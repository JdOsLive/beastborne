@namespace Beastborne.UI.Panels
@using System.Linq;
@using Sandbox;
@using Sandbox.UI;
@using Beastborne.Core;
@using Beastborne.Data;
@using Beastborne.Systems;
@using Beastborne.UI;
@using Beastborne.UI.Components;
@inherits Panel

<root class="help-container @(IsVisible ? "visible" : "")">

	@* Dimming overlay — click anywhere outside to close *@
	<div class="help-overlay" onclick=@Hide></div>

	@* Center modal — modal-popup family (matches OptionsPanel/AchievementPanel/FeedbackPanel) *@
	<div class="help-modal">

		@* Top accent line — 2px gradient bar (matches MenuPopup / OptionsPanel) *@
		<div class="modal-top-line"></div>

		@* Header — dock-tile icon + violet kicker + italic title + kb hint caps + close *@
		<div class="modal-header">
			<div class="header-left">
				<div class="header-icon-frame">
					<iconify icon="lucide:book-open" Size=@(20) Color="#9b6cff" />
				</div>
				<div class="header-text">
					<div class="hp-kicker"><span>TAMERLINK OS · HOW TO PLAY</span></div>
					<span class="header-title">GAME GUIDE</span>
				</div>
			</div>
			<div class="header-right-cluster">
				<div class="hp-hints">
					<span class="hp-keycap">W/S</span><span class="hp-hint-label">TOPICS</span>
					<span class="hp-keycap">SPACE</span><span class="hp-hint-label">READ</span>
					<span class="hp-keycap">Q</span><span class="hp-hint-label">BACK</span>
				</div>
				<button class="close-btn" onclick=@Hide>
					<iconify icon="lucide:x" Size=@(15) Color="rgba(255, 255, 255, 0.85)" />
				</button>
			</div>
		</div>

		@* Body: Sidebar + Content. Both are normal flex children of help-body. *@
		<div class="help-body">

			@* Sidebar — vertical category list with nested subtabs under the active category.
			   The keyboard cursor walks categories + subtabs as one flat list. *@
			<div class="help-sidebar @(kbMode == "nav" ? "kb-zone-active" : "")">
				@foreach (var category in Categories)
				{
					var isActive = currentCategory == category.Id;
					var isKbFocused = kbMode == "nav" && IsCategoryKbFocused(category.Id);
					var iconColor = (isActive || isKbFocused) ? "#ffffff" : "#a78bfa";
					<div class="sidebar-btn @(isActive ? "active" : "") @(isKbFocused ? "kb-focused" : "")"
						 onclick=@(() => OnCategoryClick(category.Id))>
						<div class="sidebar-icon">
							<iconify icon="@category.Icon" Size=@(18) Color="@iconColor" />
						</div>
						<div class="sidebar-text">
							<span class="sidebar-label">@category.Name</span>
							<span class="sidebar-sub">@category.Sub</span>
						</div>
					</div>
					@if (isActive && category.Subtabs != null && category.Subtabs.Length > 0)
					{
						<div class="sidebar-subtabs">
							@foreach (var sub in category.Subtabs)
							{
								var isSubKbFocused = kbMode == "nav" && IsSubtabKbFocused(category.Id, sub.Id);
								<div class="sidebar-subtab @(currentSubtab == sub.Id ? "active" : "") @(isSubKbFocused ? "kb-focused" : "")"
									 onclick=@(() => OnSubtabClick(category.Id, sub.Id))>
									<span class="sidebar-subtab-tick"></span>
									<span class="sidebar-subtab-label">@sub.Label</span>
								</div>
							}
						</div>
					}
				}
			</div>

			@* Content area — the scrollable help page. A purple inner edge
			   marks when the keyboard is in page-scroll mode. *@
			<div class="content-area @(kbMode == "scroll" ? "kb-zone-active" : "")">
				<div class="content-inner" @ref="ContentInner">
					@switch (currentCategory + "/" + currentSubtab)
					{
						case "getting-started/welcome":
							@RenderStartWelcome()
							break;
						case "getting-started/first-beast":
							@RenderStartFirstBeast()
							break;
						case "getting-started/first-run":
							@RenderStartFirstRun()
							break;
						case "getting-started/tips":
							@RenderStartTips()
							break;
						case "controls/overview":
							@RenderControlsOverview()
							break;
						case "controls/battle":
							@RenderControlsBattle()
							break;
						case "controls/taming":
							@RenderControlsTaming()
							break;
						case "controls/bag":
							@RenderControlsBag()
							break;
						case "controls/popups":
							@RenderControlsPopups()
							break;
						case "beasts/stats":
							@RenderBeastsStats()
							break;
						case "beasts/power":
							@RenderBeastsPower()
							break;
						case "beasts/rarity":
							@RenderBeastsRarity()
							break;
						case "beasts/veteran":
							@RenderBeastsVeteran()
							break;
						case "beasts/journal":
							@RenderBeastsJournal()
							break;
						case "breeding/about":
							@RenderFusionAbout()
							break;
						case "breeding/genes":
							@RenderFusionGenes()
							break;
						case "breeding/nat-mut":
							@RenderFusionNatMut()
							break;
						case "breeding/strategy":
							@RenderFusionStrategy()
							break;
						case "elements/types":
							@RenderElementsTypes()
							break;
						case "elements/effective":
							@RenderElementsEffective()
							break;
						case "elements/chart":
							@RenderElementsChart()
							break;
						case "elements/stab":
							@RenderElementsStab()
							break;
						case "elements/coverage":
							@RenderElementsCoverage()
							break;
						case "combat/turn-order":
							@RenderCombatTurnOrder()
							break;
						case "combat/move-types":
							@RenderCombatMoveTypes()
							break;
						case "combat/damage":
							@RenderCombatDamage()
							break;
						case "combat/crit-pp":
							@RenderCombatCritPp()
							break;
						case "combat/status":
							@RenderCombatStatus()
							break;
						case "contracts/how":
							@RenderTamingHow()
							break;
						case "contracts/approaches":
							@RenderTamingApproaches()
							break;
						case "contracts/math":
							@RenderTamingMath()
							break;
						case "contracts/boss":
							@RenderTamingBoss()
							break;
						case "expeditions/how":
							@RenderExpeditionsHow()
							break;
						case "expeditions/zones":
							@RenderExpeditionsZones()
							break;
						case "expeditions/bosses":
							@RenderExpeditionsBosses()
							break;
						case "expeditions/rewards":
							@RenderExpeditionsRewards()
							break;
						case "skills/earning":
							@RenderSkillsEarning()
							break;
						case "skills/branches":
							@RenderSkillsBranches()
							break;
						case "skills/respec":
							@RenderSkillsRespec()
							break;
						case "inventory/categories":
							@RenderInventoryCategories()
							break;
						case "inventory/held":
							@RenderInventoryHeld()
							break;
						case "inventory/relics":
							@RenderInventoryRelics()
							break;
						case "inventory/consumables":
							@RenderInventoryConsumables()
							break;
						case "resources/gold":
							@RenderResourcesGold()
							break;
						case "resources/ink":
							@RenderResourcesInk()
							break;
						case "resources/tokens":
							@RenderResourcesTokens()
							break;
						case "resources/storage":
							@RenderResourcesStorage()
							break;
						case "online/hub":
							@RenderOnlineHub()
							break;
						case "online/trading":
							@RenderOnlineTrading()
							break;
						case "online/arena":
							@RenderOnlineArena()
							break;
						case "online/boards":
							@RenderOnlineBoards()
							break;
						case "achievements/how":
							@RenderAchHow()
							break;
						case "achievements/categories":
							@RenderAchCategories()
							break;
						case "achievements/rewards":
							@RenderAchRewards()
							break;
					}
				</div>
			</div>

		</div>

		@* Bottom accent line *@
		<div class="modal-bottom-line"></div>

	</div>
</root>

@code {
	// Localization helper
	private string L( string key ) => LocalizationManager.Get( key );
	private string L( string key, params object[] args ) => LocalizationManager.Get( key, args );

	public static HelpPanel Instance { get; private set; }
	public bool IsVisible { get; private set; }

	private string currentCategory = "getting-started";
	private string currentSubtab = "welcome";
	private Panel ContentInner;

	// ---- Keyboard navigation -------------------------------------------
	// Single flat cursor model. The whole sidebar — every category header
	// AND every category's subtabs — is treated as ONE stable top-to-bottom
	// list of "nav rows". W/S (Up/Down) walk the cursor through that flat
	// list; landing on any row immediately switches the page underneath
	// (no Enter step).
	//
	// The nav list is built ALL-EXPANDED (every category's subtabs always
	// present) so it NEVER re-flattens as the cursor moves — that keeps the
	// integer cursor index stable in both directions. The sidebar markup
	// still only RENDERS the open category's subtabs, but the logical nav
	// list is constant, so stepping up past a category with subtabs walks
	// through each of its subtabs correctly.
	//
	// Two modes:
	//   "nav"    — W/S move the cursor; Q closes the panel.
	//   "scroll" — W/S scroll the content page; Q returns to "nav".
	//   Space toggles "nav" -> "scroll".
	private string kbMode = "nav";
	private int kbCursor = 0;
	// How many content-inner pixels one W/S press bumps the scroll TARGET
	// in scroll mode. ~2/3 of a typical page viewport keeps long pages
	// reachable in a few presses without overshooting headings.
	private const float ContentScrollStep = 220f;

	// ---- Smooth content scrolling --------------------------------------
	// scrollTarget is where the content page wants to be; Tick() eases the
	// live ScrollOffset.y toward it. W/S in scroll mode bumps the target;
	// the mouse wheel moves the live offset directly, so we resync the
	// target to the live offset whenever the two have settled (see Tick()).
	private float scrollTarget = 0f;
	// True while a keyboard-driven glide is in flight. While false, Tick()
	// resyncs scrollTarget to the live offset every frame so mouse-wheel
	// scrolling isn't fought by the easing.
	private bool scrollAnimating = false;
	// Per-frame ease factor toward the target (exponential smoothing). ~0.22
	// reaches the target in ~0.15-0.2s at 60fps — a quick, soft glide.
	private const float ScrollEase = 0.22f;
	// Below this gap the glide is "done" — snap and resync to kill jitter.
	private const float ScrollSnapEpsilon = 0.5f;

	// A single keyboard-navigable row in the flattened sidebar. Kind is
	// "category" or "subtab"; CategoryId is always set; SubtabId is set
	// only for "subtab" rows.
	private record NavRow(string Kind, string CategoryId, string SubtabId);

	// Build the flat nav-row list — ONE ROW PER ACTUAL CONTENT PAGE, no
	// redundant grouping-header stops:
	//   - A category WITH subtabs contributes only its subtab rows. Its
	//     header is a section label, not a page, so the cursor skips it.
	//   - A category with NO subtabs IS a single page, so it contributes
	//     one "category" row (there's no subtab to land on).
	// The list is ALL-EXPANDED and therefore CONSTANT — it does not change
	// as the cursor moves or as the open category changes — so the integer
	// cursor index stays stable and W/S traverse it correctly both ways.
	// Crossing a category boundary just moves to the next category's first
	// subtab; ApplyNavRow updates currentCategory implicitly.
	private List<NavRow> BuildNavRows()
	{
		var rows = new List<NavRow>();
		foreach (var cat in Categories)
		{
			if (cat.Subtabs != null && cat.Subtabs.Length > 0)
			{
				foreach (var sub in cat.Subtabs)
					rows.Add(new NavRow("subtab", cat.Id, sub.Id));
			}
			else
			{
				// Subtab-less category: the category row itself is the page.
				rows.Add(new NavRow("category", cat.Id, null));
			}
		}
		return rows;
	}

	// Apply a nav row: switch the page underneath the cursor immediately.
	// A "category" row opens that category on its first subtab; a "subtab"
	// row opens its parent category AND that subtab.
	private void ApplyNavRow(NavRow row)
	{
		if (row.Kind == "category")
		{
			SelectCategory(row.CategoryId);
		}
		else
		{
			// Make sure the parent category is the open one before the
			// subtab selection — keeps currentCategory/currentSubtab a
			// valid pair for the page dispatcher.
			if (currentCategory != row.CategoryId)
				SelectCategory(row.CategoryId);
			SelectSubtab(row.SubtabId);
		}
	}

	// Index of the nav row that matches the page currently on screen — the
	// active subtab if one is open, else the active category header.
	private int CurrentNavIndex(List<NavRow> rows)
	{
		for (int i = 0; i < rows.Count; i++)
		{
			var r = rows[i];
			if (r.Kind == "subtab" && r.CategoryId == currentCategory && r.SubtabId == currentSubtab)
				return i;
		}
		for (int i = 0; i < rows.Count; i++)
		{
			if (rows[i].Kind == "category" && rows[i].CategoryId == currentCategory)
				return i;
		}
		return 0;
	}

	// True when the keyboard cursor is sitting on this category row. The
	// cursor only ever lands on a category that has NO subtabs (those ARE
	// nav rows); a category WITH subtabs has no cursor row of its own, so
	// its header never gets the kb-focused highlight — it only renders as
	// the active section via the .active class.
	private bool IsCategoryKbFocused(string categoryId)
	{
		var rows = BuildNavRows();
		if (kbCursor < 0 || kbCursor >= rows.Count) return false;
		var r = rows[kbCursor];
		return r.Kind == "category" && r.CategoryId == categoryId;
	}

	// True when the keyboard cursor is sitting on this subtab row.
	private bool IsSubtabKbFocused(string categoryId, string subtabId)
	{
		var rows = BuildNavRows();
		if (kbCursor < 0 || kbCursor >= rows.Count) return false;
		var r = rows[kbCursor];
		return r.Kind == "subtab" && r.CategoryId == categoryId && r.SubtabId == subtabId;
	}

	private record HelpSubtab(string Id, string Label);
	private record HelpCategory(string Id, string Icon, string Name, string Sub, HelpSubtab[] Subtabs = null);

	// Help panel categories for sidebar navigation. Icons are iconify names
	// (lucide set) — matches QuestPanel sidebar pattern. Sub is a short
	// one-line hint shown under the label. Every category has subtabs; they become the
	// P5-stamp pill strip at the top of the content area (one case per
	// category/subtab pair in the markup switch).
	private static readonly HelpCategory[] Categories = new[]
	{
		new HelpCategory("getting-started", "lucide:rocket", "Start Here", "First-run guide", new[]
		{
			new HelpSubtab("welcome",     "Welcome"),
			new HelpSubtab("first-beast", "First Beast"),
			new HelpSubtab("first-run",   "First Expedition"),
			new HelpSubtab("tips",        "Tips"),
		}),
		new HelpCategory("controls", "lucide:keyboard", "Controls", "Keyboard guide", new[]
		{
			new HelpSubtab("overview", "Overview"),
			new HelpSubtab("battle",   "Battle"),
			new HelpSubtab("taming",   "Taming"),
			new HelpSubtab("bag",      "Bag"),
			new HelpSubtab("popups",   "Popups"),
		}),
		new HelpCategory("beasts", "lucide:paw-print", "Beasts", "Bond + grow", new[]
		{
			new HelpSubtab("stats",   "Stats"),
			new HelpSubtab("power",   "Power"),
			new HelpSubtab("rarity",  "Rarity"),
			new HelpSubtab("veteran", "Veteran Rank"),
			new HelpSubtab("journal", "Journal"),
		}),
		new HelpCategory("elements", "lucide:flame", "Elements", "Type matchups", new[]
		{
			new HelpSubtab("types",       "The 11 Types"),
			new HelpSubtab("effective",   "Effectiveness"),
			new HelpSubtab("chart",       "Full Chart"),
			new HelpSubtab("stab",        "STAB and Immunity"),
			new HelpSubtab("coverage",    "Coverage"),
		}),
		new HelpCategory("combat", "lucide:swords", "Combat", "Battle basics", new[]
		{
			new HelpSubtab("turn-order", "Turn Order"),
			new HelpSubtab("move-types", "Move Types"),
			new HelpSubtab("damage",     "Damage"),
			new HelpSubtab("crit-pp",    "Crits & PP"),
			new HelpSubtab("status",     "Status Effects"),
		}),
		new HelpCategory("contracts", "lucide:scroll", "Taming", "Negotiate contracts", new[]
		{
			new HelpSubtab("how",        "How It Works"),
			new HelpSubtab("approaches", "Approaches"),
			new HelpSubtab("math",       "Success Math"),
			new HelpSubtab("boss",       "Boss Contracts"),
		}),
		new HelpCategory("breeding", "lucide:dna", "Fusion", "Combine + grow", new[]
		{
			new HelpSubtab("about",     "What Fusion Does"),
			new HelpSubtab("genes",     "Genes"),
			new HelpSubtab("nat-mut",   "Natures & Mutations"),
			new HelpSubtab("strategy",  "Strategy"),
		}),
		new HelpCategory("skills", "lucide:star", "Tamer Skills", "Unlock perks", new[]
		{
			new HelpSubtab("earning",   "Earning SP"),
			new HelpSubtab("branches",  "The 5 Branches"),
			new HelpSubtab("respec",    "Respecing"),
		}),
		new HelpCategory("expeditions", "lucide:map", "Expeditions", "Run zones", new[]
		{
			new HelpSubtab("how",       "How a Run Works"),
			new HelpSubtab("zones",     "Launch Zones"),
			new HelpSubtab("bosses",    "Bosses"),
			new HelpSubtab("rewards",   "Rewards"),
		}),
		new HelpCategory("inventory", "lucide:backpack", "Inventory", "Items + gold", new[]
		{
			new HelpSubtab("categories",  "Categories"),
			new HelpSubtab("held",        "Held Items"),
			new HelpSubtab("relics",      "Relics"),
			new HelpSubtab("consumables", "Consumables"),
		}),
		new HelpCategory("resources", "lucide:coins", "Resources", "Currency guide", new[]
		{
			new HelpSubtab("gold",    "Gold"),
			new HelpSubtab("ink",     "Contract Ink"),
			new HelpSubtab("tokens",  "Boss Tokens"),
			new HelpSubtab("storage", "Beast Storage"),
		}),
		new HelpCategory("online", "lucide:globe", "Online", "Multiplayer", new[]
		{
			new HelpSubtab("hub",      "Hub Layout"),
			new HelpSubtab("trading",  "Trading"),
			new HelpSubtab("arena",    "Arena & Ranks"),
			new HelpSubtab("boards",   "Leaderboards"),
		}),
		new HelpCategory("achievements", "lucide:trophy", "Achievements", "Trophies", new[]
		{
			new HelpSubtab("how",         "How They Work"),
			new HelpSubtab("categories",  "The 15 Achievements"),
			new HelpSubtab("rewards",     "Reward Types"),
		}),
	};

	private static HelpCategory GetCategory(string id) =>
		Categories.FirstOrDefault(c => c.Id == id);

	protected override void OnAfterTreeRender(bool firstTime)
	{
		if (firstTime)
		{
			Instance = this;
		}
	}

	public static void Show()
	{
		if (Instance != null)
		{
			Instance.IsVisible = true;
			Instance.currentCategory = "getting-started";
			Instance.currentSubtab = GetCategory("getting-started")?.Subtabs?.FirstOrDefault()?.Id ?? "";
			// Keyboard starts in nav mode with the cursor on the open page.
			Instance.kbMode = "nav";
			Instance.kbCursor = Instance.CurrentNavIndex(Instance.BuildNavRows());
			Instance.ResetContentScroll();
			SoundManager.PlayPopup();
		}
	}

	public static void ShowCategory(string categoryId)
	{
		if (Instance != null)
		{
			Instance.IsVisible = true;
			Instance.currentCategory = categoryId;
			Instance.currentSubtab = GetCategory(categoryId)?.Subtabs?.FirstOrDefault()?.Id ?? "";
			// Opened straight to a category — cursor lands on that page.
			Instance.kbMode = "nav";
			Instance.kbCursor = Instance.CurrentNavIndex(Instance.BuildNavRows());
			Instance.ResetContentScroll();
			SoundManager.PlayForward();
		}
	}

	public void Hide()
	{
		IsVisible = false;
		SoundManager.PlayPopdown();
	}

	public override void Tick()
	{
		base.Tick();

		if (!IsVisible)
			return;

		// Ease the content page toward its smooth-scroll target. Runs every
		// frame the panel is visible (independent of modal-top status) so a
		// glide always finishes cleanly.
		UpdateSmoothScroll();

		// Only the topmost modal owns the keyboard — stay inert otherwise so
		// this panel doesn't fight a ConfirmDialog/OptionsPanel stacked above.
		if (!UIModalState.IsTopModal("HelpPanel"))
			return;

		HandleKeyboardInput();
	}

	// Exponentially eases ContentInner.ScrollOffset.y toward scrollTarget.
	// While NOT animating, scrollTarget tracks the live offset so mouse-wheel
	// scrolling moves freely and the next keyboard bump glides from there.
	private void UpdateSmoothScroll()
	{
		if (ContentInner == null)
			return;

		var off = ContentInner.ScrollOffset;

		if (!scrollAnimating)
		{
			// Idle — let the wheel drive. Keep the target shadowing the
			// live offset so a future W/S bump starts from the right place.
			scrollTarget = off.y;
			return;
		}

		// Clamp the target in case the page (and thus ScrollSize) changed.
		float maxY = Math.Max(0f, ContentInner.ScrollSize.y);
		scrollTarget = Math.Clamp(scrollTarget, 0f, maxY);

		float gap = scrollTarget - off.y;
		if (Math.Abs(gap) <= ScrollSnapEpsilon)
		{
			// Settled — snap exactly and hand control back to the wheel.
			off.y = scrollTarget;
			ContentInner.ScrollOffset = off;
			scrollAnimating = false;
			return;
		}

		off.y += gap * ScrollEase;
		ContentInner.ScrollOffset = off;
	}

	private void HandleKeyboardInput()
	{
		// W/S map to Forward/Backward in s&box; fold with the arrow keys.
		bool up      = Input.Pressed("Up")    || Input.Pressed("Forward");
		bool down    = Input.Pressed("Down")  || Input.Pressed("Backward");
		bool confirm = Input.Pressed("Jump")  || Input.Pressed("Enter");
		bool back    = Input.Pressed("Escape") || Input.Pressed("Menu") || Input.Pressed("run");

		// ---- SCROLL mode: W/S bump the scroll TARGET, Q returns to nav -----
		if (kbMode == "scroll")
		{
			if (back)
			{
				kbMode = "nav";
				// Re-anchor the cursor to the page that's on screen.
				kbCursor = CurrentNavIndex(BuildNavRows());
				SoundManager.PlayBack();
				return;
			}
			if ((up || down) && ContentInner != null)
			{
				// Bump the smooth-scroll target; Tick() eases the live
				// offset toward it. Clamp to the page extent. Seed the
				// target from the live offset first so a wheel scroll the
				// player just did isn't undone by a stale target.
				float maxY = Math.Max(0f, ContentInner.ScrollSize.y);
				if (!scrollAnimating) scrollTarget = ContentInner.ScrollOffset.y;
				scrollTarget = Math.Clamp(
					scrollTarget + (down ? ContentScrollStep : -ContentScrollStep),
					0f, maxY);
				scrollAnimating = true;
				return;
			}
			return;
		}

		// ---- NAV mode: W/S walk the single flat cursor --------------------
		// Q closes the whole panel.
		if (back) { Hide(); return; }

		// Space dives into page-scroll mode. Seed the scroll target from the
		// live offset so the first W/S bump glides from where the page is.
		if (confirm)
		{
			kbMode = "scroll";
			if (ContentInner != null) scrollTarget = ContentInner.ScrollOffset.y;
			SoundManager.PlayClick();
			return;
		}

		// The nav list is ALL-EXPANDED and therefore CONSTANT — the cursor
		// index stays valid across page switches, so a plain index step
		// traverses every row correctly in both directions.
		var rows = BuildNavRows();
		if (rows.Count == 0) return;
		kbCursor = Math.Clamp(kbCursor, 0, rows.Count - 1);

		if (up && kbCursor > 0)
		{
			kbCursor--;
			ApplyNavRow(rows[kbCursor]);   // live page switch; does NOT move kbCursor
			SoundManager.PlayHover();
			return;
		}
		if (down && kbCursor < rows.Count - 1)
		{
			kbCursor++;
			ApplyNavRow(rows[kbCursor]);   // live page switch; does NOT move kbCursor
			SoundManager.PlayHover();
			return;
		}
	}

	// Page-switch primitives. These do NOT touch kbCursor — the keyboard
	// handler owns the cursor while navigating, and the mouse onclick
	// handlers sync the cursor themselves after calling these. Keeping the
	// cursor out of here is what makes upward W traversal reliable.
	private void SelectCategory(string categoryId)
	{
		if (currentCategory != categoryId)
		{
			currentCategory = categoryId;
			currentSubtab = GetCategory(categoryId)?.Subtabs?.FirstOrDefault()?.Id ?? "";
			SoundManager.PlayClick();
			ResetContentScroll();
		}
	}

	private void SelectSubtab(string subtabId)
	{
		if (currentSubtab != subtabId)
		{
			currentSubtab = subtabId;
			SoundManager.PlayClick();
			ResetContentScroll();
		}
	}

	// Snap the content page back to the top (live offset AND smooth-scroll
	// target) — called on every page switch. Ends any glide instantly.
	private void ResetContentScroll()
	{
		scrollTarget = 0f;
		scrollAnimating = false;
		if (ContentInner != null)
			ContentInner.ScrollOffset = new Vector2(0, 0);
	}

	// Mouse click on a sidebar category — switch the page and re-anchor the
	// keyboard cursor so a later W/S continues from where the mouse landed.
	private void OnCategoryClick(string categoryId)
	{
		SelectCategory(categoryId);
		kbCursor = CurrentNavIndex(BuildNavRows());
	}

	// Mouse click on a sidebar subtab — same, for a subtab row.
	private void OnSubtabClick(string categoryId, string subtabId)
	{
		if (currentCategory != categoryId)
			SelectCategory(categoryId);
		SelectSubtab(subtabId);
		kbCursor = CurrentNavIndex(BuildNavRows());
	}

	protected override int BuildHash()
	{
		// kbMode + kbCursor drive the keyboard-cursor highlight and the
		// content-area scroll-mode glow.
		return HashCode.Combine(IsVisible, currentCategory, currentSubtab,
			kbMode, kbCursor);
	}

