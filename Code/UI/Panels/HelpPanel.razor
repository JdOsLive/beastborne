	private RenderFragment RenderCombatDamage() => __builder =>
	{
		<div class="help-page">
			<HelpHero HeroIcon="lucide:flame" HeroTitle="Damage" HeroSubtitle="What every hit is actually doing" />

			<p class="help-lead">
				Damage is a chain of multipliers. Knowing which factor matters most for a
				given fight tells you whether you should swap beast, swap move, or grind
				one more level.
			</p>

			<span class="help-section-title">The damage chain</span>
			<div class="help-callout">
				<span class="help-callout-eyebrow">Roughly</span>
				<span class="help-callout-formula">Damage ≈ Attack/Defense × Move Power × STAB × Type × Crit × Random</span>
				<span class="help-callout-text">The attacker's relevant attack stat (ATK or SpA) divided by the target's defense, scaled by the move's base Power, then multiplied by every situational bonus.</span>
			</div>

			<span class="help-section-title">What each factor does</span>
			<div class="help-keypoints">
				<div class="help-keypoint">
					<iconify icon="lucide:swords" Size=@(16) Color="#a78bfa" />
					<span><strong>Move Power</strong> — the move's printed base. 40 is weak, 90 is solid, 120+ is a finisher.</span>
				</div>
				<div class="help-keypoint">
					<iconify icon="lucide:flame" Size=@(16) Color="#a78bfa" />
					<span><strong>STAB</strong> — 1.5× when the move's element matches the user's. Always-on if your moveset is built right.</span>
				</div>
				<div class="help-keypoint">
					<iconify icon="lucide:target" Size=@(16) Color="#a78bfa" />
					<span><strong>Type</strong> — 2.0× / 0.5× / 0× based on the matchup. The single biggest swing in the formula.</span>
				</div>
				<div class="help-keypoint">
					<iconify icon="lucide:zap" Size=@(16) Color="#a78bfa" />
					<span><strong>Crit</strong> — 1.5× on a roll. Rare but turn-deciding when it lands. See the Crits and PP tab.</span>
				</div>
				<div class="help-keypoint">
					<iconify icon="lucide:dice-5" Size=@(16) Color="#a78bfa" />
					<span><strong>Random</strong> — small ±wiggle on every hit so you can't predict damage to the exact HP.</span>
				</div>
			</div>

			<div class="help-quicktip">
				<iconify icon="lucide:lightbulb" Size=@(14) Color="#fbbf24" />
				<span>The biggest damage swing in any fight is Type — a single super-effective swap usually beats a level grind.</span>
			</div>
		</div>
	};

	private RenderFragment RenderCombatCritPp() => __builder =>
	{
