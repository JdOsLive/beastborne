	// ==========================================
	// PAGE DISPATCHER — returns the RenderFragment for the current category/subtab.
	// Pure C# (no @markup tokens); the markup just calls @RenderActivePage().
	// ==========================================

	private RenderFragment RenderActivePage()
	{
		var key = currentCategory + "/" + currentSubtab;
		return key switch
		{
			"getting-started/welcome"     => RenderStartWelcome(),
			"getting-started/first-beast" => RenderStartFirstBeast(),
			"getting-started/first-run"   => RenderStartFirstRun(),
			"getting-started/tips"        => RenderStartTips(),
			"controls/overview"           => RenderControlsOverview(),
			"controls/battle"             => RenderControlsBattle(),
			"controls/taming"             => RenderControlsTaming(),
			"controls/bag"                => RenderControlsBag(),
			"controls/popups"             => RenderControlsPopups(),
			"beasts/stats"                => RenderBeastsStats(),
			"beasts/power"                => RenderBeastsPower(),
			"beasts/rarity"               => RenderBeastsRarity(),
			"beasts/veteran"              => RenderBeastsVeteran(),
			"beasts/journal"              => RenderBeastsJournal(),
			"breeding/about"              => RenderFusionAbout(),
			"breeding/genes"              => RenderFusionGenes(),
			"breeding/nat-mut"            => RenderFusionNatMut(),
			"breeding/strategy"           => RenderFusionStrategy(),
			_ => currentCategory switch
			{
				"elements"     => RenderElements(),
				"combat"       => RenderCombat(),
				"contracts"    => RenderContracts(),
				"skills"       => RenderSkills(),
				"expeditions"  => RenderExpeditions(),
				"inventory"    => RenderInventory(),
				"resources"    => RenderResources(),
				"online"       => RenderOnline(),
				"achievements" => RenderAchievements(),
				_              => null,
			},
		};
	}

