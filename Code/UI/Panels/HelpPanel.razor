	private static string CellClass(float m) => m switch
	{
		2.0f => "m-super",
		0.5f => "m-resist",
		0.0f => "m-immune",
		_    => "m-norm",
	};

	private static string CellLabel(float m) => m switch
	{
		2.0f => "2",
		0.5f => "½",
		0.0f => "0",
		_    => "—",
	};

	private RenderFragment RenderElementsChart() => __builder =>
	{
		<div class="help-page">
			<HelpHero HeroIcon="lucide:grid-3x3" HeroTitle="Full Type Chart" HeroSubtitle="Every attacker, every defender" />

			<p class="help-lead">
				Left column is the ATTACKER's element. Top row is the DEFENDER's element.
				Each cell shows the damage multiplier when an attack of that type lands on
				a Beast of that type.
			</p>

			<div class="elem-chart">
				@* Header row *@
				<div class="elem-chart-row">
					<div class="elem-chart-corner"></div>
					@foreach (var d in _elementData)
					{
						<div class="elem-chart-head">
							<iconify icon="@d.Icon" Size=@(14) Color="@d.Color" />
						</div>
					}
				</div>
				@* Data rows *@
				@for (int r = 0; r < 11; r++)
				{
					var atkr = _elementData[r];
					<div class="elem-chart-row">
						<div class="elem-chart-head">
							<iconify icon="@atkr.Icon" Size=@(14) Color="@atkr.Color" />
						</div>
						@for (int c = 0; c < 11; c++)
						{
							var mult = _elementChart[r, c];
							<div class="elem-chart-cell @CellClass(mult)">
								<span>@CellLabel(mult)</span>
							</div>
						}
					</div>
				}
			</div>

			<div class="elem-chart-legend">
				<div class="legend-item"><div class="legend-swatch m-super"></div><span>2× SUPER</span></div>
				<div class="legend-item"><div class="legend-swatch m-norm"></div><span>1× NORMAL</span></div>
				<div class="legend-item"><div class="legend-swatch m-resist"></div><span>½× RESISTED</span></div>
				<div class="legend-item"><div class="legend-swatch m-immune"></div><span>0× IMMUNE</span></div>
			</div>

			<div class="help-quicktip">
				<iconify icon="lucide:lightbulb" Size=@(14) Color="#fbbf24" />
				<span>Two immunities exist: Earth attacks bounce off Wind, and Electric attacks bounce off Earth. Everything else is just a multiplier.</span>
			</div>
		</div>
	};

	private RenderFragment RenderElementsStab() => __builder =>
	{
