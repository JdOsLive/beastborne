	private RenderFragment RenderBeastsPower() => __builder =>
	{
		<div class="help-page">
			<HelpHero HeroIcon="lucide:flame" HeroTitle="Power" HeroSubtitle="One number to compare beasts" />

			<p class="help-lead">
				Power is the rough overall strength score shown next to every Beast.
				It's not a stat — it's a weighted sum of all stats, used for sorting and
