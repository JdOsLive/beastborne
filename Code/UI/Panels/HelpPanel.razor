	private static HelpCategory GetCategory(string id) =>
		Categories.FirstOrDefault(c => c.Id == id);

	protected override void OnAfterTreeRender(bool firstTime)
	{
		if (firstTime)
		{
			Instance = this;
		}
	}

	public static void Show()
	{
		if (Instance != null)
		{
			Instance.IsVisible = true;
			Instance.currentCategory = "getting-started";
			Instance.currentSubtab = GetCategory("getting-started")?.Subtabs?.FirstOrDefault()?.Id ?? "";
			// Keyboard starts in nav mode with the cursor on the open page.
			Instance.kbMode = "nav";
			Instance.kbCursor = Instance.CurrentNavIndex(Instance.BuildNavRows());
			SoundManager.PlayPopup();
		}
	}

	public static void ShowCategory(string categoryId)
	{
		if (Instance != null)
		{
			Instance.IsVisible = true;
			Instance.currentCategory = categoryId;
			Instance.currentSubtab = GetCategory(categoryId)?.Subtabs?.FirstOrDefault()?.Id ?? "";
			Instance.ContentInner?.ScrollOffset = new Vector2(0, 0);
			// Opened straight to a category — cursor lands on that page.
			Instance.kbMode = "nav";
			Instance.kbCursor = Instance.CurrentNavIndex(Instance.BuildNavRows());
			SoundManager.PlayForward();
		}
	}

	public void Hide()
	{
		IsVisible = false;
		SoundManager.PlayPopdown();
	}

	public override void Tick()
	{
		base.Tick();

		// Only the topmost modal owns the keyboard — stay inert otherwise so
		// this panel doesn't fight a ConfirmDialog/OptionsPanel stacked above.
		if (!IsVisible || !UIModalState.IsTopModal("HelpPanel"))
			return;

		HandleKeyboardInput();
	}

	private void HandleKeyboardInput()
	{
		// W/S map to Forward/Backward in s&box; fold with the arrow keys.
		bool up      = Input.Pressed("Up")    || Input.Pressed("Forward");
		bool down    = Input.Pressed("Down")  || Input.Pressed("Backward");
		bool confirm = Input.Pressed("Jump")  || Input.Pressed("Enter");
		bool back    = Input.Pressed("Escape") || Input.Pressed("Menu") || Input.Pressed("run");

		// ---- SCROLL mode: W/S scroll the content page, Q returns to nav ----
		if (kbMode == "scroll")
		{
			if (back)
			{
				kbMode = "nav";
				// Re-anchor the cursor to the page that's on screen.
				kbCursor = CurrentNavIndex(BuildNavRows());
				SoundManager.PlayBack();
				return;
			}
			if ((up || down) && ContentInner != null)
			{
				var off = ContentInner.ScrollOffset;
				float maxY = Math.Max(0f, ContentInner.ScrollSize.y);
				off.y = Math.Clamp(off.y + (down ? ContentScrollStep : -ContentScrollStep), 0f, maxY);
				ContentInner.ScrollOffset = off;
				return;
			}
			return;
		}

		// ---- NAV mode: W/S walk the single flat cursor --------------------
		// Q closes the whole panel.
		if (back) { Hide(); return; }

		// Space dives into page-scroll mode.
		if (confirm) { kbMode = "scroll"; SoundManager.PlayClick(); return; }

		var rows = BuildNavRows();
		if (rows.Count == 0) return;

		// Keep the cursor coherent — if a page switch changed the row count,
		// re-anchor before moving.
		kbCursor = Math.Clamp(kbCursor, 0, rows.Count - 1);

		if (up && kbCursor > 0)
		{
			kbCursor--;
			ApplyNavRow(rows[kbCursor]);   // live page switch
			SoundManager.PlayHover();
			return;
		}
		if (down && kbCursor < rows.Count - 1)
		{
			kbCursor++;
			ApplyNavRow(rows[kbCursor]);   // live page switch
			SoundManager.PlayHover();
			return;
		}
	}

	private void SelectCategory(string categoryId)
	{
		if (currentCategory != categoryId)
		{
			currentCategory = categoryId;
			currentSubtab = GetCategory(categoryId)?.Subtabs?.FirstOrDefault()?.Id ?? "";
			SoundManager.PlayClick();

			// Scroll content to top when switching pages
			if (ContentInner != null)
			{
				ContentInner.ScrollOffset = new Vector2(0, 0);
			}
		}
		// Keyboard cursor follows mouse clicks too, so the two stay in sync.
		kbCursor = CurrentNavIndex(BuildNavRows());
	}

	private void SelectSubtab(string subtabId)
	{
		if (currentSubtab != subtabId)
		{
			currentSubtab = subtabId;
			SoundManager.PlayClick();
			if (ContentInner != null)
			{
				ContentInner.ScrollOffset = new Vector2(0, 0);
			}
		}
		kbCursor = CurrentNavIndex(BuildNavRows());
	}

	protected override int BuildHash()
	{
		// kbMode + kbCursor drive the keyboard-cursor highlight and the
		// content-area scroll-mode glow.
		return HashCode.Combine(IsVisible, currentCategory, currentSubtab,
			kbMode, kbCursor);
	}

	// ==========================================
	// START HERE — new subtab system (live preview of the redesign).
	// Dispatcher lives in markup (@switch on currentSubtab) — putting
	// `@RenderXxx()` calls inside a C# method body in @code doesn't compile.
	// ==========================================

	private RenderFragment RenderStartWelcome() => __builder =>
	{
		<div class="help-page">
			<HelpHero HeroIcon="lucide:rocket" HeroTitle="Welcome, Tamer" HeroSubtitle="A first look at Beastborne" />

			<p class="help-lead">
				Beastborne is a monster-taming roguelite. You collect Beasts, fuse them
				into stronger forms, and lead a team of three through expeditions to
				earn gold, items, and XP. The deeper you push, the better the rewards.
			</p>

			<HelpScreenshot ShotCaption="The Beastborne hub on first launch" />

			<div class="help-callout">
				<span class="help-callout-eyebrow">The loop</span>
				<span class="help-callout-text">
					Tame &middot; Fuse &middot; Expedition &middot; Ascend. Every system in the
					game feeds back into the same four pillars.
				</span>
			</div>

			<span class="help-section-title">What's in this guide</span>
			<div class="help-keypoints">
				<div class="help-keypoint">
					<iconify icon="lucide:paw-print" Size=@(16) Color="#a78bfa" />
					<span><strong>Beasts &middot; Elements &middot; Combat</strong> — what your monsters can do and how battles resolve.</span>
				</div>
				<div class="help-keypoint">
					<iconify icon="lucide:scroll" Size=@(16) Color="#a78bfa" />
					<span><strong>Taming &middot; Fusion</strong> — how to grow your collection and build stronger beasts.</span>
				</div>
				<div class="help-keypoint">
					<iconify icon="lucide:map" Size=@(16) Color="#a78bfa" />
					<span><strong>Expeditions &middot; Skills &middot; Inventory</strong> — the run-to-run loop and your meta-progression.</span>
				</div>
				<div class="help-keypoint">
					<iconify icon="lucide:globe" Size=@(16) Color="#a78bfa" />
					<span><strong>Online &middot; Achievements</strong> — when you're ready to test yourself against other Tamers.</span>
				</div>
			</div>

			<div class="help-quicktip">
				<iconify icon="lucide:lightbulb" Size=@(14) Color="#fbbf24" />
				<span>Use the tabs on the left any time. Each tab has its own subtabs along the top.</span>
