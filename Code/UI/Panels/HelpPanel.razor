	private RenderFragment RenderTamingMath() => __builder =>
	{
		<div class="help-page">
			<HelpHero HeroIcon="lucide:calculator" HeroTitle="Success Math" HeroSubtitle="What actually decides the roll" />

			<p class="help-lead">
				The success roll is a chain of multipliers. Knowing which one matters most
				for a given target tells you whether to weaken it more, switch approach,
				or invest in skills.
			</p>

			<span class="help-section-title">The formula</span>
			<div class="help-callout">
				<span class="help-callout-eyebrow">Weighted product</span>
				<span class="help-callout-formula">Final = Base × HP_Mod × Rarity_Mod × (1 + Skills) × Personality</span>
				<span class="help-callout-text">Clamped between 5% and 95%. So even a perfect setup never reaches 100% (except boss contracts — see that subtab).</span>
			</div>

			<span class="help-section-title">HP modifier</span>
			<div class="help-keypoints">
				<div class="help-keypoint">
					<iconify icon="lucide:heart" Size=@(16) Color="#22c55e" />
					<span><strong>0% HP (fainted-edge): ×1.0.</strong> Best — target is at HP just above zero.</span>
				</div>
				<div class="help-keypoint">
					<iconify icon="lucide:heart" Size=@(16) Color="#fbbf24" />
					<span><strong>50% HP: ×0.75.</strong> Solid. Reliable mid-fight breakpoint.</span>
				</div>
				<div class="help-keypoint">
					<iconify icon="lucide:heart" Size=@(16) Color="#ef4444" />
					<span><strong>100% HP: ×0.5.</strong> Worst. Halves your odds before any other factor.</span>
				</div>
			</div>

			<span class="help-section-title">Rarity modifier</span>
			<div class="help-stepgrid">
				<div class="help-step">
					<span class="help-step-number">1.0</span>
					<div class="help-step-text"><strong>Common</strong><span>No penalty.</span></div>
				</div>
				<div class="help-step">
					<span class="help-step-number">0.9</span>
					<div class="help-step-text"><strong>Uncommon</strong><span>Slight penalty.</span></div>
				</div>
				<div class="help-step">
					<span class="help-step-number">0.75</span>
					<div class="help-step-text"><strong>Rare</strong><span>Noticeable.</span></div>
				</div>
				<div class="help-step">
					<span class="help-step-number">0.6</span>
					<div class="help-step-text"><strong>Epic</strong><span>Need skills + low HP.</span></div>
				</div>
				<div class="help-step">
					<span class="help-step-number">0.4</span>
					<div class="help-step-text"><strong>Legendary</strong><span>Brutal — only catchable as a boss.</span></div>
				</div>
				<div class="help-step">
					<span class="help-step-number">0.3</span>
					<div class="help-step-text"><strong>Mythic</strong><span>Wild Mythics are nearly impossible. Boss versions are the only realistic path.</span></div>
				</div>
			</div>

			<div class="help-callout">
				<span class="help-callout-eyebrow">Stacking modifiers</span>
				<span class="help-callout-text">Skill bonuses (CatchRate node, Elite Ink consumable, Guild bonus, Previous Discovery +15%) all add INSIDE the (1 + Skills) term — so they multiply the rest of the chain. Ten percent in skills is more than ten percent in final rate.</span>
			</div>

			<div class="help-quicktip">
				<iconify icon="lucide:lightbulb" Size=@(14) Color="#fbbf24" />
				<span>The single biggest swing in any contract is HP. Knock the target to under 25% before you commit ink.</span>
			</div>
		</div>
	};

