	private RenderFragment RenderCombatTurnOrder() => __builder =>
	{
		<div class="help-page">
			<HelpHero HeroIcon="lucide:list-ordered" HeroTitle="Turn Order" HeroSubtitle="Speed decides who swings first" />

			<p class="help-lead">
				Beastborne battles are turn-based. At the start of every turn, both sides
				pick their move. Then the system orders the actions by speed and resolves
				them one at a time.
			</p>

			<HelpScreenshot ShotCaption="Battle screen — initiative readout at the start of a turn" />

			<span class="help-section-title">How order is decided</span>
			<div class="help-stepgrid">
				<div class="help-step">
					<span class="help-step-number">1</span>
					<div class="help-step-text">
						<strong>Both sides pick a move</strong>
						<span>Player picks visibly; the AI picks behind the scenes.</span>
					</div>
				</div>
				<div class="help-step">
					<span class="help-step-number">2</span>
					<div class="help-step-text">
						<strong>Compare speeds</strong>
						<span>The Beast with the higher SPD goes first this turn.</span>
					</div>
				</div>
				<div class="help-step">
					<span class="help-step-number">3</span>
					<div class="help-step-text">
						<strong>Tie-break</strong>
						<span>Equal speeds resolve in random order — coin flip per turn.</span>
					</div>
				</div>
				<div class="help-step">
					<span class="help-step-number">4</span>
					<div class="help-step-text">
						<strong>Resolve actions</strong>
						<span>Faster moves first, then slower. Status effects tick at end of turn.</span>
					</div>
				</div>
			</div>

			<div class="help-callout">
				<span class="help-callout-eyebrow">Why speed matters</span>
				<span class="help-callout-text">Hitting first means you can KO the opponent before they swing. A fast glass cannon often beats a slow wall — the slow beast never gets a turn.</span>
			</div>

			<div class="help-quicktip">
				<iconify icon="lucide:lightbulb" Size=@(14) Color="#fbbf24" />
				<span>Some moves and items shift speed for the turn — use them to flip an unfavorable speed tie before a critical hit lands.</span>
			</div>
		</div>
	};

	private RenderFragment RenderCombatMoveTypes() => __builder =>
	{
		<div class="help-page">
			<HelpHero HeroIcon="lucide:swords" HeroTitle="Move Types" HeroSubtitle="Three categories, three answers" />

			<p class="help-lead">
				Every move belongs to one of three categories. The category decides which
				stats the move uses, what defends against it, and what role it plays.
			</p>

			<span class="help-section-title">The three categories</span>
			<div class="help-keypoints">
				<div class="help-keypoint">
					<iconify icon="lucide:swords" Size=@(16) Color="#fb923c" />
					<span><strong>Physical</strong> — sword, claw, bite. Damage is calculated from the attacker's ATK against the target's DEF.</span>
				</div>
				<div class="help-keypoint">
					<iconify icon="lucide:sparkles" Size=@(16) Color="#a78bfa" />
					<span><strong>Special</strong> — magic, beams, breath. Uses the attacker's SpA against the target's SpD.</span>
				</div>
				<div class="help-keypoint">
					<iconify icon="lucide:wand-2" Size=@(16) Color="#7dd3fc" />
					<span><strong>Status</strong> — buffs, debuffs, conditions. Doesn't deal damage directly — instead it shifts stats, applies effects, or sets up the next turn.</span>
				</div>
			</div>

			<span class="help-section-title">Picking what to bring</span>
			<div class="help-keypoints">
				<div class="help-keypoint">
					<iconify icon="lucide:check" Size=@(16) Color="#22c55e" />
					<span><strong>Lean into the stat shape.</strong> A high-ATK Beast wants Physical moves. A high-SpA Beast wants Special. Mismatched movesets waste stats.</span>
				</div>
				<div class="help-keypoint">
					<iconify icon="lucide:check" Size=@(16) Color="#22c55e" />
					<span><strong>Keep at least one Status move.</strong> A turn of buffs/debuffs can flip a fight you'd otherwise lose.</span>
				</div>
				<div class="help-keypoint">
					<iconify icon="lucide:check" Size=@(16) Color="#22c55e" />
					<span><strong>Cover both attack categories on a team.</strong> A boss with monster DEF but flimsy SpD melts to a Special hitter.</span>
				</div>
			</div>

			<div class="help-quicktip">
				<iconify icon="lucide:lightbulb" Size=@(14) Color="#fbbf24" />
				<span>Move tooltips show category with a small icon — sword for Physical, sparkle for Special, wand for Status.</span>
			</div>
		</div>
	};

	private RenderFragment RenderCombatDamage() => __builder =>
	{
		<div class="help-page">
			<HelpHero HeroIcon="lucide:flame" HeroTitle="Damage" HeroSubtitle="What every hit is actually doing" />

			<p class="help-lead">
				Damage is a chain of multipliers. Knowing which factor matters most for a
				given fight tells you whether you should swap beast, swap move, or grind
				one more level.
			</p>

			<span class="help-section-title">The damage chain</span>
			<div class="help-callout">
				<span class="help-callout-eyebrow">Roughly</span>
				<span class="help-callout-formula">Damage ≈ Attack/Defense × Move Power × STAB × Type × Crit × Random</span>
				<span class="help-callout-text">The attacker's relevant attack stat (ATK or SpA) divided by the target's defense, scaled by the move's base Power, then multiplied by every situational bonus.</span>
			</div>

			<span class="help-section-title">What each factor does</span>
			<div class="help-keypoints">
				<div class="help-keypoint">
					<iconify icon="lucide:swords" Size=@(16) Color="#a78bfa" />
					<span><strong>Move Power</strong> — the move's printed base. 40 is weak, 90 is solid, 120+ is a finisher.</span>
				</div>
				<div class="help-keypoint">
					<iconify icon="lucide:flame" Size=@(16) Color="#a78bfa" />
					<span><strong>STAB</strong> — 1.5× when the move's element matches the user's. Always-on if your moveset is built right.</span>
				</div>
				<div class="help-keypoint">
					<iconify icon="lucide:target" Size=@(16) Color="#a78bfa" />
					<span><strong>Type</strong> — 2.0× / 0.5× / 0× based on the matchup. The single biggest swing in the formula.</span>
				</div>
				<div class="help-keypoint">
					<iconify icon="lucide:zap" Size=@(16) Color="#a78bfa" />
					<span><strong>Crit</strong> — 1.5× on a roll. Rare but turn-deciding when it lands. See the Crits and PP tab.</span>
				</div>
				<div class="help-keypoint">
					<iconify icon="lucide:dice-5" Size=@(16) Color="#a78bfa" />
					<span><strong>Random</strong> — small ±wiggle on every hit so you can't predict damage to the exact HP.</span>
				</div>
			</div>

			<div class="help-quicktip">
				<iconify icon="lucide:lightbulb" Size=@(14) Color="#fbbf24" />
				<span>The biggest damage swing in any fight is Type — a single super-effective swap usually beats a level grind.</span>
			</div>
		</div>
	};

