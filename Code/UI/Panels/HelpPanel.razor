			</div>

			<div class="help-quicktip">
				<iconify icon="lucide:lightbulb" Size=@(14) Color="#fbbf24" />
				<span>If a fight feels impossible, check whether the boss has an immunity blocking your team's only attack type. Switching one Beast usually breaks the wall.</span>
			</div>
		</div>
	};

	private RenderFragment RenderElementsCoverage() => __builder =>
