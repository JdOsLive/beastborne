@namespace Beastborne.UI.Panels
@using Sandbox;
@using Sandbox.UI;
@using Beastborne.Core;
@using Beastborne.Data;
@using Beastborne.Systems;
@using Beastborne.UI;
@using Achievement = Beastborne.Data.Achievement;
@inherits Panel

<root class="ach-container @(IsVisible ? "visible" : "")">

	@* Dimming overlay — click anywhere outside to close *@
	<div class="ach-overlay" onclick=@Close></div>

	@* Center modal — same envelope as OptionsPanel / FeedbackPanel. *@
	<div class="ach-modal">

		@* Top accent line — 2px gradient bar, top only (NEVER mirror at bottom). *@
		<div class="modal-top-line"></div>

		@* HEADER — title + completion chip + close *@
		<div class="modal-header">
			<div class="header-left">
				<div class="header-icon-frame @(GetUnclaimedCount() > 0 ? "has-unclaimed" : "")">
					<iconify icon="lucide:trophy" Size=@(18) Color="#fbbf24" />
				</div>
				<div class="header-text">
					<span class="header-title">@L("ui.menu_popup.achievements").ToUpper()</span>
					<span class="header-subtitle">UNLOCK · COLLECT · MASTER</span>
				</div>
			</div>
			<div class="header-right">
				<div class="completion-chip">
					<iconify icon="lucide:trophy" Size=@(12) Color="#fcd34d" />
					<span class="completion-text">@GetUnlockedCount() / @GetTotalCount() &middot; @GetOverallPercent()%</span>
				</div>
				<button class="close-btn" onclick=@Close onmouseover=@(() => OnHover("close"))>
					<iconify icon="lucide:x" Size=@(15) Color="rgba(255, 255, 255, 0.85)" />
				</button>
			</div>
		</div>

		@* OVERALL PROGRESS BAR — thin gold-tinted strip below header *@
		<div class="overall-progress-row">
			<div class="overall-progress-bar">
				<div class="overall-progress-fill" style="width: @(GetOverallPercent())%"></div>
			</div>
		</div>

		@* CATEGORY TABS — horizontal pill row with iconify glyphs *@
		<div class="modal-tabs">
			@foreach (var cat in CategoryDefs)
			{
				var isActive = currentCategory == cat.Id;
				<button class="ach-tab tab-@cat.Id @(isActive ? "active" : "")"
						onclick=@(() => SetCategory(cat.Id))
						onmouseover=@(() => OnHover("tab-" + cat.Id))>
					<iconify icon="@cat.Icon" Size=@(13) Color="@(isActive ? cat.Color : Hex2Rgba(cat.Color, 0.55f))" />
					<span class="tab-label">@cat.Label</span>
				</button>
			}
		</div>

		@* UNCLAIMED BANNER — gold strip when there are unclaimed rewards *@
		@{
			var unclaimedCount = GetUnclaimedCount();
		}
		@if (unclaimedCount > 0)
		{
			<div class="unclaimed-banner">
				<div class="unclaimed-left">
					<div class="unclaimed-icon-frame">
						<iconify icon="lucide:gift" Size=@(16) Color="#fcd34d" />
					</div>
					<div class="unclaimed-text-stack">
						<span class="unclaimed-title">@L("ui.achievement.rewards_ready", unclaimedCount, unclaimedCount > 1 ? "s" : "")</span>
						<span class="unclaimed-sub">Tap CLAIM ALL to collect every pending reward</span>
					</div>
				</div>
				<button class="claim-all-btn" onclick=@ClaimAll onmouseover=@(() => OnHover("claim-all"))>
					<iconify icon="lucide:check-check" Size=@(14) Color="#ffffff" />
					<span>@L("ui.achievement.claim_all")</span>
				</button>
			</div>
		}

		@* SCROLLABLE BODY — achievement list (flat children of overflow scroll) *@
		<div class="modal-scroll-wrap">
			<div class="modal-scroll">
				@{
					var list = GetFilteredAchievements();
				}
				@if (list.Count == 0)
				{
					<div class="ach-empty">
						<div class="empty-icon-frame">
							<iconify icon="@GetEmptyIcon()" Size=@(40) Color="#6d28d9" />
						</div>
						<span class="empty-title">@GetEmptyTitle()</span>
						<span class="empty-body">@L("ui.achievement.no_achievements")</span>
					</div>
				}
				else
				{
					@foreach (var achievement in list)
					{
						@RenderAchievementRow(achievement)
					}
				}
				<div class="scroll-tail"></div>
			</div>
		</div>

	</div>
</root>

@code {
	// Localization helper
	private string L( string key ) => LocalizationManager.Get( key );
	private string L( string key, params object[] args ) => LocalizationManager.Get( key, args );

	public static AchievementPanel Instance { get; private set; }
	public static bool IsVisible { get; set; } = false;
	private string currentCategory = "all";
	private string _lastHoveredKey;

	// ──────────────────────────────────────────────
	// CATEGORY DEFINITIONS — id, label, iconify icon, accent color (hex)
	// ──────────────────────────────────────────────
	private record CategoryDef( string Id, string Label, string Icon, string Color );

	private static readonly CategoryDef[] CategoryDefs = new[]
	{
		new CategoryDef( "all",        "All",        "lucide:trophy",         "#fbbf24" ),
		new CategoryDef( "collection", "Collection", "lucide:layers",         "#38bdf8" ),
		new CategoryDef( "battle",     "Battle",     "lucide:swords",         "#ef4444" ),
		new CategoryDef( "expedition", "Expedition", "lucide:compass",        "#84cc16" ),
		new CategoryDef( "breeding",   "Fusion",     "lucide:git-merge",      "#ec4899" ),
		new CategoryDef( "economy",    "Economy",    "lucide:coins",          "#fbbf24" ),
		new CategoryDef( "arena",      "Arena",      "lucide:shield",         "#fb923c" ),
		new CategoryDef( "social",     "Social",     "lucide:users",          "#3b82f6" ),
		new CategoryDef( "mastery",    "Mastery",    "lucide:crown",          "#a78bfa" ),
		new CategoryDef( "secret",     "Secret",     "lucide:lock-keyhole",   "#4ade80" ),
	};

	private string GetCategoryColor( string id )
	{
		foreach ( var c in CategoryDefs ) if ( c.Id == id ) return c.Color;
		return "#a78bfa";
	}

	private string GetCategoryIcon( string id )
	{
		foreach ( var c in CategoryDefs ) if ( c.Id == id ) return c.Icon;
		return "lucide:star";
	}

	private string GetCategoryIdForAchievement( Achievement a )
	{
		return a.Category switch
		{
			AchievementCategory.Collection => "collection",
			AchievementCategory.Battle     => "battle",
			AchievementCategory.Expedition => "expedition",
			AchievementCategory.Breeding   => "breeding",
			AchievementCategory.Economy    => "economy",
			AchievementCategory.Arena      => "arena",
			AchievementCategory.Social     => "social",
			AchievementCategory.Mastery    => "mastery",
			AchievementCategory.Secret     => "secret",
			_ => "collection",
		};
	}

	// Convert hex like "#a78bfa" to rgba(167, 139, 250, alpha) for inline style.
	private string Hex2Rgba( string hex, float alpha )
	{
		if ( string.IsNullOrEmpty( hex ) || !hex.StartsWith( "#" ) || hex.Length != 7 ) return hex;
		var r = Convert.ToInt32( hex.Substring( 1, 2 ), 16 );
		var g = Convert.ToInt32( hex.Substring( 3, 2 ), 16 );
		var b = Convert.ToInt32( hex.Substring( 5, 2 ), 16 );
		return $"rgba({r}, {g}, {b}, {alpha.ToString( System.Globalization.CultureInfo.InvariantCulture )})";
	}

	// ──────────────────────────────────────────────
	// LIFECYCLE
	// ──────────────────────────────────────────────

	protected override void OnAfterTreeRender( bool firstTime )
	{
		if ( firstTime ) Instance = this;
	}

	public static void Show() { IsVisible = true; SoundManager.PlayPopup(); }
	public static void Close() { IsVisible = false; SoundManager.PlayPopdown(); }
	public static void Toggle() { IsVisible = !IsVisible; if ( IsVisible ) SoundManager.PlayPopup(); else SoundManager.PlayPopdown(); }

	// NOTE: Esc is reserved by s&box for the system pause / leave-game menu.
	// Close via overlay click + close button only — don't bind Escape.

	// Keyboard: the canonical Menu/run "back" keys close the panel. Only acts
	// while this is the top-priority open modal.
	public override void Tick()
	{
		base.Tick();
		if ( IsVisible && UIModalState.IsTopModal( "AchievementPanel" )
			&& ( Input.Pressed( "Menu" ) || Input.Pressed( "run" ) ) )
			Close();
	}

	private void OnHover( string key )
	{
		if ( _lastHoveredKey == key ) return;
		_lastHoveredKey = key;
		SoundManager.PlayHover();
	}

	private void SetCategory( string category )
	{
		if ( currentCategory == category ) return;
		SoundManager.PlayClick();
		currentCategory = category;
	}

	private void ClaimReward( string achievementId )
	{
		if ( AchievementManager.Instance?.ClaimReward( achievementId ) == true )
		{
			SoundManager.PlaySelect();
		}
	}

	private void ClaimAll()
	{
		if ( AchievementManager.Instance == null ) return;

		int claimed = 0;
		foreach ( var achievement in AchievementManager.Instance.AllAchievements )
		{
			if ( AchievementManager.Instance.ClaimReward( achievement.Id ) )
				claimed++;
		}

		if ( claimed > 0 )
		{
			SoundManager.PlaySelect();
			NotificationManager.Instance?.AddNotification(
				NotificationType.Success,
				L( "ui.achievement.rewards_claimed" ),
				L( "ui.achievement.rewards_collected", claimed, claimed > 1 ? "s" : "" )
			);
		}
	}

	// ──────────────────────────────────────────────
	// DATA
	// ──────────────────────────────────────────────

	private int GetUnlockedCount() => AchievementManager.Instance?.GetUnlockedCount() ?? 0;
	private int GetTotalCount() => AchievementManager.Instance?.GetTotalCount() ?? 0;
	private int GetUnclaimedCount() => AchievementManager.Instance?.GetUnclaimedCount() ?? 0;

	private int GetOverallPercent()
	{
		var total = GetTotalCount();
		if ( total == 0 ) return 0;
		return (int)((float)GetUnlockedCount() / total * 100);
	}

	private AchievementProgress GetProgress( string achievementId )
	{
		return AchievementManager.Instance?.GetProgress( achievementId );
	}

	private float GetAchievementPercent( string achievementId )
	{
		return (AchievementManager.Instance?.GetProgressPercent( achievementId ) ?? 0) * 100;
	}

	private List<Achievement> GetFilteredAchievements()
	{
		if ( AchievementManager.Instance == null ) return new();

		if ( currentCategory == "all" )
		{
			return AchievementManager.Instance.AllAchievements
				.OrderByDescending( a =>
				{
					var p = GetProgress( a.Id );
					if ( p?.IsUnlocked == true && p?.IsClaimed != true ) return 2;
					if ( p?.IsUnlocked != true ) return 1;
					return 0;
				} )
				.ThenBy( a => a.Order )
				.ToList();
		}

		var category = currentCategory switch
		{
			"collection" => AchievementCategory.Collection,
			"battle"     => AchievementCategory.Battle,
			"expedition" => AchievementCategory.Expedition,
			"breeding"   => AchievementCategory.Breeding,
			"economy"    => AchievementCategory.Economy,
			"arena"      => AchievementCategory.Arena,
			"social"     => AchievementCategory.Social,
			"mastery"    => AchievementCategory.Mastery,
			"secret"     => AchievementCategory.Secret,
			_ => AchievementCategory.Collection
		};

		return AchievementManager.Instance.GetByCategory( category );
	}

	private string GetProgressText( Achievement achievement, AchievementProgress progress )
	{
		if ( progress == null ) return $"0 / {achievement.RequiredValue:N0}";
		if ( progress.IsUnlocked ) return L( "ui.achievement.complete" );
		return $"{progress.CurrentValue:N0} / {achievement.RequiredValue:N0}";
	}

	// Reward icon mapping — iconify (lucide) instead of emoji.
	private string GetRewardIconify( AchievementReward reward )
	{
		return reward.Type switch
		{
			AchievementRewardType.Gold        => "lucide:coins",
			AchievementRewardType.Gems        => "lucide:gem",
			AchievementRewardType.BossTokens  => "lucide:shield",
			AchievementRewardType.ContractInk => "lucide:scroll-text",
			AchievementRewardType.Title       => "lucide:award",
			AchievementRewardType.Item        => "lucide:package",
			AchievementRewardType.Monster     => "lucide:paw-print",
			_ => "lucide:sparkles"
		};
	}

	private string GetRewardColor( AchievementReward reward )
	{
		return reward.Type switch
		{
			AchievementRewardType.Gold        => "#fbbf24",
			AchievementRewardType.Gems        => "#a78bfa",
			AchievementRewardType.BossTokens  => "#fb923c",
			AchievementRewardType.ContractInk => "#7dd3fc",
			AchievementRewardType.Title       => "#fcd34d",
			AchievementRewardType.Item        => "#86efac",
			AchievementRewardType.Monster     => "#c4b5fd",
			_ => "#c4b5fd"
		};
	}

	private string GetRewardText( AchievementReward reward )
	{
		return reward.Type switch
		{
			AchievementRewardType.Gold        => L( "ui.achievement.reward_gold", reward.Value.ToString( "N0" ) ),
			AchievementRewardType.Gems        => L( "ui.achievement.reward_gems", reward.Value ),
			AchievementRewardType.BossTokens  => L( "ui.achievement.reward_boss_tokens", reward.Value ),
			AchievementRewardType.ContractInk => L( "ui.achievement.reward_contract_ink", reward.Value ),
			AchievementRewardType.Title       => L( "ui.achievement.reward_title", reward.ItemId ),
			AchievementRewardType.Item        => L( "ui.achievement.reward_item", reward.ItemId ),
			AchievementRewardType.Monster     => L( "ui.achievement.reward_monster", reward.SpeciesId ),
			_ => L( "ui.achievement.reward_unknown" )
		};
	}

	private string GetEmptyIcon() => currentCategory switch
	{
		"secret" => "lucide:lock-keyhole",
		_ => "lucide:trophy"
	};

	private string GetEmptyTitle() => currentCategory switch
	{
		"secret" => "Nothing revealed yet",
		_ => "No achievements here"
	};

	// ──────────────────────────────────────────────
	// ROW RENDERER
	// ──────────────────────────────────────────────

	private RenderFragment RenderAchievementRow( Achievement achievement ) => __builder =>
	{
		var progress = GetProgress( achievement.Id );
		var isUnlocked = progress?.IsUnlocked ?? false;
		var isClaimed = progress?.IsClaimed ?? false;
		var isSecret = achievement.IsSecret && !isUnlocked;
		var canClaim = isUnlocked && !isClaimed;
		var catId = GetCategoryIdForAchievement( achievement );
		var catColor = GetCategoryColor( catId );
		var catIcon = GetCategoryIcon( catId );

		var stateClass = isClaimed ? "claimed" : (canClaim ? "claimable" : (isUnlocked ? "unlocked" : "locked"));

		<div class="ach-row state-@stateClass cat-@catId">

			@* Left: category-tinted icon diamond (or lock if hidden secret) *@
			<div class="ach-icon-col">
				<div class="ach-icon-frame"
					 style="@(isSecret ? "" : $"background-color: {Hex2Rgba(catColor, 0.18f)}; border-color: {Hex2Rgba(catColor, 0.65f)};")">
					<iconify icon="@(isSecret ? "lucide:lock-keyhole" : catIcon)"
							 Size=@(20)
							 Color="@(isSecret ? "rgba(255, 255, 255, 0.45)" : catColor)" />
				</div>
				@if (canClaim)
				{
					<div class="claim-pulse"></div>
				}
			</div>

			@* Middle: title + desc + progress + rewards *@
			<div class="ach-body">
				<div class="ach-name-row">
					<span class="ach-name">@(isSecret ? "???" : achievement.Name)</span>
					@if (isClaimed)
					{
						<div class="ach-state-pill claimed-pill">
							<iconify icon="lucide:check" Size=@(10) Color="#4ade80" />
							<span>@L("ui.achievement.claimed")</span>
						</div>
					}
					else if (canClaim)
					{
						<div class="ach-state-pill claimable-pill">
							<iconify icon="lucide:gift" Size=@(10) Color="#fcd34d" />
							<span>READY</span>
						</div>
					}
				</div>
				<span class="ach-desc">@(isSecret ? L("ui.achievement.secret_desc") : achievement.Description)</span>

				@if (!isUnlocked && !isSecret)
				{
					var percent = GetAchievementPercent(achievement.Id);
					<div class="ach-progress-row">
						<div class="ach-progress-bar">
							<div class="ach-progress-fill" style="width: @(percent)%; background-color: @catColor;"></div>
						</div>
						<span class="ach-progress-text">@GetProgressText(achievement, progress)</span>
					</div>
				}

				@if (!isSecret && achievement.Rewards?.Count > 0)
				{
					<div class="ach-rewards-row">
						@foreach (var reward in achievement.Rewards)
						{
							var rwColor = GetRewardColor(reward);
							<div class="ach-reward-pill @(isClaimed ? "collected" : "")"
								 style="@(isClaimed ? "" : $"background-color: {Hex2Rgba(rwColor, 0.12f)}; border-color: {Hex2Rgba(rwColor, 0.55f)};")">
								<iconify icon="@GetRewardIconify(reward)" Size=@(13) Color="@(isClaimed ? "rgba(255, 255, 255, 0.45)" : rwColor)" />
								<span style="@(isClaimed ? "" : $"color: {rwColor};")">@GetRewardText(reward)</span>
							</div>
						}
					</div>
				}
			</div>

			@* Right: claim button (when claimable) — primary purple with gold hint *@
			@if (canClaim)
			{
				<button class="claim-btn"
						onclick=@(() => ClaimReward(achievement.Id))
						onmouseover=@(() => OnHover("claim-" + achievement.Id))>
					<iconify icon="lucide:gift" Size=@(13) Color="#ffffff" />
					<span>@L("ui.achievement.claim")</span>
				</button>
			}
		</div>
	};

	// ──────────────────────────────────────────────
	// HASH
	// ──────────────────────────────────────────────

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add( IsVisible );
		hash.Add( currentCategory );
		hash.Add( GetUnlockedCount() );
		hash.Add( GetTotalCount() );
		hash.Add( GetUnclaimedCount() );
		// Include progress sum so re-renders fire when an achievement progresses.
		if ( AchievementManager.Instance != null )
		{
			int progressSum = 0;
			foreach ( var a in AchievementManager.Instance.AllAchievements )
			{
				var p = AchievementManager.Instance.GetProgress( a.Id );
				progressSum += (int)(p?.CurrentValue ?? 0);
				progressSum += (p?.IsClaimed ?? false) ? 1 : 0;
			}
			hash.Add( progressSum );
		}
		return hash.ToHashCode();
	}
}
