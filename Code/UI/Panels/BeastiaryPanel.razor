@namespace Beastborne.UI.Panels
@using Sandbox;
@using Sandbox.UI;
@using Beastborne.Core;
@using Beastborne.Data;
@using Beastborne.Systems;
@using Beastborne.UI.Components;
@using Beastborne.UI.Primitives;
@inherits Panel

<root class="beastbook-panel" onclick=@OnPanelClicked>
	<!-- v10 living background: the panels own glyph drifting at the
	     house angle (user concept). Replaces animated-bg.webp. -->
	<BbIconScroll Icon="beastbook" />

	<!-- ============================================================
	     HEADER — museum/archive identity row (2026-07 sweep). Teal
	     kicker + huge italic title + skewed seam dashes on the left
	     (roster .rh-* silhouette, Beastbook teal), FilterBar pushed
	     right, completion HERO STAT as the archive's headline number.
	     Opaque bg + the ONE teal signature strip (scroll-leak law).
	     ============================================================ -->
	<div class="beastbook-header">
		<div class="bh-identity">
			<span class="bh-kicker">FIELD ARCHIVE</span>
			<div class="bh-title-row">
				<span class="bh-title">@L("ui.beastiary.title")</span>
				<div class="bh-seam"></div>
				<div class="bh-seam dim"></div>
			</div>
		</div>
		<div class="header-filters">
			<FilterBar @ref="filterBar"
					   CurrentElement=@currentElementStr
					   CurrentSort=@currentSort
					   SortAscending=@sortAscending
					   ShowBeastiarySort=@true
					   HideMonsterOnlySorts=@true
					   OnElementChanged=@OnElementChanged
					   OnSortChanged=@OnSortChanged
					   OnSortDirectionChanged=@OnSortDirectionChanged
					   OnNameFilterChanged=@OnNameFilterChanged
					   AvailableNames=@GetSpeciesNames() />
			<div class="kb-hint beastbook-kb-hint">
				<div class="cb-key kb-cap"><span>Z</span></div>
				<div class="cb-key kb-cap"><span>X</span></div>
				<span class="kb-hint-label">Cycle element</span>
			</div>
		</div>
	</div>

	<!-- ============================================================
	     BODY — THE MUSEUM WALL (2026-07 structural rebuild).
	     Three zones, left to right:
	       INDEX RAIL   — compact spine of specimen slots (sprite thumb
	                      or silhouette recess) + the completion hero
	                      stat as the rail's head plaque.
	       SHOWCASE     — ONE species commands a giant lit exhibit:
	                      huge pixelated sprite over a teal pedestal,
	                      registry-number watermark behind.
	       PLACARD      — the gallery label column: identity, flavor,
	                      diamond actions, swappable deep views.
	     Same behavior as before (keyboard nav, Z/X cycle, Space
	     handoff, scroll-follow) — the zones moved, the flows didn't.
	     ============================================================ -->
	<div class="bb-body">
		<div class="bb-rail">
			@{
				var pct = GetCompletionPercent();
				var isMilestone = pct >= 25 && (pct == 25 || pct == 50 || pct == 75 || pct == 100);
			}
			<!-- Completion hero stat — the archive's headline number. Big
			     italic count, skewed teal % chip, progress rail. Flips gold
			     on 25/50/75/100 milestones (an earned beat, not a rolled one). -->
			<div class="bb-rail-head @(isMilestone ? "milestone" : "")">
				<div class="bh-comp-row">
					<span class="bh-comp-count">@GetDiscoveredCount()</span>
					<span class="bh-comp-max">/ @GetTotalCount()</span>
					<div class="bh-comp-pct"><span>@(pct)%</span></div>
				</div>
				<div class="bh-comp-bar"><div class="bh-comp-fill" style="width: @(pct)%"></div></div>
				<span class="bh-comp-label">@L("ui.beastbook.bound")</span>
			</div>
				@* `bb-edit-no-scroll` toggles overflow-y to hidden while editing
				   so the wheel event reaches BeastiaryPanel.OnMouseWheel
				   instead of being consumed by the scroll container's
				   built-in handler. Toggle EDIT off to scroll normally. *@
				<div class="beastbook-grid @(_editMode ? "bb-edit-no-scroll" : "")" @ref="bbGridPanel">
					@{
						var filteredSpecies = GetFilteredSpecies();
					}
					@if (filteredSpecies.Count == 0)
					{
						<EmptyState Icon="lucide:search-x"
									Title=@L("ui.beastbook.no_match")
									Body=@L("ui.beastbook.no_match_hint")
									Size="full" />
					}
					else
					{
						@for (int gi = 0; gi < filteredSpecies.Count; gi++)
						{
							var species = filteredSpecies[gi];
							var isDiscovered = IsDiscovered(species.Id);
							var isSeen = IsSeen(species.Id);
							var stateClass = isDiscovered ? "discovered" : (isSeen ? "seen" : "undiscovered");
							var isSelected = selectedSpecies?.Id == species.Id;
							var primaryClass = species.Element.ToString().ToLower();
							var elementClass = $"element-{primaryClass}";
							var rarityClassCard = $"rarity-{species.BaseRarity.ToString().ToLower()}";
							// Per-card entrance stagger — small, capped delay so the
							// grid "deals in" on open instead of snapping as one block.
							// Capped at 16 cards (~0.4s) so a large filtered set never
							// drips in slowly; cards past the cap share the final delay.
							// Skipped entirely in edit mode (drag/scale needs instant
							// repaint). InvariantCulture for the `.` decimal s&box needs.
							var gci = System.Globalization.CultureInfo.InvariantCulture;
							var cardDelay = _editMode ? 0f : Math.Min(gi, 16) * 0.025f;
							var cardDelayStyle = $"animation-delay: {cardDelay.ToString("F3", gci)}s;";
							// Card = flat uniform #0c0a18 bg for every card. Element color
							// is bounded to the small square badge(s) in the bottom strip —
							// no per-card tint floods anymore. Rarity = border color + thickness.
							// Number = LV-style dark pill in the top-left corner.
							<div class="bb-card @stateClass @elementClass @rarityClassCard @(isSelected ? "selected" : "") @(_editMode ? "bb-edit" : "") @(_editMode && _hoveredEditCardId == species.Id ? "bb-edit-hover" : "")"
								 style="@cardDelayStyle"
								 onclick=@(() => { if (!_editMode) SelectSpecies(species, isDiscovered); })
								 onmousedown=@(() => StartDragCard(species))
								 onmouseover=@(() => { OnCardHover(species.Id); OnEditCardEnter(species.Id); })
								 onmouseout=@(() => OnEditCardLeave(species.Id))>

								@if (justSelectedSpeciesId == species.Id)
								{
									<!-- One-shot select pulse. `pulse-@selectPulseVersion`
									     remounts the div every click so @keyframes re-fires
									     (s&box only plays keyframes on first DOM mount).
									     Rarity class flows through so the pulse border color
									     can match the beast's rarity tier — signature beastbook
									     touch vs the shop's single purple. -->
									<div class="select-pulse pulse-@selectPulseVersion @rarityClassCard"></div>
								}

								<!-- Micro registry number — bottom-left corner tag, museum
								     index style. INSIDE the tile bounds (scroll-clip law).
								     Hidden on undiscovered so we don't leak the number. -->
								@if (isDiscovered || isSeen)
								{
									<div class="bb-tile-num"><span>@species.BeastiaryNumber.ToString("D3")</span></div>
								}

								<!-- Rarity strip — thin colored line at the bottom of the card.
								     Only visible for discovered beasts (don't leak rarity). -->
								@if (isDiscovered)
								{
									<div class="bb-card-rarity-strip @rarityClassCard"></div>
								}

								<!-- Portrait — fills most of the card, bottom-aligned.
								     CardScale + CardOffsetX/Y (per-species data overrides,
								     defaults 1.0 / 0 / 0) are composed into a single transform
								     on the container so that native sprite-size and anchor
								     mismatches can be normalized without touching the shared
								     grid layout. Scale origin is center bottom so the sprite
								     scales up from the feet and stays grounded in the card.
								     InvariantCulture on the float formatting — s&box CSS
								     needs `.` not `,` regardless of the host machine locale.
								     The img's own hover translate still composes inside. -->
								@{
									var ci = System.Globalization.CultureInfo.InvariantCulture;
									var artVals = GetCardArt(species);
									var cardOx = artVals.OffX.ToString("F2", ci);
									var cardOy = artVals.OffY.ToString("F2", ci);
									var cardSc = artVals.Scale.ToString("F2", ci);
									var cardTransform = $"transform: translate({cardOx}px, {cardOy}px) scale({cardSc}); transform-origin: center bottom;";
								}
								<div class="bb-card-portrait" style="@cardTransform">
									@if (HasSprite(species))
									{
										<img class="bb-card-sprite @(isSeen && !isDiscovered ? "seen-only" : "") @(!isDiscovered && !isSeen ? "silhouette" : "")" src="@GetAnimatedIcon(species)" />
									}
									else
									{
										<div class="bb-card-unknown">?</div>
									}
								</div>

								<!-- No name strip / element badges on the index slot — the
								     museum wall carries identity on the STAGE + PLACARD.
								     The slot is a compact numbered specimen thumb. -->

								<!-- Hover-preview ring — cheap per-card recipe (opacity swap
								     on :hover). INSET inside the card bounds (scroll containers
								     never clip overhanging absolutes — engine law) and given
								     explicit width/height (all-edge offsets = zero size on an
								     empty div). The keyboard/selection cursor is the ONE living
								     ring at panel root — this is just the mouse preview. -->
								<div class="bb-card-ring"></div>

							</div>
						}
					}
				</div>
		</div>

		<!-- ============================================================
		     SHOWCASE STAGE — the museum wall's exhibit. One species,
		     giant animated sprite (pixelated, never filtered except the
		     undiscovered silhouette), teal-lit pedestal, registry-number
		     watermark behind. Click = zoom/inspect popup (same handler
		     the old portrait used). Remounts per species via the drev
		     key so the entrance keyframes replay (proven pattern).
		     ============================================================ -->
		<div class="bb-stage">
			@if (selectedSpecies == null)
			{
				<div class="bb-stage-empty">
					<iconify icon="lucide:book-open" Size=@(72) Color="rgba(255,255,255,0.10)" />
					<span class="bb-stage-empty-text">@L("ui.beastbook.empty_state")</span>
					<span class="bb-stage-empty-hint">@L("ui.beastbook.empty_hint")</span>
				</div>
			}
			else
			{
				var stageDiscovered = IsDiscovered(selectedSpecies.Id);
				var stageSeen = IsSeen(selectedSpecies.Id);
				<div class="@($"bb-stage-wall drev-{detailRevealVersion}")">
					<div class="bb-stage-num"><span>@(stageDiscovered || stageSeen ? "#" + selectedSpecies.BeastiaryNumber.ToString("D3") : "#???")</span></div>
					<div class="bb-stage-exhibit"
						 onclick=@OnPortraitClick
						 onmouseover=@(() => OnDiamondHover("portrait"))
						 title="@L("ui.beastbook.click_to_hear")">
						<div class="bb-stage-glow"></div>
						@if (HasSprite(selectedSpecies))
						{
							<img class="bb-stage-sprite @(stageDiscovered ? "" : (stageSeen ? "seen-only" : "silhouette"))" src="@GetAnimatedIcon(selectedSpecies)" />
						}
						else
						{
							<div class="bb-stage-unknown">?</div>
						}
					</div>
					<div class="bb-stage-pedestal"></div>
				</div>
			}
		</div>

		<!-- ============================================================
		     PLACARD — the gallery label column. Identity block, flavor
		     quote, diamond actions, swappable deep views (stats / moves /
		     evolution / lore / mastery). The sprite itself lives on the
		     stage now — the placard is pure reading. Keeps the class name
		     `detail-sidebar` so the cascade/scroll rules carry over.
		     ============================================================ -->
		<div class="detail-sidebar entered">

				@if (selectedSpecies == null)
				{
					<!-- Empty state -->
					<div class="bb-empty">
						<iconify icon="lucide:book-open" Size=@(72) Color="rgba(255,255,255,0.12)" />
						<span class="bb-empty-text">@L("ui.beastbook.empty_state")</span>
						<span class="bb-empty-hint">@L("ui.beastbook.empty_hint")</span>
					</div>
				}
				else if (!IsDiscovered(selectedSpecies.Id) && !IsSeen(selectedSpecies.Id))
				{
					<!-- Undiscovered state -->
					<div class="bb-empty">
						<iconify icon="lucide:help-circle" Size=@(72) Color="rgba(255,255,255,0.12)" />
						<span class="bb-empty-text">???</span>
						<span class="bb-empty-hint">@L("ui.beastbook.find_hint")</span>
					</div>
				}
				else
				{
					var isFullyDiscovered = IsDiscovered(selectedSpecies.Id);
					var primaryClass = selectedSpecies.Element.ToString().ToLower();
					var secondaryClass = selectedSpecies.SecondaryElement.HasValue
						? selectedSpecies.SecondaryElement.Value.ToString().ToLower()
						: null;

					<!-- ============================================================
					     FIXED TOP — portrait + identity + description. Does NOT
					     scroll. Pinned so the beast + its flavor stay visible no
					     matter which swappable view is active below.
					     ============================================================ -->
					<div class="@($"bb-detail-fixed detail-rev-{detailRevealVersion}")">

						<!-- ====== IDENTITY BLOCK (placard header) ======
						     The portrait moved to the SHOWCASE STAGE — the placard
						     opens straight on the identity read. Render-key token
						     (`drev-N`) on every entrance-animated element below so
						     s&box remounts THAT element on species change and its
						     mount-time @keyframes replay. A version class on the
						     parent `.bb-detail-fixed` alone does NOT remount
						     descendants — the token must live on each animated node. -->
						<div class="@($"bb-portrait-section drev-{detailRevealVersion}")">

							<!-- Identity block — strict VERTICAL STACK.
							     Row 1 (line 1): #num pill alone.
							     Row 2 (line 2): big name.
							     Row 3 (line 3): element pill(s) with icon + full name label.
							     Row 4 (line 4): rarity badge + BST badge on their own row.
							     Per user feedback — number on top, name below, element beneath
							     with its full word, stats+rarity as a final summary row. -->
							<div class="bb-name-section">
								<div class="@($"bb-identity-row-num drev-{detailRevealVersion}")">
									<div class="bb-number-pill">
										<span>#@selectedSpecies.BeastiaryNumber.ToString("D3")</span>
									</div>
								</div>
								<div class="@($"bb-identity-row-name drev-{detailRevealVersion}")">
									<div class="bb-name">@selectedSpecies.Name</div>
								</div>
								@if (isFullyDiscovered || IsSeen(selectedSpecies.Id))
								{
									<!-- Element pills — own row. Dual-type (FIRE + SHADOW)
									     sits horizontally, wraps only if column gets cramped. -->
									<div class="@($"bb-identity-elements-row drev-{detailRevealVersion}")">
										<div class="bb-pill element-@primaryClass bb-element-pill-full">
											<img src="ui/icons/elements/element_white/@(primaryClass).svg" />
											<span>@primaryClass.ToUpper()</span>
										</div>
										@if (secondaryClass != null)
										{
											<div class="bb-pill element-@secondaryClass bb-element-pill-full">
												<img src="ui/icons/elements/element_white/@(secondaryClass).svg" />
												<span>@secondaryClass.ToUpper()</span>
											</div>
										}
									</div>
								}
								@if (isFullyDiscovered)
								{
									<!-- Rarity + BST row — sits directly under the element pills
									     so the "what kind of beast" summary reads top-down as
									     element → rarity/stats → personality (identity trailer). -->
									<div class="@($"bb-identity-row-bottom drev-{detailRevealVersion}")">
										<div class="bb-rarity-badge rarity-@selectedSpecies.BaseRarity.ToString().ToLower()">
											<span>@selectedSpecies.BaseRarity.ToString().ToUpper()</span>
										</div>
										<div class="bb-bst-badge">
											<span class="bb-bst-label">BST</span>
											<span class="bb-bst-value">@GetBaseStatTotal(selectedSpecies)</span>
										</div>
										@if (!selectedSpecies.IsCatchable)
										{
											<span class="zd-no-contract">CANNOT CONTRACT</span>
										}
									</div>
									<!-- Personality pill — standalone, no label. Sits below
									     rarity/BST so the identity block reads: type → tier →
									     character. Label dropped per user feedback — other rows
									     don't have labels, so this one shouldn't either. Tiny
									     iconify prefix (lucide:user) gives the pill a shape
									     distinct from the element pills (which use element
									     glyphs) without coloring it like a third element. -->
									<div class="@($"bb-identity-personality-row drev-{detailRevealVersion}")">
										<div class="bb-pill personality bb-personality-pill-inline">
											<iconify icon="lucide:user" Size=@(11) Color="rgba(255,255,255,0.7)" />
											<span>@selectedSpecies.Personality.ToString().ToUpper()</span>
										</div>
									</div>
								}
							</div>
						</div>

						<!-- ====== FLAVOR DESCRIPTION ======
						     MOVED UP from inside the stats view — lives in the fixed
						     top so it's always visible regardless of which swappable
						     view is active. Core identity, not view-specific content. -->
						@if (isFullyDiscovered && !string.IsNullOrEmpty(selectedSpecies.Description))
						{
							<div class="@($"bb-flavor drev-{detailRevealVersion}")"><span>@selectedSpecies.Description</span></div>
						}
						else if (!isFullyDiscovered && (IsDiscovered(selectedSpecies.Id) || IsSeen(selectedSpecies.Id)))
						{
							<div class="@($"bb-flavor drev-{detailRevealVersion}")"><span>???</span></div>
						}

					</div>

					<!-- ============================================================
					     SCROLLABLE BODY — actions, mastery, swappable view, footer.
					     Direct children only (s&box scroll-height quirk).
					     ============================================================ -->
					<div class="@($"bb-detail-scroll {(detailFreshSelect ? "casc-select" : "casc-switch")}")">

						<!-- ====== ACTIONS — diamond row ======
						     Cry / Moves / Evolution / Lore / Mastery. First thing in the
						     scroll area — primary navigation for the swappable bottom view. -->
						@if (isFullyDiscovered)
						{
							var moveCount = selectedSpecies.LearnableMoves?.Count ?? 0;
							var hasEvolution = GetEvolutionChain(selectedSpecies).Count > 1;
							<div class="@($"bb-actions-section drev-{detailRevealVersion}")">
								<div class="bb-section-title"><span>ACTIONS</span></div>
								<div class="bb-diamond-row">

								<!-- 1. Cry — plays beast cry, does NOT switch views -->
								<div class="bb-detail-diamond cry @(IsDetailActionFocused("cry") ? "kb-focused" : "")" onclick=@OnPortraitClick onmouseover=@(() => OnDiamondHover("cry"))>
									<div class="bb-diamond-shape"><iconify icon="lucide:volume-2" Size=@(16) Color="#c4b5fd" /></div>
									<span class="bb-diamond-tooltip">@L("ui.beastbook.click_to_hear")</span>
								</div>

								<!-- 2. Moves — toggles bottom section to moves view -->
								<div class="bb-detail-diamond moves @(detailView == "moves" ? "active" : "") @(IsDetailActionFocused("moves") ? "kb-focused" : "")" onclick=@(() => OnDiamondClick("moves")) onmouseover=@(() => OnDiamondHover("moves"))>
									<div class="bb-diamond-shape"><iconify icon="lucide:sparkles" Size=@(16) Color="white" /></div>
									<div class="bb-diamond-badge"><span>@moveCount</span></div>
									<span class="bb-diamond-tooltip">@L("ui.beastbook.learns_moves", moveCount)</span>
								</div>

								<!-- 3. Evolution — toggles bottom section to evolution view -->
								@if (hasEvolution)
								{
									<div class="bb-detail-diamond evolution @(detailView == "evolution" ? "active" : "") @(IsDetailActionFocused("evolution") ? "kb-focused" : "")" onclick=@(() => OnDiamondClick("evolution")) onmouseover=@(() => OnDiamondHover("evolution"))>
										<div class="bb-diamond-shape"><iconify icon="lucide:git-fork" Size=@(16) Color="#7dd3fc" /></div>
										<span class="bb-diamond-tooltip">View evolution line</span>
									</div>
								}

								<!-- 4. Lore — toggles bottom section to lore view -->
								<div class="bb-detail-diamond lore @(detailView == "lore" ? "active" : "") @(IsDetailActionFocused("lore") ? "kb-focused" : "")" onclick=@(() => OnDiamondClick("lore")) onmouseover=@(() => OnDiamondHover("lore"))>
									<div class="bb-diamond-shape"><iconify icon="lucide:scroll" Size=@(16) Color="#fcd34d" /></div>
									<span class="bb-diamond-tooltip">@(detailView == "lore" ? "Hide lore" : "Read lore")</span>
								</div>

								<!-- 5. Mastery — toggles bottom section to mastery view -->
								<div class="bb-detail-diamond mastery @(detailView == "mastery" ? "active" : "") @(IsDetailActionFocused("mastery") ? "kb-focused" : "")" onclick=@(() => OnDiamondClick("mastery")) onmouseover=@(() => OnDiamondHover("mastery"))>
									<div class="bb-diamond-shape"><iconify icon="lucide:crown" Size=@(16) Color="#c4b5fd" /></div>
									<span class="bb-diamond-tooltip">@(detailView == "mastery" ? "Hide mastery" : "View mastery")</span>
								</div>
								</div>
							</div>
						}

						<!-- ============================================================
						     SWAPPABLE BOTTOM SECTION — controlled by detailView state.
						     Diamonds toggle between stats/moves/evolution/lore/mastery.
						     Personality + traits live in the fixed top (see CHARACTER
						     section above) — identity, not stats. Stats view shows only
						     the stat bars + BST total.
						     ============================================================ -->
						@if (isFullyDiscovered)
						{
							<!-- ====== STATS VIEW (default) — stats bars only; description
							     lives in the fixed top now so it's always visible. ====== -->
							@if (detailView == "stats")
							{
								<div class="@($"bb-stats-section drev-{detailRevealVersion}")">
									<div class="bb-section-title"><span>@L("ui.beastiary.base_stats")</span></div>
									<div class="bb-stats-grid">
										<!-- Compact single-line stat rows — LABEL | BAR | VALUE.
										     Fixed-width label column (36px) + fixed-width value
										     column (30px) means every row's columns line up
										     vertically across the six stats. Bar gets flex: 1
										     to fill the middle. Hover tints the row bg subtly —
										     Tier 1 ambient "this is inspectable" feedback. -->
										<div class="bb-stat-item hp">
											<span class="bb-stat-name">HP</span>
											<div class="bb-stat-bar-bg">
												<div class="bb-stat-bar-fill hp" style="width: @(GetStatFillPct(selectedSpecies.BaseHP))%"></div>
											</div>
											<span class="bb-stat-value">@selectedSpecies.BaseHP</span>
										</div>
										<div class="bb-stat-item atk">
											<span class="bb-stat-name">ATK</span>
											<div class="bb-stat-bar-bg">
												<div class="bb-stat-bar-fill atk" style="width: @(GetStatFillPct(selectedSpecies.BaseATK))%"></div>
											</div>
											<span class="bb-stat-value">@selectedSpecies.BaseATK</span>
										</div>
										<div class="bb-stat-item def">
											<span class="bb-stat-name">DEF</span>
											<div class="bb-stat-bar-bg">
												<div class="bb-stat-bar-fill def" style="width: @(GetStatFillPct(selectedSpecies.BaseDEF))%"></div>
											</div>
											<span class="bb-stat-value">@selectedSpecies.BaseDEF</span>
										</div>
										<div class="bb-stat-item spa">
											<span class="bb-stat-name">SpA</span>
											<div class="bb-stat-bar-bg">
												<div class="bb-stat-bar-fill spa" style="width: @(GetStatFillPct(selectedSpecies.BaseSpA))%"></div>
											</div>
											<span class="bb-stat-value">@selectedSpecies.BaseSpA</span>
										</div>
										<div class="bb-stat-item spd-def">
											<span class="bb-stat-name">SpD</span>
											<div class="bb-stat-bar-bg">
												<div class="bb-stat-bar-fill spd-def" style="width: @(GetStatFillPct(selectedSpecies.BaseSpD))%"></div>
											</div>
											<span class="bb-stat-value">@selectedSpecies.BaseSpD</span>
										</div>
										<div class="bb-stat-item spd">
											<span class="bb-stat-name">SPD</span>
											<div class="bb-stat-bar-bg">
												<div class="bb-stat-bar-fill spd" style="width: @(GetStatFillPct(selectedSpecies.BaseSPD))%"></div>
											</div>
											<span class="bb-stat-value">@selectedSpecies.BaseSPD</span>
										</div>
										<!-- BST total row — inline summary so the bars resolve to a number. -->
										<div class="bb-stat-total-row">
											<span class="bb-stat-total-label">TOTAL</span>
											<span class="bb-stat-total-value">@GetBaseStatTotal(selectedSpecies)</span>
										</div>
										<!-- TRAITS row — sits at the very bottom of the stats
										     view, below TOTAL. Compact inline format: mini-label
										     on the left, wrapping trait pills on the right. Hidden
										     entirely if the species has no possible traits. -->
										@if (selectedSpecies.PossibleTraits != null && selectedSpecies.PossibleTraits.Count > 0)
										{
											<div class="bb-stat-traits-row">
												<span class="bb-stat-traits-label">TRAITS</span>
												<div class="bb-stat-traits-pills">
													@foreach (var traitId in selectedSpecies.PossibleTraits)
													{
														var trait = TraitDatabase.GetTrait(traitId);
														var traitName = trait?.Name ?? traitId;
														var traitDesc = trait?.Description ?? "";
														var traitIcon = string.IsNullOrEmpty(trait?.Icon) ? "lucide:zap" : trait.Icon;
														var isHovered = hoveredTraitId == traitId;
														var capturedId = traitId;
														<div class="bb-pill trait has-tooltip @(isHovered ? "is-hovered" : "")"
															 onmouseover=@(() => OnTraitHover(capturedId))
															 onmouseout=@(() => OnTraitOut(capturedId))>
															<iconify icon="@traitIcon" Size=@(11) Color="#ffffff" />
															<span>@traitName</span>
															@if (!string.IsNullOrEmpty(traitDesc))
															{
																<div class="bb-trait-tooltip"
																	 onmouseover=@(() => OnTraitHover(capturedId))>
																	<div class="bb-trait-tt-name">@traitName</div>
																	<div class="bb-trait-tt-desc">@traitDesc</div>
																</div>
															}
														</div>
													}
												</div>
											</div>
										}
									</div>
								</div>
							}

							<!-- ====== MOVES VIEW ====== -->
							@if (detailView == "moves")
							{
								var moves = selectedSpecies.LearnableMoves ?? new List<LearnableMove>();
								<div class="@($"bb-moves-section drev-{detailRevealVersion}")">
									<div class="bb-section-title">
										<span>MOVES</span>
										@if (moves.Count > 0)
										{
											<span class="bb-section-count-badge">@moves.Count @L("ui.roster.available")</span>
										}
									</div>
									@if (moves.Count == 0)
									{
										<div class="bb-moves-empty">
											<iconify icon="lucide:sparkles" Size=@(36) Color="rgba(255,255,255,0.2)" />
											<span>@L("ui.beastbook.moves_empty")</span>
										</div>
									}
									else
									{
										<div class="bb-moves-list">
											@foreach (var lm in moves.OrderBy(m => m.LearnLevel))
											{
												var moveDef = MoveDatabase.GetMove(lm.MoveId);
												var moveName = moveDef?.Name ?? lm.MoveId;
												var moveEl = moveDef != null ? moveDef.Element.ToString().ToLower() : "neutral";
												var moveCat = moveDef?.Category.ToString() ?? "";
												var movePwr = moveDef?.BasePower ?? 0;
												var moveAcc = moveDef?.Accuracy ?? 0;
												<!-- Move row — strict 4-column grid. Diamond (40px) |
												     name+level column (flex) | category pill (50px) |
												     power/accuracy stacked (60px, right-aligned). Fixed
												     widths so every row's columns line up regardless of
												     name length. Hover sound guarded via move id so the
												     same row doesn't re-fire every frame. -->
												<div class="bb-move-row @moveEl" onmouseover=@(() => OnMoveRowHover(lm.MoveId))>
													<div class="bb-move-diamond-col">
														<div class="bb-move-diamond @moveEl">
															<img class="bb-move-diamond-icon" src="ui/icons/elements/element_white/@(moveEl).svg" />
														</div>
													</div>
													<div class="bb-move-info">
														<span class="bb-move-name">@moveName</span>
														<span class="bb-move-level">Lv.@lm.LearnLevel</span>
													</div>
													<div class="bb-move-cat-col">
														@if (!string.IsNullOrEmpty(moveCat))
														{
															<span class="bb-move-cat @moveCat.ToLower()">@moveCat.Substring(0, 3).ToUpper()</span>
														}
													</div>
													<div class="bb-move-stats-col">
														@if (movePwr > 0)
														{
															<span class="bb-move-pwr">@movePwr</span>
														}
														@if (moveAcc > 0)
														{
															<span class="bb-move-acc">@(moveAcc)%</span>
														}
													</div>
												</div>
											}
										</div>
									}
								</div>
							}

							<!-- ====== EVOLUTION VIEW — connected diamond nodes ====== -->
							@if (detailView == "evolution")
							{
								var evolutionChain = GetEvolutionChain(selectedSpecies);
								@if (evolutionChain.Count > 1)
								{
									<div class="@($"bb-evo-section drev-{detailRevealVersion}")">
										<div class="bb-section-title"><span>@L("ui.beastbook.evolution")</span></div>
										<!-- Connected DIAMOND nodes (the action-shape dialect).
										     Each node = a 45°-rotated diamond backplate with the
										     sprite floating unclipped ON TOP (clean-first: the
										     sprite is the star, the diamond is the node shape —
										     no overflow-clip gamble on rotated elements). The
										     evolve level rides the CONNECTOR between nodes,
										     where the transition actually happens. -->
										<div class="bb-evo-chain">
											@for (int i = 0; i < evolutionChain.Count; i++)
											{
												var evoSpecies = evolutionChain[i];
												var isCurrent = evoSpecies.Id == selectedSpecies.Id;
												var evoDiscovered = IsDiscovered(evoSpecies.Id);

												@if (i > 0)
												{
													var prevEvo = evolutionChain[i - 1];
													<div class="bb-evo-link">
														@if (prevEvo.EvolutionLevel > 0)
														{
															<span class="bb-evo-link-lv">LV @prevEvo.EvolutionLevel</span>
														}
														<div class="bb-evo-link-bar"></div>
													</div>
												}

												<div class="bb-evo-node @(isCurrent ? "current" : "") @(evoDiscovered ? "" : "unknown")"
													 onmouseover=@(() => OnEvoStageHover(evoSpecies.Id))>
													<div class="bb-evo-diamond-wrap">
														<div class="bb-evo-diamond"></div>
														@if (evoDiscovered && HasSprite(evoSpecies))
														{
															<img class="bb-evo-sprite" src="@(isCurrent ? GetAnimatedIcon(evoSpecies) : evoSpecies.IconPath)" />
														}
														else
														{
															<span class="bb-evo-unknown">?</span>
														}
														@if (isCurrent)
														{
															<div class="bb-evo-here-stamp"><span>HERE</span></div>
														}
													</div>
													<span class="bb-evo-name">@(evoDiscovered ? evoSpecies.Name : "???")</span>
												</div>
											}
										</div>
									</div>
								}
								else
								{
									<div class="@($"bb-evo-section drev-{detailRevealVersion}")">
										<div class="bb-section-title"><span>@L("ui.beastbook.evolution")</span></div>
										<div class="bb-moves-empty">
											<iconify icon="lucide:git-fork" Size=@(36) Color="rgba(255,255,255,0.2)" />
											<span>This species does not evolve.</span>
										</div>
									</div>
								}
							}

							<!-- ====== LORE VIEW (mastery-gated entries) ======
							     Dark neutral rows, tier-colored LV chip + thin accent strip on
							     unlocked. Locked rows dim, italic — readable against dark bg. -->
							@if (detailView == "lore")
							{
								var bmgrLore = BeastiaryManager.Instance;
								var loreMasteryLvl = bmgrLore?.GetMasteryLevel(selectedSpecies.Id) ?? 0;
								<div class="@($"bb-lore-block drev-{detailRevealVersion}")">
									<div class="bb-section-title"><span>@L("ui.beastbook.lore_title")</span></div>

									<!-- Lore entry 1 (mastery Lv1) — uses the species Description -->
									<div class="bb-lore-entry tier-1 @(loreMasteryLvl >= 1 ? "unlocked" : "locked")">
										<div class="bb-lore-level-pill tier-1"><span>LV 1</span></div>
										@if (loreMasteryLvl >= 1 && !string.IsNullOrEmpty(selectedSpecies.Description))
										{
											<span class="bb-lore-text">@selectedSpecies.Description</span>
										}
										else
										{
											<span class="bb-lore-locked-text">@L("ui.beastbook.lore_locked", 1)</span>
										}
									</div>

									<!-- Future lore entries (Lv2-6) — placeholder locked cards.
									     When LoreEntries are authored on MonsterSpecies, loop
									     those here instead of these stubs. -->
									@for (int loreIdx = 2; loreIdx <= 6; loreIdx++)
									{
										// Hoist to a local so Razor parses cleanly. User reported
										// that "Lv@(loreIdx) to unlock" was rendering the literal
										// source text (not the value) in s&box razor. A named local
										// sidesteps whatever tokenizer edge case is biting.
										var lockedLv = loreIdx;
										<div class="bb-lore-entry tier-@loreIdx locked">
											<div class="bb-lore-level-pill tier-@loreIdx"><span>LV @loreIdx</span></div>
											<span class="bb-lore-locked-text">@L("ui.beastbook.lore_locked", lockedLv)</span>
										</div>
									}
								</div>
							}

							<!-- ====== MASTERY VIEW — per-species progression badge + tier list ====== -->
							@if (detailView == "mastery")
							{
								<div class="@($"bb-mastery-section drev-{detailRevealVersion}")">
									<div class="bb-section-title"><span>@L("ui.beastbook.mastery_title")</span></div>

									@{
										var bmgr = BeastiaryManager.Instance;
										var masteryLvl = bmgr?.GetMasteryLevel(selectedSpecies.Id) ?? 0;
										var masteryTitle = bmgr?.GetMasteryTitle(selectedSpecies.Id) ?? "";
										var masteryBonusPct = (int)((bmgr?.GetMasteryBonus(selectedSpecies.Id) ?? 0f) * 100);
										int masteryCurrent = 0;
										int masteryRequired = 1;
										string masteryDescription = "";
										if (bmgr != null)
										{
											var p = bmgr.GetProgressToNext(selectedSpecies.Id);
											masteryCurrent = p.current;
											masteryRequired = p.required;
											masteryDescription = p.description;
										}
										var progressPct = masteryRequired > 0
											? Math.Clamp((float)masteryCurrent / masteryRequired * 100f, 0f, 100f)
											: 0f;
									}

									<div class="bb-mastery-header">
										<div class="bb-mastery-level-badge level-@masteryLvl">
											<span class="bb-mastery-level-num">@masteryLvl</span>
											<span class="bb-mastery-level-caption">LV</span>
										</div>
										<div class="bb-mastery-header-text">
											<div class="bb-pill bb-mastery-title-pill level-@masteryLvl"><span>@masteryTitle</span></div>
											@if (masteryBonusPct > 0)
											{
												<div class="bb-pill bb-mastery-bonus-pill"><span>+@masteryBonusPct% stats</span></div>
											}
										</div>
									</div>

									@if (masteryLvl < 6)
									{
										<div class="bb-mastery-next">
											<span class="bb-mastery-next-label">@L("ui.beastbook.mastery_next", masteryDescription)</span>
											<div class="bb-mastery-progress-bar">
												<div class="bb-mastery-progress-fill level-@masteryLvl" style="width: @(progressPct)%"></div>
											</div>
										</div>
									}

									<div class="bb-mastery-tiers">
										@for (int tier = 1; tier <= 6; tier++)
										{
											var unlocked = masteryLvl >= tier;
											var tierTitle = tier switch
											{
												1 => "Novice",
												2 => "Adept",
												3 => "Veteran",
												4 => "Elite",
												5 => "Master",
												6 => "Grandmaster",
												_ => ""
											};
											@{
												var tierColor = tier switch
												{
													1 => "#9ca3af",
													2 => "#4ade80",
													3 => "#60a5fa",
													4 => "#a855f7",
													5 => "#fbbf24",
													6 => "#ec4899",
													_ => "#ffffff"
												};
											}
											<div class="bb-mastery-tier tier-@tier @(unlocked ? "unlocked" : "locked")">
												<iconify icon="@(unlocked ? "lucide:check" : "lucide:circle")" Size=@(11) Color="@(unlocked ? tierColor : "rgba(255,255,255,0.25)")" />
												<span class="bb-mastery-tier-name">Lv@(tier) @tierTitle</span>
											</div>
										}
									</div>
								</div>
							}
						}

						<!-- ====== ARTIST CREDIT FOOTER ====== -->
						@if (isFullyDiscovered && !string.IsNullOrEmpty(selectedSpecies.ArtistCredit))
						{
							<div class="bb-artist-credit">
								<span>@L("ui.beastbook.art_by", "@" + selectedSpecies.ArtistCredit)</span>
							</div>
						}
					</div>
				}
			</div>
	</div>

	<!-- THE LIVING VIOLET RING — the one waving selection cursor wrapping
	     the selected species' card (menu/PawPad signature, roster's
	     scroll-grid recipe ported 1:1). Root-level absolute so it waves
	     per-frame without dirtying the grid; position bound from
	     UpdateGridRing each tick, wave via imperative Style.Transform in
	     ApplyGridRingWave. z 50: above the rail (z 2) and placard (z 3),
	     below the header (500) — flat z-index law. -->
	<div @ref="bbRingRef" class="bb-grid-ring @(bbRingVisible ? "on" : "") @(bbRingWarm < 2 ? "snap" : "")"
		 style="left: @(bbRingL)px; top: @(bbRingT)px; width: @(bbRingW)px; height: @(bbRingH)px;"></div>

	<!-- ====== BEAST PREVIEW POPUP ======
	     Click the portrait (or the 'cry' diamond) to open this modal.
	     Shows a bigger sprite with zoom controls — future home for per-
	     species cry audio + animation-set picker. Closes on backdrop
	     click, X button, or species change. -->
	@if (showBeastPopup && selectedSpecies != null && HasSprite(selectedSpecies))
	{
		<div class="bb-beast-popup-root">
			<div class="bb-beast-popup-overlay" onclick=@CloseBeastPopup></div>
			<div class="bb-beast-popup">
				<div class="bb-beast-popup-header">
					<div class="bb-beast-popup-title-col">
						<span class="bb-beast-popup-number">#@selectedSpecies.BeastiaryNumber.ToString("D3")</span>
						<span class="bb-beast-popup-name">@selectedSpecies.Name</span>
					</div>
					<button class="bb-beast-popup-close" onclick=@CloseBeastPopup onmouseover=@(() => SoundManager.PlayHover())>
						<iconify icon="lucide:x" Size=@(18) Color="rgba(255,255,255,0.85)" />
					</button>
				</div>

				<div class="bb-beast-popup-stage @(_isDraggingBeast ? "is-dragging" : "")"
					 onmousedown=@OnBeastStageDown
					 onmousemove=@OnBeastStageMove
					 onmouseup=@OnBeastStageUp
					 onmouseover=@OnBeastStageEnter
					 onmouseout=@OnBeastStageLeave>
					<img class="bb-beast-popup-sprite" src="@GetAnimatedIcon(selectedSpecies)" style="@BeastPopupSpriteStyle()" />
					<div class="bb-beast-popup-hint">
						<iconify icon="lucide:move" Size=@(11) Color="rgba(196, 181, 253, 0.55)" />
						<span>Drag to pan · Scroll to zoom</span>
					</div>
				</div>

				<div class="bb-beast-popup-controls">
					<button class="bb-beast-popup-ctrl" onclick=@BeastPopupZoomOut onmouseover=@(() => SoundManager.PlayHover())>
						<iconify icon="lucide:zoom-out" Size=@(16) Color="rgba(255,255,255,0.85)" />
					</button>
					<div class="bb-beast-popup-zoom-readout">
						<span>@((int)(beastPopupZoom * 100))%</span>
					</div>
					<button class="bb-beast-popup-ctrl" onclick=@BeastPopupZoomIn onmouseover=@(() => SoundManager.PlayHover())>
						<iconify icon="lucide:zoom-in" Size=@(16) Color="rgba(255,255,255,0.85)" />
					</button>
					<button class="bb-beast-popup-ctrl reset" onclick=@BeastPopupResetZoom onmouseover=@(() => SoundManager.PlayHover())>
						<iconify icon="lucide:refresh-ccw" Size=@(14) Color="rgba(255,255,255,0.7)" />
					</button>
				</div>
			</div>
		</div>
	}

	@* ═══ DEV: GRID-CARD ART EDITOR TOOLBAR ═══════════════════════
	   Hidden behind ShowGridArtEditor. Click EDIT to enter edit
	   mode — then drag any grid card's sprite to translate it,
	   scroll wheel over a card to scale it, and SAVE → CONSOLE
	   to dump paste-ready C# lines for MonsterManager.cs.
	   Pattern mirrors WorldMapPanel's drag-to-place editor. *@
	@if ( ShowGridArtEditor )
	{
		<div class="bb-art-editor-toolbar">
			<button class="bb-art-editor-btn @(_editMode ? "active" : "")" onclick=@ToggleEditMode>
				<iconify icon="lucide:move" Size=@(13) Color="#fbbf24" />
				<span>EDIT @(_editMode ? "ON" : "OFF")</span>
			</button>
			@if ( _editMode )
			{
				<button class="bb-art-editor-btn save" onclick=@PrintCardArt>
					<iconify icon="lucide:save" Size=@(13) Color="#4ade80" />
					<span>SAVE → CONSOLE</span>
				</button>
				<button class="bb-art-editor-btn reset" onclick=@ResetCardArt>
					<iconify icon="lucide:refresh-ccw" Size=@(13) Color="#f87171" />
					<span>RESET</span>
				</button>
				<div class="bb-art-editor-hint">
					<span>Drag cards · scroll to scale</span>
					@if ( _cardOverrides.Count > 0 )
					{
						<span class="bb-art-editor-count">@_cardOverrides.Count edited</span>
					}
				</div>
			}
		</div>
	}

	@* Drag shield — fullscreen overlay that catches mousemove/up
	   while a card is being dragged. Mounts only during drag so
	   normal hover/click events work the rest of the time. *@
	@if ( !string.IsNullOrEmpty( _draggingSpeciesId ) )
	{
		<div class="bb-art-drag-shield"
			 onmousemove=@OnEditDragMove
			 onmouseup=@OnEditDragEnd></div>
	}

	@* ════════════════════════════════════════════════════════════
	   T3 — NEW-SPECIES DISCOVERY REVEAL
	   ------------------------------------------------------------
	   Fullscreen sibling of the whole panel body — NOT a child of
	   the scroll grid (the scroll-clip glow-leak rule). Mounts fresh
	   via `@if discoveryCelebrationActive` so every layer's entrance
	   @keyframes fire on a clean DOM node (the proven one-shot
	   celebration pattern — keyframes never replay on a persistent
	   element). `discoveryVersion` is folded into the wrapper key so
	   a back-to-back second discovery remounts a brand-new subtree.
	   Hades-shape sequence (anticipation → reveal → celebration →
	   settle), identical beat for ANY species — deterministic, no RNG
	   framing (anti-gacha). Driven by BeastiaryManager.OnSpeciesDiscovered.
	   ════════════════════════════════════════════════════════════ *@
	@if ( discoveryCelebrationActive && discoverySpecies != null )
	{
		var discPrimary = discoverySpecies.Element.ToString().ToLower();
		var discRarity = discoverySpecies.BaseRarity.ToString().ToLower();
		<div class="@($"bb-discovery-overlay rarity-{discRarity} disc-{discoveryVersion}")" onclick=@DismissDiscovery>

			<!-- Scrim — dims the panel behind so the reveal owns the screen. -->
			<div class="bb-disc-scrim"></div>

			<!-- Anticipation flash — one white pop on the held beat. -->
			<div class="bb-disc-flash"></div>

			<!-- Reveal bloom — expanding light ring + warm radial ray wash
			     behind the portrait. Rarity tint flows through the wrapper. -->
			<div class="bb-disc-bloom">
				<div class="bb-disc-rays"></div>
				<div class="bb-disc-ring"></div>
				<div class="bb-disc-ring ring-2"></div>
			</div>

			<!-- Center stack — eyebrow → portrait spring → name slam → meta. -->
			<div class="bb-disc-stack">
				<div class="bb-disc-eyebrow">
					<iconify icon="lucide:sparkles" Size=@(14) Color="#fbbf24" />
					<span>NEW SPECIES DISCOVERED</span>
				</div>

				<div class="bb-disc-portrait-wrap">
					@if ( HasSprite( discoverySpecies ) )
					{
						<img class="bb-disc-sprite" src="@GetAnimatedIcon( discoverySpecies )" />
					}
					else
					{
						<div class="bb-disc-unknown">?</div>
					}
				</div>

				<div class="bb-disc-name-row">
					<div class="bb-disc-number"><span>#@discoverySpecies.BeastiaryNumber.ToString( "D3" )</span></div>
					<div class="bb-disc-name">@discoverySpecies.Name</div>
				</div>

				<div class="bb-disc-meta-row">
					<div class="bb-pill element-@discPrimary bb-disc-el-pill">
						<img src="ui/icons/elements/element_white/@(discPrimary).svg" />
						<span>@discPrimary.ToUpper()</span>
					</div>
					<div class="bb-disc-rarity-pill rarity-@discRarity">
						<span>@discoverySpecies.BaseRarity.ToString().ToUpper()</span>
					</div>
				</div>

				<!-- Radial spark burst — 8 directional motes, fresh-mount
				     keyframes per spark. Sits behind the stack content. -->
				<div class="bb-disc-sparks">
					<div class="bb-disc-spark s0"></div>
					<div class="bb-disc-spark s1"></div>
					<div class="bb-disc-spark s2"></div>
					<div class="bb-disc-spark s3"></div>
					<div class="bb-disc-spark s4"></div>
					<div class="bb-disc-spark s5"></div>
					<div class="bb-disc-spark s6"></div>
					<div class="bb-disc-spark s7"></div>
				</div>

				<div class="bb-disc-dismiss-hint"><span>CLICK TO CONTINUE</span></div>
			</div>
		</div>
	}
</root>

@code {
	// ============================================================
	// Localization
	// ============================================================
	private string L( string key ) => LocalizationManager.Get( key );
	private string L( string key, params object[] args ) => LocalizationManager.Get( key, args );

	// ============================================================
	// State
	// ============================================================
	private ElementType? currentElement = null;
	private string currentElementStr = "all";
	private string currentSort = "beastiary";
	private bool sortAscending = true;
	private string currentNameFilter = "";
	private MonsterSpecies selectedSpecies = null;
	private int selectedIndex = 0;
	private FilterBar filterBar;

	// Swappable bottom section — diamonds toggle the detail view between
	// stats (default), moves, evolution, and lore. Replaces the old
	// showMoves/showLore booleans with a single state string.
	private string detailView = "stats";

	// ---- Grid <-> detail-panel keyboard focus switch -------------------
	// Mirrors the MonsterRosterPanel pattern. kbFocusZone is the zone the
	// keyboard drives: "grid" (default — arrows move the species grid) or
	// "detail" (arrows move between the detail panel's diamond actions).
	// Tab (Score) hands focus to the detail panel; Tab or Q (Menu) returns.
	private string kbFocusZone = "grid";
	private int detailActionIndex = 0;

	// Ordered list of keyboard-reachable detail-panel diamond actions for
	// the selected species. "cry" plays the cry; the rest toggle the
	// swappable bottom view. Evolution is only present when the species
	// has an evolution chain — matches the conditional in the markup.
	private List<string> GetDetailActions()
	{
		var actions = new List<string>();
		if ( selectedSpecies == null || !IsDiscovered( selectedSpecies.Id ) ) return actions;
		actions.Add( "cry" );
		actions.Add( "moves" );
		if ( GetEvolutionChain( selectedSpecies ).Count > 1 ) actions.Add( "evolution" );
		actions.Add( "lore" );
		actions.Add( "mastery" );
		return actions;
	}

	// True when the detail panel has keyboard focus and the given diamond
	// action id is under the keyboard cursor. Drives the .kb-focused style.
	private bool IsDetailActionFocused( string id )
	{
		if ( kbFocusZone != "detail" ) return false;
		var actions = GetDetailActions();
		if ( actions.Count == 0 ) return false;
		int idx = Math.Clamp( detailActionIndex, 0, actions.Count - 1 );
		return actions[idx] == id;
	}

	private void FocusDetailZone()
	{
		// Detail focus only makes sense on a fully-discovered species —
		// the diamond actions don't render otherwise.
		if ( selectedSpecies == null || !IsDiscovered( selectedSpecies.Id ) ) return;
		kbFocusZone = "detail";
		detailActionIndex = 0;
		SoundManager.PlayClick();
	}

	private void FocusGridZone()
	{
		kbFocusZone = "grid";
		SoundManager.PlayBack();
	}

	private void ToggleKbFocusZone()
	{
		if ( kbFocusZone == "grid" ) FocusDetailZone();
		else FocusGridZone();
	}

	private void ActivateFocusedDetailAction()
	{
		var actions = GetDetailActions();
		if ( actions.Count == 0 ) return;
		detailActionIndex = Math.Clamp( detailActionIndex, 0, actions.Count - 1 );
		var id = actions[detailActionIndex];
		if ( id == "cry" ) OnPortraitClick();
		else OnDiamondClick( id );
	}

	// Hover-sound guard: track the last species id that fired a hover sound so we
	// don't re-fire PlayHover() every frame while the mouse is over the same card.
	private string lastHoveredCardId = null;

	// One-shot card-select pulse — border flash on the clicked card,
	// remounted via `pulse-@selectPulseVersion` class so @keyframes
	// re-fire every click (s&box quirk). Ported from ShopPanelContent.
	private string justSelectedSpeciesId = null;
	private int selectPulseVersion = 0;

	// Detail-pane entrance — bumped each time the selected species changes so
	// the `detail-rev-N` class remounts the `.bb-detail-fixed` subtree and its
	// staggered reveal @keyframes (portrait → name → pills → flavor) fire fresh.
	// Mount-time keyframes are the right tool here: the subtree genuinely
	// remounts on species change, so there's no "replay on persistent element"
	// trap. T2 state-change polish — gives selecting a beast a satisfying
	// "the page turns to it" cascade instead of an instant snap.
	private int detailRevealVersion = 0;

	// True for the entrance right after a fresh species pick (full top→bottom
	// cascade: actions + view come in AFTER the top block). Flipped false on a
	// view toggle so switching diamonds reveals the new view snappily, not lagged.
	private bool detailFreshSelect = false;

	// ───────────────────── T3 NEW-SPECIES DISCOVERY REVEAL ────────────────
	// Fullscreen Hades-shape celebration fired off BeastiaryManager's
	// OnSpeciesDiscovered action. The overlay is a sibling of the panel body
	// (NOT inside the scroll grid) so colored glows / rings don't leak past
	// the scroll viewport. `discoveryVersion` keys the wrapper so a second
	// discovery while one is still on screen remounts a fresh subtree and the
	// entrance @keyframes replay (the proven one-shot pattern). Deterministic
	// beat for ANY species — anti-gacha (no RNG framing, identical for a
	// common or a legendary aside from the rarity tint).
	private bool discoveryCelebrationActive = false;
	private MonsterSpecies discoverySpecies = null;
	private int discoveryVersion = 0;
	private RealTimeSince _discoveryShownAt;
	// Auto-dismiss after the celebration has played + had a beat to be read.
	// Player can also click anywhere on the overlay to dismiss early.
	private const float DISCOVERY_AUTO_DISMISS = 4.5f;
	private bool _discoverySubscribed = false;

	private void OnSpeciesDiscoveredFired( string speciesId )
	{
		if ( string.IsNullOrEmpty( speciesId ) ) return;
		var sp = MonsterManager.Instance?.GetSpecies( speciesId );
		if ( sp == null ) return;
		// Only celebrate species the player can actually browse here — keeps
		// the reveal scoped to the launch roster (matches the completion math).
		if ( !MonsterManager.LaunchRoster.Contains( speciesId ) ) return;

		discoverySpecies = sp;
		discoveryCelebrationActive = true;
		discoveryVersion++;
		_discoveryShownAt = 0f;
		// Layered cue — reuse existing vocab (no dedicated discovery file yet;
		// flagged for product). Click = anticipation, Success+Gold = reveal.
		SoundManager.PlayClick();
		SoundManager.PlaySuccess();
		SoundManager.PlayGoldReward();
		StateHasChanged();
	}

	private void DismissDiscovery()
	{
		if ( !discoveryCelebrationActive ) return;
		discoveryCelebrationActive = false;
		discoverySpecies = null;
		SoundManager.PlayBack();
		StateHasChanged();
	}

	// ───────────────────── DEV: GRID-CARD ART EDITOR ──────────────────────
	// Toggle EDIT MODE to drag any grid card's sprite to retune CardOffsetX/Y
	// and use the mouse wheel over a card to retune CardScale. Hit
	// SAVE → CONSOLE to dump the current values for every edited species as
	// paste-ready C# lines that drop straight into MonsterManager.cs.
	// Hidden behind ShowGridArtEditor — flip to `true` for tuning passes.
	// Pattern mirrors WorldMapPanel's drag-to-place editor.
	private const bool ShowGridArtEditor = false;
	private bool _editMode = false;
	private string _draggingSpeciesId;
	// When editing a card lower in the grid, we pin it to position 0 of the
	// filtered list and snap the grid scroll to the top so it sits next to
	// the editor toolbar. Cleared when edit mode toggles off.
	private string _editPinnedSpeciesId;
	private Panel bbGridPanel;
	// Renamed from _dragStartMouseX/Y to avoid colliding with the beast-popup
	// pan-drag fields lower in this file (those track a different gesture).
	private float _artDragStartMouseX, _artDragStartMouseY;
	private float _dragStartOffX, _dragStartOffY;
	private bool _needsDragAnchor;
	private string _hoveredEditCardId;   // tracks card under cursor so wheel scales the right one
	// Per-species overrides authored at runtime. Key = species id; values
	// shadow MonsterSpecies.CardScale/CardOffsetX/CardOffsetY when present.
	private System.Collections.Generic.Dictionary<string, (float Scale, float OffX, float OffY)> _cardOverrides = new();

	// Separate guards for the detail-pane diamond row and the evolution
	// chain stages. Each family tracks its own "last id" so crossing from
	// the grid into the detail doesn't mis-deduplicate against a grid id.
	//
	// s&box `onmouseover` fires repeatedly while the cursor stays on the
	// element, so without a guard every diamond/stage would spam hover
	// sounds once per frame. Pattern mirrors OnCardHover.
	private string lastHoveredDiamondId = null;
	private string lastHoveredEvoStageId = null;
	private string lastHoveredMoveId = null;

	// Trait tooltip — tracked in code-behind because the CSS `:hover .descendant`
	// pattern is unreliable in s&box (tooltip sometimes only appears on mouseout).
	// Instead we render the tooltip conditionally based on this state, which
	// updates every time the hover moves between trait pills. See learnings.md.
	private string hoveredTraitId = null;
	private void OnTraitHover( string traitId )
	{
		if ( hoveredTraitId == traitId ) return;
		hoveredTraitId = traitId;
		SoundManager.PlayHover();
	}
	private void OnTraitOut( string traitId )
	{
		if ( hoveredTraitId == traitId ) hoveredTraitId = null;
	}

	private void OnDiamondHover( string diamondId )
	{
		if ( lastHoveredDiamondId != diamondId )
		{
			lastHoveredDiamondId = diamondId;
			SoundManager.PlayHover();
		}
	}

	private void OnEvoStageHover( string stageId )
	{
		if ( lastHoveredEvoStageId != stageId )
		{
			lastHoveredEvoStageId = stageId;
			SoundManager.PlayHover();
		}
	}

	private void OnMoveRowHover( string moveId )
	{
		if ( lastHoveredMoveId != moveId )
		{
			lastHoveredMoveId = moveId;
			SoundManager.PlayHover();
		}
	}

	// ───────────────────── EDIT-MODE HANDLERS ─────────────────────────────
	private (float Scale, float OffX, float OffY) GetCardArt( MonsterSpecies species )
	{
		if ( _cardOverrides.TryGetValue( species.Id, out var ov ) ) return ov;
		return (species.CardScale, species.CardOffsetX, species.CardOffsetY);
	}

	private void ToggleEditMode()
	{
		_editMode = !_editMode;
		if ( !_editMode ) { _draggingSpeciesId = null; _hoveredEditCardId = null; _editPinnedSpeciesId = null; }
		SoundManager.PlayClick();
		StateHasChanged();
	}

	private void StartDragCard( MonsterSpecies species )
	{
		if ( !_editMode || species == null ) return;
		var art = GetCardArt( species );
		_draggingSpeciesId = species.Id;
		_dragStartOffX = art.OffX;
		_dragStartOffY = art.OffY;
		_needsDragAnchor = true;
		// Pin this card to the top of the grid + scroll to top so it sits
		// next to the editor toolbar. Otherwise editing a card that was
		// previously scrolled into the lower half of the grid meant working
		// blind, far from the SAVE/RESET controls.
		_editPinnedSpeciesId = species.Id;
		if ( bbGridPanel != null ) bbGridPanel.ScrollOffset = Vector2.Zero;
		// Don't open detail / fire select pulse mid-drag.
		StateHasChanged();
	}

	private void OnEditDragMove( PanelEvent e )
	{
		if ( string.IsNullOrEmpty( _draggingSpeciesId ) ) return;
		// First move after start anchors mouse coords on the shield (which
		// is fullscreen + static, so its coords are immune to the card
		// re-rendering as we drag it).
		if ( _needsDragAnchor )
		{
			_artDragStartMouseX = MousePosition.x;
			_artDragStartMouseY = MousePosition.y;
			_needsDragAnchor = false;
			return;
		}
		float dx = MousePosition.x - _artDragStartMouseX;
		float dy = MousePosition.y - _artDragStartMouseY;
		var prev = _cardOverrides.TryGetValue( _draggingSpeciesId, out var ov )
			? ov
			: GetSpeciesArtFallback( _draggingSpeciesId );
		_cardOverrides[_draggingSpeciesId] = (prev.Scale, _dragStartOffX + dx, _dragStartOffY + dy);
		StateHasChanged();
	}

	private void OnEditDragEnd( PanelEvent e )
	{
		_draggingSpeciesId = null;
		StateHasChanged();
	}

	private (float Scale, float OffX, float OffY) GetSpeciesArtFallback( string speciesId )
	{
		var sp = MonsterManager.Instance?.GetSpecies( speciesId );
		return sp == null ? (1f, 0f, 0f) : (sp.CardScale, sp.CardOffsetX, sp.CardOffsetY);
	}

	private void OnEditCardEnter( string speciesId )
	{
		if ( !_editMode ) return;
		_hoveredEditCardId = speciesId;
	}

	private void OnEditCardLeave( string speciesId )
	{
		if ( _hoveredEditCardId == speciesId ) _hoveredEditCardId = null;
	}

	/// <summary>
	/// Dump current overrides to the engine log as paste-ready C# lines.
	/// Each block matches the field assignment block in MonsterManager.cs
	/// so the user can find/replace the species' CardScale/CardOffsetX/Y
	/// fields with the new values.
	/// </summary>
	// ───── Saved card-art persistence ─────────────────────────────
	// JSON file in FileSystem.Data so dragged offsets + scale actually persist
	// across editor sessions (was previously console-only — print and manually
	// paste). Pattern mirrors WorldMapPanel.SavedPositionsFile.
	private const string SavedCardArtFile = "beastbook_card_art.json";

	private class SavedCardArt { public string Id { get; set; } public float Scale { get; set; } public float OffX { get; set; } public float OffY { get; set; } }
	private class CardArtData { public List<SavedCardArt> Cards { get; set; } = new(); }

	/// <summary>
	/// Persist current per-species overrides to FileSystem.Data so they
	/// survive between editor sessions, AND dump paste-ready C# lines so
	/// the dev can find/replace the species' fields in MonsterManager.cs
	/// when ready to commit.
	/// </summary>
	private void PrintCardArt()
	{
		if ( _cardOverrides.Count == 0 )
		{
			Log.Info( "[BeastbookEdit] No overrides yet — drag a card or scroll over it first." );
			return;
		}

		// 1) Persist to disk so the next session loads them automatically.
		var data = new CardArtData();
		foreach ( var kvp in _cardOverrides )
		{
			data.Cards.Add( new SavedCardArt { Id = kvp.Key, Scale = kvp.Value.Scale, OffX = kvp.Value.OffX, OffY = kvp.Value.OffY } );
		}
		try
		{
			var json = System.Text.Json.JsonSerializer.Serialize( data, new System.Text.Json.JsonSerializerOptions { WriteIndented = true } );
			FileSystem.Data.WriteAllText( SavedCardArtFile, json );
			Log.Info( $"[BeastbookEdit] Saved {data.Cards.Count} card override(s) → FileSystem.Data/{SavedCardArtFile}" );
		}
		catch ( System.Exception ex )
		{
			Log.Warning( $"[BeastbookEdit] Failed to write overrides: {ex.Message}" );
		}

		// 2) Print to log for paste-back into MonsterManager.cs when committing.
		// Each line logged separately — s&box's Log.Info silently truncates
		// multi-line strings after the first newline.
		Log.Info( "─── Beastbook card-art overrides — paste into MonsterManager.cs ───" );
		var ci = System.Globalization.CultureInfo.InvariantCulture;
		foreach ( var kvp in _cardOverrides )
		{
			var sp = MonsterManager.Instance?.GetSpecies( kvp.Key );
			var name = sp?.Name ?? kvp.Key;
			Log.Info( $"// {name} ({kvp.Key})" );
			Log.Info( $"CardScale = {kvp.Value.Scale.ToString( "0.###", ci )}f," );
			Log.Info( $"CardOffsetX = {kvp.Value.OffX.ToString( "0.#", ci )}f," );
			Log.Info( $"CardOffsetY = {kvp.Value.OffY.ToString( "0.#", ci )}f," );
		}
		Log.Info( "─────────────────────────────────────────────────────────────────" );
		SoundManager.PlayClick();
	}

	/// <summary>
	/// Load saved per-species card-art overrides from FileSystem.Data into
	/// _cardOverrides. Called once on first tree render so the dev's last
	/// editor-session edits are visible immediately on panel open.
	/// </summary>
	private void LoadSavedCardArt()
	{
		try
		{
			if ( !FileSystem.Data.FileExists( SavedCardArtFile ) ) return;
			var json = FileSystem.Data.ReadAllText( SavedCardArtFile );
			var data = System.Text.Json.JsonSerializer.Deserialize<CardArtData>( json );
			if ( data == null || data.Cards == null ) return;

			foreach ( var c in data.Cards )
			{
				if ( string.IsNullOrEmpty( c.Id ) ) continue;
				_cardOverrides[c.Id] = (c.Scale, c.OffX, c.OffY);
			}
			Log.Info( $"[BeastbookEdit] Loaded {data.Cards.Count} card override(s) from {SavedCardArtFile}" );
		}
		catch ( System.Exception ex )
		{
			Log.Warning( $"[BeastbookEdit] Failed to load saved overrides: {ex.Message}" );
		}
	}

	private void ResetCardArt()
	{
		_cardOverrides.Clear();
		SoundManager.PlayClick();
		StateHasChanged();
	}

	// ───────────────────── THE LIVING VIOLET RING ─────────────────────────
	// One waving selection cursor wrapping the selected species' index slot.
	// Ported from MonsterRosterPanel's scroll-grid recipe: position recomputed
	// every Tick from live Box.Rects (the rail scrolls + reflows on filter
	// changes), wave applied imperatively (repaints the ring alone — cheap on
	// a FLAT panel; the 7fps law only bites inside perspective leans). The
	// ring self-hides when the slot scrolls out of the rail viewport
	// (s&box never clips a root-level ring to the scroll clip).
	private Panel bbRingRef;
	private int bbRingL, bbRingT, bbRingW = 80, bbRingH = 80;
	private bool bbRingVisible;
	private int bbRingWarm; // <2 = snap to position (no glide) while first rects land

	// 8px box outset each side; the 4px border lives in SCSS. Declared
	// width/height are CONTENT-box (s&box has no border-box), so the update
	// subtracts the 8px of border to keep the ring concentric.
	private const int BbRingInset = 8;

	private void UpdateGridRing()
	{
		bool wasVisible = bbRingVisible;
		bbRingVisible = false;

		if ( bbGridPanel == null || selectedSpecies == null ) return;
		if ( _editMode || discoveryCelebrationActive || showBeastPopup ) return;

		// Find the selected slot by fresh traversal (loop @refs don't exist,
		// panel refs die on hotload). Slots are DIRECT children of the scroll
		// rail (scroll-container law); the `.selected` class is authoritative.
		Panel target = null;
		foreach ( var c in bbGridPanel.Children )
		{
			if ( !c.HasClass( "bb-card" ) ) continue;
			if ( c.HasClass( "selected" ) ) { target = c; break; }
		}
		if ( target == null ) return;

		var rr = Box.Rect;
		var gr = bbGridPanel.Box.Rect;
		var cr = target.Box.Rect;
		if ( rr.Width < 1f || cr.Width < 1f ) return;

		// Scroll-clip discipline: hide once the slot has scrolled far enough
		// out that the ring would draw over the rail head / page chrome.
		if ( cr.Top < gr.Top - 12f || cr.Bottom > gr.Bottom + 12f ) return;

		float sc = ScaleFromScreen;
		if ( sc <= 0.01f || float.IsNaN( sc ) || float.IsInfinity( sc ) ) sc = 1f;

		bbRingL = (int)((cr.Left - rr.Left) * sc) - BbRingInset;
		bbRingT = (int)((cr.Top - rr.Top) * sc) - BbRingInset;
		bbRingW = (int)(cr.Width * sc) + BbRingInset * 2 - 8;
		bbRingH = (int)(cr.Height * sc) + BbRingInset * 2 - 8;

		bbRingVisible = true;
		if ( !wasVisible ) bbRingWarm = 0;       // re-appearing → snap first, glide after
		else if ( bbRingWarm < 2 ) bbRingWarm++;
	}

	// The liquid ink-lean — the menu cursor's multi-sine at the PawPad's
	// ×0.6 amplitude + out-of-phase breathing. Imperative transform: no
	// re-render, repaints the ring alone (flat-panel safe).
	private void ApplyGridRingWave()
	{
		if ( bbRingRef == null || !bbRingVisible ) return;
		float wt = Time.Now;
		float skX = ( 2.0f * MathF.Sin( wt * 2.2f ) + 0.7f * MathF.Sin( wt * 3.5f + 1.1f ) ) * 0.6f;
		float skY = ( 2.3f * MathF.Sin( wt * 1.8f + 1.9f ) + 0.9f * MathF.Sin( wt * 2.9f ) ) * 0.6f;
		float rotZ = ( 1.1f * MathF.Sin( wt * 1.0f ) + 0.5f * MathF.Sin( wt * 2.4f + 0.5f ) ) * 0.6f;
		float brX = 1f + 0.013f * MathF.Sin( wt * 1.35f + 0.7f ) + 0.006f * MathF.Sin( wt * 2.7f );
		float brY = 1f + 0.013f * MathF.Sin( wt * 1.15f + 2.6f ) + 0.006f * MathF.Sin( wt * 2.3f + 1.4f );

		var t = new PanelTransform();
		t.AddRotation( 0f, 0f, rotZ );
		t.AddSkew( skX, skY, 0f );
		t.AddScale( new Vector2( brX, brY ) );
		bbRingRef.Style.Transform = t;
	}

	// ───────────────────── Auto-select — the stage never opens dark ───────
	// The showcase stage is the panel's hero; opening (or re-filtering) to an
	// empty stage wastes the composition. Quiet select (no click sound, no
	// pulse) of the first slot in the current filter. Same detail cascade.
	private void AutoSelectFirst()
	{
		var list = GetFilteredSpecies();
		var first = list.Count > 0 ? list[0] : null;
		selectedSpecies = first;
		selectedIndex = 0;
		detailView = "stats";
		showBeastPopup = false;
		if ( first != null )
		{
			detailRevealVersion++;
			detailFreshSelect = true;
		}
	}

	// ============================================================
	// Input plumbing
	// ============================================================
	private void OnPanelClicked()
	{
		GameHUD.EnterPanel();
	}

	protected override void OnAfterTreeRender( bool firstTime )
	{
		if ( firstTime )
		{
			// Hydrate per-session card-art overrides from disk so the dev's
			// previous edits show up the moment the Beastbook opens. See
			// SavedCardArtFile / PrintCardArt above for the persistence path.
			LoadSavedCardArt();

			// Subscribe to the discovery hook so a beast caught/owned while
			// the Beastbook is open fires the T3 reveal. The panel is mounted
			// fresh each tab activation in this game's tab model, so subscribe
			// here and tear down in OnDeleted to avoid duplicate handlers.
			var bmgr = BeastiaryManager.Instance;
			if ( bmgr != null && !_discoverySubscribed )
			{
				bmgr.OnSpeciesDiscovered += OnSpeciesDiscoveredFired;
				_discoverySubscribed = true;
			}

			// The stage never opens dark — showcase the first specimen quietly.
			if ( selectedSpecies == null ) AutoSelectFirst();
		}
	}

	public override void OnDeleted()
	{
		base.OnDeleted();
		var bmgr = BeastiaryManager.Instance;
		if ( bmgr != null && _discoverySubscribed )
		{
			bmgr.OnSpeciesDiscovered -= OnSpeciesDiscoveredFired;
			_discoverySubscribed = false;
		}
	}

	public override void Tick()
	{
		base.Tick();

		// Living ring — per-tick position (rail scrolls/reflows) + imperative wave.
		UpdateGridRing();
		ApplyGridRingWave();

		// Auto-dismiss the discovery reveal once it's played + had a beat to
		// land. Cheap StateHasChanged only when the overlay is actually up.
		if ( discoveryCelebrationActive && _discoveryShownAt > DISCOVERY_AUTO_DISMISS )
		{
			DismissDiscovery();
		}
	}

	// Mouse-wheel zoom for the beast preview popup — override the Panel
	// base class's `OnMouseWheel` method (canonical s&box UI API, see
	// `Sandbox.UI.Panel.OnMouseWheel(Vector2)`). `delta.y` is the scroll
	// amount (positive = scroll up / toward user). Scoped via
	// `_isMouseOverBeastStage` so wheel elsewhere in the panel (grid
	// scroll, detail-pane scroll) isn't intercepted.
	public override void OnMouseWheel( Vector2 delta )
	{
		if ( showBeastPopup && _isMouseOverBeastStage )
		{
			beastPopupZoom = Math.Clamp(
				beastPopupZoom + delta.y * BEAST_POPUP_WHEEL_ZOOM_STEP,
				BEAST_POPUP_ZOOM_MIN,
				BEAST_POPUP_ZOOM_MAX
			);
			return; // consume — don't let wheel fall through to the grid
		}
		// Edit mode: wheel-over-card scales the card art (CardScale tuning).
		// Scope to ShowGridArtEditor + _editMode + actually-hovered card so
		// it doesn't compete with grid scroll outside edit mode.
		if ( ShowGridArtEditor && _editMode && !string.IsNullOrEmpty( _hoveredEditCardId ) )
		{
			var prev = _cardOverrides.TryGetValue( _hoveredEditCardId, out var ov )
				? ov
				: GetSpeciesArtFallback( _hoveredEditCardId );
			// delta.y is positive when scrolling toward the user (scroll up).
			// Map to scale UP for that direction so it feels like zoom-in.
			float newScale = Math.Clamp( prev.Scale + delta.y * 0.05f, 0.3f, 3.0f );
			_cardOverrides[_hoveredEditCardId] = (newScale, prev.OffX, prev.OffY);
			StateHasChanged();
			return; // consume so the grid doesn't scroll under the cursor
		}
		base.OnMouseWheel( delta );
	}

	public void TickInput()
	{
		HandleKeyboardInput();
		// Keep the keyboard-selected card on screen. Index-based (not the
		// `.selected` CSS class) so it tracks the move THIS frame.
		if ( Input.Pressed( "Left" ) || Input.Pressed( "Right" ) || Input.Pressed( "Up" ) || Input.Pressed( "Down" ) )
			UiGridScroll.ScrollIndexIntoView( bbGridPanel, selectedIndex, "bb-card" );
	}

	// Live column count for keyboard up/down navigation. Counts how many cards
	// share the first row's Y position — gap-agnostic, unlike a grid-width /
	// card-width division which over-counts whenever the grid has column
	// spacing. Falls back to 8 before the first layout pass populates Box.Rect.
	private int GetGridColumns()
	{
		if ( bbGridPanel == null ) return 8;
		int count = 0;
		float rowTop = 0f;
		bool started = false;
		foreach ( var c in bbGridPanel.Children )
		{
			if ( !c.HasClass( "bb-card" ) ) continue;
			var rect = c.Box.Rect;
			if ( rect.Width <= 0f ) return 8;          // not laid out yet
			if ( !started ) { rowTop = rect.Top; started = true; count = 1; }
			else if ( Math.Abs( rect.Top - rowTop ) <= 1f ) count++;
			else break;                                 // reached the next row
		}
		return count > 0 ? count : 8;
	}

	private void HandleKeyboardInput()
	{
		var species = GetFilteredSpecies();

		// Element filter cycle (Z/X) — handled FIRST, before the empty-list
		// early-return below, so the player can always cycle OFF an element
		// that currently has no species yet (e.g. Ice). Not while the detail
		// panel holds focus — its own nav owns the keys there.
		if ( kbFocusZone != "detail" )
		{
			if ( Input.Pressed( "CyclePrev" ) ) { CycleElementBack(); return; }
			if ( Input.Pressed( "CycleNext" ) ) { CycleElementForward(); return; }
		}

		if ( species.Count == 0 )
		{
			if ( Input.Pressed( "Up" ) ) GameHUD.ExitPanel();
			return;
		}

		// ---- DETAIL-ZONE focus: keyboard drives the detail panel --------
		// When the player has Tab'd into the detail panel, arrows move
		// between its diamond actions, Space/Enter activates, and Tab or Q
		// returns to the grid. Handled before grid nav so the grid cursor
		// stays put while the detail panel has keyboard focus.
		if ( kbFocusZone == "detail" )
		{
			var detailActions = GetDetailActions();
			if ( detailActions.Count == 0 ) { FocusGridZone(); return; }

			// Tab or Q — back to the grid. This is an INTERNAL move, not an
			// exit to the tab bar, so claim the back key (GameHUD ticks after
			// this panel and would otherwise also see the Q and flip into
			// tab-nav, freezing the panel — see GameHUD.PanelHandledBackKey).
			if ( Input.Pressed( "Score" ) || Input.Pressed( "Menu" ) )
			{
				FocusGridZone();
				GameHUD.PanelHandledBackKey = true;
				return;
			}
			detailActionIndex = Math.Clamp( detailActionIndex, 0, detailActions.Count - 1 );
			if ( Input.Pressed( "Up" ) || Input.Pressed( "Left" ) )
			{
				detailActionIndex = Math.Max( 0, detailActionIndex - 1 );
				SoundManager.PlayHover();
			}
			else if ( Input.Pressed( "Down" ) || Input.Pressed( "Right" ) )
			{
				detailActionIndex = Math.Min( detailActions.Count - 1, detailActionIndex + 1 );
				SoundManager.PlayHover();
			}
			else if ( Input.Pressed( "Jump" ) || Input.Pressed( "Enter" ) )
			{
				ActivateFocusedDetailAction();
			}
			return;
		}

		selectedIndex = Math.Clamp( selectedIndex, 0, species.Count - 1 );
		// Up/Down moves one full row — column count measured live (it changes
		// with window size and with whether the detail pane is open).
		int columns = GetGridColumns();

		// Space / Enter — confirm the highlighted species and hand keyboard
		// control to the detail panel. Tab also works (kept as an alias).
		if ( Input.Pressed( "Jump" ) || Input.Pressed( "Enter" ) || Input.Pressed( "Score" ) )
		{
			FocusDetailZone();
			return;
		}

		if ( Input.Pressed( "Left" ) )
		{
			selectedIndex = Math.Max( 0, selectedIndex - 1 );
			SelectSpecies( species[selectedIndex], IsDiscovered( species[selectedIndex].Id ) );
			SoundManager.PlayHover();
		}
		else if ( Input.Pressed( "Right" ) )
		{
			selectedIndex = Math.Min( species.Count - 1, selectedIndex + 1 );
			SelectSpecies( species[selectedIndex], IsDiscovered( species[selectedIndex].Id ) );
			SoundManager.PlayHover();
		}
		else if ( Input.Pressed( "Up" ) )
		{
			if ( selectedIndex < columns )
			{
				GameHUD.ExitPanel();
			}
			else
			{
				selectedIndex = Math.Max( 0, selectedIndex - columns );
				SelectSpecies( species[selectedIndex], IsDiscovered( species[selectedIndex].Id ) );
				SoundManager.PlayHover();
			}
		}
		else if ( Input.Pressed( "Down" ) )
		{
			selectedIndex = Math.Min( species.Count - 1, selectedIndex + columns );
			SelectSpecies( species[selectedIndex], IsDiscovered( species[selectedIndex].Id ) );
			SoundManager.PlayHover();
		}
		// (Element filter cycle Z/X is handled at the top of this method, before
		// the empty-list early-return, so it works even on a 0-species filter.)
	}

	private void CycleElementBack()
	{
		var elementStrs = new string[] { "all", "neutral", "fire", "water", "earth", "wind", "electric", "ice", "nature", "metal", "shadow", "spirit" };
		int idx = Array.IndexOf( elementStrs, currentElementStr );
		idx = (idx - 1 + elementStrs.Length) % elementStrs.Length;
		OnElementChanged( elementStrs[idx] );
		SoundManager.PlayClick();
	}

	private void CycleElementForward()
	{
		var elementStrs = new string[] { "all", "neutral", "fire", "water", "earth", "wind", "electric", "ice", "nature", "metal", "shadow", "spirit" };
		int idx = Array.IndexOf( elementStrs, currentElementStr );
		idx = (idx + 1) % elementStrs.Length;
		OnElementChanged( elementStrs[idx] );
		SoundManager.PlayClick();
	}

	// ============================================================
	// FilterBar callbacks
	// ============================================================
	private void OnElementChanged( string element )
	{
		currentElementStr = element;
		currentElement = element switch
		{
			"all" => null,
			"neutral" => ElementType.Neutral,
			"fire" => ElementType.Fire,
			"water" => ElementType.Water,
			"earth" => ElementType.Earth,
			"wind" => ElementType.Wind,
			"electric" => ElementType.Electric,
			"ice" => ElementType.Ice,
			"nature" => ElementType.Nature,
			"metal" => ElementType.Metal,
			"shadow" => ElementType.Shadow,
			"spirit" => ElementType.Spirit,
			_ => null
		};
		// Museum-wall behavior: a filter change re-aims the stage at the first
		// slot of the new set instead of leaving the showcase dark.
		AutoSelectFirst();
		SoundManager.PlayClick();
	}

	private void OnSortChanged( string sort )
	{
		currentSort = sort;
		AutoSelectFirst();
	}

	private void OnSortDirectionChanged( bool ascending )
	{
		sortAscending = ascending;
		AutoSelectFirst();
	}

	private void OnNameFilterChanged( string name )
	{
		currentNameFilter = name;
		AutoSelectFirst();
	}

	private List<string> GetSpeciesNames()
	{
		var species = GetLaunchSpecies();
		return species.Select( s => s.Name ).OrderBy( n => n ).ToList();
	}

	/// <summary>
	/// Beastiary scope — only species in the launch roster are visible.
	/// Hides the 113 AI-holdover species we don't ship at launch so the
	/// completion counter and discovery flow reflect the actual content
	/// a player can encounter.
	/// </summary>
	private List<MonsterSpecies> GetLaunchSpecies()
	{
		var all = MonsterManager.Instance?.GetAllSpecies() ?? new();
		return all.Where( s => s != null && MonsterManager.LaunchRoster.Contains( s.Id ) ).ToList();
	}

	// ============================================================
	// Counts
	// ============================================================
	private int GetDiscoveredCount()
	{
		// Only count discovered species that are also in the launch roster.
		var discovered = BeastiaryManager.Instance?.DiscoveredSpecies;
		if ( discovered == null ) return 0;
		return discovered.Count( id => MonsterManager.LaunchRoster.Contains( id ) );
	}
	private int GetTotalCount() => GetLaunchSpecies().Count;

	private int GetCompletionPercent()
	{
		int total = GetTotalCount();
		if ( total <= 0 ) return 0;
		return (int)((GetDiscoveredCount() / (float)total) * 100f);
	}

	// ============================================================
	// Filtering / sorting
	// ============================================================
	private List<MonsterSpecies> GetFilteredSpecies()
	{
		var species = GetLaunchSpecies();

		// Dual-type element filter: match primary OR secondary
		if ( currentElement.HasValue )
		{
			species = species.Where( s =>
				s.Element == currentElement.Value ||
				s.SecondaryElement == currentElement.Value ).ToList();
		}

		if ( currentSort == "name" && !string.IsNullOrEmpty( currentNameFilter ) )
		{
			species = species.Where( s => s.Name.Equals( currentNameFilter, StringComparison.OrdinalIgnoreCase ) ).ToList();
		}

		// Sort by the current mode first (each case picks its natural default
		// direction — e.g. rarity descending reads as "mythic first" which is
		// the expected "biggest first" convention). Then reverse at the end
		// if the user has toggled the direction arrow to the opposite of the
		// natural default.
		species = currentSort switch
		{
			"beastiary" => species.OrderBy( s => s.BeastiaryNumber ).ToList(),
			"power" => species.OrderByDescending( s => s.BaseHP + s.BaseATK + s.BaseDEF + s.BaseSpA + s.BaseSpD + s.BaseSPD ).ToList(),
			"basestats" => species.OrderByDescending( s => s.BaseHP + s.BaseATK + s.BaseDEF + s.BaseSpA + s.BaseSpD + s.BaseSPD ).ToList(),
			"level" => species.OrderBy( s => s.BeastiaryNumber ).ToList(),
			"genes" => species.OrderBy( s => s.BeastiaryNumber ).ToList(),
			"rarity" => species.OrderByDescending( s => (int)s.BaseRarity ).ThenBy( s => s.BeastiaryNumber ).ToList(),
			"recent" => species.OrderBy( s => s.BeastiaryNumber ).ToList(),
			"name" => species.OrderBy( s => s.Name ).ToList(),
			_ => species.OrderBy( s => s.BeastiaryNumber ).ToList()
		};

		// Each sort mode has a natural direction (ascending for number/name/
		// level, descending for basestats/rarity). The direction toggle flips
		// FROM that natural direction. We express that as: reverse the list
		// when the user's `sortAscending` disagrees with the natural default.
		bool naturalDescending = currentSort == "power" || currentSort == "basestats" || currentSort == "rarity";
		bool currentlyDescending = !sortAscending;
		if ( naturalDescending != currentlyDescending )
		{
			species.Reverse();
		}

		// Edit-mode pin: move the species currently being edited to index 0
		// so it shows at the top of the grid next to the toolbar. The actual
		// sort order is preserved for everything else.
		if ( _editMode && !string.IsNullOrEmpty( _editPinnedSpeciesId ) )
		{
			var pinIdx = species.FindIndex( s => s.Id == _editPinnedSpeciesId );
			if ( pinIdx > 0 )
			{
				var pinned = species[pinIdx];
				species.RemoveAt( pinIdx );
				species.Insert( 0, pinned );
			}
		}

		return species;
	}

	// ============================================================
	// Helpers
	// ============================================================
	private bool IsDiscovered( string speciesId ) => BeastiaryManager.Instance?.IsDiscovered( speciesId ) ?? false;
	private bool IsSeen( string speciesId ) => BeastiaryManager.Instance?.IsSeen( speciesId ) ?? false;

	private bool HasSprite( MonsterSpecies species )
	{
		if ( species == null ) return false;
		if ( species.AnimationFrames != null && species.AnimationFrames.Count > 0 ) return true;
		if ( !string.IsNullOrEmpty( species.IconPath ) ) return true;
		return false;
	}

	private void SelectSpecies( MonsterSpecies species, bool isDiscovered )
	{
		if ( selectedSpecies?.Id != species?.Id )
		{
			selectedSpecies = species;
			// Sync the keyboard cursor to mouse picks so W/S/A/D continues
			// from the clicked slot (and the living ring math stays honest).
			if ( species != null )
			{
				var syncIdx = GetFilteredSpecies().FindIndex( s => s.Id == species.Id );
				if ( syncIdx >= 0 ) selectedIndex = syncIdx;
			}
			// Reset to stats view on species change — each beast starts with a
			// clean, short detail view. User can re-toggle via diamonds.
			detailView = "stats";
			// Close any open beast preview popup — it belongs to the old species.
			showBeastPopup = false;
			// One-shot card-select pulse — keyed on selectPulseVersion so the
			// overlay div remounts each click and the @keyframes re-fires.
			// Ported from ShopPanelContent.
			justSelectedSpeciesId = species?.Id;
			selectPulseVersion++;
			// Bump the detail reveal key so the detail-fixed subtree remounts
			// and its staggered entrance @keyframes replay for the new beast.
			detailRevealVersion++;
			detailFreshSelect = true; // full top→bottom cascade for this reveal
			SoundManager.PlayClick();
		}
	}

	/// <summary>
	/// Diamond click handler — toggles the swappable bottom section.
	/// If the view is already showing the clicked diamond's target,
	/// snap back to "stats" (default). Otherwise switch to the new view.
	/// </summary>
	private void OnDiamondClick( string view )
	{
		detailFreshSelect = false; // view toggle → snappy reveal, not the full cascade
		if ( detailView == view )
			detailView = "stats"; // toggle back
		else
			detailView = view;
		SoundManager.PlayClick();
	}

	private void OnCardHover( string speciesId )
	{
		// Guard — onmouseover fires repeatedly while mouse stays on the element.
		// Only play the hover sound the first time the hovered card changes.
		if ( lastHoveredCardId != speciesId )
		{
			lastHoveredCardId = speciesId;
			SoundManager.PlayHover();
		}
	}

	// ============================================================
	// Beast preview popup — opens when the detail-pane portrait (or
	// the "cry" diamond) is clicked. Future home for per-species cry
	// audio + animation-set picker (idle / attack / faint / etc).
	// For now: zoom controls + big sprite view.
	// ============================================================
	private bool showBeastPopup = false;
	private float beastPopupZoom = 1f;
	private float beastPopupPanX = 0f;
	private float beastPopupPanY = 0f;
	private bool _isDraggingBeast = false;
	private float _dragStartMouseX = 0f;
	private float _dragStartMouseY = 0f;
	private float _dragStartPanX = 0f;
	private float _dragStartPanY = 0f;
	private bool _isMouseOverBeastStage = false;
	private const float BEAST_POPUP_ZOOM_MIN = 0.5f;
	private const float BEAST_POPUP_ZOOM_MAX = 3f;
	private const float BEAST_POPUP_ZOOM_STEP = 0.25f;
	// Mouse-wheel zoom step — smaller than button step for finer control.
	private const float BEAST_POPUP_WHEEL_ZOOM_STEP = 0.1f;

	private void OnPortraitClick()
	{
		if ( selectedSpecies == null ) return;
		beastPopupZoom = 1f;
		beastPopupPanX = 0f;
		beastPopupPanY = 0f;
		showBeastPopup = true;
		SoundManager.PlayClick();
	}

	private void CloseBeastPopup()
	{
		showBeastPopup = false;
		_isDraggingBeast = false;
		_isMouseOverBeastStage = false;
		SoundManager.PlayBack();
	}

	private void BeastPopupZoomIn()
	{
		beastPopupZoom = MathF.Min( BEAST_POPUP_ZOOM_MAX, beastPopupZoom + BEAST_POPUP_ZOOM_STEP );
		SoundManager.PlayHover();
	}

	private void BeastPopupZoomOut()
	{
		beastPopupZoom = MathF.Max( BEAST_POPUP_ZOOM_MIN, beastPopupZoom - BEAST_POPUP_ZOOM_STEP );
		SoundManager.PlayHover();
	}

	private void BeastPopupResetZoom()
	{
		beastPopupZoom = 1f;
		beastPopupPanX = 0f;
		beastPopupPanY = 0f;
		SoundManager.PlayClick();
	}

	// Drag handlers — mouse-down on the stage starts a drag, mouse-move
	// while dragging updates the pan offset by the mouse delta from start,
	// mouse-up ends the drag. Same pattern as RadioWidget volume slider.
	private void OnBeastStageDown( PanelEvent e )
	{
		_isDraggingBeast = true;
		_dragStartMouseX = MousePosition.x;
		_dragStartMouseY = MousePosition.y;
		_dragStartPanX = beastPopupPanX;
		_dragStartPanY = beastPopupPanY;
	}

	private void OnBeastStageMove( PanelEvent e )
	{
		if ( !_isDraggingBeast ) return;
		var dx = MousePosition.x - _dragStartMouseX;
		var dy = MousePosition.y - _dragStartMouseY;
		beastPopupPanX = _dragStartPanX + dx;
		beastPopupPanY = _dragStartPanY + dy;
	}

	private void OnBeastStageUp( PanelEvent e )
	{
		_isDraggingBeast = false;
	}

	private void OnBeastStageEnter()
	{
		_isMouseOverBeastStage = true;
	}

	private void OnBeastStageLeave()
	{
		_isMouseOverBeastStage = false;
		_isDraggingBeast = false;
	}

	private string BeastPopupSpriteStyle()
	{
		var ci = System.Globalization.CultureInfo.InvariantCulture;
		// Translate first (pan), then scale (zoom). transform-origin center
		// keeps zoom centered on the sprite even after panning.
		return $"transform: translate({beastPopupPanX.ToString("F2", ci)}px, {beastPopupPanY.ToString("F2", ci)}px) scale({beastPopupZoom.ToString("F2", ci)}); transform-origin: center center;";
	}

	private MonsterSpecies GetSpecies( string id ) => MonsterManager.Instance?.GetSpecies( id );

	private string GetAnimatedIcon( MonsterSpecies species )
	{
		if ( species == null ) return "ui/monsters/default.png";
		if ( species.AnimationFrames != null && species.AnimationFrames.Count > 0 )
		{
			int frameIndex = SpriteAnimator.GlobalFrame % species.AnimationFrames.Count;
			return species.AnimationFrames[frameIndex];
		}
		return species.IconPath ?? "ui/monsters/default.png";
	}

	private List<MonsterSpecies> GetEvolutionChain( MonsterSpecies species )
	{
		var chain = new List<MonsterSpecies>();
		if ( species == null ) return chain;

		var current = species;
		while ( !string.IsNullOrEmpty( current.EvolvesFrom ) )
		{
			var prev = GetSpecies( current.EvolvesFrom );
			if ( prev == null ) break;
			current = prev;
		}

		while ( current != null )
		{
			chain.Add( current );
			if ( string.IsNullOrEmpty( current.EvolvesTo ) ) break;
			current = GetSpecies( current.EvolvesTo );
		}

		return chain;
	}

	private int GetBaseStatTotal( MonsterSpecies species )
	{
		if ( species == null ) return 0;
		return species.BaseHP + species.BaseATK + species.BaseDEF +
			   species.BaseSpA + species.BaseSpD + species.BaseSPD;
	}

	/// <summary>
	/// Computes a stat bar fill as a percent (0-100). Works with the narrower
	/// stat bar in the new roster-style sidebar — no fixed pixel width needed,
	/// CSS transitions interpolate smoothly on select.
	/// </summary>
	private int GetStatFillPct( int statValue )
	{
		// 150 = "max" for visualization purposes
		return Math.Clamp( (statValue * 100) / 150, 0, 100 );
	}

	private string GetPersonalityColor( BeastPersonality p )
	{
		return p switch
		{
			BeastPersonality.Bold => "#d05040",
			BeastPersonality.Timid => "#4090d0",
			BeastPersonality.Greedy => "#c8a840",
			BeastPersonality.Loyal => "#50b060",
			BeastPersonality.Wild => "#9060c0",
			_ => "#888888"
		};
	}

	// ============================================================
	// BuildHash — include every field that affects render
	// ============================================================
	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add( currentElement );
		hash.Add( currentElementStr );
		hash.Add( currentSort );
		hash.Add( sortAscending );
		hash.Add( currentNameFilter );
		hash.Add( selectedSpecies?.Id );
		hash.Add( detailView );
		hash.Add( detailFreshSelect );
		hash.Add( hoveredTraitId );
		// Grid <-> detail keyboard focus switch — zone + action cursor both
		// drive visible state (zone glow, affordance pill, .kb-focused).
		hash.Add( kbFocusZone );
		hash.Add( detailActionIndex );
		hash.Add( GetDiscoveredCount() );
		// Beast preview popup state — visibility + zoom level need to rehash
		// so the popup opens, closes, and scales smoothly in response to
		// clicks/zoom controls.
		hash.Add( showBeastPopup );
		hash.Add( beastPopupZoom );
		hash.Add( beastPopupPanX );
		hash.Add( beastPopupPanY );
		hash.Add( _isDraggingBeast );
		// Always include animation frame — grid cards animate even when no
		// species is selected, AND undiscovered silhouettes still cycle
		// (animated shadow is free juice + signals there's a creature there).
		hash.Add( SpriteAnimator.GlobalFrame );
		// Select-pulse state — without these in the hash, the panel won't
		// re-render on re-click and the one-shot flash won't remount.
		hash.Add( justSelectedSpeciesId );
		hash.Add( selectPulseVersion );
		// Living violet ring — markup-bound position + visibility class.
		hash.Add( bbRingL );
		hash.Add( bbRingT );
		hash.Add( bbRingW );
		hash.Add( bbRingH );
		hash.Add( bbRingVisible );
		hash.Add( bbRingWarm < 2 );
		// T3 discovery reveal — visibility + version (remount key) + which
		// species so the overlay mounts/dismisses and swaps subject cleanly.
		hash.Add( discoveryCelebrationActive );
		hash.Add( discoveryVersion );
		hash.Add( discoverySpecies?.Id );
		// Detail reveal key — drives the per-species entrance cascade remount.
		hash.Add( detailRevealVersion );
		// Edit-mode state — toolbar visibility, drag/hover targets, and the
		// override-count badge all need to react to these.
		hash.Add( _editMode );
		hash.Add( _draggingSpeciesId );
		hash.Add( _hoveredEditCardId );
		hash.Add( _editPinnedSpeciesId );
		hash.Add( _cardOverrides.Count );
		// Cheap content fingerprint so dragging/scaling re-renders the
		// affected card transform every frame the value changes (rather
		// than only when count flips).
		foreach ( var kvp in _cardOverrides )
		{
			hash.Add( kvp.Key );
			hash.Add( kvp.Value.Scale );
			hash.Add( kvp.Value.OffX );
			hash.Add( kvp.Value.OffY );
		}
		return hash.ToHashCode();
	}
}
