@namespace Beastborne.UI.Panels
@using Sandbox;
@using Sandbox.UI;
@using Beastborne.Core;
@using Beastborne.Data;
@using Beastborne.Systems;
@using Beastborne.UI;
@using Beastborne.UI.Components;
@using Beastborne.UI.Primitives;
@inherits Panel

@*
	QUESTS — rebuild 2026-09-11 (LAYOUT lane, quests-redesign-brief.html).
	"The player is here to claim what they have earned and see what is left
	to do." Five control kinds only: CLAIM · CLAIM BONUS · ACCEPT · BACK·Q ·
	nothing. No tabs, no calendar, no bonus slabs, no scroll, no hint rows.

	ZONE MAP (1920×1080, PADDING-BOX — declared sizes INCLUDE padding,
	borders add on top):
	  HEADER  y 0-90    .qp-header 88 declared (pad 16/32/12/28) + 2px strip
	  BODY    y 90-1080 .qp-body 990 declared (pad 20/40) → inner 1840×950
	                    columns 912 + 16 + 912
	  LEFT  x 40-952 : LOGIN 240 @ y110 · gap 16 · DAILY 694 @ y366 → 1060
	  RIGHT x 968-1880: WEEKLY 378 @ y110 · 16 · MONTHLY 162 @ y504 · 16 ·
	                    SIDE QUESTS 378 @ y682 → 1060
	  Each slab = .qp-band 36 + .qp-list (pad 16, rows gap 14).
	  Rows 880 wide: ROOMY 114 (daily ×5) / DENSE 94 (weekly ×3 · monthly ×1
	  · side ×3). Lists are sorted at OPEN only — a claimed row settles in
	  place, it never jumps.

	LANE: input — stops are the pressables only (CLAIM DAY n · CLAIM BONUS ·
	CLAIM · ACCEPT), rebuilt from the same @if list the markup draws; one
	imperative ring at page root (mount it as the LAST child of .qp-page);
	device flag kbd-mode/mouse-mode on .qp-page + 3px travel guard; W/S/A/D
	+ Space/E/Enter; Q closes (PanelHandledBackKey claimed in Tick below).
	LANE: motion — zone rungs qpZone*, row ladder qpRowIn0-7 (WINDOWED
	classes from code, never static), qpClaimBeat / qpClaimInk /
	qpAccentTick (the .row-accent strip is the HDR host) / qpChipIn /
	qpAcceptBeat, exit latch .qp-leaving. Static states only here.
	LANE: color — page accent #3fb45e applied where the brief declares it;
	gold on primaries / claimable numerals / DONE ink; violet = ring only.
*@

<root class="quest-panel-root @_rootVisibleClass">
	<div class="qp-page">
		<!-- Living background — the quests glyph drifting. First child; the
		     page paints NO fill of its own (opaque pattern tiles). -->
		<BbIconScroll Icon="quests" />

		@if ( IsVisible )
		{
			<!-- HEADER — the hub .oh-header recipe: waves (host paints no
			     fill) · kicker · italic title · polygon seams · BACK·Q in the
			     right slot. Fresh mount under the IsVisible branch. -->
			<div class="qp-header">
				<BbHeaderWaves Accent=@("quests") />
				<div class="qp-identity">
					<span class="qp-kicker">TAMER</span>
					<div class="qp-title-row">
						<span class="qp-title">QUESTS</span>
						<div class="qp-seam"></div>
						<div class="qp-seam dim"></div>
					</div>
				</div>
				<div class="qp-toolbar">
					<div class="qp-back" onmouseover=@OnBackHover onclick=@Close>
						<span class="qp-back-label">BACK</span>
						<span class="qp-back-cap">Q</span>
					</div>
				</div>
			</div>

			<!-- BODY — two pinned columns, no scroll container anywhere. -->
			<div class="qp-body">
				<div class="qp-col">
					@RenderLogin()
					@RenderDaily()
				</div>
				<div class="qp-col">
					@RenderWeekly()
					@RenderMonthly()
					@RenderSide()
				</div>
			</div>
			<!-- LANE: input — the one imperative ring mounts HERE (last child of
			     .qp-page, z above the slabs so their overflow never clips it). -->
		}
	</div>
</root>

@code {
	public static QuestPanel Instance { get; private set; }
	public static bool IsVisible { get; private set; }

	// Pre-computed class names used in attribute values — s&box Razor chokes on
	// nested double-quotes like class="@(IsVisible ? "visible" : "")".
	private string _rootVisibleClass => IsVisible ? "visible" : "";

	private const string Accent = "#3fb45e";
	private const int BarW = 320; // .qp-bar declared width — fills arrive as px

	// ── OPEN-TIME ORDER (brief §4: lists sorted at OPEN only) ──
	// Captured when the page opens; rows render in this order until the next
	// open, so a claim settles a row in place instead of re-sorting the list.
	private static List<string> _dailyOrder = new();
	private static List<string> _weeklyOrder = new();
	private static List<string> _sideOrder = new();
	private static int _orderStamp;

	// Hover-sound guard for the one mouse-only cap (no onmouseenter in s&box).
	private bool _backHovered;
	private void OnBackHover()
	{
		if ( _backHovered ) return;
		_backHovered = true;
		SoundManager.PlayHover();
	}

	// ══════════════════════════════════════════════
	// LIFECYCLE
	// ══════════════════════════════════════════════

	protected override void OnAfterTreeRender( bool firstTime )
	{
		if ( firstTime ) Instance = this;
	}

	public static void Show()
	{
		CaptureOrder();
		IsVisible = true;
		if ( Instance != null ) Instance._backHovered = false;
		SoundManager.PlayPopup();
	}

	public static void Close()
	{
		IsVisible = false;
		if ( Instance != null ) Instance._backHovered = false;
		SoundManager.PlayPopdown();
	}

	public static void Toggle()
	{
		if ( IsVisible ) Close();
		else Show();
	}

	public override void Tick()
	{
		base.Tick();
		if ( !IsVisible || !UIModalState.IsTopModal( "QuestPanel" ) ) return;

		// Q = back, always (one stage). Claim it so GameHUD does not also flip
		// into its own Menu handling. Escape (s&box-reserved) and run close too.
		// LANE: input — W/S/A/D + Space/E/Enter stop walking attaches here;
		// LANE: motion — the exit latch (.qp-leaving) commits IsVisible=false
		// from Tick after its window instead of this immediate Close().
		if ( Input.Pressed( "Menu" ) )
		{
			GameHUD.PanelHandledBackKey = true;
			Close();
			return;
		}
		if ( Input.Pressed( "Escape" ) || Input.Pressed( "run" ) )
			Close();
	}

	// ══════════════════════════════════════════════
	// BADGE (P2 — honest count: today's login + missions incl. both bonuses
	// + claimable side quests; milestones are DailyPanel's, never drawn here)
	// ══════════════════════════════════════════════

	/// <summary>Total unclaimed on THIS page — GameHUD / PawPad badge.</summary>
	public static int GetTotalUnclaimedCount()
	{
		int count = 0;
		if ( DailyRewardManager.Instance != null && !DailyRewardManager.Instance.TodayRewardClaimed ) count++;
		count += MissionManager.Instance?.GetUnclaimedCount() ?? 0;
		count += ClaimableSideCount();
		return count;
	}

	// Only states with a LIVE definition count — a save can carry states for
	// retired quest ids (live 2026-09-11: `cove_twigs`), which never render
	// and can never be claimed (SideQuestManager.Claim returns false on a
	// null def), so they must not light the badge.
	private static int ClaimableSideCount()
	{
		var sq = SideQuestManager.Instance;
		if ( sq == null ) return 0;
		return sq.ActiveQuests.Count( q => q.Completed && !q.RewardClaimed && sq.GetDefinition( q.Id ) != null );
	}

	protected override int BuildHash()
	{
		var h = new HashCode();
		h.Add( IsVisible );
		h.Add( _orderStamp );
		h.Add( GetTotalUnclaimedCount() );
		h.Add( MissionManager.Instance?.DailyBonusClaimed ?? false );
		h.Add( MissionManager.Instance?.WeeklyBonusClaimed ?? false );
		h.Add( MissionManager.Instance?.AreAllDailiesComplete() ?? false );
		h.Add( MissionManager.Instance?.AreAllWeekliesComplete() ?? false );
		h.Add( DailyRewardManager.Instance?.TodayRewardClaimed ?? false );
		h.Add( DailyRewardManager.Instance?.DailyStreak ?? 0 );
		h.Add( DailyRewardManager.Instance?.GetWeekMultiplier() ?? 1f );
		h.Add( SideQuestManager.Instance?.DevForceAvailable ?? false );

		// Reset timers tick once a minute (the darkchips read minutes).
		h.Add( GetDailyTimer() );
		h.Add( GetWeeklyTimer() );
		h.Add( GetMonthlyTimer() );

		foreach ( var mn in MissionManager.Instance?.ActiveDailyMissions ?? new() )
			h.Add( mn.Progress + (mn.Completed ? 500_000 : 0) + (mn.Claimed ? 1_000_000 : 0) );
		foreach ( var mn in MissionManager.Instance?.ActiveWeeklyMissions ?? new() )
			h.Add( mn.Progress + (mn.Completed ? 500_000 : 0) + (mn.Claimed ? 1_000_000 : 0) );
		if ( MissionManager.Instance?.ActiveMonthlyChallenge is { } mc )
			h.Add( mc.Progress + (mc.Completed ? 500_000 : 0) + (mc.Claimed ? 1_000_000 : 0) );

		foreach ( var sq in SideQuestManager.Instance?.ActiveQuests ?? new List<SideQuestState>() )
			h.Add( sq.Id + sq.Progress + (sq.Completed ? 1_000_000 : 0) + (sq.RewardClaimed ? 2_000_000 : 0) );
		foreach ( var def in SideQuestManager.Instance?.AllDefinitions ?? new List<SideQuest>() )
			h.Add( SideQuestManager.Instance.IsAvailable( def.Id ) ? 1 : 0 );

		// LANE: input — add _kbStop + lastInputDevice. LANE: motion — add the
		// beat / tick windows (RealTime.Now < until bools).
		return h.ToHashCode();
	}

	// ══════════════════════════════════════════════
	// ORDER CAPTURE (open only)
	// ══════════════════════════════════════════════

	private static int ClaimSortKey( MissionState s )
		=> (s.Completed && !s.Claimed) ? 0 : s.Claimed ? 2 : 1;

	// claimable → active → available → locked → done
	private static int SideSortKey( SideQuest def )
	{
		var mgr = SideQuestManager.Instance;
		var st = mgr?.GetState( def.Id );
		if ( st != null && st.Completed && !st.RewardClaimed ) return 0;
		if ( st != null ) return 1;
		if ( mgr?.IsCompletedOneShot( def.Id ) == true ) return 4;
		if ( mgr?.IsAvailable( def.Id ) == true ) return 2;
		return 3;
	}

	private static void CaptureOrder()
	{
		var mm = MissionManager.Instance;
		_dailyOrder = (mm?.ActiveDailyMissions ?? new()).OrderBy( ClaimSortKey ).Select( m => m.MissionId ).ToList();
		_weeklyOrder = (mm?.ActiveWeeklyMissions ?? new()).OrderBy( ClaimSortKey ).Select( m => m.MissionId ).ToList();
		_sideOrder = (SideQuestManager.Instance?.AllDefinitions ?? new List<SideQuest>()).OrderBy( SideSortKey ).Select( d => d.Id ).ToList();
		_orderStamp++;
	}

	private static List<T> Ordered<T>( IEnumerable<T> items, Func<T, string> id, List<string> order )
	{
		var list = items.ToList();
		return list.OrderBy( x => { var i = order.IndexOf( id( x ) ); return i < 0 ? int.MaxValue : i; } ).ToList();
	}

	// ══════════════════════════════════════════════
	// HELPERS
	// ══════════════════════════════════════════════

	private static string GetGlyph( MissionDefinition def ) => def?.Category switch
	{
		MissionCategory.Battle => "lucide:swords",
		MissionCategory.Expedition => "lucide:compass",
		MissionCategory.Collection => "lucide:package",
		MissionCategory.Economy => "lucide:coins",
		MissionCategory.Social => "lucide:users",
		_ => "lucide:star",
	};

	// arena_* rolls while ranked is kill-switched — the row wears .dormant.
	private static bool IsDormant( MissionDefinition def )
		=> def != null && !MissionManager.ArenaMissionsEnabled && def.Id.StartsWith( "arena_" );

	private static int FillPx( int progress, int target )
	{
		if ( target <= 0 ) return BarW;
		var pct = Math.Clamp( (float)progress / target, 0f, 1f );
		return (int)(pct * BarW);
	}

	// n / N — targets ≥ 10,000 read "31.2K / 50K" (the counter lane is 108).
	private static string FormatCounter( int progress, int target )
	{
		if ( target >= 10000 )
			return $"{FormatK( progress )} / {FormatK( target )}";
		return $"{progress:N0} / {target:N0}";
	}

	private static string FormatK( int n )
	{
		if ( n < 1000 ) return n.ToString( "N0" );
		return (n / 1000f).ToString( "0.#" ) + "K";
	}

	private void ClaimMission( string id )
	{
		if ( MissionManager.Instance?.ClaimReward( id ) == true )
			SoundManager.PlaySuccess();
	}
	private void ClaimStreak()
	{
		if ( DailyRewardManager.Instance?.ClaimDailyReward() == true )
			SoundManager.PlaySuccess();
	}
	private void ClaimDailyBonus()
	{
		if ( MissionManager.Instance?.ClaimDailyBonus() == true )
			SoundManager.PlaySuccess();
	}
	private void ClaimWeeklyBonus()
	{
		if ( MissionManager.Instance?.ClaimWeeklyBonus() == true )
			SoundManager.PlaySuccess();
	}
	private void AcceptSideQuest( string id )
	{
		if ( SideQuestManager.Instance?.Accept( id ) == true )
			SoundManager.PlayClick();
	}
	private void ClaimSideQuest( string id )
	{
		if ( SideQuestManager.Instance?.Claim( id ) == true )
			SoundManager.PlaySuccess();
	}

	private string GetDailyTimer() => "RESETS " + FormatDuration( MissionManager.Instance?.GetDailyTimeRemaining() ?? TimeSpan.Zero );
	private string GetWeeklyTimer() => "RESETS " + FormatDuration( MissionManager.Instance?.GetWeeklyTimeRemaining() ?? TimeSpan.Zero );
	private string GetMonthlyTimer() => "RESETS " + FormatDuration( MissionManager.Instance?.GetMonthlyTimeRemaining() ?? TimeSpan.Zero );

	private static string FormatDuration( TimeSpan ts )
	{
		if ( ts.TotalDays >= 1 ) return $"{(int)ts.TotalDays}D {ts.Hours:D2}H";
		if ( ts.TotalHours >= 1 ) return $"{(int)ts.TotalHours}H {ts.Minutes:D2}M";
		return $"{ts.Minutes}M";
	}

	private static string ItemName( string itemId )
		=> ItemManager.Instance?.GetItem( itemId )?.Name ?? itemId;
	private static string ItemIcon( string itemId )
		=> ItemManager.Instance?.GetItem( itemId )?.IconPath ?? "";
	private static string ZoneName( string zoneId )
		=> ExpeditionManager.Instance?.GetExpedition( zoneId )?.Name ?? zoneId;

	// Reward parts — (icon path or "", text). Currencies + XP/SP on line 1,
	// items on line 2. N0 everywhere; the word "gem" never appears.
	private static List<(string Icon, string Text)> MissionCurrencyParts( MissionDefinition def )
	{
		var parts = new List<(string, string)>();
		if ( def.GoldReward > 0 ) parts.Add( ("ui/icons/currency/money.png", def.GoldReward.ToString( "N0" )) );
		if ( def.InkReward > 0 ) parts.Add( ("ui/icons/currency/ink.png", def.InkReward.ToString( "N0" )) );
		if ( def.GemReward > 0 ) parts.Add( ("ui/icons/currency/token.png", def.GemReward.ToString( "N0" )) );
		if ( def.XPReward > 0 ) parts.Add( ("", def.XPReward.ToString( "N0" ) + " XP") );
		return parts;
	}

	private static List<(string Icon, string Text)> SideCurrencyParts( SideQuest def )
	{
		var parts = new List<(string, string)>();
		if ( def.GoldReward > 0 ) parts.Add( ("ui/icons/currency/money.png", def.GoldReward.ToString( "N0" )) );
		if ( def.XPReward > 0 ) parts.Add( ("", def.XPReward.ToString( "N0" ) + " XP") );
		if ( def.SkillPointReward > 0 ) parts.Add( ("", def.SkillPointReward.ToString( "N0" ) + " SP") );
		return parts;
	}

	// ══════════════════════════════════════════════
	// SHARED FRAGMENTS
	// ══════════════════════════════════════════════

	// One line of reward parts joined by "·". Every text node is its own span
	// (bare-text law); the img is 16px.
	private RenderFragment RewardLine( List<(string Icon, string Text)> parts ) => __builder =>
	{
		<div class="qp-rwline">
			@for ( int i = 0; i < parts.Count; i++ )
			{
				var p = parts[i];
				if ( i > 0 )
				{
					<span class="qp-rwsep">&middot;</span>
				}
				if ( !string.IsNullOrEmpty( p.Icon ) )
				{
					<img class="qp-rwicon" src="@p.Icon" />
				}
				<span class="qp-rw">@p.Text</span>
			}
		</div>
	};

	// Band darkchip — the Guild .gp-darkchip shape. Tone: "" | gold | green
	private RenderFragment DarkChip( string text, string tone ) => __builder =>
	{
		var cls = "qp-darkchip " + tone;
		<div class="@cls"><span>@text</span></div>
	};

	// Action-slot status chip (DONE gold ink / LOCKED · NOT OPEN YET dim ink).
	private RenderFragment StatusChip( string text, string tone ) => __builder =>
	{
		var cls = "qp-chip " + tone;
		<div class="@cls"><span>@text</span></div>
	};

	// ══════════════════════════════════════════════
	// LOGIN — 912×240: band 36 + body 204 (pad 16 → inner 880×172)
	//   left : hero 76/84 at inner y28 · pips 20 at inner y144
	//   right: reward line 16 at inner y76 · CLAIM DAY n 320×56 at inner y112
	// ══════════════════════════════════════════════

	private RenderFragment RenderLogin() => __builder =>
	{
		var drm = DailyRewardManager.Instance;
		var streak = drm?.DailyStreak ?? 0;
		var claimed = drm?.TodayRewardClaimed ?? true;
		var day = drm?.GetStreakDay() ?? 1;
		var mult = drm?.GetWeekMultiplier() ?? 1f;
		var (gold, gems, ink) = drm?.GetTodayReward() ?? (0, 0, 0);
		var itemId = drm?.GetDayItemReward( day );

		// A2 — today's full reward: gold ×mult, ink, tokens, the day item, and
		// the day-7 Master Ink grant (DailyRewardManager.GrantDay7MasterInk).
		var parts = new List<(string Icon, string Text)>();
		if ( gold > 0 ) parts.Add( ("ui/icons/currency/money.png", gold.ToString( "N0" )) );
		if ( ink > 0 ) parts.Add( ("ui/icons/currency/ink.png", ink.ToString( "N0" )) );
		if ( gems > 0 ) parts.Add( ("ui/icons/currency/token.png", gems.ToString( "N0" )) );
		if ( !string.IsNullOrEmpty( itemId ) ) parts.Add( (ItemIcon( itemId ), ItemName( itemId ) + " ×1") );
		if ( day == 7 ) parts.Add( (ItemIcon( "boss_master_ink" ), ItemName( "boss_master_ink" ) + " ×1") );

		var slabClass = "qp-slab login" + (claimed ? " claimed" : "");
		var rwClass = "qp-login-rewards" + (claimed ? "" : " gold");
		var heroText = "DAY " + day;
		var streakText = streak + (streak == 1 ? " DAY" : " DAYS");
		var multText = "×" + mult.ToString( "0.#" ) + " GOLD";
		var claimLabel = "CLAIM DAY " + day;

		<div class="@slabClass">
			<div class="row-accent"></div>
			<div class="qp-band">
				<div class="qp-chipstamp"><span>LOGIN STREAK</span></div>
				@DarkChip( streakText, "" )
				@if ( mult > 1f )
				{
					@DarkChip( multText, "gold" )
				}
			</div>
			<div class="qp-login-body">
				<div class="qp-login-left">
					<span class="qp-hero">@heroText</span>
					<div class="qp-pips">
						@for ( int d = 1; d <= 7; d++ )
						{
							var pipDone = d < day || (d == day && claimed);
							var pipToday = d == day && !claimed;
							var pipClass = "qp-pip" + (pipDone ? " done" : pipToday ? " today" : " future");
							<div class="@pipClass"></div>
						}
					</div>
				</div>
				<div class="qp-login-right">
					<div class="@rwClass">
						@RewardLine( parts )
					</div>
					@if ( claimed )
					{
						<div class="qp-login-claimed"><span>CLAIMED</span></div>
					}
					else
					{
						<BbButton Tier="primary" Size=@(56) Label="@claimLabel" KeyCap="SPACE" Class="qp-login-btn" OnClick=@ClaimStreak />
					}
				</div>
			</div>
		</div>
	};

	// ══════════════════════════════════════════════
	// DAILY — 912×694: band (timer · x/5 · bonus tri-state) + 5 ROOMY rows
	//   36 + 16 + 5×114 + 4×14 + 16 = 694
	// ══════════════════════════════════════════════

	private RenderFragment RenderDaily() => __builder =>
	{
		var mm = MissionManager.Instance;
		var dailies = Ordered( mm?.ActiveDailyMissions ?? new(), m => m.MissionId, _dailyOrder );
		var claimedCount = dailies.Count( m => m.Claimed );
		var allDone = mm?.AreAllDailiesComplete() ?? false;
		var bonusClaimed = mm?.DailyBonusClaimed ?? false;
		var countText = claimedCount + " / " + dailies.Count;
		var bonusGold = MissionManager.DailyBonusGold.ToString( "N0" );
		var bonusGems = MissionManager.DailyBonusGems.ToString( "N0" );
		var bonusXp = MissionManager.DailyBonusXP.ToString( "N0" ) + " XP";

		<div class="qp-slab daily">
			<div class="qp-band">
				<div class="qp-chipstamp"><span>DAILY</span></div>
				@DarkChip( GetDailyTimer(), "" )
				<div class="qp-band-spacer"></div>
				@DarkChip( countText, "" )
				@if ( bonusClaimed )
				{
					@DarkChip( "BONUS CLAIMED", "green" )
				}
				else if ( allDone )
				{
					<BbButton Tier="primary" Size=@(34) Label="CLAIM BONUS" Class="qp-bonus-btn" OnClick=@ClaimDailyBonus />
				}
				else
				{
					<div class="qp-darkchip dim bonus">
						<img class="qp-bonus-icon" src="ui/icons/currency/money.png" />
						<span>@bonusGold</span>
						<span class="qp-sep">&middot;</span>
						<img class="qp-bonus-icon" src="ui/icons/currency/token.png" />
						<span>@bonusGems</span>
						<span class="qp-sep">&middot;</span>
						<span>@bonusXp</span>
						<span class="qp-sep">&middot;</span>
						<span>BONUS</span>
					</div>
				}
			</div>
			<div class="qp-list">
				@if ( dailies.Count == 0 )
				{
					<span class="qp-empty">New missions arrive at the reset.</span>
				}
				@for ( int i = 0; i < dailies.Count; i++ )
				{
					@MissionRow( dailies[i], i, true )
				}
			</div>
		</div>
	};

	// ══════════════════════════════════════════════
	// WEEKLY — 912×378: band + 3 DENSE rows (36 + 16 + 3×94 + 2×14 + 16)
	// ══════════════════════════════════════════════

	private RenderFragment RenderWeekly() => __builder =>
	{
		var mm = MissionManager.Instance;
		var weeklies = Ordered( mm?.ActiveWeeklyMissions ?? new(), m => m.MissionId, _weeklyOrder );
		var claimedCount = weeklies.Count( m => m.Claimed );
		var allDone = mm?.AreAllWeekliesComplete() ?? false;
		var bonusClaimed = mm?.WeeklyBonusClaimed ?? false;
		var countText = claimedCount + " / " + weeklies.Count;
		var bonusGold = MissionManager.WeeklyBonusGold.ToString( "N0" );
		var bonusGems = MissionManager.WeeklyBonusGems.ToString( "N0" );

		<div class="qp-slab weekly">
			<div class="qp-band">
				<div class="qp-chipstamp"><span>WEEKLY</span></div>
				@DarkChip( GetWeeklyTimer(), "" )
				<div class="qp-band-spacer"></div>
				@DarkChip( countText, "" )
				@if ( bonusClaimed )
				{
					@DarkChip( "BONUS CLAIMED", "green" )
				}
				else if ( allDone )
				{
					<BbButton Tier="primary" Size=@(34) Label="CLAIM BONUS" Class="qp-bonus-btn" OnClick=@ClaimWeeklyBonus />
				}
				else
				{
					<div class="qp-darkchip dim bonus">
						<img class="qp-bonus-icon" src="ui/icons/currency/money.png" />
						<span>@bonusGold</span>
						<span class="qp-sep">&middot;</span>
						<img class="qp-bonus-icon" src="ui/icons/currency/token.png" />
						<span>@bonusGems</span>
						<span class="qp-sep">&middot;</span>
						<span>BONUS</span>
					</div>
				}
			</div>
			<div class="qp-list">
				@if ( weeklies.Count == 0 )
				{
					<span class="qp-empty">New challenges arrive on Monday.</span>
				}
				@for ( int i = 0; i < weeklies.Count; i++ )
				{
					@MissionRow( weeklies[i], i, false )
				}
			</div>
		</div>
	};

	// ══════════════════════════════════════════════
	// MONTHLY — 912×162: band + 1 DENSE row (36 + 16 + 94 + 16)
	// ══════════════════════════════════════════════

	private RenderFragment RenderMonthly() => __builder =>
	{
		var monthly = MissionManager.Instance?.ActiveMonthlyChallenge;

		<div class="qp-slab monthly">
			<div class="qp-band">
				<div class="qp-chipstamp"><span>MONTHLY</span></div>
				@DarkChip( GetMonthlyTimer(), "" )
			</div>
			<div class="qp-list">
				@if ( monthly != null )
				{
					@MissionRow( monthly, 0, false )
				}
				else
				{
					<span class="qp-empty">The next challenge arrives on the 1st.</span>
				}
			</div>
		</div>
	};

	// ══════════════════════════════════════════════
	// SIDE QUESTS — 912×378: band + 3 DENSE rows (always the 3 definitions)
	// ══════════════════════════════════════════════

	private RenderFragment RenderSide() => __builder =>
	{
		var defs = Ordered( SideQuestManager.Instance?.AllDefinitions ?? new List<SideQuest>(), d => d.Id, _sideOrder );

		<div class="qp-slab side">
			<div class="qp-band">
				<div class="qp-chipstamp"><span>SIDE QUESTS</span></div>
			</div>
			<div class="qp-list">
				@for ( int i = 0; i < defs.Count; i++ )
				{
					@SideRow( defs[i], i )
				}
			</div>
		</div>
	};

	// ══════════════════════════════════════════════
	// THE ROW — one recipe, two stops (ROOMY 114 / DENSE 94), 880 wide:
	//   16 · tile 40 · 16 · text 436 · 16 · rewards 204 · 16 · action 120 · 16
	//   text lane: name 17/21 · desc 13/16 (1 line roomy / 2 lines dense)
	//              · bar 320×8 + 8 + counter 108 = 436
	// ══════════════════════════════════════════════

	private RenderFragment MissionRow( MissionState m, int idx, bool roomy ) => __builder =>
	{
		var def = MissionManager.Instance?.GetDefinition( m.MissionId );
		if ( def == null ) return;

		var dormant = IsDormant( def );
		var done = m.Claimed;
		var claimable = m.Completed && !m.Claimed && !dormant;
		var rowClass = "qp-row " + (roomy ? "roomy" : "dense")
			+ (idx % 2 == 1 ? " alt" : "")
			+ (claimable ? " claimable" : "")
			+ (done ? " done" : "")
			+ (dormant ? " dormant" : "");
		var desc = dormant ? "Ranked battles are not open yet." : def.Description;
		var fillStyle = "width: " + FillPx( m.Progress, def.Target ) + "px;";
		var counter = FormatCounter( m.Progress, def.Target );
		var missionId = m.MissionId;

		<div class="@rowClass">
			<div class="row-accent"></div>
			<div class="qp-tile">
				<iconify class="qp-glyph" icon="@GetGlyph( def )" Size=@(22) Color="@Accent" />
			</div>
			<div class="qp-text">
				<div class="qp-nameline">
					<span class="qp-name">@def.Name</span>
				</div>
				<span class="qp-desc">@desc</span>
				<div class="qp-barrow">
					@if ( !dormant )
					{
						<div class="qp-bar"><div class="qp-fill" style="@fillStyle"></div></div>
						<div class="qp-counter"><span class="qp-count">@counter</span></div>
					}
				</div>
			</div>
			<div class="qp-rewards">
				@RewardLine( MissionCurrencyParts( def ) )
				@if ( !string.IsNullOrEmpty( def.ItemReward ) )
				{
					@RewardLine( new List<(string, string)> { (ItemIcon( def.ItemReward ), ItemName( def.ItemReward ) + " ×1") } )
				}
			</div>
			<div class="qp-action">
				@if ( done )
				{
					@StatusChip( "DONE", "gold" )
				}
				else if ( dormant )
				{
					@StatusChip( "NOT OPEN YET", "dim" )
				}
				else if ( claimable )
				{
					<BbButton Tier="primary" Size=@(44) Label="CLAIM" Class="qp-claim" OnClick=@(() => ClaimMission( missionId )) />
				}
			</div>
		</div>
	};

	private RenderFragment SideRow( SideQuest def, int idx ) => __builder =>
	{
		var mgr = SideQuestManager.Instance;
		var state = mgr?.GetState( def.Id );
		var doneOneShot = mgr?.IsCompletedOneShot( def.Id ) == true;
		var claimable = state != null && state.Completed && !state.RewardClaimed;
		var available = state == null && !doneOneShot && mgr?.IsAvailable( def.Id ) == true;
		var locked = state == null && !doneOneShot && !available;

		var rowClass = "qp-row dense"
			+ (idx % 2 == 1 ? " alt" : "")
			+ (claimable ? " claimable" : "")
			+ (doneOneShot ? " done" : "")
			+ (locked ? " locked" : "")
			+ (available ? " avail" : "");

		var zone = ZoneName( def.ZoneId );
		var desc = locked ? "Clear " + zone + " once to unlock." : def.Description;
		var progress = doneOneShot ? def.Target : (state?.Progress ?? 0);
		var fillStyle = "width: " + FillPx( progress, def.Target ) + "px;";
		var counter = FormatCounter( progress, def.Target );
		var openNote = "OPEN · " + zone.ToUpperInvariant() + " CLEARED";
		var byline = "· " + def.NpcName;
		var questId = def.Id;

		// A1 — item rewards on side rows (Contract Incense ×2 / Premium Incense ×1).
		var itemParts = new List<(string Icon, string Text)>();
		foreach ( var (itemId, qty) in def.ItemRewards ?? new() )
			itemParts.Add( (ItemIcon( itemId ), ItemName( itemId ) + " ×" + qty) );

		<div class="@rowClass">
			<div class="row-accent"></div>
			<div class="qp-tile">
				<iconify class="qp-glyph" icon="lucide:scroll-text" Size=@(22) Color="@Accent" />
			</div>
			<div class="qp-text">
				<div class="qp-nameline">
					<span class="qp-name">@def.Title</span>
					@if ( !string.IsNullOrEmpty( def.NpcName ) )
					{
						<span class="qp-by">@byline</span>
					}
				</div>
				<span class="qp-desc">@desc</span>
				<div class="qp-barrow">
					@if ( available )
					{
						<span class="qp-note">@openNote</span>
					}
					else if ( !locked )
					{
						<div class="qp-bar"><div class="qp-fill" style="@fillStyle"></div></div>
						<div class="qp-counter"><span class="qp-count">@counter</span></div>
					}
				</div>
			</div>
			<div class="qp-rewards">
				@RewardLine( SideCurrencyParts( def ) )
				@if ( itemParts.Count > 0 )
				{
					@RewardLine( itemParts )
				}
			</div>
			<div class="qp-action">
				@if ( doneOneShot )
				{
					@StatusChip( "DONE", "gold" )
				}
				else if ( locked )
				{
					@StatusChip( "LOCKED", "dim" )
				}
				else if ( claimable )
				{
					<BbButton Tier="primary" Size=@(44) Label="CLAIM" Class="qp-claim" OnClick=@(() => ClaimSideQuest( questId )) />
				}
				else if ( available )
				{
					<BbButton Tier="secondary" Size=@(44) Label="ACCEPT" Icon="lucide:check" IconTint="@Accent" Class="qp-accept" OnClick=@(() => AcceptSideQuest( questId )) />
				}
			</div>
		</div>
	};

	// ══════════════════════════════════════════════
	// DEV HOOK — dev_quests [ (none) | claim | bonus | streak | side | empty | reset | off ]
	// The dev_bag pattern (InventoryPanel): close the phone, open the page,
	// mutate live state through the managers' public setters / dev hooks.
	//   dev_quests         → open
	//   dev_quests claim   → first in-progress daily → Completed (CLAIM lights)
	//   dev_quests bonus   → all 5 dailies Completed + Claimed (CLAIM BONUS lights)
	//   dev_quests streak  → today's login reward un-claimed (CLAIM DAY n)
	//   dev_quests side    → zone gate bypassed (ACCEPT) + first active side quest Completed
	//   dev_quests empty   → everything claimed, both bonuses paid, login claimed
	//   dev_quests reset   → re-roll all mission tiers + un-claim login (shoot again)
	//   dev_quests off     → close
	// Session-only mutations (MissionManager persists on real claims only).
	// REMOVE after the redesign is user-approved.
	// ══════════════════════════════════════════════

	[ConCmd( "dev_quests" )]
	public static void DevQuests( string arg = "" )
	{
		var gm = Beastborne.Core.GameManager.Instance;
		if ( gm != null && !gm.IsInGame ) gm.StartGame();

		var mm = MissionManager.Instance;
		var drm = DailyRewardManager.Instance;
		var sq = SideQuestManager.Instance;
		arg = (arg ?? "").Trim().ToLowerInvariant();

		switch ( arg )
		{
			case "off":
				if ( IsVisible ) Close();
				Log.Info( "[Quests] dev_quests off" );
				return;

			case "claim":
			{
				var target = mm?.ActiveDailyMissions.FirstOrDefault( m => !m.Completed && !m.MissionId.StartsWith( "arena_" ) );
				if ( target == null ) { Log.Warning( "[Quests] dev_quests claim: no in-progress daily" ); break; }
				var def = mm.GetDefinition( target.MissionId );
				target.Progress = def?.Target ?? target.Progress;
				target.Completed = true;
				Log.Info( $"[Quests] dev_quests claim → {target.MissionId} completed" );
				break;
			}

			case "bonus":
				foreach ( var m in mm?.ActiveDailyMissions ?? new() ) { m.Completed = true; m.Claimed = true; }
				Log.Info( "[Quests] dev_quests bonus → all dailies claimed (CLAIM BONUS lights)" );
				break;

			case "streak":
				drm?.DevResetToday();
				Log.Info( "[Quests] dev_quests streak → today's login reward un-claimed" );
				break;

			case "side":
			{
				if ( sq == null ) break;
				sq.DevForceAvailable = true;
				// First active quest that still HAS a definition; if none, accept the
				// first available definition so a CLAIM row exists to shoot.
				var first = sq.ActiveQuests.FirstOrDefault( q => !q.Completed && sq.GetDefinition( q.Id ) != null );
				if ( first == null )
				{
					var avail = sq.AllDefinitions.FirstOrDefault( d => sq.IsAvailable( d.Id ) );
					if ( avail != null && sq.Accept( avail.Id ) ) first = sq.GetState( avail.Id );
				}
				if ( first != null )
				{
					var def = sq.GetDefinition( first.Id );
					first.Progress = def?.Target ?? first.Progress;
					first.Completed = true;
				}
				Log.Info( $"[Quests] dev_quests side → gate bypassed; {(first != null ? first.Id + " completed" : "no quest to complete")}" );
				break;
			}

			case "reset":
				// Re-roll every mission tier (public Generate* verbs — they also clear
				// the bonus flags), un-claim today's login, drop the zone bypass.
				mm?.GenerateDailyMissions();
				mm?.GenerateWeeklyMissions();
				mm?.GenerateMonthlyChallenge();
				drm?.DevResetToday();
				if ( sq != null ) sq.DevForceAvailable = false;
				Log.Info( "[Quests] dev_quests reset → missions re-rolled, login un-claimed" );
				break;

			case "empty":
			{
				foreach ( var m in mm?.ActiveDailyMissions ?? new() ) { m.Completed = true; m.Claimed = true; }
				foreach ( var m in mm?.ActiveWeeklyMissions ?? new() ) { m.Completed = true; m.Claimed = true; }
				if ( mm?.ActiveMonthlyChallenge is { } mc ) { mc.Completed = true; mc.Claimed = true; }
				mm?.ClaimDailyBonus();
				mm?.ClaimWeeklyBonus();
				drm?.DevMarkTodayClaimed();
				if ( sq != null )
				{
					sq.DevForceAvailable = false;
					foreach ( var q in sq.ActiveQuests.ToList() ) { q.Completed = true; sq.Claim( q.Id ); }
				}
				Log.Info( "[Quests] dev_quests empty → everything claimed" );
				break;
			}

			case "":
				break;

			default:
				Log.Warning( "[Quests] dev_quests: (none) | claim | bonus | streak | side | empty | reset | off" );
				return;
		}

		PhoneLauncher.Close();
		if ( !IsVisible ) Show();
		else CaptureOrder();
		Log.Info( $"[Quests] dev_quests → '{arg}' (unclaimed badge = {GetTotalUnclaimedCount()})" );
	}
}
