	private void ClaimGuildGoal( string id )
	{
		SoundManager.PlaySuccess();
		GuildManager.Instance?.ClaimWeeklyGoal( id );
	}

	private string GetGuildGoalsTimer()
	{
		var gm = GuildManager.Instance;
		if ( gm == null ) return "—";
		var ts = gm.WeeklyGoalsResetAt - DateTime.UtcNow;
		if ( ts.TotalSeconds <= 0 ) return "soon";
		return FormatDuration( ts );
	}

	private static string GetGuildGoalIcon( GuildGoalType type ) => type switch
	{
		GuildGoalType.WildBeastsKO => "lucide:swords",
		GuildGoalType.BeastsContracted => "lucide:scroll",
		GuildGoalType.GoldEarned => "lucide:coins",
		GuildGoalType.ExpeditionsCleared => "lucide:compass",
		GuildGoalType.BossesDefeated => "lucide:skull",
		GuildGoalType.FusionsCompleted => "lucide:atom",
		_ => "lucide:shield"
	};

	private static string GetGuildGoalColor( GuildGoalType type ) => type switch
	{
		GuildGoalType.WildBeastsKO => "#fca5a5",
		GuildGoalType.BeastsContracted => "#7dd3fc",
		GuildGoalType.GoldEarned => "#fde047",
		GuildGoalType.ExpeditionsCleared => "#fcd34d",
		GuildGoalType.BossesDefeated => "#f0abfc",
		GuildGoalType.FusionsCompleted => "#a78bfa",
		_ => "#c4b5fd"
	};

