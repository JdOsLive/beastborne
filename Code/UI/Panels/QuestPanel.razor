	private RenderFragment MissionCard( MissionState m, int idx, bool large = false ) => __builder =>
	{
		var def = MissionManager.Instance?.GetDefinition( m.MissionId );
		var claimable = m.Completed && !m.Claimed;
		var missionCardClass = GetCategoryClass(m)
			+ (m.Claimed ? " claimed" : "")
			+ (claimable ? " completed" : "")
			+ (large ? " wide" : "")
			+ " " + GetSlipRot( idx, m.Claimed || claimable );
		var pinClass = m.Claimed ? "done" : claimable ? "gold" : "";

		<div class="slip @missionCardClass" onmouseover=@(() => OnHover("mission-" + m.MissionId))>
			<div class="pin @pinClass"></div>

			<div class="slip-head">
				<div class="mission-icon-wrap">
					<iconify icon="@GetMissionIconify(m)" Size=@(large ? 30 : 22) Color="@(GetCategoryIconColor(m))" />
				</div>
				<div class="mission-name-row">
					<span class="mission-name">@GetMissionName( m )</span>
					<span class="mission-cat-chip">@(GetCategoryLabel(m))</span>
				</div>
			</div>

			<div class="slip-descrow"><span class="mission-desc">@GetMissionDesc( m )</span></div>

			<div class="slip-barrow">
				<div class="mission-progress-bar">
					<div class="mission-progress-fill" style="width: @(GetMissionFillPx(m, large))px"></div>
				</div>
			</div>

			<div class="slip-foot">
				@if ( m.Claimed )
				{
					<BbStamp Text="DONE" Tone="green" Tilt=@(-3) Class="q-done" />
				}
				else if ( m.Completed )
				{
					<button class="claim-btn" onclick=@(() => ClaimMission(m.MissionId)) onmouseover=@(() => OnHover("claim-mission-" + m.MissionId))>
						<span>CLAIM</span>
					</button>
				}
				else
				{
					<span class="mission-target">@m.Progress / @GetMissionTarget( m )</span>
				}
			</div>

			<div class="slip-tags">
				@if ( def?.GoldReward > 0 )
				{
					<div class="q-reward gold">
						<div class="q-gem"><div class="q-gem-in"><img class="q-gem-img" src="ui/icons/currency/money.svg" /></div></div>
						<span class="q-amt">@($"{def.GoldReward / 1000f:0.#}K")</span>
					</div>
				}
				@if ( def?.GemReward > 0 )
				{
					<div class="q-reward tokens">
						<div class="q-gem"><div class="q-gem-in"><img class="q-gem-img" src="ui/icons/currency/token.svg" /></div></div>
						<span class="q-amt">@def.GemReward</span>
					</div>
				}
				@if ( def?.InkReward > 0 )
				{
					<div class="q-reward ink">
						<div class="q-gem"><div class="q-gem-in"><img class="q-gem-img" src="ui/icons/currency/ink.svg" /></div></div>
						<span class="q-amt">@def.InkReward</span>
					</div>
				}
				@if ( def?.XPReward > 0 )
				{
					<div class="q-reward xp">
						<div class="q-gem"><div class="q-gem-in"><iconify icon="lucide:arrow-up" Size=@(11) Color="#ffffff" /></div></div>
						<span class="q-amt">@($"{def.XPReward:N0}")</span>
					</div>
				}
			</div>
			<div class="q-ring"></div>
		</div>
	};
}
