@namespace Beastborne.UI.Panels
@using Sandbox;
@using Sandbox.UI;
@using Beastborne.Core;
@using Beastborne.Data;
@using Beastborne.Systems;
@using Beastborne.UI;
@using Beastborne.UI.Primitives;
@inherits Panel

@*
	QUESTS — the notice board, efficiency-first.
	One chrome rail (identity + tabs + timer), then the whole screen is a
	two-column board of quest slips. Sort order = claimable first, then
	in-progress, then claimed — the common action (claim) is always the
	first thing under the cursor. Claimable slips sit FLAT and gold-lit;
	in-progress slips rest at a whisper tilt (board identity); claimed
	slips settle flat, dim, and wear a green DONE stamp. The daily streak
	is its own pinned calendar card at the top of the Daily board.

	Engine notes (learned laws honored here):
	- Tilted slip = 2D transform ancestor, so DERIVED widths inside are
	  untrustworthy: every text/bar row inside a slip is a ROW-flex wrapper
	  whose child carries an EXPLICIT px width; progress fill widths are
	  computed in C# as px (never % under a transform).
	- Board rows chunk slips in pairs in code — flex-wrap miscalculates
	  height in s&box.
	- Hover never transforms (slips live in a scroll container) — hover =
	  brighten + the violet ring (inset absolute child).
	- Gem tags hang off the slip's bottom edge via a negative bottom
	  margin (engine-proven negative-margin overlay pattern).
*@

<root class="quest-panel-root @_rootVisibleClass">
	<div class="quest-page">

		<!-- Living background: the quests glyph drifting at the house
		     angle. Mounted INSIDE quest-page (not the root) because
		     quest-page is the absolute full-size surface that painted the
		     fill — a root-level mount would sit under it. -->
		<BbIconScroll Icon="quests" />

		<!-- THE RAIL — identity, tabs, timer, close: one chrome band -->
		<div class="qp-header">
			<div class="qp-head-left">
				<BbSectionHeader Kicker="@GetTabKicker()" Title="Quests" Size=@(52) AccentColor="#3fb45e" />
			</div>
			<div class="peg-tabs">
				@foreach ( var tab in Tabs )
				{
					var badge = GetBadgeCount( tab.Id );
					var isActive = _currentTab == tab.Id;
					var tabIconColor = isActive ? "#ffffff" : "#6fd08c";
					var tabActiveClass = isActive ? "active" : "";
					<div class="qtab @tabActiveClass"
						 onclick=@(() => SelectTab(tab.Id))
						 onmouseover=@(() => OnHover("tab-" + tab.Id))>
						<div class="qtab-inner">
							<iconify class="qtab-icon" icon="@tab.Icon" Size=@(16) Color="@tabIconColor" />
							<span class="qtab-label">@tab.Name</span>
							@if ( badge > 0 )
							{
								<div class="qtab-badge">@badge</div>
							}
						</div>
					</div>
				}
			</div>
			<div class="qp-head-right">
				@if ( GetActiveTimerLabel() != null )
				{
					<span class="peg-meta-lbl">RESETS IN</span>
					<span class="timer-pill">@GetActiveTimerLabel()</span>
				}
				@if ( GetTotalUnclaimedCount() > 0 )
				{
					<BbStamp Text="@ReadyStampText" Tone="gold" Tilt=@(3) Class="qp-ready-stamp" />
				}
				<button class="close-btn" onclick=@Close>
					<iconify icon="lucide:x" Size=@(15) Color="rgba(255, 255, 255, 0.85)" />
				</button>
			</div>
		</div>

		<!-- angled seam under the rail -->
		<div class="qp-seam">
			<div class="qp-seam-a"></div>
			<div class="qp-seam-b"></div>
		</div>

		<!-- THE BOARD — scrolling field of pinned slips -->
		<div class="board" @ref="ContentInner">
			@switch ( _currentTab )
			{
				case "main":
					@RenderMain()
					break;
				case "side":
					@RenderSide()
					break;
				case "daily":
					@RenderDaily()
					break;
				case "weekly":
					@RenderWeekly()
					break;
				case "monthly":
					@RenderMonthly()
					break;
				case "guild":
					@RenderGuild()
					break;
			}
		</div>
	</div>
</root>

@code {
	private string L( string key ) => LocalizationManager.Get( key );

	public static QuestPanel Instance { get; private set; }
	public static bool IsVisible { get; private set; }

	// Pre-computed class names used in attribute values — s&box Razor chokes on
	// nested double-quotes like class="@(IsVisible ? "visible" : "")".
	private string _rootVisibleClass => IsVisible ? "visible" : "";

	// Header stamp copy — computed in C# (never interpolate in attributes).
	private string ReadyStampText => GetTotalUnclaimedCount() + " READY";

	// Hover-sound state guard. s&box has no onmouseenter, so onmouseover bubbles
	// from every child mousemove — naive PlayHover() fires repeatedly. Track the
	// last-hovered key and only play the sound when it actually changes.
	private string _hoveredKey;
	private void OnHover( string key )
	{
		if ( _hoveredKey == key ) return;
		_hoveredKey = key;
		SoundManager.PlayHover();
	}

	private string _currentTab = "daily";
	private Panel ContentInner;

	private record QuestTab( string Id, string Icon, string Name, string Sub );

	private static readonly QuestTab[] Tabs = new[]
	{
		new QuestTab("main",    "lucide:book-open-text", "Main",    "Story chapters"),
		new QuestTab("side",    "lucide:map-pin",        "Side",    "Optional tales"),
		new QuestTab("daily",   "lucide:sun",            "Daily",   "Resets in 24h"),
		new QuestTab("weekly",  "lucide:calendar-days",  "Weekly",  "Resets Monday"),
		new QuestTab("monthly", "lucide:trophy",         "Monthly", "Big challenge"),
		new QuestTab("guild",   "lucide:shield",         "Guild",   "Community goals"),
	};

	// Board-slip geometry constants — content-box inner widths used for the
	// explicit-px rows inside rotated slips (see doc comment up top).
	private const int SlipBarW = 802;   // standard slip inner width (850 - 2*24 padding)
	private const int WideBarW = 1052;  // monthly hero slip inner width (1100 - 2*24)

	private string GetTabKicker() => _currentTab switch
	{
		"main" => "THE TAMER'S ROAD",
		"side" => "BOUNTY BOARD",
		"daily" => "FIELD JOURNAL",
		"weekly" => "STANDING CONTRACTS",
		"monthly" => "THE BIG GAME",
		"guild" => "COMMUNITY LEDGER",
		_ => "FIELD JOURNAL",
	};

	private string GetActiveTimerLabel() => _currentTab switch
	{
		"daily" => GetDailyTimer(),
		"weekly" => GetWeeklyTimer(),
		"monthly" => GetMonthlyTimer(),
		"guild" => (GuildManager.Instance?.IsInGuild ?? false) ? GetGuildGoalsTimer() : null,
		_ => null,
	};

	// Rest rotation for a slip — in-progress slips alternate a whisper tilt
	// (the board identity); SETTLED slips (claimable or claimed) sit FLAT
	// so the actionable/done states scan instantly. The transform transition
	// on .slip animates the settle when a quest completes or is claimed.
	private string GetSlipRot( int idx, bool settled )
	{
		if ( settled ) return "rot-flat";
		return idx % 2 == 0 ? "rot-a" : "rot-b";
	}

	// Board sort — the common action first: claimable → in-progress → claimed.
	private static int ClaimSortKey( MissionState s )
		=> (s.Completed && !s.Claimed) ? 0 : s.Claimed ? 2 : 1;

	protected override void OnAfterTreeRender( bool firstTime )
	{
		if ( firstTime ) Instance = this;
	}

	public static void Show()
	{
		IsVisible = true;
		if ( Instance != null ) Instance._hoveredKey = null;
		// Lazy-seed guild goals so the Guild tab never opens to "Loading…".
		// Idempotent — no-op if already seeded or not in a guild.
		GuildManager.Instance?.EnsureWeeklyGoalsSeeded();
		SoundManager.PlayPopup();
	}

	public static void Close()
	{
		IsVisible = false;
		if ( Instance != null ) Instance._hoveredKey = null;
		SoundManager.PlayPopdown();
	}

	public static void Toggle()
	{
		IsVisible = !IsVisible;
		if ( Instance != null ) Instance._hoveredKey = null;
		if ( IsVisible ) SoundManager.PlayPopup();
		else SoundManager.PlayPopdown();
	}

	public override void Tick()
	{
		base.Tick();
		// Escape (s&box-reserved) AND the canonical Menu/run "back" keys close.
		if ( IsVisible && UIModalState.IsTopModal( "QuestPanel" )
			&& ( Input.Pressed( "Escape" ) || Input.Pressed( "Menu" ) || Input.Pressed( "run" ) ) )
			Close();

		// Safety net: if the user is sitting on the Guild tab with an empty
		// goals list (panel mounted before guild data loaded, hot-reload edge,
		// stale instance), seed locally so the loader resolves.
		if ( IsVisible && _currentTab == "guild" )
		{
			var gm = GuildManager.Instance;
			if ( gm != null && gm.IsInGuild && gm.WeeklyGoals.Count == 0 )
				gm.EnsureWeeklyGoalsSeeded();
		}
	}

	private void SelectTab( string tabId )
	{
		if ( _currentTab == tabId ) return;
		_currentTab = tabId;
		_hoveredKey = null; // content swaps — reset hover guard
		SoundManager.PlayClick();
		if ( ContentInner != null )
			ContentInner.ScrollOffset = new Vector2( 0, 0 );

		// Tab-specific lazy-load. Guild goals seed locally if the cache is
		// empty so the Guild tab is never blank.
		if ( tabId == "guild" )
			GuildManager.Instance?.EnsureWeeklyGoalsSeeded();
	}

	private int GetBadgeCount( string tabId )
	{
		var m = MissionManager.Instance;
		var gm = GuildManager.Instance;
		return tabId switch
		{
			"daily" => (m?.ActiveDailyMissions.Count( x => x.Completed && !x.Claimed ) ?? 0)
					 + ((DailyRewardManager.Instance != null && !DailyRewardManager.Instance.TodayRewardClaimed) ? 1 : 0),
			"weekly" => m?.ActiveWeeklyMissions.Count( x => x.Completed && !x.Claimed ) ?? 0,
			"monthly" => (m?.ActiveMonthlyChallenge is { Completed: true, Claimed: false }) ? 1 : 0,
			"side" => SideQuestManager.Instance?.ActiveQuests?.Count( q => q.Completed && !q.RewardClaimed ) ?? 0,
			"guild" => (gm?.IsInGuild ?? false)
				? gm.WeeklyGoals.Count( g => g.Completed && !g.Claimed )
				: 0,
			_ => 0,
		};
	}

	/// <summary>Total unclaimed across streak + missions, used by GameHUD button badge.</summary>
	public static int GetTotalUnclaimedCount()
	{
		int count = 0;
		count += DailyRewardManager.Instance?.GetUnclaimedCount() ?? 0;
		count += MissionManager.Instance?.GetUnclaimedCount() ?? 0;
		return count;
	}

	protected override int BuildHash()
	{
		var h = new HashCode();
		h.Add( IsVisible );
		h.Add( _currentTab );
		h.Add( GetBadgeCount( "daily" ) );
		h.Add( GetBadgeCount( "weekly" ) );
		h.Add( GetBadgeCount( "monthly" ) );
		h.Add( GetBadgeCount( "side" ) );
		h.Add( GetTotalUnclaimedCount() );
		h.Add( GetActiveTimerLabel() );
		h.Add( MissionManager.Instance?.GetUnclaimedCount() ?? 0 );
		h.Add( MissionManager.Instance?.DailyBonusClaimed ?? false );
		h.Add( MissionManager.Instance?.WeeklyBonusClaimed ?? false );
		h.Add( DailyRewardManager.Instance?.TodayRewardClaimed ?? false );
		h.Add( DailyRewardManager.Instance?.DailyStreak ?? 0 );
		h.Add( DailyRewardManager.Instance?.GetWeekMultiplier() ?? 1f );

		// Include mission progress so bar refreshes when we track events.
		foreach ( var mn in MissionManager.Instance?.ActiveDailyMissions ?? new() )
			h.Add( mn.Progress + (mn.Claimed ? 1_000_000 : 0) );
		foreach ( var mn in MissionManager.Instance?.ActiveWeeklyMissions ?? new() )
			h.Add( mn.Progress + (mn.Claimed ? 1_000_000 : 0) );
		if ( MissionManager.Instance?.ActiveMonthlyChallenge is { } mc )
			h.Add( mc.Progress + (mc.Claimed ? 1_000_000 : 0) );

		// Side quest state — re-render on accept/progress/claim.
		foreach ( var sq in SideQuestManager.Instance?.ActiveQuests ?? new List<SideQuestState>() )
			h.Add( sq.Progress + (sq.Completed ? 1_000_000 : 0) + (sq.RewardClaimed ? 2_000_000 : 0) );

		// Guild weekly goals — refresh card progress when any member contributes.
		var gm = GuildManager.Instance;
		h.Add( gm?.IsInGuild ?? false );
		foreach ( var g in gm?.WeeklyGoals ?? new List<GuildWeeklyGoal>() )
			h.Add( g.Progress + (g.Claimed ? 1_000_000 : 0) );

		return h.ToHashCode();
	}

	// ══════════════════════════════════════════════
	// MISSION HELPERS
	// ══════════════════════════════════════════════

	private List<MissionState> GetDailyMissions() => MissionManager.Instance?.ActiveDailyMissions ?? new();
	private List<MissionState> GetWeeklyMissions() => MissionManager.Instance?.ActiveWeeklyMissions ?? new();
	private MissionState GetMonthlyMission() => MissionManager.Instance?.ActiveMonthlyChallenge;

	private string GetMissionName( MissionState s ) => MissionManager.Instance?.GetDefinition( s.MissionId )?.Name ?? s.MissionId;
	private string GetMissionDesc( MissionState s ) => MissionManager.Instance?.GetDefinition( s.MissionId )?.Description ?? "";
	private int GetMissionTarget( MissionState s ) => MissionManager.Instance?.GetDefinition( s.MissionId )?.Target ?? 1;
	private float GetMissionPercent( MissionState s )
	{
		var t = GetMissionTarget( s );
		if ( t <= 0 ) return 100f;
		return Math.Min( 100f, (float)s.Progress / t * 100f );
	}

	// Progress fill width in PX — computed in code because %-derived widths
	// are untrustworthy inside a rotated (transformed) slip.
	private int GetMissionFillPx( MissionState s, bool large = false )
		=> (int)(GetMissionPercent( s ) / 100f * (large ? WideBarW : SlipBarW));
	private int GetPctFillPx( float pct )
		=> (int)(Math.Min( 100f, Math.Max( 0f, pct ) ) / 100f * SlipBarW);

	private string GetMissionIconify( MissionState s )
	{
		var def = MissionManager.Instance?.GetDefinition( s.MissionId );
		if ( def == null ) return "lucide:star";
		return def.Category switch
		{
			MissionCategory.Battle => "lucide:swords",
			MissionCategory.Expedition => "lucide:compass",
			MissionCategory.Collection => "lucide:package",
			MissionCategory.Economy => "lucide:coins",
			MissionCategory.Social => "lucide:users",
			_ => "lucide:star",
		};
	}

	private string GetCategoryClass( MissionState s )
	{
		var def = MissionManager.Instance?.GetDefinition( s.MissionId );
		if ( def == null ) return "cat-other";
		return def.Category switch
		{
			MissionCategory.Battle => "cat-battle",
			MissionCategory.Expedition => "cat-expedition",
			MissionCategory.Collection => "cat-collection",
			MissionCategory.Economy => "cat-economy",
			MissionCategory.Social => "cat-social",
			_ => "cat-other",
		};
	}

	private string GetCategoryIconColor( MissionState s )
	{
		var def = MissionManager.Instance?.GetDefinition( s.MissionId );
		if ( def == null ) return "#c4b5fd";
		return def.Category switch
		{
			MissionCategory.Battle => "#fca5a5",
			MissionCategory.Expedition => "#fcd34d",
			MissionCategory.Collection => "#7dd3fc",
			MissionCategory.Economy => "#fde047",
			MissionCategory.Social => "#f0abfc",
			_ => "#c4b5fd",
		};
	}

	private string GetCategoryLabel( MissionState s )
	{
		var def = MissionManager.Instance?.GetDefinition( s.MissionId );
		if ( def == null ) return "";
		return def.Category switch
		{
			MissionCategory.Battle => "BATTLE",
			MissionCategory.Expedition => "EXPEDITION",
			MissionCategory.Collection => "COLLECTION",
			MissionCategory.Economy => "ECONOMY",
			MissionCategory.Social => "SOCIAL",
			_ => "",
		};
	}
	private void ClaimMission( string id )
	{
		SoundManager.PlaySuccess();
		MissionManager.Instance?.ClaimReward( id );
	}
	private string GetDailyTimer() => FormatDuration( MissionManager.Instance?.GetDailyTimeRemaining() ?? TimeSpan.Zero );
	private string GetWeeklyTimer() => FormatDuration( MissionManager.Instance?.GetWeeklyTimeRemaining() ?? TimeSpan.Zero );
	private string GetMonthlyTimer() => FormatDuration( MissionManager.Instance?.GetMonthlyTimeRemaining() ?? TimeSpan.Zero );

	private static string FormatDuration( TimeSpan ts )
	{
		if ( ts.TotalDays >= 1 ) return $"{(int)ts.TotalDays}d {ts.Hours:D2}h";
		if ( ts.TotalHours >= 1 ) return $"{(int)ts.TotalHours}h {ts.Minutes:D2}m";
		return $"{ts.Minutes}m";
	}

	// ══════════════════════════════════════════════
	// TAB RENDERERS
	// ══════════════════════════════════════════════

	private RenderFragment RenderMain() => __builder =>
	{
		<div class="tab-content">
			<div class="board-row single">
				<div class="slip empty-note rot-a">
					<div class="pin"></div>
					<div class="empty-illus">
						<iconify icon="lucide:book-open-text" Size=@(64) Color="#2e7d46" />
					</div>
					<div class="note-row"><span class="empty-title">Chapter 1 — Coming Soon</span></div>
					<div class="note-row"><span class="empty-body">The main storyline arrives after launch. For now, explore the three expeditions, complete side quests, and build a team worthy of what lies ahead.</span></div>
				</div>
			</div>
		</div>
	};

	private RenderFragment RenderSide() => __builder =>
	{
		var mgr = SideQuestManager.Instance;
		var allDefs = mgr?.AllDefinitions ?? new List<SideQuest>();
		var active = (mgr?.ActiveQuests?.ToList() ?? new List<SideQuestState>())
			.OrderBy( s => s.Completed ? 0 : 1 ).ToList();
		var available = allDefs.Where( d => mgr != null && mgr.IsAvailable( d.Id ) ).ToList();
		var completed = allDefs.Where( d => mgr != null && mgr.IsCompletedOneShot( d.Id ) ).ToList();

		<div class="tab-content">
			@if ( active.Count == 0 && available.Count == 0 && completed.Count == 0 )
			{
				<div class="board-row single">
					<div class="slip empty-note rot-b">
						<div class="pin"></div>
						<div class="empty-illus">
							<iconify icon="lucide:map-pin" Size=@(64) Color="#2e7d46" />
						</div>
						<div class="note-row"><span class="empty-title">No side quests yet</span></div>
						<div class="note-row"><span class="empty-body">Visit the world map and accept requests posted by the locals.</span></div>
					</div>
				</div>
			}

			@if ( active.Count > 0 )
			{
				<div class="section-label-row">
					<div class="section-label-left">
						<div class="section-chip"><span>IN PROGRESS</span></div>
					</div>
					<span class="section-count">@active.Count active</span>
				</div>
				<div class="rowset">
					@for ( int i = 0; i < active.Count; i += 2 )
					{
						var i0 = i;
						var i1 = i + 1;
						<div class="board-row">
							@SideQuestCard( active[i0], i0 )
							@if ( i1 < active.Count )
							{
								@SideQuestCard( active[i1], i1 )
							}
						</div>
					}
				</div>
			}

			@if ( available.Count > 0 )
			{
				<div class="section-label-row">
					<div class="section-label-left">
						<div class="section-chip"><span>AVAILABLE</span></div>
					</div>
					<span class="section-count">@available.Count open</span>
				</div>
				<div class="rowset">
					@for ( int i = 0; i < available.Count; i += 2 )
					{
						var i0 = i;
						var i1 = i + 1;
						<div class="board-row">
							@AvailableSideQuestCard( available[i0], i0 + 1 )
							@if ( i1 < available.Count )
							{
								@AvailableSideQuestCard( available[i1], i1 + 1 )
							}
						</div>
					}
				</div>
			}

			@if ( completed.Count > 0 )
			{
				<div class="section-label-row">
					<div class="section-label-left">
						<div class="section-chip"><span>COMPLETED</span></div>
					</div>
					<span class="section-count">@completed.Count done</span>
				</div>
				<div class="rowset">
					@for ( int i = 0; i < completed.Count; i += 2 )
					{
						var i0 = i;
						var i1 = i + 1;
						<div class="board-row">
							@CompletedSideQuestCard( completed[i0] )
							@if ( i1 < completed.Count )
							{
								@CompletedSideQuestCard( completed[i1] )
							}
						</div>
					}
				</div>
			}
		</div>
	};

	private RenderFragment SideQuestCard( SideQuestState state, int idx ) => __builder =>
	{
		var def = SideQuestManager.Instance?.GetDefinition( state.Id );
		if ( def == null ) return;

		var pct = def.Target > 0 ? (state.Progress * 100f / def.Target) : 0f;
		var claimable = state.Completed;
		var cardClass = (claimable ? "completed" : "") + " " + GetSlipRot( idx, claimable );
		var pinClass = claimable ? "gold" : "";

		<div class="slip @cardClass" onmouseover=@(() => OnHover("sq-" + state.Id))>
			<div class="pin @pinClass"></div>
			<div class="slip-head">
				<div class="mission-icon-wrap">
					<iconify icon="lucide:scroll-text" Size=@(22) Color="#7fd99a" />
				</div>
				<div class="mission-name-row">
					<span class="mission-name">@def.Title</span>
					@if ( !string.IsNullOrEmpty( def.NpcName ) )
					{
						<span class="mission-cat-chip">@def.NpcName</span>
					}
				</div>
			</div>
			<div class="slip-descrow"><span class="mission-desc">@def.Description</span></div>
			<div class="slip-barrow">
				<div class="mission-progress-bar">
					<div class="mission-progress-fill" style="width: @(GetPctFillPx(pct))px"></div>
				</div>
			</div>
			<div class="slip-foot">
				@if ( claimable )
				{
					<button class="claim-btn" onclick=@(() => ClaimSideQuest(state.Id)) onmouseover=@(() => OnHover("claim-sq-" + state.Id))>
						<span>CLAIM</span>
					</button>
				}
				else
				{
					<span class="mission-target">@state.Progress / @def.Target</span>
				}
			</div>
			<div class="slip-tags">
				@SideQuestRewardTags( def )
			</div>
			<div class="q-ring"></div>
		</div>
	};

	private RenderFragment AvailableSideQuestCard( SideQuest def, int idx ) => __builder =>
	{
		var rotClass = GetSlipRot( idx, false );
		<div class="slip @rotClass" onmouseover=@(() => OnHover("sq-avail-" + def.Id))>
			<div class="pin"></div>
			<div class="slip-head">
				<div class="mission-icon-wrap">
					<iconify icon="lucide:map-pin" Size=@(22) Color="#7fd99a" />
				</div>
				<div class="mission-name-row">
					<span class="mission-name">@def.Title</span>
					@if ( !string.IsNullOrEmpty( def.NpcName ) )
					{
						<span class="mission-cat-chip">@def.NpcName</span>
					}
				</div>
			</div>
			<div class="slip-descrow"><span class="mission-desc">@def.Description</span></div>
			<div class="slip-foot">
				<button class="claim-btn accept-btn" onclick=@(() => AcceptSideQuest(def.Id)) onmouseover=@(() => OnHover("accept-sq-" + def.Id))>
					<span>ACCEPT</span>
				</button>
			</div>
			<div class="slip-tags">
				@SideQuestRewardTags( def )
			</div>
			<div class="q-ring"></div>
		</div>
	};

