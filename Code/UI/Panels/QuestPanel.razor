@namespace Beastborne.UI.Panels
@using Sandbox;
@using Sandbox.UI;
@using Beastborne.Core;
@using Beastborne.Data;
@using Beastborne.Systems;
@using Beastborne.UI;
@using Beastborne.UI.Components;
@using Beastborne.UI.Primitives;
@inherits Panel

@*
	QUESTS — rebuild 2026-09-11 (LAYOUT lane, quests-redesign-brief.html).
	"The player is here to claim what they have earned and see what is left
	to do." Five control kinds only: CLAIM · CLAIM BONUS · ACCEPT · BACK·Q ·
	nothing. No tabs, no calendar, no bonus slabs, no scroll, no hint rows.

	ZONE MAP (1920×1080, PADDING-BOX — declared sizes INCLUDE padding,
	borders add on top):
	  HEADER  y 0-90    .qp-header 88 declared (pad 16/32/12/28) + 2px strip
	  BODY    y 90-1080 .qp-body 990 declared (pad 20/40) → inner 1840×950
	                    columns 912 + 16 + 912
	  LEFT  x 40-952 : LOGIN 240 @ y110 · gap 16 · DAILY 694 @ y366 → 1060
	  RIGHT x 968-1880: WEEKLY 378 @ y110 · 16 · MONTHLY 162 @ y504 · 16 ·
	                    SIDE QUESTS 378 @ y682 → 1060
	  Each slab = .qp-band 36 + .qp-list (pad 16, rows gap 14).
	  Rows 880 wide: ROOMY 114 (daily ×5) / DENSE 94 (weekly ×3 · monthly ×1
	  · side ×3). Lists are sorted at OPEN only — a claimed row settles in
	  place, it never jumps.

	LANE: input (built 2026-09-11) — stops are the pressables only (CLAIM DAY
	n · CLAIM BONUS · CLAIM · ACCEPT) as ACTION STRINGS ("login" · "b:daily" ·
	"d:<id>" · "b:weekly" · "w:<id>" · "m" · "s:<id>" · "a:<id>"), rebuilt every
	Tick from the SAME conditions the markup draws (BuildStops); each pressable
	sits in a .qp-stop wrapper (hover + ring host). ONE imperative ring
	(.qp-ring, last child of .qp-page, z60 above the slabs) · device flag
	kbd-mode/mouse-mode on .qp-page + 3px travel guard (OnPageMouseMove) ·
	W/S prev/next stop (LEFT column top→bottom, then RIGHT) · A/D the other
	column's nearest stop by y · Space/E/Enter press · Q closes (claims
	PanelHandledBackKey) · R/Z/X no job. Open edge seeds stop 0. A pressed
	stop leaves the list; the ring glides to the next, else previous, else
	hides. No scroll region → no scroll-follow.
	LANE: motion — zone rungs qpZone*, row ladder qpRowIn0-7 (WINDOWED
	classes from code, never static), qpClaimBeat / qpClaimInk /
	qpAccentTick (the .row-accent strip is the HDR host) / qpChipIn /
	qpAcceptBeat, exit latch .qp-leaving. Static states only here.
	LANE: color — page accent #3fb45e applied where the brief declares it;
	gold on primaries / claimable numerals / DONE ink; violet = ring only.
*@

<root class="quest-panel-root @_rootVisibleClass">
	<div class="@_pageClass" onmousemove=@OnPageMouseMove>
		<!-- Living background — the quests glyph drifting. First child; the
		     page paints NO fill of its own (opaque pattern tiles). -->
		<BbIconScroll Icon="quests" />

		@if ( IsVisible )
		{
			<!-- HEADER — the hub .oh-header recipe: waves (host paints no
			     fill) · kicker · italic title · polygon seams · BACK·Q in the
			     right slot. Fresh mount under the IsVisible branch. -->
			<div class="qp-header">
				<BbHeaderWaves Accent=@("quests") />
				<div class="qp-identity">
					<span class="qp-kicker">TAMER</span>
					<div class="qp-title-row">
						<span class="qp-title">QUESTS</span>
						<div class="qp-seam"></div>
						<div class="qp-seam dim"></div>
					</div>
				</div>
				<div class="qp-toolbar">
					<div class="qp-back" onmouseover=@OnBackHover onclick=@Close>
						<span class="qp-back-label">BACK</span>
						<span class="qp-back-cap">Q</span>
					</div>
				</div>
			</div>

			<!-- BODY — two pinned columns, no scroll container anywhere. -->
			<div class="qp-body">
				<div class="qp-col">
					@RenderLogin()
					@RenderDaily()
				</div>
				<div class="qp-col">
					@RenderWeekly()
					@RenderMonthly()
					@RenderSide()
				</div>
			</div>
		}
		<!-- THE living ring — one imperative element, last child of .qp-page,
		     z60 above the slabs (their overflow never sees it). Position from
		     UpdateRing each Tick; costumes: default r26 (r16 BbButtons) /
		     .small r21 (the r11 CLAIM BONUS chip). -->
		<div @ref="ringRef" class="qp-ring"></div>
	</div>
</root>

@code {
	public static QuestPanel Instance { get; private set; }
	public static bool IsVisible { get; private set; }

	// Pre-computed class names used in attribute values — s&box Razor chokes on
	// nested double-quotes like class="@(IsVisible ? "visible" : "")".
	private string _rootVisibleClass => IsVisible ? "visible" : "";
	private string _pageClass => "qp-page " + (_kbdMode ? "kbd-mode" : "mouse-mode");

	// ── LANE: input — the one cursor ──
	// _kbStop = the ACTION STRING under the cursor (null = no stop / ring
	// hidden). _stops is rebuilt every Tick from the same conditions the
	// markup draws. Device flag + the parked-pointer travel guard (learnings
	// 2026-09-01: the engine re-sends onmousemove on every re-render).
	private string _kbStop;
	private int _kbStopIdx = -1;
	private List<string> _stops = new();
	private bool _kbdMode;
	private Vector2 _kbTakeoverPos;
	private bool _wasOpen;

	// Ring geometry cache (imperative; only written on change).
	private Panel ringRef;
	private Panel _ringElem; // the element the cache below was written to
	private const int RingInset = 10; // ring radius = host radius + 10 (r26 / r21)
	private int _ringL = int.MinValue, _ringT = int.MinValue, _ringW = -1, _ringH = -1;
	private bool _ringOn;
	private int _ringWarm; // < 2 → .snap (land instantly), then glide

	// LANE: motion — the last press, for the claim / accept beat classes.
	private string _pressedStop;
	private float _pressedAt = -100f;

	private const string Accent = "#3fb45e";
	private const int BarW = 320; // .qp-bar declared width — fills arrive as px

	// ── OPEN-TIME ORDER (brief §4: lists sorted at OPEN only) ──
	// Captured when the page opens; rows render in this order until the next
	// open, so a claim settles a row in place instead of re-sorting the list.
	private static List<string> _dailyOrder = new();
	private static List<string> _weeklyOrder = new();
	private static List<string> _sideOrder = new();
	private static int _orderStamp;

	// Hover-sound guard for the one mouse-only cap (no onmouseenter in s&box).
	private bool _backHovered;
	private void OnBackHover()
	{
		if ( _backHovered ) return;
		_backHovered = true;
		SoundManager.PlayHover();
	}

	// ══════════════════════════════════════════════
	// LIFECYCLE
	// ══════════════════════════════════════════════

	protected override void OnAfterTreeRender( bool firstTime )
	{
		if ( firstTime ) Instance = this;
	}

	public static void Show()
	{
		CaptureOrder();
		IsVisible = true;
		if ( Instance != null ) Instance._backHovered = false;
		SoundManager.PlayPopup();
	}

	public static void Close()
	{
		IsVisible = false;
		if ( Instance != null ) Instance._backHovered = false;
		SoundManager.PlayPopdown();
	}

	public static void Toggle()
	{
		if ( IsVisible ) Close();
		else Show();
	}

	public override void Tick()
	{
		base.Tick();

		// OPEN EDGE (tracked bool, not the keystroke — the page opens by
		// mouse too): rebuild the stops and seed the cursor on stop 0.
		bool open = IsVisible;
		if ( open && !_wasOpen ) OnOpenEdge();
		_wasOpen = open;

		UpdateRing();

		if ( !open || !UIModalState.IsTopModal( "QuestPanel" ) ) return;

		SyncStops();

		// Q = back, always (one stage). Claim it so GameHUD does not also flip
		// into its own Menu handling. Escape (s&box-reserved) and run close too.
		// LANE: motion — the exit latch (.qp-leaving) commits IsVisible=false
		// from Tick after its window instead of this immediate Close().
		if ( Input.Pressed( "Menu" ) )
		{
			GameHUD.PanelHandledBackKey = true;
			Close();
			return;
		}
		if ( Input.Pressed( "Escape" ) || Input.Pressed( "run" ) )
		{
			Close();
			return;
		}

		TickNav();
	}

	// ══════════════════════════════════════════════
	// LANE: input — THE ONE CURSOR
	// ══════════════════════════════════════════════

	private void OnOpenEdge()
	{
		_stops = BuildStops();
		_kbStop = _stops.Count > 0 ? _stops[0] : null;
		_kbStopIdx = _stops.Count > 0 ? 0 : -1;
		_ringWarm = 0;
		_kbTakeoverPos = Mouse.Position;
		StateHasChanged();
	}

	// The stop list = the pressables, in SCREEN order: LEFT column top→bottom
	// (CLAIM DAY n → daily CLAIM BONUS → daily CLAIMs) then RIGHT (weekly
	// CLAIM BONUS → weekly CLAIMs → monthly → side CLAIM / ACCEPT). Every
	// condition here mirrors the @if that draws the button (DOC-5 #12).
	private List<string> BuildStops()
	{
		var stops = new List<string>();
		var mm = MissionManager.Instance;
		var drm = DailyRewardManager.Instance;
		var sq = SideQuestManager.Instance;

		if ( drm != null && !drm.TodayRewardClaimed ) stops.Add( "login" );

		if ( mm != null )
		{
			if ( !mm.DailyBonusClaimed && mm.AreAllDailiesComplete() ) stops.Add( "b:daily" );
			foreach ( var m in Ordered( mm.ActiveDailyMissions ?? new(), x => x.MissionId, _dailyOrder ) )
				if ( IsClaimable( m ) ) stops.Add( "d:" + m.MissionId );

			if ( !mm.WeeklyBonusClaimed && mm.AreAllWeekliesComplete() ) stops.Add( "b:weekly" );
			foreach ( var m in Ordered( mm.ActiveWeeklyMissions ?? new(), x => x.MissionId, _weeklyOrder ) )
				if ( IsClaimable( m ) ) stops.Add( "w:" + m.MissionId );

			if ( mm.ActiveMonthlyChallenge is { } mc && IsClaimable( mc ) ) stops.Add( "m" );
		}

		if ( sq != null )
		{
			foreach ( var def in Ordered( sq.AllDefinitions ?? new List<SideQuest>(), d => d.Id, _sideOrder ) )
			{
				var state = sq.GetState( def.Id );
				var doneOneShot = sq.IsCompletedOneShot( def.Id );
				if ( state != null && state.Completed && !state.RewardClaimed ) stops.Add( "s:" + def.Id );
				else if ( state == null && !doneOneShot && sq.IsAvailable( def.Id ) ) stops.Add( "a:" + def.Id );
			}
		}
		return stops;
	}

	private static bool IsClaimable( MissionState m )
	{
		var def = MissionManager.Instance?.GetDefinition( m.MissionId );
		return def != null && m.Completed && !m.Claimed && !IsDormant( def );
	}

	// Rebuild each Tick; if the cursor's stop left the list (a claim landed),
	// glide to the stop now at the same index (= next), else the previous,
	// else hide. A stop appearing later (a mission completes while open) is
	// reachable by W/S — the cursor never teleports onto it.
	private void SyncStops()
	{
		_stops = BuildStops();
		if ( _kbStop == null ) { _kbStopIdx = -1; return; }
		int idx = _stops.IndexOf( _kbStop );
		if ( idx >= 0 ) { _kbStopIdx = idx; return; }
		int n = Math.Min( _kbStopIdx, _stops.Count - 1 );
		_kbStop = n >= 0 ? _stops[n] : null;
		_kbStopIdx = n;
		StateHasChanged();
	}

	// 0 = LEFT column (login · daily) · 1 = RIGHT (weekly · monthly · side)
	private static int ColumnOf( string key )
		=> key == "login" || key == "b:daily" || key.StartsWith( "d:" ) ? 0 : 1;

	// Class-safe form of the action string — the wrapper carries qs-<key> so
	// UpdateRing can find the live host by class.
	private static string StopClass( string key )
		=> "qp-stop qs-" + key.Replace( ':', '-' ) + (key == "login" ? " col" : "");

	private void TickNav()
	{
		bool up = Input.Pressed( "Up" ), down = Input.Pressed( "Down" );
		bool left = Input.Pressed( "Left" ), right = Input.Pressed( "Right" );
		bool confirm = UiInput.ConfirmPressed();
		if ( !(up || down || left || right || confirm) ) return;

		StampKb();
		if ( _stops.Count == 0 ) return; // EMPTY GRAPH — silent

		int idx = _kbStop == null ? -1 : _stops.IndexOf( _kbStop );

		if ( confirm )
		{
			if ( idx >= 0 ) PressStop( _kbStop );
			return;
		}

		if ( up || down )
		{
			int n = idx < 0 ? 0 : Math.Clamp( idx + (down ? 1 : -1), 0, _stops.Count - 1 );
			MoveTo( _stops[n] );
			return;
		}

		// A/D — the other column's nearest stop by y; silent when there is
		// none or the cursor already sits in that column.
		int col = right ? 1 : 0;
		if ( idx >= 0 && ColumnOf( _kbStop ) == col ) return;
		var target = NearestInColumn( col );
		if ( target != null ) MoveTo( target );
	}

	private string NearestInColumn( int col )
	{
		float cy = 0f;
		var cur = _kbStop != null ? ResolveStopHost( _kbStop ) : null;
		if ( cur != null ) cy = cur.Box.Rect.Center.y;

		string best = null;
		float bestD = float.MaxValue;
		foreach ( var s in _stops )
		{
			if ( ColumnOf( s ) != col ) continue;
			var h = ResolveStopHost( s );
			float d = h != null ? MathF.Abs( h.Box.Rect.Center.y - cy ) : float.MaxValue - 1f;
			if ( d < bestD ) { bestD = d; best = s; }
		}
		return best;
	}

	private void MoveTo( string key )
	{
		if ( key == _kbStop ) return;
		_kbStop = key;
		_kbStopIdx = _stops.IndexOf( key );
		SoundManager.PlayHover();
		StateHasChanged();
	}

	// Hover IS selection (mouse mode only — a parked pointer under a kb
	// re-render must never move the cursor).
	private void HoverStop( string key )
	{
		if ( _kbdMode ) return;
		if ( key == _kbStop ) return;
		_kbStop = key;
		_kbStopIdx = _stops.IndexOf( key );
		SoundManager.PlayHover();
		StateHasChanged();
	}

	// Keyboard drove last: stamp the pointer's parked position so mouse
	// mode is reclaimed only by REAL travel.
	private void StampKb()
	{
		_kbTakeoverPos = Mouse.Position;
		if ( _kbdMode ) return;
		_kbdMode = true;
		StateHasChanged();
	}

	private void OnPageMouseMove()
	{
		if ( !_kbdMode ) return;
		if ( (Mouse.Position - _kbTakeoverPos).Length < 3f ) return;
		_kbdMode = false;
		StateHasChanged();
	}

	// The ONE press path — mouse clicks and Space/E/Enter both land here, so
	// LANE: motion has a single hook (_pressedStop / _pressedAt) for the
	// claim / accept beats.
	private void PressStop( string key )
	{
		if ( string.IsNullOrEmpty( key ) ) return;
		_pressedStop = key;
		_pressedAt = RealTime.Now;

		if ( key == "login" ) ClaimStreak();
		else if ( key == "b:daily" ) ClaimDailyBonus();
		else if ( key == "b:weekly" ) ClaimWeeklyBonus();
		else if ( key == "m" )
		{
			var id = MissionManager.Instance?.ActiveMonthlyChallenge?.MissionId;
			if ( id != null ) ClaimMission( id );
		}
		else if ( key.StartsWith( "d:" ) || key.StartsWith( "w:" ) ) ClaimMission( key.Substring( 2 ) );
		else if ( key.StartsWith( "s:" ) ) ClaimSideQuest( key.Substring( 2 ) );
		else if ( key.StartsWith( "a:" ) ) AcceptSideQuest( key.Substring( 2 ) );

		// The stop leaves the list at t0 → the ring glides on this frame.
		SyncStops();
		StateHasChanged();
	}

	// The ring host = the BbButton inside the stop's wrapper (the wrapper
	// hugs it, but the button is the honest rect).
	private Panel ResolveStopHost( string key )
	{
		var wrap = FindDescendantByClass( this, "qs-" + key.Replace( ':', '-' ) );
		if ( wrap == null ) return null;
		return wrap.Children.FirstOrDefault() ?? wrap;
	}

	private static Panel FindDescendantByClass( Panel root, string cls )
	{
		foreach ( var c in root.Children )
		{
			if ( c.HasClass( cls ) ) return c;
			var d = FindDescendantByClass( c, cls );
			if ( d != null ) return d;
		}
		return null;
	}

	// RING CENTERING LAW (learnings 2026-08-29): Style.Left/Top place the
	// PADDING box, so L/T = host − inset + 4 (the ring's border) and W/H =
	// host + 2·inset − 8. Written only on change; the CSS transition glides.
	private void UpdateRing()
	{
		if ( ringRef == null ) return;

		// The geometry cache belongs to ONE element: if the razor diff (or a
		// hotload) hands @ref a fresh panel, the cached l/t/w/h would skip the
		// writes and the new element would sit at its -500 rest (seen live
		// 2026-09-11: ring class .on, Inline {} — invisible).
		if ( !ReferenceEquals( ringRef, _ringElem ) )
		{
			_ringElem = ringRef;
			_ringL = int.MinValue; _ringT = int.MinValue; _ringW = -1; _ringH = -1;
			_ringWarm = 0;
		}

		bool was = _ringOn;
		_ringOn = false;
		bool small = false;

		if ( IsVisible && _kbStop != null )
		{
			var host = ResolveStopHost( _kbStop );
			if ( host != null )
			{
				var rr = Box.Rect;
				var cr = host.Box.Rect;
				if ( rr.Width > 1f && cr.Width > 1f )
				{
					float sc = ScaleFromScreen;
					if ( sc <= 0.01f || float.IsNaN( sc ) || float.IsInfinity( sc ) ) sc = 1f;

					int l = (int)((cr.Left - rr.Left) * sc) - RingInset + 4;
					int t = (int)((cr.Top - rr.Top) * sc) - RingInset + 4;
					int w = (int)(cr.Width * sc) + RingInset * 2 - 8;
					int h = (int)(cr.Height * sc) + RingInset * 2 - 8;

					if ( l != _ringL ) { _ringL = l; ringRef.Style.Left = Length.Pixels( l ); }
					if ( t != _ringT ) { _ringT = t; ringRef.Style.Top = Length.Pixels( t ); }
					if ( w != _ringW ) { _ringW = w; ringRef.Style.Width = Length.Pixels( w ); }
					if ( h != _ringH ) { _ringH = h; ringRef.Style.Height = Length.Pixels( h ); }

					_ringOn = true;
					small = _kbStop.StartsWith( "b:" ); // the r11 CLAIM BONUS chip → r21
					if ( !was ) _ringWarm = 0;
					else if ( _ringWarm < 2 ) _ringWarm++;
				}
			}
		}

		ringRef.SetClass( "on", _ringOn );
		ringRef.SetClass( "snap", _ringWarm < 2 );
		ringRef.SetClass( "small", _ringOn && small );
	}

	// ══════════════════════════════════════════════
	// BADGE (P2 — honest count: today's login + missions incl. both bonuses
	// + claimable side quests; milestones are DailyPanel's, never drawn here)
	// ══════════════════════════════════════════════

	/// <summary>Total unclaimed on THIS page — GameHUD / PawPad badge.</summary>
	public static int GetTotalUnclaimedCount()
	{
		int count = 0;
		if ( DailyRewardManager.Instance != null && !DailyRewardManager.Instance.TodayRewardClaimed ) count++;
		count += MissionManager.Instance?.GetUnclaimedCount() ?? 0;
		count += ClaimableSideCount();
		return count;
	}

	// Only states with a LIVE definition count — a save can carry states for
	// retired quest ids (live 2026-09-11: `cove_twigs`), which never render
	// and can never be claimed (SideQuestManager.Claim returns false on a
	// null def), so they must not light the badge.
	private static int ClaimableSideCount()
	{
		var sq = SideQuestManager.Instance;
		if ( sq == null ) return 0;
		return sq.ActiveQuests.Count( q => q.Completed && !q.RewardClaimed && sq.GetDefinition( q.Id ) != null );
	}

	protected override int BuildHash()
	{
		var h = new HashCode();
		h.Add( IsVisible );
		h.Add( _orderStamp );
		h.Add( GetTotalUnclaimedCount() );
		h.Add( MissionManager.Instance?.DailyBonusClaimed ?? false );
		h.Add( MissionManager.Instance?.WeeklyBonusClaimed ?? false );
		h.Add( MissionManager.Instance?.AreAllDailiesComplete() ?? false );
		h.Add( MissionManager.Instance?.AreAllWeekliesComplete() ?? false );
		h.Add( DailyRewardManager.Instance?.TodayRewardClaimed ?? false );
		h.Add( DailyRewardManager.Instance?.DailyStreak ?? 0 );
		h.Add( DailyRewardManager.Instance?.GetWeekMultiplier() ?? 1f );
		h.Add( SideQuestManager.Instance?.DevForceAvailable ?? false );

		// Reset timers tick once a minute (the darkchips read minutes).
		h.Add( GetDailyTimer() );
		h.Add( GetWeeklyTimer() );
		h.Add( GetMonthlyTimer() );

		foreach ( var mn in MissionManager.Instance?.ActiveDailyMissions ?? new() )
			h.Add( mn.Progress + (mn.Completed ? 500_000 : 0) + (mn.Claimed ? 1_000_000 : 0) );
		foreach ( var mn in MissionManager.Instance?.ActiveWeeklyMissions ?? new() )
			h.Add( mn.Progress + (mn.Completed ? 500_000 : 0) + (mn.Claimed ? 1_000_000 : 0) );
		if ( MissionManager.Instance?.ActiveMonthlyChallenge is { } mc )
			h.Add( mc.Progress + (mc.Completed ? 500_000 : 0) + (mc.Claimed ? 1_000_000 : 0) );

		foreach ( var sq in SideQuestManager.Instance?.ActiveQuests ?? new List<SideQuestState>() )
			h.Add( sq.Id + sq.Progress + (sq.Completed ? 1_000_000 : 0) + (sq.RewardClaimed ? 2_000_000 : 0) );
		foreach ( var def in SideQuestManager.Instance?.AllDefinitions ?? new List<SideQuest>() )
			h.Add( SideQuestManager.Instance.IsAvailable( def.Id ) ? 1 : 0 );

		// LANE: input — the cursor + device (every field that paints).
		h.Add( _kbStop ?? "" );
		h.Add( _kbdMode );
		// LANE: motion — add the beat / tick windows (RealTime.Now < until bools;
		// _pressedStop / _pressedAt are the press hook).
		return h.ToHashCode();
	}

	// ══════════════════════════════════════════════
	// ORDER CAPTURE (open only)
	// ══════════════════════════════════════════════

	private static int ClaimSortKey( MissionState s )
		=> (s.Completed && !s.Claimed) ? 0 : s.Claimed ? 2 : 1;

	// claimable → active → available → locked → done
	private static int SideSortKey( SideQuest def )
	{
		var mgr = SideQuestManager.Instance;
		var st = mgr?.GetState( def.Id );
		if ( st != null && st.Completed && !st.RewardClaimed ) return 0;
		if ( st != null ) return 1;
		if ( mgr?.IsCompletedOneShot( def.Id ) == true ) return 4;
		if ( mgr?.IsAvailable( def.Id ) == true ) return 2;
		return 3;
	}

	private static void CaptureOrder()
	{
		var mm = MissionManager.Instance;
		_dailyOrder = (mm?.ActiveDailyMissions ?? new()).OrderBy( ClaimSortKey ).Select( m => m.MissionId ).ToList();
		_weeklyOrder = (mm?.ActiveWeeklyMissions ?? new()).OrderBy( ClaimSortKey ).Select( m => m.MissionId ).ToList();
		_sideOrder = (SideQuestManager.Instance?.AllDefinitions ?? new List<SideQuest>()).OrderBy( SideSortKey ).Select( d => d.Id ).ToList();
		_orderStamp++;
	}

	private static List<T> Ordered<T>( IEnumerable<T> items, Func<T, string> id, List<string> order )
	{
		var list = items.ToList();
		return list.OrderBy( x => { var i = order.IndexOf( id( x ) ); return i < 0 ? int.MaxValue : i; } ).ToList();
	}

	// ══════════════════════════════════════════════
	// HELPERS
	// ══════════════════════════════════════════════

	private static string GetGlyph( MissionDefinition def ) => def?.Category switch
	{
		MissionCategory.Battle => "lucide:swords",
		MissionCategory.Expedition => "lucide:compass",
		MissionCategory.Collection => "lucide:package",
		MissionCategory.Economy => "lucide:coins",
		MissionCategory.Social => "lucide:users",
		_ => "lucide:star",
	};

	// arena_* rolls while ranked is kill-switched — the row wears .dormant.
	private static bool IsDormant( MissionDefinition def )
		=> def != null && !MissionManager.ArenaMissionsEnabled && def.Id.StartsWith( "arena_" );

	private static int FillPx( int progress, int target )
	{
		if ( target <= 0 ) return BarW;
		var pct = Math.Clamp( (float)progress / target, 0f, 1f );
		return (int)(pct * BarW);
	}

	// n / N — targets ≥ 10,000 read "31.2K / 50K" (the counter lane is 108).
	private static string FormatCounter( int progress, int target )
	{
		if ( target >= 10000 )
			return $"{FormatK( progress )} / {FormatK( target )}";
		return $"{progress:N0} / {target:N0}";
	}

	private static string FormatK( int n )
	{
		if ( n < 1000 ) return n.ToString( "N0" );
		return (n / 1000f).ToString( "0.#" ) + "K";
	}

	private void ClaimMission( string id )
	{
		if ( MissionManager.Instance?.ClaimReward( id ) == true )
			SoundManager.PlaySuccess();
	}
	private void ClaimStreak()
	{
		if ( DailyRewardManager.Instance?.ClaimDailyReward() == true )
			SoundManager.PlaySuccess();
	}
	private void ClaimDailyBonus()
	{
		if ( MissionManager.Instance?.ClaimDailyBonus() == true )
			SoundManager.PlaySuccess();
	}
	private void ClaimWeeklyBonus()
	{
		if ( MissionManager.Instance?.ClaimWeeklyBonus() == true )
			SoundManager.PlaySuccess();
	}
	private void AcceptSideQuest( string id )
	{
		if ( SideQuestManager.Instance?.Accept( id ) == true )
			SoundManager.PlayClick();
	}
	private void ClaimSideQuest( string id )
	{
		if ( SideQuestManager.Instance?.Claim( id ) == true )
			SoundManager.PlaySuccess();
	}

	private string GetDailyTimer() => "RESETS " + FormatDuration( MissionManager.Instance?.GetDailyTimeRemaining() ?? TimeSpan.Zero );
	private string GetWeeklyTimer() => "RESETS " + FormatDuration( MissionManager.Instance?.GetWeeklyTimeRemaining() ?? TimeSpan.Zero );
	private string GetMonthlyTimer() => "RESETS " + FormatDuration( MissionManager.Instance?.GetMonthlyTimeRemaining() ?? TimeSpan.Zero );

	private static string FormatDuration( TimeSpan ts )
	{
		if ( ts.TotalDays >= 1 ) return $"{(int)ts.TotalDays}D {ts.Hours:D2}H";
		if ( ts.TotalHours >= 1 ) return $"{(int)ts.TotalHours}H {ts.Minutes:D2}M";
		return $"{ts.Minutes}M";
	}

	private static string ItemName( string itemId )
		=> ItemManager.Instance?.GetItem( itemId )?.Name ?? itemId;
	private static string ItemIcon( string itemId )
		=> ItemManager.Instance?.GetItem( itemId )?.IconPath ?? "";
	private static string ZoneName( string zoneId )
		=> ExpeditionManager.Instance?.GetExpedition( zoneId )?.Name ?? zoneId;

	// Reward parts — (icon path or "", text). Currencies + XP/SP on line 1,
	// items on line 2. N0 everywhere; the word "gem" never appears.
	private static List<(string Icon, string Text)> MissionCurrencyParts( MissionDefinition def )
	{
		var parts = new List<(string, string)>();
		if ( def.GoldReward > 0 ) parts.Add( ("ui/icons/currency/money.png", def.GoldReward.ToString( "N0" )) );
		if ( def.InkReward > 0 ) parts.Add( ("ui/icons/currency/ink.png", def.InkReward.ToString( "N0" )) );
		if ( def.GemReward > 0 ) parts.Add( ("ui/icons/currency/token.png", def.GemReward.ToString( "N0" )) );
		if ( def.XPReward > 0 ) parts.Add( ("", def.XPReward.ToString( "N0" ) + " XP") );
		return parts;
	}

	private static List<(string Icon, string Text)> SideCurrencyParts( SideQuest def )
	{
		var parts = new List<(string, string)>();
		if ( def.GoldReward > 0 ) parts.Add( ("ui/icons/currency/money.png", def.GoldReward.ToString( "N0" )) );
		if ( def.XPReward > 0 ) parts.Add( ("", def.XPReward.ToString( "N0" ) + " XP") );
		if ( def.SkillPointReward > 0 ) parts.Add( ("", def.SkillPointReward.ToString( "N0" ) + " SP") );
		return parts;
	}

