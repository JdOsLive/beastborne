	// One line of reward parts joined by "·". Every text node is its own span
	// (bare-text law); the img is 16px.
	private RenderFragment RewardLine( List<(string Icon, string Text)> parts ) => __builder =>
	{
		<div class="qp-rwline">
			@for ( int i = 0; i < parts.Count; i++ )
			{
				var p = parts[i];
				if ( i > 0 )
				{
					<span class="qp-rwsep">&middot;</span>
				}
				if ( !string.IsNullOrEmpty( p.Icon ) )
				{
					<img class="qp-rwicon" src="@p.Icon" />
				}
				<span class="qp-rw">@p.Text</span>
			}
		</div>
	};

	// Band darkchip — the Guild .gp-darkchip shape. Tone: "" | gold | green
	private RenderFragment DarkChip( string text, string tone ) => __builder =>
	{
		var cls = "qp-darkchip " + tone;
		<div class="@cls"><span>@text</span></div>
	};

	// Action-slot status chip (DONE gold ink / LOCKED · NOT OPEN YET dim ink).
	private RenderFragment StatusChip( string text, string tone ) => __builder =>
	{
		var cls = "qp-chip " + tone;
		<div class="@cls"><span>@text</span></div>
	};

	// ══════════════════════════════════════════════
	// LOGIN — 912×240: band 36 + body 204 (pad 16 → inner 880×172)
	//   left : hero 76/84 at inner y28 · pips 20 at inner y144
	//   right: reward line 16 at inner y76 · CLAIM DAY n 320×56 at inner y112
	// ══════════════════════════════════════════════

	private RenderFragment RenderLogin() => __builder =>
	{
		var drm = DailyRewardManager.Instance;
		var streak = drm?.DailyStreak ?? 0;
		var claimedNow = drm?.TodayRewardClaimed ?? true;
		// LANE: motion — the CLAIM DAY n button stays mounted (wearing the beat,
		// reading CLAIMED) for the window; the ghost slab mounts at settle. The
		// pips read the REAL flag (today's pip transitions gold → green at t0).
		var beating = IsBeat( "login" );
		var claimed = claimedNow && !beating;
		var day = drm?.GetStreakDay() ?? 1;
		var mult = drm?.GetWeekMultiplier() ?? 1f;
		var (gold, gems, ink) = drm?.GetTodayReward() ?? (0, 0, 0);
		var itemId = drm?.GetDayItemReward( day );

		// A2 — today's full reward: gold ×mult, ink, tokens, the day item, and
		// the day-7 Master Ink grant (DailyRewardManager.GrantDay7MasterInk).
		var parts = new List<(string Icon, string Text)>();
		if ( gold > 0 ) parts.Add( ("ui/icons/currency/money.png", gold.ToString( "N0" )) );
		if ( ink > 0 ) parts.Add( ("ui/icons/currency/ink.png", ink.ToString( "N0" )) );
		if ( gems > 0 ) parts.Add( ("ui/icons/currency/token.png", gems.ToString( "N0" )) );
		if ( !string.IsNullOrEmpty( itemId ) ) parts.Add( (ItemIcon( itemId ), ItemName( itemId ) + " ×1") );
		if ( day == 7 ) parts.Add( (ItemIcon( "boss_master_ink" ), ItemName( "boss_master_ink" ) + " ×1") );

		// The slab's class string stays STATIC (it carries the qpZoneLogin mount
		// rung); claimed / qp-settle ride the body instead.
		var bodyClass = "qp-login-body" + (claimed ? " claimed" : "") + SettleClass( "login" );
		var rwClass = "qp-login-rewards" + (claimed ? "" : " gold");
		var heroText = "DAY " + day;
		var streakText = streak + (streak == 1 ? " DAY" : " DAYS");
		var multText = "×" + mult.ToString( "0.#" ) + " GOLD";
		var claimLabel = beating ? "CLAIMED" : "CLAIM DAY " + day;
		var claimCap = beating ? "" : "SPACE";
		var claimCls = "qp-login-btn" + BeatClass( "login" );
		var accentCls = AccentClass( "login" );

		<div class="qp-slab login">
			<div class="@accentCls"></div>
			<div class="qp-band">
				<div class="qp-chipstamp"><span>LOGIN STREAK</span></div>
				@DarkChip( streakText, "" )
				@if ( mult > 1f )
				{
					@DarkChip( multText, "gold" )
				}
			</div>
			<div class="@bodyClass">
				<div class="qp-login-left">
					<span class="qp-hero">@heroText</span>
					<div class="qp-pips">
						@for ( int d = 1; d <= 7; d++ )
						{
							var pipDone = d < day || (d == day && claimedNow);
							var pipToday = d == day && !claimedNow;
							var pipClass = "qp-pip" + (pipDone ? " done" : pipToday ? " today" : " future");
							<div class="@pipClass"></div>
						}
					</div>
				</div>
				<div class="qp-login-right">
					<div class="@rwClass">
						@RewardLine( parts )
					</div>
					@if ( claimed )
					{
						<div class="qp-login-claimed"><span>CLAIMED</span></div>
					}
					else
					{
						<div class="@StopClass( "login" )" onmouseover=@(() => HoverStop( "login" ))>
							<BbButton Tier="primary" Size=@(56) Label="@claimLabel" KeyCap="@claimCap" Class="@claimCls" HoverSound=@false OnClick=@(() => PressStop( "login" )) />
						</div>
					}
				</div>
			</div>
		</div>
	};

	// ══════════════════════════════════════════════
	// DAILY — 912×694: band (timer · x/5 · bonus tri-state) + 5 ROOMY rows
	//   36 + 16 + 5×114 + 4×14 + 16 = 694
	// ══════════════════════════════════════════════

	private RenderFragment RenderDaily() => __builder =>
	{
		var mm = MissionManager.Instance;
		var dailies = Ordered( mm?.ActiveDailyMissions ?? new(), m => m.MissionId, _dailyOrder );
		var claimedCount = dailies.Count( m => m.Claimed );
		var allDone = mm?.AreAllDailiesComplete() ?? false;
		var bonusClaimedNow = mm?.DailyBonusClaimed ?? false;
		var countText = claimedCount + " / " + dailies.Count;
		var bonusGold = MissionManager.DailyBonusGold.ToString( "N0" );
		var bonusGems = MissionManager.DailyBonusGems.ToString( "N0" );
		var bonusXp = MissionManager.DailyBonusXP.ToString( "N0" ) + " XP";
		// LANE: motion — the CLAIM BONUS chip holds through its beat (CLAIMED),
		// then the BONUS CLAIMED darkchip pops in under the band's qp-settle.
		var bonusBeating = IsBeat( "b:daily" );
		var bonusClaimed = bonusClaimedNow && !bonusBeating;
		var bonusLabel = bonusBeating ? "CLAIMED" : "CLAIM BONUS";
		var bonusCls = "qp-bonus-btn" + BeatClass( "b:daily" );
		var bandClass = "qp-band" + SettleClass( "b:daily" );

		<div class="qp-slab daily">
			<div class="@bandClass">
				<div class="qp-chipstamp"><span>DAILY</span></div>
				@DarkChip( GetDailyTimer(), "" )
				<div class="qp-band-spacer"></div>
				@DarkChip( countText, "" )
				@if ( bonusClaimed )
				{
					@DarkChip( "BONUS CLAIMED", "green" )
				}
				else if ( allDone || bonusBeating )
				{
					<div class="@StopClass( "b:daily" )" onmouseover=@(() => HoverStop( "b:daily" ))>
						<BbButton Tier="primary" Size=@(34) Label="@bonusLabel" Class="@bonusCls" HoverSound=@false OnClick=@(() => PressStop( "b:daily" )) />
					</div>
				}
				else
				{
					<div class="qp-darkchip dim bonus">
						<img class="qp-bonus-icon" src="ui/icons/currency/money.png" />
						<span>@bonusGold</span>
						<span class="qp-sep">&middot;</span>
						<img class="qp-bonus-icon" src="ui/icons/currency/token.png" />
						<span>@bonusGems</span>
						<span class="qp-sep">&middot;</span>
						<span>@bonusXp</span>
						<span class="qp-sep">&middot;</span>
						<span>BONUS</span>
					</div>
				}
			</div>
			<div class="qp-list">
				@if ( dailies.Count == 0 )
				{
					<span class="qp-empty">New missions arrive at the reset.</span>
				}
				@for ( int i = 0; i < dailies.Count; i++ )
				{
					@MissionRow( dailies[i], i, true, "d:" + dailies[i].MissionId )
				}
			</div>
		</div>
	};

	// ══════════════════════════════════════════════
	// WEEKLY — 912×378: band + 3 DENSE rows (36 + 16 + 3×94 + 2×14 + 16)
	// ══════════════════════════════════════════════

	private RenderFragment RenderWeekly() => __builder =>
	{
		var mm = MissionManager.Instance;
		var weeklies = Ordered( mm?.ActiveWeeklyMissions ?? new(), m => m.MissionId, _weeklyOrder );
		var claimedCount = weeklies.Count( m => m.Claimed );
		var allDone = mm?.AreAllWeekliesComplete() ?? false;
		var bonusClaimedNow = mm?.WeeklyBonusClaimed ?? false;
		var countText = claimedCount + " / " + weeklies.Count;
		var bonusGold = MissionManager.WeeklyBonusGold.ToString( "N0" );
		var bonusGems = MissionManager.WeeklyBonusGems.ToString( "N0" );
		// LANE: motion — see RenderDaily.
		var bonusBeating = IsBeat( "b:weekly" );
		var bonusClaimed = bonusClaimedNow && !bonusBeating;
		var bonusLabel = bonusBeating ? "CLAIMED" : "CLAIM BONUS";
		var bonusCls = "qp-bonus-btn" + BeatClass( "b:weekly" );
		var bandClass = "qp-band" + SettleClass( "b:weekly" );

		<div class="qp-slab weekly">
			<div class="@bandClass">
				<div class="qp-chipstamp"><span>WEEKLY</span></div>
				@DarkChip( GetWeeklyTimer(), "" )
				<div class="qp-band-spacer"></div>
				@DarkChip( countText, "" )
				@if ( bonusClaimed )
				{
					@DarkChip( "BONUS CLAIMED", "green" )
				}
				else if ( allDone || bonusBeating )
				{
					<div class="@StopClass( "b:weekly" )" onmouseover=@(() => HoverStop( "b:weekly" ))>
						<BbButton Tier="primary" Size=@(34) Label="@bonusLabel" Class="@bonusCls" HoverSound=@false OnClick=@(() => PressStop( "b:weekly" )) />
					</div>
				}
				else
				{
					<div class="qp-darkchip dim bonus">
						<img class="qp-bonus-icon" src="ui/icons/currency/money.png" />
						<span>@bonusGold</span>
						<span class="qp-sep">&middot;</span>
						<img class="qp-bonus-icon" src="ui/icons/currency/token.png" />
						<span>@bonusGems</span>
						<span class="qp-sep">&middot;</span>
						<span>BONUS</span>
					</div>
				}
			</div>
			<div class="qp-list">
				@if ( weeklies.Count == 0 )
				{
					<span class="qp-empty">New challenges arrive on Monday.</span>
				}
				@for ( int i = 0; i < weeklies.Count; i++ )
				{
					@MissionRow( weeklies[i], i, false, "w:" + weeklies[i].MissionId )
				}
			</div>
		</div>
	};

	// ══════════════════════════════════════════════
	// MONTHLY — 912×162: band + 1 DENSE row (36 + 16 + 94 + 16)
	// ══════════════════════════════════════════════

	private RenderFragment RenderMonthly() => __builder =>
	{
		var monthly = MissionManager.Instance?.ActiveMonthlyChallenge;

		<div class="qp-slab monthly">
			<div class="qp-band">
				<div class="qp-chipstamp"><span>MONTHLY</span></div>
				@DarkChip( GetMonthlyTimer(), "" )
			</div>
			<div class="qp-list">
				@if ( monthly != null )
				{
					@MissionRow( monthly, 0, false, "m" )
				}
				else
				{
					<span class="qp-empty">The next challenge arrives on the 1st.</span>
				}
			</div>
		</div>
	};

	// ══════════════════════════════════════════════
	// SIDE QUESTS — 912×378: band + 3 DENSE rows (always the 3 definitions)
	// ══════════════════════════════════════════════

	private RenderFragment RenderSide() => __builder =>
	{
		var defs = Ordered( SideQuestManager.Instance?.AllDefinitions ?? new List<SideQuest>(), d => d.Id, _sideOrder );

		<div class="qp-slab side">
			<div class="qp-band">
				<div class="qp-chipstamp"><span>SIDE QUESTS</span></div>
			</div>
			<div class="qp-list">
				@for ( int i = 0; i < defs.Count; i++ )
				{
					@SideRow( defs[i], i )
				}
			</div>
		</div>
	};

	// ══════════════════════════════════════════════
	// THE ROW — one recipe, two stops (ROOMY 114 / DENSE 94), 880 wide:
	//   16 · tile 40 · 16 · text 436 · 16 · rewards 204 · 16 · action 120 · 16
	//   text lane: name 17/21 · desc 13/16 (1 line roomy / 2 lines dense)
	//              · bar 320×8 + 8 + counter 108 = 436
	// ══════════════════════════════════════════════

	private RenderFragment MissionRow( MissionState m, int idx, bool roomy, string stopKey ) => __builder =>
	{
		var def = MissionManager.Instance?.GetDefinition( m.MissionId );
		if ( def == null ) return;

		var dormant = IsDormant( def );
		// LANE: motion — the claimable costume (gold numerals, CLAIM mounted)
		// holds through the beat window; .done lands at settle so the row's
		// bg/opacity + reward ink TRANSITION there. Rung / tick / settle are
		// windowed fragments (a class change is a remount — rows a beat
		// touched carry no rung).
		var beating = IsBeat( stopKey );
		var done = m.Claimed && !beating;
		var claimable = (m.Completed && !m.Claimed && !dormant) || beating;
		var rowClass = "qp-row " + (roomy ? "roomy" : "dense")
			+ (idx % 2 == 1 ? " alt" : "")
			+ (claimable ? " claimable" : "")
			+ (done ? " done" : "")
			+ (dormant ? " dormant" : "")
			+ RowLadderClass( idx, stopKey )
			+ SettleClass( stopKey );
		var desc = dormant ? "Ranked battles are not open yet." : def.Description;
		var fillStyle = "width: " + FillPx( m.Progress, def.Target ) + "px;";
		var counter = FormatCounter( m.Progress, def.Target );
		var missionId = m.MissionId;
		var accentCls = AccentClass( stopKey );
		var claimLabel = beating ? "CLAIMED" : "CLAIM";
		var claimCls = "qp-claim" + BeatClass( stopKey );

		<div class="@rowClass">
			<div class="@accentCls"></div>
			<div class="qp-tile">
				<iconify class="qp-glyph" icon="@GetGlyph( def )" Size=@(22) Color="@Accent" />
			</div>
			<div class="qp-text">
				<div class="qp-nameline">
					<span class="qp-name">@def.Name</span>
				</div>
				<span class="qp-desc">@desc</span>
				<div class="qp-barrow">
					@if ( !dormant )
					{
						<div class="qp-bar"><div class="qp-fill" style="@fillStyle"></div></div>
						<div class="qp-counter"><span class="qp-count">@counter</span></div>
					}
				</div>
			</div>
			<div class="qp-rewards">
				@RewardLine( MissionCurrencyParts( def ) )
				@if ( !string.IsNullOrEmpty( def.ItemReward ) )
				{
					@RewardLine( new List<(string, string)> { (ItemIcon( def.ItemReward ), ItemName( def.ItemReward ) + " ×1") } )
				}
			</div>
			<div class="qp-action">
				@if ( done )
				{
					@StatusChip( "DONE", "gold" )
				}
				else if ( dormant )
				{
					@StatusChip( "NOT OPEN YET", "dim" )
				}
				else if ( claimable )
				{
					<div class="@StopClass( stopKey )" onmouseover=@(() => HoverStop( stopKey ))>
						<BbButton Tier="primary" Size=@(44) Label="@claimLabel" Class="@claimCls" HoverSound=@false OnClick=@(() => PressStop( stopKey )) />
					</div>
				}
			</div>
		</div>
	};

	private RenderFragment SideRow( SideQuest def, int idx ) => __builder =>
	{
		var mgr = SideQuestManager.Instance;
		var state = mgr?.GetState( def.Id );
		var questId = def.Id;
		var claimKey = "s:" + questId;
		var acceptKey = "a:" + questId;
		// LANE: motion — CLAIM holds its costume through the claim beat; ACCEPT
		// holds its button through the accept beat while the text lane already
		// shows the bar (fading in under qp-accepted). Row keeps its slot.
		var beatingClaim = IsBeat( claimKey );
		var beatingAccept = IsBeat( acceptKey );
		var doneOneShotNow = mgr?.IsCompletedOneShot( def.Id ) == true;
		var doneOneShot = doneOneShotNow && !beatingClaim;
		var claimable = (state != null && state.Completed && !state.RewardClaimed) || beatingClaim;
		var available = state == null && !doneOneShotNow && mgr?.IsAvailable( def.Id ) == true;
		var showAccept = available || beatingAccept;
		var locked = state == null && !doneOneShotNow && !available;

		var rowClass = "qp-row dense"
			+ (idx % 2 == 1 ? " alt" : "")
			+ (claimable ? " claimable" : "")
			+ (doneOneShot ? " done" : "")
			+ (locked ? " locked" : "")
			+ (showAccept ? " avail" : "")
			+ (beatingAccept ? " qp-accepted" : "")
			+ RowLadderClass( idx, claimKey, acceptKey )
			+ SettleClass( claimKey );

		var zone = ZoneName( def.ZoneId );
		var desc = locked ? "Clear " + zone + " once to unlock." : def.Description;
		var progress = doneOneShotNow ? def.Target : (state?.Progress ?? 0);
		var fillStyle = "width: " + FillPx( progress, def.Target ) + "px;";
		var counter = FormatCounter( progress, def.Target );
		var openNote = "OPEN · " + zone.ToUpperInvariant() + " CLEARED";
		var byline = "· " + def.NpcName;
		var accentCls = AccentClass( claimKey );
		var claimLabel = beatingClaim ? "CLAIMED" : "CLAIM";
		var claimCls = "qp-claim" + BeatClass( claimKey );
		var acceptCls = "qp-accept" + BeatClass( acceptKey );

		// A1 — item rewards on side rows (Contract Incense ×2 / Premium Incense ×1).
		var itemParts = new List<(string Icon, string Text)>();
		foreach ( var (itemId, qty) in def.ItemRewards ?? new() )
			itemParts.Add( (ItemIcon( itemId ), ItemName( itemId ) + " ×" + qty) );

		<div class="@rowClass">
			<div class="@accentCls"></div>
			<div class="qp-tile">
				<iconify class="qp-glyph" icon="lucide:scroll-text" Size=@(22) Color="@Accent" />
			</div>
			<div class="qp-text">
				<div class="qp-nameline">
					<span class="qp-name">@def.Title</span>
					@if ( !string.IsNullOrEmpty( def.NpcName ) )
					{
						<span class="qp-by">@byline</span>
					}
				</div>
				<span class="qp-desc">@desc</span>
				<div class="qp-barrow">
					@if ( available )
					{
						<span class="qp-note">@openNote</span>
					}
					else if ( !locked )
					{
						<div class="qp-bar"><div class="qp-fill" style="@fillStyle"></div></div>
						<div class="qp-counter"><span class="qp-count">@counter</span></div>
					}
				</div>
			</div>
			<div class="qp-rewards">
				@RewardLine( SideCurrencyParts( def ) )
				@if ( itemParts.Count > 0 )
				{
					@RewardLine( itemParts )
				}
			</div>
			<div class="qp-action">
				@if ( doneOneShot )
				{
					@StatusChip( "DONE", "gold" )
				}
				else if ( locked )
				{
					@StatusChip( "LOCKED", "dim" )
				}
				else if ( claimable )
				{
					<div class="@StopClass( claimKey )" onmouseover=@(() => HoverStop( claimKey ))>
						<BbButton Tier="primary" Size=@(44) Label="@claimLabel" Class="@claimCls" HoverSound=@false OnClick=@(() => PressStop( claimKey )) />
					</div>
				}
				else if ( showAccept )
				{
					<div class="@StopClass( acceptKey )" onmouseover=@(() => HoverStop( acceptKey ))>
						<BbButton Tier="secondary" Size=@(44) Label="ACCEPT" Icon="lucide:check" IconTint="@Accent" Class="@acceptCls" HoverSound=@false OnClick=@(() => PressStop( acceptKey )) />
					</div>
				}
			</div>
		</div>
	};

	// ══════════════════════════════════════════════
	// DEV HOOK — dev_quests [ (none) | claim | bonus | streak | side | empty | reset | off ]
	// The dev_bag pattern (InventoryPanel): close the phone, open the page,
	// mutate live state through the managers' public setters / dev hooks.
	//   dev_quests         → open
	//   dev_quests claim   → first in-progress daily → Completed (CLAIM lights)
	//   dev_quests bonus   → all 5 dailies Completed + Claimed (CLAIM BONUS lights)
	//   dev_quests streak  → today's login reward un-claimed (CLAIM DAY n)
	//   dev_quests side    → zone gate bypassed (ACCEPT) + first active side quest Completed
	//   dev_quests empty   → everything claimed, both bonuses paid, login claimed
	//   dev_quests reset   → re-roll all mission tiers + un-claim login (shoot again)
	//   dev_quests next | prev | press | left | right → drive the kb cursor (LANE: input)
	//   dev_quests off     → close
	// Session-only mutations (MissionManager persists on real claims only).
	// REMOVE after the redesign is user-approved.
	// ══════════════════════════════════════════════

	[ConCmd( "dev_quests" )]
	public static void DevQuests( string arg = "" )
	{
		var gm = Beastborne.Core.GameManager.Instance;
		if ( gm != null && !gm.IsInGame ) gm.StartGame();

		var mm = MissionManager.Instance;
		var drm = DailyRewardManager.Instance;
		var sq = SideQuestManager.Instance;
		arg = (arg ?? "").Trim().ToLowerInvariant();

		switch ( arg )
		{
			case "off":
				if ( IsVisible ) Close();
				Log.Info( "[Quests] dev_quests off" );
				return;

			case "next":
			case "prev":
			case "left":
			case "right":
			case "press":
			{
				var p = Instance;
				if ( p == null || !IsVisible ) { Log.Warning( "[Quests] dev_quests " + arg + ": page not open" ); return; }
				p.StampKb();
				p.SyncStops();
				int idx = p._kbStop == null ? -1 : p._stops.IndexOf( p._kbStop );
				if ( arg == "press" ) { if ( idx >= 0 ) p.PressStop( p._kbStop ); }
				else if ( arg == "left" || arg == "right" )
				{
					int col = arg == "right" ? 1 : 0;
					if ( p._stops.Count > 0 && !(idx >= 0 && ColumnOf( p._kbStop ) == col) )
					{
						var t = p.NearestInColumn( col );
						if ( t != null ) p.MoveTo( t );
					}
				}
				else if ( p._stops.Count > 0 )
				{
					int n = idx < 0 ? 0 : Math.Clamp( idx + (arg == "next" ? 1 : -1), 0, p._stops.Count - 1 );
					p.MoveTo( p._stops[n] );
				}
				Log.Info( $"[Quests] dev_quests {arg} → stop '{p._kbStop ?? "(none)"}' [{p._stops.Count} stops: {string.Join( " ", p._stops )}]" );
				return;
			}

			case "claim":
			{
				var target = mm?.ActiveDailyMissions.FirstOrDefault( m => !m.Completed && !m.MissionId.StartsWith( "arena_" ) );
				if ( target == null ) { Log.Warning( "[Quests] dev_quests claim: no in-progress daily" ); break; }
				var def = mm.GetDefinition( target.MissionId );
				target.Progress = def?.Target ?? target.Progress;
				target.Completed = true;
				Log.Info( $"[Quests] dev_quests claim → {target.MissionId} completed" );
				break;
			}

			case "bonus":
				foreach ( var m in mm?.ActiveDailyMissions ?? new() ) { m.Completed = true; m.Claimed = true; }
				Log.Info( "[Quests] dev_quests bonus → all dailies claimed (CLAIM BONUS lights)" );
				break;

			case "streak":
				drm?.DevResetToday();
				Log.Info( "[Quests] dev_quests streak → today's login reward un-claimed" );
				break;

			case "side":
			{
				if ( sq == null ) break;
				sq.DevForceAvailable = true;
				// First active quest that still HAS a definition; if none, accept the
				// first available definition so a CLAIM row exists to shoot.
				var first = sq.ActiveQuests.FirstOrDefault( q => !q.Completed && sq.GetDefinition( q.Id ) != null );
				if ( first == null )
				{
					var avail = sq.AllDefinitions.FirstOrDefault( d => sq.IsAvailable( d.Id ) );
					if ( avail != null && sq.Accept( avail.Id ) ) first = sq.GetState( avail.Id );
				}
				if ( first != null )
				{
					var def = sq.GetDefinition( first.Id );
					first.Progress = def?.Target ?? first.Progress;
					first.Completed = true;
				}
				Log.Info( $"[Quests] dev_quests side → gate bypassed; {(first != null ? first.Id + " completed" : "no quest to complete")}" );
				break;
			}

			case "reset":
				// Re-roll every mission tier (public Generate* verbs — they also clear
				// the bonus flags), un-claim today's login, drop the zone bypass.
				mm?.GenerateDailyMissions();
				mm?.GenerateWeeklyMissions();
				mm?.GenerateMonthlyChallenge();
				drm?.DevResetToday();
				if ( sq != null ) sq.DevForceAvailable = false;
				Log.Info( "[Quests] dev_quests reset → missions re-rolled, login un-claimed" );
				break;

			case "empty":
			{
				foreach ( var m in mm?.ActiveDailyMissions ?? new() ) { m.Completed = true; m.Claimed = true; }
				foreach ( var m in mm?.ActiveWeeklyMissions ?? new() ) { m.Completed = true; m.Claimed = true; }
				if ( mm?.ActiveMonthlyChallenge is { } mc ) { mc.Completed = true; mc.Claimed = true; }
				mm?.ClaimDailyBonus();
				mm?.ClaimWeeklyBonus();
				drm?.DevMarkTodayClaimed();
				if ( sq != null )
				{
					sq.DevForceAvailable = false;
					foreach ( var q in sq.ActiveQuests.ToList() ) { q.Completed = true; sq.Claim( q.Id ); }
				}
				Log.Info( "[Quests] dev_quests empty → everything claimed" );
				break;
			}

			case "":
				break;

			default:
				Log.Warning( "[Quests] dev_quests: (none) | claim | bonus | streak | side | empty | reset | off" );
				return;
		}

		PhoneLauncher.Close();
		if ( InventoryPanel.IsVisible ) InventoryPanel.Close(); // the Bag (z 9000) covers this page (z 1000) — clear the screen for a shot
		if ( !IsVisible ) Show();
		else CaptureOrder();
		Log.Info( $"[Quests] dev_quests → '{arg}' (unclaimed badge = {GetTotalUnclaimedCount()})" );
	}

	// ══════════════════════════════════════════════
	// LANE: motion — dev_questsfx <beat> (the dev_fusefx / dev_pawpadfx pattern)
	// Replays every beat WITHOUT touching save state: a visual-only beat keeps
	// the button mounted reading CLAIMED for its window, then the row returns
	// to whatever the managers say.
	//   dev_questsfx claim  [key] → claim beat on the cursor stop (or the given
	//                               action string, e.g. d:daily_battle_3)
	//   dev_questsfx login         → CLAIM DAY n beat (button shows even if claimed)
	//   dev_questsfx bonus         → daily CLAIM BONUS beat (chip shows regardless)
	//   dev_questsfx accept        → accept beat on the first ACCEPT stop
	//   dev_questsfx land          → kb land flash on the ring
	//   dev_questsfx ladder        → re-arm the row ladder (2 priming frames)
	//   dev_questsfx open [log]    → close + re-open across frames (zone rungs replay); `log` traces the ring's re-appear 40 Ticks
	//   dev_questsfx exit          → the exit latch
	//   dev_questsfx freeze        → hold every window at its END frame (`both`)
	//   dev_questsfx settle        → (frozen) jump the live beats to their settle phase
	//   dev_questsfx off           → release the clock, clear beats
	// REMOVE after the redesign is user-approved.
	// ══════════════════════════════════════════════

	[ConCmd( "dev_questsfx" )]
	public static void DevQuestsFx( string arg = "", string key = "" )
	{
		var p = Instance;
		if ( p == null ) { Log.Warning( "[Quests] dev_questsfx: panel not rooted" ); return; }
		arg = (arg ?? "").Trim().ToLowerInvariant();
		if ( arg != "open" && !IsVisible ) DevQuests();

		p.SyncStops();
		switch ( arg )
		{
			case "claim":
			{
				var k = !string.IsNullOrEmpty( key ) ? key : (p._kbStop ?? p._stops.FirstOrDefault( s => s != "login" && !s.StartsWith( "b:" ) && !s.StartsWith( "a:" ) ));
				if ( k == null ) { Log.Warning( "[Quests] dev_questsfx claim: no stop to beat" ); return; }
				p.FireBeat( k );
				Log.Info( $"[Quests] dev_questsfx claim → beat on '{k}' (v{p._beatVersion})" );
				return;
			}
			case "login": p.FireBeat( "login" ); Log.Info( "[Quests] dev_questsfx login → CLAIM DAY n beat" ); return;
			case "bonus": p.FireBeat( "b:daily" ); Log.Info( "[Quests] dev_questsfx bonus → daily CLAIM BONUS beat" ); return;
			case "accept":
			{
				var k = p._stops.FirstOrDefault( s => s.StartsWith( "a:" ) );
				if ( k == null ) { Log.Warning( "[Quests] dev_questsfx accept: no ACCEPT stop (dev_quests side first)" ); return; }
				p.FireBeat( k );
				Log.Info( $"[Quests] dev_questsfx accept → beat on '{k}'" );
				return;
			}
			case "land":
				p.StampKb();
				p._ringLitUntil = RealTime.Now + 0.05f;
				Log.Info( "[Quests] dev_questsfx land → ring flash" );
				return;
			case "ladder":
				p._ladderPrime = 2;
				p.StateHasChanged();
				Log.Info( "[Quests] dev_questsfx ladder → re-armed (2 priming frames)" );
				return;
			case "open":
				if ( IsVisible ) Close();
				p._reopenIn = 2;
				if ( key == "log" ) p._ringLogFrames = 40; // `dev_questsfx open log` — trace the ring's re-appear
				Log.Info( "[Quests] dev_questsfx open → re-open in 2 frames" + (key == "log" ? " (ring trace armed, 40 frames)" : "") );
				return;
			case "exit":
				p.BeginExit();
				Log.Info( "[Quests] dev_questsfx exit → latch 0.12s" );
				return;
			case "freeze":
				p._fxFreeze = true;
				p._fxFrozenAt = RealTime.Now;
				p.StateHasChanged();
				Log.Info( "[Quests] dev_questsfx freeze → windows held" );
				return;
			case "settle":
			{
				if ( !p._fxFreeze ) { Log.Warning( "[Quests] dev_questsfx settle: freeze first" ); return; }
				float at = p._beats.Count > 0 ? p._beats.Values.Max( b => b.at + b.window ) : RealTime.Now;
				p._fxFrozenAt = at + 0.01f;
				p.StateHasChanged();
				Log.Info( "[Quests] dev_questsfx settle → beats in phase 2" );
				return;
			}
			case "off":
				p._fxFreeze = false;
				p._beats.Clear();
				p.StateHasChanged();
				Log.Info( "[Quests] dev_questsfx off → clock released" );
				return;
			default:
				Log.Warning( "[Quests] dev_questsfx: claim [key] | login | bonus | accept | land | ladder | open | exit | freeze | settle | off" );
				return;
		}
	}
}
