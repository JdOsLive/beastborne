@namespace Beastborne.UI.Panels
@using Sandbox;
@using Sandbox.UI;
@using Beastborne.Core;
@using Beastborne.Data;
@using Beastborne.Systems;
@using Beastborne.UI;
@using System.Linq;
@inherits Panel

<root class="@(IsVisible ? "visible" : "") @(hasEntered ? "entered" : "")">
	<div class="profile-overlay" onclick=@Close></div>

	<div class="profile-modal @GetRankClass()">
		<div class="profile-pattern"></div>

		<!-- Angled violet kicker stamp (top-left, sticks past panel edge) —
			the panel's ONE angled element. Dock-tier identity: violet on
			dark, not rank-colored (rank lives on the avatar stamp + pill). -->
		<div class="profile-corner-tag">
			<span>TAMER CARD · LV @GetLevel()</span>
		</div>

		<button class="close-btn profile-close-stamp" onclick=@Close><iconify icon="lucide:x" Size=@(15) Color="rgba(255, 255, 255, 0.9)" /></button>

		<!-- Zone 1: Hero Banner -->
		<div class="profile-hero">
			@{
				var heroBg = GetHeroBackground();
			}
			<div class="hero-bg" style="background-image: url(@heroBg)"></div>
			<div class="hero-overlay"></div>
			<div class="hero-halftone"></div>
			<div class="hero-content">
				<!-- THE HERO — big gold-ringed avatar, the HUD player tag's
					hardware language at card scale. Rank keeps its color on
					the small stamp badge only. -->
				<div class="avatar-frame">
					<div class="avatar-portrait" style="background-image: url(@GetPortraitPath())"></div>
					<div class="avatar-rank-stamp" style="background-color: @GetRankColor()">
						<iconify icon="@GetRankLucideIcon()" Size=@(14) Color="#1a0f30" />
					</div>
				</div>
				<div class="hero-info">
					<span class="tamer-name">@GetTamerName()</span>
					<div class="title-row">
						<span class="title-text" style="color: @GetDisplayTitleColor()">@GetDisplayTitle()</span>
						<span class="title-edit-btn" onclick=@ToggleTitleSelector>@L("ui.profile.change")</span>
					</div>
					@if ( GuildManager.UiEnabled && GuildManager.Instance?.IsInGuild == true )
					{
						<span class="guild-pill" style="background-color: @(GuildManager.Instance?.Guild?.EmblemColor ?? "#7c3aed")">[@(GuildManager.Instance?.Guild?.Tag ?? "")] @(GuildManager.Instance?.Guild?.Name ?? "")</span>
					}
					<span class="rank-pill" style="background-color: @GetRankColor()">
						<iconify icon="@GetRankLucideIcon()" Size=@(12) Color="#1a0f30" />
						<span class="rank-pill-text">@GetRankComputed()</span>
					</span>
				</div>
				<div class="level-block">
					<div class="level-stamp-pill">
						<span class="level-stamp-text">@L("ui.profile.level")</span>
					</div>
					<span class="level-number">@GetLevel()</span>
					<div class="xp-bar">
						<div class="xp-fill" style="width: @(GetXPProgress() * 100)%"></div>
					</div>
					<span class="xp-text">@FormatLargeNumber( GetCurrentLevelXP() ) / @FormatLargeNumber( GetXPForNextLevel() ) XP</span>
				</div>
			</div>
		</div>

		<div class="profile-content">
			<!-- Zone 2: Favorite Beast + Beastiary Discovery —
				Two side-by-side stamp slabs (asymmetric: portrait slab is wider).
				Collection slab is now Beastiary-only — the Owned/Max count was
				redundant with the persistent HUD and added a second number that
				distracted from the discovery progression read. -->
			<div class="collection-section">
				<div class="favorite-beast @(GetFavoriteMonsterSpecies()?.Element.ToString().ToLower() ?? "")">
					<span class="section-label">@L("ui.profile.favorite_beast")</span>
					@if ( showBeastSelector )
					{
						<div class="fav-selector-dropdown">
							<div class="fav-opt" onclick=@(() => SetFavoriteBeast( null ))>
								<span class="fav-opt-name">@L("ui.profile.none")</span>
							</div>
							@foreach ( var species in GetDiscoveredSpeciesList() )
							{
								<div class="fav-opt" onclick=@(() => SetFavoriteBeast( species.Id ))>
									@if ( !string.IsNullOrEmpty( species.IconPath ) )
									{
										<img class="fav-opt-icon" src="@species.IconPath" />
									}
									<span class="fav-opt-name">@species.Name</span>
								</div>
							}
						</div>
					}
					else
					{
						<div class="fav-display beast-display" onclick=@(() => { showBeastSelector = true; })>
							@{
								var favSpecies = GetFavoriteMonsterSpecies();
							}
							@if ( favSpecies != null && !string.IsNullOrEmpty( favSpecies.IconPath ) )
							{
								<div class="beast-portrait-frame">
									<img class="beast-portrait-img" src="@favSpecies.IconPath" style="margin-left: @(favSpecies.IconOffsetX - 18)px; margin-top: @(favSpecies.IconOffsetY)px" />
								</div>
								<span class="fav-name">@favSpecies.Name</span>
							}
							else
							{
								<span class="fav-empty">@L("ui.profile.select")</span>
							}
							<span class="fav-change-hint">@L("ui.profile.change")</span>
						</div>
					}
				</div>
				<!-- Beastiary discovery slab — single stat (discovered species)
					+ the gradient bar. The Owned/Max counter was cut as duplicate
					information already present in the HUD / roster. -->
				<div class="collection-stamp">
					<div class="discovery-headline">
						<span class="discovery-count">@GetDiscoveredSpecies()</span>
						<span class="discovery-cap">/ @GetTotalSpecies()</span>
						<span class="discovery-label">@L("ui.profile.discovered")</span>
					</div>
					<div class="discovery-bar">
						<div class="discovery-fill" style="width: @(GetDiscoveryPercent())%"></div>
					</div>
				</div>
			</div>

			<!-- Zone 3: Achievements meter — the one progression beat that
				doubles as flex (count) AND a navigation affordance into the
				Achievements panel (one click). -->
			<div class="prog-meter achievements clickable" onclick=@OnViewAchievements>
				<div class="prog-meter-row">
					<span class="prog-meter-diamond"></span>
					<span class="prog-meter-label">@L("ui.profile.achievements")</span>
					<span class="prog-meter-value">@GetAchievementCount()</span>
					<span class="prog-meter-cap">/ @GetTotalAchievementCount()</span>
					<span class="prog-meter-arrow"><iconify icon="lucide:chevron-right" Size=@(14) Color="rgba(255,255,255,0.65)" /></span>
				</div>
				<div class="prog-meter-bar">
					<div class="prog-meter-fill achievements" style="width: @(GetTotalAchievementCount() > 0 ? (int)((float)GetAchievementCount() / GetTotalAchievementCount() * 100) : 0)%"></div>
				</div>
			</div>

			<!-- Zone 4: Arena record — DEMOTED to a compact strip (the online
				arena isn't live yet; the rank-up celebration + rank theming
				stay wired for launch, but an UNRANKED 0-pts showcase doesn't
				earn headline placement on a live player's card). -->
			<div class="arena-showcase">
				<div class="arena-stamp-tag">
					<span>ARENA</span>
				</div>
				<div class="arena-top-row">
					<div class="arena-rank-display">
						<div class="rank-icon-square" style="background-color: @GetRankColor()">
							<iconify icon="@GetRankLucideIcon()" Size=@(18) Color="#1a0f30" />
						</div>
						<div class="rank-details">
							<span class="rank-name" style="color: @GetRankColor()">@GetRankComputed()</span>
							<span class="rank-points">@GetArenaPoints().ToString("N0") pts</span>
						</div>
					</div>
					<div class="arena-stats-row">
						<div class="arena-stat-pill wins">
							<span class="arena-stat-diamond"></span>
							<span class="arena-stat-value">@GetArenaWins().ToString("N0")</span>
							<span class="arena-stat-label">@L("ui.profile.wins")</span>
						</div>
						<div class="arena-stat-pill losses">
							<span class="arena-stat-diamond"></span>
							<span class="arena-stat-value">@GetArenaLosses().ToString("N0")</span>
							<span class="arena-stat-label">@L("ui.profile.losses")</span>
						</div>
						@if ( GetArenaWinStreak() > 0 )
						{
							<div class="arena-stat-pill streak">
								<span class="arena-stat-diamond"></span>
								<span class="arena-stat-value">@GetArenaWinStreak().ToString("N0")</span>
								<span class="arena-stat-label">@L("ui.profile.streak")</span>
							</div>
						}
					</div>
					<div class="arena-winrate-badge" style="color: @GetRankColor()">
						<span class="arena-winrate-value">@GetArenaWinRate()%</span>
						<span class="arena-winrate-label">@L("ui.profile.win_rate")</span>
					</div>
				</div>
			</div>

			<!-- Zone 5: Footer -->
			<div class="profile-footer">
				<span class="playtime">@L("ui.profile.playtime", GetPlayTime())</span>
				<span class="created-date">@L("ui.profile.tamer_since", GetCreatedDate())</span>
			</div>
		</div>

		<!-- Title Selector Popup Overlay -->
		@if ( showTitleSelector )
		{
			<div class="title-overlay" onclick=@CloseTitleSelector></div>
			<div class="title-popup">
				<span class="title-popup-header">@L("ui.profile.select_title")</span>
				<div class="title-popup-list">
					@foreach ( var lt in GetEarnedLevelTitles() )
					{
						<button class="title-option @(string.IsNullOrEmpty( GetTamer()?.ActiveTitleId ) && GetDisplayTitle() == lt ? "active" : "")"
							onclick=@(() => SelectLevelTitle( lt ))>
							<span class="title-option-name" style="color: #a78bfa">@lt</span>
						</button>
					}
					@if ( GetUnlockedTitles().Count > 0 )
					{
						<span class="title-section-divider">@L("ui.profile.cosmetic")</span>
					}
					@foreach ( var title in GetUnlockedTitles() )
					{
						<button class="title-option @(GetTamer()?.ActiveTitleId == title.Id ? "active" : "")"
							onclick=@(() => SelectTitle( title.Id ))>
							<span class="title-option-name" style="color: @title.TitleColor">@title.Title</span>
						</button>
					}
				</div>
			</div>
		}
	</div>

	<!-- ═══════════════════════════════════════════════════════════
		T3 RANK-UP CELEBRATION — fires when the computed arena rank
		INCREASES (point gains that cross a tier threshold). Full-bleed
		sibling of the modal so it is never clipped by modal/content
		bounds. Every layer is conditionally rendered + render-keyed
		(@key=rankUpVersion) so its mount-time @keyframes fire FRESH each
		time — the proven one-shot reveal pattern (per 26.06.03 rules;
		class-toggle transforms snap, mounted @keyframes don't replay).
		Anti-gacha: deterministic — you EARNED this rank by climbing
		points, there is no roll. Themed to the rank you just reached.
	═══════════════════════════════════════════════════════════ -->
	@if ( rankUpActive )
	{
		<div class="rankup-overlay" @key=rankUpVersion>
			<div class="rankup-flash" style="background-color: @(rankUpColor)"></div>
			<div class="rankup-ring rankup-ring-1" style="border-color: @(rankUpColor)"></div>
			<div class="rankup-ring rankup-ring-2" style="border-color: @(rankUpColor)"></div>
			<div class="rankup-burst">
				@for ( int i = 0; i < 12; i++ )
				{
					<div class="rankup-mote rankup-mote-@i" style="background-color: @(rankUpColor)"></div>
				}
			</div>
			<div class="rankup-card" style="border-color: @(rankUpColor); box-shadow: 6px 6px 0 @(rankUpShadow), 0 18px 48px rgba(0, 0, 0, 0.7)">
				<!-- Literal string (not L()) — the `ui.profile.rank_up` key isn't in
					the localization files (Assets/, out of UI-agent scope). A missing
					key renders the raw key string, so a literal avoids that. Flag to
					product to add the key if localization is wanted. -->
				<span class="rankup-eyebrow">RANK UP</span>
				<div class="rankup-icon-square" style="background-color: @(rankUpColor); box-shadow: 3px 3px 0 @(rankUpShadow)">
					<iconify icon="@rankUpIcon" Size=@(40) Color="#1a0f30" />
				</div>
				<span class="rankup-rank-name" style="color: @(rankUpColor)">@rankUpRank</span>
			</div>
		</div>
	}
</root>

@code {
	// Localization helper
	private string L( string key ) => LocalizationManager.Get( key );
	private string L( string key, params object[] args ) => LocalizationManager.Get( key, args );

	public static bool IsVisible { get; set; } = false;

	public static void Show() { IsVisible = true; SoundManager.PlayPopup(); }
	public static void Close() { IsVisible = false; SoundManager.PlayPopdown(); }
	public static void Toggle() { IsVisible = !IsVisible; if (IsVisible) SoundManager.PlayPopup(); else SoundManager.PlayPopdown(); }

	private bool showTitleSelector = false;
	private bool showBeastSelector = false;

	// ── Open-entrance state ──
	// `.entered` is flipped ON a frame after the panel mounts/opens so the
	// CSS opacity+delay staggers (on .visible.entered ...) re-fire EVERY open.
	// We can't rely on first-mount @keyframes (they don't replay on re-open)
	// nor on class-toggle transforms (they snap in 26.06.03). Opacity
	// transitions off a code-flipped class are the reliable pattern.
	private bool hasEntered = false;
	private bool _wasVisible = false;

	// ── T3 rank-up celebration state ──
	// Tracks the last rank index we rendered so we can detect a tier-crossing
	// INCREASE (point gains). Only an increase celebrates — a point loss that
	// drops a tier is silently absorbed.
	private int _lastRankIndex = -1;
	private bool rankUpActive = false;
	private int rankUpVersion = 0;          // render key — remounts overlay so @keyframes re-fire
	private string rankUpRank = "";
	private string rankUpColor = "#9ca3af";
	private string rankUpShadow = "rgba(75, 85, 99, 0.78)";
	private string rankUpIcon = "lucide:shield";

	// Ordered low→high so a larger index = a higher rank. Mirrors
	// CompetitiveManager.GetRankFromPoints thresholds.
	private static readonly string[] RankOrder =
	{
		"Unranked", "Bronze", "Silver", "Gold", "Platinum",
		"Diamond", "Master", "Legendary", "Mythic"
	};

	private int RankIndexOf( string rank )
	{
		for ( int i = 0; i < RankOrder.Length; i++ )
			if ( RankOrder[i] == rank ) return i;
		return 0;
	}

	private Tamer GetTamer() => TamerManager.Instance?.CurrentTamer;

	// Identity
	private string GetTamerName() => GetTamer()?.Name ?? "Unknown Tamer";
	private int GetLevel() => GetTamer()?.Level ?? 1;
	private float GetXPProgress() => GetTamer()?.XPProgress ?? 0;
	private int GetCurrentLevelXP() => GetTamer()?.CurrentLevelXP ?? 0;
	private int GetXPForNextLevel() => GetTamer()?.XPForNextLevel ?? 100;

	// Arena (rank is computed from points via GetRankComputed; raw
	// Tamer.ArenaRank field isn't read on this card)
	private int GetArenaPoints() => GetTamer()?.ArenaPoints ?? 0;
	private int GetArenaWins() => GetTamer()?.ArenaWins ?? 0;
	private int GetArenaLosses() => GetTamer()?.ArenaLosses ?? 0;
	private int GetArenaWinRate()
	{
		var total = GetArenaWins() + GetArenaLosses();
		return total > 0 ? (int)((float)GetArenaWins() / total * 100) : 0;
	}
	private int GetArenaWinStreak() => GetTamer()?.ArenaWinStreak ?? 0;

	// Rank helpers
	private string GetRankComputed() => CompetitiveManager.GetRankFromPoints( GetArenaPoints() );
	private string GetRankColor()
	{
		var color = CompetitiveManager.GetRankColor( GetRankComputed() );
		// Brighten unranked so it's visible on dark backgrounds
		if ( color == "#6b7280" ) return "#9ca3af";
		return color;
	}
	private string GetRankIcon() => CompetitiveManager.GetRankIcon( GetRankComputed() );
	private string GetRankLucideIcon() => CompetitiveManager.GetRankLucideIcon( GetRankComputed() );
	private string GetRankClass() => $"rank-{GetRankComputed().ToLower()}";

	// P5-stamp hard-offset shadow color, keyed to rank. Slightly darker /
	// more saturated than the rank fill so the slab reads "stamped" against
	// the dark modal background.
	private string GetRankShadow()
	{
		return GetRankComputed() switch
		{
			"Mythic" => "rgba(190, 24, 93, 0.78)",        // pink-deep
			"Legendary" => "rgba(217, 119, 6, 0.78)",     // gold-deep
			"Master" => "rgba(124, 58, 237, 0.78)",       // purple-deep
			"Diamond" => "rgba(37, 99, 235, 0.78)",       // blue-deep
			"Platinum" => "rgba(8, 145, 178, 0.78)",      // cyan-deep
			"Gold" => "rgba(161, 98, 7, 0.78)",           // amber-deep
			"Silver" => "rgba(75, 85, 99, 0.85)",         // slate-deep
			"Bronze" => "rgba(154, 52, 18, 0.78)",        // bronze-deep
			_ => "rgba(75, 85, 99, 0.78)"                 // unranked-slate
		};
	}

	// Discovery
	private int GetDiscoveredSpecies() => BeastiaryManager.Instance?.GetDiscoveryCount() ?? 0;
	private int GetTotalSpecies() => BeastiaryManager.Instance?.GetTotalSpeciesCount() ?? 1;
	private int GetDiscoveryPercent()
	{
		var total = GetTotalSpecies();
		return total > 0 ? (int)((float)GetDiscoveredSpecies() / total * 100) : 0;
	}

	// Achievements
	private int GetAchievementCount() => GetTamer()?.Achievements?.Values.Count( p => p.IsUnlocked ) ?? 0;
	private int GetTotalAchievementCount() => AchievementManager.Instance?.GetTotalCount() ?? 0;

	// Favorite monster
	private MonsterSpecies GetFavoriteMonsterSpecies()
	{
		var id = GetTamer()?.FavoriteMonsterSpeciesId;
		if ( string.IsNullOrEmpty( id ) ) return null;
		return MonsterManager.Instance?.GetSpecies( id );
	}

	// Favorite beast selector
	private List<MonsterSpecies> GetDiscoveredSpeciesList()
	{
		var discovered = BeastiaryManager.Instance?.DiscoveredSpecies;
		if ( discovered == null || discovered.Count == 0 ) return new();
		return discovered
			.Select( id => MonsterManager.Instance?.GetSpecies( id ) )
			.Where( s => s != null )
			.OrderBy( s => s.Name )
			.ToList();
	}

	private void SetFavoriteBeast( string speciesId )
	{
		var tamer = GetTamer();
		if ( tamer != null )
		{
			tamer.FavoriteMonsterSpeciesId = speciesId;
			TamerManager.Instance?.SaveToCloud();
		}
		showBeastSelector = false;
	}

	// Portrait
	private string GetPortraitPath() => GetTamer()?.Gender == TamerGender.Female
		? "ui/characters/female/female_tamer.png"
		: "ui/characters/male/male_tamer.png";

	// Hero background — fixed default tamer-card art. Favorite-expedition was
	// removed from the profile panel UI (the underlying Tamer.FavoriteExpeditionId
	// data field still exists for use elsewhere — chat tamer cards, etc).
	private string GetHeroBackground() => "ui/menus/bg_tamercard.png";

	// Title system — calibrated to launch's Tamer max level of 50.
	// 1 Tamer / 10 Apprentice / 20 Skilled / 30 Expert / 40 Master /
	// 50 Legendary. Player earns the "Legendary Tamer" title at the cap.
	private string GetTitle()
	{
		var level = GetLevel();
		if ( level >= 50 ) return "Legendary Tamer";
		if ( level >= 40 ) return "Master Tamer";
		if ( level >= 30 ) return "Expert Tamer";
		if ( level >= 20 ) return "Skilled Tamer";
		if ( level >= 10 ) return "Apprentice Tamer";
		return "Tamer";
	}

	private string GetDisplayTitle()
	{
		var tamer = GetTamer();
		var activeId = tamer?.ActiveTitleId;
		if ( !string.IsNullOrEmpty( activeId ) )
		{
			var title = CosmeticDatabase.GetTitle( activeId );
			if ( title != null ) return title.Title;
		}
		if ( !string.IsNullOrEmpty( tamer?.ActiveLevelTitle ) )
			return tamer.ActiveLevelTitle;
		return GetTitle();
	}

	private string GetDisplayTitleColor()
	{
		var activeId = GetTamer()?.ActiveTitleId;
		if ( !string.IsNullOrEmpty( activeId ) )
		{
			var title = CosmeticDatabase.GetTitle( activeId );
			if ( title != null ) return title.TitleColor;
		}
		return "#a78bfa";
	}

	private List<TamerTitle> GetUnlockedTitles()
	{
		var unlocked = GetTamer()?.UnlockedTitles;
		if ( unlocked == null || unlocked.Count == 0 ) return new();
		return CosmeticDatabase.Titles.Where( t => unlocked.Contains( t.Id ) ).ToList();
	}

	private void ToggleTitleSelector()
	{
		showTitleSelector = !showTitleSelector;
		SoundManager.PlayClick();
	}

	private void CloseTitleSelector()
	{
		showTitleSelector = false;
		SoundManager.PlayClick();
	}

	private void SelectTitle( string titleId )
	{
		TamerManager.Instance?.SetActiveTitle( titleId );
		var tamer = GetTamer();
		if ( tamer != null ) tamer.ActiveLevelTitle = null;
		TamerManager.Instance?.SaveToCloud();
		showTitleSelector = false;
		SoundManager.PlayClick();
		ChatManager.Instance?.SendPlayerProfile();
	}

	private List<string> GetEarnedLevelTitles()
	{
		var level = GetLevel();
		var titles = new List<string> { "Tamer" };
		if ( level >= 10 ) titles.Add( "Apprentice Tamer" );
		if ( level >= 20 ) titles.Add( "Skilled Tamer" );
		if ( level >= 30 ) titles.Add( "Expert Tamer" );
		if ( level >= 40 ) titles.Add( "Master Tamer" );
		if ( level >= 50 ) titles.Add( "Legendary Tamer" );
		return titles;
	}

	private void SelectLevelTitle( string title )
	{
		var tamer = GetTamer();
		if ( tamer == null ) return;
		tamer.ActiveTitleId = null;
		tamer.ActiveLevelTitle = title;
		TamerManager.Instance?.SaveToCloud();
		showTitleSelector = false;
		SoundManager.PlayClick();
		ChatManager.Instance?.SendPlayerProfile();
	}

	// Formatting
	private string FormatLargeNumber( int value )
	{
		if ( value >= 1000000 ) return $"{value / 1000000f:F1}M";
		if ( value >= 1000 ) return $"{value / 1000f:F1}K";
		return value.ToString( "N0" );
	}

	private string GetPlayTime()
	{
		var time = GetTamer()?.TotalPlayTime ?? TimeSpan.Zero;
		if ( time.TotalDays >= 1 )
			return $"{(int)time.TotalDays}d {time.Hours}h";
		if ( time.TotalHours >= 1 )
			return $"{(int)time.TotalHours}h {time.Minutes}m";
		return $"{time.Minutes}m";
	}

	private string GetCreatedDate()
	{
		var date = GetTamer()?.CreatedAt ?? DateTime.UtcNow;
		return date.ToString( "MMM d, yyyy" );
	}

	// Navigation
	private void OnViewAchievements()
	{
		Close();
		AchievementPanel.Show();
	}

	public override void Tick()
	{
		base.Tick();

		// ── Open-entrance: flip `.entered` a frame after the panel becomes
		// visible so the opacity+delay stagger replays every open. Reset on
		// close so the next open re-runs from the hidden base state.
		if ( IsVisible && !_wasVisible )
		{
			hasEntered = false;
			_ = PlayEntrance();
			// Seed the rank baseline on open so the FIRST open never fires a
			// false celebration (we only celebrate a change observed while open).
			if ( _lastRankIndex < 0 )
				_lastRankIndex = RankIndexOf( GetRankComputed() );
		}
		else if ( !IsVisible && _wasVisible )
		{
			hasEntered = false;
		}
		_wasVisible = IsVisible;

		// ── Rank-up detection (only while the panel is open + visible so the
		// celebration is seen). Compares the live computed rank against the
		// last index; an INCREASE fires the T3 moment.
		if ( IsVisible )
		{
			var idx = RankIndexOf( GetRankComputed() );
			if ( _lastRankIndex >= 0 && idx > _lastRankIndex )
				TriggerRankUp();
			if ( idx != _lastRankIndex )
				_lastRankIndex = idx;
		}

		// Escape (s&box-reserved) AND the canonical Menu/run "back" keys close.
		if ( IsVisible && UIModalState.IsTopModal( "ProfilePanel" )
			&& ( Input.Pressed( "Escape" ) || Input.Pressed( "Menu" ) || Input.Pressed( "run" ) ) )
			Close();
	}

	// Flip `.entered` shortly after mount/open so CSS opacity transitions +
	// transition-delay staggers fire. Small delay lets the hidden base state
	// paint one frame first, so the transition has a from→to to animate.
	private async System.Threading.Tasks.Task PlayEntrance()
	{
		await System.Threading.Tasks.Task.Delay( 30 );
		if ( !IsVisible ) return;
		hasEntered = true;
	}

	// ── T3 rank-up: capture the reached rank's theme + remount the overlay so
	// its mount-time @keyframes play, then auto-dismiss after the celebration.
	private void TriggerRankUp()
	{
		rankUpRank = GetRankComputed();
		rankUpColor = GetRankColor();
		rankUpShadow = GetRankShadow();
		rankUpIcon = GetRankLucideIcon();
		rankUpVersion++;
		rankUpActive = true;

		// Layered cue — milestone vocabulary (click impact + success swell +
		// gold reward sting). No dedicated rank-up cue file exists yet; flagged
		// to product. Per "sound is UI" this is ~the right T3 shape until then.
		SoundManager.PlayClick();
		SoundManager.PlaySuccess();
		SoundManager.PlayGoldReward();

		_ = DismissRankUp();
	}

	private async System.Threading.Tasks.Task DismissRankUp()
	{
		// Hold long enough for flash → rings → burst → card slam to read,
		// then unmount (overlay fades via its own settle keyframe end-state).
		await System.Threading.Tasks.Task.Delay( 2200 );
		rankUpActive = false;
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add( IsVisible );
		hash.Add( GetLevel() );
		hash.Add( GetArenaPoints() );
		hash.Add( GetDiscoveredSpecies() );
		hash.Add( GetAchievementCount() );
		hash.Add( GetTamer()?.ActiveTitleId );
		hash.Add( GetTamer()?.ActiveLevelTitle );
		hash.Add( GetTamer()?.FavoriteMonsterSpeciesId );
		hash.Add( showTitleSelector );
		hash.Add( showBeastSelector );
		hash.Add( hasEntered );
		hash.Add( rankUpActive );
		hash.Add( rankUpVersion );
		return hash.ToHashCode();
	}
}
