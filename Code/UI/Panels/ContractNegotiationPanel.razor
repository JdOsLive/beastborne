@namespace Beastborne.UI.Panels
@using Sandbox;
@using Sandbox.UI;
@using Beastborne.Core;
@using Beastborne.Data;
@using Beastborne.Systems;
@using Beastborne.UI.Components;
@using Beastborne.Battle3D;
@inherits Panel

<div class="contract-radial @(IsVisible ? "visible" : "") @GetResultClass()">
	@if (IsVisible && TargetMonster != null && currentState == NegotiationState.Selecting)
	{
		@{
			var screenPos = GetBeastScreenPosition();
			var leftPct = screenPos.x * 100f;
			var topPct = screenPos.y * 100f;
		}
		<!-- Radial diamond container, centered on beast screen position -->
		<div class="radial-container" style="left: @(leftPct)%; top: @(topPct)%">
			<!-- 4 approach diamonds positioned absolutely -->
			@if (negotiationOptions != null)
			{
				int posIdx = 0;
				@foreach (var option in negotiationOptions)
				{
					var opt = option;
					var isSelected = selectedOption == opt;
					var canAfford = CanAffordOption(opt);
					var posClass = posIdx switch { 0 => "radial-top", 1 => "radial-right", 2 => "radial-bottom", 3 => "radial-left", _ => "radial-top" };
					// Cap number is owned by SCREEN POSITION, not approach identity
					// or declaration order. The 2x2 grid is: BL=1, TL=2, TR=3, BR=4
					// (sweep up the left column, then down the right). The loop
					// visits declaration order, whose posClass→screen mapping is
					// radial-top=BL, radial-right=TR, radial-bottom=BR, radial-left=TL
					// — so declaration index 0/1/2/3 → cap 1/3/4/2.
					var capNumber = SlotNumberForIndex(posIdx);
					posIdx++;

					<div class="radial-approach @posClass @(isSelected ? "selected" : "") @(!canAfford ? "cant-afford" : "") @(selectedOption != null && !isSelected ? "dimmed" : "")"
						 onclick=@(() => SelectOption(opt))
						 onmouseover=@(() => SoundManager.PlayHover())>
						<div class="approach-diamond">
							<div class="approach-diamond-inner"></div>
							<span class="approach-pct">@(useMasterInk ? "100%" : ((int)(opt.SuccessChance * 100)).ToString() + "%")</span>
						</div>
						<div class="approach-label">
							<div class="approach-name-row">
								<span class="kb-key">@(capNumber)</span>
								<span class="approach-name">@opt.Name</span>
								@if (opt.IsPersonalityMatch)
								{
									<span class="approach-match"><iconify icon="lucide:star" Size=@(12) Color="#fbbf24" /></span>
								}
							</div>
							<div class="approach-cost-row">
								@if (opt.InkCost > 0)
								{
									<span class="cost-item">@opt.InkCost</span>
									<img class="cost-icon" src="ui/icons/currency/ink.svg" />
								}
								@if (opt.GoldCost > 0)
								{
									<span class="cost-item">@opt.GoldCost</span>
									<img class="cost-icon" src="ui/icons/currency/money.svg" />
								}
								@if (opt.BossTokenCost > 0)
								{
									<span class="cost-item">@opt.BossTokenCost</span>
									<img class="cost-icon" src="ui/icons/currency/token.svg" />
								}
								@if (opt.CostsPlayerHP)
								{
									<span class="cost-special">HP</span>
								}
								@if (opt.CostsSkipTurns)
								{
									<span class="cost-special">2 turns</span>
								}
								@if (opt.InkCost == 0 && opt.GoldCost == 0 && opt.BossTokenCost == 0 && !opt.CostsPlayerHP && !opt.CostsSkipTurns)
								{
									<span class="cost-item">Free</span>
								}
							</div>
						</div>
					</div>
				}
			}

			<!-- Below radial: hint + info + buttons -->
			<div class="radial-bottom-section">
				<div class="radial-kicker">
					<span class="kicker-text">CONTRACT · LV @TargetMonster?.Level</span>
				</div>
				<div class="radial-hint">
					<span class="hint-text">@GetPersonalityHint()</span>
				</div>
				<div class="radial-info-bar">
			<div class="info-beast">
				<div class="info-beast-diamond el-border-@GetElementClass()">
					@if (HasSprite())
					{
						<img class="info-beast-sprite" src="@GetMonsterIcon()" />
					}
				</div>
				<div class="info-beast-text">
					<span class="info-name">@TargetMonster?.Nickname</span>
					<span class="info-level">Lv @TargetMonster?.Level</span>
					<span class="info-ink">Ink: @GetStampCount()</span>
					@if (HasMasterInk())
					{
						<div class="info-master-ink @(useMasterInk ? "active" : "")" onclick=@ToggleMasterInk>
							<span class="kb-key kb-key-wide">Tab</span>
							<span class="master-ink-label">Master Ink</span>
						</div>
					}
				</div>
			</div>
		</div>

		<!-- Action buttons -->
		<div class="radial-actions">
			<div class="radial-btn attempt @(selectedOption == null ? "disabled" : "")" onclick=@AttemptNegotiation onmouseover=@(() => SoundManager.PlayHover())>
				<span class="kb-key kb-key-wide">Space</span>
				<span class="radial-btn-text">ATTEMPT</span>
			</div>
			<div class="radial-btn cancel" onclick=@SkipNegotiation onmouseover=@(() => SoundManager.PlayHover())>
				<span class="kb-key">Q</span>
				<span class="radial-btn-text">CANCEL</span>
			</div>
		</div>
			</div>
		</div>
	}
	else if (IsVisible && TargetMonster != null && currentState == NegotiationState.Success)
	{
		<div class="radial-result success">
			<!-- Celebration backdrop: anticipation light-ring + radial burst rays
			     behind the portrait. Deterministic reveal (anti-gacha): the same
			     beat plays whether the catch was 30% or 100% — no RNG framing. -->
			<div class="success-flash"></div>
			<div class="success-rays"></div>
			<div class="success-ring"></div>
			@for (int s = 0; s < 8; s++)
			{
				var spark = s;
				<div class="success-spark spark-@spark"></div>
			}
			<span class="result-title">Contract Signed!</span>
			@if (HasSprite())
			{
				<div class="result-portrait-wrap">
					<img class="result-portrait" src="@GetMonsterIcon()" />
				</div>
			}
			<span class="result-text">@TargetMonster?.Nickname joined your team!</span>
			<div class="radial-btn continue" onclick=@FinishNegotiation onmouseover=@(() => SoundManager.PlayHover())>
				<span class="kb-key kb-key-wide">Space</span>
				<span class="radial-btn-text">CONTINUE</span>
			</div>
		</div>
	}
	else if (IsVisible && TargetMonster != null && currentState == NegotiationState.Failed)
	{
		<div class="radial-result failed">
			<span class="result-title">Negotiation Failed</span>
			<span class="result-text">@TargetMonster?.Nickname refused your contract!</span>
			<div class="radial-btn continue" onclick=@FinishNegotiation onmouseover=@(() => SoundManager.PlayHover())>
				<span class="kb-key kb-key-wide">Space</span>
				<span class="radial-btn-text">CONTINUE</span>
			</div>
		</div>
	}
</div>

@code {
	// Localization helper
	private string L( string key ) => LocalizationManager.Get( key );
	private string L( string key, params object[] args ) => LocalizationManager.Get( key, args );

	// ── Screen-position numbering ──────────────────────────────────────────
	// The 4 approach diamonds form a 2x2 grid. The cap number + hotkey are
	// owned strictly by SCREEN POSITION (never by approach identity):
	//   BL = 1, TL = 2, TR = 3, BR = 4   (up the left column, down the right)
	// The foreach renders in declaration order; its posClass mapping is
	//   declIdx 0 -> radial-top    -> BL -> slot 1
	//   declIdx 1 -> radial-right  -> TR -> slot 3
	//   declIdx 2 -> radial-bottom -> BR -> slot 4
	//   declIdx 3 -> radial-left   -> TL -> slot 2
	// _indexToSlot maps declaration index -> screen slot number; _slotToIndex
	// is the inverse (indexed by slotNumber-1).
	private static readonly int[] _indexToSlot = { 1, 3, 4, 2 };
	private static readonly int[] _slotToIndex = { 0, 3, 1, 2 };

	// Screen slot number (1-4) for a declaration index. Out-of-range indices
	// (fewer than 4 options) fall back to declIdx+1 so the cap still shows.
	private int SlotNumberForIndex( int declIdx )
		=> ( declIdx >= 0 && declIdx < _indexToSlot.Length ) ? _indexToSlot[declIdx] : declIdx + 1;

	// Declaration index for a screen slot number (1-4). Returns -1 if that
	// slot isn't occupied (fewer than 4 options generated).
	private int IndexForSlotNumber( int slot )
	{
		if ( slot < 1 || slot > _slotToIndex.Length ) return -1;
		int idx = _slotToIndex[slot - 1];
		return ( negotiationOptions != null && idx < negotiationOptions.Count ) ? idx : -1;
	}

	public Monster TargetMonster { get; set; }
	public bool IsVisible { get; set; }
	public bool IsBossContract { get; set; } = false;
	public bool WasSkipped { get; set; } = false;
	public Action<bool, Monster> OnNegotiationComplete { get; set; }

	private enum NegotiationState { Selecting, Success, Failed }
	private NegotiationState currentState = NegotiationState.Selecting;

	private List<NegotiationOption> negotiationOptions;
	private NegotiationOption selectedOption;
	private int selectedOptionIndex = 0;
	private bool useMasterInk = false;

	protected override void OnAfterTreeRender(bool firstTime)
	{
		if (firstTime && TargetMonster != null)
		{
			GenerateOptions();

			// Tutorial: notify that contract negotiations are open. Initialize() is
			// only called from the legacy Tame Workshop flow; mid-battle contracts
			// instantiate this panel via @ref so the hook has to live here too.
			Beastborne.Core.TutorialManager.Instance?.NotifyEvent( "contract.opened" );
		}
	}

	public void Initialize(Monster target)
	{
		TargetMonster = target;
		currentState = NegotiationState.Selecting;
		selectedOption = null;
		selectedOptionIndex = 0;
		WasSkipped = false;
		useMasterInk = false;
		GenerateOptions();
		IsVisible = true;
		SoundManager.PlayPopup();
		StateHasChanged();

		// Tutorial: notify that contract negotiations are open.
		Beastborne.Core.TutorialManager.Instance?.NotifyEvent( "contract.opened" );
	}

	private void GenerateOptions()
	{
		if (TargetMonster == null) return;

		var species = MonsterManager.Instance?.GetSpecies(TargetMonster.SpeciesId);
		if (species == null) return;

		// Pass IsBossContract for boosted catch rates on rare bosses
		negotiationOptions = ContractGenerator.GenerateNegotiationOptions(species, TargetMonster, IsBossContract);

		// Auto-select first option
		if (negotiationOptions?.Count > 0)
		{
			selectedOption = negotiationOptions[0];
			selectedOptionIndex = 0;
		}
	}

	public void TickInput()
	{
		if (!IsVisible) return;

		if (currentState == NegotiationState.Selecting)
		{
			int count = negotiationOptions?.Count ?? 0;
			if (count == 0) { StateHasChanged(); return; }

			// SINGLE-AXIS navigation. The 4 diamonds sit in a horizontal arc,
			// NOT a 2x2 grid — left-to-right their screen slots are 1,2,3,4
			// (BL=far-left, TL=center-left, TR=center-right, BR=far-right).
			// A/Left steps to the previous slot, D/Right to the next, cycling
			// through all four with wrap at the ends. W/S alias to prev/next so
			// every key still moves the cursor. Worked in SCREEN-SLOT space:
			// convert the current declaration index to its slot, step, convert
			// back to a declaration index.
			int curSlot = SlotNumberForIndex(selectedOptionIndex);
			int step = 0;
			if (Input.Pressed("Left")  || Input.Pressed("Up"))   step = -1;
			else if (Input.Pressed("Right") || Input.Pressed("Down")) step = 1;

			if (step != 0)
			{
				// Step through occupied slots (1..count) with wrap. count is
				// almost always 4; if fewer options exist the arc is shorter.
				int targetSlot = ((curSlot - 1 + step + count) % count) + 1;
				int targetIdx = IndexForSlotNumber(targetSlot);
				if (targetIdx >= 0 && targetIdx != selectedOptionIndex)
				{
					selectedOptionIndex = targetIdx;
					selectedOption = negotiationOptions[selectedOptionIndex];
					SoundManager.PlayHover();
				}
			}

			// Number keys 1-4 — instant-select the approach occupying that
			// SCREEN slot (1=BL, 2=TL, 3=TR, 4=BR), independent of which
			// approach identity lives there.
			var slotKeys = new[] { "Slot1", "Slot2", "Slot3", "Slot4" };
			for (int s = 1; s <= slotKeys.Length; s++)
			{
				if (Input.Pressed(slotKeys[s - 1]))
				{
					int idx = IndexForSlotNumber(s);
					if (idx >= 0)
					{
						selectedOptionIndex = idx;
						selectedOption = negotiationOptions[idx];
						SoundManager.PlayHover();
					}
					break;
				}
			}

			// Tab — toggle Master Ink (only meaningful when the player has it).
			// Bound to the existing "Score" input action (Tab); the contract
			// overlay is modal and suppresses battle input, so reusing the
			// scoreboard key here is collision-free without editing Input.config.
			if (Input.Pressed("Score") && HasMasterInk())
			{
				ToggleMasterInk();
			}

			// Keyboard confirm = Space or Enter (Attack1 is mouse1, not a key).
			if (Input.Pressed("Jump") || Input.Pressed("Enter"))
			{
				AttemptNegotiation();
			}
			else if (Input.Pressed("Menu"))
			{
				SkipNegotiation();
			}
		}
		else
		{
			// Result state - any continue key (Space / Enter / Q).
			if (Input.Pressed("Jump") || Input.Pressed("Enter") || Input.Pressed("Menu"))
			{
				FinishNegotiation();
			}
		}

		StateHasChanged();
	}

	private void SelectOption(NegotiationOption option)
	{
		if (!CanAffordOption(option))
		{
			SoundManager.PlayDeny();
			return;
		}

		selectedOption = option;
		selectedOptionIndex = negotiationOptions?.IndexOf(option) ?? 0;
		SoundManager.PlaySelect();
		StateHasChanged();

		// Tutorial: notify that an approach was selected (any approach counts).
		Beastborne.Core.TutorialManager.Instance?.NotifyEvent( "contract.approach-selected" );
	}

	private bool CanAffordOption(NegotiationOption option)
	{
		// Check ink (entry fee already spent, this is the approach cost)
		int inkNeeded = option.InkCost - 1; // Subtract entry fee already spent
		if ( inkNeeded > 0 && (TamerManager.Instance?.CurrentTamer?.ContractInk ?? 0) < inkNeeded )
			return false;

		// Check gold
		if ( option.GoldCost > 0 && (TamerManager.Instance?.CurrentTamer?.Gold ?? 0) < option.GoldCost )
			return false;

		// Check boss tokens
		if ( option.BossTokenCost > 0 && (TamerManager.Instance?.CurrentTamer?.BossTokens ?? 0) < option.BossTokenCost )
			return false;

		return true;
	}

	private void AttemptNegotiation()
	{
		if (selectedOption == null || TargetMonster == null)
		{
			SoundManager.PlayDeny();
			return;
		}

		// Tutorial rig — bypass cost checks during the tutorial confirm step so
		// the player can't brick themselves out of finishing the walkthrough.
		bool tutorialFreeContract =
			Beastborne.Core.TutorialManager.Instance?.IsRiggedStep() == true
			&& Beastborne.Core.TutorialManager.Instance.IsActiveStep( "confirm-contract" );

		if (!tutorialFreeContract && !CanAffordOption(selectedOption))
		{
			SoundManager.PlayDeny();
			return;
		}

		// Check and spend contract ink based on option's cost (skipped during tutorial)
		if (!tutorialFreeContract && !TamerManager.Instance.SpendContractInk(selectedOption.InkCost))
		{
			SoundManager.PlayDeny();
			Log.Warning($"Not enough contract ink! Need {selectedOption.InkCost}");
			return;
		}

		SoundManager.PlayClick();

		// Tutorial: notify that the contract was confirmed (advances past pick-approach).
		// Tutorial-rigged success is handled below in the success branch.
		Beastborne.Core.TutorialManager.Instance?.NotifyEvent( "contract.confirmed" );

		// Master Ink guarantees capture
		bool success;
		if (useMasterInk && HasMasterInk())
		{
			// Spend gold if needed
			if (selectedOption.GoldCost > 0)
				TamerManager.Instance.SpendGold(selectedOption.GoldCost);

			success = true;

			// If it's in inventory but not yet activated, use it from inventory
			if (HasMasterInkInInventory())
			{
				ItemManager.Instance?.UseItem("boss_master_ink", null);
			}
			// Consume the active flag
			TamerManager.Instance.CurrentTamer.HasMasterInk = false;
			TamerManager.Instance.SaveToCloud();
			Log.Info("Master Ink used! Guaranteed contract negotiation.");
		}
		else if ( Beastborne.Core.TutorialManager.Instance?.IsRiggedStep() == true
		           && Beastborne.Core.TutorialManager.Instance.IsActiveStep( "confirm-contract" ) )
		{
			// Tutorial rig — first contract is a guaranteed success so the player
			// gets the satisfying "it joined your roster" beat on their first try.
			SoundManager.PlayContractAttempt();
			success = true;
			Log.Info( "[Tutorial] Rigged contract success." );
		}
		else
		{
			// Normal negotiation attempt
			SoundManager.PlayContractAttempt();
			var result = ContractGenerator.AttemptNegotiation(selectedOption);
			success = result.success;

			// Handle intimidate critical fail
			if ( result.criticalFail && TargetMonster != null )
			{
				TargetMonster.IntimidatePenalty += 0.20f;
				SoundManager.PlayIntimidateFail();
				Log.Info( $"INTIMIDATE critical fail! {TargetMonster.Nickname} enraged. Penalty now: {TargetMonster.IntimidatePenalty}" );
			}
		}

		if (success)
		{
			currentState = NegotiationState.Success;
			SoundManager.PlayMonsterCatch();

			// Create the caught monster
			var caughtMonster = MonsterManager.Instance?.CreateMonster(
				TargetMonster.SpeciesId,
				isBred: false,
				TargetMonster.Genetics
			);

			if (caughtMonster != null)
			{
				caughtMonster.Level = TargetMonster.Level;
				caughtMonster.Contract = selectedOption.Contract;
				MonsterManager.Instance?.RecalculateStats(caughtMonster);

				// Record catch (stats, leaderboard, beastiary, event)
				ExpeditionManager.Instance?.RecordMonsterCatch(caughtMonster);

				// Reveal personality in beastiary after any contract attempt
				BeastiaryManager.Instance?.DiscoverSpecies( TargetMonster.SpeciesId );

				Log.Info($"Caught {caughtMonster.Nickname} with contract!");
			}
		}
		else
		{
			currentState = NegotiationState.Failed;
			SoundManager.PlayContractFail();

			// Reveal personality after failed attempt (so 2nd try is informed)
			if ( TargetMonster != null )
				BeastiaryManager.Instance?.DiscoverSpecies( TargetMonster.SpeciesId );
		}

		StateHasChanged();
	}

	private void SkipNegotiation()
	{
		WasSkipped = true;
		SoundManager.PlayPopdown();
		IsVisible = false;
		OnNegotiationComplete?.Invoke(false, null);
	}

	private void FinishNegotiation()
	{
		SoundManager.PlayPopdown();
		bool caught = currentState == NegotiationState.Success;
		IsVisible = false;
		OnNegotiationComplete?.Invoke(caught, caught ? TargetMonster : null);
	}

	private bool HasSprite()
	{
		if (TargetMonster == null) return false;
		var species = MonsterManager.Instance?.GetSpecies(TargetMonster.SpeciesId);
		if (species == null) return false;

		if (species.AnimationFrames != null && species.AnimationFrames.Count > 0)
			return true;
		if (!string.IsNullOrEmpty(species.IconPath))
			return true;

		return false;
	}

	private string GetMonsterIcon()
	{
		if (TargetMonster == null) return "";
		var species = MonsterManager.Instance?.GetSpecies(TargetMonster.SpeciesId);
		return species?.IconPath ?? "";
	}

	private string GetRarityClass()
	{
		var species = MonsterManager.Instance?.GetSpecies(TargetMonster?.SpeciesId);
		return species != null ? $"rarity-{species.BaseRarity.ToString().ToLower()}" : "";
	}

	private string GetElementClass()
	{
		var species = MonsterManager.Instance?.GetSpecies(TargetMonster?.SpeciesId);
		return species?.Element.ToString().ToLower() ?? "";
	}

	private string GetElementName()
	{
		var species = MonsterManager.Instance?.GetSpecies(TargetMonster?.SpeciesId);
		return species?.Element.ToString() ?? "Unknown";
	}

	private float GetHPPercent()
	{
		if (TargetMonster == null || TargetMonster.MaxHP <= 0) return 0;
		return 100f * TargetMonster.CurrentHP / TargetMonster.MaxHP;
	}

	private int GetStampCount()
	{
		return TamerManager.Instance?.CurrentTamer?.ContractInk ?? 0;
	}

	private bool HasEliteInk()
	{
		return TamerManager.Instance?.CurrentTamer?.EliteInkExpiresAt > DateTime.Now;
	}

	private string GetEliteInkTimeRemaining()
	{
		var expiry = TamerManager.Instance?.CurrentTamer?.EliteInkExpiresAt ?? DateTime.MinValue;
		if (expiry <= DateTime.Now) return "";
		var remaining = expiry - DateTime.Now;
		if (remaining.TotalMinutes >= 1)
			return $"{(int)remaining.TotalMinutes}m {remaining.Seconds}s";
		return $"{remaining.Seconds}s";
	}

	private bool HasMasterInk()
	{
		// Check both the active flag AND inventory
		return TamerManager.Instance?.CurrentTamer?.HasMasterInk == true
			|| HasMasterInkInInventory();
	}

	private bool HasMasterInkInInventory()
	{
		return ItemManager.Instance?.HasItem("boss_master_ink") == true;
	}

	private void ToggleMasterInk()
	{
		useMasterInk = !useMasterInk;
		SoundManager.PlayClick();
		StateHasChanged();
	}

	private string GetResultClass()
	{
		return currentState switch
		{
			NegotiationState.Success => "result-success",
			NegotiationState.Failed => "result-failed",
			_ => ""
		};
	}

	private string GetCostText(NegotiationOption opt)
	{
		var parts = new List<string>();
		if (opt.InkCost > 0) parts.Add($"{opt.InkCost} ink");
		if (opt.GoldCost > 0) parts.Add($"{opt.GoldCost} gold");
		if (opt.BossTokenCost > 0) parts.Add($"{opt.BossTokenCost} tokens");
		if (opt.CostsPlayerHP) parts.Add("HP cost");
		if (opt.CostsBeastXP) parts.Add("XP cost");
		if (opt.CostsSkipTurns) parts.Add("Skip 2 turns");
		return parts.Count > 0 ? string.Join(" · ", parts) : "Free";
	}

	private Vector2 GetBeastScreenPosition()
	{
		if ( TargetMonster == null ) return new Vector2( 0.5f, 0.4f );
		var pos = BattleSceneController.Instance?.GetMonsterScreenPosition( TargetMonster.Id );
		if ( pos.HasValue )
			return pos.Value;
		// Fallback: center-ish of screen
		return new Vector2( 0.5f, 0.4f );
	}

	private string GetPersonalityHint()
	{
		if (TargetMonster == null) return "";
		var species = MonsterManager.Instance?.GetSpecies(TargetMonster.SpeciesId);
		return species?.PersonalityHint ?? "This creature watches you cautiously...";
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add(IsVisible);
		hash.Add(currentState);
		hash.Add(TargetMonster?.Id);
		hash.Add(selectedOption?.Name);
		hash.Add(TamerManager.Instance?.CurrentTamer?.Gold ?? 0);
		hash.Add(TamerManager.Instance?.CurrentTamer?.ContractInk ?? 0);
		hash.Add(HasEliteInk());
		hash.Add(HasMasterInk());
		hash.Add(useMasterInk);
		return hash.ToHashCode();
	}
}
