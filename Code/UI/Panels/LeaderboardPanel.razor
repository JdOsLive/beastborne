@namespace Beastborne.UI.Panels
@using System;
@using System.Linq;
@using System.Collections.Generic;
@using System.Threading.Tasks;
@using Sandbox;
@using Sandbox.Services;
@using Sandbox.UI;
@using Beastborne.Core;
@using Beastborne.Data;
@using Beastborne.Systems;
@inherits Panel

<div class="leaderboard-panel">
	<div class="leaderboard-header">
		<div class="header-left">
			<img class="panel-title-icon" src="ui/icons/tabs/leaderboards.svg" />
			<span class="leaderboard-title">@L("ui.leaderboard.title")</span>
		</div>
		@if ( FilterMode == "all" )
		{
			<div class="header-filters">
				@foreach ( var filter in new[] { ("all", "All"), ("battle", "Battle"), ("collection", "Collection"), ("social", "Social"), ("economy", "Economy") } )
				{
					<div class="sort-btn @(activeFilter == filter.Item1 ? "active" : "")"
						 onclick=@(() => SetFilter( filter.Item1 ))
						 onmouseover=@(() => SoundManager.PlayHover())>
						<span class="pill-label">@filter.Item2</span>
					</div>
				}
			</div>
		}
		<div class="header-right">
			<button class="sort-btn" onclick=@RefreshAll onmouseover=@(() => SoundManager.PlayHover())>
				<span class="pill-label">@L("ui.leaderboard.refresh")</span>
			</button>
			<button class="back-btn" onclick=@OnBackClicked>
				<img class="back-icon" src="ui/icons/buttons/back.svg" />
			</button>
		</div>
	</div>

	<div class="leaderboard-scroll">
		@if ( isLoading )
		{
			<div class="loading-state">
				<div class="loading-spinner"></div>
				<span>@L("ui.leaderboard.loading")</span>
			</div>
		}
		else
		{
			@foreach ( var cat in GetVisibleCategories() )
			{
				var catEntries = GetEntries( cat.Key );
				var rank = GetPlayerRank( cat.Key );
				var playerValue = GetPlayerValue( cat.Key );
				var isExpanded = expanded.ContainsKey( cat.Key ) && expanded[cat.Key];
				var displayEntries = isExpanded ? catEntries.Take( 20 ).ToList() : catEntries.Take( 10 ).ToList();
				var playerName = TamerManager.Instance?.CurrentTamer?.Name;
				var playerInList = displayEntries.Any( e => e.Name == playerName );
				var playerEntry = catEntries.FirstOrDefault( e => e.Name == playerName );

				<div class="lb-section" style="border-color: @ColorWithAlpha( cat.Color, 0.2 )">
					<div class="lb-accent-line" style="background-color: @cat.Color"></div>
					<div class="lb-section-header">
						<div class="lb-section-left">
							<img class="lb-section-icon" src="ui/icons/@cat.Icon" />
							<span class="lb-section-name">@cat.Label</span>
						</div>
						<div class="lb-section-right">
							<span class="lb-your-value" style="color: @cat.Color">@FormatValue( playerValue, cat.Key )</span>
							@if ( cat.Key == "arena-score" )
							{
								<span class="lb-section-tier" style="color: @GetPlayerRankColor()">@GetPlayerRankTitle()</span>
							}
							<div class="lb-rank-pill" style="background-color: @ColorWithAlpha( cat.Color, 0.2 ); border-color: @ColorWithAlpha( cat.Color, 0.4 )">
								<span class="lb-rank-text">Rank</span>
								<span class="lb-rank-number" style="color: @cat.Color">@rank</span>
							</div>
						</div>
					</div>

					@if ( catEntries.Count == 0 )
					{
						<div class="lb-empty">@L("ui.leaderboard.no_entries")</div>
					}
					else
					{
						<div class="lb-entries">
							@foreach ( var entry in displayEntries )
							{
								<div class="lb-entry @(entry.Rank == 1 ? "top-1" : "") @(entry.Rank == 2 ? "top-2" : "") @(entry.Rank == 3 ? "top-3" : "") @(IsPlayerEntry( entry ) ? "player" : "")">
									<div class="lb-entry-rank">
										@if ( entry.Rank == 1 )
										{
											<img class="rank-trophy" src="ui/icons/ranking/gold.svg" />
										}
										else if ( entry.Rank == 2 )
										{
											<img class="rank-trophy" src="ui/icons/ranking/silver.svg" />
										}
										else if ( entry.Rank == 3 )
										{
											<img class="rank-trophy" src="ui/icons/ranking/bronze.svg" />
										}
										else
										{
											<span class="rank-number">#@entry.Rank</span>
										}
									</div>
									@if ( entry.SteamId > 0 )
									{
										<img class="lb-avatar" src="avatar:@entry.SteamId" />
									}
									<div class="lb-entry-name">@entry.Name</div>
									@if ( cat.Key == "arena-score" && !string.IsNullOrEmpty( entry.RankTitle ) )
									{
										<div class="lb-entry-tier" style="color: @CompetitiveManager.GetRankColor( entry.RankTitle )">
											@entry.RankTitle
										</div>
									}
									<div class="lb-entry-score" style="color: @cat.Color">@FormatValue( entry.Score, cat.Key )</div>
								</div>
							}
						</div>

						@if ( !playerInList && playerEntry != null )
						{
							<div class="lb-entry lb-player-pinned player">
								<div class="lb-entry-rank">
									<span class="rank-number">#@playerEntry.Rank</span>
								</div>
								@if ( playerEntry.SteamId > 0 )
								{
									<img class="lb-avatar" src="avatar:@playerEntry.SteamId" />
								}
								<div class="lb-entry-name">@playerEntry.Name</div>
								<div class="lb-entry-score" style="color: @cat.Color">@FormatValue( playerEntry.Score, cat.Key )</div>
							</div>
						}

						@if ( catEntries.Count > 10 )
						{
							<button class="lb-expand-btn" onclick=@(() => ToggleExpand( cat.Key ))>
								@(isExpanded ? L("ui.leaderboard.show_less") : L("ui.leaderboard.show_top_20"))
							</button>
						}
					}
				</div>
			}
		}
	</div>
</div>

@code {
	// Localization helper
	private string L( string key ) => LocalizationManager.Get( key );
	private string L( string key, params object[] args ) => LocalizationManager.Get( key, args );

	public Action OnBack { get; set; }
	public string FilterMode { get; set; } = "all"; // "all", "arena", or "guild"

	private Dictionary<string, List<LeaderboardEntry>> allEntries = new();
	private Dictionary<string, int> playerRanks = new();
	private Dictionary<string, int> playerBoardValues = new();
	private Dictionary<string, bool> expanded = new();
	private bool isLoading = true;
	private string activeFilter = "all";

	private void SetFilter( string filter )
	{
		SoundManager.PlayClick();
		activeFilter = filter;
	}

	private record CategoryInfo( string Key, string LeaderboardName, string Label, string Icon, string Unit, string Color, string Group );

	private static readonly CategoryInfo[] Categories = new[]
	{
		new CategoryInfo( "arena-score", "arena-score-s0", "Arena Rating", "tabs/arena.svg", "pts", "#fbbf24", "Battle" ),
		new CategoryInfo( "arena-wins", "arena-wins-total", "Arena Wins", "sort/trophy.svg", "wins", "#facc15", "Battle" ),
		new CategoryInfo( "guild-ranking", "guild-rp-s0", "Guild RP", "tabs/guild.svg", "RP", "#c084fc", "Social" ),
		new CategoryInfo( "monsters-caught", "monsters-caught", "Contracted", "sort/handshake.svg", "", "#60a5fa", "Collection" ),
		new CategoryInfo( "monsters-bred", "monsters-bred", "Fused", "tabs/fusion.svg", "", "#f472b6", "Collection" ),
		new CategoryInfo( "monsters-evolved", "monsters-evolved", "Evolved", "sort/evolve.svg", "", "#c084fc", "Collection" ),
		new CategoryInfo( "battles-won", "battles-won", "Battles Won", "sort/shield-check.svg", "", "#f87171", "Battle" ),
		new CategoryInfo( "total-damage", "total-damage", "Damage", "sort/burst.svg", "dmg", "#fb923c", "Battle" ),
		new CategoryInfo( "total-knockouts", "total-knockouts", "Knockouts", "sort/skull.svg", "KOs", "#cbd5e1", "Battle" ),
		new CategoryInfo( "total-gold", "total-gold-v2", "Gold Earned", "currency/money.svg", "", "#fcd34d", "Economy" ),
		new CategoryInfo( "expeditions-completed", "expeditions-completed", "Expeditions", "expedition.svg", "", "#5eead4", "Social" ),
		new CategoryInfo( "total-playtime", "total-playtime-v2", "Playtime", "sort/clock.svg", "", "#a78bfa", "Economy" )
	};

	private CategoryInfo[] GetVisibleCategories()
	{
		if ( FilterMode == "arena" )
			return Categories.Where( c => c.Key == "arena-score" || c.Key == "arena-wins" ).ToArray();
		if ( FilterMode == "guild" )
			return Categories.Where( c => c.Key == "guild-ranking" ).ToArray();
		if ( activeFilter == "all" )
			return Categories;
		return Categories.Where( c => c.Group.ToLower() == activeFilter ).ToArray();
	}

	protected override async void OnAfterTreeRender( bool firstTime )
	{
		if ( firstTime )
		{
			await LoadAllLeaderboards();
		}
	}

	private async Task LoadAllLeaderboards()
	{
		isLoading = true;
		allEntries = new();
		playerRanks = new();

		var tasks = Categories.Select( async cat =>
		{
			try
			{
				var board = Leaderboards.GetFromStat( "publicsquare.beastborne", cat.LeaderboardName );
				board.MaxEntries = 100;
				await board.Refresh();

				var entries = board.Entries.Select( ( e, index ) => new LeaderboardEntry
				{
					Rank = (int)e.Rank,
					Name = e.DisplayName,
					Score = (int)e.Value,
					SteamId = 0,
					RankTitle = cat.Key == "arena-score"
						? CompetitiveManager.GetRankFromPoints( (int)e.Value )
						: ""
				} ).ToList();

				var myName = Connection.Local?.DisplayName;
				var myEntry = entries.FirstOrDefault( x => x.Name == myName );
				var rank = myEntry != null ? myEntry.Rank : (entries.Count + 1);
				var boardValue = myEntry?.Score ?? 0;

				lock ( allEntries )
				{
					allEntries[cat.Key] = entries;
					playerRanks[cat.Key] = rank;
					playerBoardValues[cat.Key] = boardValue;
				}

				Log.Info( $"Fetched {entries.Count} entries for '{cat.LeaderboardName}'" );
			}
			catch ( Exception e )
			{
				Log.Warning( $"Failed to fetch '{cat.LeaderboardName}': {e.Message}" );
				lock ( allEntries )
				{
					allEntries[cat.Key] = new();
					playerRanks[cat.Key] = 0;
				}
			}
		} );

		await Task.WhenAll( tasks );
		isLoading = false;
		StateHasChanged();
	}

	private async void RefreshAll()
	{
		SoundManager.PlayClick();
		await LoadAllLeaderboards();
	}

	private void OnBackClicked()
	{
		SoundManager.PlayBack();
		OnBack?.Invoke();
	}

	private void ToggleExpand( string key )
	{
		SoundManager.PlayClick();
		if ( expanded.ContainsKey( key ) )
			expanded[key] = !expanded[key];
		else
			expanded[key] = true;
	}

	private List<LeaderboardEntry> GetEntries( string key )
	{
		return allEntries.ContainsKey( key ) ? allEntries[key] : new();
	}

	private int GetPlayerRank( string key )
	{
		return playerRanks.ContainsKey( key ) ? playerRanks[key] : 0;
	}

	private int GetPlayerValue( string key )
	{
		var tamer = TamerManager.Instance?.CurrentTamer;
		if ( tamer == null ) return 0;

		var localValue = key switch
		{
			"arena-score" => tamer.ArenaPoints,
			"arena-wins" => tamer.ArenaWins,
			"guild-ranking" => GuildManager.Instance?.TotalRP ?? 0,
			"monsters-caught" => tamer.TotalMonstersCaught,
			"monsters-bred" => tamer.TotalMonstersBred,
			"monsters-evolved" => tamer.TotalMonstersEvolved,
			"battles-won" => tamer.TotalBattlesWon,
			"total-damage" => tamer.TotalDamageDealt,
			"total-knockouts" => tamer.TotalKnockouts,
			"total-gold" => tamer.TotalGoldEarned,
			"expeditions-completed" => tamer.TotalExpeditionsCompleted,
			"total-playtime" => (int)tamer.TotalPlayTime.TotalMinutes,
			_ => 0
		};

		// Use the higher of local tamer value or leaderboard API value to stay consistent with board entries
		var boardValue = playerBoardValues.ContainsKey( key ) ? playerBoardValues[key] : 0;
		return Math.Max( 0, Math.Max( localValue, boardValue ) );
	}

	private string FormatValue( int value, string category )
	{
		// Clamp to sane maximums for display
		value = ClampForDisplay( value, category );

		return category switch
		{
			"arena-score" => $"{value:N0} pts",
			"arena-wins" => $"{value:N0}",
			"guild-ranking" => $"{value:N0} RP",
			"monsters-caught" => $"{value:N0}",
			"monsters-bred" => $"{value:N0}",
			"monsters-evolved" => $"{value:N0}",
			"battles-won" => $"{value:N0}",
			"total-damage" => FormatLargeNumber( value ),
			"total-knockouts" => $"{value:N0}",
			"total-gold" => FormatLargeNumber( value * 1000 ),
			"expeditions-completed" => $"{value:N0}",
			"total-playtime" => FormatPlaytime( value ),
			_ => $"{value:N0}"
		};
	}

	/// <summary>
	/// Clamp leaderboard values to reasonable maximums to filter out corrupted/cheated entries.
	/// </summary>
	private int ClampForDisplay( int value, string category )
	{
		if ( value < 0 ) return 0;

		return category switch
		{
			"total-playtime" => Math.Min( value, 90 * 24 * 60 ), // 90 days in minutes
			_ => value
		};
	}

	private string FormatLargeNumber( int value )
	{
		if ( value >= 1000000 ) return $"{value / 1000000f:F1}M";
		if ( value >= 1000 ) return $"{value / 1000f:F1}K";
		return $"{value:N0}";
	}

	private string FormatPlaytime( int minutes )
	{
		if ( minutes < 60 ) return $"{minutes}m";
		int hours = minutes / 60;
		int mins = minutes % 60;
		if ( hours < 24 ) return $"{hours}h {mins}m";
		int days = hours / 24;
		hours = hours % 24;
		return $"{days}d {hours}h";
	}

	private string ColorWithAlpha( string hex, double alpha )
	{
		if ( string.IsNullOrEmpty( hex ) || hex.Length < 7 ) return $"rgba(139, 92, 246, {alpha})";
		int r = Convert.ToInt32( hex.Substring( 1, 2 ), 16 );
		int g = Convert.ToInt32( hex.Substring( 3, 2 ), 16 );
		int b = Convert.ToInt32( hex.Substring( 5, 2 ), 16 );
		return $"rgba({r}, {g}, {b}, {alpha})";
	}

	private string GetPlayerRankTitle()
	{
		return CompetitiveManager.GetRankFromPoints( TamerManager.Instance?.CurrentTamer?.ArenaPoints ?? 0 );
	}

	private string GetPlayerRankColor()
	{
		return CompetitiveManager.GetRankColor( GetPlayerRankTitle() );
	}

	private bool IsPlayerEntry( LeaderboardEntry entry )
	{
		var playerName = TamerManager.Instance?.CurrentTamer?.Name;
		return entry.Name == playerName;
	}
}
