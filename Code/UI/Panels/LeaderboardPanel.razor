@namespace Beastborne.UI.Panels
@using System;
@using System.Linq;
@using System.Collections.Generic;
@using System.Threading.Tasks;
@using Sandbox;
@using Sandbox.Services;
@using Sandbox.UI;
@using Beastborne.Core;
@using Beastborne.Data;
@using Beastborne.Systems;
@using Beastborne.UI.Components;
@using Beastborne.UI.Primitives;
@inherits Panel

<div class="leaderboard-panel">

	@* Living background: the online glyph drifting at the house angle —
	   the leaderboards live under the Online hub, so they wear the hub's
	   glyph. The hub's opaque z-500 header covers this layer's top
	   overhang; the tiles' baked dark base covers the hub's own drift
	   beneath. *@
	<BbIconScroll Icon="online" />

	@* Top action bar — refresh only. The 4 group panels themselves act as the
	   visual "tabs" so the user doesn't need filter pills to navigate. *@
	@if ( FilterMode == "all" )
	{
		<div class="lb-top-bar">
			<div class="lb-keys">
				<div class="lb-cap"><span>A</span></div>
				<div class="lb-cap"><span>D</span></div>
				<span class="lb-keys-label">GROUPS</span>
				<div class="lb-cap"><span>W</span></div>
				<div class="lb-cap"><span>S</span></div>
				<span class="lb-keys-label">CARDS</span>
				<div class="lb-cap lb-cap-wide"><span>SPACE</span></div>
				<span class="lb-keys-label">EXPAND</span>
			</div>
			<div class="lb-top-bar-spacer"></div>
			<div class="lb-refresh-pill"
				 onmouseover=@(() => SoundManager.PlayHover())
				 onclick=@RefreshAll>
				<iconify icon="lucide:refresh-cw" Size=@(13) Color="#9ecdf5" />
				<span class="lb-refresh-label">@L("ui.leaderboard.refresh")</span>
				<div class="lb-cap"><span>F</span></div>
			</div>
		</div>
	}

	<div class="leaderboard-scroll" @ref="lbScroll">
		@if ( isLoading )
		{
			<div class="loading-state">
				<div class="loading-spinner"></div>
				<span>@L("ui.leaderboard.loading")</span>
			</div>
		}
		else
		{
			@{
				var visibleCats = GetVisibleCategories();
				var current = GroupMeta[currentGroupIndex];
				var currentCats = visibleCats.Where( c => c.Group == current.Name ).ToArray();
			}

			@* 2.5D Cover-Flow-style wheel: arrows on the outer edges, all 4 group
			   cards rendered at once. Each card's position class is derived from
			   its offset from currentGroupIndex (-1 = left preview, 0 = center,
			   +1 = right preview, ±2 = hidden behind). Clicking center = no-op,
			   clicking a side preview jumps to that group, arrows do prev/next. *@
			<div class="lb-carousel-nav">
				<div class="lb-arrow lb-arrow-left"
					 onmouseover=@(() => SoundManager.PlayHover())
					 onclick=@PrevGroup>
					<iconify icon="lucide:chevron-left" Size=@(34) Color="#9ecdf5" />
				</div>

				<div class="lb-wheel">
					@for ( int i = 0; i < GroupMeta.Length; i++ )
					{
						var idx = i;
						var grp = GroupMeta[i];
						var groupCatsForWheel = visibleCats.Where( c => c.Group == grp.Name ).ToArray();
						var offset = ((i - currentGroupIndex + GroupMeta.Length) % GroupMeta.Length);
						if ( offset > GroupMeta.Length / 2 ) offset -= GroupMeta.Length;
						var posClass = offset == 0 ? "pos-center" : offset == -1 ? "pos-left" : offset == 1 ? "pos-right" : "pos-back";

						<div class="lb-wheel-item @posClass" style="border-color: @grp.Color"
							 onmouseover=@(() => { if ( posClass != "pos-center" && posClass != "pos-back" ) SoundManager.PlayHover(); })
							 onclick=@(() => SetGroup( idx ))>
							<div class="lb-wheel-icon-wrap" style="border-color: @grp.Color">
								<iconify icon="@grp.Icon" Size=@(24) Color="@grp.Color" />
							</div>
							<span class="lb-wheel-title">@grp.Name.ToUpper()</span>
							<div class="lb-wheel-count"><span>@groupCatsForWheel.Length</span></div>
						</div>
					}
				</div>

				<div class="lb-arrow lb-arrow-right"
					 onmouseover=@(() => SoundManager.PlayHover())
					 onclick=@NextGroup>
					<iconify icon="lucide:chevron-right" Size=@(34) Color="#9ecdf5" />
				</div>
			</div>

			<div class="lb-group-cards @spinClass">
			@for ( int ci = 0; ci < currentCats.Length; ci++ )
			{
				var cat = currentCats[ci];
				var catEntries = GetEntries( cat.Key );
				var rank = GetPlayerRank( cat.Key );
				var playerValue = GetPlayerValue( cat.Key );
				var isExpanded = expanded.ContainsKey( cat.Key ) && expanded[cat.Key];
				var displayEntries = isExpanded ? catEntries.Take( 20 ).ToList() : catEntries.Take( 10 ).ToList();
				var playerName = TamerManager.Instance?.CurrentTamer?.Name;
				var playerInList = displayEntries.Any( e => e.Name == playerName );
				var playerEntry = catEntries.FirstOrDefault( e => e.Name == playerName );

				<div class="lb-section cat-@cat.Key @(_kbActive && ci == _kbCardIndex ? "lb-kb-selected" : "")">
					<div class="lb-section-header">
						<div class="lb-section-left">
							<div class="lb-section-icon-wrap" style="border-color: @cat.Color">
								<iconify icon="@cat.Icon" Size=@(18) Color="@cat.Color" />
							</div>
							<span class="lb-section-name">@cat.Label</span>
							<div class="lb-section-tag"><span>@cat.Group.ToUpper()</span></div>
						</div>
						<div class="lb-section-right">
							<span class="lb-your-value" style="color: @cat.Color">@FormatValue( playerValue, cat.Key )</span>
							<div class="lb-rank-pill"><span class="lb-rank-text">@($"#{rank}")</span></div>
						</div>
					</div>

					@if ( catEntries.Count == 0 )
					{
						<EmptyState Icon="lucide:trophy"
									Title=@L("ui.leaderboard.no_entries")
									Body="Be the first to set a record."
									Size="inline" />
					}
					else
					{
						<div class="lb-entries">
							@{ var entryIndex = 0; }
							@foreach ( var entry in displayEntries )
							{
								// Rank diamond (45° = the house identity shape): gold /
								// silver-violet / bronze-tan for the podium, dark slab
								// for the field. Number counter-rotates inside.
								var rowClass = "lb-entry"
									+ ( entry.Rank <= 3 ? $" top-{entry.Rank}" : "" )
									+ ( IsPlayerEntry( entry ) ? " player" : "" );
								var rdClass = entry.Rank <= 3 ? $"rd-{entry.Rank}" : "rd-n";
								<div class="@rowClass">
									@if ( IsPlayerEntry( entry ) )
									{
										<div class="lb-entry-rail"></div>
									}
									<div class="lb-rank-diamond @rdClass">
										<span class="rd-num">@entry.Rank</span>
									</div>
									@* Avatar render disabled for launch — SteamId always 0 until we verify the s&box leaderboard entry's identifier field name. *@
									@if ( entry.SteamId > 0 )
									{
										<img class="lb-avatar" src="avatar:@entry.SteamId" />
									}
									<span class="lb-entry-name">@entry.Name</span>
									@if ( IsPlayerEntry( entry ) )
									{
										<div class="lb-you-badge"><span>YOU</span></div>
									}
									<span class="lb-entry-score" style="color: @cat.Color">@FormatValue( entry.Score, cat.Key )</span>
								</div>
								@if ( entry.Rank == 3 && displayEntries.Count > 3 )
								{
									<span class="lb-divider-line">&nbsp;</span>
								}
								entryIndex++;
							}
						</div>

						@if ( !playerInList && playerEntry != null )
						{
							<div class="lb-entry lb-player-pinned player">
								<div class="lb-entry-rail"></div>
								<div class="lb-rank-diamond rd-n">
									<span class="rd-num">@playerEntry.Rank</span>
								</div>
								@if ( playerEntry.SteamId > 0 )
								{
									<img class="lb-avatar" src="avatar:@playerEntry.SteamId" />
								}
								<span class="lb-entry-name">@playerEntry.Name</span>
								<div class="lb-you-badge"><span>YOU</span></div>
								<span class="lb-entry-score" style="color: @cat.Color">@FormatValue( playerEntry.Score, cat.Key )</span>
							</div>
						}

						@if ( catEntries.Count > 10 )
						{
							<button class="lb-expand-btn" onclick=@(() => ToggleExpand( cat.Key ))>
								<span>@(isExpanded ? L("ui.leaderboard.show_less") : L("ui.leaderboard.show_top_20"))</span>
							</button>
						}
					}
				</div>
			}
			</div>
		}
	</div>
</div>

@code {
	// Localization helper
	private string L( string key ) => LocalizationManager.Get( key );
	private string L( string key, params object[] args ) => LocalizationManager.Get( key, args );

	public Action OnBack { get; set; }
	public string FilterMode { get; set; } = "all"; // "all", "arena", or "guild"

	private Dictionary<string, List<LeaderboardEntry>> allEntries = new();
	private Dictionary<string, int> playerRanks = new();
	// Long-typed because cumulative stats (gold, damage, playtime) can exceed
	// int.MaxValue and would silently wrap negative when displayed.
	private Dictionary<string, long> playerBoardValues = new();
	private Dictionary<string, bool> expanded = new();
	private bool isLoading = true;
	private string activeFilter = "all";
	private string hoveredFilter = null;

	// Paper-Mario-style carousel state. Index into `GroupMeta` for the active
	// category group (Battle / Collection / Social / Economy). Arrow buttons
	// + dot indicators rotate through it. `spinClass` cycles through three
	// phases per swap: spin-out-X → warp-from-Y (instant teleport, transition
	// disabled) → "" (transition back). This gives a proper carousel feel
	// where new content arrives from the opposite side of where old content
	// went out, instead of bouncing back from the same side.
	private int currentGroupIndex = 0;
	private string spinClass = "";
	private bool isSpinning = false;

	private record GroupInfo( string Name, string Icon, string Color );

	private static readonly GroupInfo[] GroupMeta = new[]
	{
		new GroupInfo( "Battle", "lucide:swords", "#f87171" ),
		new GroupInfo( "Collection", "lucide:layers", "#60a5fa" ),
		new GroupInfo( "Social", "lucide:users", "#c084fc" ),
		new GroupInfo( "Economy", "lucide:coins", "#fcd34d" )
	};

	private async void PrevGroup()
	{
		if ( isSpinning ) return;
		SoundManager.PlayClick();
		// Going BACKWARDS: old content slides RIGHT off, new content arrives from LEFT.
		await SpinTo( (currentGroupIndex - 1 + GroupMeta.Length) % GroupMeta.Length, exitTo: "right", enterFrom: "left" );
	}

	private async void NextGroup()
	{
		if ( isSpinning ) return;
		SoundManager.PlayClick();
		// Going FORWARD: old content slides LEFT off, new content arrives from RIGHT.
		await SpinTo( (currentGroupIndex + 1) % GroupMeta.Length, exitTo: "left", enterFrom: "right" );
	}

	private async void SetGroup( int idx )
	{
		if ( idx < 0 || idx >= GroupMeta.Length ) return;
		if ( idx == currentGroupIndex ) return;
		if ( isSpinning ) return;
		SoundManager.PlaySelect();
		// Direction follows index distance — clicking a dot to the right exits left, etc.
		if ( idx > currentGroupIndex )
			await SpinTo( idx, exitTo: "left", enterFrom: "right" );
		else
			await SpinTo( idx, exitTo: "right", enterFrom: "left" );
	}

	// Three-phase swap:
	//   Phase 1: cards fade/slide out via spin-out-{exitTo}; wheel rotates
	//            immediately because currentGroupIndex changes here too (cards
	//            content changing mid-fade is invisible — they're at opacity 0
	//            from the spin-out class — so the swap is hidden).
	//   Phase 2: warp-from-{enterFrom} teleports cards to the opposite side
	//            with transition disabled, so the next class change animates
	//            from there instead of reverse-sliding.
	//   Phase 3: clear class — cards transition back to centre, new content
	//            visible. Wheel rotation finishes around the same time.
	private async Task SpinTo( int targetIdx, string exitTo, string enterFrom )
	{
		isSpinning = true;

		spinClass = $"spin-out-{exitTo}";
		currentGroupIndex = targetIdx;
		// New group → reset the card cursor to the top of the new card list.
		_kbCardIndex = 0;
		await System.Threading.Tasks.Task.Delay( 180 );

		spinClass = $"warp-from-{enterFrom}";
		await System.Threading.Tasks.Task.Delay( 30 );

		spinClass = "";
		await System.Threading.Tasks.Task.Delay( 220 );

		isSpinning = false;
	}

	// Required so the carousel rotation actually re-renders. s&box's Panel
	// framework only diffs when BuildHash changes — without this, clicking the
	// arrow flips currentGroupIndex but the visible group can lag behind.
	protected override int BuildHash()
	{
		return System.HashCode.Combine(
			currentGroupIndex,
			spinClass,
			isLoading,
			activeFilter,
			allEntries.Count,
			expanded.Count,
			FilterMode,
			System.HashCode.Combine( _kbCardIndex, _kbActive )
		);
	}

	private record CategoryInfo( string Key, string LeaderboardName, string Label, string Icon, string Unit, string Color, string Group );

	private static readonly CategoryInfo[] Categories = new[]
	{
		new CategoryInfo( "guild-ranking", "guild-rp-launch", "Guild RP", "lucide:flag", "RP", "#c084fc", "Social" ),
		new CategoryInfo( "monsters-caught", "monsters-caught-launch", "Contracted", "lucide:handshake", "", "#60a5fa", "Collection" ),
		new CategoryInfo( "monsters-bred", "monsters-bred-launch", "Fused", "lucide:atom", "", "#f472b6", "Collection" ),
		new CategoryInfo( "monsters-evolved", "monsters-evolved-launch", "Evolved", "lucide:sparkles", "", "#c084fc", "Collection" ),
		new CategoryInfo( "battles-won", "battles-won-launch", "Battles Won", "lucide:shield-check", "", "#f87171", "Battle" ),
		new CategoryInfo( "total-damage", "total-damage-launch", "Damage", "lucide:flame", "dmg", "#fb923c", "Battle" ),
		new CategoryInfo( "total-knockouts", "total-knockouts-launch", "Knockouts", "lucide:skull", "KOs", "#cbd5e1", "Battle" ),
		new CategoryInfo( "total-gold", "total-gold-launch", "Gold Earned", "lucide:coins", "", "#fcd34d", "Economy" ),
		new CategoryInfo( "expeditions-completed", "expeditions-completed-launch", "Expeditions", "lucide:compass", "", "#5eead4", "Social" ),
		new CategoryInfo( "total-playtime", "total-playtime-launch", "Playtime", "lucide:clock", "", "#a78bfa", "Economy" )
	};

	private CategoryInfo[] GetVisibleCategories()
	{
		// Honors GuildManager.UiEnabled — guild leaderboards are hidden during the
		// beta launch alongside the rest of the guild UI surface.
		var pool = Categories
			.Where( c => GuildManager.UiEnabled || c.Key != "guild-ranking" )
			.ToArray();

		if ( FilterMode == "arena" )
			return Array.Empty<CategoryInfo>();
		if ( FilterMode == "guild" )
			return pool.Where( c => c.Key == "guild-ranking" ).ToArray();
		if ( activeFilter == "all" )
			return pool;
		return pool.Where( c => c.Group.ToLower() == activeFilter ).ToArray();
	}

	protected override async void OnAfterTreeRender( bool firstTime )
	{
		if ( firstTime )
		{
			await LoadAllLeaderboards();
		}
	}

	private async Task LoadAllLeaderboards()
	{
		isLoading = true;
		allEntries = new();
		playerRanks = new();

		var tasks = Categories.Select( async cat =>
		{
			try
			{
				var board = Leaderboards.GetFromStat( "publicsquare.beastborne", cat.LeaderboardName );
				// Explicit aggregation: every Beastborne stat tracked here is a
				// monotonically-increasing cumulative counter (battles won, damage,
				// monsters caught, etc) — we want the HIGHEST value the player ever
				// submitted, not a sum or average. Without this, s&box's default
				// aggregation can produce wildly inflated numbers (this was the v1.0.1
				// "hyper-inflated leaderboards" bug). Mirrors the explicit-config
				// pattern from the Flow project's LeaderboardManager.
				board.SetAggregationMax();
				board.MaxEntries = 100;
				await board.Refresh();

				var entries = board.Entries.Select( ( e, index ) => new LeaderboardEntry
				{
					Rank = (int)e.Rank,
					Name = e.DisplayName,
					// e.Value is double in s&box; cast to long for our integer-only stats.
					Score = (long)e.Value,
					// TODO post-launch: avatar resolution needs the player's Steam ID. The
					// Sandbox.Services leaderboard entry probably exposes it (e.Identifier in
					// historical APIs), but verify the field name against the current s&box
					// build before wiring up — building blind here risks breaking launch.
					SteamId = 0,
					RankTitle = ""
				} ).ToList();

				var myName = Connection.Local?.DisplayName;
				var myEntry = entries.FirstOrDefault( x => x.Name == myName );
				var rank = myEntry != null ? myEntry.Rank : (entries.Count + 1);
				var boardValue = myEntry?.Score ?? 0L;

				lock ( allEntries )
				{
					allEntries[cat.Key] = entries;
					playerRanks[cat.Key] = rank;
					playerBoardValues[cat.Key] = boardValue;
				}

				Log.Info( $"Fetched {entries.Count} entries for '{cat.LeaderboardName}'" );
			}
			catch ( Exception e )
			{
				Log.Warning( $"Failed to fetch '{cat.LeaderboardName}': {e.Message}" );
				lock ( allEntries )
				{
					allEntries[cat.Key] = new();
					playerRanks[cat.Key] = 0;
				}
			}
		} );

		await Task.WhenAll( tasks );
		isLoading = false;
		StateHasChanged();
	}

	public async void RefreshAll()
	{
		SoundManager.PlayClick();
		await LoadAllLeaderboards();
	}

	// =========================================================================
	// Keyboard navigation — called by OnlineHubPanel while the Leaderboards
	// section is active. A/D rotate the category-group carousel, W/S move a
	// cursor over the current group's category cards (scroll-follows), Space
	// toggles the focused card's top-10/top-20 expand, F refreshes. ( , / . are
	// the hub's section-cycle keys and never reach here.)
	// =========================================================================
	private int _kbCardIndex = 0;
	// The card cursor only renders once a nav key has been pressed, so it never
	// fights a mouse hover on a fresh open.
	private bool _kbActive = false;
	private Panel lbScroll;

	public void TickInput()
	{
		if ( isLoading ) return;

		if ( Input.Pressed( "Flashlight" ) ) { RefreshAll(); return; }

		// A / D — rotate the category-group carousel.
		if ( Input.Pressed( "Left" ) ) { _kbActive = true; PrevGroup(); return; }
		if ( Input.Pressed( "Right" ) ) { _kbActive = true; NextGroup(); return; }

		var cats = GetCurrentGroupCats();
		if ( cats.Length == 0 ) return;
		_kbCardIndex = Math.Clamp( _kbCardIndex, 0, cats.Length - 1 );

		// W / S — move the card cursor, scroll-following.
		if ( Input.Pressed( "Up" ) )
		{
			_kbActive = true;
			if ( _kbCardIndex > 0 ) { _kbCardIndex--; SoundManager.PlayHover(); ScrollCardIntoView(); }
			return;
		}
		if ( Input.Pressed( "Down" ) )
		{
			_kbActive = true;
			if ( _kbCardIndex < cats.Length - 1 ) { _kbCardIndex++; SoundManager.PlayHover(); ScrollCardIntoView(); }
			return;
		}

		// Space / Enter — toggle the focused card's expand (only cards with
		// more than 10 entries carry an expand control).
		if ( Input.Pressed( "Jump" ) || Input.Pressed( "Enter" ) )
		{
			var cat = cats[_kbCardIndex];
			if ( GetEntries( cat.Key ).Count > 10 )
				ToggleExpand( cat.Key );
			else
				SoundManager.PlayDeny();
		}
	}

	// The category cards visible for the active carousel group — MUST match the
	// render's `currentCats` exactly so _kbCardIndex lines up with the cards.
	private CategoryInfo[] GetCurrentGroupCats()
	{
		var current = GroupMeta[currentGroupIndex];
		return GetVisibleCategories().Where( c => c.Group == current.Name ).ToArray();
	}

	private void ScrollCardIntoView()
	{
		if ( lbScroll == null ) return;
		var sections = new List<Panel>();
		CollectByClass( lbScroll, "lb-section", sections );
		if ( _kbCardIndex >= 0 && _kbCardIndex < sections.Count )
			UiGridScroll.IntoView( lbScroll, sections[_kbCardIndex] );
	}

	private void CollectByClass( Panel root, string cls, List<Panel> outList )
	{
		foreach ( var c in root.Children )
		{
			if ( c.HasClass( cls ) ) outList.Add( c );
			else CollectByClass( c, cls, outList );
		}
	}

	private void OnBackClicked()
	{
		SoundManager.PlayBack();
		OnBack?.Invoke();
	}

	private void ToggleExpand( string key )
	{
		SoundManager.PlayClick();
		if ( expanded.ContainsKey( key ) )
			expanded[key] = !expanded[key];
		else
			expanded[key] = true;
	}

	private List<LeaderboardEntry> GetEntries( string key )
	{
		return allEntries.ContainsKey( key ) ? allEntries[key] : new();
	}

	private int GetPlayerRank( string key )
	{
		return playerRanks.ContainsKey( key ) ? playerRanks[key] : 0;
	}

	private long GetPlayerValue( string key )
	{
		var tamer = TamerManager.Instance?.CurrentTamer;
		if ( tamer == null ) return 0L;

		long localValue = key switch
		{
			"guild-ranking" => GuildManager.Instance?.TotalRP ?? 0,
			"monsters-caught" => tamer.TotalMonstersCaught,
			"monsters-bred" => tamer.TotalMonstersBred,
			"monsters-evolved" => tamer.TotalMonstersEvolved,
			"battles-won" => tamer.TotalBattlesWon,
			"total-damage" => tamer.TotalDamageDealt,
			"total-knockouts" => tamer.TotalKnockouts,
			"total-gold" => tamer.TotalGoldEarned,
			"expeditions-completed" => tamer.TotalExpeditionsCompleted,
			"total-playtime" => (long)tamer.TotalPlayTime.TotalMinutes,
			_ => 0L
		};

		// Use the higher of local tamer value or leaderboard API value to stay consistent with board entries
		var boardValue = playerBoardValues.ContainsKey( key ) ? playerBoardValues[key] : 0L;
		return Math.Max( 0L, Math.Max( localValue, boardValue ) );
	}

	private string FormatValue( long value, string category )
	{
		// Clamp to sane maximums for display
		value = ClampForDisplay( value, category );

		return category switch
		{
			"guild-ranking" => $"{value:N0} RP",
			"monsters-caught-launch" => $"{value:N0}",
			"monsters-bred-launch" => $"{value:N0}",
			"monsters-evolved-launch" => $"{value:N0}",
			"battles-won-launch" => $"{value:N0}",
			"total-damage-launch" => FormatLargeNumber( value ),
			"total-knockouts-launch" => $"{value:N0}",
			"total-gold" => FormatLargeNumber( value * 1000L ),
			"expeditions-completed-launch" => $"{value:N0}",
			"total-playtime" => FormatPlaytime( value ),
			_ => $"{value:N0}"
		};
	}

	/// <summary>
	/// Clamp leaderboard values to reasonable maximums to filter out corrupted/cheated entries.
	/// Negative values (from int overflow on legacy clients) become 0.
	/// </summary>
	private long ClampForDisplay( long value, string category )
	{
		if ( value < 0 ) return 0L;

		return category switch
		{
			// Cap playtime at 5 years (≈ 2.6M minutes). Past that, the source data is
			// almost certainly a unit error (seconds being stored as minutes, etc.)
			// or a legacy/abandoned account — clamp keeps the display readable.
			"total-playtime" => Math.Min( value, 5L * 365L * 24L * 60L ),
			_ => value
		};
	}

	private string FormatLargeNumber( long value )
	{
		if ( value >= 1_000_000_000L ) return $"{value / 1_000_000_000f:F1}B";
		if ( value >= 1_000_000L ) return $"{value / 1_000_000f:F1}M";
		if ( value >= 1_000L ) return $"{value / 1_000f:F1}K";
		return $"{value:N0}";
	}

	private string FormatPlaytime( long minutes )
	{
		if ( minutes < 60 ) return $"{minutes}m";
		long hours = minutes / 60;
		long mins = minutes % 60;
		if ( hours < 24 ) return $"{hours}h {mins}m";
		long days = hours / 24;
		hours = hours % 24;
		// For very long playtimes, show years/months instead of "423d" which is unreadable.
		if ( days >= 365 )
		{
			long years = days / 365;
			long remDays = days % 365;
			return $"{years}y {remDays}d";
		}
		return $"{days}d {hours}h";
	}

	private string ColorWithAlpha( string hex, double alpha )
	{
		if ( string.IsNullOrEmpty( hex ) || hex.Length < 7 ) return $"rgba(139, 92, 246, {alpha})";
		int r = Convert.ToInt32( hex.Substring( 1, 2 ), 16 );
		int g = Convert.ToInt32( hex.Substring( 3, 2 ), 16 );
		int b = Convert.ToInt32( hex.Substring( 5, 2 ), 16 );
		return $"rgba({r}, {g}, {b}, {alpha})";
	}

	private bool IsPlayerEntry( LeaderboardEntry entry )
	{
		var playerName = TamerManager.Instance?.CurrentTamer?.Name;
		return entry.Name == playerName;
	}
}
