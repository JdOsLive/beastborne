@namespace Beastborne.UI.Panels
@using System;
@using System.Linq;
@using System.Collections.Generic;
@using System.Threading.Tasks;
@using Sandbox;
@using Sandbox.Services;
@using Sandbox.UI;
@using Beastborne.Core;
@using Beastborne.Data;
@using Beastborne.Systems;
@using Beastborne.UI.Components;
@using Beastborne.UI.Primitives;
@inherits Panel

@*
   LEADERBOARDS — the Online hub's takeover (LAYOUT lane rebuild, pipeline run 1,
   2026-09-04; brief: .claude/design-system/components/leaderboards-redesign-brief.html
   + leaderboards-mock-page.html, every RECOMMENDED toggle taken).

   ZONE MAP (1920×1080, PADDING-BOX — the hub's .oh-header 88 + 2 strip sits above):
     header 90 → body pad 20 → carousel 44 → 20 → slabs 808 → 98 bottom pad
     90 + 20 + 44 + 20 + 808 + 98 = 1080 ✓  (slabs end at y 982 — 8px above
     the PawPad chip at y 990, so the right slab's pinned YOU value shows;
     input pass 2026-09-04, was 874/32)
     slabs: 40 pad + 600 + 20 + 600 + 20 + 600 + 40 pad = 1920 ✓
   The hub header (kicker TAMERLINK · title LEADERBOARDS · REFRESH · F + BACK TO
   HUB · Q) is the hub's markup — see OnlineHubPanel.razor .oh-header.

   KEPT verbatim: the three-phase slab swap (SpinTo), click-a-neighbour-to-jump
   (SetGroup), the data path (SetAggregationMax · MaxEntries 100 · WhenAll).
   CUT (ledger): hint row · refresh pill · 2.5D wheel + count badges · SOCIAL group
   + Guild RP board · card icon-rim / group tag / your-value / #rank pill · rank
   diamonds · podium hairline · SHOW TOP 20 + expanded state + W/S card cursor ·
   FilterMode branches · ColorWithAlpha / RankTitle / entryIndex · page scroll.
*@

<div class="leaderboard-panel">

	@* Living background — the online glyph drifting (the page lives under the
	   Online hub, so it wears the hub's glyph). The hub's opaque z-500 header
	   covers this layer's top overhang. *@
	<BbIconScroll Icon="online" />

	@* ── CAROUSEL BAND 44 — ‹ 44 ghost · ECONOMY · BATTLE · COLLECTION · › 44 ghost,
	   centred, gap 12. Chips = the guild .gp-chip recipe (32 r11, two-tone .on —
	   ACTIONS NEVER SKEW); arrows = BbButton ghost 44 pinned square. All three
	   groups are visible, so the row IS the counter (no dots, no "2 / 3").
	   LANE: input (wired 2026-09-04) — the chips are SLAB-cursor stops (.kb-focused
	   = violet rim, fill holds .on's two-tone; DOC-5 §7/§8 — a 32px chip has no
	   12px ring clearance). The cursor RIDES the active chip: A/D rotate the
	   group and the rim follows .on; mouse hover parks the rim on any chip
	   (mouse mode only — DOC-5 §15), Space on a parked non-active chip = that
	   group. The ‹ › arrows are CLICK targets, not stops (A/D are their keys).
	   Device flag (.kbd-mode/.mouse-mode) + the 3px travel guard are the hub
	   root's (OnlineHubPanel OnRootMouseMove) — read here via HubKbMode. The
	   CSS for hover/cursor lives in the hub's ONE DEVICE GATE (LEADERBOARDS
	   TAKEOVER sub-blocks), so a parked pointer never fights the cursor. *@
	<div class="lb-carousel">
		<BbButton Tier="ghost" Size=@(44) Icon="lucide:chevron-left" OnClick=@PrevGroup Class="lb-arrow" />
		<div class="lb-groups">
			@for ( int i = 0; i < GroupMeta.Length; i++ )
			{
				var idx = i;
				var grp = GroupMeta[i];
				var on = i == currentGroupIndex;
				<div class="lb-gchip @(on ? "on" : "") @(IsChipKb( idx ) ? "kb-focused" : "")"
					 onmouseover=@(() => HoverChip( idx ))
					 onclick=@(() => SetGroup( idx ))>
					<iconify class="lb-gchip-glyph" icon="@grp.Icon" Size=@(16) Color="@(on ? "#ffffff" : "rgba(214, 206, 236, 0.55)")" />
					<span class="lb-gchip-label">@grp.Name.ToUpper()</span>
				</div>
			}
		</div>
		<BbButton Tier="ghost" Size=@(44) Icon="lucide:chevron-right" OnClick=@NextGroup Class="lb-arrow" />
	</div>

	@{
		var currentCats = GetCurrentGroupCats();
		var myName = Connection.Local?.DisplayName;
		var mySteam = GetLocalSteamId();
	}

	@* ── SLABS — three pinned 600×874 (gap 20). The row carries the three-phase
	   spin classes (spin-out-* / warp-from-*) — LANE: motion owns the swap
	   choreography and any cascade; the classes + timings here are the shipped
	   mechanics, preserved. Nothing inside needs flex-grow WIDTH resolution
	   (three pinned 600s), so the translateX on this row is safe. *@
	<div class="lb-slabs @spinClass">
		@for ( int si = 0; si < currentCats.Length; si++ )
		{
			var slabIdx = si;
			var cat = currentCats[si];
			var entries = GetEntries( cat.Key );
			var count = entries.Count;
			var myEntry = FindMyEntry( entries, mySteam, myName );
			// YOU is told ONCE: inline while your row is inside the 12-row lane,
			// pinned under the lane (outside the scroll) when you sit below it or
			// aren't on the board yet ("—" rank, your local value).
			var pinYou = !isLoading && ( myEntry == null || myEntry.Rank > VisibleRows );

			<div class="lb-slab">
				@* Band 36 — chipstamp (category) · spacer · darkchip "N TAMERS"
				   (entries.Count — the honest population). OPAQUE, gap 0 to the list
				   (scroll-leak law). *@
				<div class="lb-band">
					<div class="lb-stamp"><span>@cat.Label.ToUpper()</span></div>
					<div class="lb-band-spacer"></div>
					@if ( !isLoading )
					{
						<div class="lb-darkchip"><span>@($"{count} TAMERS")</span></div>
					}
				</div>

				@* List zone 772 = 808 − 36; pad 16/12/12/12 → inner 744 × 576.
				   .lb-lane is THE scroll child (flex 1 1 0; min-height 0), rows its
				   DIRECT children. Lane = 744 − (8 + 56 pinned) = 680 when YOU is
				   pinned → 11 × 56 + 10 × 6 = 676 (4 slack); 744 when inline → 12 rows
				   (668). LANE: input — rows are SLAB-cursor stops (read-only: Space
				   is silent) so the lane is keyboard-reachable (house rule: every
				   scroll region); W/S walk + glide scroll-follow in Tick; wheel over
				   a lane scrolls THAT lane (OnMouseWheel below). Hover on a row is
				   COLOUR-ONLY css (mouse mode) — it does not move the cursor. The
				   pinned YOU row is outside the lane and always visible: not a stop. *@
				<div class="lb-list">
					@if ( isLoading )
					{
						<div class="lb-note"><span class="lb-note-text">Fetching standings…</span></div>
					}
					else if ( count == 0 )
					{
						<EmptyState Icon="lucide:trophy"
									Title="No one on this board yet."
									Body="Be the first to set a record."
									Size="inline" />
					}
					else
					{
						<div class="lb-lane">
							@for ( int ri = 0; ri < entries.Count; ri++ )
							{
								var entry = entries[ri];
								var isMe = myEntry != null && ReferenceEquals( entry, myEntry );
								@RenderRow( entry, cat.Key, isMe, ri % 2 == 1, false, IsRowKb( slabIdx, ri ) )
							}
						</div>
					}

					@if ( pinYou )
					{
						@RenderRow( myEntry, cat.Key, true, false, true, false )
					}
				</div>
			</div>
		}
	</div>
</div>

@code {
	// Copy is literal this run — the brief's new strings ("Fetching standings…",
	// "N TAMERS", "No one on this board yet.") have no loc keys yet; the
	// type/copy lane owns adding them to Assets/localization/*.json.
	public Action OnBack { get; set; }

	// INERT — the dormant ArenaPanel (ArenaPanel.razor:788) still passes
	// FilterMode="arena"; the arena/guild branches are deleted (the hub is the
	// only live mount and never set it). Kept so the dormant panel compiles.
	public string FilterMode { get; set; } = "all";

	// How many 56px rows the lane shows before it scrolls — the inline/pinned
	// YOU decision reads this (see the slab loop). 11 × 56 + 10 × 6 = 676 ≤ 680
	// (the 808 slab; was 12 at 874).
	private const int VisibleRows = 11;

	private Dictionary<string, List<LeaderboardEntry>> allEntries = new();
	// Long-typed because cumulative stats (gold, damage, playtime) can exceed
	// int.MaxValue and would silently wrap negative when displayed.
	private Dictionary<string, long> playerBoardValues = new();
	private bool isLoading = true;
	// Bumped per completed load so a refresh with identical counts still re-renders.
	private int _loadVersion = 0;

	// Row identity helpers, built once per load (not per row):
	// avatar ids BY DISPLAY NAME for entries whose Board2 SteamId is 0 (the hub's
	// helper, promoted to a shared static) and guild tags by Steam id / name
	// (own guild Members → session PlayerProfiles → you).
	private Dictionary<string, long> _avatarByName = new( StringComparer.OrdinalIgnoreCase );
	private Dictionary<long, string> _tagBySteam = new();
	private Dictionary<string, string> _tagByName = new( StringComparer.OrdinalIgnoreCase );

	// ── Carousel state ────────────────────────────────────────────────────
	// Index into GroupMeta for the active group. `spinClass` cycles through
	// three phases per swap: spin-out-X → warp-from-Y (instant teleport,
	// transition disabled) → "" (transition back), so new content arrives from
	// the opposite side of where the old content went out.
	private int currentGroupIndex = 1; // opens on BATTLE (the middle chip)
	private string spinClass = "";
	private bool isSpinning = false;

	private record GroupInfo( string Name, string Icon );

	// Three groups, no colours (the page is ONE accent). Order = the chip row.
	private static readonly GroupInfo[] GroupMeta = new[]
	{
		new GroupInfo( "Economy", "lucide:coins" ),
		new GroupInfo( "Battle", "lucide:swords" ),
		new GroupInfo( "Collection", "lucide:layers" )
	};

	private async void PrevGroup()
	{
		if ( isSpinning ) return;
		SoundManager.PlayClick();
		// Going BACKWARDS: old content slides RIGHT off, new content arrives from LEFT.
		await SpinTo( (currentGroupIndex - 1 + GroupMeta.Length) % GroupMeta.Length, exitTo: "right", enterFrom: "left" );
	}

	private async void NextGroup()
	{
		if ( isSpinning ) return;
		SoundManager.PlayClick();
		// Going FORWARD: old content slides LEFT off, new content arrives from RIGHT.
		await SpinTo( (currentGroupIndex + 1) % GroupMeta.Length, exitTo: "left", enterFrom: "right" );
	}

	private async void SetGroup( int idx )
	{
		if ( idx < 0 || idx >= GroupMeta.Length ) return;
		if ( idx == currentGroupIndex ) return;
		if ( isSpinning ) return;
		SoundManager.PlaySelect();
		// Direction follows index distance — clicking a chip to the right exits left, etc.
		if ( idx > currentGroupIndex )
			await SpinTo( idx, exitTo: "left", enterFrom: "right" );
		else
			await SpinTo( idx, exitTo: "right", enterFrom: "left" );
	}

	// Three-phase swap (preserved verbatim from the shipped page):
	//   Phase 1: slabs fade/slide out via spin-out-{exitTo}; currentGroupIndex
	//            changes here too (content swapping mid-fade is invisible — the
	//            row is at opacity 0 from the spin-out class).
	//   Phase 2: warp-from-{enterFrom} teleports the row to the opposite side
	//            with transition disabled.
	//   Phase 3: clear class — the row transitions back to centre, new content
	//            visible.
	private async Task SpinTo( int targetIdx, string exitTo, string enterFrom )
	{
		isSpinning = true;

		spinClass = $"spin-out-{exitTo}";
		currentGroupIndex = targetIdx;
		// LANE: input — the rim rides .on; a row cursor re-follows in the new
		// lane (counts differ per board — TickInput clamps _kbRow).
		if ( _kbZone == "chips" ) _kbIndex = targetIdx;
		if ( _kbZone == "rows" ) { _rowFollowPending = true; _laneGlideTarget = -1f; }
		await System.Threading.Tasks.Task.Delay( 180 );

		spinClass = $"warp-from-{enterFrom}";
		await System.Threading.Tasks.Task.Delay( 30 );

		spinClass = "";
		await System.Threading.Tasks.Task.Delay( 220 );

		isSpinning = false;
	}

	// Every field that affects rendering: the carousel, the swap phase, the
	// load state + version, the identity maps' sizes, the presence count
	// (session tags / avatars change as people come and go) and — LANE:
	// input — every cursor field + the REFRESH press window (InputHash; the
	// hub folds the same value into ITS BuildHash so the header chips
	// re-render with the cursor). Combine caps at 8 args — nested.
	protected override int BuildHash()
	{
		return System.HashCode.Combine(
			currentGroupIndex,
			spinClass,
			isLoading,
			_loadVersion,
			allEntries.Count,
			System.HashCode.Combine( _avatarByName.Count, _tagBySteam.Count, _tagByName.Count ),
			Networking.IsActive ? Connection.All.Count : 0,
			System.HashCode.Combine( TamerManager.Instance?.CurrentTamer?.CollectedCards?.Count ?? 0, InputHash )
		);
	}

	// ── Boards ────────────────────────────────────────────────────────────
	private record CategoryInfo( string Key, string LeaderboardName, string Label, string Group );

	// Nine boards, three per group. Guild RP left for the guild page (it ranks
	// players by their GUILD's TotalRP — guildmates tie); Expeditions joined
	// ECONOMY when SOCIAL was cut.
	private static readonly CategoryInfo[] Categories = new[]
	{
		new CategoryInfo( "battles-won", "battles-won-launch", "Battles Won", "Battle" ),
		new CategoryInfo( "total-damage", "total-damage-launch", "Damage", "Battle" ),
		new CategoryInfo( "total-knockouts", "total-knockouts-launch", "Knockouts", "Battle" ),
		new CategoryInfo( "monsters-caught", "monsters-caught-launch", "Contracted", "Collection" ),
		new CategoryInfo( "monsters-bred", "monsters-bred-launch", "Fused", "Collection" ),
		new CategoryInfo( "monsters-evolved", "monsters-evolved-launch", "Evolved", "Collection" ),
		new CategoryInfo( "total-gold", "total-gold-launch", "Gold Earned", "Economy" ),
		new CategoryInfo( "expeditions-completed", "expeditions-completed-launch", "Expeditions", "Economy" ),
		new CategoryInfo( "total-playtime", "total-playtime-launch", "Playtime", "Economy" )
	};

	// The three boards of the active group — the ONE source the render and any
	// keyboard walk both read, so they can never disagree.
	private CategoryInfo[] GetCurrentGroupCats()
	{
		var current = GroupMeta[currentGroupIndex];
		return Categories.Where( c => c.Group == current.Name ).ToArray();
	}

	protected override async void OnAfterTreeRender( bool firstTime )
	{
		if ( firstTime )
		{
			await LoadAllLeaderboards();
		}
	}

	// Logged once per session — answers the "does Board2.Entry.SteamId arrive
	// non-zero?" question live (three readers in the codebase disagree).
	private static bool _livenessLogged = false;

	private async Task LoadAllLeaderboards()
	{
		isLoading = true;
		allEntries = new();
		playerBoardValues = new();

		var tasks = Categories.Select( async cat =>
		{
			try
			{
				var board = Leaderboards.GetFromStat( "publicsquare.beastborne", cat.LeaderboardName );
				// Explicit aggregation: every Beastborne stat tracked here is a
				// monotonically-increasing cumulative counter — we want the HIGHEST
				// value the player ever submitted, not a sum or average (the v1.0.1
				// "hyper-inflated leaderboards" bug).
				board.SetAggregationMax();
				board.MaxEntries = 100;
				await board.Refresh();

				var entries = board.Entries.Select( e => new LeaderboardEntry
				{
					Rank = (int)e.Rank,
					Name = e.DisplayName,
					// e.Value is double in s&box; cast to long for our integer-only stats.
					Score = (long)e.Value,
					// The Steam id the hub column already reads (OnlineHubPanel
					// LoadHubLeaderboards) — drives the row's avatar + YOU match.
					SteamId = (long)e.SteamId,
					RankTitle = ""
				} ).ToList();

				var mine = FindMyEntry( entries, GetLocalSteamId(), Connection.Local?.DisplayName );

				lock ( allEntries )
				{
					allEntries[cat.Key] = entries;
					playerBoardValues[cat.Key] = mine?.Score ?? 0L;
				}

				Log.Info( $"Fetched {entries.Count} entries for '{cat.LeaderboardName}'" );
			}
			catch ( Exception e )
			{
				Log.Warning( $"Failed to fetch '{cat.LeaderboardName}': {e.Message}" );
				lock ( allEntries )
				{
					allEntries[cat.Key] = new();
				}
			}
		} );

		await Task.WhenAll( tasks );

		// Identity maps — once per load, not per row.
		_avatarByName = OnlineHubPanel.BuildAvatarByNameShared( null );
		BuildTagMaps();

		if ( !_livenessLogged )
		{
			_livenessLogged = true;
			int total = 0, withId = 0;
			lock ( allEntries )
			{
				foreach ( var list in allEntries.Values )
				{
					total += list.Count;
					withId += list.Count( x => x.SteamId > 0 );
				}
			}
			Log.Info( $"[Leaderboards] SteamId liveness: {withId}/{total} entries carry a non-zero Steam id" );
		}

		isLoading = false;
		_loadVersion++;
		StateHasChanged();
	}

	public async void RefreshAll()
	{
		SoundManager.PlayClick();
		await LoadAllLeaderboards();
	}

	// [TAG] sources, in authority order (later overwrites): the session's
	// PlayerProfiles (GuildTag, keyed by connection → Connection.All gives the
	// Steam id + display name), then your own guild's Members (SteamId + Name →
	// the guild's Tag), then you. Offline strangers: unknown — honest blank.
	private void BuildTagMaps()
	{
		var bySteam = new Dictionary<long, string>();
		var byName = new Dictionary<string, string>( StringComparer.OrdinalIgnoreCase );

		if ( Networking.IsActive )
		{
			var profiles = ChatManager.Instance?.PlayerProfiles;
			if ( profiles != null )
			{
				foreach ( var c in Connection.All )
				{
					if ( c == null ) continue;
					if ( !profiles.TryGetValue( c.Id.ToString(), out var p ) || string.IsNullOrEmpty( p?.GuildTag ) ) continue;
					long sid = c.SteamId;
					if ( sid > 0 ) bySteam[sid] = p.GuildTag;
					if ( !string.IsNullOrEmpty( c.DisplayName ) ) byName[c.DisplayName] = p.GuildTag;
				}
			}
		}

		var gm = GuildManager.Instance;
		var ownTag = gm?.Guild?.Tag;
		if ( !string.IsNullOrEmpty( ownTag ) && gm?.Members != null )
		{
			foreach ( var m in gm.Members )
			{
				if ( m == null ) continue;
				if ( m.SteamId > 0 ) bySteam[m.SteamId] = ownTag;
				if ( !string.IsNullOrEmpty( m.Name ) ) byName[m.Name] = ownTag;
			}
		}

		var myTag = gm?.Membership?.GuildTag;
		if ( !string.IsNullOrEmpty( myTag ) )
		{
			long me = GetLocalSteamId();
			if ( me > 0 ) bySteam[me] = myTag;
			var steamName = Connection.Local?.DisplayName;
			if ( !string.IsNullOrEmpty( steamName ) ) byName[steamName] = myTag;
		}

		_tagBySteam = bySteam;
		_tagByName = byName;
	}

	private string TagFor( LeaderboardEntry entry )
	{
		if ( entry == null ) return null;
		if ( entry.SteamId > 0 && _tagBySteam.TryGetValue( entry.SteamId, out var t ) ) return t;
		if ( !string.IsNullOrEmpty( entry.Name ) && _tagByName.TryGetValue( entry.Name, out var t2 ) ) return t2;
		return null;
	}

	// The Steam id a row's head renders from: the entry's own id, else the
	// by-name map (CollectedCards → presence → you). 0 = the neutral mark.
	private long AvatarIdFor( LeaderboardEntry entry )
	{
		if ( entry == null ) return 0;
		if ( entry.SteamId > 0 ) return entry.SteamId;
		if ( !string.IsNullOrEmpty( entry.Name ) && _avatarByName.TryGetValue( entry.Name, out var id ) ) return id;
		return 0;
	}

	// ── Row ───────────────────────────────────────────────────────────────
	// ONE row recipe for the lane rows AND the pinned YOU row (the hub column's
	// .lb-row / .lb-you at 56). `entry` null = you're not on this board yet:
	// rank "—", your local value.
	// (The `__builder =>` form is the one proven in-engine — OptionsPanel
	// RenderToggleRow; the templated-fragment form is unverified here.)
	// `kb` = the slab cursor sits on this row (LANE: input — .kb-focused is the
	// ONE cursor class; painted violet under .kbd-mode by the hub gate).
	private RenderFragment RenderRow( LeaderboardEntry entry, string catKey, bool isMe, bool alt, bool pinned, bool kb ) => __builder =>
	{
		var rank = entry?.Rank ?? 0;
		var rankText = rank > 0 ? rank.ToString() : "—";
		var podium = rank >= 1 && rank <= 3;
		var discClass = podium ? $"p{rank}" : "none";
		var name = entry?.Name ?? ( Connection.Local?.DisplayName ?? TamerManager.Instance?.CurrentTamer?.Name ?? "You" );
		var avatarId = entry != null ? AvatarIdFor( entry ) : GetLocalSteamId();
		var tag = entry != null ? TagFor( entry ) : GuildManager.Instance?.Membership?.GuildTag;
		var value = entry?.Score ?? GetPlayerValue( catKey );
		var rowClass = "lb-row" + ( alt ? " alt" : "" ) + ( isMe ? " me" : "" ) + ( pinned ? " pinned" : "" ) + ( kb ? " kb-focused" : "" );
		<div class="@rowClass">
			<div class="lb-rank">
				<div class="lb-disc @discClass"><span class="lb-rank-t @(podium ? "ink" : "")">@rankText</span></div>
			</div>
			<div class="lb-head @(isMe ? "me" : "")">
				@if ( avatarId > 0 )
				{
					<img class="lb-head-img" src="avatar:@avatarId" />
				}
				else
				{
					<div class="lb-head-mark"></div>
				}
			</div>
			<span class="lb-name">@name</span>
			@if ( !string.IsNullOrEmpty( tag ) )
			{
				<span class="lb-tag">@($"[{tag}]")</span>
			}
			@if ( isMe )
			{
				<div class="lb-you-chip"><span class="lb-you-chip-t">YOU</span></div>
			}
			<div class="lb-spacer"></div>
			<span class="lb-value">@FormatValue( value, catKey )</span>
		</div>
	};

	// ── LANE: input — THE ONE CURSOR (DOC-5 §6/§11; wired 2026-09-04) ─────
	// Three zones, W/S flowing top-to-bottom exactly as the screen stacks them:
	//   "header" — the hub chrome's REFRESH (0) · BACK TO HUB (1). A/D between,
	//              Space fires, S → chips. (Hub markup; the hub reads
	//              IsHeaderKb/RefreshPressed and forwards HoverHeader.)
	//   "chips"  — the carousel; _kbIndex = the chip under the rim. Seeded on
	//              the ACTIVE chip (BATTLE) at mount — the hub @if-mounts this
	//              panel fresh per takeover, so the fields ARE the open edge
	//              (DOC-5 §12). A/D ROTATE the group (SpinTo moves the rim with
	//              .on); W → header, S → rows.
	//   "rows"   — _kbSlab (0..2 = left/middle/right lane) × _kbRow. A/D hop
	//              lanes (row index carries, clamped — rank N stays under the
	//              cursor); W/S walk rows with glide scroll-follow; W off row 0
	//              → chips; S past the last row rests (endpoint). Rows are
	//              read-only: Space is SILENT. Empty/loading lanes are skipped.
	// R / X = next group · Z = previous (the page's cycle pair, silent twins of
	// A/D on the carousel; any zone). F = refresh (any zone; REFRESH chip wears
	// .pressed for the window). Q = back to hub, CLAIMED here.
	private string _kbZone = "chips";
	private int _kbIndex = 1;          // chips: the chip idx (= currentGroupIndex at seed) · header: 0/1
	private int _kbSlab = 1;           // rows: the lane — first entry lands on the MIDDLE (under the centred carousel)
	private int _kbRow = 0;

	// REFRESH press window (F / Space / chrome click) — the hub paints .pressed.
	private float _refreshPressedUntil = -1f;
	public bool RefreshPressed => Time.Now < _refreshPressedUntil;

	// Every cursor field — this panel's BuildHash AND the hub's fold it in.
	public int InputHash => System.HashCode.Combine( _kbZone, _kbIndex, _kbSlab, _kbRow, RefreshPressed );

	public bool IsHeaderKb( int idx ) => _kbZone == "header" && _kbIndex == idx;
	private bool IsChipKb( int idx ) => _kbZone == "chips" && _kbIndex == idx;
	private bool IsRowKb( int slab, int row ) => _kbZone == "rows" && _kbSlab == slab && _kbRow == row;

	// The hub root wears .kbd-mode / .mouse-mode (its ONE device flag + 3px
	// travel guard) — read off the ancestor chain, no hub private exposed.
	private bool HubKbMode
	{
		get
		{
			for ( var p = Parent; p != null; p = p.Parent )
			{
				if ( p.HasClass( "kbd-mode" ) ) return true;
				if ( p.HasClass( "mouse-mode" ) ) return false;
			}
			return false;
		}
	}

	// Mouse hover moves the SAME cursor (one cursor, last input wins) — mouse
	// mode only: kb scroll-follow slides rows under a parked pointer and the
	// engine re-sends synthetic hovers (DOC-5 §15; learnings 2026-09-01).
	private void HoverChip( int idx )
	{
		if ( HubKbMode ) return;
		if ( _kbZone == "chips" && _kbIndex == idx ) return;
		_kbZone = "chips";
		_kbIndex = idx;
		if ( idx != currentGroupIndex ) SoundManager.PlayHover();  // the .on chip stays quiet (shipped behaviour)
		StateHasChanged();
	}

	// The hub's REFRESH / BACK TO HUB chips forward their hover here.
	public void HoverHeader( int idx )
	{
		if ( HubKbMode ) return;
		if ( _kbZone == "header" && _kbIndex == idx ) return;
		_kbZone = "header";
		_kbIndex = idx;
		SoundManager.PlayHover();
		StateHasChanged();
	}

	// F / Space-on-REFRESH / the chrome chip click — one path, one press window.
	public void PressRefresh()
	{
		if ( isLoading ) return;
		_refreshPressedUntil = Time.Now + 0.16f;
		RefreshAll();
	}

	private int RowCount( int slab )
	{
		var cats = GetCurrentGroupCats();
		if ( slab < 0 || slab >= cats.Length ) return 0;
		return GetEntries( cats[slab].Key ).Count;
	}

	// Nearest lane with rows, searching from `from` in `dir` (±1; 0 = from
	// itself outward). -1 when every lane is empty.
	private int NearestFilledSlab( int from, int dir )
	{
		int n = GetCurrentGroupCats().Length;
		if ( dir != 0 )
		{
			for ( int s = from + dir; s >= 0 && s < n; s += dir )
				if ( RowCount( s ) > 0 ) return s;
			return -1;
		}
		if ( RowCount( from ) > 0 ) return from;
		for ( int d = 1; d < n; d++ )
		{
			if ( from - d >= 0 && RowCount( from - d ) > 0 ) return from - d;
			if ( from + d < n && RowCount( from + d ) > 0 ) return from + d;
		}
		return -1;
	}

	private void EnterRows()
	{
		int slab = NearestFilledSlab( _kbSlab, 0 );
		if ( slab < 0 ) return;                 // nothing to walk — the cursor stays on the carousel
		_kbZone = "rows";
		_kbSlab = slab;
		_kbRow = 0;
		_rowFollowPending = true;
		_laneGlideTarget = -1f;
		SoundManager.PlayHover();
	}

	private void LeaveRowsUp()
	{
		_kbZone = "chips";
		_kbIndex = currentGroupIndex;
		// A cursor leaving upward glides the lane home (DOC-5 §13).
		_rowFollowPending = false;
		_laneGlideTarget = 0f;
		SoundManager.PlayHover();
	}

	// The hub calls this each frame while the takeover has the page (its
	// device stamp already ran, so HubKbMode is honest here). Order: Q claim →
	// F → cycle keys → (loading gate) → confirm → per-zone WASD.
	public void TickInput()
	{
		if ( Input.Pressed( "Menu" ) && !GameHUD.PanelHandledBackKey )
		{
			GameHUD.PanelHandledBackKey = true;
			OnBack?.Invoke();
			return;
		}

		if ( Input.Pressed( "Flashlight" ) ) { PressRefresh(); return; }

		if ( isLoading ) return;

		// Page cycle pair (DOC-5 §1): R / X forward, Z back — from any zone.
		if ( Input.Pressed( "Reload" ) || Input.Pressed( "CycleNext" ) ) { NextGroup(); return; }
		if ( Input.Pressed( "CyclePrev" ) ) { PrevGroup(); return; }

		// Clamp against the live lists (group swaps and refreshes change counts).
		if ( _kbZone == "rows" )
		{
			int slab = NearestFilledSlab( _kbSlab, 0 );
			if ( slab < 0 ) { _kbZone = "chips"; _kbIndex = currentGroupIndex; }
			else
			{
				if ( slab != _kbSlab ) { _kbSlab = slab; _rowFollowPending = true; }
				_kbRow = Math.Clamp( _kbRow, 0, RowCount( _kbSlab ) - 1 );
			}
		}

		if ( UiInput.ConfirmPressed() )   // Space (advertised) · Enter · E
		{
			if ( _kbZone == "header" )
			{
				if ( _kbIndex == 0 ) PressRefresh();
				else OnBack?.Invoke();          // the hub's BackToHub plays the back blip
			}
			else if ( _kbZone == "chips" && _kbIndex != currentGroupIndex )
			{
				SetGroup( _kbIndex );          // a mouse-parked rim + Space = that group
			}
			// rows: read-only — silent.
			return;
		}

		int dx = 0, dy = 0;
		if ( Input.Pressed( "Up" ) ) dy = -1;
		else if ( Input.Pressed( "Down" ) ) dy = 1;
		else if ( Input.Pressed( "Left" ) ) dx = -1;
		else if ( Input.Pressed( "Right" ) ) dx = 1;
		if ( dx == 0 && dy == 0 ) return;

		switch ( _kbZone )
		{
			case "header":
				if ( dx != 0 ) { int t = Math.Clamp( _kbIndex + dx, 0, 1 ); if ( t != _kbIndex ) { _kbIndex = t; SoundManager.PlayHover(); } }
				else if ( dy > 0 ) { _kbZone = "chips"; _kbIndex = currentGroupIndex; SoundManager.PlayHover(); }
				// W off the header: top of the page — rests.
				break;

			case "chips":
				if ( dx < 0 ) PrevGroup();                       // rotate; SpinTo moves the rim with .on
				else if ( dx > 0 ) NextGroup();
				else if ( dy < 0 ) { _kbZone = "header"; _kbIndex = 0; SoundManager.PlayHover(); }
				else EnterRows();
				break;

			case "rows":
				if ( dx != 0 )
				{
					int t = NearestFilledSlab( _kbSlab, dx );
					if ( t >= 0 )
					{
						_kbSlab = t;
						_kbRow = Math.Clamp( _kbRow, 0, RowCount( t ) - 1 );
						_rowFollowPending = true;
						_laneGlideTarget = -1f;
						SoundManager.PlayHover();
					}
				}
				else if ( dy < 0 )
				{
					if ( _kbRow > 0 ) { _kbRow--; _rowFollowPending = true; SoundManager.PlayHover(); }
					else LeaveRowsUp();
				}
				else
				{
					int last = RowCount( _kbSlab ) - 1;
					if ( _kbRow < last ) { _kbRow++; _rowFollowPending = true; SoundManager.PlayHover(); }
				}
				break;
		}
		StateHasChanged();
	}

	// ── LANE: input — scroll-follow + wheel ────────────────────────────────
	// The lanes are rendered in a loop (no @ref) — resolve the Nth .lb-lane
	// on demand (three slabs; cheap). Slabs with a note / EmptyState have no
	// lane, so the Nth lane is the Nth FILLED slab — RowCount-ordered the
	// same way the markup mounts them (a lane exists iff count > 0).
	private Panel LaneFor( int slab )
	{
		if ( slab < 0 ) return null;
		// Map the slab index to its lane ordinal (skip empty slabs before it).
		int ordinal = 0;
		for ( int s = 0; s < slab; s++ ) if ( RowCount( s ) > 0 ) ordinal++;
		if ( RowCount( slab ) == 0 ) return null;
		int n = 0;
		foreach ( var lane in Descendants.Where( d => d.HasClass( "lb-lane" ) ) )
		{
			if ( n == ordinal ) return lane;
			n++;
		}
		return null;
	}

	private Panel LaneUnderPointer()
	{
		var m = Mouse.Position;
		return Descendants.FirstOrDefault( d => d.HasClass( "lb-lane" ) && d.Box.Rect.IsInside( m ) );
	}

	// Kb scroll-follow (DOC-5 §13 — the hub board / FilterBar recipe):
	// ComputeIndexOffset behind a pending flag (retried until the focused row
	// has a rect), then a 0.30 glide per tick toward the target.
	private bool _rowFollowPending = false;
	private float _laneGlideTarget = -1f;

	public override void Tick()
	{
		base.Tick();
		UpdateRowScrollFollow();
	}

	private void UpdateRowScrollFollow()
	{
		if ( !_rowFollowPending && _laneGlideTarget < 0f ) return;   // idle — no tree walk
		var lane = LaneFor( _kbSlab );
		if ( lane == null ) { _rowFollowPending = false; _laneGlideTarget = -1f; return; }

		if ( _rowFollowPending && _kbZone == "rows" )
		{
			var off = UiGridScroll.ComputeIndexOffset( lane, _kbRow, "lb-row", null, 12f );
			var focused = lane.Children.FirstOrDefault( c => c.HasClass( "kb-focused" ) );
			if ( focused != null && focused.Box.Rect.Height > 0f ) _rowFollowPending = false;
			if ( off.HasValue ) _laneGlideTarget = off.Value;
			// Endpoint (DOC-5 §13): row 0 always shows the lane from the top.
			if ( _kbRow == 0 && lane.ScrollOffset.y > 0.5f ) _laneGlideTarget = 0f;
		}

		if ( _laneGlideTarget < 0f ) return;
		float cur = lane.ScrollOffset.y;
		float delta = _laneGlideTarget - cur;
		if ( Math.Abs( delta ) < 1.5f )
		{
			lane.ScrollOffset = new Vector2( lane.ScrollOffset.x, _laneGlideTarget );
			_laneGlideTarget = -1f;
			return;
		}
		lane.ScrollOffset = new Vector2( lane.ScrollOffset.x, cur + delta * 0.30f );
	}

	// Wheel (DOC-5 §17; CLAUDE.md wheel row). Engine model, proven on the
	// PawPad (learnings 2026-08-28/29 — its overflow-y: scroll lists could not
	// wheel at all while the root override consumed): a scrollable leaf does
	// NOT scroll itself — the wheel bubbles to the root, and only if NOBODY
	// consumed it does the engine scroll the nearest scrollable ancestor of
	// the hovered panel. So: over a lane → let it through (the engine scrolls
	// exactly the hovered lane, the same step as every other list in the
	// game; writing ScrollOffset here too would double-step) and drop any kb
	// glide on it (mouse wins); anywhere else → consume, so nothing behind
	// the takeover moves. `public` — on THIS panel the compiler reports the
	// inherited member as public (live compile 2026-09-04); the CLAUDE.md
	// `protected override` note applies where the base is protected internal.
	public override void OnMouseWheel( Vector2 delta )
	{
		var lane = LaneUnderPointer();
		if ( lane != null )
		{
			_rowFollowPending = false;
			_laneGlideTarget = -1f;
			base.OnMouseWheel( delta );
			return;
		}
		// consumed
	}

	// ── Data helpers ──────────────────────────────────────────────────────
	private long GetLocalSteamId() => Connection.Local?.SteamId ?? 0L;

	private List<LeaderboardEntry> GetEntries( string key )
	{
		lock ( allEntries )
		{
			return allEntries.TryGetValue( key, out var list ) ? list : new();
		}
	}

	// Self match by SteamId first (exact), Steam display name as the fallback —
	// the board's Name IS the Steam display name, never the tamer name.
	private static LeaderboardEntry FindMyEntry( List<LeaderboardEntry> entries, long mySteam, string myName )
	{
		if ( entries == null || entries.Count == 0 ) return null;
		LeaderboardEntry hit = null;
		if ( mySteam > 0 ) hit = entries.FirstOrDefault( x => x.SteamId == mySteam );
		if ( hit == null && !string.IsNullOrEmpty( myName ) ) hit = entries.FirstOrDefault( x => x.Name == myName );
		return hit;
	}

	private long GetPlayerValue( string key )
	{
		var tamer = TamerManager.Instance?.CurrentTamer;
		if ( tamer == null ) return 0L;

		long localValue = key switch
		{
			"monsters-caught" => tamer.TotalMonstersCaught,
			"monsters-bred" => tamer.TotalMonstersBred,
			"monsters-evolved" => tamer.TotalMonstersEvolved,
			"battles-won" => tamer.TotalBattlesWon,
			"total-damage" => tamer.TotalDamageDealt,
			"total-knockouts" => tamer.TotalKnockouts,
			"total-gold" => tamer.TotalGoldEarned,
			"expeditions-completed" => tamer.TotalExpeditionsCompleted,
			"total-playtime" => (long)tamer.TotalPlayTime.TotalMinutes,
			_ => 0L
		};

		// The higher of the local tamer value and the board's value — consistent with the rows.
		var boardValue = playerBoardValues.TryGetValue( key, out var bv ) ? bv : 0L;
		return Math.Max( 0L, Math.Max( localValue, boardValue ) );
	}

	// Keyed on the category KEY (the shipped switch listed "-launch" board names
	// that never matched, so Damage printed 2,412,880 instead of 2.4M).
	private string FormatValue( long value, string key )
	{
		value = ClampForDisplay( value, key );

		return key switch
		{
			"total-damage" => FormatLargeNumber( value ),
			// total-gold-launch is pushed in THOUSANDS (TamerManager.cs:597) — the ×1000 is correct.
			"total-gold" => FormatLargeNumber( value * 1000L ),
			"total-playtime" => FormatPlaytime( value ),
			_ => $"{value:N0}"
		};
	}

	/// <summary>
	/// Clamp leaderboard values to reasonable maximums to filter out corrupted/cheated entries.
	/// Negative values (from int overflow on legacy clients) become 0.
	/// </summary>
	private long ClampForDisplay( long value, string key )
	{
		if ( value < 0 ) return 0L;

		return key switch
		{
			// Cap playtime at 5 years (≈ 2.6M minutes) — past that the source data is
			// almost certainly a unit error or an abandoned account.
			"total-playtime" => Math.Min( value, 5L * 365L * 24L * 60L ),
			_ => value
		};
	}

	private string FormatLargeNumber( long value )
	{
		if ( value >= 1_000_000_000L ) return $"{value / 1_000_000_000f:F1}B";
		if ( value >= 1_000_000L ) return $"{value / 1_000_000f:F1}M";
		if ( value >= 1_000L ) return $"{value / 1_000f:F1}K";
		return $"{value:N0}";
	}

	private string FormatPlaytime( long minutes )
	{
		if ( minutes < 60 ) return $"{minutes}m";
		long hours = minutes / 60;
		long mins = minutes % 60;
		if ( hours < 24 ) return $"{hours}h {mins}m";
		long days = hours / 24;
		hours = hours % 24;
		// For very long playtimes, show years/days instead of "423d".
		if ( days >= 365 )
		{
			long years = days / 365;
			long remDays = days % 365;
			return $"{years}y {remDays}d";
		}
		return $"{days}d {hours}h";
	}
}
