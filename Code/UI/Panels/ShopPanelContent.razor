	private string GetBoostLabel( ShopItem item ) => item.Type switch
	{
		ShopItemType.XPBoost or ShopItemType.TamerXPBoost or ShopItemType.BeastXPBoost => "2× XP",
		ShopItemType.GoldBoost => "2× GOLD",
		ShopItemType.RareEncounter => "2× RARE ENCOUNTERS",
		ShopItemType.LuckyCharm => "2× RARE DROPS",
		_ => ""
	};

	private string GetDurationText( int minutes )
	{
		if ( minutes >= 60 )
		{
			int hours = minutes / 60;
			int mins = minutes % 60;
			return mins > 0 ? hours + "H " + mins + "M" : hours + (hours > 1 ? " HOURS" : " HOUR");
		}
		return minutes + " MIN";
	}

	private string GetShortDuration( int minutes ) => minutes >= 60 ? (minutes / 60) + "H" : minutes + "M";

	private string FormatBoostTime( TimeSpan t )
	{
		if ( t.TotalHours >= 1 ) return $"{(int)t.TotalHours}h {t.Minutes}m";
		if ( t.TotalMinutes >= 1 ) return $"{(int)t.TotalMinutes}m";
		return $"{(int)t.TotalSeconds}s";
	}

	// Time left on the running boost of this good's TYPE (personal first, then server).
	private string GetBoostTimeText( ShopItem item )
	{
		var personal = ShopManager.Instance?.GetActiveBoost( item.Type );
		if ( personal != null ) return FormatBoostTime( personal.TimeRemaining );
		var server = ShopManager.Instance?.GetServerBoost( item.Type );
		if ( server != null ) return FormatBoostTime( server.TimeRemaining );
		return L( "ui.shop.active" ).ToLowerInvariant();
	}

	// Card name = the string before "(" — the bundle rides the corner chip.
	private string GetBaseName( string name )
	{
		if ( string.IsNullOrEmpty( name ) ) return name;
		int idx = name.IndexOf( '(' );
		return idx > 0 ? name.Substring( 0, idx ).Trim() : name;
	}

