	public class ConsumableGroup
	{
		public string Label { get; set; }
		public List<BossConsumable> Items { get; set; } = new();
	}

	// Runes group by the stat their NatureType BOOSTS, read from the
	// ItemDefinition's EffectValue (ItemManager) — never from description
	// strings. Offense = ATK / SpA · Defense = DEF / SpD / HP · Speed = SPD.
	// LANE: systems — the +stat map belongs beside NatureType in Genetics.cs
	// (GetNatureDescription is the only shipped source and it is a string).
	private static string RuneFamily( NatureType n ) => n switch
	{
		NatureType.Ferocious or NatureType.Reckless or NatureType.Ruthless
			or NatureType.Mystical or NatureType.Arcane or NatureType.Cunning => "offense",
		NatureType.Stalwart or NatureType.Enduring or NatureType.Stoic or NatureType.Vigorous
			or NatureType.Resolute or NatureType.Warded or NatureType.Serene => "defense",
		NatureType.Restless or NatureType.Skittish or NatureType.Nimble => "speed",
		_ => "other"
	};

	private string RuneFamilyOf( BossConsumable c )
	{
		var def = ItemManager.Instance?.GetItem( c.Id );
		if ( def == null || def.EffectType != ItemEffectType.NatureChange ) return c.Id.StartsWith( "boss_rune_" ) ? "other" : null;
		return RuneFamily( (NatureType)(int)def.EffectValue );
	}

	private List<ConsumableGroup> GetConsumableGroups()
	{
		var result = new List<ConsumableGroup>();
		var items = new List<BossConsumable>();
		var offense = new List<BossConsumable>();
		var defense = new List<BossConsumable>();
		var speed = new List<BossConsumable>();
		var other = new List<BossConsumable>();

		foreach ( var c in consumables )
		{
			switch ( RuneFamilyOf( c ) )
			{
				case "offense": offense.Add( c ); break;
				case "defense": defense.Add( c ); break;
				case "speed": speed.Add( c ); break;
				case "other": other.Add( c ); break;
				default: items.Add( c ); break;
			}
		}

		if ( items.Count > 0 ) result.Add( new ConsumableGroup { Label = "ITEMS", Items = items } );
		if ( offense.Count > 0 ) result.Add( new ConsumableGroup { Label = "OFFENSE RUNES", Items = offense } );
		if ( defense.Count > 0 ) result.Add( new ConsumableGroup { Label = "DEFENSE RUNES", Items = defense } );
		if ( speed.Count > 0 ) result.Add( new ConsumableGroup { Label = "SPEED RUNES", Items = speed } );
		if ( other.Count > 0 ) result.Add( new ConsumableGroup { Label = "RUNES", Items = other } );
		return result;
	}

	private BossConsumable GetDefaultBossItem()
	{
		var ordered = GetConsumableGroups().SelectMany( g => g.Items ).ToList();
		return ordered.FirstOrDefault( c => GetBossTokens() >= c.Cost && !IsConsumableMaxed( c ) ) ?? ordered.FirstOrDefault();
	}

	private BossConsumable GetCaseBossItem() => selectedConsumable ?? GetDefaultBossItem();

	private int GetConsumableMaxStack( string itemId )
	{
		var itemDef = ItemManager.Instance?.GetItem( itemId );
		if ( itemDef != null && itemDef.MaxStack > 0 ) return itemDef.MaxStack;
		return 99;
	}

	private int GetConsumableOwned( string itemId ) => ItemManager.Instance?.GetItemCount( itemId ) ?? 0;
	private bool IsConsumableMaxed( BossConsumable item ) => GetConsumableOwned( item.Id ) >= GetConsumableMaxStack( item.Id );

	// ============================================================
	// DEV HOOK — `dev_shop [itemId|gold|boss]` opens the shop and parks the
	// case on a given good (screenshot instrument; the dev_beastbook pattern).
	//   dev_shop                    → open the shop
	//   dev_shop boss               → open the BOSS TOKENS store
	//   dev_shop tamer_xp_120       → open GOLD, select that good
	//   dev_shop boss_rune_arcane   → open BOSS TOKENS, select that good
	// REMOVE after the redesign is user-approved.
	// ============================================================
	private static string _devPending;

	[ConCmd( "dev_shop" )]
	public static void DevOpenShop( string arg = "" )
	{
		var gm = Beastborne.Core.GameManager.Instance;
		if ( gm != null && !gm.IsInGame ) gm.StartGame();
		PhoneLauncher.Close();
		NavManager.GoTo( "shop" );
		_devPending = arg ?? "";
		Log.Info( $"[Shop] dev_shop → '{_devPending}'" );
	}

	private void ApplyDevPending()
	{
		if ( _devPending == null ) return;
		if ( Box.Rect.Width < 2f ) return; // wait until laid out
		string arg = _devPending;
		_devPending = null;

		if ( string.IsNullOrEmpty( arg ) || arg == "gold" ) { SwitchShopView( "gold" ); return; }
		if ( arg == "boss" ) { SwitchShopView( "boss" ); return; }

		var gold = GetGoldItems().FirstOrDefault( i => i.Id == arg );
		if ( gold != null ) { SwitchShopView( "gold" ); selectedItem = gold; purchaseQty = 1; detailVersion++; return; }
		var boss = consumables.FirstOrDefault( c => c.Id == arg );
		if ( boss != null ) { SwitchShopView( "boss" ); selectedConsumable = boss; purchaseQty = 1; detailVersion++; return; }
		Log.Warning( $"[Shop] dev_shop: no good with id '{arg}'" );
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add( shopView );
		hash.Add( selectedItem?.Id );
		hash.Add( selectedConsumable?.Id );
		hash.Add( GetGold() );
		hash.Add( GetBossTokens() );
		hash.Add( GetInk() );
		// Tamer level drives the LOCKED chip + the LEVEL N button state.
		hash.Add( GetLevel() );
		hash.Add( detailVersion );
		hash.Add( purchaseQty );
		hash.Add( buyBeatVersion );
		hash.Add( IsBuyBeat );
		// Owned counts feed the corner chips, the case chip, the qty cap and MAX HELD.
		if ( selectedConsumable != null ) hash.Add( GetConsumableOwned( selectedConsumable.Id ) );
		if ( selectedItem != null ) hash.Add( GetOwned( selectedItem ) );
		// Running boosts — second granularity so the card timers tick.
		var actives = ShopManager.Instance?.GetAllActiveBoosts();
		if ( actives != null )
		{
			hash.Add( actives.Count );
			foreach ( var b in actives )
			{
				hash.Add( b.Type );
				hash.Add( (int)b.TimeRemaining.TotalSeconds );
			}
		}
		// Balance pulse
		CheckCurrencyFlash();
		hash.Add( IsGoldFlash );
		hash.Add( IsTokenFlash );
		// Living ring — markup-bound position + visibility class.
		hash.Add( shopRingL );
		hash.Add( shopRingT );
		hash.Add( shopRingW );
		hash.Add( shopRingH );
		hash.Add( shopRingVisible );
		hash.Add( shopRingWarm < 2 );
		hash.Add( shopRingPill );
		// One-device flag + cursor graph (root class, chip `.kb-focused`).
		hash.Add( lastInputDevice );
		hash.Add( cursorZone );
		hash.Add( caseStop );
		hash.Add( headerCursor );
		return hash.ToHashCode();
	}
