	private List<BoostDisplay> GetAllActiveBoostDisplay()
	{
		var all = ShopManager.Instance?.GetAllActiveBoosts() ?? new();
		return all.Select(b => new BoostDisplay { Type = b.Type, TimeRemaining = b.TimeRemaining, IsServer = b.IsServer }).ToList();
	}

	/// <summary>
	/// Gets the base part of an item name (before parentheses).
	/// </summary>
	private string GetBaseName(string name)
	{
		if (string.IsNullOrEmpty(name)) return name;
		int idx = name.IndexOf('(');
		return idx > 0 ? name.Substring(0, idx).Trim() : name;
	}

	/// <summary>
	/// Gets the parenthetical part of an item name.
	/// </summary>
	private string GetNameSuffix(string name)
	{
		if (string.IsNullOrEmpty(name)) return null;
		int idx = name.IndexOf('(');
		return idx > 0 ? name.Substring(idx) : null;
	}

