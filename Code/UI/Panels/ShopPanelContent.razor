	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add(shopView);
		hash.Add(currentCategory);
		hash.Add(goldSort);
		hash.Add(bossSort);
		hash.Add(selectedItem?.Id);
		hash.Add(selectedConsumable?.Id);
		hash.Add(GetGold());
		hash.Add(GetBossTokens());
		// Tamer level drives level-lock met/locked state + ShouldShowLevelChip
		// visibility on every card. Without it, leveling up while the shop tab
		// is open leaves stale lock pills until the next unrelated re-render.
		hash.Add(GetLevel());
		hash.Add(categoryDropdownOpen);
		hash.Add(swapVersion);
		hash.Add(detailVersion);
		hash.Add(viewSwitchDir);
		hash.Add(justSelectedItemId);
		hash.Add(selectPulseVersion);
		hash.Add(purchasedItemId);
		hash.Add(buyBtnOvershoot);
		hash.Add(purchaseBurstActive);
		hash.Add(purchaseBurstVersion);
		hash.Add(purchaseQty);
		// Consumable owned-count feeds into max-stack display, qty cap,
		// and Maxed state — without it, the picker would fail to update
		// after a purchase lands.
		if (selectedConsumable != null)
			hash.Add(GetConsumableOwned(selectedConsumable.Id));
		// Active boosts — minute-granularity timer so the rail ticks down visibly
		var actives = GetAllActiveBoostDisplay();
		hash.Add(actives.Count);
		foreach (var b in actives)
		{
			hash.Add(b.Type);
			hash.Add((int)b.TimeRemaining.TotalSeconds);
		}
		// Currency change flash detection
		CheckCurrencyFlash();
		hash.Add(IsPurchaseFlash);
		hash.Add(IsGoldFlash);
		hash.Add(IsTokenFlash);
		// Living violet ring — markup-bound position + visibility class.
		hash.Add(shopRingL);
		hash.Add(shopRingT);
		hash.Add(shopRingW);
		hash.Add(shopRingH);
		hash.Add(shopRingVisible);
		hash.Add(shopRingWarm < 2);
		return hash.ToHashCode();
	}
