@namespace Beastborne.UI.Panels
@using Sandbox;
@using Sandbox.UI;
@using Beastborne.Core;
@using Beastborne.Data;
@using Beastborne.Systems;
@using Beastborne.UI;
@using Beastborne.UI.Components;
@using Beastborne.UI.Primitives;
@inherits Panel

<root class="shop-panel-content">
	<!-- Living background: the shop glyph drifting at the house angle
	     (BbIconScroll supplies the opaque dark base — root paints none). -->
	<BbIconScroll Icon="shop" />

	<!-- ═══ SIGNBOARD HEADER — merchant-stall identity band. Kicker +
	     huge italic title (swaps per store), skewed gold seam, the two
	     big skewed store signboards, filters, and the pouch readout.
	     Opaque bg + the ONE panel-signature strip (gold) so scroll-grid
	     leaks below never show through. ═══ -->
	<div class="shop-header">
		<div class="sh-identity">
			<span class="sh-kicker">MERCHANT STALL</span>
			<span class="sh-title">@GetStoreTitle()</span>
		</div>
		<div class="sh-seam"></div>
		<div class="shop-type-switch">
			<div class="sh-store-chip @(shopView == "gold" ? "active" : "")"
				 onmouseover=@(() => { if (hoveredShopTab != "gold") { hoveredShopTab = "gold"; SoundManager.PlayHover(); } })
				 onmouseout=@(() => hoveredShopTab = null)
				 onclick=@(() => { SoundManager.PlayClick(); SwitchShopView("gold"); })>
				<div class="sh-chip-inner">
					<img class="sh-chip-icon" src="ui/icons/currency/money.svg" />
					<span class="sh-chip-label">@L("ui.shop.gold_store")</span>
				</div>
			</div>
			<div class="sh-store-chip @(shopView == "boss" ? "active" : "")"
				 onmouseover=@(() => { if (hoveredShopTab != "boss") { hoveredShopTab = "boss"; SoundManager.PlayHover(); } })
				 onmouseout=@(() => hoveredShopTab = null)
				 onclick=@(() => { SoundManager.PlayClick(); SwitchShopView("boss"); })>
				<div class="sh-chip-inner">
					<img class="sh-chip-icon" src="ui/icons/currency/token.svg" />
					<span class="sh-chip-label">@L("ui.shop.boss_store")</span>
				</div>
			</div>
			<div class="sh-kb-hint">
				<div class="sh-cap"><span>&lt;</span></div>
				<div class="sh-cap"><span>&gt;</span></div>
			</div>
		</div>
		<div class="filter-controls">
			@if (shopView == "gold")
			{
				<div class="dropdown-container">
					<button class="dropdown-btn shop-category-btn @(currentCategory != "all" ? "active" : "")" onclick=@ToggleCategoryDropdown onmouseover=@OnCategoryDropdownHover>
						<iconify class="dropdown-icon" icon="@GetCategoryIcon(currentCategory)" Size=@(14) Color="#ffce3a" />
						<span class="dropdown-label">@GetCategoryLabel(currentCategory)</span>
						<iconify class="dropdown-arrow @(categoryDropdownOpen ? "open" : "")" icon="lucide:chevron-down" Size=@(12) Color="rgba(255,255,255,0.5)" />
					</button>
					@if (categoryDropdownOpen)
					{
						<div class="dropdown-menu">
							<div class="dropdown-item @(currentCategory == "all" ? "active" : "")" onclick=@(() => SelectCategory("all")) onmouseover=@(() => OnDropdownItemHover("gold-all"))>
								<iconify class="dd-icon" icon="lucide:layers" Size=@(13) Color="rgba(255,255,255,0.7)" />
								<span class="dd-label">All Items</span>
							</div>
							<div class="dropdown-item @(currentCategory == "supplies" ? "active" : "")" onclick=@(() => SelectCategory("supplies")) onmouseover=@(() => OnDropdownItemHover("gold-supplies"))>
								<iconify class="dd-icon" icon="lucide:feather" Size=@(13) Color="rgba(255,255,255,0.7)" />
								<span class="dd-label">Supplies</span>
							</div>
							<div class="dropdown-item @(currentCategory == "boosts" ? "active" : "")" onclick=@(() => SelectCategory("boosts")) onmouseover=@(() => OnDropdownItemHover("gold-boosts"))>
								<iconify class="dd-icon" icon="lucide:zap" Size=@(13) Color="rgba(255,255,255,0.7)" />
								<span class="dd-label">Boosts</span>
							</div>
							<div class="dropdown-item @(currentCategory == "storage" ? "active" : "")" onclick=@(() => SelectCategory("storage")) onmouseover=@(() => OnDropdownItemHover("gold-storage"))>
								<iconify class="dd-icon" icon="lucide:package" Size=@(13) Color="rgba(255,255,255,0.7)" />
								<span class="dd-label">Storage</span>
							</div>
						</div>
					}
				</div>
				<button class="sort-btn @(goldSort != "default" ? "active" : "")" onclick=@CycleGoldSort onmouseover=@OnSortHover>
					<iconify class="sort-icon" icon="@GetSortIcon(goldSort)" Size=@(13) Color="#ffce3a" />
					<span class="sort-label">@GetSortLabel(goldSort)</span>
				</button>
			}
			@if (shopView == "boss")
			{
				<button class="sort-btn @(bossSort != "default" ? "active" : "")" onclick=@CycleBossSort onmouseover=@OnSortHover>
					<iconify class="sort-icon" icon="@GetSortIcon(bossSort)" Size=@(13) Color="#ffce3a" />
					<span class="sort-label">@GetSortLabel(bossSort)</span>
				</button>
			}
		</div>
		@if (shopView == "gold")
		{
			<div class="currency-display @(IsGoldFlash ? "currency-flash" : "")">
				<div class="cur-gem gold"><img class="cur-gem-icon" src="ui/icons/currency/money.svg" /></div>
				<span class="cur-value gold-value">@GetGold().ToString("N0")</span>
			</div>
		}
		@if (shopView == "boss")
		{
			<div class="currency-display boss-currency @(IsTokenFlash ? "currency-flash" : "")">
				<div class="cur-gem tokens"><img class="cur-gem-icon" src="ui/icons/currency/token.svg" /></div>
				<span class="cur-value token-value">@GetBossTokens().ToString("N0")</span>
			</div>
		}
	</div>

	@if (shopView == "gold")
	{
		@{
			var allFiltered = GetFilteredItems();
			var caseItem = GetCaseItem(allFiltered);
			var goldSections = GroupGoldSections(allFiltered, null);
		}
		<div class="shop-layout layout-@swapVersion dir-@(string.IsNullOrEmpty(viewSwitchDir) ? "none" : viewSwitchDir)">
			<!-- ═══ THE COUNTER — goods stand on shelf plinths in rows;
			     price gems hang under them as tags. Flat direct children
			     of the scroll (engine law), section shelf-tags force row
			     breaks with flex-basis 100%. ═══ -->
			<div class="shop-left">
				<div class="active-boosts-rail">
					@{ var actives = GetAllActiveBoostDisplay(); }
					@if (actives.Count == 0)
					{
						<div class="active-boosts-empty">
							<iconify icon="lucide:zap-off" Size=@(12) Color="rgba(255,255,255,0.3)" />
							<span class="active-boosts-empty-text">No active boosts</span>
							<div class="active-boosts-nudge">
								<iconify icon="lucide:arrow-down" Size=@(11) Color="rgba(255, 206, 58, 0.7)" />
								<span>Grab one below to stack XP &amp; gold</span>
							</div>
						</div>
					}
					else
					{
						<span class="active-boosts-label">ACTIVE</span>
						@foreach (var b in actives)
						{
							<div class="active-boost-pill @(b.IsServer ? "server" : "personal") @(b.TimeRemaining.TotalSeconds < 60 ? "expiring" : "")">
								<iconify class="ab-icon" icon="@GetBoostIconKey(b.Type)" Size=@(12) Color="@GetBoostIconColor(b.Type)" />
								<span class="ab-label">@GetBoostShortLabel(b.Type)</span>
								<span class="ab-sep">·</span>
								<span class="ab-time">@FormatBoostTime(b.TimeRemaining)</span>
								@if (b.IsServer)
								{
									<span class="ab-server-tag">SERVER</span>
								}
							</div>
						}
					}
				</div>
				<div class="scroll-fade scroll-fade-bottom"></div>
				<div @ref="shopGridRef" class="items-scroll swap-@swapVersion">
					@{ int sectionIdx = 0; }
					@foreach (var section in goldSections)
					{
						<div class="shop-section-title stagger-@(Math.Min(sectionIdx, 4))"><span class="section-accent"></span><span class="section-label">@section.Label</span><span class="section-count">@section.Items.Count</span><span class="section-spacer"></span></div>
						@foreach (var item in section.Items)
						{
							bool isActiveBoost = IsBoostItem(item) && (ShopManager.Instance?.IsBoostActive(item.Type) ?? false);

							<div class="shop-item @GetItemTypeClass(item.Type) @(CanAfford(item) ? "" : "cant-afford") @(selectedItem?.Id == item.Id ? "selected" : "") @(isActiveBoost ? "boost-active" : "") @(purchasedItemId == item.Id ? "just-purchased" : "")"
								 onclick=@(() => SelectItem(item))
								 onmouseover=@(() => OnShopItemHover(item.Id))>
								<div class="good-ring"></div>
								@if (justSelectedItemId == item.Id)
								{
									<div class="select-pulse pulse-@selectPulseVersion"></div>
								}
								@if (purchasedItemId == item.Id)
								{
									<div class="purchase-confirm"><iconify icon="lucide:check" Size=@(28) Color="#ffffff" /></div>
								}
								<div class="good-art">
									<img class="good-icon" src=@IconSrc(item) />
									@if (isActiveBoost)
									{
										<div class="good-active-check"><iconify icon="lucide:check" Size=@(28) Color="#2a1605" /></div>
									}
									@if (item.Quantity > 1)
									{
										<span class="good-qty">x@(item.Quantity)</span>
									}
									@if (item.BoostDurationMinutes > 0 && !isActiveBoost)
									{
										<span class="good-duration">@GetShortDuration(item.BoostDurationMinutes)</span>
									}
								</div>
								<div class="good-shelf"></div>
								<div class="good-name"><span>@GetBaseName(item.Name)</span></div>
								<div class="good-tag-zone">
									@if (isActiveBoost)
									{
										<div class="good-timer">
											<iconify icon="lucide:clock" Size=@(11) Color="#ffce3a" />
											<span>@GetActiveBoostTimeText(item.Type)</span>
										</div>
									}
									else
									{
										<div class="good-tag @(CanAfford(item) ? "" : "short")">
											<div class="price-gem gold"><img class="price-gem-icon" src="ui/icons/currency/money.svg" /></div>
											<span class="good-tag-val">@item.Price.ToString("N0")</span>
										</div>
									}
								</div>
								@if (isActiveBoost)
								{
									<div class="good-active-tag"><span>ACTIVE</span></div>
								}
								@if (ShouldShowLevelChip(item))
								{
									<div class="good-lock @(GetLevel() >= item.RequiredLevel ? "met" : "locked")">
										@if (GetLevel() >= item.RequiredLevel)
										{
											<iconify icon="lucide:check" Size=@(9) Color="#86efac" />
										}
										else
										{
											<iconify icon="lucide:lock" Size=@(9) Color="#fca5a5" />
										}
										<span>LV @item.RequiredLevel</span>
									</div>
								}
							</div>
						}
						@{ sectionIdx++; }
					}

					@if (allFiltered.Count == 0)
					{
						<EmptyState Icon="lucide:search-x"
									Title="Nothing here right now"
									Body="Try a different category"
									Size="full" />
					}
					else
					{
						<div class="shop-item shop-item-coming-soon">
							<iconify icon="lucide:plus" Size=@(22) Color="rgba(255, 206, 58, 0.3)" />
							<span class="coming-soon-label">More stock soon</span>
						</div>
					}
				</div>
			</div>

			<!-- ═══ THE DISPLAY CASE — gold-trimmed graphite showcase (the
			     PawPad hardware treatment). Default content: the Daily
			     Spotlight (the merchant's pick); selecting any good places
			     it under the glass. The buy CTA lives here, always in the
			     same spot. ═══ -->
			<div class="shop-right">
				@if (caseItem != null)
				{
					@{
						bool caseIsSpotlight = ShopManager.Instance?.IsSpotlight(caseItem) == true;
						bool caseOnSale = caseIsSpotlight
							&& caseItem.Currency == CurrencyType.Gold
							&& (ShopManager.Instance?.SpotlightDiscountPercent ?? 0) > 0;
						int casePct = caseOnSale ? (int)(ShopManager.Instance?.SpotlightDiscountPercent ?? 0) : 0;
						// Effective price routes through ShopManager.GetDiscountedPrice —
						// skill discounts + spotlight stack; purchase charges this amount.
						int caseUnitPrice = GetEffectivePrice(caseItem);
						bool goldMulti = SupportsMultiBuy(caseItem);
						int goldQty = goldMulti && selectedItem != null ? Math.Max(1, purchaseQty) : 1;
						int casePrice = caseUnitPrice * goldQty;
						int caseListTotal = caseItem.Price * goldQty;
						int caseDeficit = casePrice - GetGold();
						int goldMaxQty = GetMaxBuyQty(caseItem);
						var caseSave = caseOnSale ? null : GetFeaturedSavings(caseItem);
						var caseHook = GetFeaturedHook(caseItem);
						var caseSuffix = GetNameSuffix(caseItem.Name);
						bool caseHasBoostMeta = caseItem.BoostDurationMinutes > 0;
						bool caseHasLevelReq = caseItem.RequiredLevel > 1;
					}
					<div class="display-case detail-@detailVersion @(purchasedItemId == caseItem.Id ? "just-purchased" : "")">
						<div class="case-underplate"></div>
						<div class="case-body">
							@if (purchasedItemId == caseItem.Id)
							{
								<div class="purchase-confirm case-confirm"><iconify icon="lucide:check" Size=@(36) Color="#ffffff" /></div>
							}
							<div class="case-stamp-slot">
								@if (caseIsSpotlight)
								{
									<BbStamp Text="DAILY SPOTLIGHT" Tone="gold" Tilt=@(-3) />
								}
								else
								{
									<BbStamp Text="@GetItemCategory(caseItem.Type)" Tone="neutral" Tilt=@(-3) />
								}
							</div>
							@if (caseOnSale)
							{
								<div class="case-sale-slot">
									<BbStamp Text="@GetSaleStampText(casePct)" Tone="violet" Tilt=@(3) />
								</div>
							}
							<div class="case-glass" onclick=@EnsureCaseSelected>
								<div class="case-dust">
									<div class="fd fd0"></div>
									<div class="fd fd1"></div>
									<div class="fd fd2"></div>
								</div>
								<img class="case-icon" src=@IconSrc(caseItem) />
								@if (caseItem.Quantity > 1)
								{
									<span class="case-qty">x@(caseItem.Quantity)</span>
								}
							</div>
							<div class="case-info">
								<div class="case-name"><span>@GetBaseName(caseItem.Name)</span></div>
								@if (caseSuffix != null)
								{
									<div class="case-name-sub">@caseSuffix</div>
								}
								<div class="case-desc">@caseItem.Description</div>
								@if (caseHook != null)
								{
									<div class="case-hook">
										<iconify icon="lucide:sparkles" Size=@(11) Color="#ffce3a" />
										<span>@caseHook</span>
									</div>
								}
								@if (caseSave != null)
								{
									<div class="case-save"><span>@caseSave</span></div>
								}
								@if (caseHasBoostMeta || caseHasLevelReq || caseItem.Id.StartsWith("server_"))
								{
									<div class="case-meta-row">
										@if (caseHasBoostMeta)
										{
											<div class="case-meta-chip">
												<iconify icon="lucide:clock" Size=@(11) Color="#ffce3a" />
												<span>@GetDurationText(caseItem.BoostDurationMinutes)</span>
											</div>
											<div class="case-meta-chip">
												<iconify icon="lucide:trending-up" Size=@(11) Color="#ffce3a" />
												<span>@GetBoostLabel(caseItem)</span>
											</div>
										}
										@if (caseItem.Id.StartsWith("server_"))
										{
											<div class="case-meta-chip server"><span>SERVER-WIDE</span></div>
										}
										@if (caseHasLevelReq)
										{
											<div class="case-meta-chip @(GetLevel() >= caseItem.RequiredLevel ? "met" : "unmet")">
												@if (GetLevel() >= caseItem.RequiredLevel)
												{
													<iconify icon="lucide:check" Size=@(11) Color="#86efac" />
												}
												else
												{
													<iconify icon="lucide:lock" Size=@(11) Color="#fca5a5" />
												}
												<span>LV @caseItem.RequiredLevel</span>
											</div>
										}
									</div>
								}
							</div>
							<div class="case-till">
								@if (goldMulti)
								{
									<div class="qty-picker">
										<button class="qty-btn @(goldQty <= 1 ? "disabled" : "")" onclick=@(() => CaseChangeQty(-1)) onmouseover=@OnQtyHover>
											<iconify icon="lucide:minus" Size=@(14) Color="#ffce3a" />
										</button>
										<div class="qty-display">
											<span class="qty-val">@goldQty</span>
											<span class="qty-unit">@(goldQty == 1 ? "unit" : "units")</span>
										</div>
										<button class="qty-btn @(selectedItem != null && purchaseQty >= goldMaxQty ? "disabled" : "")" onclick=@(() => CaseChangeQty(1)) onmouseover=@OnQtyHover>
											<iconify icon="lucide:plus" Size=@(14) Color="#ffce3a" />
										</button>
										<button class="qty-max @(selectedItem != null && purchaseQty >= goldMaxQty ? "active" : "")" onclick=@CaseSetQtyMax onmouseover=@OnQtyHover>
											<span>MAX</span>
										</button>
									</div>
								}
								<div class="price-seam @(GetGold() >= casePrice ? "" : "short")">
									<div class="price-seam-inner">
										<div class="price-gem gold"><img class="price-gem-icon" src="ui/icons/currency/money.svg" /></div>
										@if (caseOnSale)
										{
											<div class="price-struck-wrap">
												<span class="price-struck">@caseListTotal.ToString("N0")</span>
												<div class="price-struck-line"></div>
											</div>
											<iconify class="price-arrow" icon="lucide:arrow-right" Size=@(14) Color="rgba(255, 206, 58, 0.75)" />
											<span class="price-now">@casePrice.ToString("N0")</span>
										}
										else
										{
											<span class="price-now">@casePrice.ToString("N0")</span>
										}
										@if (GetGold() < casePrice)
										{
											<span class="deficit">need +@(caseDeficit.ToString("N0"))</span>
										}
									</div>
								</div>
								@{ var goldBtn = GetBuyButtonContent(caseItem); }
								<button class="buy-btn @(IsPurchaseFlash ? "purchased is-flashing" : "") @(CanPurchaseQty(caseItem) ? "" : "disabled") @(buyBtnOvershoot ? "overshoot" : "")"
										onclick=@(() => PurchaseItem(caseItem))>
									<iconify icon="@goldBtn.icon" Size=@(goldBtn.size) Color="@goldBtn.color" />
									<span>@goldBtn.label</span>
								</button>
							</div>
						</div>
					</div>
				}
				else
				{
					<div class="display-case case-empty">
						<div class="case-underplate"></div>
						<div class="case-body">
							<div class="case-glass empty">
								<iconify icon="lucide:shopping-basket" Size=@(52) Color="rgba(255, 206, 58, 0.25)" />
							</div>
							<div class="case-info">
								<div class="case-name"><span>Browse the shelves</span></div>
								<div class="case-desc">Pick a good from the counter and it lands here, under the glass.</div>
							</div>
						</div>
					</div>
				}
			</div>
		</div>
	}
	@if (shopView == "boss")
	{
		<div class="shop-layout layout-@swapVersion dir-@(string.IsNullOrEmpty(viewSwitchDir) ? "none" : viewSwitchDir)">
			<!-- ═══ THE COUNTER (boss exchange) — same shelf language,
			     token price tags + owned counters. ═══ -->
			<div class="shop-left boss-left">
				<div class="active-boosts-rail">
					@{ var bActives = GetAllActiveBoostDisplay(); }
					@if (bActives.Count == 0)
					{
						<div class="active-boosts-empty">
							<iconify icon="lucide:zap-off" Size=@(12) Color="rgba(255,255,255,0.3)" />
							<span class="active-boosts-empty-text">No active boosts</span>
							<div class="active-boosts-nudge">
								<iconify icon="lucide:arrow-up-left" Size=@(11) Color="rgba(255, 206, 58, 0.7)" />
								<span>Grab one from the Gold Market</span>
							</div>
						</div>
					}
					else
					{
						<span class="active-boosts-label">ACTIVE</span>
						@foreach (var b in bActives)
						{
							<div class="active-boost-pill @(b.IsServer ? "server" : "personal") @(b.TimeRemaining.TotalSeconds < 60 ? "expiring" : "")">
								<iconify class="ab-icon" icon="@GetBoostIconKey(b.Type)" Size=@(12) Color="@GetBoostIconColor(b.Type)" />
								<span class="ab-label">@GetBoostShortLabel(b.Type)</span>
								<span class="ab-sep">·</span>
								<span class="ab-time">@FormatBoostTime(b.TimeRemaining)</span>
								@if (b.IsServer)
								{
									<span class="ab-server-tag">SERVER</span>
								}
							</div>
						}
					}
				</div>
				<div class="scroll-fade scroll-fade-bottom"></div>
				<div @ref="shopGridRef" class="items-scroll swap-@swapVersion">
					@{
						var bossConsumableGroups = GetConsumableGroups();
						int bossSectionIdx = 0;
					}
					@foreach (var group in bossConsumableGroups)
					{
						<div class="shop-section-title stagger-@(Math.Min(bossSectionIdx, 4))"><span class="section-accent"></span><span class="section-label">@group.Label</span><span class="section-count">@group.Items.Count</span><span class="section-spacer"></span></div>
						@foreach (var item in group.Items)
						{
							bool canAfford = GetBossTokens() >= item.Cost;
							int owned = GetConsumableOwned(item.Id);
							bool maxed = IsConsumableMaxed(item);

							<div class="shop-item boss-item @(!canAfford ? "cant-afford" : "") @(selectedConsumable?.Id == item.Id ? "selected" : "") @(maxed ? "maxed" : "") @(purchasedItemId == item.Id ? "just-purchased" : "")"
								 onclick=@(() => SelectConsumable(item))
								 onmouseover=@(() => OnShopItemHover(item.Id))>
								<div class="good-ring"></div>
								@if (justSelectedItemId == item.Id)
								{
									<div class="select-pulse pulse-@selectPulseVersion"></div>
								}
								@if (purchasedItemId == item.Id)
								{
									<div class="purchase-confirm"><iconify icon="lucide:check" Size=@(28) Color="#ffffff" /></div>
								}
								<div class="good-art">
									<img class="good-icon" src=@item.Icon />
								</div>
								<div class="good-shelf"></div>
								<div class="good-name"><span>@GetBaseName(item.Name)</span></div>
								<div class="good-tag-zone">
									@if (maxed)
									{
										<div class="good-maxed"><span>MAX</span></div>
									}
									else
									{
										<div class="good-tag @(canAfford ? "" : "short")">
											<div class="price-gem tokens"><img class="price-gem-icon" src="ui/icons/currency/token.svg" /></div>
											<span class="good-tag-val">@item.Cost.ToString("N0")</span>
										</div>
									}
								</div>
								@if (owned > 0)
								{
									<div class="good-owned"><span>@owned</span></div>
								}
							</div>
						}
						@{ bossSectionIdx++; }
					}

					@if (GetTotalBossCount(bossConsumableGroups) == 0)
					{
						<EmptyState Icon="lucide:search-x"
									Title="Nothing here right now"
									Body="Try a different category"
									Size="full" />
					}
					else
					{
						<div class="shop-item shop-item-coming-soon">
							<iconify icon="lucide:plus" Size=@(22) Color="rgba(255, 206, 58, 0.3)" />
							<span class="coming-soon-label">Beat more bosses</span>
						</div>
					}
				</div>
			</div>

			<!-- ═══ THE DISPLAY CASE (boss exchange) — selected consumable
			     under the glass; plaque copy when nothing is picked. ═══ -->
			<div class="shop-right boss-right">
				@if (selectedConsumable != null)
				{
					@{
						int cQty = Math.Max(1, purchaseQty);
						int cTotal = selectedConsumable.Cost * cQty;
						int cDeficit = cTotal - GetBossTokens();
						int cMaxQty = GetMaxBuyQty(selectedConsumable);
						bool cMaxed = IsConsumableMaxed(selectedConsumable);
						var cSuffix = GetNameSuffix(selectedConsumable.Name);
					}
					<div class="display-case boss-case detail-@detailVersion @(purchasedItemId == selectedConsumable.Id ? "just-purchased" : "")">
						<div class="case-underplate"></div>
						<div class="case-body">
							@if (purchasedItemId == selectedConsumable.Id)
							{
								<div class="purchase-confirm case-confirm"><iconify icon="lucide:check" Size=@(36) Color="#ffffff" /></div>
							}
							<div class="case-stamp-slot">
								<BbStamp Text="BOSS EXCHANGE" Tone="violet" Tilt=@(-3) />
							</div>
							<div class="case-glass">
								<div class="case-dust">
									<div class="fd fd0"></div>
									<div class="fd fd1"></div>
									<div class="fd fd2"></div>
								</div>
								<img class="case-icon" src=@selectedConsumable.Icon />
							</div>
							<div class="case-info">
								<div class="case-name"><span>@GetBaseName(selectedConsumable.Name)</span></div>
								@if (cSuffix != null)
								{
									<div class="case-name-sub">@cSuffix</div>
								}
								<div class="case-desc">@selectedConsumable.Description</div>
								<div class="case-meta-row">
									<div class="case-meta-chip">
										<iconify icon="lucide:package" Size=@(11) Color="#ffce3a" />
										<span>OWNED @GetConsumableOwned(selectedConsumable.Id) / @GetConsumableMaxStack(selectedConsumable.Id)</span>
									</div>
								</div>
							</div>
							<div class="case-till">
								@if (!cMaxed)
								{
									<div class="qty-picker">
										<button class="qty-btn @(purchaseQty <= 1 ? "disabled" : "")" onclick=@(() => ChangeQty(-1)) onmouseover=@OnQtyHover>
											<iconify icon="lucide:minus" Size=@(14) Color="#ffce3a" />
										</button>
										<div class="qty-display">
											<span class="qty-val">@cQty</span>
											<span class="qty-unit">@(cQty == 1 ? "unit" : "units")</span>
										</div>
										<button class="qty-btn @(purchaseQty >= cMaxQty ? "disabled" : "")" onclick=@(() => ChangeQty(1)) onmouseover=@OnQtyHover>
											<iconify icon="lucide:plus" Size=@(14) Color="#ffce3a" />
										</button>
										<button class="qty-max @(purchaseQty >= cMaxQty ? "active" : "")" onclick=@SetQtyMax onmouseover=@OnQtyHover>
											<span>MAX</span>
										</button>
									</div>
								}
								<div class="price-seam boss-seam @(GetBossTokens() >= cTotal ? "" : "short")">
									<div class="price-seam-inner">
										<div class="price-gem tokens"><img class="price-gem-icon" src="ui/icons/currency/token.svg" /></div>
										<span class="price-now">@cTotal.ToString("N0")</span>
										@if (GetBossTokens() < cTotal)
										{
											<span class="deficit">need +@(cDeficit.ToString("N0"))</span>
										}
									</div>
								</div>
								@{ var cBtn = GetBuyButtonContentConsumable(selectedConsumable); }
								<button class="buy-btn @(IsPurchaseFlash ? "purchased is-flashing" : "") @(CanPurchaseConsumableQty(selectedConsumable) ? "" : "disabled") @(buyBtnOvershoot ? "overshoot" : "")"
										onclick=@(() => PurchaseConsumable(selectedConsumable))>
									<iconify icon="@cBtn.icon" Size=@(cBtn.size) Color="@cBtn.color" />
									<span>@cBtn.label</span>
								</button>
							</div>
						</div>
					</div>
				}
				else
				{
					<div class="display-case case-empty">
						<div class="case-underplate"></div>
						<div class="case-body">
							<div class="case-stamp-slot">
								<BbStamp Text="BOSS EXCHANGE" Tone="violet" Tilt=@(-3) />
							</div>
							<div class="case-glass empty">
								<iconify icon="lucide:gem" Size=@(52) Color="rgba(255, 206, 58, 0.25)" />
							</div>
							<div class="case-info">
								<div class="case-name"><span>Pick from the counter</span></div>
								<div class="case-desc">Rare runes &amp; consumables, paid in boss tokens.</div>
								<div class="case-meta-row">
									<div class="case-meta-chip">
										<iconify icon="lucide:layers" Size=@(11) Color="#ffce3a" />
										<span>@consumables.Count GOODS IN STOCK</span>
									</div>
								</div>
							</div>
						</div>
					</div>
				}
			</div>
		</div>
	}

	<!-- THE LIVING VIOLET RING — one waving selection cursor wrapping the
	     selected good on the counter. Root-level absolute so it can wave
	     per-frame without dirtying the grid; position bound from
	     UpdateShopRing each tick, wave via imperative Style.Transform in
	     ApplyShopRingWave. z 60: above the counter goods, below the
	     display case (80) and header (500) — flat z-index law. -->
	<div @ref="shopRingRef" class="shop-ring @(shopRingVisible ? "on" : "") @(shopRingWarm < 2 ? "snap" : "")"
		 style="left: @(shopRingL)px; top: @(shopRingT)px; width: @(shopRingW)px; height: @(shopRingH)px;"></div>

	@if (purchaseBurstActive)
	{
		@{
			// Particle count scales with the qty that was purchased so a big
			// buy feels bigger, but cap at 30 so x100 isn't a snowstorm. Base
			// is 10 (the pre-multibuy count) + qty, bounded.
			int burstQty = Math.Max(1, purchaseBurstQty);
			int particleCount = Math.Min(30, 10 + burstQty);
			// Flyer scale: 1.0 for small, 1.3 for >=10, 1.6 for >=50.
			string flyerScale = burstQty >= 50 ? "flyer-xl" : (burstQty >= 10 ? "flyer-lg" : "");
		}
		<div class="purchase-burst-layer burst-@purchaseBurstVersion @(purchaseBurstIsBoss ? "boss-burst" : "gold-burst")">
			@for (int i = 0; i < particleCount; i++)
			{
				<div class="purchase-burst-particle pp@(i % 10)"></div>
			}
			<div class="purchase-reward-flyer @(purchaseBurstIsBoss ? "fly-token" : "fly-gold") @flyerScale"></div>
		</div>
	}

</root>

@code {
	// Localization helper
	private string L( string key ) => LocalizationManager.Get( key );
	private string L( string key, params object[] args ) => LocalizationManager.Get( key, args );

	// Shop view state
	private string shopView = "gold";
	private string hoveredShopTab = null;

	// Hover-sound guards
	private string hoveredCategoryDropdown = null;
	private string hoveredDropdownItem = null;
	private string hoveredShopItem = null;
	private string hoveredSort = null;

	private void OnCategoryDropdownHover()
	{
		string key = shopView;
		if (hoveredCategoryDropdown == key) return;
		hoveredCategoryDropdown = key;
		SoundManager.PlayHover();
	}

	private void OnDropdownItemHover(string id)
	{
		if (hoveredDropdownItem == id) return;
		hoveredDropdownItem = id;
		SoundManager.PlayHover();
	}

	private void OnShopItemHover(string id)
	{
		if (hoveredShopItem == id) return;
		hoveredShopItem = id;
		SoundManager.PlayHover();
	}

	private void OnSortHover()
	{
		if (hoveredSort == "btn") return;
		hoveredSort = "btn";
		SoundManager.PlayHover();
	}

	private string hoveredQtyBtn = null;
	private void OnQtyHover()
	{
		if (hoveredQtyBtn == "qty") return;
		hoveredQtyBtn = "qty";
		SoundManager.PlayHover();
	}

	// Gold shop state
	private string currentCategory = "all";
	private string goldSort = "default";
	private ShopItem selectedItem;

	// Boss shop state
	private string bossSort = "default";
	private BossConsumable selectedConsumable;

	// Category dropdown state
	private bool categoryDropdownOpen = false;

	// Version counter to retrigger grid fade on category swap
	private int swapVersion = 0;

	// @ref to the shop item grid — keyboard up/down navigation reads its
	// child .shop-item rects to find the row above/below.
	private Panel shopGridRef;
	// Version counter to retrigger detail-pane fade on selection change
	private int detailVersion = 0;

	// ============================================================
	// THE LIVING VIOLET RING — one waving selection cursor wrapping
	// the selected good on the counter (menu/PawPad signature, roster
	// scroll-grid recipe). Root-level absolute; position recomputed
	// every Tick from live Box.Rects (grid scrolls + reflows), wave
	// via imperative Style.Transform (flat panel — per-frame writes
	// are cheap outside a perspective lean).
	// ============================================================
	private Panel shopRingRef;
	private int shopRingL, shopRingT, shopRingW = 140, shopRingH = 170;
	private bool shopRingVisible;
	private int shopRingWarm; // <2 = snap to position (no glide) while first rects land
	private const int ShopRingInset = 8;

	public override void Tick()
	{
		base.Tick();
		UpdateShopRing();
		ApplyShopRingWave();
	}

	private void UpdateShopRing()
	{
		bool wasVisible = shopRingVisible;
		shopRingVisible = false;

		if ( shopGridRef == null ) return;
		bool want = shopView == "gold" ? selectedItem != null : selectedConsumable != null;
		if ( !want ) return;

		var gr = shopGridRef.Box.Rect;
		var rr = Box.Rect;
		if ( rr.Width < 2f || gr.Width < 2f ) return;

		// Fresh traversal for the .selected good. Self-hide when it sits
		// outside the counter viewport — the root-level ring is never
		// clipped by the scroll container (engine law), so an off-screen
		// target would paint the ring over the showcase band.
		Panel target = null;
		foreach ( var c in shopGridRef.Children )
		{
			if ( !c.HasClass( "shop-item" ) || !c.HasClass( "selected" ) ) continue;
			var r = c.Box.Rect;
			if ( r.Top < gr.Top - 12f || r.Bottom > gr.Bottom + 12f ) continue;
			target = c;
			break;
		}
		if ( target == null ) return;

		var cr = target.Box.Rect;
		if ( cr.Width < 2f ) return;

		float sc = ScaleFromScreen;
		if ( sc <= 0.01f || float.IsNaN( sc ) || float.IsInfinity( sc ) ) sc = 1f;

		// Content-box math: declared size = target + 2×inset − 2×border
		// (4px border in SCSS; s&box has no border-box).
		shopRingL = (int)((cr.Left - rr.Left) * sc) - ShopRingInset;
		shopRingT = (int)((cr.Top - rr.Top) * sc) - ShopRingInset;
		shopRingW = (int)(cr.Width * sc) + ShopRingInset * 2 - 8;
		shopRingH = (int)(cr.Height * sc) + ShopRingInset * 2 - 8;

		shopRingVisible = true;
		if ( !wasVisible ) shopRingWarm = 0;       // re-appearing → snap first, glide after
		else if ( shopRingWarm < 2 ) shopRingWarm++;
	}

	// The liquid ink-lean — the menu cursor's multi-sine at the PawPad's
	// ×0.6 amplitude + out-of-phase breathing. Imperative transform:
	// repaints the ring alone, never re-renders.
	private void ApplyShopRingWave()
	{
		if ( shopRingRef == null || !shopRingVisible ) return;
		float wt = Time.Now;
		float skX = ( 2.0f * MathF.Sin( wt * 2.2f ) + 0.7f * MathF.Sin( wt * 3.5f + 1.1f ) ) * 0.6f;
		float skY = ( 2.3f * MathF.Sin( wt * 1.8f + 1.9f ) + 0.9f * MathF.Sin( wt * 2.9f ) ) * 0.6f;
		float rotZ = ( 1.1f * MathF.Sin( wt * 1.0f ) + 0.5f * MathF.Sin( wt * 2.4f + 0.5f ) ) * 0.6f;
		float brX = 1f + 0.013f * MathF.Sin( wt * 1.35f + 0.7f ) + 0.006f * MathF.Sin( wt * 2.7f );
		float brY = 1f + 0.013f * MathF.Sin( wt * 1.15f + 2.6f ) + 0.006f * MathF.Sin( wt * 2.3f + 1.4f );

		var t = new PanelTransform();
		t.AddRotation( 0f, 0f, rotZ );
		t.AddSkew( skX, skY, 0f );
		t.AddScale( new Vector2( brX, brY ) );
		shopRingRef.Style.Transform = t;
	}

	// ============================================================
	// Market-counter composition helpers
	// ============================================================

	// Icon src without $-interpolation in markup attributes (razor
	// generator law: interpolated strings in attribute expressions
	// emit broken codegen).
	private string IconSrc( ShopItem item ) => "/" + item.IconPath;

	// Signboard title per store.
	private string GetStoreTitle() => shopView == "boss" ? "Boss Exchange" : "Gold Market";

	// Sale stamp copy ("15% OFF TODAY") — helper keeps interpolation
	// out of the markup attribute.
	private string GetSaleStampText( int pct ) => pct + "% OFF TODAY";

	// The item currently under the display-case glass: the player's
	// selection, or the merchant's Daily Spotlight pick as the default.
	private ShopItem GetCaseItem( List<ShopItem> filtered ) => selectedItem ?? GetFeaturedItem( filtered );

	// Qty controls on the case act on the DISPLAYED item — if the case
	// is showing the un-selected spotlight default, adopt it as the
	// selection first so ChangeQty/SetQtyMax have a target.
	private void EnsureCaseSelected()
	{
		if ( shopView != "gold" || selectedItem != null ) return;
		var f = GetFeaturedItem( GetFilteredItems() );
		if ( f == null ) return;
		selectedItem = f;
		purchaseQty = 1;
	}

	private void CaseChangeQty( int delta ) { EnsureCaseSelected(); ChangeQty( delta ); }
	private void CaseSetQtyMax() { EnsureCaseSelected(); SetQtyMax(); }

	// Direction of the last store switch — "forward" (gold→boss) or "back" (boss→gold).
	// Drives which side the new view slides in from. Empty on first mount so the
	// initial entrance uses the neutral `.shop-layout-enter` fade instead of a
	// slide (we don't want to fake a "you came from somewhere" on first open).
	private string viewSwitchDir = "";

	// Card-select pulse — a one-shot border flash on the clicked card. Increments
	// per click so `.select-pulse-@selectPulseVersion` remounts the overlay div,
	// re-firing the @keyframes each time. Two fields so we know WHICH card is
	// the pulse target (we can't put this on every card).
	private string justSelectedItemId = null;
	private int selectPulseVersion = 0;

	// After a successful purchase, mark the card so it can flash a green "got it"
	// overlay before clearing. Pairs with TriggerPurchaseFlash for ~800ms.
	private string purchasedItemId = null;

	// Purchase feedback state
	private float purchaseFlashUntil = 0f;
	private float goldFlashUntil = 0f;
	private float tokenFlashUntil = 0f;
	private int lastGoldValue = -1;
	private int lastTokenValue = -1;

	// Multi-buy quantity state — only applies to stackable items (ContractInk
	// in the gold store, and all boss-store consumables). Reset to 1 on any
	// selection change or view swap so the player never carries a stale qty
	// into a new item's detail pane.
	private int purchaseQty = 1;

	// Buy button overshoot (press animation, ~100ms)
	private bool buyBtnOvershoot = false;

	// Purchase particle burst state (DailyPanel-style flyer toward HUD currency pill)
	private bool purchaseBurstActive = false;
	private bool purchaseBurstIsBoss = false;
	private int purchaseBurstVersion = 0;
	// Captured qty at burst start — used to scale particle count and flyer size.
	// Snapshot at burst time so we don't render more particles if the player
	// toggles qty mid-flight (wouldn't happen — overlay is on top — but safer).
	private int purchaseBurstQty = 1;

	private bool IsPurchaseFlash => RealTime.Now < purchaseFlashUntil;
	private bool IsGoldFlash => RealTime.Now < goldFlashUntil;
	private bool IsTokenFlash => RealTime.Now < tokenFlashUntil;

	private void TriggerPurchaseFlash()
	{
		purchaseFlashUntil = RealTime.Now + 0.8f;
	}

	private void CheckCurrencyFlash()
	{
		int currentGold = GetGold();
		int currentTokens = GetBossTokens();
		if ( lastGoldValue >= 0 && currentGold != lastGoldValue )
			goldFlashUntil = RealTime.Now + 0.6f;
		if ( lastTokenValue >= 0 && currentTokens != lastTokenValue )
			tokenFlashUntil = RealTime.Now + 0.6f;
		lastGoldValue = currentGold;
		lastTokenValue = currentTokens;
	}

	// Category dropdown helpers
	private void ToggleCategoryDropdown() { categoryDropdownOpen = !categoryDropdownOpen; }

	private void SelectCategory(string cat)
	{
		if (currentCategory == cat) { categoryDropdownOpen = false; return; }
		currentCategory = cat;
		categoryDropdownOpen = false;
		selectedItem = null;
		hoveredShopItem = null;
		purchaseQty = 1;
		swapVersion++;
	}

	private string GetCategoryIcon(string cat) => cat switch
	{
		"supplies" => "lucide:feather",
		"boosts" => "lucide:zap",
		"storage" => "lucide:package",
		_ => "lucide:layers"
	};

	private string GetCategoryLabel(string cat) => cat switch
	{
		"supplies" => "Supplies",
		"boosts" => "Boosts",
		"storage" => "Storage",
		_ => "All Items"
	};

	private void CycleGoldSort()
	{
		goldSort = goldSort switch
		{
			"default" => "price-asc",
			"price-asc" => "price-desc",
			"price-desc" => "level",
			_ => "default"
		};
		selectedItem = null;
		purchaseQty = 1;
		swapVersion++;
		SoundManager.PlayClick();
	}

	private void CycleBossSort()
	{
		bossSort = bossSort switch
		{
			"default" => "price-asc",
			"price-asc" => "price-desc",
			_ => "default"
		};
		selectedConsumable = null;
		purchaseQty = 1;
		swapVersion++;
		SoundManager.PlayClick();
	}

	private string GetSortIcon(string s) => s switch
	{
		"price-asc" => "lucide:arrow-up-narrow-wide",
		"price-desc" => "lucide:arrow-down-wide-narrow",
		"level" => "lucide:shield",
		_ => "lucide:arrow-up-down"
	};

	private string GetSortLabel(string s) => s switch
	{
		"price-asc" => "Price ↑",
		"price-desc" => "Price ↓",
		"level" => "Level Req",
		_ => "Default"
	};

	// Gold helpers
	private int GetGold() => TamerManager.Instance?.CurrentTamer?.Gold ?? 0;
	private int GetGems() => TamerManager.Instance?.CurrentTamer?.Gems ?? 0;
	private int GetLevel() => TamerManager.Instance?.CurrentTamer?.Level ?? 1;

	// Boss helpers
	private int GetBossTokens() => TamerManager.Instance?.CurrentTamer?.BossTokens ?? 0;

	private void SwitchShopView(string view)
	{
		if (shopView == view) return;
		// Remember direction so the new grid slides in from the matching side —
		// gold is the "left tab", boss is the "right tab" in the header pill row.
		// Forward = gold→boss (new content comes from the right).
		// Back = boss→gold (new content comes from the left).
		viewSwitchDir = (shopView == "gold" && view == "boss") ? "forward" : "back";
		shopView = view;
		selectedItem = null;
		selectedConsumable = null;
		justSelectedItemId = null;
		purchaseQty = 1;
		swapVersion++;
		SoundManager.PlayClick();
	}

	// ============================================================
	// Keyboard navigation — called by GameHUD.TickCurrentPanel().
	// Reuses selectedItem / selectedConsumable as the cursor so the
	// existing card-highlight + detail-pane state needs no parallel
	// fields. Arrows move the cursor through the flat visible list,
	// confirm purchases the selected item, Q/E swap stores.
	// ============================================================
	public void TickInput()
	{
		try
		{
			HandleShopKeyboardInput();

			// Keep the keyboard-selected item on screen. Resolve the index from
			// the (already-updated) selected item — NOT the `.selected` CSS
			// class, which only updates next render and lagged the scroll a row.
			if ( Input.Pressed( "Left" ) || Input.Pressed( "Right" ) || Input.Pressed( "Up" ) || Input.Pressed( "Down" ) )
			{
				int sidx = ResolveSelectedShopIndex();
				if ( sidx >= 0 )
					UiGridScroll.ScrollIndexIntoView( shopGridRef, sidx, "shop-item", "shop-item-coming-soon" );
			}
		}
		catch ( Exception ex )
		{
			Log.Warning( $"ShopPanelContent.TickInput error: {ex.Message}" );
		}
	}

	// Index of the currently-selected item within the grid's render order
	// (the order .shop-item children appear in). -1 when nothing is selected.
	private int ResolveSelectedShopIndex()
	{
		if ( shopView == "gold" )
		{
			if ( selectedItem == null ) return -1;
			var af = GetFilteredItems();
			var ri = GroupGoldSections( af, GetFeaturedItem( af ) ).SelectMany( s => s.Items ).ToList();
			return ri.FindIndex( i => i.Id == selectedItem.Id );
		}

		if ( selectedConsumable == null ) return -1;
		var bossItems = GetConsumableGroups().SelectMany( g => g.Items ).ToList();
		return bossItems.FindIndex( i => i.Id == selectedConsumable.Id );
	}

	// Position-based vertical navigation for the shop's sectioned flex-wrap
	// grid. The K-th real .shop-item child of the grid is item K in the
	// caller's render-order list. Finds the item in the nearest row above/
	// below whose horizontal centre is closest — so W/S move one visual row
	// and respect category section breaks instead of leaping across them.
	private int GetVerticalNeighbor( int idx, int itemCount, bool down )
	{
		var grid = shopGridRef;
		if ( grid == null ) return idx;
		var panels = grid.Children
			.Where( c => c.HasClass( "shop-item" ) && !c.HasClass( "shop-item-coming-soon" ) )
			.ToList();
		if ( panels.Count != itemCount || idx < 0 || idx >= panels.Count ) return idx;

		var cur = panels[idx].Box.Rect;
		float curCentreX = cur.Left + cur.Width * 0.5f;
		float curTop = cur.Top;

		int best = idx;
		float bestRowDist = float.MaxValue;
		float bestDX = float.MaxValue;
		for ( int i = 0; i < panels.Count; i++ )
		{
			if ( i == idx ) continue;
			var r = panels[i].Box.Rect;
			// Only consider panels on a row in the requested direction.
			if ( down ? r.Top <= curTop + 1f : r.Top >= curTop - 1f ) continue;
			float rowDist = Math.Abs( r.Top - curTop );
			float dx = Math.Abs( (r.Left + r.Width * 0.5f) - curCentreX );
			if ( rowDist < bestRowDist - 1f || (rowDist <= bestRowDist + 1f && dx < bestDX) )
			{
				best = i;
				bestRowDist = rowDist;
				bestDX = dx;
			}
		}
		return best;
	}

	private void HandleShopKeyboardInput()
	{
		if ( ChatPanel.IsChatFocused ) return;
		// A blocking popup is open — it owns the keyboard.
		if ( UIModalState.AnyModalOpen ) return;

		// , / . swap stores (CyclePrev / CycleNext — the <,> keys). A prev/next
		// pair that doesn't collide with the grid's arrows, Jump/Enter confirm,
		// or Menu/Run back. ( [ / ] stay reserved for the global radio skip.)
		if ( Input.Pressed( "CyclePrev" ) ) { SwitchShopView( "gold" ); return; }
		if ( Input.Pressed( "CycleNext" ) ) { SwitchShopView( "boss" ); return; }

		if ( shopView == "gold" )
		{
			var allFiltered = GetFilteredItems();
			// Walk the SAME order the grid renders — GroupGoldSections regroups
			// items by category, so navigating the raw filtered list would
			// teleport across category sections.
			var items = GroupGoldSections( allFiltered, GetFeaturedItem( allFiltered ) )
				.SelectMany( s => s.Items ).ToList();
			if ( items.Count == 0 ) return;

			int idx = selectedItem == null ? -1 : items.FindIndex( i => i.Id == selectedItem.Id );

			if ( Input.Pressed( "Left" ) )
			{
				idx = idx <= 0 ? 0 : idx - 1;
				SelectItem( items[idx] );
			}
			else if ( Input.Pressed( "Right" ) )
			{
				idx = idx < 0 ? 0 : Math.Min( items.Count - 1, idx + 1 );
				SelectItem( items[idx] );
			}
			else if ( Input.Pressed( "Up" ) )
			{
				idx = idx < 0 ? 0 : GetVerticalNeighbor( idx, items.Count, false );
				SelectItem( items[idx] );
			}
			else if ( Input.Pressed( "Down" ) )
			{
				idx = idx < 0 ? 0 : GetVerticalNeighbor( idx, items.Count, true );
				SelectItem( items[idx] );
			}
			else if ( Input.Pressed( "Jump" ) || Input.Pressed( "Enter" ) )
			{
				if ( selectedItem != null ) PurchaseItem( selectedItem );
				else SelectItem( items[0] );
			}
			else if ( Input.Pressed( "Menu" ) || Input.Pressed( "run" ) )
			{
				// Back: deselect first, then exit to tab nav. The deselect is
				// an INTERNAL action — claim the back key so GameHUD doesn't
				// also exit to tabs the same frame. When nothing is selected,
				// Q genuinely exits the panel, so the flag is NOT set there.
				if ( selectedItem != null )
				{
					selectedItem = null; detailVersion++; SoundManager.PlayBack();
					GameHUD.PanelHandledBackKey = true;
				}
				else GameHUD.ExitPanel();
			}
		}
		else // boss store
		{
			var items = GetConsumableGroups().SelectMany( g => g.Items ).ToList();
			if ( items.Count == 0 ) return;

			int idx = selectedConsumable == null ? -1 : items.FindIndex( i => i.Id == selectedConsumable.Id );

			if ( Input.Pressed( "Left" ) )
			{
				idx = idx <= 0 ? 0 : idx - 1;
				SelectConsumable( items[idx] );
			}
			else if ( Input.Pressed( "Right" ) )
			{
				idx = idx < 0 ? 0 : Math.Min( items.Count - 1, idx + 1 );
				SelectConsumable( items[idx] );
			}
			else if ( Input.Pressed( "Up" ) )
			{
				idx = idx < 0 ? 0 : GetVerticalNeighbor( idx, items.Count, false );
				SelectConsumable( items[idx] );
			}
			else if ( Input.Pressed( "Down" ) )
			{
				idx = idx < 0 ? 0 : GetVerticalNeighbor( idx, items.Count, true );
				SelectConsumable( items[idx] );
			}
			else if ( Input.Pressed( "Jump" ) || Input.Pressed( "Enter" ) )
			{
				if ( selectedConsumable != null ) PurchaseConsumable( selectedConsumable );
				else SelectConsumable( items[0] );
			}
			else if ( Input.Pressed( "Menu" ) || Input.Pressed( "run" ) )
			{
				// Same two-stage back as the gold store: deselect = internal
				// (claim the key), nothing selected = genuine exit (don't).
				if ( selectedConsumable != null )
				{
					selectedConsumable = null; detailVersion++; SoundManager.PlayBack();
					GameHUD.PanelHandledBackKey = true;
				}
				else GameHUD.ExitPanel();
			}
		}
	}

	private List<ShopItem> GetFilteredItems()
	{
		var items = ShopManager.Instance?.GetAvailableItems(100) ?? new List<ShopItem>();
		items = items.Where(i => i.Currency == CurrencyType.Gold).ToList();

		items = currentCategory switch
		{
			"supplies" => items.Where(i => i.Type == ShopItemType.ContractInk || i.Type == ShopItemType.Consumable).ToList(),
			"boosts" => items.Where(i => i.Type == ShopItemType.XPBoost || i.Type == ShopItemType.TamerXPBoost || i.Type == ShopItemType.BeastXPBoost || i.Type == ShopItemType.GoldBoost || i.Type == ShopItemType.RareEncounter || i.Type == ShopItemType.LuckyCharm).ToList(),
			"storage" => items.Where(i => i.Type == ShopItemType.MonsterSlot).ToList(),
			_ => items
		};

		return goldSort switch
		{
			"price-asc" => items.OrderBy(i => i.Price).ToList(),
			"price-desc" => items.OrderByDescending(i => i.Price).ToList(),
			"level" => items.OrderBy(i => i.RequiredLevel).ThenBy(i => i.Price).ToList(),
			_ => items
		};
	}

	/// <summary>
	/// Pick a "featured" item to spotlight. Priority ladder:
	///   1. Big-ticket storage expansion (if player still has room to expand)
	///   2. Highest-priced non-server boost (personal XP/Gold/Lucky)
	///   3. Highest-priced non-server item (any type — final safety net)
	/// Only shown when category is "all" and no sort is applied so the player
	/// isn't fighting their own filter intent.
	///
	/// Why the ladder: a lv 158 player may have maxed their monster storage and
	/// server boosts are out of place as a "hero pick" (they're a communal
	/// action, not a personal-progression moment). Falling back to a personal
	/// boost keeps the spotlight card relevant across the game's lifecycle.
	/// </summary>
	private ShopItem GetFeaturedItem(List<ShopItem> filtered)
	{
		// The featured hero card only renders on the unfiltered "all" view
		// with default sort — filtered views shouldn't fight player intent.
		// NOTE: we do NOT clear ShopManager.SpotlightItemId here — the sale
		// is a "today's deal" concept that applies to the item even when the
		// player buys it from a filtered view. The card being visible on-
		// screen is a presentation detail; the sale is a data fact.
		if (currentCategory != "all" || goldSort != "default") return null;
		if (filtered == null || filtered.Count == 0) return null;

		ShopItem picked = null;

		bool canExpandStorage = MonsterManager.Instance?.CanExpandStorage ?? true;
		if (canExpandStorage)
		{
			picked = filtered.FirstOrDefault(i => i.Type == ShopItemType.MonsterSlot && i.Price >= 250000);
		}

		if (picked == null)
		{
			picked = filtered
				.Where(i => !i.Id.StartsWith("server_") && IsBoostItem(i))
				.OrderByDescending(i => i.Price)
				.FirstOrDefault();
		}

		if (picked == null)
		{
			picked = filtered
				.Where(i => !i.Id.StartsWith("server_"))
				.OrderByDescending(i => i.Price)
				.FirstOrDefault();
		}

		// Keep ShopManager's spotlight id in sync with the UI's pick — this
		// matters when the UI heuristic differs from the manager's init-time
		// resolver (e.g. player maxed their storage, UI falls back to a boost
		// while the manager resolved storage at boot). The discount applies
		// to whatever the UI actually shows; filtered views inherit the same
		// id until this function runs again with a different pick.
		if (picked != null)
		{
			ShopManager.Instance?.SetSpotlight(picked.Id);
		}
		return picked;
	}

	/// <summary>
	/// Return a short "why is this featured?" hook for the spotlight card.
	/// Pulled from item type — gives the right side of the card a reason to
	/// exist beyond category + price (which a normal grid card already shows).
	/// Returns null when the item type doesn't have a clear value angle.
	/// </summary>
	private string GetFeaturedHook(ShopItem item)
	{
		if (item == null) return null;
		return item.Type switch
		{
			ShopItemType.MonsterSlot => "Permanent unlock",
			ShopItemType.ContractInk when item.Quantity >= 100 => "Best per-ink rate",
			ShopItemType.ContractInk => "Stockpile for capture runs",
			ShopItemType.TamerXPBoost or ShopItemType.BeastXPBoost or ShopItemType.XPBoost => "Stack with daily login bonus",
			ShopItemType.GoldBoost => "Pairs with rare-drop runs",
			ShopItemType.RareEncounter => "Best for legendary hunting",
			ShopItemType.LuckyCharm => "More rare item drops",
			_ => null
		};
	}

	/// <summary>
	/// Compute a "SAVE X%" value callout for bundle items. Compares this item's
	/// per-unit price to the cheapest per-unit price of siblings in the same
	/// category — if this is a real bundle (>= 5% savings), surface the discount.
	/// This is price-per-unit math, not RNG — anti-gacha safe (no "lucky roll"
	/// framing). Returns null for singletons and non-bundles.
	/// </summary>
	private string GetFeaturedSavings(ShopItem item)
	{
		if (item == null || item.Quantity <= 1) return null;
		if (item.Type != ShopItemType.ContractInk) return null;

		var items = ShopManager.Instance?.GetAvailableItems(100) ?? new List<ShopItem>();
		var siblings = items.Where(i => i.Type == item.Type && i.Id != item.Id && i.Quantity > 0).ToList();
		if (siblings.Count == 0) return null;

		float ourPerUnit = item.Quantity > 0 ? (float)item.Price / item.Quantity : item.Price;
		float cheapestSibling = siblings.Min(i => i.Quantity > 0 ? (float)i.Price / i.Quantity : i.Price);
		if (cheapestSibling <= 0 || ourPerUnit >= cheapestSibling) return null;

		int savePct = (int)MathF.Round((1f - ourPerUnit / cheapestSibling) * 100f);
		if (savePct < 5) return null;
		if (savePct >= 30) return $"BEST VALUE · {savePct}% OFF";
		return $"SAVE {savePct}%";
	}

	public class GoldSection
	{
		public string Label { get; set; }
		public List<ShopItem> Items { get; set; } = new();
	}

	private List<GoldSection> GroupGoldSections(List<ShopItem> items, ShopItem featured)
	{
		// The featured card at the top of the grid is a spotlight highlight,
		// not a relocation — we still list the item in its normal section so
		// players searching by category can find it where they expect.
		var working = items.ToList();
		var result = new List<GoldSection>();

		// When sorted explicitly, don't split by category — one flat section labeled by sort.
		if (goldSort != "default")
		{
			result.Add(new GoldSection { Label = "Results", Items = working });
			return result;
		}

		// Category-based grouping
		if (currentCategory == "all")
		{
			var supplies = working.Where(i => i.Type == ShopItemType.ContractInk || i.Type == ShopItemType.Consumable).ToList();
			var boosts = working.Where(i => i.Type == ShopItemType.TamerXPBoost || i.Type == ShopItemType.BeastXPBoost || i.Type == ShopItemType.XPBoost || i.Type == ShopItemType.GoldBoost || i.Type == ShopItemType.RareEncounter || i.Type == ShopItemType.LuckyCharm).ToList();
			var storage = working.Where(i => i.Type == ShopItemType.MonsterSlot).ToList();

			if (supplies.Count > 0) result.Add(new GoldSection { Label = "Supplies", Items = supplies });
			if (boosts.Count > 0)
			{
				// Split server vs personal
				var personal = boosts.Where(i => !i.Id.StartsWith("server_")).ToList();
				var server = boosts.Where(i => i.Id.StartsWith("server_")).ToList();
				if (personal.Count > 0) result.Add(new GoldSection { Label = "Boosts", Items = personal });
				if (server.Count > 0) result.Add(new GoldSection { Label = "Server-Wide Boosts", Items = server });
			}
			if (storage.Count > 0) result.Add(new GoldSection { Label = "Storage", Items = storage });
		}
		else if (currentCategory == "boosts")
		{
			var personal = working.Where(i => !i.Id.StartsWith("server_")).ToList();
			var server = working.Where(i => i.Id.StartsWith("server_")).ToList();
			if (personal.Count > 0) result.Add(new GoldSection { Label = "Personal Boosts", Items = personal });
			if (server.Count > 0) result.Add(new GoldSection { Label = "Server-Wide Boosts", Items = server });
		}
		else
		{
			result.Add(new GoldSection { Label = GetCategoryLabel(currentCategory), Items = working });
		}

		return result;
	}

	/// <summary>
	/// For boss-store consumables: group runes by stat family, and keep other
	/// items in a general "Items" group. Makes the 16-rune list scannable.
	/// </summary>
	public class ConsumableGroup
	{
		public string Label { get; set; }
		public List<BossConsumable> Items { get; set; } = new();
	}

	private List<ConsumableGroup> GetConsumableGroups()
	{
		var sorted = bossSort switch
		{
			"price-asc" => consumables.OrderBy(i => i.Cost).ToList(),
			"price-desc" => consumables.OrderByDescending(i => i.Cost).ToList(),
			_ => consumables.ToList()
		};

		var result = new List<ConsumableGroup>();

		if (bossSort != "default")
		{
			// Flat sorted list when player picks a sort
			result.Add(new ConsumableGroup { Label = "Items & Runes", Items = sorted });
			return result;
		}

		var runes = sorted.Where(i => i.Id.StartsWith("boss_rune_")).ToList();
		var other = sorted.Where(i => !i.Id.StartsWith("boss_rune_")).ToList();

		if (other.Count > 0) result.Add(new ConsumableGroup { Label = "Items", Items = other });

		// Split runes into rough families by description keywords
		if (runes.Count > 0)
		{
			var offense = runes.Where(r => r.Description.Contains("+10% ATK") || r.Description.Contains("+10% SpA")).ToList();
			var defense = runes.Where(r => (r.Description.Contains("+10% DEF") || r.Description.Contains("+10% SpD") || r.Description.Contains("+10% HP")) && !r.Description.Contains("+10% ATK") && !r.Description.Contains("+10% SpA") && !r.Description.Contains("+10% SPD")).ToList();
			var speed = runes.Where(r => r.Description.Contains("+10% SPD") && !r.Description.Contains("+10% ATK") && !r.Description.Contains("+10% DEF") && !r.Description.Contains("+10% HP") && !r.Description.Contains("+10% SpA") && !r.Description.Contains("+10% SpD")).ToList();
			var rest = runes.Except(offense).Except(defense).Except(speed).ToList();

			if (offense.Count > 0) result.Add(new ConsumableGroup { Label = "Offense Runes", Items = offense });
			if (defense.Count > 0) result.Add(new ConsumableGroup { Label = "Defense Runes", Items = defense });
			if (speed.Count > 0) result.Add(new ConsumableGroup { Label = "Speed Runes", Items = speed });
			if (rest.Count > 0) result.Add(new ConsumableGroup { Label = "Hybrid Runes", Items = rest });
		}

		return result;
	}

	/// <summary>
	/// Compute total number of boss-store items rendered for the current filter —
	/// used to show an empty-state when the filter matches nothing. Takes the
	/// pre-computed consumable groups so we don't call GetConsumableGroups twice.
	/// </summary>
	private int GetTotalBossCount(List<ConsumableGroup> consumableGroups)
	{
		return consumableGroups.Sum(g => g.Items.Count);
	}

	private bool IsBoostItem(ShopItem item)
	{
		return item.Type == ShopItemType.TamerXPBoost || item.Type == ShopItemType.BeastXPBoost || item.Type == ShopItemType.XPBoost || item.Type == ShopItemType.GoldBoost || item.Type == ShopItemType.RareEncounter || item.Type == ShopItemType.LuckyCharm;
	}

	// Is this specific boost type currently running? (Used to disable server-
	// boost purchases when the same buff is already active communally.)
	private bool IsBoostAlreadyActive(ShopItem item)
	{
		if (!IsBoostItem(item)) return false;
		return ShopManager.Instance?.IsBoostActive(item.Type) ?? false;
	}

	// Has the player hit the active-boost limit for this type? Server boosts
	// and personal boosts use separate caps.
	private bool IsAtBoostLimit(ShopItem item)
	{
		if (!IsBoostItem(item)) return false;
		if (IsBoostAlreadyActive(item)) return true;
		if (item.Id.StartsWith("server_"))
			return !(ShopManager.Instance?.CanActivateServerBoost(item.Type) ?? true);
		return !(ShopManager.Instance?.CanActivateBoost(item.Type) ?? true);
	}

	// Storage expansion is a singleton purchase — caps out at MaxMonsters.
	private bool IsStorageMaxed(ShopItem item)
	{
		if (item.Type != ShopItemType.MonsterSlot) return false;
		return !(MonsterManager.Instance?.CanExpandStorage ?? true);
	}

	/// <summary>
	/// Whether the level-req chip should render on a shop card. The intent is
	/// to signal an item's unlock gate to players who still find that info
	/// actionable (locked, or just-unlocked-so-recall-matters). For veterans
	/// who've long out-levelled every item, the chip becomes a wall of green
	/// checkmarks that adds noise without information — suppress it.
	///
	/// Rule: only show when the item has a req > lv 1 AND the player is within
	/// 5 levels of the gate. 5 levels ≈ one play session's worth of catch-up,
	/// so a new player still sees the green checks as "I reached these
	/// recently" while long-time players see a clean grid.
	/// </summary>
	private bool ShouldShowLevelChip(ShopItem item)
	{
		if (item.RequiredLevel <= 1) return false;
		int level = GetLevel();
		if (level < item.RequiredLevel) return true; // still locked → always show
		return level < item.RequiredLevel + 5;
	}

	/// <summary>
	/// Convert a `#RRGGBB` hex string to `rgba(r, g, b, a)` so we can tint
	/// s&box inline styles at arbitrary alpha. s&box doesn't support
	/// `color-mix()` or similar CSS composition — this is the cheap
	/// equivalent. Returns `rgba(0,0,0,a)` for any malformed input so we
	/// never emit invalid CSS at runtime.
	/// </summary>
	private string HexToRgba(string hex, float alpha)
	{
		if (string.IsNullOrEmpty(hex) || hex.Length < 7 || hex[0] != '#')
			return $"rgba(0, 0, 0, {alpha.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)})";
		try
		{
			int r = System.Convert.ToInt32(hex.Substring(1, 2), 16);
			int g = System.Convert.ToInt32(hex.Substring(3, 2), 16);
			int b = System.Convert.ToInt32(hex.Substring(5, 2), 16);
			string a = alpha.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
			return $"rgba({r}, {g}, {b}, {a})";
		}
		catch
		{
			return $"rgba(0, 0, 0, {alpha.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)})";
		}
	}

	// Affordability uses the effective (post-discount) price so the spotlight
	// + any skill discounts are honored by every downstream "can the player
	// actually buy this?" check (card state, button state, deficit line).
	// ShopManager.PurchaseItem charges the same effective price.
	private int GetEffectivePrice(ShopItem item) => ShopManager.Instance?.GetDiscountedPrice(item) ?? item.Price;
	private bool CanAfford(ShopItem item) => GetGold() >= GetEffectivePrice(item);

	private bool CanPurchase(ShopItem item) =>
		CanAfford(item)
		&& GetLevel() >= item.RequiredLevel
		&& item.IsInStock
		&& !IsAtBoostLimit(item)
		&& !IsStorageMaxed(item);

	// ============================================================
	// Multi-buy plumbing
	// ------------------------------------------------------------
	// Only stackable items qualify: gold ContractInk bundles, and every
	// boss-store consumable (runes, orbs, ink bundles). Boosts and
	// MonsterSlot expansions are singletons and never show the picker.
	// ============================================================
	private bool SupportsMultiBuy(ShopItem item)
	{
		if (item == null) return false;
		// Server-activated boosts are one-off communal actions — can't be
		// stockpiled, so no multi-buy.
		if (item.Id.StartsWith("server_")) return false;
		// ContractInk + all personal boosts (into inventory as stackable items).
		if (item.Type == ShopItemType.ContractInk) return true;
		if (IsBoostItem(item)) return true;
		return false;
	}

	private bool SupportsMultiBuy(BossConsumable item) => item != null;

	/// <summary>
	/// Cap on how many units the player can buy right now. Balance-capped
	/// first (floor gold / unit price), then inventory-capped (MaxStack
	/// minus currently-owned) so we never oversell. Returns at least 1 so
	/// the qty picker never shows "0 max" for an item the player has just
	/// clicked.
	/// </summary>
	private int GetMaxBuyQty(ShopItem item)
	{
		if (item == null) return 1;
		int unit = GetEffectivePrice(item);
		if (unit <= 0) return 1;
		int byBalance = GetGold() / unit;
		// Contract Ink has no hard inventory cap in this panel — rely on balance.
		return Math.Max(1, byBalance);
	}

	private int GetMaxBuyQty(BossConsumable item)
	{
		if (item == null) return 1;
		int unit = item.Cost;
		if (unit <= 0) return 1;
		int byBalance = GetBossTokens() / unit;
		int stackRoom = GetConsumableMaxStack(item.Id) - GetConsumableOwned(item.Id);
		int cap = Math.Max(0, Math.Min(byBalance, stackRoom));
		return Math.Max(1, cap);
	}

	private void ChangeQty(int delta)
	{
		int next = purchaseQty + delta;
		int max = 1;
		if (selectedItem != null && SupportsMultiBuy(selectedItem)) max = GetMaxBuyQty(selectedItem);
		else if (selectedConsumable != null) max = GetMaxBuyQty(selectedConsumable);
		purchaseQty = Math.Max(1, Math.Min(max, next));
		SoundManager.PlayClick();
	}

	private void SetQtyMax()
	{
		if (selectedItem != null && SupportsMultiBuy(selectedItem))
			purchaseQty = GetMaxBuyQty(selectedItem);
		else if (selectedConsumable != null)
			purchaseQty = GetMaxBuyQty(selectedConsumable);
		else
			purchaseQty = 1;
		SoundManager.PlayClick();
	}

	/// <summary>
	/// Total cost after multiplying unit price by qty. Spotlight/skill
	/// discounts are already baked into `GetEffectivePrice`, so this is
	/// the exact amount SpendGold will deduct across the purchase loop.
	/// Non-multi-buy items always use qty=1 regardless of the picker value
	/// so a stale qty can never leak into a singleton's affordability.
	/// </summary>
	private int GetTotalPrice(ShopItem item)
	{
		int qty = SupportsMultiBuy(item) ? Math.Max(1, purchaseQty) : 1;
		return GetEffectivePrice(item) * qty;
	}
	private int GetTotalPrice(BossConsumable item) => (item?.Cost ?? 0) * Math.Max(1, purchaseQty);

	private bool CanAffordTotal(ShopItem item) => GetGold() >= GetTotalPrice(item);
	private bool CanAffordTotal(BossConsumable item) => GetBossTokens() >= GetTotalPrice(item);

	private bool CanPurchaseQty(ShopItem item)
	{
		if (item == null) return false;
		if (!CanAffordTotal(item)) return false;
		if (GetLevel() < item.RequiredLevel) return false;
		if (!item.IsInStock) return false;
		return true;
	}

	private bool CanPurchaseConsumableQty(BossConsumable item)
	{
		if (item == null) return false;
		if (!CanAffordTotal(item)) return false;
		if (IsConsumableMaxed(item)) return false;
		int qty = Math.Max(1, purchaseQty);
		int stackRoom = GetConsumableMaxStack(item.Id) - GetConsumableOwned(item.Id);
		if (stackRoom < qty) return false;
		return true;
	}

	// ------------------------------------------------------------
	// Unified buy-button content. The cascaded @if/else chain in Razor
	// was leaving ghost iconify children in the DOM during rapid clicks
	// (user-reported bug: two icons + text during purchase flash). By
	// computing the icon + label in code-behind and rendering ONE
	// iconify + ONE span unconditionally, s&box only swaps attribute
	// values on re-render — no child-slot thrash, no duplicate glyphs.
	// ------------------------------------------------------------
	private (string icon, string label, string color, int size) GetBuyButtonContent(ShopItem item)
	{
		// Gold-tier CTA: ink #2a1605 on the gold fill (BbTokens.GoldInk).
		// Flash state stays white (green confirm fill); disabled states
		// stay dim white (dark slab fill).
		if (IsPurchaseFlash) return ("lucide:check", "Purchased!", "#ffffff", 18);
		if (item == null) return ("lucide:shopping-bag", "Purchase", "#2a1605", 18);

		int qty = SupportsMultiBuy(item) ? Math.Max(1, purchaseQty) : 1;
		int total = GetEffectivePrice(item) * qty;

		// Level gate — user can't get past this, no qty workaround.
		if (GetLevel() < item.RequiredLevel) return ("lucide:lock", "Level Locked", "rgba(255,255,255,0.5)", 16);

		// Server boost already running — can't re-activate until it expires.
		if (IsBoostItem(item) && item.Id.StartsWith("server_") && IsBoostAlreadyActive(item))
			return ("lucide:zap", "Active", "rgba(255,255,255,0.5)", 16);
		// Server boost type limit reached (communal cap).
		if (IsBoostItem(item) && item.Id.StartsWith("server_") && IsAtBoostLimit(item))
			return ("lucide:archive", "Max Active", "rgba(255,255,255,0.5)", 16);
		// Storage expansion — already at max monster slots.
		if (item.Type == ShopItemType.MonsterSlot && IsStorageMaxed(item))
			return ("lucide:archive", "Max Storage", "rgba(255,255,255,0.5)", 16);

		if (GetGold() < total) return ("lucide:x", "Not Enough", "rgba(255,255,255,0.5)", 16);
		return ("lucide:shopping-bag", qty > 1 ? $"Purchase x{qty}" : "Purchase", "#ffffff", 18);
	}

	private (string icon, string label, string color, int size) GetBuyButtonContentConsumable(BossConsumable item)
	{
		if (IsPurchaseFlash) return ("lucide:check", "Purchased!", "#ffffff", 18);
		if (item == null) return ("lucide:shopping-bag", "Purchase", "#ffffff", 18);

		int qty = Math.Max(1, purchaseQty);
		int total = item.Cost * qty;

		if (IsConsumableMaxed(item)) return ("lucide:archive", "Max Owned", "rgba(255,255,255,0.5)", 16);
		int stackRoom = GetConsumableMaxStack(item.Id) - GetConsumableOwned(item.Id);
		if (stackRoom < qty) return ("lucide:archive", "Stack Full", "rgba(255,255,255,0.5)", 16);
		if (GetBossTokens() < total) return ("lucide:x", "Not Enough", "rgba(255,255,255,0.5)", 16);
		return ("lucide:shopping-bag", qty > 1 ? $"Purchase x{qty}" : "Purchase", "#ffffff", 18);
	}

	private void SelectItem(ShopItem item)
	{
		if (selectedItem?.Id == item.Id) return;
		selectedItem = item;
		purchaseQty = 1; // reset multi-buy qty so a new item never inherits a stale count
		detailVersion++;
		// One-shot card-select pulse — the overlay div is keyed on
		// selectPulseVersion so it remounts each click, replaying @keyframes.
		justSelectedItemId = item.Id;
		selectPulseVersion++;
		SoundManager.PlayClick();
	}

	private async void PurchaseItem(ShopItem item)
	{
		if (!CanPurchaseQty(item)) return;
		if (purchaseBurstActive) return; // guard against double-click

		int qty = SupportsMultiBuy(item) ? Math.Max(1, purchaseQty) : 1;

		// t=0: layered sound + button overshoot + particle burst. Sound fires
		// ONCE for the whole multi-buy (not N times) — anti-annoyance. For
		// big buys, sprinkle extra gold-reward chimes: one per 10 units, max 3.
		SoundManager.PlayClick();
		SoundManager.PlaySuccess();
		SoundManager.PlayGoldReward();
		_ = PlayMultiBuyChimes(qty);

		buyBtnOvershoot = true;
		_ = ClearBuyBtnOvershoot();

		purchaseBurstIsBoss = false;
		purchaseBurstQty = qty;
		purchaseBurstVersion++;
		purchaseBurstActive = true;

		// Defer so HUD currency roll-up / icon pulse fires when the flyer "lands"
		await GameTask.DelaySeconds( 0.35f );

		// Single-unit ShopManager.PurchaseItem call in a loop. The HUD currency
		// roll-up handles the cumulative deduction naturally (it pulses on any
		// value change). If any unit fails (balance tanked elsewhere), break
		// and still flash success for the units that went through.
		int bought = 0;
		for (int i = 0; i < qty; i++)
		{
			if (ShopManager.Instance?.PurchaseItem(item.Id) != true) break;
			bought++;
		}

		if (bought > 0)
		{
			TriggerPurchaseFlash();
			// Flash the purchased card itself — a brief green tick overlay gives
			// "yes, you got THIS item" confirmation on top of the HUD currency
			// flyer. Clears ~900ms later, not retriggered on re-renders.
			purchasedItemId = item.Id;
			_ = ClearPurchasedCard();
		}
		else
		{
			SoundManager.PlayBack();
		}

		// Reset qty back to 1 after a successful multi-buy so the next item
		// opened from the grid doesn't inherit a stale high count.
		if (bought > 0 && qty > 1) purchaseQty = 1;

		await GameTask.DelaySeconds( 0.5f );
		purchaseBurstActive = false;
	}

	/// <summary>
	/// Sprinkle 1-3 extra gold-reward chimes for multi-buy (qty >= 10).
	/// Caps at 3 extras so the biggest purchase (x100) isn't a siren.
	/// </summary>
	private async Task PlayMultiBuyChimes(int qty)
	{
		if (qty < 10) return;
		int extras = Math.Min(3, qty / 10);
		for (int i = 0; i < extras; i++)
		{
			await GameTask.DelaySeconds( 0.08f + 0.06f * i );
			SoundManager.PlayGoldReward();
		}
	}

	private async Task ClearPurchasedCard()
	{
		// Capture the id we're clearing — if the player has already purchased
		// a different item before our timer fires, we shouldn't clear theirs.
		string targetId = purchasedItemId;
		await GameTask.DelaySeconds( 0.9f );
		if (purchasedItemId == targetId)
		{
			purchasedItemId = null;
		}
	}

	private async Task ClearBuyBtnOvershoot()
	{
		await GameTask.DelaySeconds( 0.12f );
		buyBtnOvershoot = false;
	}

