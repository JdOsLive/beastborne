	private int GetConsumableMaxStack(string itemId)
	{
		var itemDef = ItemManager.Instance?.GetItem(itemId);
		if (itemDef != null && itemDef.MaxStack > 0) return itemDef.MaxStack;
		return 99;
	}

	private int GetConsumableOwned(string itemId)
	{
		return TamerManager.Instance?.CurrentTamer?.Inventory?.GetValueOrDefault(itemId, 0) ?? 0;
	}

	private bool IsConsumableMaxed(BossConsumable item)
	{
		return GetConsumableOwned(item.Id) >= GetConsumableMaxStack(item.Id);
	}

	private async void PurchaseConsumable(BossConsumable item)
	{
		if (purchaseBurstActive) return;
		if (!CanPurchaseConsumableQty(item))
		{
			if (IsConsumableMaxed(item)) SoundManager.PlayDeny();
			return;
		}

		int qty = Math.Max(1, purchaseQty);

		SoundManager.PlayClick();
		SoundManager.PlaySuccess();
		SoundManager.PlayGoldReward();
		_ = PlayMultiBuyChimes(qty);

		buyBtnOvershoot = true;
		_ = ClearBuyBtnOvershoot();

		purchaseBurstIsBoss = true;
		purchaseBurstQty = qty;
		purchaseBurstVersion++;
		purchaseBurstActive = true;

		await GameTask.DelaySeconds( 0.35f );

		// Loop single-unit purchase so we stop cleanly if balance drops mid-buy
		// (shouldn't happen client-side, but cheap safety). SaveToCloud once
		// at the end — not per unit.
		int bought = 0;
		for (int i = 0; i < qty; i++)
		{
			if (TamerManager.Instance?.SpendBossTokens(item.Cost) != true) break;
			ItemManager.Instance?.AddItem(item.Id);
			bought++;
		}

		if (bought > 0)
		{
			TamerManager.Instance?.SaveToCloud();
			MissionManager.Instance?.TrackShopPurchase( 0 );
			TriggerPurchaseFlash();
			purchasedItemId = item.Id;
			_ = ClearPurchasedCard();
			if (qty > 1) purchaseQty = 1;
		}
		else
		{
			SoundManager.PlayBack();
			purchaseBurstActive = false;
			return;
		}

		await GameTask.DelaySeconds( 0.5f );
		purchaseBurstActive = false;
	}

