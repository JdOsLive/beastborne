@namespace Beastborne.UI.Panels
@using Sandbox;
@using Sandbox.UI;
@using Beastborne.Core;
@using Beastborne.Data;
@using Beastborne.Systems;
@using Beastborne.UI;
@using Beastborne.UI.Primitives;
@using Beastborne.UI.Components;
@using System.Linq;
@inherits Panel

@*
	SHOP — the goods grid + one display case (2026-09-02 pipeline rebuild,
	LAYOUT lane).

	Brief: .claude/design-system/components/shop-redesign-brief.html +
	shop-mock-page.html (user-approved 2026-09-02, the mock's default
	toggles are the rulings): categories NONE (kicker rows are the
	sections) · goods are the Bag's .sat-card · qty = a bare − + stepper ·
	discount BAKED into every price (struck list price ONLY on the Daily
	Spotlight) · the case opens on the FIRST AFFORDABLE good · accent A =
	AMBER chrome with BUY in the primary gold · no sell flow.

	CUT (22 + 1 merge): active-boosts rail + nudges · category dropdown +
	sort · signboards, < > caps, single blade · MERCHANT STALL / Gold
	Market / Boss Exchange copy · plinths + hanging price gems · triple
	active signal (timer stays) · "More stock soon" · section counts · met
	level chip · select pulse · scroll fades · stagger classes · empty
	cases · underplate · skewed price seam · dust · hook line · SAVE badge
	· LV meta chip · unit/units · MAX · the 7-signal purchase.
	ADDED (3): Contract Ink balance on the SUPPLIES row · owned count on
	gold consumables · EFFECTIVE price on every card (the list-price bug).

	ZONE MAP (1920×1080, PADDING-BOX math — declared size includes
	padding, borders add on top):
	  header  1920×88 + 2px strip = 90   (pad 16/32/12/28; kicker 12/14
	          + 2 + title 38/44 = 60 tall; the hub .oh-header recipe)
	  body    pad 20/40/20/40; GameHUD keeps a 56px ::after reserve on
	          .shop-panel-content (the PawPad launcher chip) → the real
	          column is 1080 − 90 − 20 − 20 − 56 = 894 (the brief's 930
	          assumed no reserve — same deviation the Skills build took)
	  goods   1310 = grid 1298 (8 × 150 + 7 × 14) + 12 scrollbar lane
	  gap     48
	  case    482 × 894 r22, pad 24 → 434 inner
	  row     40 + 1310 + 48 + 482 + 40 = 1920 ✓
	  column  90 + 20 + 894 + 20 + 56 = 1080 ✓
	Grid rhythm (flat wrap list, kicker rows + cards as DIRECT children):
	  grid row-gap 8 · card 168 + margin-bottom 8 → card→card 16 ·
	  kicker 24 + margin-top 8 → card→kicker 24 · kicker→card 8.
	  GOLD: 4 kickers + 6 card rows = 96 + 24 + 1056 + 72 = 1248 (scrolls
	  354) · BOSS: 4 kickers + 4 card rows = 96 + 24 + 704 + 56 = 880 ✓ fits.
	Case interior (434 wide): art 300 · +16 name 34 · +8 desc 44 · +12
	  chips 26 · +16 qty 44 · +16 price 34 · +4 deficit 16 · +12 BUY 56
	  = 638; the rest is the ghost glyph's ground.

	ONE-CURSOR MODEL (INPUT lane 2026-09-02, DOC-5 #5/#6/#7): ONE cursor,
	three zones. GRID — the cursor card IS the case item (hover selects in
	mouse mode; WASD walk the true 2-D grid in kb mode), the root-level
	living ring wraps it. HEADER — W from the top row climbs to the store
	chips; they wear the hover costume as `.kb-focused` and the ring HIDES
	(2026-09-02 ruling: header controls never carry the ring); A/D swap the
	store on landing. CASE — D off a row's last card (or Space on a card)
	enters the case: the ring glides to the STEPPER group (r21 pill) or the
	BUY slab (r26); A/D step qty (hold repeats), S/W walk stepper ↔ BUY,
	Space on BUY buys, A/Q return to the grid card. One device flag gates
	every :hover under .mouse-mode and `.kb-focused` under .kbd-mode.

	ENGINE LAWS honored: no AcceptsFocus; pointer-events all/none via a
	CLASS on every child of a pressable; explicit boxes on every absolute;
	line-height px; bare text in spans; explicit width + flex pin on every
	card; no width:100% inside padded parents; wrap grid pins width AND
	max-width; no transform/box-shadow on scroll-grid cards.
*@

@* Root carries the device class (DOC-5 #5) — onmousemove is the mouse-mode
   reclaim (travel-gated), onclick re-enters the panel from tab-nav. *@
<root class="@RootClass" onmousemove=@OnRootMouseMove onclick=@OnRootClicked>
	@* Living background: the shop glyph drifting at the house angle
	   (BbIconScroll supplies the opaque dark base — root paints none). *@
	<BbIconScroll Icon="shop" />

	@* ====================== HEADER — the hub .oh-header recipe ====================== *@
	<div class="sh-header">
		@* LANE: color — the brief's accent A wants wave-amber-a/b.png (make-waves.ps1
		   bake, #e0a030). No amber bake exists and assets are outside this lane's
		   files, so the shipped GOLD bake mounts here; swap the Accent once baked. *@
		<BbHeaderWaves Accent=@("gold") />
		<div class="sh-identity">
			<span class="sh-kicker">SHOP</span>
			<div class="sh-title-row">
				<span class="sh-title">@GetStoreTitle()</span>
				<div class="sh-seam"></div>
				<div class="sh-seam dim"></div>
			</div>
		</div>
		@* Right slot (.oh-toolbar position): two store chips + the balance chip.
		   LANE: input (wired 2026-09-02) — the HEADER zone: W from the top card
		   row lands the cursor on the active chip (`.kb-focused`, no ring); A/D
		   swap the store on landing; S returns to the grid; W again exits the
		   panel. Z/X stay as the SILENT store cycle from any zone (DOC-5 #1).
		   Chips are ROUNDED slabs (actions never skew). *@
		<div class="sh-toolbar">
			<div class="@StoreChipClass("gold")"
				 onmouseover=@(() => OnStoreChipHover("gold"))
				 onmouseout=@ClearStoreChipHover
				 onclick=@(() => OnStoreChipClick("gold"))>
				<img class="sh-store-glyph" src="ui/icons/currency/money.svg" />
				<span class="sh-store-label">GOLD</span>
			</div>
			<div class="@StoreChipClass("boss")"
				 onmouseover=@(() => OnStoreChipHover("boss"))
				 onmouseout=@ClearStoreChipHover
				 onclick=@(() => OnStoreChipClick("boss"))>
				<img class="sh-store-glyph" src="ui/icons/currency/token.svg" />
				<span class="sh-store-label">BOSS TOKENS</span>
			</div>
			@* Balance — coin glyph for GOLD, token glyph for BOSS TOKENS.
			   LANE: motion — `.flash` (IsGoldFlash / IsTokenFlash) is the ONE
			   balance pulse; no rules yet. *@
			<div class="@BalanceClass()">
				<img class="sh-balance-glyph" src="@BalanceGlyph()" />
				<span class="sh-balance-value">@BalanceText()</span>
			</div>
		</div>
	</div>

	@* ====================== BODY — goods grid + the case ====================== *@
	<div class="sh-body">

		@* ---- GOODS — 1310: the 1298 grid + a 12px overlay-scrollbar lane ---- *@
		<div class="sh-goods">
			<div @ref="shopGridRef" class="sh-grid">
				@if (shopView == "gold")
				{
					var goldItems = GetGoldItems();
					var goldSections = GroupGoldSections(goldItems);
					var caseGold = GetCaseGoldItem(goldItems);

					foreach (var section in goldSections)
					{
						<div class="sh-kicker-row">
							<div class="sh-kicker-chip">
								<div class="sh-kicker-chip-inner"><span class="sh-kicker-text">@section.Label</span></div>
							</div>
							<div class="sh-kicker-line"></div>
							@if (section.Key == "supplies")
							{
								@* ADD 1 — the Contract Ink balance every ink pack is bought against. *@
								<div class="sh-ink">
									<img class="sh-ink-glyph" src="ui/icons/currency/ink.svg" />
									<span class="sh-ink-label">CONTRACT INK</span>
									<span class="sh-ink-value">@GetInk().ToString("N0")</span>
								</div>
							}
						</div>

						foreach (var item in section.Items)
						{
							bool running = IsBoostRunning(item);
							bool locked = GetLevel() < item.RequiredLevel;
							int owned = GetOwned(item);
							bool isCase = caseGold != null && caseGold.Id == item.Id;
							var cardClass = "shop-card" + (isCase ? " selected" : "") + (CanAfford(item) ? "" : " short");
							var art = ArtPx(item.IconPath, 84);

							<div class="@cardClass"
								 onclick=@(() => OnGoldCardClick(item))
								 onmouseover=@(() => OnGoldCardHover(item))>
								<div class="sat-card-art">
									<img class="sat-card-icon" src=@IconSrc(item) style="width: @(art.w)px; height: @(art.h)px;" />
								</div>
								<div class="sat-card-foot"><span class="sat-card-name">@GetBaseName(item.Name)</span></div>
								@if (running)
								{
									@* ACTIVE boost = the timer replaces the price. ONE signal. *@
									<div class="shop-card-price timer">
										<iconify class="shop-card-glyph" icon="lucide:clock" Size=@(12) Color="#e0a030" />
										<span class="shop-card-time">@GetBoostTimeText(item)</span>
									</div>
								}
								else
								{
									@* ADD 3 — EFFECTIVE price (GetDiscountedPrice), never item.Price. *@
									<div class="shop-card-price">
										<img class="shop-card-coin" src="ui/icons/currency/money.svg" />
										<span class="shop-card-value">@GetEffectivePrice(item).ToString("N0")</span>
									</div>
								}
								@if (locked)
								{
									<div class="shop-card-lock">
										<iconify class="shop-card-lock-glyph" icon="lucide:lock" Size=@(9) Color="#fca5a5" />
										<span class="shop-card-lock-text">@("LV " + item.RequiredLevel)</span>
									</div>
								}
								@if (HasBundleChip(item))
								{
									<div class="sat-qty"><span>@BundleChipText(item)</span></div>
								}
								else if (owned > 0)
								{
									@* ADD 2 — owned count (the Bag's qty-chip semantics, cream). *@
									<div class="sat-qty owned"><span>@OwnedChipText(owned)</span></div>
								}
								@if (item.BoostDurationMinutes > 0 && !running)
								{
									<div class="shop-card-dur"><span>@GetShortDuration(item.BoostDurationMinutes)</span></div>
								}
							</div>
						}
					}
				}
				else
				{
					var bossGroups = GetConsumableGroups();
					var caseBoss = GetCaseBossItem();

					foreach (var group in bossGroups)
					{
						<div class="sh-kicker-row">
							<div class="sh-kicker-chip">
								<div class="sh-kicker-chip-inner"><span class="sh-kicker-text">@group.Label</span></div>
							</div>
							<div class="sh-kicker-line"></div>
						</div>

						foreach (var item in group.Items)
						{
							int owned = GetConsumableOwned(item.Id);
							bool maxed = IsConsumableMaxed(item);
							bool isCase = caseBoss != null && caseBoss.Id == item.Id;
							var cardClass = "shop-card" + (isCase ? " selected" : "") + (GetBossTokens() >= item.Cost ? "" : " short");
							var art = ArtPx(item.Icon, 84);

							<div class="@cardClass"
								 onclick=@(() => OnBossCardClick(item))
								 onmouseover=@(() => OnBossCardHover(item))>
								<div class="sat-card-art">
									<img class="sat-card-icon" src=@item.Icon style="width: @(art.w)px; height: @(art.h)px;" />
								</div>
								<div class="sat-card-foot"><span class="sat-card-name">@GetBaseName(item.Name)</span></div>
								@if (maxed)
								{
									<div class="shop-card-price maxed"><span class="shop-card-max">MAX HELD</span></div>
								}
								else
								{
									<div class="shop-card-price">
										<img class="shop-card-coin" src="ui/icons/currency/token.svg" />
										<span class="shop-card-value">@item.Cost.ToString("N0")</span>
									</div>
								}
								@if (owned > 0)
								{
									<div class="sat-qty owned"><span>@OwnedChipText(owned)</span></div>
								}
							</div>
						}
					}
				}
			</div>

			@* Overlay scrollbar — the roster .col-scrollbar recipe: read-only thumb
			   written per tick (scrollbar-color/-width don't parse). Lives in the
			   12px lane right of the 1298 grid. *@
			<div @ref="sbTrackRef" class="sh-scrollbar">
				<div @ref="sbThumbRef" class="sh-sb-thumb"></div>
			</div>
		</div>

		@* ---- THE CASE — 482 × 894 r22, pad 24 → 434 inner ---- *@
		<div class="sh-case">
			@if (shopView == "gold")
			{
				var caseItem = GetCaseGoldItem(GetGoldItems());
				if (caseItem != null)
				{
					bool spotlight = ShopManager.Instance?.IsSpotlight(caseItem) == true
						&& (ShopManager.Instance?.SpotlightDiscountPercent ?? 0) > 0;
					int unit = GetEffectivePrice(caseItem);
					bool multi = SupportsMultiBuy(caseItem);
					int qty = multi ? Math.Max(1, purchaseQty) : 1;
					int total = unit * qty;
					int listTotal = caseItem.Price * qty;
					int deficit = total - GetGold();
					bool running = IsBoostRunning(caseItem);
					int owned = GetOwned(caseItem);
					var art = ArtPx(caseItem.IconPath, 240);
					var ghost = ArtPx(caseItem.IconPath, 160);
					var buy = GetBuyButtonContent(caseItem);

					<div class="sh-case-art">
						<img class="sh-case-img" src=@IconSrc(caseItem) style="width: @(art.w)px; height: @(art.h)px;" />
						@if (spotlight)
						{
							@* The ONE stamp on this surface — the Daily Spotlight sale. *@
							<div class="sh-case-stamp">
								<BbStamp Text="@GetSaleStampText()" Tone="gold" Tilt=@(-3) />
							</div>
						}
					</div>
					<span class="sh-case-name">@caseItem.Name</span>
					<span class="sh-case-desc">@caseItem.Description</span>
					<div class="sh-case-meta">
						@if (caseItem.BoostDurationMinutes > 0)
						{
							<div class="sh-meta-chip">
								<iconify class="sh-meta-glyph" icon="lucide:clock" Size=@(11) Color="rgba(214, 206, 236, 0.7)" />
								<span class="sh-meta-text">@GetDurationText(caseItem.BoostDurationMinutes)</span>
							</div>
							<div class="sh-meta-chip"><span class="sh-meta-text">@GetBoostLabel(caseItem)</span></div>
						}
						@if (caseItem.Id.StartsWith("server_"))
						{
							<div class="sh-meta-chip amber"><span class="sh-meta-text">SERVER-WIDE</span></div>
						}
						@if (HasBundleChip(caseItem))
						{
							<div class="sh-meta-chip"><span class="sh-meta-text">@BundleMetaText(caseItem)</span></div>
						}
						@if (owned > 0)
						{
							<div class="sh-meta-chip"><span class="sh-meta-text">@OwnedChipText(owned)</span></div>
						}
						@if (running)
						{
							<div class="sh-meta-chip amber">
								<iconify class="sh-meta-glyph" icon="lucide:clock" Size=@(11) Color="#e0a030" />
								<span class="sh-meta-text">@(GetBoostTimeText(caseItem) + " LEFT")</span>
							</div>
						}
					</div>
					if (multi)
					{
						@* Qty — a bare − + stepper (no MAX, no "units"). Clamped in ChangeQty
						   to floor(balance ÷ unit). LANE: input (wired 2026-09-02) — the
						   STEPPER stop: A/D = − / + (kb), hold repeats after 0.35s at 8/s on
						   both devices (mousedown/up arm the same repeat), deny blip at the
						   clamp. The ring wraps the − … + group as an r21 pill. *@
						<div @ref="qtyRowRef" class="sh-qty-row">
							<div class="@QtyBtnClass(qty <= 1)" onclick=@(() => OnQtyClick(-1)) onmousedown=@(() => ArmMouseHold(-1)) onmouseup=@ReleaseMouseHold onmouseout=@ReleaseMouseHold onmouseover=@OnQtyHover>
								<iconify class="sh-qty-glyph" icon="lucide:minus" Size=@(18) Color="#f4f1ea" />
							</div>
							<div class="sh-qty-value"><span class="sh-qty-num">@qty</span></div>
							<div class="@QtyBtnClass(qty >= GetMaxBuyQty(caseItem))" onclick=@(() => OnQtyClick(1)) onmousedown=@(() => ArmMouseHold(1)) onmouseup=@ReleaseMouseHold onmouseout=@ReleaseMouseHold onmouseover=@OnQtyHover>
								<iconify class="sh-qty-glyph" icon="lucide:plus" Size=@(18) Color="#f4f1ea" />
							</div>
						</div>
					}
					<div class="sh-case-price">
						@if (spotlight)
						{
							<span class="sh-price-struck">@listTotal.ToString("N0")</span>
						}
						<img class="sh-price-coin" src="ui/icons/currency/money.svg" />
						<span class="sh-price-value">@total.ToString("N0")</span>
						@if (qty > 1)
						{
							<span class="sh-price-mult">@(qty + " × " + unit.ToString("N0"))</span>
						}
					</div>
					<div class="sh-case-deficit"><span class="sh-deficit-text">@(deficit > 0 ? "need +" + deficit.ToString("N0") : "")</span></div>
					@* BUY — the page's one primary (gold; DOC-2 #1 exception: the page
					   chrome is amber so the pressable primary stays the only gold slab).
					   Directly under the price it commits. LANE: motion — `.beat beat-N`
					   is the ONE purchase beat hook (remounts per buy); no rules yet.
					   LANE: input (wired 2026-09-02) — the BUY stop: the page's ONE
					   root-level HDR ring glides here (r16 + 10 → r26) instead of
					   lighting BbButton's own non-HDR `Focused` ring, so the cursor
					   stays one object across grid → stepper → BUY. Space/Enter/E
					   buy; an off slab answers with the deny blip (never dead). *@
					<BbButton @ref="buyBtnRef" Tier="@BuyTier(buy.off)" Size=@(56) Label="@buy.label" Icon="@buy.icon" KeyCap="SPACE"
							  Disabled=@buy.off Class="@BuyClass(buy.off)" OnClick=@BuyCurrent />
					<img class="sh-case-ghost" src=@IconSrc(caseItem) style="width: @(ghost.w)px; height: @(ghost.h)px;" />
				}
			}
			else
			{
				var caseItem = GetCaseBossItem();
				if (caseItem != null)
				{
					int qty = Math.Max(1, purchaseQty);
					int total = caseItem.Cost * qty;
					int deficit = total - GetBossTokens();
					bool maxed = IsConsumableMaxed(caseItem);
					int owned = GetConsumableOwned(caseItem.Id);
					var art = ArtPx(caseItem.Icon, 240);
					var ghost = ArtPx(caseItem.Icon, 160);
					var buy = GetBuyButtonContentConsumable(caseItem);

					<div class="sh-case-art">
						<img class="sh-case-img" src=@caseItem.Icon style="width: @(art.w)px; height: @(art.h)px;" />
					</div>
					<span class="sh-case-name">@caseItem.Name</span>
					<span class="sh-case-desc">@caseItem.Description</span>
					<div class="sh-case-meta">
						<div class="sh-meta-chip"><span class="sh-meta-text">@(L("ui.shop.owned") + " " + owned + " / " + GetConsumableMaxStack(caseItem.Id))</span></div>
					</div>
					if (!maxed)
					{
						<div @ref="qtyRowRef" class="sh-qty-row">
							<div class="@QtyBtnClass(qty <= 1)" onclick=@(() => OnQtyClick(-1)) onmousedown=@(() => ArmMouseHold(-1)) onmouseup=@ReleaseMouseHold onmouseout=@ReleaseMouseHold onmouseover=@OnQtyHover>
								<iconify class="sh-qty-glyph" icon="lucide:minus" Size=@(18) Color="#f4f1ea" />
							</div>
							<div class="sh-qty-value"><span class="sh-qty-num">@qty</span></div>
							<div class="@QtyBtnClass(qty >= GetMaxBuyQty(caseItem))" onclick=@(() => OnQtyClick(1)) onmousedown=@(() => ArmMouseHold(1)) onmouseup=@ReleaseMouseHold onmouseout=@ReleaseMouseHold onmouseover=@OnQtyHover>
								<iconify class="sh-qty-glyph" icon="lucide:plus" Size=@(18) Color="#f4f1ea" />
							</div>
						</div>
					}
					<div class="sh-case-price">
						<img class="sh-price-coin" src="ui/icons/currency/token.svg" />
						<span class="sh-price-value">@total.ToString("N0")</span>
						@if (qty > 1)
						{
							<span class="sh-price-mult">@(qty + " × " + caseItem.Cost.ToString("N0"))</span>
						}
					</div>
					<div class="sh-case-deficit"><span class="sh-deficit-text">@(deficit > 0 ? "need +" + deficit.ToString("N0") : "")</span></div>
					<BbButton @ref="buyBtnRef" Tier="@BuyTier(buy.off)" Size=@(56) Label="@buy.label" Icon="@buy.icon" KeyCap="SPACE"
							  Disabled=@buy.off Class="@BuyClass(buy.off)" OnClick=@BuyCurrent />
					<img class="sh-case-ghost" src=@caseItem.Icon style="width: @(ghost.w)px; height: @(ghost.h)px;" />
				}
			}
		</div>
	</div>

	@* THE LIVING VIOLET RING — the one cursor. Wraps the case item's card, or
	   (kb mode, CASE zone) the stepper group (`.pill` r21) / the BUY slab; hidden
	   in the HEADER zone. Root-level absolute (never clipped by the scroll);
	   position bound from UpdateShopRing each tick, wave via imperative
	   Style.Transform. z 60. *@
	<div @ref="shopRingRef" class="@RingClass()"
		 style="left: @(shopRingL)px; top: @(shopRingT)px; width: @(shopRingW)px; height: @(shopRingH)px;"></div>
</root>

@code {
	// Localization helper — routed only where keys already exist.
	// LANE: audit (loc) — "GOLD" / "BOSS TOKENS" / "SERVER-WIDE" / "CONTRACT INK" /
	// "MAX HELD" / "need +N" have no keys; ui.shop.gold_store ("Gold Store") and
	// ui.shop.boss_store ("Boss Token Store") carry the RETIRED copy.
	private string L( string key ) => LocalizationManager.Get( key );

	// ── Store state ──────────────────────────────────────────────
	private string shopView = "gold";
	private string hoveredStoreChip = null;
	private string hoveredShopItem = null;
	private string hoveredQtyBtn = null;

	// Selection — null = the case shows the first affordable good.
	private ShopItem selectedItem;
	private BossConsumable selectedConsumable;
	private int detailVersion = 0;

	// Multi-buy qty — reset to 1 on any selection change or store swap.
	private int purchaseQty = 1;

	// Purchase beat — ONE hook for the MOTION lane (BUY flash class, remounted
	// per buy via the version key). The HUD gold pill pulses on its own.
	private int buyBeatVersion = 0;
	private float buyBeatUntil = 0f;
	private bool IsBuyBeat => RealTime.Now < buyBeatUntil;

	// Balance pulse (kept — the one currency signal on this page).
	private float goldFlashUntil = 0f;
	private float tokenFlashUntil = 0f;
	private int lastGoldValue = -1;
	private int lastTokenValue = -1;
	private bool IsGoldFlash => RealTime.Now < goldFlashUntil;
	private bool IsTokenFlash => RealTime.Now < tokenFlashUntil;

	// Refs
	private Panel shopGridRef;
	private Panel sbTrackRef, sbThumbRef;
	private Panel shopRingRef;
	// Case-zone ring hosts — one of the two razor branches mounts each.
	private Panel qtyRowRef;
	private Panel buyBtnRef;

	// ============================================================
	// LANE: input (2026-09-02) — THE ONE-DEVICE FLAG (DOC-5 #5, the Skills
	// page's recipe). Root .kbd-mode / .mouse-mode; any nav / confirm / back
	// key takes the keyboard and stamps the mouse position; the mouse
	// reclaims only after REAL travel (≥3px — the engine re-sends onmousemove
	// on every re-render under a parked cursor). Hover handlers IGNORE events
	// in kb mode (DOC-5 #15); every owned :hover is CSS-gated under
	// .mouse-mode, every `.kb-focused` under .kbd-mode.
	// ============================================================
	private enum InputDevice { Mouse, Keyboard }
	private InputDevice lastInputDevice = InputDevice.Mouse;
	private bool IsKbMode => lastInputDevice == InputDevice.Keyboard;
	private Vector2 _kbTakeoverMousePos = new Vector2( -9999f, -9999f );
	private string RootClass => "shop-panel-content " + (IsKbMode ? "kbd-mode" : "mouse-mode");

	// THE CURSOR GRAPH (DOC-5 #11/#21 — geometry-honest):
	//   HEADER  the two store chips (0 GOLD · 1 BOSS TOKENS); A/D swap on
	//           landing; S → grid; W → GameHUD.ExitPanel().
	//   GRID    the case item's card (selection == cursor); WASD true-2D,
	//           clamped, kicker rows are not stops; W off the top row →
	//           HEADER; D off a row's last card → CASE (stepper); Space → CASE (BUY).
	//   CASE    Stepper (A/D = − / +, S → BUY) · BUY (Space buys, W → stepper,
	//           A → grid). Q from CASE/HEADER → grid (claims the back key).
	private enum CursorZone { Grid, Header, Case }
	private enum CaseStop { Stepper, Buy }
	private CursorZone cursorZone = CursorZone.Grid;
	private CaseStop caseStop = CaseStop.Buy;
	private int headerCursor = 0;

	private void SetInputDevice( InputDevice dev )
	{
		if ( lastInputDevice == dev ) return;
		lastInputDevice = dev;
		if ( dev == InputDevice.Keyboard )
		{
			_kbTakeoverMousePos = Mouse.Position;
			// Drop every live hover so a parked mouse can't keep a second
			// element lit (and the hover-sound guards re-arm for the flip back).
			hoveredStoreChip = null;
			hoveredShopItem = null;
			hoveredQtyBtn = null;
		}
		else
		{
			// The mouse owns the page: the cursor is the selection card again;
			// any kb stepper hold ends with the device.
			cursorZone = CursorZone.Grid;
			_kbHoldDir = 0;
		}
	}

	// Root onmousemove — the mouse-mode RECLAIM. Travel-gated: a bare flip
	// would hand the cursor back to the mouse on every keypress re-render.
	private void OnRootMouseMove()
	{
		if ( IsKbMode && (Mouse.Position - _kbTakeoverMousePos).Length >= 3f )
			SetInputDevice( InputDevice.Mouse );
	}

	// A click anywhere re-enters the panel from GameHUD's tab-nav state
	// (the sibling panels' OnPanelClicked recipe).
	private void OnRootClicked() => GameHUD.EnterPanel();

	// ── Hover handlers — hover IS selection (DOC-5 #6), mouse mode only ──
	private void OnStoreChipHover( string id )
	{
		if ( IsKbMode ) return;
		if ( hoveredStoreChip == id ) return;
		hoveredStoreChip = id;
		SoundManager.PlayHover();
	}
	private void ClearStoreChipHover() => hoveredStoreChip = null;

	private void OnStoreChipClick( string store )
	{
		SetInputDevice( InputDevice.Mouse );
		SoundManager.PlayClick();
		SwitchShopView( store );
	}

	// Card hover moves the ONE cursor: the card becomes the case item (the
	// ring + case follow the selection). Silent select — the hover blip is
	// the sound. Ignored while the keyboard drives (synthetic hovers under a
	// parked cursor during scroll-follow).
	private void OnGoldCardHover( ShopItem item )
	{
		if ( IsKbMode || item == null ) return;
		if ( hoveredShopItem == item.Id ) return;
		hoveredShopItem = item.Id;
		SoundManager.PlayHover();
		SelectItem( item, silent: true );
	}

	private void OnBossCardHover( BossConsumable item )
	{
		if ( IsKbMode || item == null ) return;
		if ( hoveredShopItem == item.Id ) return;
		hoveredShopItem = item.Id;
		SoundManager.PlayHover();
		SelectConsumable( item, silent: true );
	}

	// Click = the same selection with the click sound (hover already moved
	// the cursor; the click still answers).
	private void OnGoldCardClick( ShopItem item )
	{
		SetInputDevice( InputDevice.Mouse );
		SelectItem( item, silent: true );
		SoundManager.PlayClick();
	}

	private void OnBossCardClick( BossConsumable item )
	{
		SetInputDevice( InputDevice.Mouse );
		SelectConsumable( item, silent: true );
		SoundManager.PlayClick();
	}

	private void OnQtyHover()
	{
		if ( IsKbMode ) return;
		if ( hoveredQtyBtn == "qty" ) return;
		hoveredQtyBtn = "qty";
		SoundManager.PlayHover();
	}

	// ── Header helpers ───────────────────────────────────────────
	private string GetStoreTitle() => shopView == "boss" ? "BOSS TOKENS" : "GOLD";
	private static int StoreIndex( string store ) => store == "boss" ? 1 : 0;
	private static string StoreAt( int index ) => index == 1 ? "boss" : "gold";
	private bool IsChipKbFocused( string store ) => IsKbMode && cursorZone == CursorZone.Header && headerCursor == StoreIndex( store );
	private string StoreChipClass( string store ) => "sh-store-chip" + (shopView == store ? " on" : "") + (IsChipKbFocused( store ) ? " kb-focused" : "");
	private string BalanceClass() => "sh-balance" + ((shopView == "gold" ? IsGoldFlash : IsTokenFlash) ? " flash" : "");
	private string BalanceGlyph() => shopView == "gold" ? "ui/icons/currency/money.svg" : "ui/icons/currency/token.svg";
	private string BalanceText() => (shopView == "gold" ? GetGold() : GetBossTokens()).ToString( "N0" );
	private string RingClass() => "sh-ring" + (shopRingVisible ? " on" : "") + (shopRingWarm < 2 ? " snap" : "") + (shopRingPill ? " pill" : "");
	private string QtyBtnClass( bool off ) => "sh-qty-btn" + (off ? " off" : "");
	private string BuyClass( bool off ) => "case-buy" + (off ? " off" : "") + (IsBuyBeat ? " beat beat-" + buyBeatVersion : "");
	// Off = the ghost tier (same 434×56 slab, desaturated) — a TIER swap is an
	// attribute change on the root, never a child-slot swap (ghost-child law).
	private string BuyTier( bool off ) => off ? "ghost" : "primary";

	// ── Tamer reads ──────────────────────────────────────────────
	private int GetGold() => TamerManager.Instance?.CurrentTamer?.Gold ?? 0;
	private int GetLevel() => TamerManager.Instance?.CurrentTamer?.Level ?? 1;
	private int GetBossTokens() => TamerManager.Instance?.CurrentTamer?.BossTokens ?? 0;
	private int GetInk() => TamerManager.Instance?.CurrentTamer?.ContractInk ?? 0;

	// Icon src without $-interpolation in markup attributes (razor generator
	// law: interpolated strings in attribute expressions emit broken codegen).
	private string IconSrc( ShopItem item ) => "/" + item.IconPath;
	private string GetSaleStampText() => (int)(ShopManager.Instance?.SpotlightDiscountPercent ?? 15f) + "% OFF TODAY";

	// ── Art at INTEGER scale (DOC-6 #13) ─────────────────────────
	// Sources are 64×64 (ink, slots, boosts, runes) or 51×51 (consumables).
	// Card zone max 84 → 1× (64 / 51); case slab max 240 → 3× 192 / 4× 204;
	// ghost max 160 → 2× 128 / 3× 153. Dims cached from Texture.Load once per
	// path (the BbEmblem SpriteDims recipe); fallback 64.
	private static readonly Dictionary<string, (int w, int h)> _artDims = new();

	private static (int w, int h) ArtDims( string path )
	{
		if ( string.IsNullOrEmpty( path ) ) return (64, 64);
		string key = path.TrimStart( '/' );
		if ( !_artDims.TryGetValue( key, out var d ) )
		{
			d = (64, 64);
			try
			{
				var tex = Texture.Load( FileSystem.Mounted, key );
				if ( tex != null && tex.Width > 0 && tex.Height > 0 ) d = (tex.Width, tex.Height);
			}
			catch { }
			_artDims[key] = d;
		}
		return d;
	}

	private static (int w, int h) ArtPx( string path, int max )
	{
		var d = ArtDims( path );
		int longest = Math.Max( d.w, d.h );
		int scale = Math.Max( 1, max / Math.Max( 1, longest ) );
		return (d.w * scale, d.h * scale);
	}

	private void SwitchShopView( string view )
	{
		if ( shopView == view ) return;
		shopView = view;
		selectedItem = null;
		selectedConsumable = null;
		purchaseQty = 1;
		detailVersion++;
		// A new catalogue under the cursor: the case zone's hosts remount, so
		// the cursor falls back to the grid unless it sits in the header (a
		// header swap keeps the cursor on the chips).
		if ( cursorZone == CursorZone.Case ) cursorZone = CursorZone.Grid;
		_kbHoldDir = 0;
		_mouseHoldDir = 0;
		RequestScrollFollow();
	}

	// ============================================================
	// THE LIVING VIOLET RING — imperative position (the Bag/roster
	// recipe), waving via Style.Transform. Wraps the case item's card.
	// ============================================================
	private int shopRingL, shopRingT, shopRingW = 152, shopRingH = 170;
	private bool shopRingVisible;
	private bool shopRingPill;  // stepper host: r11 + 10 → r21 (one costume per host radius, DOC-5 #9)
	private int shopRingWarm; // <2 = snap to position (no glide) while first rects land
	private const int ShopRingInset = 10; // card r16 + 10 → ring r26

	public override void Tick()
	{
		base.Tick();
		ApplyDevPending();
		UpdateMouseHold();
		UpdateScrollFollow();
		UpdateShopRing();
		ApplyShopRingWave();
		UpdateScrollbar();
	}

	// The ring's host this tick, or null to hide. Mouse mode / GRID zone: the
	// `.selected` card (== the case item), self-hidden outside the grid
	// viewport (a root-level ring is never clipped by the scroll). Kb CASE
	// zone: the stepper − … + group or the BUY slab. HEADER: hidden (the chips
	// wear `.kb-focused`).
	private Rect? ResolveRingHost( out bool pill )
	{
		pill = false;
		if ( IsKbMode && cursorZone == CursorZone.Header ) return null;

		if ( IsKbMode && cursorZone == CursorZone.Case )
		{
			if ( caseStop == CaseStop.Stepper && qtyRowRef != null )
			{
				Panel first = null, last = null;
				foreach ( var c in qtyRowRef.Children )
				{
					if ( !c.HasClass( "sh-qty-btn" ) ) continue;
					if ( first == null ) first = c;
					last = c;
				}
				if ( first != null && last != null && first.Box.Rect.Width > 1f )
				{
					var a = first.Box.Rect;
					var b = last.Box.Rect;
					pill = true;
					return new Rect( a.Left, a.Top, b.Right - a.Left, a.Height );
				}
			}
			if ( buyBtnRef != null && buyBtnRef.Box.Rect.Width > 1f ) return buyBtnRef.Box.Rect;
			return null;
		}

		if ( shopGridRef == null ) return null;
		var gr = shopGridRef.Box.Rect;
		if ( gr.Width < 2f ) return null;
		foreach ( var c in shopGridRef.Children )
		{
			if ( !c.HasClass( "shop-card" ) || !c.HasClass( "selected" ) ) continue;
			var r = c.Box.Rect;
			if ( r.Top < gr.Top - 14f || r.Bottom > gr.Bottom + 14f ) return null;
			return r.Width < 2f ? (Rect?)null : r;
		}
		return null;
	}

	private void UpdateShopRing()
	{
		bool wasVisible = shopRingVisible;
		shopRingVisible = false;

		var rr = Box.Rect;
		if ( rr.Width < 2f ) return;

		var host = ResolveRingHost( out bool pill );
		if ( host == null ) return;
		var cr = host.Value;

		float sc = ScaleFromScreen;
		if ( sc <= 0.01f || float.IsNaN( sc ) || float.IsInfinity( sc ) ) sc = 1f;

		// RING CENTERING LAW (learnings 2026-08-29 / audit 2026-09-02): Style.Left/
		// Top place the PADDING box and the 4px border draws outside it, so
		// L/T = host − inset + 4 and W/H = host + 2·inset − 8 put the ring's
		// OUTER edge exactly `inset` off the host on every side.
		shopRingL = (int)((cr.Left - rr.Left) * sc) - ShopRingInset + 4;
		shopRingT = (int)((cr.Top - rr.Top) * sc) - ShopRingInset + 4;
		shopRingW = (int)(cr.Width * sc) + ShopRingInset * 2 - 8;
		shopRingH = (int)(cr.Height * sc) + ShopRingInset * 2 - 8;
		shopRingPill = pill;

		shopRingVisible = true;
		if ( !wasVisible ) shopRingWarm = 0;       // re-appearing → snap first, glide after
		else if ( shopRingWarm < 2 ) shopRingWarm++;
	}

	// ============================================================
	// KB SCROLL-FOLLOW — the roster's glide recipe (DOC-5 #13): a pending
	// flag resolved in Tick once the cursor card has a rect, endpoints scroll
	// fully to top/bottom (the kicker rows stay reachable to the eye), then a
	// 0.30 exponential step per tick toward the target.
	// ============================================================
	private bool _scrollFollowPending;
	private int _scrollFollowFrames;
	private float gridScrollGlideTarget = -1f;

	private void RequestScrollFollow()
	{
		_scrollFollowPending = true;
		_scrollFollowFrames = 0;
	}

	private void UpdateScrollFollow()
	{
		if ( shopGridRef == null ) return;

		if ( _scrollFollowPending )
		{
			if ( ++_scrollFollowFrames > 12 ) _scrollFollowPending = false; // nothing to follow (empty store)
			int idx = ResolveSelectedShopIndex();
			var panels = shopGridRef.Children.Where( c => c.HasClass( "shop-card" ) ).ToList();
			if ( idx >= 0 && idx < panels.Count && panels[idx].Box.Rect.Height > 1f )
			{
				_scrollFollowPending = false;
				var cur = panels[idx].Box.Rect;
				bool topRow = !panels.Any( p => p.Box.Rect.Top < cur.Top - 1f );
				bool bottomRow = !panels.Any( p => p.Box.Rect.Top > cur.Top + 1f );
				float curOff = shopGridRef.ScrollOffset.y;
				float? t;
				if ( topRow ) t = curOff > 0.5f ? 0f : null;
				else if ( bottomRow )
				{
					float max = Math.Max( 0f, shopGridRef.ScrollSize.y );
					t = Math.Abs( max - curOff ) > 0.5f ? max : null;
				}
				else t = UiGridScroll.ComputeOffset( shopGridRef, panels[idx] );
				if ( t.HasValue ) gridScrollGlideTarget = t.Value;
			}
		}

		if ( gridScrollGlideTarget < 0f ) return;
		float now = shopGridRef.ScrollOffset.y;
		float delta = gridScrollGlideTarget - now;
		if ( Math.Abs( delta ) < 1.5f )
		{
			shopGridRef.ScrollOffset = new Vector2( shopGridRef.ScrollOffset.x, gridScrollGlideTarget );
			gridScrollGlideTarget = -1f;
			return;
		}
		shopGridRef.ScrollOffset = new Vector2( shopGridRef.ScrollOffset.x, now + delta * 0.30f );
	}

	// The liquid ink-lean — the menu cursor's multi-sine at the PawPad's
	// ×0.6 amplitude + out-of-phase breathing. Imperative transform:
	// repaints the ring alone, never re-renders.
	private void ApplyShopRingWave()
	{
		if ( shopRingRef == null || !shopRingVisible ) return;
		float wt = Time.Now;
		float skX = ( 2.0f * MathF.Sin( wt * 2.2f ) + 0.7f * MathF.Sin( wt * 3.5f + 1.1f ) ) * 0.6f;
		float skY = ( 2.3f * MathF.Sin( wt * 1.8f + 1.9f ) + 0.9f * MathF.Sin( wt * 2.9f ) ) * 0.6f;
		float rotZ = ( 1.1f * MathF.Sin( wt * 1.0f ) + 0.5f * MathF.Sin( wt * 2.4f + 0.5f ) ) * 0.6f;
		float brX = 1f + 0.013f * MathF.Sin( wt * 1.35f + 0.7f ) + 0.006f * MathF.Sin( wt * 2.7f );
		float brY = 1f + 0.013f * MathF.Sin( wt * 1.15f + 2.6f ) + 0.006f * MathF.Sin( wt * 2.3f + 1.4f );

		var t = new PanelTransform();
		t.AddRotation( 0f, 0f, rotZ );
		t.AddSkew( skX, skY, 0f );
		t.AddScale( new Vector2( brX, brY ) );
		shopRingRef.Style.Transform = t;
	}

	// ============================================================
	// OVERLAY SCROLLBAR — the roster UpdateScrollbar recipe (read-only
	// thumb, imperative Style writes, only-on-change caches; caches reset
	// when a template swap remounts the track).
	// ============================================================
	private int _sbTop = int.MinValue, _sbH = int.MinValue, _sbTrackH = int.MinValue;
	private Panel _sbSeen;

	private void UpdateScrollbar()
	{
		if ( !ReferenceEquals( _sbSeen, sbThumbRef ) )
		{ _sbSeen = sbThumbRef; _sbTop = _sbH = _sbTrackH = int.MinValue; }

		var scroll = shopGridRef;
		var track = sbTrackRef;
		var thumb = sbThumbRef;
		if ( track == null || thumb == null ) return;

		float maxOff = scroll?.ScrollSize.y ?? 0f;
		float viewH = scroll?.Box.Rect.Height ?? 0f;
		if ( scroll == null || maxOff < 2f || viewH <= 0f )
		{
			track.SetClass( "on", false ); // content fits — hide entirely
			return;
		}

		float sc = ScaleFromScreen;
		if ( sc <= 0.01f || float.IsNaN( sc ) || float.IsInfinity( sc ) ) sc = 1f;

		// Track top 8 (SCSS) + 8 bottom breathing = 16 trimmed.
		int trackH = (int)(viewH * sc) - 16;
		if ( trackH < 40 ) { track.SetClass( "on", false ); return; }

		float contentH = viewH + maxOff;
		int h = Math.Max( 24, (int)(trackH * (viewH / contentH)) );
		float t01 = Math.Clamp( scroll.ScrollOffset.y / maxOff, 0f, 1f );
		int top = (int)((trackH - h) * t01);

		if ( trackH != _sbTrackH ) { _sbTrackH = trackH; track.Style.Height = Length.Pixels( trackH ); }
		if ( h != _sbH ) { _sbH = h; thumb.Style.Height = Length.Pixels( h ); }
		if ( top != _sbTop ) { _sbTop = top; thumb.Style.Top = Length.Pixels( top ); }
		track.SetClass( "on", true );
	}

	// ============================================================
	// KEYBOARD — called by GameHUD.TickCurrentPanel() (already gated on
	// UIModalState.AnyModalOpen + IsNavigatingTabs; re-checked here for the
	// chat focus + a defensive modal check). LANE: input 2026-09-02.
	//
	// KEY MAP (DOC-5 #1 grammar):
	//   WASD / arrows  move the ONE cursor (true-2D grid · header chips ·
	//                  case stops)          Space / Enter / E  confirm
	//   Q (Shift)      back — CASE/HEADER → grid (claims the key); GRID →
	//                  the two-stage exit (home the case + qty 1, then exit)
	//   Z / X          SILENT store cycle from any zone (DOC-5 #1 pair)
	//   A / D on the STEPPER stop = − / + (hold repeats); on the HEADER = swap
	// ============================================================
	public void TickInput()
	{
		try
		{
			if ( ChatPanel.IsChatFocused ) return;
			if ( UIModalState.AnyModalOpen ) return;
			EnsureCursor();
			UpdateKbHold();
			HandleShopKeyboardInput();
		}
		catch ( Exception ex )
		{
			Log.Warning( $"ShopPanelContent.TickInput error: {ex.Message}" );
		}
	}

	// Coerce the cursor onto a stop that is actually mounted: the stepper
	// unmounts for singletons / a maxed boss good (DOC-5 #12 — build the
	// same live list the markup does).
	private void EnsureCursor()
	{
		if ( cursorZone == CursorZone.Case && caseStop == CaseStop.Stepper && !StepperMounted() )
			caseStop = CaseStop.Buy;
		if ( cursorZone == CursorZone.Header ) headerCursor = Math.Clamp( headerCursor, 0, 1 );
	}

	private bool StepperMounted()
	{
		if ( shopView == "gold" )
		{
			var c = GetCaseGoldItem( GetGoldItems() );
			return c != null && SupportsMultiBuy( c );
		}
		var b = GetCaseBossItem();
		return b != null && !IsConsumableMaxed( b );
	}

	// Index of the case item within the grid's render order. -1 when none.
	private int ResolveSelectedShopIndex()
	{
		if ( shopView == "gold" )
		{
			var items = GetGoldItems();
			var ordered = GroupGoldSections( items ).SelectMany( s => s.Items ).ToList();
			var c = GetCaseGoldItem( items );
			return c == null ? -1 : ordered.FindIndex( i => i.Id == c.Id );
		}

		var bossItems = GetConsumableGroups().SelectMany( g => g.Items ).ToList();
		var cb = GetCaseBossItem();
		return cb == null ? -1 : bossItems.FindIndex( i => i.Id == cb.Id );
	}

	private int GridCount() => shopView == "gold"
		? GroupGoldSections( GetGoldItems() ).SelectMany( s => s.Items ).Count()
		: GetConsumableGroups().SelectMany( g => g.Items ).Count();

	// Select the K-th card in render order — the kb cursor move (hover blip,
	// not the click) + scroll-follow.
	private void SelectIndex( int idx )
	{
		if ( idx < 0 ) return;
		if ( shopView == "gold" )
		{
			var items = GroupGoldSections( GetGoldItems() ).SelectMany( s => s.Items ).ToList();
			if ( idx >= items.Count ) return;
			SelectItem( items[idx], silent: true );
		}
		else
		{
			var items = GetConsumableGroups().SelectMany( g => g.Items ).ToList();
			if ( idx >= items.Count ) return;
			SelectConsumable( items[idx], silent: true );
		}
		SoundManager.PlayHover();
		RequestScrollFollow();
	}

	// The K-th .shop-card child of the grid is item K in render order.
	private List<Panel> CardPanels() => shopGridRef == null
		? new List<Panel>()
		: shopGridRef.Children.Where( c => c.HasClass( "shop-card" ) ).ToList();

	// TRUE-2D vertical step: the card in the nearest row above/below whose
	// horizontal centre is closest. Kicker rows are not cards, so W/S skip
	// them. -1 = no row that way (the grid's top/bottom edge).
	private int GetVerticalNeighbor( int idx, int itemCount, bool down )
	{
		var panels = CardPanels();
		if ( panels.Count != itemCount || idx < 0 || idx >= panels.Count ) return -1;

		var cur = panels[idx].Box.Rect;
		float curCentreX = cur.Left + cur.Width * 0.5f;
		float curTop = cur.Top;

		int best = -1;
		float bestRowDist = float.MaxValue;
		float bestDX = float.MaxValue;
		for ( int i = 0; i < panels.Count; i++ )
		{
			if ( i == idx ) continue;
			var r = panels[i].Box.Rect;
			if ( down ? r.Top <= curTop + 1f : r.Top >= curTop - 1f ) continue;
			float rowDist = Math.Abs( r.Top - curTop );
			float dx = Math.Abs( (r.Left + r.Width * 0.5f) - curCentreX );
			if ( rowDist < bestRowDist - 1f || (rowDist <= bestRowDist + 1f && dx < bestDX) )
			{
				best = i;
				bestRowDist = rowDist;
				bestDX = dx;
			}
		}
		return best;
	}

	// TRUE-2D horizontal step within the SAME row (same rect Top) — clamped,
	// no wrap. -1 = the row's edge (A: stay · D: enter the case). Falls back
	// to flat ±1 before the first layout lands.
	private int GetHorizontalNeighbor( int idx, int itemCount, bool right )
	{
		var panels = CardPanels();
		if ( panels.Count != itemCount || idx < 0 || idx >= panels.Count )
		{
			int flat = right ? idx + 1 : idx - 1;
			return flat >= 0 && flat < itemCount ? flat : -1;
		}

		var cur = panels[idx].Box.Rect;
		int best = -1;
		float bestDX = float.MaxValue;
		for ( int i = 0; i < panels.Count; i++ )
		{
			if ( i == idx ) continue;
			var r = panels[i].Box.Rect;
			if ( Math.Abs( r.Top - cur.Top ) > 1f ) continue;
			float dx = right ? r.Left - cur.Left : cur.Left - r.Left;
			if ( dx <= 1f || dx >= bestDX ) continue;
			best = i;
			bestDX = dx;
		}
		return best;
	}

	private void HandleShopKeyboardInput()
	{
		// Z / X — the silent store cycle (DOC-5 #1 pair), any zone. A header
		// cursor follows the active chip; a case cursor falls back to the grid
		// (SwitchShopView); the grid cursor lands on the new store's case item.
		if ( Input.Pressed( "CyclePrev" ) || Input.Pressed( "CycleNext" ) )
		{
			SetInputDevice( InputDevice.Keyboard );
			SwitchShopView( shopView == "gold" ? "boss" : "gold" );
			if ( cursorZone == CursorZone.Header ) headerCursor = StoreIndex( shopView );
			SoundManager.PlayClick();
			return;
		}

		int dir = -1; // 0 up · 1 down · 2 left · 3 right
		if ( Input.Pressed( "Up" ) ) dir = 0;
		else if ( Input.Pressed( "Down" ) ) dir = 1;
		else if ( Input.Pressed( "Left" ) ) dir = 2;
		else if ( Input.Pressed( "Right" ) ) dir = 3;
		bool confirm = UiInput.ConfirmPressed();
		bool back = Input.Pressed( "Menu" ) || Input.Pressed( "run" );
		if ( dir < 0 && !confirm && !back ) return;

		SetInputDevice( InputDevice.Keyboard );

		switch ( cursorZone )
		{
			case CursorZone.Header: HandleHeaderKeys( dir, confirm, back ); break;
			case CursorZone.Case: HandleCaseKeys( dir, confirm, back ); break;
			default: HandleGridKeys( dir, confirm, back ); break;
		}
	}

	// ── HEADER zone — the two store chips ──
	private void HandleHeaderKeys( int dir, bool confirm, bool back )
	{
		if ( back )
		{
			cursorZone = CursorZone.Grid;
			SoundManager.PlayBack();
			RequestScrollFollow();
			GameHUD.PanelHandledBackKey = true;
			return;
		}
		if ( confirm )
		{
			// The chip under the cursor is already the active store (A/D swap
			// on landing) — a confirm re-asserts it, never a dead press.
			SwitchShopView( StoreAt( headerCursor ) );
			SoundManager.PlayClick();
			return;
		}
		switch ( dir )
		{
			case 2: // A → GOLD
			case 3: // D → BOSS TOKENS — swap IMMEDIATELY (the hub's segment law)
				{
					int next = Math.Clamp( headerCursor + (dir == 3 ? 1 : -1), 0, 1 );
					if ( next == headerCursor ) return; // clamp — silent
					headerCursor = next;
					SwitchShopView( StoreAt( headerCursor ) );
					SoundManager.PlayClick();
					return;
				}
			case 1: // S → back down to the grid (the case item's card)
				cursorZone = CursorZone.Grid;
				SoundManager.PlayHover();
				RequestScrollFollow();
				return;
			case 0: // W → the header is the top of the page: exit the panel
				GameHUD.ExitPanel();
				return;
		}
	}

	// ── GRID zone — the cursor card IS the case item ──
	private void HandleGridKeys( int dir, bool confirm, bool back )
	{
		int count = GridCount();
		int idx = ResolveSelectedShopIndex();

		if ( back )
		{
			// Two-stage back (kept): stage 1 homes the case (first affordable,
			// qty 1) and CLAIMS the key; stage 2 (already home) genuinely exits.
			if ( shopView == "gold" )
			{
				var all = GetGoldItems();
				bool home = selectedItem == null || (GetDefaultGoldItem( all )?.Id == selectedItem.Id);
				if ( !home || purchaseQty != 1 )
				{
					selectedItem = null; purchaseQty = 1; detailVersion++; SoundManager.PlayBack();
					RequestScrollFollow();
					GameHUD.PanelHandledBackKey = true;
				}
				else GameHUD.ExitPanel();
			}
			else
			{
				bool home = selectedConsumable == null || (GetDefaultBossItem()?.Id == selectedConsumable.Id);
				if ( !home || purchaseQty != 1 )
				{
					selectedConsumable = null; purchaseQty = 1; detailVersion++; SoundManager.PlayBack();
					RequestScrollFollow();
					GameHUD.PanelHandledBackKey = true;
				}
				else GameHUD.ExitPanel();
			}
			return;
		}

		if ( count == 0 ) return;
		if ( idx < 0 ) { SelectIndex( 0 ); return; }

		if ( confirm )
		{
			// RULING (job 2): Space on a card never buys — the cursor card is
			// already the case item, so confirm carries the intent INTO the case
			// and parks on BUY; the second Space commits. Two presses, never an
			// accidental 250k storage buy.
			EnterCase( CaseStop.Buy );
			return;
		}

		switch ( dir )
		{
			case 2: // A — same row, clamped (silent at the row's first card)
				{
					int n = GetHorizontalNeighbor( idx, count, false );
					if ( n >= 0 ) SelectIndex( n );
					return;
				}
			case 3: // D — same row, else off the row's last card into the case
				{
					int n = GetHorizontalNeighbor( idx, count, true );
					if ( n >= 0 ) SelectIndex( n );
					else EnterCase( CaseStop.Stepper );
					return;
				}
			case 0: // W — the row above, else the header chips
				{
					int n = GetVerticalNeighbor( idx, count, false );
					if ( n >= 0 ) { SelectIndex( n ); return; }
					cursorZone = CursorZone.Header;
					headerCursor = StoreIndex( shopView );
					gridScrollGlideTarget = 0f; // a cursor leaving upward glides the grid home (DOC-5 #13)
					SoundManager.PlayHover();
					return;
				}
			case 1: // S — the row below, clamped at the bottom row
				{
					int n = GetVerticalNeighbor( idx, count, true );
					if ( n >= 0 ) SelectIndex( n );
					return;
				}
		}
	}

	private void EnterCase( CaseStop preferred )
	{
		cursorZone = CursorZone.Case;
		caseStop = preferred == CaseStop.Stepper && StepperMounted() ? CaseStop.Stepper : CaseStop.Buy;
		SoundManager.PlayHover();
	}

	private void LeaveCaseToGrid( bool isBack )
	{
		cursorZone = CursorZone.Grid;
		_kbHoldDir = 0;
		if ( isBack ) { SoundManager.PlayBack(); GameHUD.PanelHandledBackKey = true; }
		else SoundManager.PlayHover();
		RequestScrollFollow();
	}

	// ── CASE zone — STEPPER stop (A/D = − / +) · BUY stop (Space buys) ──
	private void HandleCaseKeys( int dir, bool confirm, bool back )
	{
		if ( back ) { LeaveCaseToGrid( isBack: true ); return; }

		if ( caseStop == CaseStop.Stepper )
		{
			if ( confirm ) { caseStop = CaseStop.Buy; SoundManager.PlayHover(); return; } // confirm advances to BUY
			switch ( dir )
			{
				case 2: ChangeQty( -1 ); ArmKbHold( -1 ); return; // clamp = deny blip inside ChangeQty
				case 3: ChangeQty( 1 ); ArmKbHold( 1 ); return;
				case 1: caseStop = CaseStop.Buy; SoundManager.PlayHover(); return;
				case 0: return; // nothing above the stepper — clamp (silent)
			}
			return;
		}

		// BUY stop
		if ( confirm ) { BuyCurrent(); return; } // off slab → PurchaseX plays the deny blip
		switch ( dir )
		{
			case 0: // W → the stepper (when mounted); a singleton's BUY has nothing above
				if ( StepperMounted() ) { caseStop = CaseStop.Stepper; SoundManager.PlayHover(); }
				return;
			case 2: LeaveCaseToGrid( isBack: false ); return; // A → the grid's cursor card
			case 1: // S — BUY is the case's floor
			case 3: // D — nothing right of the case
				return;
		}
	}

	// ============================================================
	// GOLD goods — the 30 ShopManager goods in four sections
	// ============================================================
	private List<ShopItem> GetGoldItems()
	{
		var items = ShopManager.Instance?.GetAvailableItems( 100 ) ?? new List<ShopItem>();
		return items.Where( i => i.Currency == CurrencyType.Gold ).ToList();
	}

	public class GoldSection
	{
		public string Key { get; set; }
		public string Label { get; set; }
		public List<ShopItem> Items { get; set; } = new();
	}

	// Grouping verbatim from the shipped page: ContractInk + Consumable →
	// SUPPLIES; the six boost types split personal / `server_` prefix;
	// MonsterSlot → STORAGE.
	private List<GoldSection> GroupGoldSections( List<ShopItem> items )
	{
		var result = new List<GoldSection>();

		var supplies = items.Where( i => i.Type == ShopItemType.ContractInk || i.Type == ShopItemType.Consumable ).ToList();
		var boosts = items.Where( IsBoostItem ).ToList();
		var storage = items.Where( i => i.Type == ShopItemType.MonsterSlot ).ToList();

		if ( supplies.Count > 0 ) result.Add( new GoldSection { Key = "supplies", Label = L( "ui.shop.supplies" ).ToUpperInvariant(), Items = supplies } );
		if ( boosts.Count > 0 )
		{
			var personal = boosts.Where( i => !i.Id.StartsWith( "server_" ) ).ToList();
			var server = boosts.Where( i => i.Id.StartsWith( "server_" ) ).ToList();
			if ( personal.Count > 0 ) result.Add( new GoldSection { Key = "boosts", Label = L( "ui.shop.boosts" ).ToUpperInvariant(), Items = personal } );
			if ( server.Count > 0 ) result.Add( new GoldSection { Key = "server", Label = "SERVER-WIDE", Items = server } );
		}
		if ( storage.Count > 0 ) result.Add( new GoldSection { Key = "storage", Label = L( "ui.shop.storage" ).ToUpperInvariant(), Items = storage } );

		// Keep ShopManager's spotlight id in sync with the UI's pick (the shipped
		// ladder: storage ≥ 250k → priciest personal boost → priciest good).
		SyncSpotlight( items );
		return result;
	}

	private void SyncSpotlight( List<ShopItem> items )
	{
		if ( items == null || items.Count == 0 ) return;
		ShopItem picked = null;
		bool canExpandStorage = MonsterManager.Instance?.CanExpandStorage ?? true;
		if ( canExpandStorage )
			picked = items.FirstOrDefault( i => i.Type == ShopItemType.MonsterSlot && i.Price >= 250000 );
		if ( picked == null )
			picked = items.Where( i => !i.Id.StartsWith( "server_" ) && IsBoostItem( i ) ).OrderByDescending( i => i.Price ).FirstOrDefault();
		if ( picked == null )
			picked = items.Where( i => !i.Id.StartsWith( "server_" ) ).OrderByDescending( i => i.Price ).FirstOrDefault();
		if ( picked != null ) ShopManager.Instance?.SetSpotlight( picked.Id );
	}

	// The case NEVER empties (NO NOTHING): selection, else the first good the
	// player can actually buy, else the first good.
	private ShopItem GetDefaultGoldItem( List<ShopItem> items )
	{
		var ordered = GroupGoldSections( items ).SelectMany( s => s.Items ).ToList();
		return ordered.FirstOrDefault( CanPurchase ) ?? ordered.FirstOrDefault();
	}

	private ShopItem GetCaseGoldItem( List<ShopItem> items )
	{
		if ( selectedItem != null && items.Any( i => i.Id == selectedItem.Id ) ) return selectedItem;
		return GetDefaultGoldItem( items );
	}

	private bool IsBoostItem( ShopItem item )
	{
		return item.Type == ShopItemType.TamerXPBoost || item.Type == ShopItemType.BeastXPBoost || item.Type == ShopItemType.XPBoost
			|| item.Type == ShopItemType.GoldBoost || item.Type == ShopItemType.RareEncounter || item.Type == ShopItemType.LuckyCharm;
	}

	// Boost state is per TYPE (ShopManager.IsBoostActive) — both Gold Boost
	// goods show the same running timer, honestly.
	private bool IsBoostRunning( ShopItem item ) => IsBoostItem( item ) && (ShopManager.Instance?.IsBoostActive( item.Type ) ?? false);

	private bool IsAtBoostLimit( ShopItem item )
	{
		if ( !IsBoostItem( item ) ) return false;
		if ( IsBoostRunning( item ) ) return true;
		if ( item.Id.StartsWith( "server_" ) )
			return !(ShopManager.Instance?.CanActivateServerBoost( item.Type ) ?? true);
		return !(ShopManager.Instance?.CanActivateBoost( item.Type ) ?? true);
	}

	private bool IsStorageMaxed( ShopItem item )
	{
		if ( item.Type != ShopItemType.MonsterSlot ) return false;
		return !(MonsterManager.Instance?.CanExpandStorage ?? true);
	}

	// ADD 2 — the ShopItem → inventory-id map. Consumables share their id with
	// the ItemDefinition (ApplyItemEffect's Consumable branch). Ink is a
	// currency and storage a permanent unlock (no inventory row).
	// LANE: systems — boosts land in inventory via ShopManager's PRIVATE
	// GetInventoryItemIdForBoost (boost_tamer_xp_1h …); expose it publicly and
	// route it here so boost cards can carry an owned count too.
	private string GetInventoryId( ShopItem item ) => item?.Type == ShopItemType.Consumable ? item.Id : null;

	private int GetOwned( ShopItem item )
	{
		var id = GetInventoryId( item );
		return id == null ? 0 : (ItemManager.Instance?.GetItemCount( id ) ?? 0);
	}

	// Corner chip — ONE slot, two meanings by kind: bundle count (ink ×5,
	// storage +50, tan) OR owned count (cream). Ink/storage never carry an
	// owned count, consumables never a bundle, so the two never co-occur.
	private bool HasBundleChip( ShopItem item ) => item.Quantity > 1 && item.Type != ShopItemType.Consumable;
	private string BundleChipText( ShopItem item ) => (item.Type == ShopItemType.MonsterSlot ? "+" : "×") + item.Quantity;
	private string BundleMetaText( ShopItem item ) => item.Type == ShopItemType.MonsterSlot ? "+" + item.Quantity + " SLOTS" : "×" + item.Quantity + " CONTRACT INK";
	private string OwnedChipText( int owned ) => L( "ui.shop.owned" ) + " " + owned;

	// Affordability uses the EFFECTIVE (post-discount) price everywhere —
	// ShopManager.PurchaseItem charges the same amount.
	private int GetEffectivePrice( ShopItem item ) => ShopManager.Instance?.GetDiscountedPrice( item ) ?? item.Price;
	private bool CanAfford( ShopItem item ) => GetGold() >= GetEffectivePrice( item );

	private bool CanPurchase( ShopItem item ) =>
		CanAfford( item )
		&& GetLevel() >= item.RequiredLevel
		&& item.IsInStock
		&& !IsAtBoostLimit( item )
		&& !IsStorageMaxed( item );

	// ── Multi-buy ────────────────────────────────────────────────
	// Stackable goods only: ink packs + personal boosts (inventory items) and
	// every boss-token good. Server boosts and storage are singletons.
	private bool SupportsMultiBuy( ShopItem item )
	{
		if ( item == null ) return false;
		if ( item.Id.StartsWith( "server_" ) ) return false;
		if ( item.Type == ShopItemType.ContractInk || item.Type == ShopItemType.Consumable ) return true;
		if ( IsBoostItem( item ) ) return true;
		return false;
	}

	// Cap = floor(balance ÷ unit), never below 1 so the stepper always has a floor.
	private int GetMaxBuyQty( ShopItem item )
	{
		if ( item == null ) return 1;
		int unit = GetEffectivePrice( item );
		if ( unit <= 0 ) return 1;
		return Math.Max( 1, GetGold() / unit );
	}

	private int GetMaxBuyQty( BossConsumable item )
	{
		if ( item == null ) return 1;
		int unit = item.Cost;
		if ( unit <= 0 ) return 1;
		int byBalance = GetBossTokens() / unit;
		int stackRoom = GetConsumableMaxStack( item.Id ) - GetConsumableOwned( item.Id );
		return Math.Max( 1, Math.Max( 0, Math.Min( byBalance, stackRoom ) ) );
	}

	// Returns false at the clamp (deny blip played) so hold-repeat can stop.
	private bool ChangeQty( int delta )
	{
		int next = purchaseQty + delta;
		int max = 1;
		if ( shopView == "gold" )
		{
			var c = GetCaseGoldItem( GetGoldItems() );
			if ( c != null && SupportsMultiBuy( c ) ) { selectedItem = c; max = GetMaxBuyQty( c ); }
		}
		else
		{
			var c = GetCaseBossItem();
			if ( c != null ) { selectedConsumable = c; max = GetMaxBuyQty( c ); }
		}
		int clamped = Math.Max( 1, Math.Min( max, next ) );
		if ( clamped == purchaseQty ) { SoundManager.PlayDeny(); return false; }
		purchaseQty = clamped;
		SoundManager.PlayClick();
		return true;
	}

	// ============================================================
	// STEPPER HOLD-REPEAT (job 5) — holding − / + repeats after 0.35s at
	// ~8/s on BOTH devices; the clamp answers once with the deny blip and
	// ends the hold (no 8/s deny chatter). Replaces MAX for bulk ink buys.
	// ============================================================
	private const float HoldDelay = 0.35f;
	private const float HoldPeriod = 0.125f;

	// Keyboard: armed by the A/D press on the stepper stop, polled in TickInput.
	private int _kbHoldDir;
	private float _kbHoldNext;

	// Mouse: armed by onmousedown on a qty button, released by mouseup/mouseout,
	// polled in Tick (panel tick — works even when GameHUD isn't routing keys).
	private int _mouseHoldDir;
	private float _mouseHoldNext;
	private bool _mouseHoldRepeated;
	private bool _suppressNextQtyClick;

	private void ArmKbHold( int dir )
	{
		_kbHoldDir = dir;
		_kbHoldNext = RealTime.Now + HoldDelay;
	}

	private void UpdateKbHold()
	{
		if ( _kbHoldDir == 0 ) return;
		if ( !IsKbMode || cursorZone != CursorZone.Case || caseStop != CaseStop.Stepper ) { _kbHoldDir = 0; return; }
		if ( !Input.Down( _kbHoldDir < 0 ? "Left" : "Right" ) ) { _kbHoldDir = 0; return; }
		if ( RealTime.Now < _kbHoldNext ) return;
		if ( !ChangeQty( _kbHoldDir ) ) { _kbHoldDir = 0; return; }
		_kbHoldNext = RealTime.Now + HoldPeriod;
	}

	private void ArmMouseHold( int dir )
	{
		SetInputDevice( InputDevice.Mouse );
		_mouseHoldDir = dir;
		_mouseHoldNext = RealTime.Now + HoldDelay;
		_mouseHoldRepeated = false;
		_suppressNextQtyClick = false;
	}

	// mouseup fires BEFORE click on the same element: a hold that already
	// repeated eats the release-click so the count doesn't jump one extra.
	private void ReleaseMouseHold()
	{
		if ( _mouseHoldDir != 0 && _mouseHoldRepeated ) _suppressNextQtyClick = true;
		_mouseHoldDir = 0;
	}

	private void UpdateMouseHold()
	{
		if ( _mouseHoldDir == 0 ) return;
		if ( RealTime.Now < _mouseHoldNext ) return;
		_mouseHoldRepeated = true;
		if ( !ChangeQty( _mouseHoldDir ) ) { _mouseHoldDir = 0; return; }
		_mouseHoldNext = RealTime.Now + HoldPeriod;
	}

	private void OnQtyClick( int delta )
	{
		SetInputDevice( InputDevice.Mouse );
		if ( _suppressNextQtyClick ) { _suppressNextQtyClick = false; return; }
		ChangeQty( delta );
	}

	private int GetTotalPrice( ShopItem item )
	{
		int qty = SupportsMultiBuy( item ) ? Math.Max( 1, purchaseQty ) : 1;
		return GetEffectivePrice( item ) * qty;
	}

	private bool CanPurchaseQty( ShopItem item )
	{
		if ( item == null ) return false;
		if ( GetGold() < GetTotalPrice( item ) ) return false;
		if ( GetLevel() < item.RequiredLevel ) return false;
		if ( !item.IsInStock ) return false;
		if ( IsAtBoostLimit( item ) ) return false;
		if ( IsStorageMaxed( item ) ) return false;
		return true;
	}

	private bool CanPurchaseConsumableQty( BossConsumable item )
	{
		if ( item == null ) return false;
		int qty = Math.Max( 1, purchaseQty );
		if ( GetBossTokens() < item.Cost * qty ) return false;
		if ( IsConsumableMaxed( item ) ) return false;
		int stackRoom = GetConsumableMaxStack( item.Id ) - GetConsumableOwned( item.Id );
		if ( stackRoom < qty ) return false;
		return true;
	}

	// ------------------------------------------------------------
	// Unified BUY content — computed as a tuple so BbButton renders ONE
	// iconify + ONE span and only swaps attribute values (the ghost-child
	// law). `off` = the desaturated non-pressable slab (same size, BIG
	// THINGS BIG). Copy is plain words; the qty rides the label.
	// ------------------------------------------------------------
	private (string icon, string label, bool off) GetBuyButtonContent( ShopItem item )
	{
		if ( IsBuyBeat ) return ("lucide:check", "BOUGHT", false);
		if ( item == null ) return ("lucide:shopping-bag", L( "ui.shop.buy" ).ToUpperInvariant(), true);

		int qty = SupportsMultiBuy( item ) ? Math.Max( 1, purchaseQty ) : 1;
		int total = GetEffectivePrice( item ) * qty;

		if ( GetLevel() < item.RequiredLevel ) return ("lucide:lock", "LEVEL " + item.RequiredLevel, true);
		if ( IsBoostItem( item ) && IsBoostRunning( item ) && item.Id.StartsWith( "server_" ) )
			return ("lucide:zap", L( "ui.shop.active" ).ToUpperInvariant(), true);
		if ( IsBoostItem( item ) && IsAtBoostLimit( item ) ) return ("lucide:zap", "BOOST FULL", true);
		if ( IsStorageMaxed( item ) ) return ("lucide:archive", "STORAGE FULL", true);
		if ( GetGold() < total ) return ("lucide:x", "NEED +" + (total - GetGold()).ToString( "N0" ), true);

		string buy = L( "ui.shop.buy" ).ToUpperInvariant();
		return ("lucide:shopping-bag", qty > 1 ? buy + " ×" + qty : buy, false);
	}

	private (string icon, string label, bool off) GetBuyButtonContentConsumable( BossConsumable item )
	{
		if ( IsBuyBeat ) return ("lucide:check", "BOUGHT", false);
		if ( item == null ) return ("lucide:shopping-bag", L( "ui.shop.buy" ).ToUpperInvariant(), true);

		int qty = Math.Max( 1, purchaseQty );
		int total = item.Cost * qty;

		if ( IsConsumableMaxed( item ) ) return ("lucide:archive", "MAX HELD", true);
		int stackRoom = GetConsumableMaxStack( item.Id ) - GetConsumableOwned( item.Id );
		if ( stackRoom < qty ) return ("lucide:archive", "ROOM FOR " + stackRoom, true);
		if ( GetBossTokens() < total ) return ("lucide:x", "NEED +" + (total - GetBossTokens()).ToString( "N0" ), true);

		string buy = L( "ui.shop.buy" ).ToUpperInvariant();
		return ("lucide:shopping-bag", qty > 1 ? buy + " ×" + qty : buy, false);
	}

	// `silent` = the caller owns the sound (hover blip / kb cursor hover / click).
	private void SelectItem( ShopItem item, bool silent = false )
	{
		if ( item == null ) return;
		if ( selectedItem?.Id == item.Id ) return;
		selectedItem = item;
		purchaseQty = 1;
		detailVersion++;
		if ( !silent ) SoundManager.PlayClick();
	}

	private void SelectConsumable( BossConsumable item, bool silent = false )
	{
		if ( item == null ) return;
		if ( selectedConsumable?.Id == item.Id ) return;
		selectedConsumable = item;
		purchaseQty = 1;
		detailVersion++;
		if ( !silent ) SoundManager.PlayClick();
	}

	// BUY — buys whatever the case shows (method group for BbButton + Space).
	private void BuyCurrent()
	{
		if ( shopView == "gold" ) PurchaseItem( GetCaseGoldItem( GetGoldItems() ) );
		else PurchaseConsumable( GetCaseBossItem() );
	}

	// ONE beat: the BUY flash class + the balance pulse (CheckCurrencyFlash).
	// The 0.35s defer, particle burst, flyer, card tick and chime ladder are CUT.
	private void PurchaseItem( ShopItem item )
	{
		if ( item == null ) return;
		if ( !CanPurchaseQty( item ) ) { SoundManager.PlayDeny(); return; }

		int qty = SupportsMultiBuy( item ) ? Math.Max( 1, purchaseQty ) : 1;
		if ( selectedItem == null || selectedItem.Id != item.Id ) selectedItem = item;

		int bought = 0;
		for ( int i = 0; i < qty; i++ )
		{
			if ( ShopManager.Instance?.PurchaseItem( item.Id ) != true ) break;
			bought++;
		}

		if ( bought > 0 )
		{
			SoundManager.PlayGoldReward();
			TriggerBuyBeat();
			if ( qty > 1 ) purchaseQty = 1;
		}
		else
		{
			SoundManager.PlayBack();
		}
	}

	private void PurchaseConsumable( BossConsumable item )
	{
		if ( item == null ) return;
		if ( !CanPurchaseConsumableQty( item ) ) { SoundManager.PlayDeny(); return; }

		int qty = Math.Max( 1, purchaseQty );
		if ( selectedConsumable == null || selectedConsumable.Id != item.Id ) selectedConsumable = item;

		int bought = 0;
		for ( int i = 0; i < qty; i++ )
		{
			if ( TamerManager.Instance?.SpendBossTokens( item.Cost ) != true ) break;
			ItemManager.Instance?.AddItem( item.Id );
			bought++;
		}

		if ( bought > 0 )
		{
			TamerManager.Instance?.SaveToCloud();
			MissionManager.Instance?.TrackShopPurchase( 0 );
			SoundManager.PlayGoldReward();
			TriggerBuyBeat();
			if ( qty > 1 ) purchaseQty = 1;
		}
		else
		{
			SoundManager.PlayBack();
		}
	}

	private void TriggerBuyBeat()
	{
		buyBeatVersion++;
		buyBeatUntil = RealTime.Now + 0.5f;
	}

	private void CheckCurrencyFlash()
	{
		int currentGold = GetGold();
		int currentTokens = GetBossTokens();
		if ( lastGoldValue >= 0 && currentGold != lastGoldValue ) goldFlashUntil = RealTime.Now + 0.6f;
		if ( lastTokenValue >= 0 && currentTokens != lastTokenValue ) tokenFlashUntil = RealTime.Now + 0.6f;
		lastGoldValue = currentGold;
		lastTokenValue = currentTokens;
	}

