	// Track if keyboard navigation is active (vs mouse)
	// ═══ ONE DEVICE FLAG (2026-07-06, user-approved input model) —
	// replaces isKeyboardNavigationActive + detailMouseDriving. The last
	// input device drives a root .kbd-mode/.mouse-mode class: ALL
	// .kb-focused styling is CSS-gated under .kbd-mode (one gate instead
	// of per-control C# checks), which kills the fighting-highlights bug
	// class. Entering keyboard mode clears hover state centrally.
	private enum InputDevice { Mouse, Keyboard }
	private InputDevice lastInputDevice = InputDevice.Mouse;
	private bool IsKbMode => lastInputDevice == InputDevice.Keyboard;

	private void SetInputDevice( InputDevice dev )
	{
		if ( lastInputDevice == dev ) return;
		lastInputDevice = dev;
		if ( dev == InputDevice.Keyboard )
		{
			hoveredMonsterId = null;
			hoveredPickerItem = null;
			pendingHoverSelect = null; // kb takes over — drop the hover dwell
		}
	}

	// Root onmousemove (main-menu contract, 2026-07-06: "the mouse and
	// keyboard are fighting each other") — onmouseover never re-fires
	// for movement WITHIN an element, so a PARKED cursor could never
	// reclaim mouse mode by twitching. The root move handler catches it
	// (menu OnMenuMouseMove / SkillTree OnPanelMouseMove precedent —
	// the menu confirms it doesn't swallow events needed elsewhere).
	// Guarded: onmousemove fires every moving frame, so it must only
	// re-render on an actual mode change.
	private void OnRootMouseMove()
	{
		if ( lastInputDevice == InputDevice.Mouse ) return;
		SetInputDevice( InputDevice.Mouse );
		StateHasChanged();
	}

	// Hover blip, honored only in mouse mode — kb scroll-follow slides
	// content under a parked cursor, firing synthetic onmouseover per
	// row; unguarded, those machine-gun the blip while keyboarding.
	// (Replaces every inline `() => SoundManager.PlayHover()` handler.)
	private void OnHoverBlip()
	{
		if ( lastInputDevice == InputDevice.Keyboard ) return;
		SoundManager.PlayHover();
	}

	// ═══ ONE-CURSOR, detail zone (2026-07-06): in mouse mode, hovering a
	// focusable dossier control moves the SAME cursor the keyboard walks
	// (detailFocusIndex + zone) — the `.kb-focused` class IS the cursor
	// in both modes, so there is never a hover-vs-focus pair highlighted.
	// When the user then keyboards, W/S continue from where the mouse
	// left the cursor. No scroll-follow on hover (the control is already
	// under the cursor).
	private void OnDetailControlHover( string id )
	{
		if ( lastInputDevice == InputDevice.Keyboard ) return;
		var items = GetDetailFocusItems();
		for ( int i = 0; i < items.Count; i++ )
		{
			if ( items[i].Id != id ) continue;
			kbFocusZone = "detail";
			if ( detailFocusIndex != i )
			{
				detailFocusIndex = i;
				SoundManager.PlayHover();
			}
			return;
		}
	}

	// ONE-CURSOR, picker rows — mouse hover drives pickerCursorIndex.
	private void OnPickerRowHover( int idx )
	{
		if ( lastInputDevice == InputDevice.Keyboard ) return;
		if ( pickerCursorIndex == idx ) return;
		pickerCursorIndex = idx;
		SoundManager.PlayHover();
	}

	// ONE-CURSOR, release modal — mouse hover drives releaseKbCursor.
	private void OnReleaseBtnHover( int idx )
	{
		if ( lastInputDevice == InputDevice.Keyboard ) return;
		if ( releaseKbCursor == idx ) return;
		releaseKbCursor = idx;
		SoundManager.PlayHover();
	}

	// @ref handles for measuring the live grid layout. The roster grid is a
	// responsive flex-wrap, so the column count must be measured, not hardcoded.
	private Panel rosterGridRef;
	private Panel cardSizeRef;

	// ── THE LIVING VIOLET RING (grid selection cursor) ──────────────────
	// One waving #9b6cff ring wrapping the selected beast's card — the
	// menu/PawPad signature on the flat-panel recipe (no 3D lean here, so
	// no projection: Box.Rect is layout space and flat panels paint at
	// layout). Position is recomputed every Tick from live rects rather
	// than event-latched — the grid scrolls and reflows on filter changes,
	// and this panel already re-renders per frame (SpriteAnimator.
	// GlobalFrame in BuildHash) so the markup style binding costs nothing
	// extra. The ink-lean wave is imperative Style.Transform per frame —
	// repaints the ring alone, never re-renders (PawPad v4.2 law).
	private Panel gridRingRef;
	// Ring scope (user 2026-07-05): the violet cursor belongs to BEAST
	// SELECTION only — no liquid ring over the stage/facts columns.
	// SPLIT 2026-07-06 (user: "the keyboard isnt going over to the
	// details anymore"): the original single gate killed the ring AND
	// the Space handoff + detail kb nav together — only the ring was
	// unwanted. Ring stays off; keyboard zone is back on (focus reads
	// via the .kb-focused bg/border styling, no liquid ring).
	// readonly (not const) so gated blocks don't trip CS0162.
	private static readonly bool DetailRingEnabled = false;
	private static readonly bool DetailKeyboardEnabled = true;
	private int gridRingL, gridRingT, gridRingW = 150, gridRingH = 180;
	private bool gridRingVisible;
	private bool gridRingTight; // detail-zone hosts are small — tighter inset/radius
	private int gridRingWarm; // <2 = snap to position (no glide) while first rects land

	// ── OVERLAY SCROLLBARS (2026-07-05) ─────────────────────────────────
	// s&box's scrollbar-color/-width don't parse (learnings 2026-04-15),
	// so both scroll columns carry a hand-rolled overlay: an absolute
	// track pinned to the column's right edge + a thumb whose top/height
	// are written IMPERATIVELY per tick (OnlineHubPanel ring precedent —
	// Style writes fire CSS transitions and need no BuildHash input).
	// Geometry from the scroll panel's proven API surface: ScrollOffset.y
	// (current), ScrollSize.y (max offset = content − viewport; proven by
	// ScrollFocusedDetailIntoView's scroll-to-bottom), Box.Rect (screen
	// px — commensurate with ScrollOffset per UiGridScroll's math).
	private Panel gridSbTrackRef, gridSbThumbRef, factsSbTrackRef, factsSbThumbRef;
	private int _gridSbTop = int.MinValue, _gridSbH = int.MinValue, _gridSbTrackH = int.MinValue;
	private int _factsSbTop = int.MinValue, _factsSbH = int.MinValue, _factsSbTrackH = int.MinValue;
	// Cache-identity guards: template swaps (normal <-> fusion <-> empty)
	// REMOUNT the track/thumb elements — a stale only-on-change cache
	// would then skip writing onto the fresh element, leaving the thumb
	// at its CSS default. Reset the caches whenever the instance changes.
	private Panel _gridSbSeen, _factsSbSeen;

	private void UpdateScrollbars()
	{
		if ( !ReferenceEquals( _gridSbSeen, gridSbThumbRef ) )
		{ _gridSbSeen = gridSbThumbRef; _gridSbTop = _gridSbH = _gridSbTrackH = int.MinValue; }
		if ( !ReferenceEquals( _factsSbSeen, factsSbThumbRef ) )
		{ _factsSbSeen = factsSbThumbRef; _factsSbTop = _factsSbH = _factsSbTrackH = int.MinValue; }

		// Grid track top 12 (SCSS) + 12 bottom breathing = 24 trimmed.
		UpdateScrollbar( rosterGridRef, gridSbTrackRef, gridSbThumbRef, 24,
			ref _gridSbTop, ref _gridSbH, ref _gridSbTrackH );
		// Facts track top 28 = roof cap 24 + 4; 4 more at the foot = 8.
		UpdateScrollbar( factsScrollRef, factsSbTrackRef, factsSbThumbRef, 8,
			ref _factsSbTop, ref _factsSbH, ref _factsSbTrackH );
	}

	private void UpdateScrollbar( Panel scroll, Panel track, Panel thumb, int trimLayoutPx,
		ref int lastTop, ref int lastH, ref int lastTrackH )
	{
		if ( track == null || thumb == null ) return;

		float maxOff = scroll?.ScrollSize.y ?? 0f;
		float viewH = scroll?.Box.Rect.Height ?? 0f;
		if ( scroll == null || maxOff < 2f || viewH <= 0f )
		{
			track.SetClass( "on", false ); // content fits — hide entirely
			return;
		}

		float sc = ScaleFromScreen;
		if ( sc <= 0.01f || float.IsNaN( sc ) || float.IsInfinity( sc ) ) sc = 1f;

		// Track height derives from the scroll viewport (explicit Style
		// write — absolute top+bottom stretch is unproven in-engine, an
		// explicit height is deterministic).
		int trackH = (int)(viewH * sc) - trimLayoutPx;
		if ( trackH < 40 ) { track.SetClass( "on", false ); return; }

		float contentH = viewH + maxOff;
		int h = Math.Max( 24, (int)(trackH * (viewH / contentH)) );
		float t01 = Math.Clamp( scroll.ScrollOffset.y / maxOff, 0f, 1f );
		int top = (int)((trackH - h) * t01);

		if ( trackH != lastTrackH ) { lastTrackH = trackH; track.Style.Height = Length.Pixels( trackH ); }
		if ( h != lastH ) { lastH = h; thumb.Style.Height = Length.Pixels( h ); }
		if ( top != lastTop ) { lastTop = top; thumb.Style.Top = Length.Pixels( top ); }
		track.SetClass( "on", true );
	}

	// 10px box inset each side; the 4px border lives in SCSS. Declared
	// width/height are CONTENT-box (s&box has no border-box), so the
	// update subtracts the 8px of border to keep the ring concentric.
	private const int GridRingInset = 10;
	// Dossier controls are small — scale the concentric gap down.
	// 8px (was 6): the ring reads as clearly WRAPPING the control
	// (user 2026-07-03: "doesn't actually go around the button").
	private const int DetailRingInset = 8;

	private void UpdateGridRing()
	{
		bool wasVisible = gridRingVisible;
		gridRingVisible = false;
		gridRingTight = false;

		// STAGE ZONE — one cursor language (user mandate 2026-07-02): when
		// keyboard focus hands over to the dossier, the SAME waving ring
		// wraps the focused control there (found via the .kb-focused class
		// the markup already assigns — action slabs, move slots, glyph
		// squares, picker rows). No separate ring system.
		// MOUSE PATH FIRST — LAST-INPUT-WINS (user 2026-07-03: the kb
		// highlight lingered while mousing, and the moused control got no
		// ring in kb mode). A hovered dossier control always takes the
		// ring and suppresses the kb highlight; the next kb nav input
		// reclaims it (SetDetailFocus / FocusDetailZone clear the flag).
		if ( DetailRingEnabled && !showResult && !isFusionMode && detailScrollRef != null && detailScrollRef.HasHovered )
		{
			var hovered = FindHoveredRingHost( detailScrollRef );
			if ( hovered != null && WrapDetailRing( hovered, wasVisible ) )
			{
				SetInputDevice( InputDevice.Mouse );
				return;
			}
		}

		if ( DetailRingEnabled && kbFocusZone == "detail" && IsKbMode && !showResult && !isFusionMode && detailScrollRef != null )
		{
			var focused = FindPanelByClass( detailScrollRef, "kb-focused" );
			if ( focused == null ) return;
			WrapDetailRing( focused, wasVisible );
			return;
		}

		bool want = rosterGridRef != null && !showResult
			&& (isFusionMode ? IsKbMode : SelectedMonster != null);
		if ( !want ) return;

		// Find the selectedMonsterIndex-th card wrapper by fresh traversal
		// (loop @refs don't exist and panel refs die on hotload). Wrappers
		// are DIRECT children of the scroll grid (scroll-container law).
		Panel target = null;
		int n = 0;
		foreach ( var c in rosterGridRef.Children )
		{
			if ( !c.HasClass( "monster-card-wrapper" ) ) continue;
			if ( n == selectedMonsterIndex ) { target = c; break; }
			n++;
		}
		if ( target == null ) return;

		var rr = Box.Rect;
		var gr = rosterGridRef.Box.Rect;
		var cr = target.Box.Rect;
		if ( rr.Width < 1f || cr.Width < 1f ) return;

		// Scroll-clip discipline: s&box never clips this root-level ring to
		// the grid viewport, so hide it once the card has scrolled far
		// enough out that the ring would draw over header/footer chrome.
		// (Keyboard scroll-follow keeps the cursor card in view, so this
		// only fires transiently during manual wheel scrolling.)
		if ( cr.Top < gr.Top - 14f || cr.Bottom > gr.Bottom + 14f ) return;

		float sc = ScaleFromScreen;
		if ( sc <= 0.01f || float.IsNaN( sc ) || float.IsInfinity( sc ) ) sc = 1f;

		gridRingL = (int)(( cr.Left - rr.Left ) * sc) - GridRingInset;
		gridRingT = (int)(( cr.Top - rr.Top ) * sc) - GridRingInset;
		gridRingW = (int)(cr.Width * sc) + GridRingInset * 2 - 8;
		gridRingH = (int)(cr.Height * sc) + GridRingInset * 2 - 8;

		gridRingVisible = true;
		if ( !wasVisible ) gridRingWarm = 0;       // re-appearing → snap first, glide after
		else if ( gridRingWarm < 2 ) gridRingWarm++;
	}

	// Wrap the ring around a dossier control (tight inset), clipped
	// against the detail scroll viewport. Shared by the kb-focus and
	// mouse-hover detail paths. Returns false if the host is off-screen
	// or not yet laid out.
	private bool WrapDetailRing( Panel host, bool wasVisible )
	{
		var rrd = Box.Rect;
		var dvr = detailScrollRef.Box.Rect;
		var fr = host.Box.Rect;
		if ( rrd.Width < 1f || fr.Width < 1f ) return false;

		// Same scroll-clip discipline, against the detail viewport.
		if ( fr.Top < dvr.Top - 10f || fr.Bottom > dvr.Bottom + 10f ) return false;

		float scd = ScaleFromScreen;
		if ( scd <= 0.01f || float.IsNaN( scd ) || float.IsInfinity( scd ) ) scd = 1f;

		// Small hosts → tighter inset + radius (.tight in SCSS).
		gridRingL = (int)(( fr.Left - rrd.Left ) * scd) - DetailRingInset;
		gridRingT = (int)(( fr.Top - rrd.Top ) * scd) - DetailRingInset;
		gridRingW = (int)(fr.Width * scd) + DetailRingInset * 2 - 8;
		gridRingH = (int)(fr.Height * scd) + DetailRingInset * 2 - 8;
		gridRingTight = true;

		gridRingVisible = true;
		if ( !wasVisible ) gridRingWarm = 0;
		else if ( gridRingWarm < 2 ) gridRingWarm++;
		return true;
	}

	// Ring-eligible dossier controls for the mouse-hover path — kept in
	// sync with the markup's .kb-focused hosts (plus picker rows/back).
	private static readonly string[] RingHostClasses =
	{
		"action-v2", "detail-diamond", "nickname-btn", "nickname-key-hint",
		"move-diamond-slot", "inline-item", "picker-back",
		// Center Stage rebuild (2026-07): the stage's favorite star square.
		"stage-fav",
	};

	// Deepest hovered descendant carrying a ring-host class. HasHovered
	// is only true along the single ancestor chain under the cursor, so
	// this walk descends one path — cheap per frame. Disabled controls
	// don't earn the ring (it promises actionability).
	private static Panel FindHoveredRingHost( Panel root )
	{
		if ( root == null || !root.HasHovered ) return null;
		foreach ( var child in root.Children )
		{
			if ( child is Panel p && p.HasHovered )
			{
				var hit = FindHoveredRingHost( p );
				if ( hit != null ) return hit;
			}
		}
		if ( root.HasClass( "disabled" ) ) return null;
		foreach ( var cls in RingHostClasses )
			if ( root.HasClass( cls ) ) return root;
		return null;
	}

	// The liquid ink-lean — the menu cursor's multi-sine at the PawPad's
	// ×0.6 amplitude + out-of-phase breathing (the "reads liquid, not
	// metronome" rebalance). Imperative transform: no re-render, and this
	// is a FLAT panel so per-frame writes are cheap (the 7fps law only
	// bites inside perspective-leaned subtrees).
	private void ApplyGridRingWave()
	{
		if ( gridRingRef == null || !gridRingVisible ) return;
		float wt = Time.Now;
		float skX = ( 2.0f * MathF.Sin( wt * 2.2f ) + 0.7f * MathF.Sin( wt * 3.5f + 1.1f ) ) * 0.6f;
		float skY = ( 2.3f * MathF.Sin( wt * 1.8f + 1.9f ) + 0.9f * MathF.Sin( wt * 2.9f ) ) * 0.6f;
		float rotZ = ( 1.1f * MathF.Sin( wt * 1.0f ) + 0.5f * MathF.Sin( wt * 2.4f + 0.5f ) ) * 0.6f;
		float brX = 1f + 0.013f * MathF.Sin( wt * 1.35f + 0.7f ) + 0.006f * MathF.Sin( wt * 2.7f );
		float brY = 1f + 0.013f * MathF.Sin( wt * 1.15f + 2.6f ) + 0.006f * MathF.Sin( wt * 2.3f + 1.4f );

		var t = new PanelTransform();
		t.AddRotation( 0f, 0f, rotZ );
		t.AddSkew( skX, skY, 0f );
		t.AddScale( new Vector2( brX, brY ) );
		gridRingRef.Style.Transform = t;
	}

	// ---- Grid <-> inspect (STAGE+FACTS) keyboard focus switch ----------
	// kbFocusZone is the zone the keyboard currently drives:
	//   "grid"   — WASD/arrows move the beast grid cursor (default)
	//   "detail" — arrows move a 2D positional cursor over the inspect zones
	// Tab (Score) toggles grid -> inspect; Tab or Q (Menu) returns to grid.
	//
	// Center Stage (2026-07): the inspect area is genuinely TWO COLUMNS —
	// the STAGE (center) and the FACTS dossier (right) — so the cursor is
	// a real 2D positional model — see DetailFocusItem + GetDetailFocusItems().
	// Each control carries (Col, Band, Sub):
	//   Col  0 = the STAGE column, 1 = the FACTS column
	//   Band = vertical order within that column (0 at top)
	//   Sub  = horizontal index within a band (the ACTIONS triplet, the
	//          two-wide MOVES rows, the glyph pair). Single controls have Sub 0.
	// W/S walk a column by Band; A/D move within a band by Sub and, off the
	// edge of a band, BRIDGE between the two columns landing on the control
	// whose Band is nearest. detailFocusIndex is a flat cursor into the list.
	private string kbFocusZone = "grid";
	private int detailFocusIndex = 0;

	// Cursor into the inline picker LIST (the move-swap / item picker that
	// opens inside the detail scroll). A flat row index — W/S walk it, Space
	// activates the row, Q/Tab close the picker. Seeded to 0 when a picker
	// opens. Only meaningful while showMovePicker || showItemPicker.
	private int pickerCursorIndex = 0;

	// One keyboard-focusable control in the detail panel, with its position
	// in the 2-column / banded layout.
	private struct DetailFocusItem
	{
		public string Id;
		public int Col;   // 0 = left/main column, 1 = diamond column
		public int Band;  // vertical order within the column
		public int Sub;   // horizontal index within the band
		public DetailFocusItem( string id, int col, int band, int sub )
		{ Id = id; Col = col; Band = band; Sub = sub; }
	}

	// @ref to the STAGE+FACTS shared ancestor (.cs-inspect). The ring's
	// detail walk (kb .kb-focused + mouse hover) covers BOTH zones through
	// this one ref — the focused control is found by descending for the
	// `.kb-focused` class. Name kept from the pre-Center-Stage era when it
	// pointed at the single detail scroll column.
	private Panel detailScrollRef;
	// @ref to the FACTS column's scroll container (.facts-scroll) — the
	// only scrolling inspect zone, so scroll-follow targets this one.
	private Panel factsScrollRef;
	// Set true when the cursor moves; Tick() consumes it to run the
	// scroll-into-view AFTER layout has positioned the new focused element.
	private bool detailScrollFollowPending = false;

	// Recursively find the first descendant carrying `className`.
	private static Panel FindPanelByClass( Panel root, string className )
	{
		if ( root == null ) return null;
		if ( root.HasClass( className ) ) return root;
		foreach ( var child in root.Children )
		{
			if ( child is Panel p )
			{
				var hit = FindPanelByClass( p, className );
				if ( hit != null ) return hit;
			}
		}
		return null;
	}

	// Builds the 2D positional layout of focusable controls for the current
	// SelectedMonster. Center Stage geometry — two columns:
	//
	//   STAGE column (Col 0) — top-to-bottom:
	//     Band 0  nick / diamond-fav      (nickname pencil + favorite star,
	//                                      Sub 0/1 — both on the nameplate)
	//     Band 1  evolve                  (full-width, only when evolvable)
	//     Band 2  item / fuse / release   (the ACTIONS triplet, Sub 0/1/2)
	//
	//   FACTS column (Col 1) — the scrolling dossier on the right:
	//     Band 0-3  move-0..move-3        (MOVES: one COLUMN of full-width
	//                                      slabs since 2026-07-05 — one
	//                                      band each, single Sub)
	//     Band 4  diamond-journal / diamond-showoff
	//                                     (utility chips side-by-side —
	//                                      Sub 0/1; explicit chip widths
	//                                      make the row safe in the scroll
	//                                      column, the info-card-row recipe)
	//
	// Conditional controls (Evolve, Journal) are simply omitted when not
	// rendered — the navigation methods operate on whatever is in the list,
	// so the cursor never lands on a control that isn't on screen. Bands are
	// NOT renumbered when Evolve is absent: the cross-column "nearest band"
	// mapping still works because it picks the closest available band.
	private List<DetailFocusItem> GetDetailFocusItems()
	{
		var items = new List<DetailFocusItem>();
		if ( SelectedMonster == null ) return items;

		// --- STAGE column (Col 0) ---
		// Nickname pencil + favorite star — hidden while editing (the
		// TextEntry owns the keys; the star leaves with the pencil).
		if ( !isEditingNickname )
		{
			items.Add( new DetailFocusItem( "nick",        0, 0, 0 ) );
			items.Add( new DetailFocusItem( "diamond-fav", 0, 0, 1 ) );
		}

		// Evolve — own band, only when the beast can evolve.
		if ( CanSelectedMonsterEvolve() )
			items.Add( new DetailFocusItem( "evolve", 0, 1, 0 ) );

		// ACTIONS triplet — one band, three horizontal Subs.
		items.Add( new DetailFocusItem( "item",    0, 2, 0 ) );
		items.Add( new DetailFocusItem( "fuse",    0, 2, 1 ) );
		items.Add( new DetailFocusItem( "release", 0, 2, 2 ) );

		// --- FACTS column (Col 1) ---
		// MOVES — one COLUMN of full-width slabs (2026-07-05): one band per
		// slot, single Sub. All four slots always render (empty slots
		// included — clicking one opens the learn-move picker).
		items.Add( new DetailFocusItem( "move-0", 1, 0, 0 ) );
		items.Add( new DetailFocusItem( "move-1", 1, 1, 0 ) );
		items.Add( new DetailFocusItem( "move-2", 1, 2, 0 ) );
		items.Add( new DetailFocusItem( "move-3", 1, 3, 0 ) );

		// Utility chips (Journal / Show-off) — ONE side-by-side band at the
		// dossier's foot (2026-07-05 row conversion). Journal is Sub 0 when
		// present; Show-off slides into Sub 0 when it isn't.
		bool hasJournal = SelectedMonster.Journal != null && SelectedMonster.Journal.Count > 0;
		if ( hasJournal )
			items.Add( new DetailFocusItem( "diamond-journal", 1, 4, 0 ) );
		items.Add( new DetailFocusItem( "diamond-showoff", 1, 4, hasJournal ? 1 : 0 ) );

		return items;
	}

	// The control id currently under the detail-panel keyboard cursor, or
	// null if the detail zone isn't focused. Clamps the flat cursor to the
	// live item list so a control disappearing (e.g. Evolve after evolving)
	// never leaves the cursor pointing at nothing.
	private string GetFocusedDetailControl()
	{
		if ( kbFocusZone != "detail" || isFusionMode ) return null;
		var items = GetDetailFocusItems();
		if ( items.Count == 0 ) return null;
		int i = Math.Clamp( detailFocusIndex, 0, items.Count - 1 );
		return items[i].Id;
	}

	// Markup helper — true when `id` is the focused detail control.
	// (2026-07-06: the old detailMouseDriving suppression moved to CSS —
	// the class is always stamped per cursor; `.mouse-mode` gates the
	// STYLING, so mouse and keyboard can never fight highlights.)
	private bool IsDetailControlFocused( string id )
		=> GetFocusedDetailControl() == id;

	// The beast the detail cursor last walked — RESUME the cursor position
	// when re-entering the zone on the same beast (2026-07-06 input model);
	// re-seed to the first item only when the beast changed.
	private Guid lastDetailFocusMonsterId = Guid.Empty;

	// Move keyboard focus to the detail panel (if a beast is selected).
	private void FocusDetailZone()
	{
		if ( !DetailKeyboardEnabled || SelectedMonster == null || isFusionMode ) return;
		kbFocusZone = "detail";
		if ( SelectedMonster.Id != lastDetailFocusMonsterId )
		{
			detailFocusIndex = 0;
			lastDetailFocusMonsterId = SelectedMonster.Id;
		}
		// Clamp in case the item list shrank since the last visit
		// (evolve control gone, journal chip appeared/vanished...).
		var _items = GetDetailFocusItems().Count;
		if ( _items > 0 ) detailFocusIndex = Math.Clamp( detailFocusIndex, 0, _items - 1 );
		SetInputDevice( InputDevice.Keyboard );
		detailScrollFollowPending = true;
		SoundManager.PlayClick();
	}

	// Return keyboard focus to the grid.
	private void FocusGridZone()
	{
		kbFocusZone = "grid";
		SetInputDevice( InputDevice.Keyboard );
		SoundManager.PlayBack();
	}

	// Clickable affordance toggles between the two zones (mouse parity).
	private void ToggleKbFocusZone()
	{
		if ( kbFocusZone == "grid" ) FocusDetailZone();
		else FocusGridZone();
	}

	// Commit a cursor move to the item at `items[newIndex]`. No-ops (and stays
	// silent) when the move didn't change anything; otherwise plays the hover
	// blip and queues the scroll-into-view.
	private void SetDetailFocus( int newIndex )
	{
		// KB input reclaims the highlight from the mouse (last-input-wins)
		// — even a no-op move re-asserts keyboard mode.
		SetInputDevice( InputDevice.Keyboard );
		if ( newIndex < 0 || newIndex == detailFocusIndex ) return;
		detailFocusIndex = newIndex;
		detailScrollFollowPending = true;
		SoundManager.PlayHover();
	}

	// Place the detail cursor on the control with the given id (silent — used
	// when returning from a sub-mode like nickname edit, not for normal nav).
	// Queues a scroll-into-view so the control is shown if it was off-screen.
	private void FocusDetailControl( string id )
	{
		var items = GetDetailFocusItems();
		for ( int i = 0; i < items.Count; i++ )
		{
			if ( items[i].Id == id )
			{
				detailFocusIndex = i;
				detailScrollFollowPending = true;
				return;
			}
		}
	}

	// --- 2D positional navigation over the two-column detail layout ---
	// W/S walk the CURRENT column by Band (keeping Sub where the band allows).
	// A/D move within a band by Sub and, off the edge of a band, BRIDGE to
	// the other column landing on the control whose Band is nearest.

	// W / Up — previous Band in the same column, nearest Sub. If that steps
	// off the TOP of the diamond column, bridge into the left/main column at
	// the nearest band so the diamond column isn't a dead-end at its top.
	private void MoveDetailUp()
	{
		var items = GetDetailFocusItems();
		if ( items.Count == 0 ) return;
		var cur = items[Math.Clamp( detailFocusIndex, 0, items.Count - 1 )];
		int step = FindBandStep( items, cur, -1 );
		if ( step < 0 && cur.Col == 1 )
			step = FindNearestInColumn( items, 0, cur.Band, true ); // bridge to left col, rightmost on tie
		SetDetailFocus( step );
	}

	// S / Down — next Band in the same column, nearest Sub. If that steps off
	// the BOTTOM of the diamond column, bridge into the left/main column at
	// the nearest band — landing on its RIGHTMOST control (closest to the
	// diamonds), e.g. Favorite -> ACTIONS row -> Release.
	private void MoveDetailDown()
	{
		var items = GetDetailFocusItems();
		if ( items.Count == 0 ) return;
		var cur = items[Math.Clamp( detailFocusIndex, 0, items.Count - 1 )];
		int step = FindBandStep( items, cur, 1 );
		if ( step < 0 && cur.Col == 1 )
		{
			// (2026-07-06) S past the facts FOOT re-asserts the full-bottom
			// scroll (read-only content below the focusables stays
			// reachable — the last-band special in ScrollFocusedDetailInto-
			// View does the scroll) instead of the old sideways teleport
			// onto the stage column.
			SetInputDevice( InputDevice.Keyboard );
			detailScrollFollowPending = true;
			return;
		}
		SetDetailFocus( step );
	}

	// A / Left — step left within the band; off the left edge of the diamond
	// column, bridge to the nearest-Band control in the left/main column.
	private void MoveDetailLeft()
	{
		var items = GetDetailFocusItems();
		if ( items.Count == 0 ) return;
		var cur = items[Math.Clamp( detailFocusIndex, 0, items.Count - 1 )];

		// Within-band step left (the ACTIONS triplet / a MOVES row).
		int within = FindSubStep( items, cur, -1 );
		if ( within >= 0 ) { SetDetailFocus( within ); return; }

		// At the band's left edge: from the diamond column, cross to left col.
		// Land on the leftmost control of the nearest band (preferRightmost
		// false) — A reads as "go to the start of the row over there".
		if ( cur.Col == 1 )
		{
			SetDetailFocus( FindNearestInColumn( items, 0, cur.Band, false ) );
			return;
		}

		// SEAM EXIT (2026-07-06, user-approved): A off the STAGE column's
		// left edge crosses back into the collection grid — the mirror of
		// the grid's D-at-row-end entry. No more dead-end.
		FocusGridZone();
	}

	// D / Right — step right within the band; off the right edge of the left
	// column, bridge to the nearest-Band diamond.
	private void MoveDetailRight()
	{
		var items = GetDetailFocusItems();
		if ( items.Count == 0 ) return;
		var cur = items[Math.Clamp( detailFocusIndex, 0, items.Count - 1 )];

		// Within-band step right (the ACTIONS triplet / a MOVES row).
		int within = FindSubStep( items, cur, 1 );
		if ( within >= 0 ) { SetDetailFocus( within ); return; }

		// At the band's right edge: from the left column, cross to diamonds.
		// The diamond column is single-Sub, so the tie preference is moot.
		if ( cur.Col == 0 )
			SetDetailFocus( FindNearestInColumn( items, 1, cur.Band, false ) );
	}

	// Index of the item one Sub-step (dir = -1 / +1) from `cur` within the
	// same Col+Band, or -1 if none (cur is at the band edge / band is 1-wide).
	private int FindSubStep( List<DetailFocusItem> items, DetailFocusItem cur, int dir )
	{
		int wantSub = cur.Sub + dir;
		for ( int i = 0; i < items.Count; i++ )
		{
			var it = items[i];
			if ( it.Col == cur.Col && it.Band == cur.Band && it.Sub == wantSub )
				return i;
		}
		return -1;
	}

	// Index of the control to land on when stepping one Band (dir = -1 / +1)
	// within `cur`'s column. Picks the next band that actually has controls
	// (so a missing Evolve band is skipped), and within that band the Sub
	// closest to the current Sub. Returns -1 if cur is already at the column
	// edge in that direction.
	private int FindBandStep( List<DetailFocusItem> items, DetailFocusItem cur, int dir )
	{
		int bestBand = -1;
		for ( int i = 0; i < items.Count; i++ )
		{
			var it = items[i];
			if ( it.Col != cur.Col ) continue;
			if ( dir > 0 && it.Band > cur.Band )
			{
				if ( bestBand < 0 || it.Band < bestBand ) bestBand = it.Band;
			}
			else if ( dir < 0 && it.Band < cur.Band )
			{
				if ( bestBand < 0 || it.Band > bestBand ) bestBand = it.Band;
			}
		}
		if ( bestBand < 0 ) return -1; // at column edge
		return FindNearestSubInBand( items, cur.Col, bestBand, cur.Sub );
	}

	// Index of the item in (col, band) whose Sub is closest to `wantSub`.
	private int FindNearestSubInBand( List<DetailFocusItem> items, int col, int band, int wantSub )
	{
		int best = -1, bestDist = int.MaxValue;
		for ( int i = 0; i < items.Count; i++ )
		{
			var it = items[i];
			if ( it.Col != col || it.Band != band ) continue;
			int d = Math.Abs( it.Sub - wantSub );
			if ( d < bestDist ) { bestDist = d; best = i; }
		}
		return best;
	}

	// Index of the control in `col` whose Band is closest to `wantBand` —
	// used to BRIDGE between the two columns.
	//   preferRightmost = false : on a Band tie, the leftmost (lowest-Sub)
	//     control wins. Used by A (diamond -> left column) so the cursor
	//     lands at the start of the row it crosses into.
	//   preferRightmost = true  : on a Band tie, the rightmost (highest-Sub)
	//     control wins. Used by W/S off the ends of the diamond column so the
	//     cursor lands on the control nearest the diamonds it came from.
	private int FindNearestInColumn( List<DetailFocusItem> items, int col, int wantBand, bool preferRightmost )
	{
		int best = -1, bestDist = int.MaxValue;
		for ( int i = 0; i < items.Count; i++ )
		{
			var it = items[i];
			if ( it.Col != col ) continue;
			int d = Math.Abs( it.Band - wantBand );
			bool tieWins = d == bestDist && best >= 0
				&& ( preferRightmost ? it.Sub > items[best].Sub : it.Sub < items[best].Sub );
			if ( d < bestDist || tieWins )
			{
				bestDist = d; best = i;
			}
		}
		return best;
	}

	// Activate the control under the detail cursor — dispatches to the same
	// handler the control's onclick uses, so keyboard and mouse are identical.
	private void ActivateFocusedDetailControl()
	{
		var id = GetFocusedDetailControl();
		if ( string.IsNullOrEmpty( id ) ) return;
		switch ( id )
		{
			case "nick": StartNicknameEdit(); break;
			case "diamond-showoff": ShowOffBeast(); break;
			case "diamond-journal": OpenJournal(); break;
			case "diamond-fav": ToggleFavorite(); break;
			case "evolve":
				if ( CanSelectedMonsterEvolve() ) OnEvolveClicked();
				else SoundManager.PlayDeny();
				break;
			case "item": OpenItemPicker(); break;
			case "fuse": OnBreedFromDetail(); break;
			case "release":
				if ( CanReleaseMonster() ) OnReleaseClicked();
				else SoundManager.PlayDeny();
				break;
			case "move-0": OpenMoveSwap( 0 ); break;
			case "move-1": OpenMoveSwap( 1 ); break;
			case "move-2": OpenMoveSwap( 2 ); break;
			case "move-3": OpenMoveSwap( 3 ); break;
		}
	}

	// True when the detail cursor is on the LAST navigable band of the
	// FACTS column (the glyph rows at the dossier's foot). Used by
	// scroll-follow: on the last band, scroll all the way to the bottom so
	// anything display-only beneath the focusables comes fully into view.
	// Not relevant while a picker is open.
	private bool IsFocusedDetailControlLast()
	{
		if ( showItemPicker || showMovePicker ) return false;
		var items = GetDetailFocusItems();
		if ( items.Count == 0 ) return false;
		var cur = items[Math.Clamp( detailFocusIndex, 0, items.Count - 1 )];
		if ( cur.Col != 1 ) return false;
		int maxFactsBand = 0;
		foreach ( var it in items )
			if ( it.Col == 1 && it.Band > maxFactsBand ) maxFactsBand = it.Band;
		return cur.Band == maxFactsBand;
	}

	// Mirror of the above (user 2026-07-06: "you can't scroll to the top
	// of the details with just wasd") — true when the cursor is on the
	// FIRST navigable facts band. Scroll-follow then goes fully to TOP so
	// the display-only content ABOVE the first focusable (STATS rows,
	// quality/nature tiles) comes back into view.
	private bool IsFocusedDetailControlFirstFacts()
	{
		if ( showItemPicker || showMovePicker ) return false;
		var items = GetDetailFocusItems();
		if ( items.Count == 0 ) return false;
		var cur = items[Math.Clamp( detailFocusIndex, 0, items.Count - 1 )];
		if ( cur.Col != 1 ) return false;
		int minFactsBand = int.MaxValue;
		foreach ( var it in items )
			if ( it.Col == 1 && it.Band < minFactsBand ) minFactsBand = it.Band;
		return cur.Band == minFactsBand;
	}

	// Scroll the FACTS column so the currently-focused control is fully
	// visible. s&box has no scroll-into-view; we compute the target offset
	// from screen-space Box.Rect. Called from Tick() one frame AFTER the
	// cursor moved, so layout has positioned the new focused element.
	// Stage controls never scroll (the stage is a fixed column), so the
	// walk is scoped to factsScrollRef — a stage-side focus simply no-ops.
	private void ScrollFocusedDetailIntoView()
	{
		if ( factsScrollRef == null ) return;
		var focused = FindPanelByClass( factsScrollRef, "kb-focused" );
		if ( focused == null ) return; // focused control lives on the stage

		var view = factsScrollRef.Box.Rect;
		var ctrl = focused.Box.Rect;
		if ( view.Height <= 0f || ctrl.Height <= 0f ) return;

		float curOff = factsScrollRef.ScrollOffset.y;

		// Special case: cursor on the LAST navigable band (the glyph rows).
		// Jump straight to the content bottom so anything display-only
		// beneath the last focusable is fully shown.
		if ( IsFocusedDetailControlLast() )
		{
			float bottomOff = Math.Max( 0f, factsScrollRef.ScrollSize.y );
			if ( Math.Abs( bottomOff - curOff ) > 0.5f )
				factsScrollRef.ScrollOffset = new Vector2( factsScrollRef.ScrollOffset.x, bottomOff );
			return;
		}

		// Mirror special case (2026-07-06): cursor on the FIRST facts band
		// → scroll fully to TOP so the display-only STATS/quality content
		// above the first focusable is reachable by keyboard again. Same
		// for the pickers' first row (the equipped/replacing strip sits
		// above row 0). Trade-off: on very short windows the focused
		// control may sit low in the viewport — deliberate, the top
		// content is what the user asked to see.
		bool pickerAtTop = ( showItemPicker || showMovePicker ) && pickerCursorIndex == 0;
		if ( pickerAtTop || IsFocusedDetailControlFirstFacts() )
		{
			if ( curOff > 0.5f )
				factsScrollRef.ScrollOffset = new Vector2( factsScrollRef.ScrollOffset.x, 0f );
			return;
		}

		// Control top/bottom in the scroll container's content space.
		float ctrlTop = ctrl.Top - view.Top + curOff;
		float ctrlBottom = ctrlTop + ctrl.Height;

		const float margin = 24f; // keep a little breathing room around the control
		float newOff = curOff;
		if ( ctrlTop - margin < curOff )
			newOff = ctrlTop - margin;                       // control above viewport
		else if ( ctrlBottom + margin > curOff + view.Height )
			newOff = ctrlBottom + margin - view.Height;       // control below viewport

		newOff = Math.Max( 0f, newOff );
		if ( Math.Abs( newOff - curOff ) > 0.5f )
			factsScrollRef.ScrollOffset = new Vector2( factsScrollRef.ScrollOffset.x, newOff );
	}

	// Track which card is being hovered (to prevent selected card from animating when hovering another)
	private Guid? hoveredMonsterId = null;

	// Evolution animation state
	private bool isEvolving = false;
	private string evolutionPhase = ""; // "shake", "glow", "transform", "burst"
	private string evolvedIconPath = "";

	// Public accessor for GameHUD to determine help category
	public bool IsFusionMode => isFusionMode;

