								</div>
							</div>
							<div class="sb-row">
								<span class="sb-label atk">ATK</span>
								<span class="sb-gene">@(SelectedMonster.Genetics.ATKGene)/30</span>
								<div class="sb-bar"><div class="sb-fill atk" style="width: @GetStatBarPx(SelectedMonster.ATK)"></div></div>
								<span class="sb-value">@SelectedMonster.ATK</span>
								<div class="sb-boost">
									@if (GetStatVeteranBonus(SelectedMonster.ATK) > 0)
									{
										<span class="sb-boost-chip"><span>+@GetStatVeteranBonus(SelectedMonster.ATK)</span></span>
									}
								</div>
							</div>
							<div class="sb-row">
								<span class="sb-label def">DEF</span>
								<span class="sb-gene">@(SelectedMonster.Genetics.DEFGene)/30</span>
								<div class="sb-bar"><div class="sb-fill def" style="width: @GetStatBarPx(SelectedMonster.DEF)"></div></div>
								<span class="sb-value">@SelectedMonster.DEF</span>
								<div class="sb-boost">
									@if (GetStatVeteranBonus(SelectedMonster.DEF) > 0)
									{
										<span class="sb-boost-chip"><span>+@GetStatVeteranBonus(SelectedMonster.DEF)</span></span>
									}
								</div>
							</div>
							<div class="sb-row">
								<span class="sb-label spa">SpA</span>
								<span class="sb-gene">@(SelectedMonster.Genetics.SpAGene)/30</span>
								<div class="sb-bar"><div class="sb-fill spa" style="width: @GetStatBarPx(SelectedMonster.SpA)"></div></div>
								<span class="sb-value">@SelectedMonster.SpA</span>
								<div class="sb-boost">
									@if (GetStatVeteranBonus(SelectedMonster.SpA) > 0)
									{
										<span class="sb-boost-chip"><span>+@GetStatVeteranBonus(SelectedMonster.SpA)</span></span>
									}
								</div>
							</div>
							<div class="sb-row">
								<span class="sb-label spd-def">SpD</span>
								<span class="sb-gene">@(SelectedMonster.Genetics.SpDGene)/30</span>
								<div class="sb-bar"><div class="sb-fill spd-def" style="width: @GetStatBarPx(SelectedMonster.SpD)"></div></div>
								<span class="sb-value">@SelectedMonster.SpD</span>
								<div class="sb-boost">
									@if (GetStatVeteranBonus(SelectedMonster.SpD) > 0)
									{
										<span class="sb-boost-chip"><span>+@GetStatVeteranBonus(SelectedMonster.SpD)</span></span>
									}
								</div>
							</div>
							<div class="sb-row">
								<span class="sb-label spd">SPD</span>
								<span class="sb-gene">@(SelectedMonster.Genetics.SPDGene)/30</span>
								<div class="sb-bar"><div class="sb-fill spd" style="width: @GetStatBarPx(SelectedMonster.SPD)"></div></div>
								<span class="sb-value">@SelectedMonster.SPD</span>
								<div class="sb-boost">
									@if (GetStatVeteranBonus(SelectedMonster.SPD) > 0)
									{
										<span class="sb-boost-chip"><span>+@GetStatVeteranBonus(SelectedMonster.SPD)</span></span>
									}
								</div>
							</div>

							@* Quality + Nature side by side — 1B corner-cut tiles.
							   Explicit row height + explicit tile widths (212 content;
							   2×246 occupied + 12 gap = 504). *@
							<div class="info-card-row">
							<div class="info-card info-card-quality @GetSelectedGeneticsClass()">
								<div class="fd-cut"></div>
								<div class="info-card-header">
									<span class="info-card-label">@L("ui.roster.quality")</span>
									<span class="info-card-meta">@GetSelectedTotalGenes()/180</span>
								</div>
								<span class="info-card-value">@SelectedMonster.Genetics.QualityRating</span>
								@* Gene-total gauge — % fill + width transition kept (the tile
								   persists across switches, so it re-tweens). *@
								<div class="quality-gene-bar">
									<div class="quality-gene-fill @GetSelectedGeneticsClass()" style="width: @GetSelectedGenePercent()%"></div>
								</div>
							</div>
							<div class="info-card info-card-nature">
								<div class="fd-cut"></div>
								<span class="info-card-label">@L("ui.roster.nature")</span>
								<span class="info-card-value">@GetSelectedNature()</span>
								<span class="info-card-meta">@GetSelectedNatureEffect()</span>
							</div>
							</div>
						</div>

						@if (_hasTraits)
						{
							<div class="traits-section fd-zone frev frev-@stageRevVersion">
								<div class="fd-head">
									<div class="fd-head-chip"><span>@L("ui.roster.traits")</span></div>
									<div class="fd-head-line"></div>
								</div>
								<div class="traits-list">
									@foreach (var traitId in SelectedMonster.Traits)
									{
										<div class="trait-card">
											<div class="trait-icon-tile">
												<iconify icon="@GetTraitIcon(traitId)" Size=@(15) Color="#A78BFA" />
											</div>
											<div class="trait-card-body">
												<span class="trait-card-name">@GetTraitName(traitId)</span>
												<span class="trait-card-desc">@GetTraitDescription(traitId)</span>
											</div>
											<div class="fd-cut"></div>
										</div>
									}
								</div>
							</div>
						}

						@* ══ MOVES — ONE COLUMN of full-width 1B corner-cut slabs,
						   each carrying the move's DESCRIPTION inline (user
						   2026-07-05; the hover tooltip is RETIRED). Meta row now
						   also carries the violet EFFECT chip (mock's -ATK -SpA /
						   30% Paralyze — meta-row placement instead of the
						   header's far right to avoid a 3rd sibling in the
						   icon/info flex pair, the flex-1 misdistribution law).
						   Layout: variable-height tiles in a column inside a
						   PADDED section (live-proven); hover stays bg-only
						   (scroll-clip law). frev key = species-change cascade.
						   The "N AVAILABLE" chip sits on the header hairline. *@
						<div class="moves-section fd-zone frev frev-@stageRevVersion">
							<div class="fd-head">
								<div class="fd-head-chip"><span>@L("ui.roster.moves")</span></div>
								<div class="fd-head-line"></div>
								@if (GetAvailableMovesCount() > 0)
								{
									<div class="fd-head-badge"><span>@GetAvailableMovesCount() @L("ui.roster.available")</span></div>
								}
							</div>
							<div class="moves-list">
								@{
									var moves = SelectedMonster.Moves ?? new List<MonsterMove>();
								}
								@for (int i = 0; i < 4; i++)
								{
									var slotIndex = i;
									@if (i < moves.Count)
									{
										var move = moves[i];
										var moveDef = MoveDatabase.GetMove(move.MoveId);
										if (moveDef != null)
										{
											var elementClass = moveDef.Element.ToString().ToLower();
											var isStab = IsMoveSTAB(moveDef);
											var effectsSummary = GetMoveEffectsSummary(moveDef);
											<div class="move-diamond-slot @elementClass @(GetAvailableMovesCount() > 0 ? "swappable" : "") @(isStab ? "stab" : "") @(IsDetailControlFocused($"move-{slotIndex}") ? "kb-focused" : "")" onclick="@(() => OpenMoveSwap(slotIndex))" onmouseover=@(() => OnDetailControlHover($"move-{slotIndex}"))>
												<div class="move-diamond-icon @elementClass">
													<img class="move-el-img" src="ui/icons/elements/element_white/@(GetElementIconName(moveDef.Element)).svg" />
												</div>
												<div class="move-diamond-info">
													<div class="move-name-row">
														<span class="move-diamond-name">@moveDef.Name</span>
														@if (isStab)
														{
															<span class="move-stab-badge"><span>STAB</span></span>
														}
													</div>
													<div class="move-diamond-meta">
														<span class="move-cat @moveDef.Category.ToString().ToLower()">@moveDef.Category.ToString().Substring(0, 3).ToUpper()@(moveDef.BasePower > 0 ? " " + moveDef.BasePower : "")</span>
														<span class="move-meta-stat">ACC @moveDef.Accuracy%</span>
														<span class="move-meta-stat">PP @move.CurrentPP/@moveDef.MaxPP</span>
														@if (moveDef.Priority != 0)
														{
															<span class="move-meta-stat pri">PRI @(moveDef.Priority > 0 ? "+" : "")@moveDef.Priority</span>
														}
														@if (!string.IsNullOrEmpty(effectsSummary))
														{
															<div class="move-effect-chip"><span>@effectsSummary</span></div>
														}
													</div>
													<span class="move-desc">@moveDef.Description</span>
												</div>
												<div class="fd-cut"></div>
											</div>
										}
									}
									else
									{
										<div class="move-diamond-slot empty @(IsDetailControlFocused($"move-{slotIndex}") ? "kb-focused" : "")" onclick="@(() => OpenMoveSwap(slotIndex))" onmouseover=@(() => OnDetailControlHover($"move-{slotIndex}"))>
											<div class="move-diamond-icon empty-icon">
												<span class="move-empty-plus">+</span>
											</div>
											<div class="move-diamond-info">
												<span class="move-diamond-name empty-text">Empty Slot</span>
											</div>
											<div class="fd-cut"></div>
										</div>
									}
								}
							</div>
						</div>

						@* ══ RECORD — lifetime battle ledger. 1B: header chip +
						   2×2 corner-cut tiles (explicit row heights + tile
						   widths — collapse + flex-misdistribution laws). *@
						<div class="record-section fd-zone frev frev-@stageRevVersion">
							<div class="fd-head">
								<div class="fd-head-chip"><span>RECORD</span></div>
								<div class="fd-head-line"></div>
							</div>
							<div class="record-row">
								<div class="record-tile">
									<div class="record-ghost-clip"><div class="record-ghost"><iconify icon="lucide:skull" Size=@(112) Color="rgba(167,139,250,0.11)" /></div></div>
									<span class="record-value">@FormatRecordValue(SelectedMonster.TotalKnockouts)</span>
									<span class="record-label">KNOCKOUTS</span>
									<div class="fd-cut"></div>
								</div>
								<div class="record-tile">
									<div class="record-ghost-clip"><div class="record-ghost"><iconify icon="lucide:swords" Size=@(112) Color="rgba(167,139,250,0.11)" /></div></div>
									<span class="record-value">@FormatRecordValue(SelectedMonster.TotalDamageDealt)</span>
									<span class="record-label">DAMAGE DEALT</span>
									<div class="fd-cut"></div>
								</div>
							</div>
							<div class="record-row">
								<div class="record-tile">
									<div class="record-ghost-clip"><div class="record-ghost"><iconify icon="lucide:crown" Size=@(112) Color="rgba(167,139,250,0.11)" /></div></div>
									<span class="record-value">@FormatRecordValue(SelectedMonster.BossesDefeated)</span>
									<span class="record-label">BOSSES FAINTED</span>
									<div class="fd-cut"></div>
								</div>
								<div class="record-tile">
									<div class="record-ghost-clip"><div class="record-ghost"><iconify icon="lucide:map" Size=@(112) Color="rgba(167,139,250,0.11)" /></div></div>
									<span class="record-value">@FormatRecordValue(SelectedMonster.ExpeditionsCompleted)</span>
									<span class="record-label">EXPEDITIONS</span>
									<div class="fd-cut"></div>
								</div>
							</div>
						</div>

						@* ══ INFO — 1B: header chip + quiet label/value rows with
						   hairline separators (info + lineage merged 2026-07-05),
						   then JOURNAL / SHOW OFF as two corner-cut buttons
						   (folded INSIDE this section per the mock — one level
						   deep in a padded section is collapse-safe). *@
						<div class="info-section fd-zone frev frev-@stageRevVersion">
							<div class="fd-head">
								<div class="fd-head-chip"><span>@L("ui.roster.info")</span></div>
								<div class="fd-head-line"></div>
							</div>
							<div class="info-grid">
								<div class="info-row">
									<span class="info-label">@L("ui.roster.gen")</span>
									<span class="info-value">@(SelectedMonster.Generation == 0 ? L("ui.roster.wild") : $"{SelectedMonster.Generation}")</span>
								</div>
								@if (!string.IsNullOrEmpty(SelectedMonster.OriginalTrainerName))
								{
									<div class="info-row">
										<span class="info-label">@L("ui.roster.ot")</span>
										<span class="info-value">@SelectedMonster.OriginalTrainerName</span>
									</div>
								}
								<div class="info-row">
									<span class="info-label">@L("ui.roster.obtained")</span>
									<span class="info-value">@SelectedMonster.CaughtAt.ToString("MMM d")</span>
								</div>
								@if (SelectedMonster.Parent1Id.HasValue)
								{
									<div class="info-row">
										<span class="info-label">@L("ui.roster.source_1")</span>
										<span class="info-value lineage">@GetParentName(SelectedMonster.Parent1Id.Value)</span>
									</div>
								}
								@if (SelectedMonster.Parent2Id.HasValue)
								{
									<div class="info-row">
										<span class="info-label">@L("ui.roster.source_2")</span>
										<span class="info-value lineage">@GetParentName(SelectedMonster.Parent2Id.Value)</span>
									</div>
								}
							</div>

							@* Journal / Show-off — 1B corner-cut buttons, one
							   side-by-side row (explicit row height + explicit
							   button widths in SCSS — flex:1 misdistributes).
							   kb ids/classes unchanged (ring + activation). *@
							<div class="facts-utility">
								@if (SelectedMonster.Journal != null && SelectedMonster.Journal.Count > 0)
								{
									<div class="detail-diamond wide @(IsDetailControlFocused("diamond-journal") ? "kb-focused" : "")" onclick=@OpenJournal onmouseover=@(() => OnDetailControlHover("diamond-journal"))>
										<iconify icon="lucide:book-open" Size=@(14) Color="#A79DBE" />
										<span class="diamond-label">@L("ui.roster.journal")</span>
										<div class="fd-cut"></div>
									</div>
								}
								<div class="detail-diamond wide @(IsDetailControlFocused("diamond-showoff") ? "kb-focused" : "")" onclick=@ShowOffBeast onmouseover=@(() => OnDetailControlHover("diamond-showoff"))>
									<iconify icon="lucide:megaphone" Size=@(14) Color="#A79DBE" />
									<span class="diamond-label">@L("ui.roster.show_off")</span>
									<div class="fd-cut"></div>
								</div>
							</div>
						</div>
					}
				</div>
				@* Slim container-tone foot cap — bottom leak cover. *@
				<div class="facts-foot"></div>
				<div @ref="factsSbTrackRef" class="col-scrollbar">
					<div @ref="factsSbThumbRef" class="col-sb-thumb"></div>
				</div>
			</div>
		}
		else
		{
			@* ══ Empty stage — quiet prompt, no selection / empty roster. ══ *@
			<div class="cs-stage stage-empty">
				<div class="stage-empty-prompt">
					<iconify icon="lucide:paw-print" Size=@(56) Color="rgba(155, 108, 255, 0.35)" />
					<span class="sep-title">No beast on stage</span>
					<span class="sep-hint">Catch a beast on an expedition and it will take the stage here.</span>
				</div>
			</div>
			@* Empty facts keeps the column silhouette: slim caps with the
			   hint centered in the flex-1 middle zone between them. *@
			<div class="cs-facts facts-empty">
				<div class="facts-roof"></div>
				<div class="facts-empty-mid">
					<span class="facts-empty-hint">FACTS</span>
				</div>
				<div class="facts-foot"></div>
			</div>
		}
		</div>
	</div>

	<!-- Release Confirmation Modal -->
	@if (showReleaseConfirm && monsterToRelease != null)
	{
		@{
			var _releaseSpecies = MonsterManager.Instance?.GetSpecies(monsterToRelease.SpeciesId);
			var _releaseElementClass = _releaseSpecies?.Element.ToString().ToLower() ?? "neutral";
		}
		<div class="bulk-release-overlay" onclick=@CancelRelease>
			<div class="bulk-release-panel" onclick:stopPropagation>
				<!-- Header with warning icon -->
				<div class="bulk-release-header">
					<div class="bulk-release-warning-icon">
						<iconify icon="lucide:triangle-alert" Size=@(28) Color="#ef4444" />
					</div>
					<div class="bulk-release-title-block">
						<span class="bulk-release-title">Release this Beast?</span>
						<span class="bulk-release-subtitle">This action cannot be undone</span>
					</div>
				</div>

				<!-- Single beast card -->
				<div class="bulk-release-list">
					<div class="bulk-release-card @($"element-{_releaseElementClass}")">
						<div class="bulk-release-card-portrait" style="background-image: url(@(_releaseSpecies?.IconPath ?? ""))"></div>
						<div class="bulk-release-card-info">
							<span class="bulk-release-card-name">@monsterToRelease.Nickname</span>
							<div class="bulk-release-card-meta">
								<span class="bulk-release-card-level">LV @monsterToRelease.Level</span>
								<img class="bulk-release-card-element" src="ui/icons/elements/element_white/@(_releaseElementClass).svg" />
							</div>
						</div>
					</div>
				</div>

				<!-- Action buttons — kb cursor (A/D + Space, Q cancels; seeded
				     on Cancel — destructive never defaults to confirm). -->
				<div class="bulk-release-buttons">
					<button class="bulk-release-btn cancel @(releaseKbCursor == 0 ? "kb-focused" : "")" onclick=@CancelRelease onmouseover=@(() => OnReleaseBtnHover(0))>
						<iconify icon="lucide:x" Size=@(16) Color="white" />
						<span>@L("ui.common.cancel")</span>
					</button>
					<button class="bulk-release-btn release @(releaseKbCursor == 1 ? "kb-focused" : "")" onclick=@ConfirmRelease onmouseover=@(() => OnReleaseBtnHover(1))>
						<iconify icon="lucide:trash-2" Size=@(16) Color="white" />
						<span>@L("ui.roster.release")</span>
					</button>
				</div>
			</div>
		</div>
	}

	@* (Journal modal RETIRED 2026-07-05 — turn 10A: the journal is now an
	   in-column facts sub-view (.fsub-head band + .jm-card milestones).
	   The .journal-modal-* scss is inert-frozen; the modal's helper
	   methods (GetJournalEntry*) remain for future reuse.) *@

	<!-- THE LIVING VIOLET RING — one waving selection cursor wrapping the
	     selected beast's card (menu/PawPad signature, flat-panel recipe).
	     Root-level absolute so it can wave per-frame without dirtying the
	     grid; position bound from UpdateGridRing each tick, wave via
	     imperative Style.Transform in ApplyGridRingWave. z 60: above the
	     grid cards, below the sidebar (80) / journal modal (100) /
	     header (500) — flat z-index law, no stacking contexts. -->
	<div @ref="gridRingRef" class="grid-ring @(gridRingVisible ? "on" : "") @(gridRingWarm < 2 ? "snap" : "") @(gridRingTight ? "tight" : "") @(isFusionMode ? "fusion" : "")"
		 style="left: @(gridRingL)px; top: @(gridRingT)px; width: @(gridRingW)px; height: @(gridRingH)px;"></div>

	<!-- Move Picker Modal (at root level for full coverage) -->

	<!-- Fusion confirmation popup REMOVED — replaced with the
	     two-stage in-button confirm on the FUSE CTA. See
	     pendingFusionConfirm + RunFusionConfirmTimeout in the code-behind. -->

	<!-- Fusion Result Modal — REVERTED to original simple structure
	     after multiple failed attempts at the v2 redesign. Keeping the
	     original markup that we know works; v2 redesign is shelved. -->
	@* (Fusion result OVERLAY RETIRED 2026-07-06 — user: "i also want the
	   fusion to not have a popup but stay all in this menu". The result
	   is STAGED INLINE now: the fuse animation plays over the altar, the
	   reveal takes the altar center, and the gene table vs both parents
	   cascades into the FACTS column. The .result-* scss stays frozen.) *@
</div>

@if (showBulkReleaseConfirm && selectedForRelease.Count > 0)
{
	<div class="bulk-release-overlay" onclick=@CancelBulkRelease>
		<div class="bulk-release-panel" onclick:stopPropagation>
			<!-- Header with warning icon -->
			<div class="bulk-release-header">
				<div class="bulk-release-warning-icon">
					<iconify icon="lucide:triangle-alert" Size=@(28) Color="#ef4444" />
				</div>
				<div class="bulk-release-title-block">
					<span class="bulk-release-title">Release @selectedForRelease.Count @(selectedForRelease.Count == 1 ? "Beast" : "Beasts")?</span>
					<span class="bulk-release-subtitle">This action cannot be undone</span>
				</div>
			</div>

			<!-- Beast cards being released — show first 3 + "more" pill so
			     the popup stays a fixed compact size regardless of selection
			     count. Players don't need to see all N beasts to confirm,
			     they need to understand what kind of release this is. -->
			<div class="bulk-release-list">
				@foreach (var monsterId in selectedForRelease.Take(3))
				{
					var monster = MonsterManager.Instance?.OwnedMonsters?.FirstOrDefault(m => m.Id == monsterId);
					if (monster != null)
					{
						var species = MonsterManager.Instance?.GetSpecies(monster.SpeciesId);
						var elementClass = species?.Element.ToString().ToLower() ?? "neutral";
						<div class="bulk-release-card @($"element-{elementClass}")">
							<div class="bulk-release-card-portrait" style="background-image: url(@(species?.IconPath ?? ""))"></div>
							<div class="bulk-release-card-info">
								<span class="bulk-release-card-name">@monster.Nickname</span>
								<div class="bulk-release-card-meta">
									<span class="bulk-release-card-level">LV @monster.Level</span>
									<img class="bulk-release-card-element" src="ui/icons/elements/element_white/@(elementClass).svg" />
								</div>
							</div>
						</div>
					}
				}
				@if (selectedForRelease.Count > 3)
				{
					<div class="bulk-release-more-pill">
						<iconify icon="lucide:more-horizontal" Size=@(14) Color="rgba(255,255,255,0.5)" />
						<span>and @(selectedForRelease.Count - 3) more</span>
					</div>
				}
			</div>

			<!-- Action buttons -->
			<div class="bulk-release-buttons">
				<button class="bulk-release-btn cancel @(releaseKbCursor == 0 ? "kb-focused" : "")" onclick=@CancelBulkRelease onmouseover=@(() => OnReleaseBtnHover(0))>
					<iconify icon="lucide:x" Size=@(16) Color="white" />
					<span>@L("ui.common.cancel")</span>
				</button>
				<button class="bulk-release-btn release @(releaseKbCursor == 1 ? "kb-focused" : "")" onclick=@ConfirmBulkRelease onmouseover=@(() => OnReleaseBtnHover(1))>
					<iconify icon="lucide:trash-2" Size=@(16) Color="white" />
					<span>Release @selectedForRelease.Count</span>
				</button>
			</div>
		</div>
	</div>
}

