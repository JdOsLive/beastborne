	private void ToggleGeneLock(string geneName)
	{
		int maxLocks = (int)(TamerManager.Instance?.GetSkillBonus( SkillEffectType.GeneLock ) ?? 0);
		if (maxLocks <= 0)
		{
			SoundManager.PlayDeny();
			return;
		}

		if (lockedGenes.Contains(geneName))
		{
			lockedGenes.Remove(geneName);
			SoundManager.PlayBack();
		}
		else if (lockedGenes.Count < maxLocks)
		{
			lockedGenes.Add(geneName);
			SoundManager.PlayForward();
		}
		else
		{
			SoundManager.PlayDeny();
		}
	}

	private List<Monster> GetAvailableBreedingMonsters()
	{
		var monsters = MonsterManager.Instance?.OwnedMonsters ?? new List<Monster>();

		// Apply element filter
		if (breedingFilter != "all")
		{
			if (Enum.TryParse<ElementType>(breedingFilter, true, out var elementType))
			{
				monsters = monsters.Where(m =>
				{
					var species = MonsterManager.Instance?.GetSpecies(m.SpeciesId);
					return species?.Element == elementType;
				}).ToList();
			}
		}

		// Apply rarity filter
		if (breedingRarity != "all")
		{
			if (Enum.TryParse<Rarity>(breedingRarity, true, out var rarityType))
			{
				monsters = monsters.Where(m =>
				{
					var species = MonsterManager.Instance?.GetSpecies(m.SpeciesId);
					return species?.BaseRarity == rarityType;
				}).ToList();
			}
		}

		// Apply name filter
		if (breedingSort == "name" && !string.IsNullOrEmpty(breedingNameFilter))
		{
			monsters = monsters.Where(m =>
			{
				var species = MonsterManager.Instance?.GetSpecies(m.SpeciesId);
				return species?.Name?.Equals(breedingNameFilter, StringComparison.OrdinalIgnoreCase) == true ||
					   m.Nickname?.Equals(breedingNameFilter, StringComparison.OrdinalIgnoreCase) == true;
			}).ToList();
		}

		// Apply sorting based on breedingSort
		IEnumerable<Monster> sorted = breedingSort switch
		{
			"fav" => monsters.OrderByDescending(m => m.IsFavorite).ThenByDescending(m => GetMonsterTotalGenes(m)),
			"genes" => monsters.OrderByDescending(m => GetMonsterTotalGenes(m)),
			"level" => monsters.OrderByDescending(m => m.Level),
			"power" => monsters.OrderByDescending(m => m.PowerRating),
			"rarity" => monsters.OrderByDescending(m =>
			{
				var species = MonsterManager.Instance?.GetSpecies(m.SpeciesId);
				return (int)(species?.BaseRarity ?? Rarity.Common);
			}),
			"basestats" => monsters.OrderByDescending(m =>
			{
				var species = MonsterManager.Instance?.GetSpecies(m.SpeciesId);
				if (species == null) return 0;
				return species.BaseHP + species.BaseATK + species.BaseDEF + species.BaseSpA + species.BaseSpD + species.BaseSPD;
			}),
			"recent" => monsters.OrderByDescending(m => m.CaughtAt),
			"beastiary" => monsters.OrderBy(m =>
			{
				var species = MonsterManager.Instance?.GetSpecies(m.SpeciesId);
				return species?.BeastiaryNumber ?? 9999;
			}),
			"name" => monsters.OrderBy(m => m.Nickname ?? MonsterManager.Instance?.GetSpecies(m.SpeciesId)?.Name ?? ""),
			_ => monsters.OrderByDescending(m => GetMonsterTotalGenes(m))
		};

		// Reverse if ascending (default is descending for most sorts)
		if (breedingSortAscending && breedingSort != "beastiary" && breedingSort != "name")
		{
			sorted = sorted.Reverse();
		}
		else if (!breedingSortAscending && (breedingSort == "beastiary" || breedingSort == "name"))
		{
			sorted = sorted.Reverse();
		}

		return sorted.ToList();
	}

	private void OnBreedingMonsterClicked(Monster monster)
	{
		// If already selected as a parent, deselect it
		if (Parent1?.Id == monster.Id)
		{
			ClearParent(1);
			return;
		}
		if (Parent2?.Id == monster.Id)
		{
			ClearParent(2);
			return;
		}

		// Check compatibility if parent 1 is already selected
		if (Parent1 != null && monster.SpeciesId != Parent1.SpeciesId)
		{
			SoundManager.PlayDeny();
			return;
		}

		SoundManager.PlaySelect();
		lockedGenes.Clear();
		ClearPendingFusionConfirm();

		// Assign to the currently selected slot
		if (selectedForSlot == 1 || Parent1 == null)
		{
			Parent1 = monster;
			// Auto-switch to slot 2 after selecting parent 1
			selectedForSlot = 2;
		}
		else
		{
			Parent2 = monster;
		}
	}

	private void OnBreedClicked()
	{
		if (Parent1 == null || Parent2 == null)
		{
			SoundManager.PlayDeny();
			return;
		}

		var compatibility = GeneticsCalculator.CheckCompatibility(Parent1, Parent2);
		if (!compatibility.CanBreed)
		{
			SoundManager.PlayDeny();
			return;
		}

		// Two-stage in-button confirm. Setting controls whether the
		// player gets the safety pause or fuses on first click.
		bool requireConfirm = SettingsManager.Instance?.Settings?.ConfirmBeforeFusion ?? true;

		if (!requireConfirm)
		{
			ExecuteFusion();
			return;
		}

		if (pendingFusionConfirm)
		{
			// Second click within the window — execute the fusion.
			pendingFusionConfirm = false;
			ExecuteFusion();
			return;
		}

		// First click — arm the confirm state and start a revert timer.
		// The token guards against stale timers from earlier clicks
		// flipping us back off after a fresh re-arm.
		pendingFusionConfirm = true;
		pendingConfirmToken++;
		SoundManager.PlayClick();
		_ = RunFusionConfirmTimeout(pendingConfirmToken);
	}

	private async Task RunFusionConfirmTimeout(int token)
	{
		await GameTask.DelaySeconds(4f);
		if (token == pendingConfirmToken && pendingFusionConfirm)
		{
			pendingFusionConfirm = false;
			StateHasChanged();
		}
	}

	private void ClearPendingFusionConfirm()
	{
		if (pendingFusionConfirm)
		{
			pendingFusionConfirm = false;
			pendingConfirmToken++;
		}
	}

	private void ExecuteFusion()
	{
		if (Parent1 == null || Parent2 == null) return;

		var cost = GeneticsCalculator.CalculateBreedingCost(Parent1, Parent2);
		if (!TamerManager.Instance.SpendGold(cost))
		{
			SoundManager.PlayDeny();
			return;
		}

		// Snapshot parents + expected outcome BEFORE breeding so the
		// result panel can derive trait inheritance sources and show
		// "roll vs expected" variance feedback.
		lastFusionParent1 = Parent1;
		lastFusionParent2 = Parent2;
		var preview = GeneticsCalculator.PreviewOffspring(Parent1, Parent2, lockedGenes.Count > 0 ? lockedGenes : null);
		lastFusionExpectedTotal = preview.AvgHP + preview.AvgATK + preview.AvgDEF + preview.AvgSpA + preview.AvgSpD + preview.AvgSPD;
		lastFusionExpectedQuality = preview.PredictedQuality;

		// Create the offspring (pass locked genes for guaranteed inheritance)
		breedingResult = MonsterManager.Instance?.BreedMonsters(Parent1, Parent2, lockedGenes.Count > 0 ? lockedGenes : null);

		if (breedingResult != null)
		{
			// Start fusion animation sequence
			showResult = true;
			isFusionAnimating = true;
			fusionPhase = "spiral";
			fusionAnimationStart = RealTime.Now;

			// Phase 1: Spiral (0.8s) -> Phase 2: Flash (0.3s) -> Phase 3: Reveal (0.5s)
			_ = RunFusionAnimation();

			// Clear parents and locks after breeding
			Parent1 = null;
			Parent2 = null;
			lockedGenes.Clear();
		}
		ClearPendingFusionConfirm();
	}

	// Trait/nature source helpers — used by the result panel to label
	// each inherited trait with which parent it came from.
	private string GetTraitSource(string traitId)
	{
		bool inP1 = lastFusionParent1?.Traits?.Contains(traitId) == true;
		bool inP2 = lastFusionParent2?.Traits?.Contains(traitId) == true;
		if (inP1 && inP2) return "both";
		if (inP1) return "b1";
		if (inP2) return "b2";
		return "new"; // mutation / fusion-only / etc
	}

	private string GetNatureSource()
	{
		if (breedingResult?.Genetics == null) return "rolled";
		var nature = breedingResult.Genetics.Nature;
		bool fromP1 = lastFusionParent1?.Genetics?.Nature == nature;
		bool fromP2 = lastFusionParent2?.Genetics?.Nature == nature;
		if (fromP1 && fromP2) return "both";
		if (fromP1) return "b1";
		if (fromP2) return "b2";
		return "rolled";
	}

	// Result-vs-expected verdict for the variance feedback row.
	// > expected → LUCKY (green); = expected → ON TARGET (gold); < → HARSH (amber)
	private string GetResultVsExpectedClass()
	{
		if (breedingResult?.Genetics == null) return "stable";
		int actual = breedingResult.Genetics.TotalValue;
		int delta = actual - lastFusionExpectedTotal;
		if (delta >= 3) return "improved";
		if (delta <= -3) return "downgrade";
		return "stable";
	}

	private string GetResultVsExpectedLabel()
	{
		if (breedingResult?.Genetics == null) return "ON TARGET";
		int actual = breedingResult.Genetics.TotalValue;
		int delta = actual - lastFusionExpectedTotal;
		if (delta >= 3) return "LUCKY";
		if (delta <= -3) return "HARSH";
		return "ON TARGET";
	}

	// Chain fusion — closes the result modal and auto-fills the
	// offspring as Parent1, leaving Parent2 empty for the next fuse.
	// Lets the player chain breed loops without re-clicking the result.
	private void FuseAgain()
	{
		if (breedingResult == null) return;
		SoundManager.PlayClick();
		Parent1 = breedingResult;
		Parent2 = null;
		selectedForSlot = 2;
		lockedGenes.Clear();
		showResult = false;
		breedingResult = null;
		isFusionAnimating = false;
		fusionPhase = "";
	}

	private async Task RunFusionAnimation()
	{
		// Phase 1: Spiral - DNA strands spiral inward
		fusionPhase = "spiral";
		SoundManager.PlayForward();
		await GameTask.DelaySeconds(1.5f);

		// Phase 2: Flash - bright merge flash. Layer multiple sounds
		// for impact: catch sound (the main hit) + success (the
		// positive feedback) + gold reward (the "you got something").
		fusionPhase = "flash";
		SoundManager.PlayMonsterCatch();
		SoundManager.PlaySuccess();
		SoundManager.PlayGoldReward();
		await GameTask.DelaySeconds(0.6f);

		// Animation complete - content wrapper will animate in with reveal animation
		fusionPhase = "";
		isFusionAnimating = false;
	}

	// CancelFusion / ConfirmFusion removed — replaced with two-stage
	// in-button confirm via pendingFusionConfirm. See OnBreedClicked.

	private void CloseResult()
	{
		SoundManager.PlayClick();
		showResult = false;
		breedingResult = null;
		isFusionAnimating = false;
		fusionPhase = "";
	}

	// Keyboard navigation state for monster selection
	private int selectedMonsterIndex = 0;

	// Sidebar entrance reveal — staircase. Fires sequentially based on
	// tick counter so each stage gets enough render frames to interpolate
	// its transition. Earlier attempt with `await GameTask.DelaySeconds()`
	// produced partial-broken state because s&box's render cadence missed
	// stages flipped at <100ms intervals. Tick counter avoids that.
	//
	// Stage map:
	//   0 = nothing visible (sidebar at translateX(-100), opacity 0)
	//   1 = sidebar slides in (tick 3)
	//   2 = portrait section reveals (tick 8)
	//   3 = actions section reveals (tick 11)
	//   4 = stats + info reveal (tick 14)
	//   5 = moves reveal (tick 17)
	//   6 = traits + battle mastery reveal (tick 20)
	//
	// 5-tick spacing = ~80ms at 60fps. Safe above the s&box render
	// cadence threshold that caused earlier failures at <100ms intervals.
	private int rosterRevealStage = 0;
	private int _ticksSinceMount = 0;

	// ─────────── DEV: BEAST ART POSITION EDITOR ─────────────
	// Two-mode editor for tuning where each beast's sprite sits inside
	// the My Beasts panel surfaces:
	//   CARD mode  → grid mini-card sprite (also inherited by the
	//                ExpeditionPanel embark cards, since both use the
	//                same MonsterCard component reading MiniScale/X/Y)
	//   DETAIL mode → small portrait sprite next to the selected
	//                 beast's stats (DetailIconScale/X/Y).
	// Drag the sprite to adjust offsets; mouse wheel scales it. SAVE
	// dumps paste-ready C# blocks to the console; values also persist
	// to FileSystem.Data so tuning survives session restarts. Loaded
	// on first mount regardless of editor state — flipping the toolbar
	// off doesn't revert your work.
	private const bool ShowMyBeastsArtEditor = false;

	// Stage portrait geometry multiplier — the beast-stage hero renders the
	// detail portrait at K× the geometry the per-species DetailIconScale/
	// OffsetX/OffsetY values were tuned at (120px container, 180px sprite).
	// Markup multiplies the tuned px offsets by K; the art editor's drag
	// divides mouse deltas by K so a saved offset stays in TUNED-space px.
	// Keep in lockstep with .portrait-container / .monster-portrait sizes
	// in the SCSS (240px container, 360px sprite = K 2).
	private const float DetailArtK = 2f;
	private string _myBeastsEditMode = "card";
	private string _myBeastsDraggingId;
	private string _myBeastsHoveredId;
	private float _myBeastsDragStartMouseX, _myBeastsDragStartMouseY;
	private float _myBeastsDragStartOffX, _myBeastsDragStartOffY;
	private bool _myBeastsDragNeedsAnchor;

	// Override dictionaries — track which species have been tuned so SAVE
	// can print only the edited entries and PERSIST/RESET know what to
	// write or revert. Mutations are applied to the live MonsterSpecies
	// fields so MonsterCard/portrait renders pick them up immediately.
	private System.Collections.Generic.Dictionary<string, (float Scale, float OffX, float OffY)> _myBeastsCardOverrides = new();
	private System.Collections.Generic.Dictionary<string, (float Scale, float OffX, float OffY)> _detailIconOverrides = new();

	// Bumped on every edit (drag-move, wheel-scale, mode/test-species swap)
	// so BuildHash sees a change even when the override count is unchanged
	// — without this, scrolling keeps mutating species values but the panel
	// never re-renders because the hash is stable.
	private int _myBeastsArtVersion = 0;
	private string _myBeastsTestSpeciesId;

	// Originals snapshot — captured before any persisted overrides apply,
	// so RESET can restore the species to their MonsterManager.cs values
	// without requiring a game restart.
	private System.Collections.Generic.Dictionary<string, (float Scale, float OffX, float OffY)> _myBeastsCardOriginals = new();
	private System.Collections.Generic.Dictionary<string, (float Scale, float OffX, float OffY)> _detailIconOriginals = new();

	private const string MyBeastsCardArtFile = "mybeasts_card_art.json";
	private const string DetailIconArtFile = "detail_icon_art.json";
	private class SavedBeastArt { public string Id { get; set; } public float Scale { get; set; } public float OffX { get; set; } public float OffY { get; set; } }
	private class BeastArtData { public List<SavedBeastArt> Cards { get; set; } = new(); }
	private bool _myBeastsArtLoaded = false;

	private void SetMyBeastsArtMode( string mode )
	{
		_myBeastsEditMode = mode;
		_myBeastsHoveredId = null;
		SoundManager.PlayClick();
		StateHasChanged();
	}

	private void SnapshotMyBeastsOriginals()
	{
		var all = MonsterManager.Instance?.GetAllSpecies() ?? new();
		_myBeastsCardOriginals.Clear();
		_detailIconOriginals.Clear();
		foreach ( var sp in all )
		{
			_myBeastsCardOriginals[sp.Id] = ( sp.MiniScale, sp.MiniOffsetX, sp.MiniOffsetY );
			_detailIconOriginals[sp.Id] = ( sp.DetailIconScale, sp.DetailIconOffsetX, sp.DetailIconOffsetY );
		}
	}

	private void LoadSavedMyBeastsArt()
	{
		LoadSavedArtFile( MyBeastsCardArtFile, _myBeastsCardOverrides, isDetail: false );
		LoadSavedArtFile( DetailIconArtFile, _detailIconOverrides, isDetail: true );
	}

	private void LoadSavedArtFile( string file, System.Collections.Generic.Dictionary<string, (float, float, float)> dict, bool isDetail )
	{
		try
		{
			if ( !FileSystem.Data.FileExists( file ) ) return;
			var json = FileSystem.Data.ReadAllText( file );
			var data = System.Text.Json.JsonSerializer.Deserialize<BeastArtData>( json );
			if ( data?.Cards == null ) return;
			foreach ( var c in data.Cards )
			{
				if ( string.IsNullOrEmpty( c.Id ) ) continue;
				dict[c.Id] = ( c.Scale, c.OffX, c.OffY );
				var sp = MonsterManager.Instance?.GetSpecies( c.Id );
				if ( sp == null ) continue;
				if ( isDetail )
				{
					sp.DetailIconScale = c.Scale;
					sp.DetailIconOffsetX = c.OffX;
					sp.DetailIconOffsetY = c.OffY;
				}
				else
				{
					sp.MiniScale = c.Scale;
					sp.MiniOffsetX = c.OffX;
					sp.MiniOffsetY = c.OffY;
				}
			}
			Log.Info( $"[MyBeastsArt] Loaded {data.Cards.Count} override(s) from {file}" );
		}
		catch ( System.Exception ex )
		{
			Log.Warning( $"[MyBeastsArt] Failed to load {file}: {ex.Message}" );
		}
	}

	private void PersistActiveModeToDisk()
	{
		try
		{
			var data = new BeastArtData();
			var dict = _myBeastsEditMode == "detail" ? _detailIconOverrides : _myBeastsCardOverrides;
			foreach ( var kvp in dict )
			{
				data.Cards.Add( new SavedBeastArt { Id = kvp.Key, Scale = kvp.Value.Scale, OffX = kvp.Value.OffX, OffY = kvp.Value.OffY } );
			}
			var json = System.Text.Json.JsonSerializer.Serialize( data, new System.Text.Json.JsonSerializerOptions { WriteIndented = true } );
			FileSystem.Data.WriteAllText( _myBeastsEditMode == "detail" ? DetailIconArtFile : MyBeastsCardArtFile, json );
		}
		catch ( System.Exception ex )
		{
			Log.Warning( $"[MyBeastsArt] Failed to write overrides: {ex.Message}" );
		}
	}

	private void ApplyMyBeastsArtOverride( string speciesId, float scale, float offX, float offY )
	{
		var sp = MonsterManager.Instance?.GetSpecies( speciesId );
		if ( sp == null ) return;
		if ( _myBeastsEditMode == "detail" )
		{
			_detailIconOverrides[speciesId] = ( scale, offX, offY );
			sp.DetailIconScale = scale;
			sp.DetailIconOffsetX = offX;
			sp.DetailIconOffsetY = offY;
		}
		else
		{
			_myBeastsCardOverrides[speciesId] = ( scale, offX, offY );
			sp.MiniScale = scale;
			sp.MiniOffsetX = offX;
			sp.MiniOffsetY = offY;
		}
		_myBeastsArtVersion++;
	}

	private List<MonsterSpecies> GetAllTestableSpecies()
	{
		var all = MonsterManager.Instance?.GetAllSpecies() ?? new();
		return all.OrderBy( s => s.BeastiaryNumber ).ToList();
	}

	private void MyBeastsTestPrev()
	{
		var all = GetAllTestableSpecies();
		if ( all.Count == 0 ) return;
		var idx = string.IsNullOrEmpty( _myBeastsTestSpeciesId )
			? all.Count - 1
			: all.FindIndex( s => s.Id == _myBeastsTestSpeciesId ) - 1;
		if ( idx < 0 ) idx = all.Count - 1;
		_myBeastsTestSpeciesId = all[idx].Id;
		_myBeastsHoveredId = _myBeastsTestSpeciesId;
		_myBeastsArtVersion++;
		SoundManager.PlayHover();
		StateHasChanged();
	}

	private void MyBeastsTestNext()
	{
		var all = GetAllTestableSpecies();
		if ( all.Count == 0 ) return;
		var idx = string.IsNullOrEmpty( _myBeastsTestSpeciesId )
			? 0
			: all.FindIndex( s => s.Id == _myBeastsTestSpeciesId ) + 1;
		if ( idx >= all.Count ) idx = 0;
		_myBeastsTestSpeciesId = all[idx].Id;
		_myBeastsHoveredId = _myBeastsTestSpeciesId;
		_myBeastsArtVersion++;
		SoundManager.PlayHover();
		StateHasChanged();
	}

	private void MyBeastsTestClear()
	{
		_myBeastsTestSpeciesId = null;
		_myBeastsArtVersion++;
		StateHasChanged();
	}

	private (float Scale, float OffX, float OffY) GetActiveModeArt( string speciesId )
	{
		var sp = MonsterManager.Instance?.GetSpecies( speciesId );
		if ( sp == null ) return ( 1f, 0f, 0f );
		return _myBeastsEditMode == "detail"
			? ( sp.DetailIconScale, sp.DetailIconOffsetX, sp.DetailIconOffsetY )
			: ( sp.MiniScale, sp.MiniOffsetX, sp.MiniOffsetY );
	}

	private void StartMyBeastsArtDrag( string speciesId )
	{
		if ( !ShowMyBeastsArtEditor || string.IsNullOrEmpty( speciesId ) ) return;
		var art = GetActiveModeArt( speciesId );
		_myBeastsDraggingId = speciesId;
		_myBeastsDragStartOffX = art.OffX;
		_myBeastsDragStartOffY = art.OffY;
		_myBeastsDragNeedsAnchor = true;
		StateHasChanged();
	}

	private void OnMyBeastsArtDragMove( PanelEvent e )
	{
		if ( string.IsNullOrEmpty( _myBeastsDraggingId ) ) return;
		if ( _myBeastsDragNeedsAnchor )
		{
			_myBeastsDragStartMouseX = MousePosition.x;
			_myBeastsDragStartMouseY = MousePosition.y;
			_myBeastsDragNeedsAnchor = false;
			return;
		}
		float dx = MousePosition.x - _myBeastsDragStartMouseX;
		float dy = MousePosition.y - _myBeastsDragStartMouseY;
		// DETAIL mode renders at DetailArtK× the tuned geometry — divide the
		// screen-space drag back into tuned-space px so saved offsets stay
		// compatible with every other surface that reads them.
		if ( _myBeastsEditMode == "detail" && DetailArtK > 0f )
		{
			dx /= DetailArtK;
			dy /= DetailArtK;
		}
		var art = GetActiveModeArt( _myBeastsDraggingId );
		ApplyMyBeastsArtOverride( _myBeastsDraggingId, art.Scale, _myBeastsDragStartOffX + dx, _myBeastsDragStartOffY + dy );
		PersistActiveModeToDisk();
		StateHasChanged();
	}

	private void OnMyBeastsArtDragEnd( PanelEvent e )
	{
		_myBeastsDraggingId = null;
		StateHasChanged();
	}

	private void OnMyBeastsArtHover( string speciesId )
	{
		if ( !ShowMyBeastsArtEditor ) return;
		_myBeastsHoveredId = speciesId;
	}

	private void OnMyBeastsArtLeave( string speciesId )
	{
		if ( _myBeastsHoveredId == speciesId ) _myBeastsHoveredId = null;
	}

	public override void OnMouseWheel( Vector2 delta )
	{
		if ( ShowMyBeastsArtEditor )
		{
			// Test species takes priority over the hovered card — once a
			// species is picked in the toolbar selector, the wheel always
			// targets it so you don't have to keep the cursor pinned over
			// a particular card to scale it.
			var targetId = !string.IsNullOrEmpty( _myBeastsTestSpeciesId )
				? _myBeastsTestSpeciesId
				: _myBeastsHoveredId;
			if ( !string.IsNullOrEmpty( targetId ) )
			{
				var art = GetActiveModeArt( targetId );
				float newScale = Math.Clamp( art.Scale + delta.y * 0.05f, 0.3f, 3.0f );
				ApplyMyBeastsArtOverride( targetId, newScale, art.OffX, art.OffY );
				PersistActiveModeToDisk();
				StateHasChanged();
				return;
			}
		}
		base.OnMouseWheel( delta );
	}

	private void PrintMyBeastsArt()
	{
		var dict = _myBeastsEditMode == "detail" ? _detailIconOverrides : _myBeastsCardOverrides;
		if ( dict.Count == 0 )
		{
			Log.Info( "[MyBeastsArt] No overrides — drag or scroll a beast first." );
			return;
		}
		PersistActiveModeToDisk();
		var file = _myBeastsEditMode == "detail" ? DetailIconArtFile : MyBeastsCardArtFile;
		Log.Info( $"[MyBeastsArt] Saved {dict.Count} override(s) → FileSystem.Data/{file}" );

		// Per-line logging — Log.Info silently truncates multi-line strings
		// (s&box quirk; see CLAUDE.md). Each property gets its own line so
		// the output is paste-friendly into MonsterManager.cs.
		var ci = System.Globalization.CultureInfo.InvariantCulture;
		var fieldScale = _myBeastsEditMode == "detail" ? "DetailIconScale" : "MiniScale";
		var fieldX = _myBeastsEditMode == "detail" ? "DetailIconOffsetX" : "MiniOffsetX";
		var fieldY = _myBeastsEditMode == "detail" ? "DetailIconOffsetY" : "MiniOffsetY";
		Log.Info( $"─── {_myBeastsEditMode.ToUpper()} art overrides — paste into MonsterManager.cs ───" );
		foreach ( var kvp in dict )
		{
			var sp = MonsterManager.Instance?.GetSpecies( kvp.Key );
			var name = sp?.Name ?? kvp.Key;
			Log.Info( $"// {name} ({kvp.Key})" );
			Log.Info( $"{fieldScale} = {kvp.Value.Scale.ToString( "0.###", ci )}f," );
			Log.Info( $"{fieldX} = {kvp.Value.OffX.ToString( "0.#", ci )}f," );
			Log.Info( $"{fieldY} = {kvp.Value.OffY.ToString( "0.#", ci )}f," );
		}
		Log.Info( "─────────────────────────────────────────────────────────────" );
		SoundManager.PlayClick();
	}

	private void ResetMyBeastsArt()
	{
		var dict = _myBeastsEditMode == "detail" ? _detailIconOverrides : _myBeastsCardOverrides;
		var originals = _myBeastsEditMode == "detail" ? _detailIconOriginals : _myBeastsCardOriginals;
		foreach ( var id in dict.Keys.ToList() )
		{
			var sp = MonsterManager.Instance?.GetSpecies( id );
			if ( sp == null ) continue;
			if ( originals.TryGetValue( id, out var orig ) )
			{
				if ( _myBeastsEditMode == "detail" )
				{
					sp.DetailIconScale = orig.Item1;
					sp.DetailIconOffsetX = orig.Item2;
					sp.DetailIconOffsetY = orig.Item3;
				}
				else
				{
					sp.MiniScale = orig.Item1;
					sp.MiniOffsetX = orig.Item2;
					sp.MiniOffsetY = orig.Item3;
				}
			}
		}
		dict.Clear();
		PersistActiveModeToDisk();
		Log.Info( $"[MyBeastsArt] Reset {_myBeastsEditMode.ToUpper()} overrides to MonsterManager defaults." );
		SoundManager.PlayClick();
		StateHasChanged();
	}

	protected override void OnAfterTreeRender( bool firstTime )
	{
		base.OnAfterTreeRender( firstTime );
		if ( firstTime && !_myBeastsArtLoaded )
		{
			// Snapshot first so RESET can revert; THEN apply persisted overrides.
			// Loading is unconditional — even if ShowMyBeastsArtEditor is false,
			// previously tuned values still need to apply at runtime.
			SnapshotMyBeastsOriginals();
			LoadSavedMyBeastsArt();
			_myBeastsArtLoaded = true;
		}
	}

	public override void Tick()
	{
		base.Tick();
		// Note: Input handling is now done via TickInput() called from GameHUD

		// Pick up pending focus from BreedingPanel "VIEW BEAST"
		if ( PendingFocusMonsterId != Guid.Empty )
		{
			var target = MonsterManager.Instance?.OwnedMonsters?.FirstOrDefault( m => m.Id == PendingFocusMonsterId );
			if ( target != null )
			{
				SelectedMonster = target;
				selectedMonsterIndex = GetFilteredMonsters().IndexOf( target );
			}
			PendingFocusMonsterId = Guid.Empty;
		}

		// Auto-select first monster if none selected (detail panel always visible)
		if ( SelectedMonster == null && !isFusionMode && !isDetailClosing )
		{
			var monsters = GetFilteredMonsters();
			if ( monsters.Count > 0 )
			{
				SelectedMonster = monsters[0];
				selectedMonsterIndex = 0;
			}
		}

		// Wait for the second tick before flipping rosterRevealStage to 1.
		// First tick = panel mounts, hidden state paints (opacity:0 + translateX-80).
		// Second tick = flip to entered, transition has a starting state to interpolate from.
		// One tick is not enough — s&box's render cadence collapses the
		// flip to a single frame and you see no motion.
		_ticksSinceMount++;
		// Sub-section staircase reveal does NOT work in this panel because
		// BuildHash includes `SpriteAnimator.GlobalFrame` which re-hashes
		// every render frame for the monster card sprite animations. The
		// per-frame re-renders cause sub-section .entered classes to flip
		// repeatedly, producing visual flickering. Reverted to single-
		// stage reveal: only the parent sidebar slides in, sub-sections
		// are always visible (no .entered class gate on them).
		if ( _ticksSinceMount == 3 && rosterRevealStage < 1 ) rosterRevealStage = 1;

		// Scroll the keyboard-focused detail control into view. Deferred by
		// one tick after the cursor moved (detailScrollFollowPending) so the
		// layout pass has positioned the new .kb-focused element before we
		// read its Box.Rect.
		if ( detailScrollFollowPending )
		{
			detailScrollFollowPending = false;
			if ( kbFocusZone == "detail" )
				ScrollFocusedDetailIntoView();
		}

		// Auto-focus the nickname TextEntry the tick AFTER the edit opened —
		// by now the @if branch has rendered the field so the @ref is bound
		// and .Focus() lands. Lets the player type immediately, no click.
		if ( nicknameFocusPending )
		{
			nicknameFocusPending = false;
			if ( isEditingNickname )
				nicknameInput?.Focus();
		}

		// Living-ring upkeep — recompute the target rect (grid scrolls +
		// reflows, so this is per-tick, not event-latched) and apply the
		// ink-lean wave imperatively.
		UpdateGridRing();
		ApplyGridRingWave();
	}

	/// <summary>
	/// Called by GameHUD to handle keyboard input (child panels don't auto-tick in s&box Razor)
	/// </summary>
	public void TickInput()
	{
		HandleKeyboardInput();
		// Keep the keyboard-selected card on screen — scroll the grid to follow.
		if ( Input.Pressed( "Left" ) || Input.Pressed( "Right" ) || Input.Pressed( "Up" ) || Input.Pressed( "Down" ) )
			UiGridScroll.ScrollIndexIntoView( rosterGridRef, selectedMonsterIndex, "monster-card-wrapper" );
	}

	// Live column count for keyboard up/down navigation. The grid is a
	// responsive flex-wrap so this changes with window size — measured from
	// the rendered grid/card widths (ratio is unit-agnostic). Falls back to 9
	// before the first layout pass has populated Box.Rect.
	private int GetGridColumns()
	{
		var gridW = rosterGridRef?.Box.Rect.Width ?? 0f;
		var cardW = cardSizeRef?.Box.Rect.Width ?? 0f;
		if ( gridW <= 0f || cardW <= 0f ) return 9;
		return Math.Max( 1, (int)(gridW / cardW) );
	}

	private void HandleKeyboardInput()
	{

		// Handle result modal - Enter or Escape to close
		if (showResult)
		{
			if (Input.Pressed("Jump") || Input.Pressed("Enter") || Input.Pressed("Menu"))
			{
				CloseResult();
			}
			return;
		}

		// Fusion mode keyboard controls (inline grid selection assigns to parent slots)
		if (isFusionMode)
		{
			var monsters = GetAvailableBreedingMonsters();

			// R to exit fusion mode. (Was the non-existent "PrevWeapon"
			// action — dead no-op. Q/Menu is already taken by "breed" below,
			// so exit uses Reload/R, which is otherwise unused in this panel.)
			if (Input.Pressed("Reload"))
			{
				ToggleFusionMode();
				return;
			}

			// E to switch between selecting for slot 1 or 2. (Was the
			// non-existent "NextWeapon" action. Use/E is free in fusion mode.)
			if (Input.Pressed("Use"))
			{
				selectedForSlot = selectedForSlot == 1 ? 2 : 1;
				SoundManager.PlayHover();
				return;
			}

			// Grid navigation
			if (monsters.Count > 0)
			{
				selectedMonsterIndex = Math.Clamp(selectedMonsterIndex, 0, monsters.Count - 1);
				int columns = GetGridColumns();

				if (Input.Pressed("Left"))
				{
					selectedMonsterIndex = Math.Max(0, selectedMonsterIndex - 1);
					isKeyboardNavigationActive = true;
					SoundManager.PlayHover();
				}
				else if (Input.Pressed("Right"))
				{
					selectedMonsterIndex = Math.Min(monsters.Count - 1, selectedMonsterIndex + 1);
					isKeyboardNavigationActive = true;
					SoundManager.PlayHover();
				}
				else if (Input.Pressed("Up"))
				{
					if (selectedMonsterIndex < columns)
					{
						GameHUD.ExitPanel();
					}
					else
					{
						selectedMonsterIndex = Math.Max(0, selectedMonsterIndex - columns);
						isKeyboardNavigationActive = true;
						SoundManager.PlayHover();
					}
				}
				else if (Input.Pressed("Down"))
				{
					selectedMonsterIndex = Math.Min(monsters.Count - 1, selectedMonsterIndex + columns);
					isKeyboardNavigationActive = true;
					SoundManager.PlayHover();
				}
				else if (Input.Pressed("Jump") || Input.Pressed("Enter"))
				{
					OnBreedingMonsterClicked(monsters[selectedMonsterIndex]);
				}
			}

			// Q to breed when both parents selected — an internal action, so
			// claim the back key (otherwise GameHUD would also exit to tabs).
			// When the parents aren't both set, Q is NOT consumed here and
			// falls through to GameHUD's normal exit-to-tabs.
			if (Input.Pressed("Menu"))
			{
				if (Parent1 != null && Parent2 != null)
				{
					OnBreedClicked();
					GameHUD.PanelHandledBackKey = true;
				}
			}

			// Backspace/Escape to clear parents
			if (Input.Pressed("run"))
			{
				if (Parent2 != null)
				{
					ClearParent(2);
				}
				else if (Parent1 != null)
				{
					ClearParent(1);
				}
			}
		}
		// Collection view keyboard controls
		else
		{
			// ---- DETAIL-ZONE focus: keyboard drives the detail panel -----
			// When the player has Tab'd into the detail panel, the arrows
			// move a 2D cursor over EVERY interactive control (nickname
			// pencil, the 3 portrait diamonds, the action buttons, the 4
			// move slots): Up/Down step between rows, Left/Right within a
			// row. Space/Enter activates, Tab or Q returns to the grid.
			// Handled before grid nav so the grid cursor stays put.
			if (kbFocusZone == "detail")
			{
				// Detail focus only makes sense with a beast selected.
				if (SelectedMonster == null) { FocusGridZone(); return; }

				// Q (Menu) and Tab (Score) are INTERNAL back keys throughout
				// the detail zone — close a picker, leave nickname edit, or go
				// detail->grid. Every time Q is consumed for one of those, set
				// GameHUD.PanelHandledBackKey so GameHUD's own Menu->exit-to-
				// tabs flip yields this frame (see GameHUD.PanelHandledBackKey).
				// Without it, Q would do the internal action AND bump the HUD
				// into tab-nav, freezing the panel.

				// While editing the nickname, the TextEntry owns the keyboard
				// for typing. We still watch for the two EXIT keys so the
				// player is never trapped in edit mode:
				//   Enter   -> CONFIRM (SaveNickname)
				//   Q / Tab -> CANCEL  (CancelNicknameEdit)
				// Both reset isEditingNickname=false so the handler resumes
				// WASD next frame, re-seed the cursor onto the nickname
				// control, and claim the back key so GameHUD doesn't also
				// exit to tabs. Without the CONFIRM branch, pressing Enter
				// left isEditingNickname stuck true and the panel frozen.
				// (Space is NOT a confirm here — names may contain spaces;
				// Enter is the natural text-field submit.)
				if (isEditingNickname)
				{
					if (Input.Pressed("Enter"))
					{
						SaveNickname();
						FocusDetailControl("nick");
						GameHUD.PanelHandledBackKey = true;
					}
					else if (Input.Pressed("Score") || Input.Pressed("Menu"))
					{
						CancelNicknameEdit();
						FocusDetailControl("nick");
						GameHUD.PanelHandledBackKey = true;
					}
					return;
				}

				// An inline picker (item / move) is open inside the detail
				// scroll. Full keyboard nav over its list:
				//   W/S (Up/Down) — move the row cursor
				//   Space/Enter   — activate the highlighted row (learn move
				//                   / equip item) via its onclick handler
				//   Q / Tab       — close the picker back to detail-control
				//                   nav (claims the back key so GameHUD
				//                   doesn't also exit to tabs)
				// List rows stay mouse-operable too.
				if (showItemPicker || showMovePicker)
				{
					if (Input.Pressed("Score") || Input.Pressed("Menu"))
					{
						if (showItemPicker) CloseItemPicker();
						else CloseMoveSwap();
						GameHUD.PanelHandledBackKey = true;
					}
					else if (Input.Pressed("Up"))
					{
						MovePickerCursor(-1);
					}
					else if (Input.Pressed("Down"))
					{
						MovePickerCursor(1);
					}
					else if (Input.Pressed("Jump") || Input.Pressed("Enter"))
					{
						ActivatePickerRow();
					}
					return;
				}

				// Tab or Q — back to the grid (an internal move, NOT an exit
				// to the tab bar, so claim the back key).
				if (Input.Pressed("Score") || Input.Pressed("Menu"))
				{
					FocusGridZone();
					GameHUD.PanelHandledBackKey = true;
					return;
				}
				if (Input.Pressed("Up"))         MoveDetailUp();
				else if (Input.Pressed("Down"))  MoveDetailDown();
				else if (Input.Pressed("Left"))  MoveDetailLeft();
				else if (Input.Pressed("Right")) MoveDetailRight();
				else if (Input.Pressed("Jump") || Input.Pressed("Enter"))
				{
					ActivateFocusedDetailControl();
				}
				return;
			}

			// Tab — hand keyboard control to the detail panel.
			if (Input.Pressed("Score"))
			{
				FocusDetailZone();
				return;
			}

			// E to enter Fusion mode. (Was the non-existent "NextWeapon"
			// action — dead no-op. Use/E is free in the collection grid.)
			if (Input.Pressed("Use"))
			{
				ToggleFusionMode();
				return;
			}

			var monsters = GetFilteredMonsters();
			if (monsters.Count == 0)
			{
				// No monsters - W/Up exits to tabs
				if (Input.Pressed("Up"))
				{
					GameHUD.ExitPanel();
				}
				return;
			}

			// Clamp index
			selectedMonsterIndex = Math.Clamp(selectedMonsterIndex, 0, monsters.Count - 1);

			// Up/Down moves one full row — column count is measured live.
			int columns = GetGridColumns();

			if (Input.Pressed("Left"))
			{
				selectedMonsterIndex = Math.Max(0, selectedMonsterIndex - 1);
				SelectedMonster = monsters[selectedMonsterIndex]; // Detail panel follows the keyboard cursor — keeps the sidebar mounted so the grid doesn't reflow/flicker
				hoveredMonsterId = null; // Clear hover state when using keyboard
				isKeyboardNavigationActive = true;
				SoundManager.PlayHover();
			}
			else if (Input.Pressed("Right"))
			{
				selectedMonsterIndex = Math.Min(monsters.Count - 1, selectedMonsterIndex + 1);
				SelectedMonster = monsters[selectedMonsterIndex]; // Detail panel follows the keyboard cursor — keeps the sidebar mounted so the grid doesn't reflow/flicker
				hoveredMonsterId = null; // Clear hover state when using keyboard
				isKeyboardNavigationActive = true;
				SoundManager.PlayHover();
			}
			else if (Input.Pressed("Up"))
			{
				// If at top row, exit to tab navigation
				if (selectedMonsterIndex < columns)
				{
					GameHUD.ExitPanel();
				}
				else
				{
					selectedMonsterIndex = Math.Max(0, selectedMonsterIndex - columns);
					SelectedMonster = monsters[selectedMonsterIndex]; // Detail panel follows the keyboard cursor — keeps the sidebar mounted so the grid doesn't reflow/flicker
					hoveredMonsterId = null; // Clear hover state when using keyboard
					isKeyboardNavigationActive = true;
					SoundManager.PlayHover();
				}
			}
			else if (Input.Pressed("Down"))
			{
				selectedMonsterIndex = Math.Min(monsters.Count - 1, selectedMonsterIndex + columns);
				SelectedMonster = monsters[selectedMonsterIndex]; // Detail panel follows the keyboard cursor — keeps the sidebar mounted so the grid doesn't reflow/flicker
				hoveredMonsterId = null; // Clear hover state when using keyboard
				isKeyboardNavigationActive = true;
				SoundManager.PlayHover();
			}
			else if (Input.Pressed("Jump") || Input.Pressed("Enter"))
			{
				// Confirm the highlighted beast — hand keyboard control to the
				// detail panel so its controls can be used. The detail already
				// mirrors the grid cursor, so Space just moves focus INTO it.
				// (Previously Space called OnMonsterSelected on the already-
				// selected beast, which toggled the detail CLOSED.)
				// FocusDetailZone plays its own click cue.
				if (SelectedMonster != null)
					FocusDetailZone();
			}
		}
	}

	// Get the currently keyboard-selected monster for highlighting in breeding grid
	private Monster GetKeyboardSelectedBreedingMonster()
	{
		if (!isFusionMode || !isKeyboardNavigationActive) return null;
		var monsters = GetAvailableBreedingMonsters();
		if (selectedMonsterIndex >= 0 && selectedMonsterIndex < monsters.Count)
		{
			return monsters[selectedMonsterIndex];
		}
		return null;
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add(rosterRevealStage);
		hash.Add(isFusionMode);
		hash.Add(currentFilter);
		hash.Add(currentSort);
		hash.Add(sortAscending);
		hash.Add(SelectedMonster?.Id);
		hash.Add(SelectedMonster?.Nickname);
		hash.Add(Parent1?.Id);
		hash.Add(Parent2?.Id);
		hash.Add(selectedForSlot);
		hash.Add(breedingFilter);
		hash.Add(breedingSort);
		hash.Add(breedingRarity);
		hash.Add(breedingNameFilter);
		hash.Add(breedingSortAscending);
		hash.Add(showResult);
		hash.Add(breedingResult?.Id);
		hash.Add(isFusionAnimating);
		hash.Add(fusionPhase);
		hash.Add(GetMonsterCount());
		hash.Add(GetMaxMonsters());
		hash.Add(PendingFocusMonsterId);
		hash.Add(SpriteAnimator.GlobalFrame);
		hash.Add(selectedMonsterIndex);
		hash.Add(isKeyboardNavigationActive);
		// Grid <-> detail keyboard focus switch — the focus zone and the
		// detail-panel cursor both drive visible state (affordance pill label
		// + the .kb-focused highlight on the focused control). pickerCursorIndex
		// drives the .kb-focused row inside an open move/item picker.
		hash.Add(kbFocusZone);
		hash.Add(detailFocusIndex);
		hash.Add(pickerCursorIndex);
		hash.Add(hoveredMonsterId);
		hash.Add(isEditingNickname);
		hash.Add(showReleaseConfirm);
		hash.Add(pendingFusionConfirm);
		hash.Add(isMultiSelectMode);
		hash.Add(selectedForRelease.Count);
		hash.Add(showBulkReleaseConfirm);
		hash.Add(showJournalModal);
		hash.Add(showItemPicker);
		hash.Add(showMovePicker);
		hash.Add(selectedMoveSlot);
		hash.Add(SelectedMonster?.HeldItemId);
		hash.Add(SelectedMonster?.Moves?.Count);
		hash.Add(isEvolving);
		hash.Add(evolutionPhase);
		hash.Add(evolvedIconPath);
		// Select-pulse state — without these in the hash, the panel won't
		// re-render on re-click of a card and the one-shot border flash
		// won't remount. (Shop uses the same pair.)
		hash.Add(justSelectedMonsterId);
		hash.Add(selectPulseVersion);
		// Living violet ring — markup-bound position + visibility class.
		hash.Add(gridRingL);
		hash.Add(gridRingT);
		hash.Add(gridRingW);
		hash.Add(gridRingH);
		hash.Add(gridRingVisible);
		hash.Add(gridRingWarm < 2);
		// Beast-art editor — re-render when the dev switches modes,
		// drags a sprite, or the override count changes (so the toolbar's
		// edit-counter and active-mode chip both stay live).
		hash.Add(_myBeastsEditMode);
		hash.Add(_myBeastsDraggingId);
		hash.Add(_myBeastsTestSpeciesId);
		hash.Add(_myBeastsCardOverrides.Count);
		hash.Add(_detailIconOverrides.Count);
		hash.Add(_myBeastsArtVersion);
		return hash.ToHashCode();
	}

	private float GetSelectedXPPercent()
	{
		if (SelectedMonster == null || SelectedMonster.XPToNextLevel <= 0) return 0;
		return (float)SelectedMonster.CurrentXP / SelectedMonster.XPToNextLevel * 100f;
	}

	// ==========================================
	// Species Mastery stat-bonus Helper
	// ==========================================

	// Calculate the species-mastery bonus amount for a stat (reverse calculate from final stat).
	// Used to show the "(+N)" suffix next to raw stat values in the detail pane.
	private int GetStatVeteranBonus(int currentStat, bool isHP = false)
	{
		if (SelectedMonster == null) return 0;
		float bonusPercent = BeastiaryManager.Instance?.GetMasteryBonus(SelectedMonster.SpeciesId) ?? 0f;
		if (bonusPercent <= 0) return 0;

		// HP gets half bonus, other stats get full bonus
		float multiplier = isHP ? (1 + bonusPercent * 0.5f) : (1 + bonusPercent);
		int baseStat = (int)(currentStat / multiplier);
		return currentStat - baseStat;
	}

	private string FormatDamageValue(int damage)
	{
		if (damage >= 1000000) return $"{damage / 1000000f:0.#}M";
		if (damage >= 1000) return $"{damage / 1000f:0.#}K";
		return damage.ToString();
	}

