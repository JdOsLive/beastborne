@namespace Beastborne.UI.Panels
@using Sandbox;
@using Sandbox.UI;
@using Beastborne.Core;
@using Beastborne.Data;
@using Beastborne.Systems;
@using Beastborne.UI.Components;
@inherits Panel

<div class="roster-panel @(isFusionMode ? "fusion-view" : "")" onclick=@OnPanelClicked>
	<div class="roster-header">
		<div class="header-left">
			<img class="panel-title-icon" src="ui/icons/beast.svg" />
			<div class="roster-title">@(isFusionMode ? L("ui.roster.contract_fusion") : L("ui.roster.my_beasts"))</div>
		</div>
		<div class="header-filters">
			@if (!isMultiSelectMode && !isFusionMode)
			{
				<FilterBar @ref="filterBar"
						   CurrentElement=@currentFilter
						   CurrentSort=@currentSort
						   CurrentRarity=@currentRarity
						   SortAscending=@sortAscending
						   ShowBeastiarySort=@true
						   ShowRarityFilter=@true
						   OnElementChanged=@OnElementChanged
						   OnSortChanged=@OnSortChanged
						   OnRarityChanged=@OnRarityChanged
						   OnNameFilterChanged=@OnNameFilterChanged
						   OnSortDirectionChanged=@OnSortDirectionChanged
						   AvailableNames=@GetMonsterNames() />
			}
			@if (isFusionMode)
			{
				<FilterBar @ref="breedingFilterBar"
						   CurrentElement=@breedingFilter
						   CurrentSort=@breedingSort
						   CurrentRarity=@breedingRarity
						   SortAscending=@breedingSortAscending
						   ShowBeastiarySort=@true
						   ShowRarityFilter=@true
						   OnElementChanged=@OnBreedingElementChanged
						   OnSortChanged=@OnBreedingSortChanged
						   OnRarityChanged=@OnBreedingRarityChanged
						   OnNameFilterChanged=@OnBreedingNameFilterChanged
						   OnSortDirectionChanged=@OnBreedingSortDirectionChanged
						   AvailableNames=@GetBreedingMonsterNames() />
			}
			@if (!isMultiSelectMode)
			{
				<button class="sort-btn fusion-toggle @(isFusionMode ? "active-mode" : "")"
						onclick=@ToggleFusionMode
						onmouseover=@(() => SoundManager.PlayHover())>
					<span class="pill-label">@(isFusionMode ? L("ui.roster.cancel") : L("ui.beast.fuse"))</span>
				</button>
			}
			@if (!isFusionMode)
			{
				<button class="sort-btn multi-select @(isMultiSelectMode ? "active-mode" : "")"
						onclick=@ToggleMultiSelectMode
						onmouseover=@(() => SoundManager.PlayHover())>
					<span class="pill-label">@(isMultiSelectMode ? L("ui.roster.cancel") : L("ui.roster.multi_release"))</span>
				</button>
			}
			@if (isMultiSelectMode && selectedForRelease.Count > 0)
			{
				<button class="sort-btn release-confirm" onclick=@OnReleaseSelectedClicked
					onmouseover=@(() => SoundManager.PlayHover())>
					<span class="pill-label">@string.Format(L("ui.roster.release_count"), selectedForRelease.Count)</span>
				</button>
			}
		</div>
		<div class="header-right">
			<div class="roster-count">
				<img class="storage-icon-svg" src="ui/icons/sort/box.svg" />
				<span class="storage-text">@GetMonsterCount() / @GetMaxMonsters()</span>
			</div>
		</div>
	</div>

	<!-- Collection View — fusion is now an in-place mode toggle, not a separate view -->
	<div class="view-container">
		<div class="collection-layout with-detail">
			<div class="collection-main">
				<div class="roster-grid" onmouseup=@OnDragSelectEnd>
				@{
					// In fusion mode, use the breeding filter state (separate from the
					// collection filter state) so swapping in/out of fusion mode doesn't
					// disturb the player's primary collection sort/filter setup.
					var collectionMonsters = isFusionMode ? GetAvailableBreedingMonsters() : GetFilteredMonsters();
					var keyboardIdx = Math.Clamp(selectedMonsterIndex, 0, Math.Max(0, collectionMonsters.Count - 1));
				}
				@for (int i = 0; i < collectionMonsters.Count; i++)
				{
					var monster = collectionMonsters[i];
					var idx = i;
					var isKeyboardSelected = isKeyboardNavigationActive && i == keyboardIdx;
					var isSelectedForRelease = selectedForRelease.Contains(monster.Id);
					var isFusionParent1 = isFusionMode && Parent1?.Id == monster.Id;
					var isFusionParent2 = isFusionMode && Parent2?.Id == monster.Id;
					var isFusionParent = isFusionParent1 || isFusionParent2;
					var isFusionIncompatible = isFusionMode && Parent1 != null && !isFusionParent && monster.SpeciesId != Parent1.SpeciesId;
					<div class="monster-card-wrapper @(isMultiSelectMode ? "multi-select-mode" : "") @(isSelectedForRelease ? "selected-for-release" : "") @(isFusionMode ? "fusion-mode" : "") @(isFusionParent ? "fusion-parent" : "") @(isFusionIncompatible ? "fusion-incompatible" : "")"
						 onclick=@(() => OnMonsterCardClicked(monster, idx))
						 onmousedown=@(() => OnCardMouseDown(monster, idx))
						 onmouseover=@(() => OnCardMouseEnter(monster, idx))
						 onmouseup=@OnDragSelectEnd>
						@if (justSelectedMonsterId.HasValue && justSelectedMonsterId.Value == monster.Id)
						{
							<!-- One-shot select pulse. Keyed on selectPulseVersion so
							     each click remounts the overlay and @keyframes fire
							     fresh (s&box quirk: keyframes only run on first mount).
							     Removes itself visually via SCSS opacity: 0 end-state. -->
							<div class="select-pulse pulse-@selectPulseVersion"></div>
						}
						@if (isMultiSelectMode)
						{
							<div class="select-checkbox @(isSelectedForRelease ? "checked" : "")">
								@(isSelectedForRelease ? "✓" : "")
							</div>
						}
						@if (isFusionParent1)
						{
							<div class="parent-indicator p1">B1</div>
						}
						@if (isFusionParent2)
						{
							<div class="parent-indicator p2">B2</div>
						}
@{
							// Card is hovered if it matches the hoveredMonsterId
							var isThisCardHovered = hoveredMonsterId.HasValue && hoveredMonsterId.Value == monster.Id;
							// Card is selected if it's the SelectedMonster, keyboard selected, or hovered (for visual styling - purple glow)
							var isThisCardSelected = (SelectedMonster?.Id == monster.Id || isKeyboardSelected || isThisCardHovered);
							// Should animate if: hovered, OR (selected AND no other card is hovered)
							var shouldAnimate = isThisCardHovered || (isThisCardSelected && !hoveredMonsterId.HasValue);
						}
						<MonsterCard Monster=@monster
									 IsSelected=@isThisCardSelected
									 ShouldAnimate=@shouldAnimate
									 IsMini=@true
									 ShowGenes=@isFusionMode
									 AnimateOnHover=@true
									 AnimationFrame=@SpriteAnimator.GlobalFrame
									 ClickAction=@(() => {})
									 HoverAction=@(() => OnMouseHoverCard(monster.Id))
									 LeaveAction=@OnMouseLeaveCard />
					</div>
				}

				@if (currentFilter == "all")
				{
					var totalMonsters = GetMonsterCount();
					var emptySlots = GetEmptySlotCount(totalMonsters);
					@for (int i = 0; i < emptySlots; i++)
					{
						<div class="empty-slot mini" onmouseover=@OnMouseLeaveCard>
							<div class="empty-slot-border"></div>
						</div>
					}
				}

				@if (GetFilteredMonsters().Count == 0 && currentFilter != "all")
				{
					<div class="empty-roster">
						<div class="empty-icon">?</div>
						<div class="empty-text">@L("ui.roster.no_monsters")</div>
						<div class="empty-hint">@L("ui.roster.no_filter_match")</div>
					</div>
				}
				</div>
			</div>

			@if (isFusionMode || SelectedMonster != null)
			{
				<!-- Unified sidebar element. Both detail view AND fusion staging
				     live under a single outer .detail-sidebar div so Razor reuses
				     the DOM node when toggling between modes — prevents the grid
				     from reflowing/squishing during the swap. -->
				<div class="detail-sidebar @(isFusionMode ? "fusion-sidebar entered" : (rosterRevealStage >= 1 ? "entered" : ""))">
				@if (isFusionMode)
				{
					@{
						// Compatibility + preview computed once for the whole sidebar so the
						// header pill, hero card, gene grid, outcomes row and CTA all stay
						// in sync. `bothPicked` gates the preview-only sections.
						var bothPicked = Parent1 != null && Parent2 != null;
						BreedCompatibility fusionCompat = bothPicked ? GeneticsCalculator.CheckCompatibility(Parent1, Parent2) : null;
						BreedingPreview fusionPreview = (bothPicked && fusionCompat != null && fusionCompat.CanBreed)
							? GeneticsCalculator.PreviewOffspring(Parent1, Parent2, lockedGenes.Count > 0 ? lockedGenes : null)
							: null;
						int maxLocks = fusionPreview?.GeneLockSlots ?? (int)(TamerManager.Instance?.GetSkillBonus( SkillEffectType.GeneLock ) ?? 0);
						bool hasLockSkill = maxLocks > 0;
						int p1Total = Parent1?.Genetics?.TotalValue ?? 0;
						int p2Total = Parent2?.Genetics?.TotalValue ?? 0;
						int previewTotal = fusionPreview != null
							? fusionPreview.AvgHP + fusionPreview.AvgATK + fusionPreview.AvgDEF + fusionPreview.AvgSpA + fusionPreview.AvgSpD + fusionPreview.AvgSPD
							: 0;
						int fusionCost = bothPicked ? GeneticsCalculator.CalculateBreedingCost(Parent1, Parent2) : 0;
						bool canAffordFusion = TamerManager.Instance?.CurrentTamer?.Gold >= fusionCost;
						bool canFuse = bothPicked && fusionCompat != null && fusionCompat.CanBreed && canAffordFusion;
					}

					<!-- ====== FUSION HEADER ====== -->
					<div class="fusion-header">
						<iconify icon="lucide:combine" Size=@(20) Color="#c4b5fd" />
						<div class="fusion-header-text">
							<div class="fusion-header-title">@L("ui.roster.contract_fusion")</div>
							<div class="fusion-header-sub">
								@(bothPicked && fusionCompat?.CanBreed == true
									? L("ui.roster.both_consumed")
									: "Pick two beasts of the same species")
							</div>
						</div>
						@if (fusionPreview != null)
						{
							<!-- Outcome chances live in the header right side, freeing
							     vertical space in the body for the gene grid. -->
							<div class="fusion-header-chances">
								<div class="header-chance twin">
									<iconify icon="lucide:users" Size=@(11) Color="#fbbf24" />
									<span class="hc-label">Twin</span>
									<span class="hc-value">@((fusionPreview.TwinChance * 100).ToString("F0"))%</span>
								</div>
								<div class="header-chance mutation">
									<iconify icon="lucide:sparkles" Size=@(11) Color="#c4b5fd" />
									<span class="hc-label">Mut</span>
									<span class="hc-value">@((fusionPreview.MutationChance * 100).ToString("F0"))%</span>
								</div>
								@if (fusionPreview.NatureInheritChance > 0)
								{
									<div class="header-chance nature">
										<iconify icon="lucide:leaf" Size=@(11) Color="#86efac" />
										<span class="hc-label">Nat</span>
										<span class="hc-value">@((fusionPreview.NatureInheritChance * 100).ToString("F0"))%</span>
									</div>
								}
							</div>
						}
					</div>

					<!-- ====== PARENTS COLUMN — sticky band, OUTSIDE the scrollable
					     body so chip tooltips can pop without being clipped by the
					     body's overflow:scroll. Also keeps both parents pinned and
					     visible while the player scrolls the gene grid. -->
					<div class="fusion-parents-section">
						<!-- Slot 1 — NOTE: no row-level onmouseover. Hover sound is
					     routed through the inner MonsterCard's HoverAction so the
					     card's isInternallyHovered guard prevents the spam that
					     happens when the mouse moves between child elements. -->
						<div class="fusion-parent-row @(Parent1 != null ? "filled" : "") @(selectedForSlot == 1 ? "selecting" : "")"
							 onclick=@(() => SetSelectingSlot(1))>
							<div class="fusion-slot-tag">B1</div>
							@if (Parent1 != null)
							{
								<div class="fusion-card-wrap">
									<MonsterCard Monster=@Parent1 IsHorizontal=@true AnimationFrame=@SpriteAnimator.GlobalFrame HoverAction=@(() => SoundManager.PlayHover()) />
									<button class="parent-remove-btn" onclick=@(() => ClearParent(1)) onclick:stopPropagation onmouseover=@(() => SoundManager.PlayHover())>
										<iconify icon="lucide:x" Size=@(12) Color="white" />
									</button>
								</div>
								<div class="parent-extras">
									@if (Parent1.Genetics != null)
									{
										<div class="extra-chip nature">
											<iconify icon="lucide:leaf" Size=@(10) Color="#86efac" />
											<span>@Parent1.Genetics.Nature</span>
											<span class="chip-tooltip">@Parent1.Genetics.GetNatureDescription()</span>
										</div>
									}
									@if (Parent1.Traits != null)
									{
										@foreach (var trait in Parent1.Traits)
										{
											<div class="extra-chip trait">
												<iconify icon="lucide:zap" Size=@(10) Color="#fbbf24" />
												<span>@GetTraitName(trait)</span>
												<span class="chip-tooltip">@GetTraitDescription(trait)</span>
											</div>
										}
									}
								</div>
							}
							else
							{
								<div class="empty-parent-horiz">
									<iconify icon="lucide:plus" Size=@(20) Color="rgba(255,255,255,0.4)" />
									<span>Pick a beast</span>
								</div>
							}
						</div>

						<!-- Vertical connector — two converging chevrons. No circle, no
					     pulsing glow — flat, sharp, more "stamped" than "AI generated". -->
						<div class="fusion-connector-v @(bothPicked && fusionCompat?.CanBreed == true ? "active" : "")">
							<iconify class="connector-chevron up" icon="lucide:chevrons-down" Size=@(20) Color="@(bothPicked && fusionCompat?.CanBreed == true ? "#fbbf24" : "rgba(255,255,255,0.25)")" />
						</div>

						<!-- Slot 2 — same hover-sound routing as Slot 1 -->
						<div class="fusion-parent-row @(Parent2 != null ? "filled" : "") @(selectedForSlot == 2 ? "selecting" : "")"
							 onclick=@(() => SetSelectingSlot(2))>
							<div class="fusion-slot-tag">B2</div>
							@if (Parent2 != null)
							{
								<div class="fusion-card-wrap">
									<MonsterCard Monster=@Parent2 IsHorizontal=@true AnimationFrame=@SpriteAnimator.GlobalFrame HoverAction=@(() => SoundManager.PlayHover()) />
									<button class="parent-remove-btn" onclick=@(() => ClearParent(2)) onclick:stopPropagation onmouseover=@(() => SoundManager.PlayHover())>
										<iconify icon="lucide:x" Size=@(12) Color="white" />
									</button>
								</div>
								<div class="parent-extras">
									@if (Parent2.Genetics != null)
									{
										<div class="extra-chip nature">
											<iconify icon="lucide:leaf" Size=@(10) Color="#86efac" />
											<span>@Parent2.Genetics.Nature</span>
											<span class="chip-tooltip">@Parent2.Genetics.GetNatureDescription()</span>
										</div>
									}
									@if (Parent2.Traits != null)
									{
										@foreach (var trait in Parent2.Traits)
										{
											<div class="extra-chip trait">
												<iconify icon="lucide:zap" Size=@(10) Color="#fbbf24" />
												<span>@GetTraitName(trait)</span>
												<span class="chip-tooltip">@GetTraitDescription(trait)</span>
											</div>
										}
									}
								</div>
							}
							else
							{
								<div class="empty-parent-horiz">
									<iconify icon="lucide:plus" Size=@(20) Color="rgba(255,255,255,0.4)" />
									<span>Pick a beast</span>
								</div>
							}
						</div>
					</div>

					<!-- ====== SCROLLABLE BODY (hero + genes only) ====== -->
					<div class="fusion-body">

					@if (bothPicked && fusionCompat?.CanBreed == false)
					{
						<!-- Compat warning (same-species mismatch / contract risk / etc) -->
						<div class="fusion-warning">
							<iconify icon="lucide:triangle-alert" Size=@(20) Color="#ef4444" />
							<span class="warning-text">@fusionCompat.Reason</span>
						</div>
					}

					@if (fusionPreview != null)
					{
						<!-- ====== PREDICTED OFFSPRING HERO (single-row compact) ====== -->
						@{
							// Hero verdict badge — quick read of "is this fusion worth it?"
							// Compares predicted total against the BETTER parent total.
							// > best parent → IMPROVE (green up arrow)
							// = best parent → STABLE (gray equals)
							// < best parent → RISK (amber down arrow)
							var heroBetter = Math.Max(p1Total, p2Total);
							var heroVerdict = previewTotal > heroBetter ? "improved"
								: previewTotal == heroBetter ? "stable"
								: "downgrade";
							var heroVerdictIcon = previewTotal > heroBetter ? "lucide:trending-up"
								: previewTotal == heroBetter ? "lucide:equal"
								: "lucide:trending-down";
							var heroVerdictLabel = previewTotal > heroBetter ? "GAIN"
								: previewTotal == heroBetter ? "EVEN"
								: "RISK";
							var heroVerdictColor = previewTotal > heroBetter ? "#4ade80"
								: previewTotal == heroBetter ? "#9ca3af"
								: "#fbbf24";

							// Family fusion detection — true when both parents share the
							// same evolution line (compared via base form). Same family =
							// gene-farming loop. Different families = (future) cross-species
							// fusion that produces a different beast via the fusion table.
							var p1BaseId = MonsterManager.Instance?.GetSpecies(Parent1.SpeciesId);
							var p2BaseId = MonsterManager.Instance?.GetSpecies(Parent2.SpeciesId);
							var isFamilyFusion = p1BaseId != null && p2BaseId != null && p1BaseId.Id == p2BaseId.Id;
						}
						<div class="fusion-hero @(fusionPreview.PredictedQuality.ToLower())">
							<div class="hero-row">
								<iconify icon="lucide:sparkles" Size=@(14) Color="#c4b5fd" />
								<div class="hero-name">@GetSpeciesNameFor(Parent1)</div>
								<div class="hero-family-tag @(isFamilyFusion ? "family" : "cross")">
									<iconify icon="@(isFamilyFusion ? "lucide:dna" : "lucide:shuffle")" Size=@(10) Color="@(isFamilyFusion ? "#c4b5fd" : "#fbbf24")" />
									<span>@(isFamilyFusion ? "FAMILY" : "CROSS")</span>
								</div>
								<div class="hero-spacer"></div>
								<div class="hero-verdict @heroVerdict">
									<iconify icon="@heroVerdictIcon" Size=@(12) Color="@heroVerdictColor" />
									<span>@heroVerdictLabel</span>
								</div>
								<div class="hero-stat-line">
									<span class="hero-stat-value">~@previewTotal</span>
									<span class="hero-stat-max">/180</span>
								</div>
								<div class="hero-quality-badge @(fusionPreview.PredictedQuality.ToLower())">
									@fusionPreview.PredictedQuality
								</div>
							</div>
							<!-- Gene-total bar — fill colored by predicted quality tier.
							     Tier ticks are kept very faint so they don't fight the
							     fill color. -->
							<div class="hero-gene-bar-bg">
								<div class="hero-gene-bar-fill @(fusionPreview.PredictedQuality.ToLower())" style="width: @((previewTotal / 180f * 100f).ToString("F0"))%"></div>
								<div class="hero-gene-tick" style="left: 40%"></div>
								<div class="hero-gene-tick" style="left: 60%"></div>
								<div class="hero-gene-tick" style="left: 75%"></div>
								<div class="hero-gene-tick" style="left: 90%"></div>
							</div>
						</div>

						<!-- ====== GENE COMPARISON ROWS ====== -->
						<div class="fusion-genes-card">
							<div class="genes-card-header">
								<div class="genes-card-title">
									<iconify icon="lucide:dna" Size=@(14) Color="#c4b5fd" />
									<span>GENETICS</span>
								</div>
								@if (hasLockSkill)
								{
									<div class="genes-lock-counter">
										<iconify icon="lucide:lock" Size=@(11) Color="#fbbf24" />
										<span class="lock-current">@lockedGenes.Count</span>
										<span class="lock-max">/@maxLocks</span>
									</div>
								}
							</div>

							<!-- Column headers — tells the player which numbers are which beast -->
							<div class="gene-row gene-col-headers">
								<div class="gene-row-label"></div>
								<div class="gene-cell col-head">Beast 1</div>
								<div class="gene-cell col-head">Beast 2</div>
								<div class="gene-arrow"></div>
								<div class="gene-cell col-head predicted">Result</div>
								<div class="gene-lock-toggle empty"></div>
							</div>

							@{
								// Inline helper data so each row uses the same compact layout.
								var geneRows = new (string key, string label, int p1, int p2, int avg)[]
								{
									("HP",  "HP",  Parent1.Genetics.HPGene,  Parent2.Genetics.HPGene,  fusionPreview.AvgHP),
									("ATK", "ATK", Parent1.Genetics.ATKGene, Parent2.Genetics.ATKGene, fusionPreview.AvgATK),
									("DEF", "DEF", Parent1.Genetics.DEFGene, Parent2.Genetics.DEFGene, fusionPreview.AvgDEF),
									("SpA", "SpA", Parent1.Genetics.SpAGene, Parent2.Genetics.SpAGene, fusionPreview.AvgSpA),
									("SpD", "SpD", Parent1.Genetics.SpDGene, Parent2.Genetics.SpDGene, fusionPreview.AvgSpD),
									("SPD", "SPD", Parent1.Genetics.SPDGene, Parent2.Genetics.SPDGene, fusionPreview.AvgSPD),
								};
							}

							@foreach (var row in geneRows)
							{
								var key = row.key;
								var locked = lockedGenes.Contains(key);
								var canLockMore = hasLockSkill && (locked || lockedGenes.Count < maxLocks);
								var p1Best = row.p1 >= row.p2;
								var p2Best = row.p2 >= row.p1;
								// Verdict per gene: predicted vs the BETTER of the two parents.
								// > better parent → "improved" (green) — actually a gain
								// = better parent → "stable" (gold/default) — preserved high value
								// < better parent → "downgrade" (amber) — likely loss
								var betterParent = Math.Max(row.p1, row.p2);
								var verdict = row.avg > betterParent ? "improved"
									: row.avg == betterParent ? "stable"
									: "downgrade";
								<div class="gene-row @(locked ? "locked" : "")">
									<div class="gene-row-label gene-@key.ToLower()">@row.label</div>
									<div class="gene-cell @(p1Best ? "best" : "")">@row.p1</div>
									<div class="gene-cell @(p2Best ? "best" : "")">@row.p2</div>
									<div class="gene-arrow"><iconify icon="lucide:arrow-right" Size=@(12) Color="rgba(255,255,255,0.4)" /></div>
									<div class="gene-cell predicted @verdict">@row.avg</div>
									<div class="gene-lock-toggle @(locked ? "active" : "") @(!canLockMore && !locked ? "disabled" : "") @(!hasLockSkill ? "no-skill" : "")"
										 onclick=@(() => ToggleGeneLock(key))
										 onmouseover=@(() => SoundManager.PlayHover())>
										<iconify icon="@(locked ? "lucide:lock" : "lucide:lock-open")" Size=@(12) Color="@(locked ? "#fbbf24" : "rgba(255,255,255,0.4)")" />
									</div>
								</div>
							}

							@{
								// Total row verdict — same logic as per-row but on the sum.
								// Also compute a TYPICAL spread (~80% of outcomes) instead of
								// absolute worst-case extremes. The absolute min/max from
								// PreviewOffspring assume every gene rolls its worst variance
								// simultaneously, which is astronomically unlikely. The typical
								// spread is expected ± 6 (about 1.5 standard deviations across
								// 6 independent rolls of -2 to +2 variance).
								var betterParentTotal = Math.Max(p1Total, p2Total);
								var totalVerdict = previewTotal > betterParentTotal ? "improved"
									: previewTotal == betterParentTotal ? "stable"
									: "downgrade";
								var typicalSpread = 6;
								var minTotal = Math.Max(0, previewTotal - typicalSpread);
								var maxTotal = Math.Min(180, previewTotal + typicalSpread);
							}
							<div class="gene-row totals-row">
								<div class="gene-row-label">TOTAL</div>
								<div class="gene-cell @(p1Total >= p2Total ? "best" : "")">@p1Total</div>
								<div class="gene-cell @(p2Total >= p1Total ? "best" : "")">@p2Total</div>
								<div class="gene-arrow"><iconify icon="lucide:arrow-right" Size=@(12) Color="rgba(255,255,255,0.4)" /></div>
								<div class="gene-cell predicted @totalVerdict">~@previewTotal</div>
								<div class="gene-lock-toggle empty"></div>
							</div>
							<!-- Variance range under the totals row — tells the player how
							     wide the outcome spread is so they can judge risk. Uses
							     plain "to" because the en-dash collides with adjacent
							     numbers in s&box's font rendering. -->
							<div class="gene-range-row">
								<span class="gene-range-label">Range</span>
								<span class="gene-range-value">@minTotal to @maxTotal</span>
							</div>
						</div>

					}
					else if (!bothPicked)
					{
						<!-- Empty state — clean prompt, no tip wall -->
						<div class="fusion-empty">
							<div class="fusion-empty-icon">
								<iconify icon="lucide:flame" Size=@(48) Color="rgba(196, 181, 253, 0.4)" />
							</div>
							<div class="fusion-empty-title">Forge a New Lineage</div>
							<div class="fusion-empty-text">
								Choose two beasts of the same species. Their genes combine into a single offspring — both parents are consumed.
							</div>
							@if (Parent1 != null && Parent2 == null)
							{
								<div class="fusion-empty-hint">
									<iconify icon="lucide:arrow-up" Size=@(14) Color="#c4b5fd" />
									<span>Pick a second @GetSpeciesNameFor(Parent1)</span>
								</div>
							}
						</div>
					}

					</div>

				<!-- ====== STICKY FUSE CTA ======
				     Two-stage in-button confirm: first click arms the
				     `pendingFusionConfirm` flag and the button morphs
				     into "CONFIRM" with an amber accent. Second click
				     within ~4s actually fires the fusion. Replaces the
				     old centered modal popup. -->
				@if (bothPicked && fusionCompat?.CanBreed == true)
				{
					<div class="fusion-cta-bar">
						<div class="cta-cost @(canAffordFusion ? "" : "insufficient")">
							<img class="cta-cost-icon" src="ui/icons/currency/money.svg" />
							<span class="cta-cost-value">@fusionCost</span>
						</div>
						<button class="cta-fuse-btn @(canFuse ? "" : "disabled") @(pendingFusionConfirm ? "confirming" : "")"
								onclick=@OnBreedClicked
								onmouseover=@(() => SoundManager.PlayHover())>
							<iconify icon="@(pendingFusionConfirm ? "lucide:check" : "lucide:combine")" Size=@(18) Color="#ffffff" />
							<span class="cta-fuse-label">@(pendingFusionConfirm ? "CONFIRM" : L("ui.roster.fuse_btn"))</span>
						</button>
					</div>
				}
				}
				else
				{
					<div class="detail-scroll">
						<!-- Monster Portrait (always visible) -->
						<div class="portrait-section">
							<div class="portrait-wrapper">
								<div class="portrait-container @GetSelectedRarityClass() @GetEvolutionClass()">
									<div class="evolution-glow"></div>
									<div class="evolution-particles">
										<div class="particle p1"></div>
										<div class="particle p2"></div>
										<div class="particle p3"></div>
										<div class="particle p4"></div>
										<div class="particle p5"></div>
										<div class="particle p6"></div>
										<div class="particle p7"></div>
										<div class="particle p8"></div>
									</div>
									<div class="monster-portrait @(evolutionPhase == "transform" || evolutionPhase == "burst" ? "hidden" : "")" style="background-image: url(@GetSelectedIconPath())"></div>
									@if (!string.IsNullOrEmpty(evolvedIconPath) && (evolutionPhase == "transform" || evolutionPhase == "burst"))
									{
										<div class="monster-portrait evolved-portrait" style="background-image: url(@evolvedIconPath)"></div>
									}
								</div>
								<div class="element-tags-row">
								<div class="element-tag @GetSelectedElementClass()">
									<img class="element-tag-icon" src="ui/icons/elements/element_white/@(GetSelectedElementClass()).svg" />
									<span class="element-tag-text">@GetSelectedElementName()</span>
								</div>
								@if (HasSelectedSecondaryElement())
								{
									<div class="element-tag @GetSelectedSecondaryElementClass()">
										<img class="element-tag-icon" src="ui/icons/elements/element_white/@(GetSelectedSecondaryElementClass()).svg" />
										<span class="element-tag-text">@GetSelectedSecondaryElementName()</span>
									</div>
								}
							</div>
							</div>
							<div class="monster-name-section">
								<div class="nickname-row">
									@if (isEditingNickname)
									{
										<div class="nickname-input-wrapper">
											<TextEntry class="nickname-input" @ref="nicknameInput" Text="@editingNickname" />
										</div>
										<div class="nickname-btn save" onclick=@SaveNickname>✓</div>
										<div class="nickname-btn cancel" onclick=@CancelNicknameEdit>✕</div>
									}
									else
									{
										<div class="nickname">@SelectedMonster.Nickname</div>
										<div class="nickname-btn edit" onclick=@StartNicknameEdit>✎</div>
									}
								</div>
								<div class="species-name">@GetSelectedSpeciesName()</div>
								<div class="level-power-row">
									<div class="level-badge">LV @SelectedMonster.Level</div>
									<div class="power-badge">
										<span class="power-label">PWR</span>
										<span class="power-value">@SelectedMonster.PowerRating.ToString("N0")</span>
									</div>
								</div>
								<div class="portrait-xp-bar">
									<div class="xp-fill" style="width: @(SelectedMonster.Level >= 100 ? 100 : GetSelectedXPPercent())%"></div>
									<span class="xp-text-small">@(SelectedMonster.Level >= 100 ? "MAX" : $"{SelectedMonster.CurrentXP} / {SelectedMonster.XPToNextLevel} XP")</span>
								</div>
							</div>
							<!-- Diamond Actions (vertical) -->
							<div class="portrait-actions">
								<div class="detail-diamond" onclick=@ShowOffBeast onmouseover=@(() => SoundManager.PlayHover())>
									<div class="diamond-shape"><iconify icon="lucide:megaphone" Size=@(16) Color="white" /></div>
									<span class="diamond-tooltip">@L("ui.roster.show_off")</span>
								</div>
								@if (SelectedMonster.Journal != null && SelectedMonster.Journal.Count > 0)
								{
									<div class="detail-diamond" onclick=@OpenJournal onmouseover=@(() => SoundManager.PlayHover())>
										<div class="diamond-shape"><iconify icon="lucide:book-open" Size=@(16) Color="white" /></div>
										<span class="diamond-tooltip">@L("ui.roster.journal")</span>
									</div>
								}
								<div class="detail-diamond @(SelectedMonster.IsFavorite ? "active" : "")" onclick=@ToggleFavorite onmouseover=@(() => SoundManager.PlayHover())>
									<div class="diamond-shape"><iconify icon="lucide:star" Size=@(16) Color="@(SelectedMonster.IsFavorite ? "#fbbf24" : "white")" /></div>
									<span class="diamond-tooltip">@L("ui.roster.favorite")</span>
								</div>
							</div>
						</div>

						<!-- Actions (moved above stats per UX feedback — primary actions sit
						     near the portrait so the player doesn't have to scroll to find them) -->
						<div class="actions-section">
							<div class="section-title">ACTIONS</div>
							<div class="detail-actions-v2">
							@if (CanSelectedMonsterEvolve())
							{
								<button class="action-v2 evolve" onclick=@OnEvolveClicked onmouseover=@(() => SoundManager.PlayHover())>
									<div class="action-v2-diamond evolve-diamond">
										<iconify icon="lucide:sparkles" Size=@(16) Color="white" />
									</div>
									<span class="action-v2-text">@L("ui.roster.evolve_to") @GetSelectedMonsterEvolutionName()</span>
								</button>
							}
							<div class="action-v2-row">
								<button class="action-v2 item @(HasSelectedHeldItem() ? "has-item" : "no-item")" onclick=@OpenItemPicker onmouseover=@(() => SoundManager.PlayHover())>
									@* Ghost-child safety: always mount both icon slots, toggle
									   visibility via has-item/no-item class on the button. Avoids
									   s&box ghost-child bug when a Razor @if/else swaps different
									   child tag types (img vs iconify) inside a button during
									   state transitions. Mirrors shop GetBuyButtonContent. *@
									<div class="action-v2-diamond item-diamond">
										<img class="action-v2-item-img" src="@GetSelectedHeldItemIconPath()" onerror="this.style.display='none'" />
										<iconify class="action-v2-item-fallback" icon="lucide:shield" Size=@(16) Color="white" />
									</div>
									<span class="action-v2-text">@(HasSelectedHeldItem() ? GetSelectedHeldItemName() : L("ui.roster.item"))</span>
								</button>
								<button class="action-v2 fuse" onclick=@OnBreedFromDetail onmouseover=@(() => SoundManager.PlayHover())>
									<div class="action-v2-diamond fuse-diamond">
										<iconify icon="lucide:combine" Size=@(16) Color="white" />
									</div>
									<span class="action-v2-text">@L("ui.roster.fuse")</span>
								</button>
								<button class="action-v2 release @(CanReleaseMonster() ? "" : "disabled")" onclick=@OnReleaseClicked onmouseover=@(() => SoundManager.PlayHover())>
									<div class="action-v2-diamond release-diamond">
										<iconify icon="lucide:arrow-up-right" Size=@(16) Color="white" />
									</div>
									<span class="action-v2-text">@(CanReleaseMonster() ? L("ui.roster.release") : L("ui.roster.last"))</span>
								</button>
							</div>
						</div>
						</div>

						@if (showItemPicker)
						{
							<!-- Inline Item Picker -->
							<div class="inline-picker-header">
								<div class="picker-back" onclick=@CloseItemPicker onmouseover=@(() => SoundManager.PlayHover())>
									<iconify icon="lucide:arrow-left" Size=@(18) Color="white" />
								</div>
								<span class="picker-title-text">@L("ui.roster.item")</span>
								<span class="picker-count">@GetAvailableHeldItems().Count</span>
							</div>
							@if (HasSelectedHeldItem())
							{
								<div class="inline-equipped">
									<img class="inline-equipped-icon" src="@GetSelectedHeldItemIconPath()" />
									<div class="inline-equipped-info">
										<span class="inline-equipped-name">@GetSelectedHeldItemName()</span>
										<span class="inline-equipped-label">Equipped</span>
									</div>
									<button class="inline-unequip" onclick=@UnequipCurrentItem onmouseover=@(() => SoundManager.PlayHover())>
										<iconify icon="lucide:x" Size=@(14) Color="white" />
									</button>
								</div>
							}
							@foreach (var item in GetAvailableHeldItems())
							{
								<div class="inline-item @($"rarity-{GetItemRarityClass(item)}")" onclick="@(() => EquipItem(item.Id))" onmouseover="@(() => { if (hoveredPickerItem?.Id != item.Id) { hoveredPickerItem = item; SoundManager.PlayHover(); } })">
									<div class="inline-item-diamond @($"rarity-{GetItemRarityClass(item)}")">
										<img class="inline-item-img" src="@item.IconPath" />
									</div>
									<div class="inline-item-info">
										<div class="inline-item-name">@item.Name</div>
										<div class="inline-item-desc">@item.Description</div>
									</div>
									@if (GetItemQuantity(item.Id) > 1)
									{
										<span class="inline-item-qty">x@(GetItemQuantity(item.Id))</span>
									}
								</div>
							}
							@if (GetAvailableHeldItems().Count == 0)
							{
								<div class="inline-empty">
									<iconify icon="lucide:package-x" Size=@(24) Color="rgba(255,255,255,0.3)" />
									<span class="inline-empty-text">No held items</span>
								</div>
							}
						}
						else if (showMovePicker)
						{
							<!-- Inline Move Picker -->
							<div class="inline-picker-header">
								<div class="picker-back" onclick=@CloseMoveSwap onmouseover=@(() => SoundManager.PlayHover())>
									<iconify icon="lucide:arrow-left" Size=@(18) Color="white" />
								</div>
								<span class="picker-title-text">@(selectedMoveSlot < (SelectedMonster.Moves?.Count ?? 0) ? "Swap Move" : "Learn Move")</span>
								<span class="picker-count">@GetAvailableMovesForPicker().Count</span>
							</div>
							@if (selectedMoveSlot < (SelectedMonster.Moves?.Count ?? 0))
							{
								var currentMove = SelectedMonster.Moves[selectedMoveSlot];
								var currentDef = MoveDatabase.GetMove(currentMove.MoveId);
								@if (currentDef != null)
								{
									var curElClass = currentDef.Element.ToString().ToLower();
									<div class="inline-equipped">
										<img class="inline-equipped-icon" src="ui/icons/elements/background/@(curElClass).svg" />
										<div class="inline-equipped-info">
											<span class="inline-equipped-name">@currentDef.Name</span>
											<span class="inline-equipped-label">Replacing</span>
										</div>
									</div>
								}
							}
							@{
								// Current move for comparison (null if learning into empty slot)
								MoveDefinition pickerCurrentMove = null;
								if (selectedMoveSlot < (SelectedMonster.Moves?.Count ?? 0))
								{
									pickerCurrentMove = MoveDatabase.GetMove(SelectedMonster.Moves[selectedMoveSlot].MoveId);
								}
							}
							@foreach (var lm in GetAvailableMovesForPicker())
							{
								var moveDef = MoveDatabase.GetMove(lm.MoveId);
								if (moveDef != null)
								{
									var elClass = moveDef.Element.ToString().ToLower();
									var isStab = IsMoveSTAB(moveDef);
									var effectsSummary = GetMoveEffectsSummary(moveDef);
									var powerDiff = pickerCurrentMove != null && pickerCurrentMove.BasePower > 0 ? moveDef.BasePower - pickerCurrentMove.BasePower : 0;
									var isUpgrade = powerDiff > 0;
									var isDowngrade = powerDiff < 0;
									<div class="inline-item @elClass @(isStab ? "stab" : "") @(isUpgrade ? "upgrade" : "") @(isDowngrade ? "downgrade" : "")" onclick="@(() => SwapMoveSlot(lm.MoveId))" onmouseover=@(() => SoundManager.PlayHover())>
										<div class="inline-item-diamond @elClass">
											<img class="inline-item-img" src="ui/icons/elements/element_white/@(GetElementIconName(moveDef.Element)).svg" />
										</div>
										<div class="inline-item-info">
											<div class="inline-item-name-row">
												<span class="inline-item-name">@moveDef.Name</span>
												@if (isStab)
												{
													<span class="picker-stab-badge">STAB</span>
												}
											</div>
											<div class="inline-item-desc">@moveDef.Description</div>
											@if (!string.IsNullOrEmpty(effectsSummary))
											{
												<div class="inline-item-effects">
													<iconify icon="lucide:sparkles" Size=@(10) Color="#c4b5fd" />
													<span>@effectsSummary</span>
												</div>
											}
										</div>
										<div class="inline-move-stats">
											<span class="move-cat @moveDef.Category.ToString().ToLower()">@moveDef.Category.ToString().Substring(0, 3).ToUpper()</span>
											@if (moveDef.BasePower > 0)
											{
												<div class="move-pwr-row">
													<span class="move-pwr">@moveDef.BasePower</span>
													@if (powerDiff != 0)
													{
														<span class="move-pwr-diff @(isUpgrade ? "up" : "down")">@(powerDiff > 0 ? "+" : "")@powerDiff</span>
													}
												</div>
											}
											<span class="move-acc">@moveDef.Accuracy%</span>
										</div>
									</div>
								}
							}
							@if (GetAvailableMovesForPicker().Count == 0)
							{
								<div class="inline-empty">
									<iconify icon="lucide:swords" Size=@(24) Color="rgba(255,255,255,0.3)" />
									<span class="inline-empty-text">No other moves available</span>
								</div>
							}
						}
						else
						{

						<!-- Stats + Info Row -->
						<div class="stats-info-row">
							<!-- Stats Section -->
							<div class="stats-section">
								<div class="section-title">@L("ui.roster.stats")</div>
								<div class="stats-grid">
									<div class="stat-item">
										<div class="stat-header">
											<span class="stat-name">HP <span class="stat-gene">(@SelectedMonster.Genetics.HPGene/30)</span></span>
											<span class="stat-value">@SelectedMonster.MaxHP @if(GetStatVeteranBonus(SelectedMonster.MaxHP, true) > 0){<span class="stat-bonus">(+@GetStatVeteranBonus(SelectedMonster.MaxHP, true))</span>}</span>
										</div>
										<div class="stat-bar-bg">
											<div class="stat-bar-fill hp" style="width: @(GetStatPercent(SelectedMonster.MaxHP, 1330))%"></div>
										</div>
									</div>
									<div class="stat-item">
										<div class="stat-header">
											<span class="stat-name">ATK <span class="stat-gene">(@SelectedMonster.Genetics.ATKGene/30)</span></span>
											<span class="stat-value">@SelectedMonster.ATK @if(GetStatVeteranBonus(SelectedMonster.ATK) > 0){<span class="stat-bonus">(+@GetStatVeteranBonus(SelectedMonster.ATK))</span>}</span>
										</div>
										<div class="stat-bar-bg">
											<div class="stat-bar-fill atk" style="width: @(GetStatPercent(SelectedMonster.ATK, 1330))%"></div>
										</div>
									</div>
									<div class="stat-item">
										<div class="stat-header">
											<span class="stat-name">DEF <span class="stat-gene">(@SelectedMonster.Genetics.DEFGene/30)</span></span>
											<span class="stat-value">@SelectedMonster.DEF @if(GetStatVeteranBonus(SelectedMonster.DEF) > 0){<span class="stat-bonus">(+@GetStatVeteranBonus(SelectedMonster.DEF))</span>}</span>
										</div>
										<div class="stat-bar-bg">
											<div class="stat-bar-fill def" style="width: @(GetStatPercent(SelectedMonster.DEF, 1330))%"></div>
										</div>
									</div>
									<div class="stat-item">
										<div class="stat-header">
											<span class="stat-name">SpA <span class="stat-gene">(@SelectedMonster.Genetics.SpAGene/30)</span></span>
											<span class="stat-value">@SelectedMonster.SpA @if(GetStatVeteranBonus(SelectedMonster.SpA) > 0){<span class="stat-bonus">(+@GetStatVeteranBonus(SelectedMonster.SpA))</span>}</span>
										</div>
										<div class="stat-bar-bg">
											<div class="stat-bar-fill spa" style="width: @(GetStatPercent(SelectedMonster.SpA, 1330))%"></div>
										</div>
									</div>
									<div class="stat-item">
										<div class="stat-header">
											<span class="stat-name">SpD <span class="stat-gene">(@SelectedMonster.Genetics.SpDGene/30)</span></span>
											<span class="stat-value">@SelectedMonster.SpD @if(GetStatVeteranBonus(SelectedMonster.SpD) > 0){<span class="stat-bonus">(+@GetStatVeteranBonus(SelectedMonster.SpD))</span>}</span>
										</div>
										<div class="stat-bar-bg">
											<div class="stat-bar-fill spd-def" style="width: @(GetStatPercent(SelectedMonster.SpD, 1330))%"></div>
										</div>
									</div>
									<div class="stat-item">
										<div class="stat-header">
											<span class="stat-name">SPD <span class="stat-gene">(@SelectedMonster.Genetics.SPDGene/30)</span></span>
											<span class="stat-value">@SelectedMonster.SPD @if(GetStatVeteranBonus(SelectedMonster.SPD) > 0){<span class="stat-bonus">(+@GetStatVeteranBonus(SelectedMonster.SPD))</span>}</span>
										</div>
										<div class="stat-bar-bg">
											<div class="stat-bar-fill spd" style="width: @(GetStatPercent(SelectedMonster.SPD, 1330))%"></div>
										</div>
									</div>
								</div>
							</div>

							<!-- Info Section -->
							<div class="info-section">
								<div class="section-title">@L("ui.roster.info")</div>
								<div class="info-grid">
									<div class="info-row">
										<span class="info-label">@L("ui.roster.gen")</span>
										<span class="info-value">@(SelectedMonster.Generation == 0 ? L("ui.roster.wild") : $"{SelectedMonster.Generation}")</span>
									</div>
									<div class="info-row">
										<span class="info-label">@L("ui.roster.loyalty")</span>
										<span class="info-value @(SelectedMonster.IsLoyal ? "loyal" : "contracted")">@(SelectedMonster.IsLoyal ? L("ui.roster.loyal") : L("ui.roster.contract"))</span>
									</div>
									@if (!string.IsNullOrEmpty(SelectedMonster.OriginalTrainerName))
									{
										<div class="info-row">
											<span class="info-label">@L("ui.roster.ot")</span>
											<span class="info-value">@SelectedMonster.OriginalTrainerName</span>
										</div>
									}
									<div class="info-row">
										<span class="info-label">@L("ui.roster.obtained")</span>
										<span class="info-value">@SelectedMonster.CaughtAt.ToString("MMM d")</span>
									</div>
								</div>
								<!-- Quality + Nature cards — inline name + description, no
								     tooltips. Hover-gated info gets ignored; this shows
								     all the meaningful info at a glance. -->
								<div class="info-pills">
									<div class="info-card info-card-quality @GetSelectedGeneticsClass()">
										<div class="info-card-header">
											<span class="info-card-label">@L("ui.roster.quality")</span>
											<span class="info-card-value">@SelectedMonster.Genetics.QualityRating</span>
										</div>
										<span class="info-card-meta">@GetSelectedTotalGenes()/180 @L("ui.roster.genes")</span>
									</div>
									<div class="info-card info-card-nature">
										<div class="info-card-header">
											<span class="info-card-label">@L("ui.roster.nature")</span>
											<span class="info-card-value">@GetSelectedNature()</span>
										</div>
										<span class="info-card-meta">@GetSelectedNatureEffect()</span>
									</div>
								</div>
							</div>
						</div>

						<!-- Moves Section -->
						<div class="moves-section">
							<div class="section-title">
								@L("ui.roster.moves")
								@if (GetAvailableMovesCount() > 0)
								{
									<span class="moves-available-badge">@GetAvailableMovesCount() @L("ui.roster.available")</span>
								}
							</div>
							<div class="moves-grid-2x2">
								@{
									var moves = SelectedMonster.Moves ?? new List<MonsterMove>();
								}
								<!-- Row 1 -->
								<div class="moves-row">
									@for (int i = 0; i < 2; i++)
									{
										var slotIndex = i;
										@if (i < moves.Count)
										{
											var move = moves[i];
											var moveDef = MoveDatabase.GetMove(move.MoveId);
											if (moveDef != null)
											{
												var elementClass = moveDef.Element.ToString().ToLower();
												var isStab = IsMoveSTAB(moveDef);
												var effectsSummary = GetMoveEffectsSummary(moveDef);
												<div class="move-diamond-slot @elementClass @(GetAvailableMovesCount() > 0 ? "swappable" : "") @(isStab ? "stab" : "") has-move-tip" onclick="@(() => OpenMoveSwap(slotIndex))" onmouseover=@(() => SoundManager.PlayHover())>
													<div class="move-diamond-icon @elementClass">
														<img class="move-el-img" src="ui/icons/elements/element_white/@(GetElementIconName(moveDef.Element)).svg" />
													</div>
													<div class="move-diamond-info">
														<span class="move-diamond-name">@moveDef.Name</span>
														<div class="move-diamond-meta">
															<span class="move-cat @moveDef.Category.ToString().ToLower()">@moveDef.Category.ToString().Substring(0, 3).ToUpper()</span>
															@if (moveDef.BasePower > 0)
															{
																<span class="move-pwr">@moveDef.BasePower</span>
															}
															@if (isStab)
															{
																<span class="move-stab-badge">STAB</span>
															}
														</div>
													</div>
													<!-- Tooltip showing full description + accuracy + effects -->
													<div class="move-tooltip">
														<span class="move-tip-name">@moveDef.Name</span>
														<span class="move-tip-desc">@moveDef.Description</span>
														<div class="move-tip-stats">
															<span class="move-tip-stat">
																<span class="tip-label">ACC</span>
																<span class="tip-val">@moveDef.Accuracy%</span>
															</span>
															<span class="move-tip-stat">
																<span class="tip-label">PP</span>
																<span class="tip-val">@move.CurrentPP/@moveDef.MaxPP</span>
															</span>
															@if (moveDef.Priority != 0)
															{
																<span class="move-tip-stat">
																	<span class="tip-label">PRI</span>
																	<span class="tip-val">@(moveDef.Priority > 0 ? "+" : "")@moveDef.Priority</span>
																</span>
															}
														</div>
														@if (!string.IsNullOrEmpty(effectsSummary))
														{
															<span class="move-tip-effects">@effectsSummary</span>
														}
													</div>
												</div>
											}
										}
										else
										{
											<div class="move-diamond-slot empty" onclick="@(() => OpenMoveSwap(slotIndex))" onmouseover=@(() => SoundManager.PlayHover())>
												<div class="move-diamond-icon empty-icon">
													<span class="move-empty-plus">+</span>
												</div>
												<div class="move-diamond-info">
													<span class="move-diamond-name empty-text">Empty Slot</span>
												</div>
											</div>
										}
									}
								</div>
								<!-- Row 2 -->
								<div class="moves-row">
									@for (int i = 2; i < 4; i++)
									{
										var slotIndex = i;
										@if (i < moves.Count)
										{
											var move = moves[i];
											var moveDef = MoveDatabase.GetMove(move.MoveId);
											if (moveDef != null)
											{
												var elementClass = moveDef.Element.ToString().ToLower();
												var isStab = IsMoveSTAB(moveDef);
												var effectsSummary = GetMoveEffectsSummary(moveDef);
												<div class="move-diamond-slot @elementClass @(GetAvailableMovesCount() > 0 ? "swappable" : "") @(isStab ? "stab" : "") has-move-tip" onclick="@(() => OpenMoveSwap(slotIndex))" onmouseover=@(() => SoundManager.PlayHover())>
													<div class="move-diamond-icon @elementClass">
														<img class="move-el-img" src="ui/icons/elements/element_white/@(GetElementIconName(moveDef.Element)).svg" />
													</div>
													<div class="move-diamond-info">
														<span class="move-diamond-name">@moveDef.Name</span>
														<div class="move-diamond-meta">
															<span class="move-cat @moveDef.Category.ToString().ToLower()">@moveDef.Category.ToString().Substring(0, 3).ToUpper()</span>
															@if (moveDef.BasePower > 0)
															{
																<span class="move-pwr">@moveDef.BasePower</span>
															}
															@if (isStab)
															{
																<span class="move-stab-badge">STAB</span>
															}
														</div>
													</div>
													<!-- Tooltip showing full description + accuracy + effects -->
													<div class="move-tooltip">
														<span class="move-tip-name">@moveDef.Name</span>
														<span class="move-tip-desc">@moveDef.Description</span>
														<div class="move-tip-stats">
															<span class="move-tip-stat">
																<span class="tip-label">ACC</span>
																<span class="tip-val">@moveDef.Accuracy%</span>
															</span>
															<span class="move-tip-stat">
																<span class="tip-label">PP</span>
																<span class="tip-val">@move.CurrentPP/@moveDef.MaxPP</span>
															</span>
															@if (moveDef.Priority != 0)
															{
																<span class="move-tip-stat">
																	<span class="tip-label">PRI</span>
																	<span class="tip-val">@(moveDef.Priority > 0 ? "+" : "")@moveDef.Priority</span>
																</span>
															}
														</div>
														@if (!string.IsNullOrEmpty(effectsSummary))
														{
															<span class="move-tip-effects">@effectsSummary</span>
														}
													</div>
												</div>
											}
										}
										else
										{
											<div class="move-diamond-slot empty" onclick="@(() => OpenMoveSwap(slotIndex))" onmouseover=@(() => SoundManager.PlayHover())>
												<div class="move-diamond-icon empty-icon">
													<span class="move-empty-plus">+</span>
												</div>
												<div class="move-diamond-info">
													<span class="move-diamond-name empty-text">Empty Slot</span>
												</div>
											</div>
										}
									}
								</div>
							</div>
						</div>


						<!-- Lineage Section (for bred monsters) -->
						@if (SelectedMonster.Generation > 0 && (SelectedMonster.Parent1Id.HasValue || SelectedMonster.Parent2Id.HasValue))
						{
							<div class="lineage-section">
								<div class="section-title">@L("ui.roster.lineage")</div>
								<div class="lineage-info">
									<div class="lineage-row">
										<span class="lineage-label">@L("ui.roster.generation")</span>
										<span class="lineage-value">@SelectedMonster.Generation</span>
									</div>
									@if (SelectedMonster.Parent1Id.HasValue)
									{
										<div class="lineage-row">
											<span class="lineage-label">@L("ui.roster.source_1")</span>
											<span class="lineage-value">@GetParentName(SelectedMonster.Parent1Id.Value)</span>
										</div>
									}
									@if (SelectedMonster.Parent2Id.HasValue)
									{
										<div class="lineage-row">
											<span class="lineage-label">@L("ui.roster.source_2")</span>
											<span class="lineage-value">@GetParentName(SelectedMonster.Parent2Id.Value)</span>
										</div>
									}
								</div>
							</div>
						}

						<!-- Traits Section (sits between moves and battle mastery — traits
						     are character flavor that modify how moves work, so they
						     read naturally as a footnote to the moves above. Hidden
						     when the beast has no traits, so layout collapses cleanly). -->
						@if (SelectedMonster.Traits != null && SelectedMonster.Traits.Count > 0)
						{
							<div class="traits-section">
								<div class="section-title">@L("ui.roster.traits")</div>
								<div class="traits-list">
									@foreach (var traitId in SelectedMonster.Traits)
									{
										<div class="trait-card">
											<div class="trait-card-header">
												<iconify icon="lucide:sparkles" Size=@(12) Color="#a78bfa" />
												<span class="trait-card-name">@GetTraitName(traitId)</span>
											</div>
											<span class="trait-card-desc">@GetTraitDescription(traitId)</span>
										</div>
									}
								</div>
							</div>
						}

						<!-- Battle Mastery removed — mastery is now species-level in the Beastbook -->

					</div>

					}
				</div>
				}
				</div>
			}

			<!-- Release Confirmation Modal -->
			@if (showReleaseConfirm && monsterToRelease != null)
			{
				@{
					var _releaseSpecies = MonsterManager.Instance?.GetSpecies(monsterToRelease.SpeciesId);
					var _releaseElementClass = _releaseSpecies?.Element.ToString().ToLower() ?? "neutral";
				}
				<div class="bulk-release-overlay" onclick=@CancelRelease>
					<div class="bulk-release-panel" onclick:stopPropagation>
						<!-- Header with warning icon -->
						<div class="bulk-release-header">
							<div class="bulk-release-warning-icon">
								<iconify icon="lucide:triangle-alert" Size=@(28) Color="#ef4444" />
							</div>
							<div class="bulk-release-title-block">
								<span class="bulk-release-title">Release this Beast?</span>
								<span class="bulk-release-subtitle">This action cannot be undone</span>
							</div>
						</div>

						<!-- Single beast card -->
						<div class="bulk-release-list">
							<div class="bulk-release-card @($"element-{_releaseElementClass}")">
								<div class="bulk-release-card-portrait" style="background-image: url(@(_releaseSpecies?.IconPath ?? ""))"></div>
								<div class="bulk-release-card-info">
									<span class="bulk-release-card-name">@monsterToRelease.Nickname</span>
									<div class="bulk-release-card-meta">
										<span class="bulk-release-card-level">LV @monsterToRelease.Level</span>
										<img class="bulk-release-card-element" src="ui/icons/elements/element_white/@(_releaseElementClass).svg" />
									</div>
								</div>
							</div>
						</div>

						<!-- Action buttons -->
						<div class="bulk-release-buttons">
							<button class="bulk-release-btn cancel" onclick=@CancelRelease onmouseover=@(() => SoundManager.PlayHover())>
								<iconify icon="lucide:x" Size=@(16) Color="white" />
								<span>@L("ui.common.cancel")</span>
							</button>
							<button class="bulk-release-btn release" onclick=@ConfirmRelease onmouseover=@(() => SoundManager.PlayHover())>
								<iconify icon="lucide:trash-2" Size=@(16) Color="white" />
								<span>@L("ui.roster.release")</span>
							</button>
						</div>
					</div>
				</div>
			}

	
			<!-- Journal Modal -->
			@if (showJournalModal && SelectedMonster != null)
			{
				<div class="journal-modal-overlay" onclick=@CloseJournal>
					<div class="journal-modal" onclick:stopPropagation>
						<div class="journal-modal-header">
							<div class="journal-modal-title">
								<span class="journal-icon">📖</span>
								<span class="journal-name">@(string.IsNullOrEmpty(SelectedMonster.Nickname) ? GetSelectedSpeciesName() : SelectedMonster.Nickname)'s Journal</span>
							</div>
							<button class="journal-close-btn" onclick=@CloseJournal><img class="close-icon" src="ui/icons/buttons/close.svg" /></button>
						</div>
						<div class="journal-modal-content">
							@if (SelectedMonster.Journal != null && SelectedMonster.Journal.Count > 0)
							{
								@foreach (var entry in SelectedMonster.Journal.OrderByDescending(e => e.Timestamp))
								{
									<div class="journal-modal-entry @GetJournalEntryClass(entry.Type) @(!string.IsNullOrEmpty(entry.ZoneId) ? "has-background" : "") @(entry.Type == JournalEntryType.BossDefeat ? "has-monster" : "")" style="@GetEntryBackgroundStyle(entry)">
										<span class="entry-icon">@GetJournalEntryIcon(entry.Type)</span>
										<div class="entry-body">
											<div class="entry-text">@entry.Content</div>
											<div class="entry-meta">
												<div class="entry-badge @GetJournalEntryClass(entry.Type)">
													<span class="badge-text">@GetJournalEntryBadge(entry.Type)</span>
												</div>
												<div class="entry-timestamp">@entry.Timestamp.ToString("MMM d, yyyy") at @entry.Timestamp.ToString("h:mm tt")</div>
											</div>
										</div>
										@if (entry.Type == JournalEntryType.BossDefeat)
										{
											<div class="entry-monster">
												@if (!string.IsNullOrEmpty(entry.SpeciesId))
												{
													<img src="@GetJournalSpeciesIcon(entry.SpeciesId)" />
												}
												else
												{
													<span class="monster-placeholder">💀</span>
												}
											</div>
										}
									</div>
								}
							}
							else
							{
								<div class="journal-empty">@L("ui.roster.journal_empty")</div>
							}
						</div>
					</div>
				</div>
			}
		</div>
		</div>

	<!-- Move Picker Modal (at root level for full coverage) -->

	<!-- Fusion confirmation popup REMOVED — replaced with the
	     two-stage in-button confirm on the FUSE CTA. See
	     pendingFusionConfirm + RunFusionConfirmTimeout in @code. -->

	<!-- Fusion Result Modal — REVERTED to original simple structure
	     after multiple failed attempts at the v2 redesign. Keeping the
	     original markup that we know works; v2 redesign is shelved. -->
	@if (showResult && breedingResult != null)
	{
		<div class="result-overlay @(isFusionAnimating ? "animating" : "")">
			<!-- Result Panel - always visible, animation plays inside.
			     The `tier-X` class colors the panel border based on the
			     offspring's quality (gold for Perfect, purple for Excellent, etc) -->
			<div class="result-panel @(isFusionAnimating ? "fusing" : "") @(breedingResult?.Genetics != null ? $"tier-{breedingResult.Genetics.QualityRating.ToLower()}" : "")">
				<!-- Fusion Animation (inside panel) -->
				@if (isFusionAnimating)
				{
					<div class="fusion-animation-container @fusionPhase">
						<!-- DNA Helix Spirals -->
						<div class="dna-helix left">
							@for (int i = 0; i < 8; i++)
							{
								<div class="helix-particle p@(i)"></div>
							}
						</div>
						<div class="dna-helix right">
							@for (int i = 0; i < 8; i++)
							{
								<div class="helix-particle p@(i)"></div>
							}
						</div>

						<!-- Swirling energy particles -->
						<div class="energy-vortex">
							@for (int i = 0; i < 12; i++)
							{
								<div class="vortex-particle p@(i)"></div>
							}
						</div>

						<!-- Central fusion core -->
						<div class="fusion-core">
							<div class="core-inner"></div>
							<div class="core-ring r1"></div>
							<div class="core-ring r2"></div>
							<div class="core-ring r3"></div>
						</div>

						<!-- Flash effect -->
						<div class="fusion-flash"></div>
					</div>
				}

				<!-- Result Content (hidden during animation, revealed after) -->
				<div class="result-content-wrapper @(isFusionAnimating ? "hidden" : "revealed")">
					@{
						// Hero data — pulled up so the title row can also use the
						// quality class for its tier badge.
						var heroSpecies = MonsterManager.Instance?.GetSpecies(breedingResult.SpeciesId);
						var heroSprite = heroSpecies?.IconPath ?? "";
						var heroQualityClass = breedingResult.Genetics?.QualityRating?.ToLower() ?? "average";
						var heroQuality = breedingResult.Genetics?.QualityRating ?? "Average";
						var heroElement = heroSpecies?.Element.ToString().ToLower() ?? "neutral";
						var heroSecondaryElement = heroSpecies?.SecondaryElement?.ToString().ToLower();
						var heroRarity = heroSpecies?.BaseRarity.ToString() ?? "Common";
						var heroRarityClass = heroRarity.ToLower();
					}
					@{
						var rTotal = GetResultTotalGenes();
						var rDelta = rTotal - lastFusionExpectedTotal;
						var rvxClass = rDelta >= 3 ? "lucky" : rDelta <= -3 ? "harsh" : "ontarget";
						var rvxLabel = rDelta >= 3 ? "LUCKY" : rDelta <= -3 ? "HARSH" : "ON TARGET";
						var rvxSign = rDelta > 0 ? "+" : "";
						// Nature source — player-friendly labels
						var natSrc = GetNatureSource();
						var natSrcLabel = natSrc == "both" ? "inherited" : natSrc == "b1" ? $"from {lastFusionParent1?.Nickname ?? "B1"}" : natSrc == "b2" ? $"from {lastFusionParent2?.Nickname ?? "B2"}" : "random";
						// Element name for display
						var heroElementName = heroSpecies?.Element.ToString() ?? "Neutral";
					}

					<!-- Title -->
					<div class="result-title">
						<iconify icon="lucide:sparkles" Size=@(22) Color="#fbbf24" />
						<span>FUSION COMPLETE</span>
						<span class="result-tier-badge @heroQualityClass">@heroQuality</span>
					</div>

					<!-- Hero row: mini card + info side by side.
					     Uses IsMini (cleaner — just sprite + LV pill + name bar)
					     instead of IsCompact which duplicates PWR/rarity/element
					     that the right column already shows. -->
					<div class="result-content">
						<MonsterCard Monster=@breedingResult IsMini=@true ShowGenes=@true AnimationFrame=@SpriteAnimator.GlobalFrame />
						<div class="result-right">
							<div class="result-hero-name"><span>@(string.IsNullOrEmpty(breedingResult.Nickname) ? heroSpecies?.Name : breedingResult.Nickname)</span></div>
							<!-- Element type + Rarity -->
							<div class="result-hero-sub">
								<img class="result-hero-el" src="ui/icons/elements/background/@(heroElement).svg" />
								<span>@heroElementName</span>
								@if (heroSecondaryElement != null)
								{
									<span class="result-sep">/</span>
									<img class="result-hero-el secondary" src="ui/icons/elements/background/@(heroSecondaryElement).svg" />
									<span>@(heroSpecies.SecondaryElement?.ToString() ?? "")</span>
								}
								<span class="result-sep">·</span>
								<span class="result-hero-rarity @heroRarityClass">@heroRarity</span>
							</div>
							<!-- Power Rating -->
							<div class="result-hero-power">
								<iconify icon="lucide:zap" Size=@(14) Color="#fbbf24" />
								<span class="pwr-label">PWR</span>
								<span class="pwr-value">@breedingResult.PowerRating.ToString("N0")</span>
							</div>
							<!-- Gene total + bar -->
							<div class="result-gene-line">
								<iconify icon="lucide:dna" Size=@(13) Color="#c4b5fd" />
								<span class="result-gene-total">@rTotal</span>
								<span class="result-gene-max">/180</span>
							</div>
							<div class="result-gene-bar-bg">
								<div class="result-gene-bar-fill @heroQualityClass" style="width: @((rTotal / 180f * 100f).ToString("F0"))%"></div>
							</div>
						</div>
					</div>

					<!-- Roll vs Expected -->
					@if (lastFusionExpectedTotal > 0)
					{
						<div class="result-section result-rvx-row">
							<span class="result-section-label">RESULT</span>
							<span class="rvx-expected">~@lastFusionExpectedTotal expected</span>
							<span class="rvx-verdict @rvxClass">
								<span>@rvxSign@rDelta @rvxLabel</span>
							</span>
						</div>
					}

					<!-- Genetics — simple text grid, no boxes. Colored label +
					     white value inline. Two rows of three pairs. -->
					<div class="result-section">
						<span class="result-section-label">GENETICS</span>
					</div>
					<div class="result-stat-grid">
						<div class="result-stat-row">
							<div class="result-stat"><span class="stat-label hp">HP</span><span class="stat-val">@breedingResult.Genetics.HPGene</span></div>
							<div class="result-stat"><span class="stat-label atk">ATK</span><span class="stat-val">@breedingResult.Genetics.ATKGene</span></div>
							<div class="result-stat"><span class="stat-label def">DEF</span><span class="stat-val">@breedingResult.Genetics.DEFGene</span></div>
						</div>
						<div class="result-stat-row">
							<div class="result-stat"><span class="stat-label spa">SpA</span><span class="stat-val">@breedingResult.Genetics.SpAGene</span></div>
							<div class="result-stat"><span class="stat-label spd-def">SpD</span><span class="stat-val">@breedingResult.Genetics.SpDGene</span></div>
							<div class="result-stat"><span class="stat-label spd">SPD</span><span class="stat-val">@breedingResult.Genetics.SPDGene</span></div>
						</div>
					</div>

					<!-- Traits inherited -->
					@if (breedingResult.Traits != null && breedingResult.Traits.Count > 0)
					{
						<div class="result-section">
							<span class="result-section-label">TRAITS INHERITED</span>
							<div class="result-traits">
								@foreach (var trait in breedingResult.Traits)
								{
									var src = GetTraitSource(trait);
									var srcLabel = src == "both" ? "inherited"
										: src == "b1" ? $"from {lastFusionParent1?.Nickname ?? "parent"}"
										: src == "b2" ? $"from {lastFusionParent2?.Nickname ?? "parent"}"
										: "new";
									<span class="result-trait has-tooltip">
										<iconify icon="lucide:zap" Size=@(11) Color="#fbbf24" />
										<span class="result-trait-name">@GetTraitName(trait)</span>
										<span class="result-trait-src @src">@srcLabel</span>
										<span class="result-popup-tip">@GetTraitDescription(trait)</span>
									</span>
								}
							</div>
						</div>
					}

					<!-- Nature -->
					<div class="result-section result-nature-row has-tooltip">
						<iconify icon="lucide:leaf" Size=@(14) Color="#86efac" />
						<span class="nature-name">@breedingResult.Genetics.Nature</span>
						<span class="nature-src @natSrc">@natSrcLabel</span>
						<span class="result-popup-tip">@breedingResult.Genetics.GetNatureDescription()</span>
					</div>

					<!-- CTAs -->
					<div class="result-cta-row">
						<button class="result-btn secondary" onclick=@CloseResult onmouseover=@(() => SoundManager.PlayHover())>
							<span>CONTINUE</span>
						</button>
						<button class="result-btn primary" onclick=@FuseAgain onmouseover=@(() => SoundManager.PlayHover())>
							<iconify icon="lucide:combine" Size=@(16) Color="#ffffff" />
							<span>FUSE AGAIN</span>
						</button>
					</div>
				</div>
			</div>
		</div>
	}
</div>

@if (showBulkReleaseConfirm && selectedForRelease.Count > 0)
{
	<div class="bulk-release-overlay" onclick=@CancelBulkRelease>
		<div class="bulk-release-panel" onclick:stopPropagation>
			<!-- Header with warning icon -->
			<div class="bulk-release-header">
				<div class="bulk-release-warning-icon">
					<iconify icon="lucide:triangle-alert" Size=@(28) Color="#ef4444" />
				</div>
				<div class="bulk-release-title-block">
					<span class="bulk-release-title">Release @selectedForRelease.Count @(selectedForRelease.Count == 1 ? "Beast" : "Beasts")?</span>
					<span class="bulk-release-subtitle">This action cannot be undone</span>
				</div>
			</div>

			<!-- Beast cards being released — show first 3 + "more" pill so
			     the popup stays a fixed compact size regardless of selection
			     count. Players don't need to see all N beasts to confirm,
			     they need to understand what kind of release this is. -->
			<div class="bulk-release-list">
				@foreach (var monsterId in selectedForRelease.Take(3))
				{
					var monster = MonsterManager.Instance?.OwnedMonsters?.FirstOrDefault(m => m.Id == monsterId);
					if (monster != null)
					{
						var species = MonsterManager.Instance?.GetSpecies(monster.SpeciesId);
						var elementClass = species?.Element.ToString().ToLower() ?? "neutral";
						<div class="bulk-release-card @($"element-{elementClass}")">
							<div class="bulk-release-card-portrait" style="background-image: url(@(species?.IconPath ?? ""))"></div>
							<div class="bulk-release-card-info">
								<span class="bulk-release-card-name">@monster.Nickname</span>
								<div class="bulk-release-card-meta">
									<span class="bulk-release-card-level">LV @monster.Level</span>
									<img class="bulk-release-card-element" src="ui/icons/elements/element_white/@(elementClass).svg" />
								</div>
							</div>
						</div>
					}
				}
				@if (selectedForRelease.Count > 3)
				{
					<div class="bulk-release-more-pill">
						<iconify icon="lucide:more-horizontal" Size=@(14) Color="rgba(255,255,255,0.5)" />
						<span>and @(selectedForRelease.Count - 3) more</span>
					</div>
				}
			</div>

			<!-- Action buttons -->
			<div class="bulk-release-buttons">
				<button class="bulk-release-btn cancel" onclick=@CancelBulkRelease onmouseover=@(() => SoundManager.PlayHover())>
					<iconify icon="lucide:x" Size=@(16) Color="white" />
					<span>@L("ui.common.cancel")</span>
				</button>
				<button class="bulk-release-btn release" onclick=@ConfirmBulkRelease onmouseover=@(() => SoundManager.PlayHover())>
					<iconify icon="lucide:trash-2" Size=@(16) Color="white" />
					<span>Release @selectedForRelease.Count</span>
				</button>
			</div>
		</div>
	</div>
}

@code {
	// Localization helper
	private string L( string key ) => LocalizationManager.Get( key );
