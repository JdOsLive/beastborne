	private float GetStatPercent(int value, int max)
	{
		return Math.Min(100, (float)value / max * 100);
	}

	// 1B stat gauge fill — EXPLICIT PX, not %: the .sb-bar container is
	// skewX-transformed, and a % width under a transformed ancestor is
	// in the derived-width poison family (QuestPanel law). 270 = the
	// bar's explicit content width (see the .razor.scss width math).
	//
	// Scale recalibrated 2026-07-05 (user: "what's the highest number
	// obtainable?"). Formula: Base + Lv×Growth×0.6 + Gene, Lv cap 50,
	// gene cap 30. Launch-roster ceiling = Manehelm ATK: 118 + 50×9×0.6
	// + 30 = 418 raw; ×1.10 nature ×1.12 mastery ≈ 515 fully buffed.
	// 550 leaves headroom for skill/relic % stacking; the old 1330 was
	// a relic that capped even the strongest stat at ~35% fill.
	// GetStatPercent clamps at 100, so over-550 stacks just fill the bar.
	private string GetStatBarPx(int value)
	{
		return $"{(int)(GetStatPercent(value, 550) * 2.70f)}px";
	}

	// RECORD tile numerals — compact abbreviation (user 2026-07-05:
	// "k for thousand because it could get very long"). Full digits up
	// to 9,999; then one-decimal K/M/B with the trailing .0 dropped
	// (117,687 → 117.7K; 12,000 → 12K).
	private string FormatRecordValue( long value )
	{
		string Compact( double v, string suffix )
		{
			var s = (Math.Floor( v * 10 ) / 10).ToString( "0.#" );
			return $"{s}{suffix}";
		}
		if ( value >= 1_000_000_000 ) return Compact( value / 1_000_000_000d, "B" );
		if ( value >= 1_000_000 ) return Compact( value / 1_000_000d, "M" );
		if ( value >= 10_000 ) return Compact( value / 1_000d, "K" );
		return value.ToString( "N0" );
	}

