@namespace Beastborne.UI.Panels
@using Sandbox;
@using Sandbox.UI;
@using Beastborne.Core;
@using Beastborne.Data;
@using Beastborne.Systems;
@using Beastborne.UI.Components;
@using Beastborne.UI.Primitives;
@inherits Panel

<div class="roster-panel @(isFusionMode ? "fusion-view" : "") @(IsKbMode ? "kbd-mode" : "mouse-mode")" onclick=@OnPanelClicked onmousemove=@OnRootMouseMove>
	@* Living background: the panel's own app glyph drifting at the house
	   angle (BbIconScroll supplies the base fill — root paints none). *@
	<BbIconScroll Icon="beasts" />
	@* ═══ DEV: MY-BEASTS ART POSITION EDITOR ═══════════════════════
	   Hidden behind ShowMyBeastsArtEditor. Two modes:
	     CARD   — drag/scroll any grid mini-card sprite to tune
	              MonsterSpecies.MiniScale / MiniOffsetX / MiniOffsetY
	     DETAIL — drag/scroll the small detail-panel sprite (the
	              little square icon next to the selected beast's
	              stats) to tune DetailIconScale/OffsetX/OffsetY.
	   Both surfaces persist independently to FileSystem.Data and
	   load on first mount regardless of editor state, so any tuning
	   sticks even with the editor toggled off. SAVE → CONSOLE prints
	   paste-ready C# blocks for MonsterManager.cs. *@
	@if ( ShowMyBeastsArtEditor )
	{
		@{
			var allTestable = GetAllTestableSpecies();
			var currentTestIdx = string.IsNullOrEmpty( _myBeastsTestSpeciesId )
				? -1
				: allTestable.FindIndex( s => s.Id == _myBeastsTestSpeciesId );
			var currentTestSp = currentTestIdx >= 0 ? allTestable[currentTestIdx] : null;
		}
		<div class="myb-art-toolbar">
			<div class="myb-label">BEAST ART</div>
			<button class="myb-btn mode @(_myBeastsEditMode == "card" ? "active" : "")" onclick=@(() => SetMyBeastsArtMode("card"))>
				<iconify icon="lucide:grid-2x2" Size=@(13) Color="#fbbf24" />
				<span>CARD</span>
			</button>
			<button class="myb-btn mode @(_myBeastsEditMode == "detail" ? "active" : "")" onclick=@(() => SetMyBeastsArtMode("detail"))>
				<iconify icon="lucide:square-user" Size=@(13) Color="#fbbf24" />
				<span>ICON</span>
			</button>

			@* Test-species selector — pick any species (whether owned or not)
			   and the grid cards (CARD mode) or detail portrait (ICON mode)
			   render that species so framing can be tuned without owning it. *@
			<button class="myb-btn nav" onclick=@MyBeastsTestPrev>
				<iconify icon="lucide:chevron-left" Size=@(14) Color="#cbd5e1" />
			</button>
			<div class="myb-current-species">
				<span>@(currentTestSp?.Name ?? "OFF")</span>
			</div>
			<button class="myb-btn nav" onclick=@MyBeastsTestNext>
				<iconify icon="lucide:chevron-right" Size=@(14) Color="#cbd5e1" />
			</button>
			<button class="myb-btn nav" onclick=@MyBeastsTestClear>
				<iconify icon="lucide:x" Size=@(13) Color="#f87171" />
			</button>

			<button class="myb-btn save" onclick=@PrintMyBeastsArt>
				<iconify icon="lucide:save" Size=@(13) Color="#4ade80" />
				<span>SAVE</span>
			</button>
			<button class="myb-btn reset" onclick=@ResetMyBeastsArt>
				<iconify icon="lucide:refresh-ccw" Size=@(13) Color="#f87171" />
				<span>RESET</span>
			</button>
			<div class="myb-hint">
				<span>drag · scroll</span>
				@{
					var mybCount = _myBeastsEditMode == "detail" ? _detailIconOverrides.Count : _myBeastsCardOverrides.Count;
				}
				@if ( mybCount > 0 )
				{
					<span class="myb-count">@mybCount edited</span>
				}
			</div>
		</div>

		@* Drag shield — fullscreen overlay during art-edit drag. *@
		@if ( !string.IsNullOrEmpty( _myBeastsDraggingId ) )
		{
			<div class="myb-art-drag-shield"
				 onmousemove=@OnMyBeastsArtDragMove
				 onmouseup=@OnMyBeastsArtDragEnd></div>
		}
	}
	@* ═══ IDENTITY HEADER (2026-07 sweep) — violet kicker + big italic
	   title + skewed accent seam dashes; storage as a skew-slab chip;
	   FilterBar + mode toggles right-anchored in the same band. The
	   header stays OPAQUE with gap 0 to the grid (scroll-leak law). *@
	<div class="roster-header">
		@* Living wave band (turn 7A) — counter-flowing accent waves under
		   the header content. The component paints the header's opaque
		   base fill (the old background-color moved onto .bhw-base —
		   paint-behind law); host positioning rule lives in the scss
		   (.roster-header > .bhw-root). Accent value-swaps to the fusion
		   pink when the forge takes the header. *@
		<BbHeaderWaves Accent=@(isFusionMode ? "pink" : "violet") />
		<div class="rh-identity">
			<span class="rh-kicker">@(isFusionMode ? "GENE FORGE" : "COLLECTION")</span>
			<div class="rh-title-row">
				<span class="rh-title">@(isFusionMode ? L("ui.roster.contract_fusion") : L("ui.roster.my_beasts"))</span>
				<div class="rh-seam"></div>
				<div class="rh-seam dim"></div>
			</div>
		</div>
		<div class="rh-toolbar">
			@if (!isMultiSelectMode && !isFusionMode)
			{
				<FilterBar @ref="filterBar"
						   CurrentElement=@currentFilter
						   CurrentSort=@currentSort
						   CurrentRarity=@currentRarity
						   SortAscending=@sortAscending
						   ShowBeastiarySort=@true
						   ShowRarityFilter=@true
						   OnElementChanged=@OnElementChanged
						   OnSortChanged=@OnSortChanged
						   OnRarityChanged=@OnRarityChanged
						   OnNameFilterChanged=@OnNameFilterChanged
						   OnSortDirectionChanged=@OnSortDirectionChanged
						   AvailableNames=@GetMonsterNames() />
			}
			@if (isFusionMode)
			{
				<FilterBar @ref="breedingFilterBar"
						   CurrentElement=@breedingFilter
						   CurrentSort=@breedingSort
						   CurrentRarity=@breedingRarity
						   SortAscending=@breedingSortAscending
						   ShowBeastiarySort=@true
						   ShowRarityFilter=@true
						   OnElementChanged=@OnBreedingElementChanged
						   OnSortChanged=@OnBreedingSortChanged
						   OnRarityChanged=@OnBreedingRarityChanged
						   OnNameFilterChanged=@OnBreedingNameFilterChanged
						   OnSortDirectionChanged=@OnBreedingSortDirectionChanged
						   AvailableNames=@GetBreedingMonsterNames() />
			}
			@if (!isMultiSelectMode)
			{
				<button class="sort-btn fusion-toggle @(isFusionMode ? "active-mode" : "")"
						onclick=@ToggleFusionMode
						onmouseover=@OnHoverBlip>
					<span class="pill-label">@(isFusionMode ? L("ui.roster.cancel") : L("ui.beast.fuse"))</span>
				</button>
			}
			@if (!isFusionMode)
			{
				<button class="sort-btn multi-select @(isMultiSelectMode ? "active-mode" : "")"
						onclick=@ToggleMultiSelectMode
						onmouseover=@OnHoverBlip>
					<span class="pill-label">@(isMultiSelectMode ? L("ui.roster.cancel") : L("ui.roster.multi_release"))</span>
				</button>
			}
			@* Release-confirm moved OUT of the header — the multi-release
			   confirm bar now docks under the stage (.ms-dockbar). *@
		</div>
		<div class="rh-storage">
			<div class="rh-storage-in">
				<img class="rh-storage-icon" src="ui/icons/sort/box.svg" />
				<span class="rh-storage-text">@GetMonsterCount() / @GetMaxMonsters()</span>
			</div>
		</div>
	</div>

	@* ═══ CENTER STAGE (2026-07 rebuild) ══════════════════════════════════
	   Three zones: COLLECTION (left rail, 4-col mini-card grid) / STAGE
	   (center, the selected beast at 2.5x on an open floor) / FACTS
	   (right, scrolling dossier). cs-inspect wraps STAGE + FACTS and
	   carries detailScrollRef so the ONE living ring can walk both zones
	   (kb .kb-focused path + mouse-hover path). Fusion turns the stage
	   into the altar; multi-release docks its confirm bar under the
	   stage actions. *@
	<div class="cs-zones">

		@* ────── COLLECTION (left) ────── *@
		<div class="cs-collection">
			<div @ref="rosterGridRef" class="roster-grid" onmouseup=@OnDragSelectEnd>
			@{
				// In fusion mode, use the breeding filter state (separate from the
				// collection filter state) so swapping in/out of fusion mode doesn't
				// disturb the player's primary collection sort/filter setup.
				var collectionMonsters = isFusionMode ? GetAvailableBreedingMonsters() : GetFilteredMonsters();
				var keyboardIdx = Math.Clamp(selectedMonsterIndex, 0, Math.Max(0, collectionMonsters.Count - 1));
			}
			@for (int i = 0; i < collectionMonsters.Count; i++)
			{
				var monster = collectionMonsters[i];
				var idx = i;
				var isKeyboardSelected = IsKbMode && i == keyboardIdx;
				var isSelectedForRelease = selectedForRelease.Contains(monster.Id);
				var isFusionParent1 = isFusionMode && Parent1?.Id == monster.Id;
				var isFusionParent2 = isFusionMode && Parent2?.Id == monster.Id;
				var isFusionParent = isFusionParent1 || isFusionParent2;
				var isFusionIncompatible = isFusionMode && Parent1 != null && !isFusionParent && monster.SpeciesId != Parent1.SpeciesId;
				// Beast-art editor is only active in "card" mode, when the
				// editor toolbar is enabled, and when no other interaction
				// mode (fusion / multi-select) is competing for clicks.
				var _mybCardEditing = ShowMyBeastsArtEditor && _myBeastsEditMode == "card" && !isFusionMode && !isMultiSelectMode;
				<div @ref="cardSizeRef" class="monster-card-wrapper @(releasingIds.Contains(monster.Id) ? "releasing" : "") @(isMultiSelectMode ? "multi-select-mode" : "") @(isSelectedForRelease ? "selected-for-release" : "") @(isFusionMode ? "fusion-mode" : "") @(isFusionParent ? "fusion-parent" : "") @(isFusionIncompatible ? "fusion-incompatible" : "") @(_mybCardEditing ? "myb-art-edit" : "")"
					 onclick=@(() => OnMonsterCardClicked(monster, idx))
					 onmousedown=@((e) => { OnCardMouseDown(monster, idx); if (isMultiSelectMode) e.StopPropagation(); if (_mybCardEditing) StartMyBeastsArtDrag(_myBeastsTestSpeciesId ?? monster.SpeciesId); })
					 onmouseover=@(() => { OnCardMouseEnter(monster, idx); if (_mybCardEditing) OnMyBeastsArtHover(_myBeastsTestSpeciesId ?? monster.SpeciesId); })
					 onmouseout=@(() => { if (_mybCardEditing) OnMyBeastsArtLeave(_myBeastsTestSpeciesId ?? monster.SpeciesId); })
					 onmouseup=@OnDragSelectEnd>
					@if (justSelectedMonsterId.HasValue && justSelectedMonsterId.Value == monster.Id)
					{
						@* One-shot select pulse. Keyed on selectPulseVersion so
						   each click remounts the overlay and css-keyframes fire
						   fresh (s&box quirk: keyframes only run on first mount).
						   Removes itself visually via SCSS opacity: 0 end-state. *@
						<div class="select-pulse pulse-@selectPulseVersion"></div>
					}
					@if (isMultiSelectMode)
					{
						<div class="select-checkbox @(isSelectedForRelease ? "checked" : "")">
							@(isSelectedForRelease ? "✓" : "")
						</div>
					}
					@if (isFusionParent1)
					{
						<div class="parent-indicator p1">B1</div>
					}
					@if (isFusionParent2)
					{
						<div class="parent-indicator p2">B2</div>
					}
					@{
						// Card is hovered if it matches the hoveredMonsterId
						var isThisCardHovered = hoveredMonsterId.HasValue && hoveredMonsterId.Value == monster.Id;
						// Card is selected if it's the SelectedMonster, keyboard selected, or hovered (for visual styling - purple glow)
						var isThisCardSelected = (SelectedMonster?.Id == monster.Id || isKeyboardSelected || isThisCardHovered);
						// Should animate if: hovered, OR (selected AND no other card is hovered)
						var shouldAnimate = isThisCardHovered || (isThisCardSelected && !hoveredMonsterId.HasValue);
					}
					<MonsterCard Monster=@monster
								 IsSelected=@isThisCardSelected
								 ShouldAnimate=@shouldAnimate
								 IsMini=@true
								 ShowGenes=@isFusionMode
								 AnimateOnHover=@true
								 AnimationFrame=@SpriteAnimator.GlobalFrame
								 OverrideArtSpeciesId=@(_mybCardEditing ? _myBeastsTestSpeciesId : null)
								 ArtVersion=@_myBeastsArtVersion
								 ClickAction=@(() => {})
								 HoverAction=@(() => OnMouseHoverCard(monster.Id))
								 LeaveAction=@OnMouseLeaveCard />
					@* Favorite quick-toggle — one click from the rail, no
					   select-then-stage round trip. Same spot as the (hidden)
					   mini-fav star; suppressed in multi-select via SCSS. *@
					@if (!isMultiSelectMode)
					{
						<div class="card-fav-qt @(monster.IsFavorite ? "fav" : "")"
							 onclick=@(() => ToggleFavoriteFor(monster)) onclick:stopPropagation
							 onmouseover=@OnHoverBlip>
							<iconify icon="lucide:star" Size=@(14) Color="@(monster.IsFavorite ? "#ffce3a" : "rgba(244, 241, 234, 0.7)")" />
						</div>
					}
					@* Hover-preview ring — the cheap flat-panel recipe (absolute
					   bordered div, opacity swap on :hover). The SELECTED beast
					   gets the one waving imperative ring instead (root level). *@
					<div class="card-ring"></div>
				</div>
			}

			@if (currentFilter == "all")
			{
				var totalMonsters = GetMonsterCount();
				var emptySlots = GetEmptySlotCount(totalMonsters);
				@for (int i = 0; i < emptySlots; i++)
				{
					<div class="empty-slot mini" onmouseover=@OnMouseLeaveCard>
						<div class="empty-slot-border"></div>
					</div>
				}
			}

			@if (GetFilteredMonsters().Count == 0 && currentFilter != "all")
			{
				<div class="empty-roster">
					<div class="empty-icon">?</div>
					<div class="empty-text">@L("ui.roster.no_monsters")</div>
					<div class="empty-hint">@L("ui.roster.no_filter_match")</div>
				</div>
			}
			</div>
			@* Overlay scrollbar — read-only thumb driven per-tick from the
			   grid's ScrollOffset/ScrollSize (UpdateScrollbars). s&box's
			   scrollbar-color/-width don't parse (learnings 2026-04-15), so
			   this IS the scrollbar visual; pointer-events: none so wheel and
			   hover pass straight through to the grid. *@
			<div @ref="gridSbTrackRef" class="col-scrollbar">
				<div @ref="gridSbThumbRef" class="col-sb-thumb"></div>
			</div>
		</div>

		@* ────── STAGE + FACTS (shared ancestor = the ring's detail walk) ────── *@
		<div @ref="detailScrollRef" class="cs-inspect @(rosterRevealStage >= 1 ? "entered" : "")">
		@if (isFusionMode)
		{
			@{
				// Compatibility + preview computed once for the whole altar so the
				// slots, core, hero bar, gene grid and CTA all stay in sync.
				// `bothPicked` gates the preview-only sections.
				var bothPicked = Parent1 != null && Parent2 != null;
				BreedCompatibility fusionCompat = bothPicked ? GeneticsCalculator.CheckCompatibility(Parent1, Parent2) : null;
				BreedingPreview fusionPreview = (bothPicked && fusionCompat != null && fusionCompat.CanBreed)
					? GeneticsCalculator.PreviewOffspring(Parent1, Parent2, lockedGenes.Count > 0 ? lockedGenes : null)
					: null;
				int maxLocks = fusionPreview?.GeneLockSlots ?? (int)(TamerManager.Instance?.GetSkillBonus( SkillEffectType.GeneLock ) ?? 0);
				bool hasLockSkill = maxLocks > 0;
				int p1Total = Parent1?.Genetics?.TotalValue ?? 0;
				int p2Total = Parent2?.Genetics?.TotalValue ?? 0;
				int previewTotal = fusionPreview != null
					? fusionPreview.AvgHP + fusionPreview.AvgATK + fusionPreview.AvgDEF + fusionPreview.AvgSpA + fusionPreview.AvgSpD + fusionPreview.AvgSPD
					: 0;
				int fusionCost = bothPicked ? GeneticsCalculator.CalculateBreedingCost(Parent1, Parent2) : 0;
				bool canAffordFusion = TamerManager.Instance?.CurrentTamer?.Gold >= fusionCost;
				bool canFuse = bothPicked && fusionCompat != null && fusionCompat.CanBreed && canAffordFusion;
				// The altar core previews the offspring's species art (family
				// fusion keeps Parent1's line, so its icon is the honest preview).
				var altarSpecies = Parent1 != null ? MonsterManager.Instance?.GetSpecies(Parent1.SpeciesId) : null;
				var altarIcon = altarSpecies?.IconPath ?? "";
				var altarActive = bothPicked && fusionCompat?.CanBreed == true;
			}

			@* ══ THE ALTAR — parents flank the predicted offspring ══ *@
			<div class="cs-stage altar">
				<div class="altar-kicker">
					<iconify icon="lucide:combine" Size=@(16) Color="#f9a8d4" />
					<span class="altar-kicker-text">@(showResult && breedingResult != null ? "FUSION COMPLETE" : (altarActive ? L("ui.roster.both_consumed") : "Pick two beasts of the same species"))</span>
				</div>

				@if (showResult && breedingResult != null && !isFusionAnimating)
			{
				@* ══ INLINE FUSION REVEAL (2026-07-06) — the altar center IS
				   the reveal stage: offspring springs in where the ? sat,
				   name + quality stamp under it. rrev key remounts per
				   result so the entrance keyframes fire. P5: heavier
				   choreography than a switch — spring + stamp cascade. *@
				@{
					var _frSpecies = MonsterManager.Instance?.GetSpecies(breedingResult.SpeciesId);
					var _frQualityClass = breedingResult.Genetics?.QualityRating?.ToLower() ?? "average";
				}
				<div class="fr-stage rrev-@resultRevVersion">
					<img class="fr-sprite" src="@(_frSpecies?.IconPath ?? "")" />
					<div class="fr-name">@(string.IsNullOrEmpty(breedingResult.Nickname) ? _frSpecies?.Name : breedingResult.Nickname)</div>
					<div class="fr-quality @_frQualityClass"><span>@(breedingResult.Genetics?.QualityRating ?? "Average")</span></div>
				</div>
			}
			else
			{
			<div class="altar-row @(isFusionAnimating ? "consuming" : "")">
					@* Slot 1 — hover sound is routed through the inner MonsterCard's
					   HoverAction so the card's isInternallyHovered guard prevents
					   spam when the mouse moves between child elements. *@
					<div class="altar-slot @(Parent1 != null ? "filled" : "") @(selectedForSlot == 1 ? "selecting" : "")"
						 onclick=@(() => SetSelectingSlot(1))>
						<div class="fusion-slot-tag">B1</div>
						@if (Parent1 != null)
						{
							<div class="fusion-card-wrap">
								<MonsterCard Monster=@Parent1 IsMini=@true ShowGenes=@true AnimationFrame=@SpriteAnimator.GlobalFrame HoverAction=@(() => SoundManager.PlayHover()) />
								<button class="parent-remove-btn" onclick=@(() => ClearParent(1)) onclick:stopPropagation onmouseover=@OnHoverBlip>
									<iconify icon="lucide:x" Size=@(12) Color="white" />
								</button>
							</div>
							<div class="parent-extras">
								@if (Parent1.Genetics != null)
								{
									<div class="extra-chip nature">
										<iconify icon="lucide:leaf" Size=@(10) Color="#86efac" />
										<span>@Parent1.Genetics.Nature</span>
										<span class="chip-tooltip">@Parent1.Genetics.GetNatureDescription()</span>
									</div>
								}
								@if (Parent1.Traits != null)
								{
									@foreach (var trait in Parent1.Traits)
									{
										<div class="extra-chip trait">
											<iconify icon="@GetTraitIcon(trait)" Size=@(10) Color="#fbbf24" />
											<span>@GetTraitName(trait)</span>
											<span class="chip-tooltip">@GetTraitDescription(trait)</span>
										</div>
									}
								}
							</div>
						}
						else
						{
							<div class="altar-empty">
								<iconify icon="lucide:plus" Size=@(24) Color="rgba(255,255,255,0.4)" />
								<span>Pick a beast</span>
							</div>
						}
					</div>

					@* The core — chevrons converge on the predicted offspring. *@
					<div class="altar-core @(altarActive ? "active" : "")">
						<iconify class="altar-chev" icon="lucide:chevrons-right" Size=@(22) Color="@(altarActive ? "#fbbf24" : "rgba(255,255,255,0.25)")" />
						<div class="altar-result">
							@if (Parent1 != null)
							{
								<img class="altar-result-img" src="@altarIcon" />
							}
							else
							{
								<span class="altar-result-q">?</span>
							}
						</div>
						<iconify class="altar-chev" icon="lucide:chevrons-left" Size=@(22) Color="@(altarActive ? "#fbbf24" : "rgba(255,255,255,0.25)")" />
					</div>

					@* Slot 2 — same routing as Slot 1 *@
					<div class="altar-slot @(Parent2 != null ? "filled" : "") @(selectedForSlot == 2 ? "selecting" : "")"
						 onclick=@(() => SetSelectingSlot(2))>
						<div class="fusion-slot-tag">B2</div>
						@if (Parent2 != null)
						{
							<div class="fusion-card-wrap">
								<MonsterCard Monster=@Parent2 IsMini=@true ShowGenes=@true AnimationFrame=@SpriteAnimator.GlobalFrame HoverAction=@(() => SoundManager.PlayHover()) />
								<button class="parent-remove-btn" onclick=@(() => ClearParent(2)) onclick:stopPropagation onmouseover=@OnHoverBlip>
									<iconify icon="lucide:x" Size=@(12) Color="white" />
								</button>
							</div>
							<div class="parent-extras">
								@if (Parent2.Genetics != null)
								{
									<div class="extra-chip nature">
										<iconify icon="lucide:leaf" Size=@(10) Color="#86efac" />
										<span>@Parent2.Genetics.Nature</span>
										<span class="chip-tooltip">@Parent2.Genetics.GetNatureDescription()</span>
									</div>
								}
								@if (Parent2.Traits != null)
								{
									@foreach (var trait in Parent2.Traits)
									{
										<div class="extra-chip trait">
											<iconify icon="@GetTraitIcon(trait)" Size=@(10) Color="#fbbf24" />
											<span>@GetTraitName(trait)</span>
											<span class="chip-tooltip">@GetTraitDescription(trait)</span>
										</div>
									}
								}
							</div>
						}
						else
						{
							<div class="altar-empty">
								<iconify icon="lucide:plus" Size=@(24) Color="rgba(255,255,255,0.4)" />
								<span>Pick a beast</span>
							</div>
						}
					</div>
				</div>

				@if (fusionPreview != null)
				{
					<div class="altar-chances">
						<div class="header-chance twin">
							<iconify icon="lucide:users" Size=@(11) Color="#fbbf24" />
							<span class="hc-label">Twin</span>
							<span class="hc-value">@((fusionPreview.TwinChance * 100).ToString("F0"))%</span>
						</div>
						<div class="header-chance mutation">
							<iconify icon="lucide:sparkles" Size=@(11) Color="#f9a8d4" />
							<span class="hc-label">Mut</span>
							<span class="hc-value">@((fusionPreview.MutationChance * 100).ToString("F0"))%</span>
						</div>
						@if (fusionPreview.NatureInheritChance > 0)
						{
							<div class="header-chance nature">
								<iconify icon="lucide:leaf" Size=@(11) Color="#86efac" />
								<span class="hc-label">Nat</span>
								<span class="hc-value">@((fusionPreview.NatureInheritChance * 100).ToString("F0"))%</span>
							</div>
						}
					</div>

					@{
						// Hero verdict badge — quick read of "is this fusion worth it?"
						// Compares predicted total against the BETTER parent total.
						var heroBetter = Math.Max(p1Total, p2Total);
						var heroVerdict = previewTotal > heroBetter ? "improved"
							: previewTotal == heroBetter ? "stable"
							: "downgrade";
						var heroVerdictIcon = previewTotal > heroBetter ? "lucide:trending-up"
							: previewTotal == heroBetter ? "lucide:equal"
							: "lucide:trending-down";
						var heroVerdictLabel = previewTotal > heroBetter ? "GAIN"
							: previewTotal == heroBetter ? "EVEN"
							: "RISK";
						var heroVerdictColor = previewTotal > heroBetter ? "#4ade80"
							: previewTotal == heroBetter ? "#9ca3af"
							: "#fbbf24";

						// Family fusion detection — true when both parents share the
						// same evolution line (compared via base form).
						var p1BaseId = MonsterManager.Instance?.GetSpecies(Parent1.SpeciesId);
						var p2BaseId = MonsterManager.Instance?.GetSpecies(Parent2.SpeciesId);
						var isFamilyFusion = p1BaseId != null && p2BaseId != null && p1BaseId.Id == p2BaseId.Id;
					}
					<div class="fusion-hero @(fusionPreview.PredictedQuality.ToLower())">
						<div class="hero-row">
							<iconify icon="lucide:sparkles" Size=@(14) Color="#f9a8d4" />
							<div class="hero-name">@GetSpeciesNameFor(Parent1)</div>
							<div class="hero-family-tag @(isFamilyFusion ? "family" : "cross")">
								<iconify icon="@(isFamilyFusion ? "lucide:dna" : "lucide:shuffle")" Size=@(10) Color="@(isFamilyFusion ? "#f9a8d4" : "#fbbf24")" />
								<span>@(isFamilyFusion ? "FAMILY" : "CROSS")</span>
							</div>
							<div class="hero-spacer"></div>
							<div class="hero-verdict @heroVerdict">
								<iconify icon="@heroVerdictIcon" Size=@(12) Color="@heroVerdictColor" />
								<span>@heroVerdictLabel</span>
							</div>
							<div class="hero-stat-line">
								<span class="hero-stat-value">~@previewTotal</span>
								<span class="hero-stat-max">/180</span>
							</div>
							<div class="hero-quality-badge @(fusionPreview.PredictedQuality.ToLower())">
								@fusionPreview.PredictedQuality
							</div>
						</div>
						<div class="hero-gene-bar-bg">
							<div class="hero-gene-bar-fill @(fusionPreview.PredictedQuality.ToLower())" style="width: @((previewTotal / 180f * 100f).ToString("F0"))%"></div>
							<div class="hero-gene-tick" style="left: 40%"></div>
							<div class="hero-gene-tick" style="left: 60%"></div>
							<div class="hero-gene-tick" style="left: 75%"></div>
							<div class="hero-gene-tick" style="left: 90%"></div>
						</div>
					</div>
				}

				@if (bothPicked && fusionCompat?.CanBreed == false)
				{
					<div class="fusion-warning">
						<iconify icon="lucide:triangle-alert" Size=@(20) Color="#ef4444" />
						<span class="warning-text">@fusionCompat.Reason</span>
					</div>
				}

				@* Sticky FUSE CTA — two-stage in-button confirm (pendingFusionConfirm). *@
				@if (bothPicked && fusionCompat?.CanBreed == true)
				{
					<div class="fusion-cta-bar">
						<div class="cta-cost @(canAffordFusion ? "" : "insufficient")">
							<img class="cta-cost-icon" src="ui/icons/currency/money.svg" />
							<span class="cta-cost-value">@fusionCost</span>
						</div>
						<button class="cta-fuse-btn @(canFuse ? "" : "disabled") @(pendingFusionConfirm ? "confirming" : "")"
								onclick=@OnBreedClicked
								onmouseover=@OnHoverBlip>
							<iconify icon="@(pendingFusionConfirm ? "lucide:check" : "lucide:combine")" Size=@(18) Color="@(canFuse ? "#3a0a22" : "#ffffff")" />
							<span class="cta-fuse-label">@(pendingFusionConfirm ? "CONFIRM" : L("ui.roster.fuse_btn"))</span>
							@* Q/R swap 2026-07-06: R = breed confirm, capped on the CTA. *@
							<span class="kb-key cta-fuse-key">R</span>
						</button>
					</div>
				}

			}

				@* Fuse animation — re-homed from the retired overlay: plays OVER
				   the altar (absolute, centered, pointer-inert) while the
				   parents drain out of their slots (.consuming). *@
				@if (isFusionAnimating)
				{
					@* ══ THE RITUAL (2026-07-06 rebuild — two beasts die for
					   this): essence orbs in the PARENTS' element colors slam
					   to the center; a rising two-tone helix twines up; pink
					   shockwaves + a white-hot flash on the merge; the
					   offspring FORMS as a dark silhouette in a glow, holds a
					   beat, then the real reveal springs in (.fr-stage).
					   Phases (spiral → flash → forming) gate the pieces via
					   ancestor-scoped animation rules; sounds ride
					   RunFusionAnimation's beats. *@
					@{
						var _fx1 = GetElementHexFor(lastFusionParent1);
						var _fx2 = GetElementHexFor(lastFusionParent2);
						var _fxSpecies = MonsterManager.Instance?.GetSpecies(breedingResult?.SpeciesId);
					}
					<div class="fr-anim-box">
						<div class="fusion-animation-container @fusionPhase">
							<div class="fx-orb a" style="background-image: radial-gradient(@JmRgba(_fx1, 0.9f) 0%, @JmRgba(_fx1, 0.25f) 45%, rgba(0, 0, 0, 0) 70%);"></div>
							<div class="fx-orb b" style="background-image: radial-gradient(@JmRgba(_fx2, 0.9f) 0%, @JmRgba(_fx2, 0.25f) 45%, rgba(0, 0, 0, 0) 70%);"></div>
							<div class="fx-helix">
								@for (int i = 0; i < 12; i++)
								{
									<div class="fx-dot d@(i)" style="background-color: @(i % 2 == 0 ? _fx1 : _fx2);"></div>
								}
							</div>
							<div class="fx-ring r1"></div>
							<div class="fx-ring r2"></div>
							<div class="fx-flash"></div>
							<div class="fx-glow"></div>
							<img class="fx-silhouette" src="@(_fxSpecies?.IconPath ?? "")" />
						</div>
					</div>
				}

				@* Contextual key legend — fusion context				@* Contextual key legend — fusion context (2026-07-06); always
				   visible (user call); content swaps in the result state. *@
					<div class="kb-legend">
						@if (showResult && breedingResult != null)
						{
							<span class="kb-key">A/D</span><span class="kbl-label">Choose</span>
							<span class="kb-key">Space</span><span class="kbl-label">Select</span>
							<span class="kb-key">Q</span><span class="kbl-label">Fuse Again</span>
						}
						else
						{
							<span class="kb-key">E</span><span class="kbl-label">Slot</span>
							<span class="kb-key">R</span><span class="kbl-label">Fuse</span>
							<span class="kb-key">Q</span><span class="kbl-label">Exit</span>
						}
					</div>
			</div>

			@* ══ FACTS (fusion) — the gene ledger ══ *@
			<div class="cs-facts">
				@* Slim container-tone cap — leak cover for the rotated
				   corner-cut squares (transforms escape the scroll clip);
				   container-toned, it reads as the panel's own top padding. *@
				<div class="facts-roof"></div>
				@* 13c — FUSE header band: pink kicker, two orbs orbiting
				   (about to become one). Ambient first in DOM, content above;
				   back card exits fusion (Q — the universal back key since
				   the 2026-07-06 Q/R swap; R = breed confirm on the CTA).
				   Non-scrolling sibling — the rotating orbit never nears a
				   scroll edge. *@
				<div class="fsub-head fusion">
					<div class="fsub-orbit-glow"></div>
					<div class="fsub-orbit">
						<div class="fsub-orbit-ring"></div>
						<div class="fsub-orbit-dot a"></div>
						<div class="fsub-orbit-dot b"></div>
					</div>
					<div class="picker-back" onclick=@ToggleFusionMode onmouseover=@OnHoverBlip>
						<iconify icon="lucide:arrow-left" Size=@(16) Color="#A79DBE" />
						@* Q/R swap 2026-07-06: Q = back everywhere (was R). *@
						<span class="kb-key">Q</span>
					</div>
					<div class="fsub-id">
						<span class="fsub-kicker">FUSE</span>
						<span class="fsub-name">@(Parent1 != null ? (string.IsNullOrEmpty(Parent1.Nickname) ? GetSpeciesNameFor(Parent1) : Parent1.Nickname) : "GENE FORGE")</span>
					</div>
					<div class="fsub-spacer"></div>
					<div class="fd-head-badge dim"><span>@GetFusionHeaderStatus()</span></div>
					<div class="fd-cut"></div>
				</div>
				<div class="facts-scroll">
					@if (showResult && breedingResult != null && !isFusionAnimating)
					{
						@* ══ INLINE RESULT LEDGER (2026-07-06) — the gene table
						   vs BOTH parents cascades in (nth ladder, opacity-only
						   in the scroll), then quality/nature settle, then the
						   CTAs. One-cursor: the CTA pair is kb+hover driven via
						   fusionResultCursor. *@
						@{
							var _rq = breedingResult.Genetics?.QualityRating ?? "Average";
							var _rTot = GetResultTotalGenes();
							var _rDelta = _rTot - lastFusionExpectedTotal;
							var _rvx = _rDelta >= 3 ? "lucky" : _rDelta <= -3 ? "harsh" : "ontarget";
							var _rvxLabel = _rDelta >= 3 ? "LUCKY" : _rDelta <= -3 ? "HARSH" : "ON TARGET";
							var _natSrc = GetNatureSource();
							var _natLabel = _natSrc == "both" ? "inherited" : _natSrc == "b1" ? $"from {lastFusionParent1?.Nickname ?? "B1"}" : _natSrc == "b2" ? $"from {lastFusionParent2?.Nickname ?? "B2"}" : "random";
						}
						<div class="fr-zone fd-zone rrev-@resultRevVersion">
							<div class="fd-head">
								<div class="fd-head-chip"><span>FUSION RESULT</span></div>
								<div class="fd-head-line"></div>
								<div class="fd-head-badge dim"><span>@_rq.ToUpper()</span></div>
							</div>
							<div class="fr-card">
								<div class="fd-cut"></div>
								@if (lastFusionExpectedTotal > 0)
								{
									<div class="fr-rvx">
										<span class="fr-rvx-total">@_rTot</span>
										<span class="fr-rvx-max">/180</span>
										<span class="fr-rvx-expected">~@lastFusionExpectedTotal expected</span>
										<div class="fr-rvx-verdict @_rvx"><span>@(_rDelta > 0 ? "+" : "")@_rDelta @_rvxLabel</span></div>
									</div>
								}
								<div class="fr-ghead">
									<span class="fr-g-label"></span>
									<span class="fr-g-col">@(lastFusionParent1?.Nickname ?? "B1")</span>
									<span class="fr-g-col">@(lastFusionParent2?.Nickname ?? "B2")</span>
									<span class="fr-g-col result">RESULT</span>
								</div>
								@{
									var _frRows = new (string label, string cls, int p1, int p2, int res)[]
									{
										("HP",  "hp",      lastFusionParent1?.Genetics?.HPGene ?? 0,  lastFusionParent2?.Genetics?.HPGene ?? 0,  breedingResult.Genetics?.HPGene ?? 0),
										("ATK", "atk",     lastFusionParent1?.Genetics?.ATKGene ?? 0, lastFusionParent2?.Genetics?.ATKGene ?? 0, breedingResult.Genetics?.ATKGene ?? 0),
										("DEF", "def",     lastFusionParent1?.Genetics?.DEFGene ?? 0, lastFusionParent2?.Genetics?.DEFGene ?? 0, breedingResult.Genetics?.DEFGene ?? 0),
										("SpA", "spa",     lastFusionParent1?.Genetics?.SpAGene ?? 0, lastFusionParent2?.Genetics?.SpAGene ?? 0, breedingResult.Genetics?.SpAGene ?? 0),
										("SpD", "spd-def", lastFusionParent1?.Genetics?.SpDGene ?? 0, lastFusionParent2?.Genetics?.SpDGene ?? 0, breedingResult.Genetics?.SpDGene ?? 0),
										("SPD", "spd",     lastFusionParent1?.Genetics?.SPDGene ?? 0, lastFusionParent2?.Genetics?.SPDGene ?? 0, breedingResult.Genetics?.SPDGene ?? 0),
									};
								}
								@foreach (var g in _frRows)
								{
									var _avg = (g.p1 + g.p2) / 2f;
									var _verdict = g.res > _avg + 0.5f ? "up" : (g.res < _avg - 0.5f ? "down" : "even");
									<div class="fr-gene">
										<span class="fr-g-label @g.cls">@g.label</span>
										<span class="fr-g-col">@g.p1</span>
										<span class="fr-g-col">@g.p2</span>
										<span class="fr-g-col result @_verdict">@g.res</span>
									</div>
								}
								<div class="fr-nature">
									<iconify icon="lucide:leaf" Size=@(13) Color="#86efac" />
									<span class="fr-nature-name">@(breedingResult.Genetics?.Nature.ToString() ?? "")</span>
									<span class="fr-nature-src">@_natLabel</span>
								</div>
							</div>
							@if (breedingResult.Traits != null && breedingResult.Traits.Count > 0)
							{
								<div class="fr-traits">
									@foreach (var trait in breedingResult.Traits)
									{
										<div class="fr-trait"><iconify icon="@GetTraitIcon(trait)" Size=@(11) Color="#f9a8d4" /><span>@GetTraitName(trait)</span></div>
									}
								</div>
							}
							<div class="fr-cta-row">
								<button class="fr-btn view @(fusionResultCursor == 0 ? "kb-focused" : "")" onclick=@OnViewFusedBeast onmouseover=@(() => OnResultBtnHover(0))>
									<span>VIEW BEAST</span>
								</button>
								<button class="fr-btn again @(fusionResultCursor == 1 ? "kb-focused" : "")" onclick=@FuseAgain onmouseover=@(() => OnResultBtnHover(1))>
									<iconify icon="lucide:combine" Size=@(15) Color="#ffffff" />
									<span>FUSE AGAIN</span>
								</button>
							</div>
						</div>
					}
					else
					{
					@* 1B section: GENE LEDGER header (violet chip + hairline)
					   with the corner-cut card below, all inside a scroll-
					   direct padded section (collapse-safe shape). *@
					<div class="genes-zone fd-zone">
					<div class="fd-head">
						<div class="fd-head-chip"><span>GENE LEDGER</span></div>
						<div class="fd-head-line"></div>
					</div>
					@if (fusionPreview != null)
					{
						<div class="fusion-genes-card">
							<div class="fd-cut"></div>
							<div class="genes-card-header">
								<div class="genes-card-title">
									<iconify icon="lucide:dna" Size=@(14) Color="#f9a8d4" />
									<span>GENETICS</span>
								</div>
								@if (hasLockSkill)
								{
									<div class="genes-lock-counter">
										<iconify icon="lucide:lock" Size=@(11) Color="#fbbf24" />
										<span class="lock-current">@lockedGenes.Count</span>
										<span class="lock-max">/@maxLocks</span>
									</div>
								}
							</div>

							<div class="gene-row gene-col-headers">
								<div class="gene-row-label"></div>
								<div class="gene-cell col-head">Beast 1</div>
								<div class="gene-cell col-head">Beast 2</div>
								<div class="gene-arrow"></div>
								<div class="gene-cell col-head predicted">Result</div>
								<div class="gene-lock-toggle empty"></div>
							</div>

							@{
								// Inline helper data so each row uses the same compact layout.
								var geneRows = new (string key, string label, int p1, int p2, int avg)[]
								{
									("HP",  "HP",  Parent1.Genetics.HPGene,  Parent2.Genetics.HPGene,  fusionPreview.AvgHP),
									("ATK", "ATK", Parent1.Genetics.ATKGene, Parent2.Genetics.ATKGene, fusionPreview.AvgATK),
									("DEF", "DEF", Parent1.Genetics.DEFGene, Parent2.Genetics.DEFGene, fusionPreview.AvgDEF),
									("SpA", "SpA", Parent1.Genetics.SpAGene, Parent2.Genetics.SpAGene, fusionPreview.AvgSpA),
									("SpD", "SpD", Parent1.Genetics.SpDGene, Parent2.Genetics.SpDGene, fusionPreview.AvgSpD),
									("SPD", "SPD", Parent1.Genetics.SPDGene, Parent2.Genetics.SPDGene, fusionPreview.AvgSPD),
								};
							}

							@foreach (var row in geneRows)
							{
								var key = row.key;
								var locked = lockedGenes.Contains(key);
								var canLockMore = hasLockSkill && (locked || lockedGenes.Count < maxLocks);
								var p1Best = row.p1 >= row.p2;
								var p2Best = row.p2 >= row.p1;
								var betterParent = Math.Max(row.p1, row.p2);
								var verdict = row.avg > betterParent ? "improved"
									: row.avg == betterParent ? "stable"
									: "downgrade";
								<div class="gene-row @(locked ? "locked" : "")">
									<div class="gene-row-label gene-@key.ToLower()">@row.label</div>
									<div class="gene-cell @(p1Best ? "best" : "")">@row.p1</div>
									<div class="gene-cell @(p2Best ? "best" : "")">@row.p2</div>
									<div class="gene-arrow"><iconify icon="lucide:arrow-right" Size=@(12) Color="rgba(255,255,255,0.4)" /></div>
									<div class="gene-cell predicted @verdict">@row.avg</div>
									<div class="gene-lock-toggle @(locked ? "active" : "") @(!canLockMore && !locked ? "disabled" : "") @(!hasLockSkill ? "no-skill" : "")"
										 onclick=@(() => ToggleGeneLock(key))
										 onmouseover=@OnHoverBlip>
										<iconify icon="@(locked ? "lucide:lock" : "lucide:lock-open")" Size=@(12) Color="@(locked ? "#fbbf24" : "rgba(255,255,255,0.4)")" />
									</div>
								</div>
							}

							@{
								// Total row verdict — same logic as per-row but on the sum,
								// plus a TYPICAL spread (~80% of outcomes; expected ± 6).
								var betterParentTotal = Math.Max(p1Total, p2Total);
								var totalVerdict = previewTotal > betterParentTotal ? "improved"
									: previewTotal == betterParentTotal ? "stable"
									: "downgrade";
								var typicalSpread = 6;
								var minTotal = Math.Max(0, previewTotal - typicalSpread);
								var maxTotal = Math.Min(180, previewTotal + typicalSpread);
							}
							<div class="gene-row totals-row">
								<div class="gene-row-label">TOTAL</div>
								<div class="gene-cell @(p1Total >= p2Total ? "best" : "")">@p1Total</div>
								<div class="gene-cell @(p2Total >= p1Total ? "best" : "")">@p2Total</div>
								<div class="gene-arrow"><iconify icon="lucide:arrow-right" Size=@(12) Color="rgba(255,255,255,0.4)" /></div>
								<div class="gene-cell predicted @totalVerdict">~@previewTotal</div>
								<div class="gene-lock-toggle empty"></div>
							</div>
							<div class="gene-range-row">
								<span class="gene-range-label">Range</span>
								<span class="gene-range-value">@minTotal to @maxTotal</span>
							</div>
						</div>
					}
					else
					{
						<div class="fusion-empty">
							<div class="fd-cut"></div>
							<div class="fusion-empty-icon">
								<iconify icon="lucide:flame" Size=@(48) Color="rgba(249, 168, 212, 0.4)" />
							</div>
							<div class="fusion-empty-title">Forge a New Lineage</div>
							<div class="fusion-empty-text">
								Choose two beasts of the same species. Their genes combine into a single offspring — both parents are consumed.
							</div>
							@if (Parent1 != null && Parent2 == null)
							{
								<div class="fusion-empty-hint">
									<iconify icon="lucide:arrow-left" Size=@(14) Color="#f9a8d4" />
									<span>Pick a second @GetSpeciesNameFor(Parent1)</span>
								</div>
							}
						</div>
					}
					</div>
				}
				</div>
				@* Slim container-tone foot cap — bottom leak cover. *@
				<div class="facts-foot"></div>
				<div @ref="factsSbTrackRef" class="col-scrollbar">
					<div @ref="factsSbThumbRef" class="col-sb-thumb"></div>
				</div>
			</div>
		}
		else if (SelectedMonster != null)
		{
			@* ══ THE STAGE — the selected beast at 2.5x ══ *@
			<div class="cs-stage">
				@* Zone hint strip — DEMOTED at rest (user 2026-07-05: clicking
				   already inspects, don't advertise a TAB affordance). Resting
				   state leads with the natural action, keycap hidden via SCSS;
				   Tab keeps working silently. The Q cap only surfaces once the
				   keyboard actually holds the stage. Both spans stay mounted
				   (value-swap, never child-swap — ghost-child law). *@
				@* 2026-07-06 input model: in kbd-mode the resting hint becomes
				   `Space · Inspect` (the cap un-hides via .kbd-mode css);
				   mouse mode keeps the quiet "Click a beast to inspect".
				   Value-swaps only — both spans always mounted. *@
				<div class="stage-zone-hint @(kbFocusZone == "detail" ? "kb-live" : "demoted")">
					<span class="kb-key">@(kbFocusZone == "detail" ? "Q" : "Space")</span>
					<span class="szh-label">@(kbFocusZone == "detail" ? "Back to collection" : "Inspect")</span>
				</div>

				<div class="portrait-wrapper">
					@{
						// The stage shows the WHOLE sprite contain-fit (user call
						// 2026-07-03) — the old per-species DetailIcon crop transforms
						// are RETIRED here; there is no framing left to tune. The art
						// editor's DETAIL mode still previews a test species' icon.
						var _diEditing = ShowMyBeastsArtEditor && _myBeastsEditMode == "detail" && SelectedMonster != null;
						var _diArtId = ( _diEditing && !string.IsNullOrEmpty( _myBeastsTestSpeciesId ) )
							? _myBeastsTestSpeciesId
							: SelectedMonster?.SpeciesId;
						var _diSp = !string.IsNullOrEmpty( _diArtId ) ? MonsterManager.Instance?.GetSpecies( _diArtId ) : null;
						var _diIconPath = ( _diEditing && !string.IsNullOrEmpty( _myBeastsTestSpeciesId ) && _diSp != null )
							? ( _diSp.AnimationFrames != null && _diSp.AnimationFrames.Count > 0 ? _diSp.AnimationFrames[0] : _diSp.IconPath )
							: GetSelectedIconPath();
					}
					@* Showcase layer (turn 5A/6A, 2026-07-05): the ELEMENT DAIS —
					   the beast STANDS on an elliptical stage tinted by its
					   primary element; paints BENEATH the sprite (earlier
					   sibling wins the flat z-order). Replaces the violet
					   .stage-halo spotlight. BAKED PNG per element (platter
					   wash + rim + inner ring in one 600×148 asset at 2x) —
					   CSS could not draw it: border-radius:50% pills instead
					   of ellipsing and the percent-stop radial painted
					   near-solid (live-verified). Swapped per element via src
					   (value-swap; GetSelectedElementClass = the filename key). *@
					@* Reactivity pass: the srev key remounts the dais per beast
				   switch (breathe restarts at its peak — small free pop), and
				   the FLARE overlay — the same PNG stacked once more — plays a
				   one-shot bright fade-out on each remount: the stage light
				   flares as the new beast lands. fill both parks it invisible
				   after 0.55s (opacity-hold is harmless). *@
				<img class="stage-dais srev-@stageRevVersion" src="ui/dais/dais-@(GetSelectedElementClass()).png" />
				<img class="stage-dais-flare srev-@stageRevVersion" src="ui/dais/dais-@(GetSelectedElementClass()).png" />
					@* pop-@N render key: a beast switch remounts the container so
					   the stagePop entrance keyframe replays (select-pulse
					   precedent — class-string change forces a fresh mount).
					   Evolution keeps the same Monster.Id so the key holds
					   still through the whole evolve sequence. *@
					<div class="portrait-container pop-@stageRevVersion @GetSelectedRarityClass() @GetEvolutionClass() @(_diEditing ? "myb-art-edit" : "")"
						 onmousedown=@(() => { if (_diEditing) StartMyBeastsArtDrag(_diArtId); })
						 onmouseover=@(() => { if (_diEditing) OnMyBeastsArtHover(_diArtId); })
						 onmouseout=@(() => { if (_diEditing) OnMyBeastsArtLeave(_diArtId); })>
						<div class="evolution-glow"></div>
						<div class="evolution-particles">
							<div class="particle p1"></div>
							<div class="particle p2"></div>
							<div class="particle p3"></div>
							<div class="particle p4"></div>
							<div class="particle p5"></div>
							<div class="particle p6"></div>
							<div class="particle p7"></div>
							<div class="particle p8"></div>
						</div>
						<div class="monster-portrait @(evolutionPhase == "transform" || evolutionPhase == "burst" ? "hidden" : "")" style="background-image: url(@_diIconPath);"></div>
						@if (!string.IsNullOrEmpty(evolvedIconPath) && (evolutionPhase == "transform" || evolutionPhase == "burst"))
						{
							<div class="monster-portrait evolved-portrait" style="background-image: url(@evolvedIconPath);"></div>
						}
					</div>
				</div>

				@* Nameplate block — identity under the beast. The species
				   kicker wears the RARITY color (the disc that carried it
				   was cut). *@
				<div class="stage-plate">
					@* Reactivity pass: name + badge row RE-STAMP per beast switch
					   (srev remount). The XP bar + nickname row stay UN-keyed —
					   the XP fill must TWEEN on switch (selective-keying law) and
					   the nickname row hosts interactive controls. *@
					<div class="species-name srev-@stageRevVersion @GetSelectedRarityClass()">@GetSelectedSpeciesName()</div>
					<div class="nickname-row">
						@if (isEditingNickname)
						{
							<div class="nickname-input-wrapper">
								<TextEntry class="nickname-input" @ref="nicknameInput" Text="@editingNickname" />
							</div>
							<div class="nickname-btn save" onclick=@SaveNickname>✓</div>
							<div class="nickname-btn cancel" onclick=@CancelNicknameEdit>✕</div>
						}
						else
						{
							<div class="nickname">@SelectedMonster.Nickname</div>
							<div class="nickname-btn edit @(IsDetailControlFocused("nick") ? "kb-focused" : "")" onclick=@StartNicknameEdit onmouseover=@(() => OnDetailControlHover("nick"))>✎</div>
							<div class="stage-fav @(SelectedMonster.IsFavorite ? "active" : "") @(IsDetailControlFocused("diamond-fav") ? "kb-focused" : "")"
								 onclick=@ToggleFavorite onmouseover=@(() => OnDetailControlHover("diamond-fav"))>
								<iconify icon="lucide:star" Size=@(16) Color="@(SelectedMonster.IsFavorite ? "#ffce3a" : "rgba(244, 241, 234, 0.7)")" />
							</div>
						}
					</div>
					@if (isEditingNickname)
					{
						@* Hotkey caps for the nickname edit — Q = cancel, Enter =
						   confirm. Clickable too, for mouse parity with ✓/✕. *@
						<div class="nickname-keys-row">
							<div class="nickname-key-hint cancel" onclick=@CancelNicknameEdit onmouseover=@OnHoverBlip>
								<span class="kb-key">Q</span>
								<span class="nickname-key-label">Cancel</span>
							</div>
							<div class="nickname-key-hint confirm" onclick=@SaveNickname onmouseover=@OnHoverBlip>
								<span class="kb-key">Enter</span>
								<span class="nickname-key-label">Confirm</span>
							</div>
						</div>
					}
					<div class="level-power-row srev-@stageRevVersion">
						<div class="level-badge">LV @SelectedMonster.Level</div>
						<div class="power-badge">
							<span class="power-label">PWR</span>
							<span class="power-value">@(((int)displayedPwr).ToString("N0"))</span>
						</div>
						<div class="stage-elements">
							<div class="element-tag @GetSelectedElementClass()">
								<img class="element-tag-icon" src="ui/icons/elements/element_white/@(GetSelectedElementClass()).svg" />
								<span class="element-tag-text">@GetSelectedElementName()</span>
							</div>
							@if (HasSelectedSecondaryElement())
							{
								<div class="element-tag secondary @GetSelectedSecondaryElementClass()">
									<img class="element-tag-icon" src="ui/icons/elements/element_white/@(GetSelectedSecondaryElementClass()).svg" />
									<span class="element-tag-text">@GetSelectedSecondaryElementName()</span>
								</div>
							}
						</div>
					</div>
					<div class="portrait-xp-bar @(SelectedMonster.Level >= Monster.MaxLevel ? "maxed" : "")">
						<div class="xp-fill" style="width: @(SelectedMonster.Level >= Monster.MaxLevel ? 100 : GetSelectedXPPercent())%"></div>
						<span class="xp-readout">@GetXpReadout()</span>
					</div>
				</div>

				@* ACTIONS — evolve hero slab + the ITEM/FUSE/RELEASE tier row. *@
				<div class="actions-section">
					<div class="section-title">ACTIONS</div>
					<div class="detail-actions-v2">
					@if (CanSelectedMonsterEvolve())
					{
						<button class="action-v2 evolve @(IsDetailControlFocused("evolve") ? "kb-focused" : "")" onclick=@OnEvolveClicked onmouseover=@(() => OnDetailControlHover("evolve"))>
							<div class="action-v2-diamond evolve-diamond">
								<iconify icon="lucide:sparkles" Size=@(20) Color="white" />
							</div>
							<span class="action-v2-text">@L("ui.roster.evolve_to") @GetSelectedMonsterEvolutionName()</span>
						</button>
					}
					<div class="action-v2-row">
						<button class="action-v2 item @(HasSelectedHeldItem() ? "has-item" : "no-item") @(IsDetailControlFocused("item") ? "kb-focused" : "")" onclick=@OpenItemPicker onmouseover=@(() => OnDetailControlHover("item"))>
							@* Ghost-child safety: always mount both icon slots, toggle
							   visibility via has-item/no-item class on the button.
							   Mirrors shop GetBuyButtonContent. *@
							<div class="action-v2-diamond item-diamond">
								<img class="action-v2-item-img" src="@GetSelectedHeldItemIconPath()" onerror="this.style.display='none'" />
								<iconify class="action-v2-item-fallback" icon="lucide:shield" Size=@(20) Color="white" />
							</div>
							<span class="action-v2-text">@(HasSelectedHeldItem() ? GetSelectedHeldItemName() : L("ui.roster.item"))</span>
						</button>
						<button class="action-v2 fuse @(IsDetailControlFocused("fuse") ? "kb-focused" : "")" onclick=@OnBreedFromDetail onmouseover=@(() => OnDetailControlHover("fuse"))>
							<div class="action-v2-diamond fuse-diamond">
								<iconify icon="lucide:combine" Size=@(20) Color="white" />
							</div>
							<span class="action-v2-text">@L("ui.roster.fuse")</span>
						</button>
						<button class="action-v2 release @(CanReleaseMonster() ? "" : "disabled") @(IsDetailControlFocused("release") ? "kb-focused" : "")" onclick=@OnReleaseClicked onmouseover=@(() => OnDetailControlHover("release"))>
							<div class="action-v2-diamond release-diamond">
								<iconify icon="lucide:arrow-up-right" Size=@(20) Color="white" />
							</div>
							<span class="action-v2-text">@(CanReleaseMonster() ? L("ui.roster.release") : L("ui.roster.last"))</span>
						</button>
					</div>
					</div>
				</div>

				@* Multi-release confirm bar — docks under the stage actions. *@
				@if (isMultiSelectMode)
				{
					<div class="ms-dockbar @(selectedForRelease.Count > 0 ? "armed" : "")">
						<div class="ms-dock-info">
							<iconify icon="lucide:trash-2" Size=@(15) Color="@(selectedForRelease.Count > 0 ? "#f87171" : "rgba(244, 241, 234, 0.5)")" />
							<span class="ms-dock-count">@selectedForRelease.Count marked</span>
						</div>
						<button class="ms-dock-btn cancel" onclick=@ToggleMultiSelectMode onmouseover=@OnHoverBlip>
							<span>@L("ui.roster.cancel")</span>
						</button>
						@if (selectedForRelease.Count > 0)
						{
							<button class="ms-dock-btn release" onclick=@OnReleaseSelectedClicked onmouseover=@OnHoverBlip>
								<span>@string.Format(L("ui.roster.release_count"), selectedForRelease.Count)</span>
							</button>
						}
					</div>
				}

				@* Contextual key legend (2026-07-06 input model) — one strip at
				   the stage's foot, ALWAYS visible (user: "always have the
				   keyboard controls up even when using a mouse"), content per
				   zone. Native .kb-key caps, never resized. *@
					<div class="kb-legend">
						@if (kbFocusZone == "detail")
						{
							<span class="kb-key">Space</span><span class="kbl-label">Select</span>
							<span class="kb-key">Q</span><span class="kbl-label">Collection</span>
						}
						else
						{
							<span class="kb-key">W/S/A/D</span><span class="kbl-label">Browse</span>
							<span class="kb-key">Space</span><span class="kbl-label">Inspect</span>
							<span class="kb-key">E</span><span class="kbl-label">Fuse</span>
						}
					</div>
			</div>

			@* ══ FACTS — the scrolling dossier. OPTION 1B "SIGNATURE EDGE"
			   (2026-07-05, user-approved mock: Downloads/Detail Sidebar
			   .dc.html #1b): ONE quiet container — transparent sections
			   separated by 34px gaps, each led by a violet skewX(-12°)
			   header chip + hairline; cards (tiles, move slabs, buttons)
			   are #1A1428 with a 1px #2A2340 border and the signature
			   TOP-RIGHT CORNER CUT (a container-tone rotate(45°) square —
			   s&box has no clip-path). Icon tiles/badges/gauges are skewX
			   parallelograms on LEAF children only (ring-host roots stay
			   untransformed). Full spec + width math: .razor.scss
			   "SIGNATURE EDGE" banner. *@
			<div class="cs-facts">
				<div class="facts-roof"></div>
				@* ══ 13-SERIES SUB-VIEW HEADER BAND (2026-07-05, turns 13a/13b)
				   — a NON-SCROLLING band between the roof cap and the scroll
				   (its ambient keyframe dots can then never straddle a scroll
				   edge — animated/transformed content escapes scroll clips).
				   Ambient dots come FIRST in DOM (nth-child geometry in scss;
				   content paints above by flat z-order): journal = twinkling
				   starlight, pickers = motes rising. Back card = the shared
				   .picker-back (Q). The band remounts per sub-view swap, which
				   restarts the ambient loops — intended. *@
				@if (showItemPicker || showMovePicker || showJournalView)
				{
					<div class="fsub-head @(showJournalView ? "journal" : "moves")">
						@if (showJournalView)
						{
							<div class="fsub-star"></div>
							<div class="fsub-star"></div>
							<div class="fsub-star"></div>
							<div class="fsub-star"></div>
							<div class="fsub-star"></div>
							<div class="fsub-star"></div>
							<div class="fsub-star"></div>
							<div class="fsub-star"></div>
						}
						else
						{
							<div class="fsub-mote"></div>
							<div class="fsub-mote"></div>
							<div class="fsub-mote"></div>
							<div class="fsub-mote"></div>
							<div class="fsub-mote"></div>
							<div class="fsub-mote"></div>
						}
						<div class="picker-back" onclick=@CloseCurrentSubView onmouseover=@OnHoverBlip>
							<iconify icon="lucide:arrow-left" Size=@(16) Color="#A79DBE" />
							<span class="kb-key">Q</span>
						</div>
						<div class="fsub-id">
							<span class="fsub-kicker">@(showJournalView ? "JOURNAL" : (showMovePicker ? "MOVES" : "ITEM"))</span>
							<span class="fsub-name">@GetSelectedDisplayName()</span>
						</div>
						<div class="fsub-spacer"></div>
						@if (showJournalView)
						{
							<div class="fd-head-badge dim"><span>@GetJournalMilestones().Count MILESTONES</span></div>
						}
						else
						{
							<div class="fd-head-badge"><span>@(showMovePicker ? GetAvailableMovesForPicker().Count : GetAvailableHeldItems().Count) @L("ui.roster.available")</span></div>
						}
						<div class="fd-cut"></div>
					</div>
				}
				<div @ref="factsScrollRef" class="facts-scroll @(showItemPicker || showMovePicker || showJournalView ? "picking" : "")">
					@if (showItemPicker)
					{
						@if (HasSelectedHeldItem())
						{
							<div class="inline-equipped">
								<img class="inline-equipped-icon" src="@GetSelectedHeldItemIconPath()" />
								<div class="inline-equipped-info">
									<span class="inline-equipped-name">@GetSelectedHeldItemName()</span>
									<span class="inline-equipped-label">Equipped</span>
								</div>
								<button class="inline-unequip" onclick=@UnequipCurrentItem onmouseover=@OnHoverBlip>
									<iconify icon="lucide:x" Size=@(14) Color="white" />
								</button>
							</div>
						}
						@{ int _itemRowIdx = 0; }
						@foreach (var item in GetAvailableHeldItems())
						{
							var _itemKbFocused = IsPickerRowFocused(_itemRowIdx);
							var _itemRowIdxCaptured = _itemRowIdx; // per-iteration capture for the hover handler
							_itemRowIdx++;
							<div class="inline-item @($"rarity-{GetItemRarityClass(item)}") @(_itemKbFocused ? "kb-focused" : "")" onclick="@(() => EquipItem(item.Id))" onmouseover=@(() => OnPickerRowHover(_itemRowIdxCaptured))>
								<div class="inline-item-diamond @($"rarity-{GetItemRarityClass(item)}")">
									<img class="inline-item-img" src="@item.IconPath" />
								</div>
								<div class="inline-item-info">
									<div class="inline-item-name">@item.Name</div>
									<div class="inline-item-desc">@item.Description</div>
								</div>
								@if (GetItemQuantity(item.Id) > 1)
								{
									<span class="inline-item-qty">x@(GetItemQuantity(item.Id))</span>
								}
							</div>
						}
						@if (GetAvailableHeldItems().Count == 0)
						{
							<div class="inline-empty">
								<iconify icon="lucide:package-x" Size=@(24) Color="rgba(255,255,255,0.3)" />
								<span class="inline-empty-text">No held items</span>
							</div>
						}
					}
					else if (showMovePicker)
					{
						@* (13b: the picker header moved OUT of the scroll into the
						   .fsub-head band above — kicker MOVES + motes ambient.) *@
						@if (selectedMoveSlot < (SelectedMonster.Moves?.Count ?? 0))
						{
							var currentMove = SelectedMonster.Moves[selectedMoveSlot];
							var currentDef = MoveDatabase.GetMove(currentMove.MoveId);
							@if (currentDef != null)
							{
								var curElClass = currentDef.Element.ToString().ToLower();
								<div class="inline-equipped">
									<img class="inline-equipped-icon" src="ui/icons/elements/background/@(curElClass).svg" />
									<div class="inline-equipped-info">
										<span class="inline-equipped-name">@currentDef.Name</span>
										<span class="inline-equipped-label">Replacing</span>
									</div>
								</div>
							}
						}
						@{
							// Current move for comparison (null if learning into empty slot)
							MoveDefinition pickerCurrentMove = null;
							if (selectedMoveSlot < (SelectedMonster.Moves?.Count ?? 0))
							{
								pickerCurrentMove = MoveDatabase.GetMove(SelectedMonster.Moves[selectedMoveSlot].MoveId);
							}
						}
						@{ int _moveRowIdx = 0; }
						@foreach (var lm in GetAvailableMovesForPicker())
						{
							var moveDef = MoveDatabase.GetMove(lm.MoveId);
							var _moveKbFocused = IsPickerRowFocused(_moveRowIdx);
							var _rowIdxCaptured = _moveRowIdx; // per-iteration capture for the hover handler
							_moveRowIdx++;
							if (moveDef != null)
							{
								var elClass = moveDef.Element.ToString().ToLower();
								var isStab = IsMoveSTAB(moveDef);
								var effectsSummary = GetMoveEffectsSummary(moveDef);
								var powerDiff = pickerCurrentMove != null && pickerCurrentMove.BasePower > 0 ? moveDef.BasePower - pickerCurrentMove.BasePower : 0;
								var isUpgrade = powerDiff > 0;
								var isDowngrade = powerDiff < 0;
								// 4A row (2026-07-05) — PORTS the dossier move-slab family
								// (.move-diamond-slot: parallelogram element tile, name +
								// STAB stamp, colored cat/power token, inline desc,
								// fd-cut) with a picker-only .mvp width override and the
								// ARM-THEN-CONFIRM flow: first click arms the row (violet
								// border + the chip slot becomes a solid LEARN button),
								// second click on the SAME row commits via the original
								// SwapMoveSlot. The chip is ONE value-swapped element
								// (ghost-child law) and pointer-inert like every row
								// child, so there is no nested-handler bubbling — the
								// armed row itself is the commit surface.
								var _isArmed = pickerArmedMoveId == lm.MoveId;
								<div class="move-diamond-slot mvp @elClass @(_isArmed ? "armed" : "") @(_moveKbFocused ? "kb-focused" : "")" onclick="@(() => OnMovePickerRowClicked(lm.MoveId))" onmouseover=@(() => OnPickerRowHover(_rowIdxCaptured))>
									<div class="move-diamond-icon @elClass">
										<img class="move-el-img" src="ui/icons/elements/element_white/@(GetElementIconName(moveDef.Element)).svg" />
									</div>
									<div class="move-diamond-info">
										<div class="move-name-row">
											<span class="move-diamond-name">@moveDef.Name</span>
											@if (isStab)
											{
												<span class="move-stab-badge"><span>STAB</span></span>
											}
										</div>
										<div class="move-diamond-meta">
											<span class="move-cat @moveDef.Category.ToString().ToLower()">@moveDef.Category.ToString().Substring(0, 3).ToUpper()@(moveDef.BasePower > 0 ? " " + moveDef.BasePower : "")</span>
											@if (powerDiff != 0)
											{
												<span class="move-pwr-diff @(isUpgrade ? "up" : "down")">@(powerDiff > 0 ? "+" : "")@powerDiff</span>
											}
											<span class="move-meta-stat">ACC @moveDef.Accuracy%</span>
										</div>
										<span class="move-desc">@moveDef.Description</span>
									</div>
									<div class="mvp-chip @(_isArmed ? "learn" : (string.IsNullOrEmpty(effectsSummary) ? "off" : ""))">
										<span>@(_isArmed ? "LEARN" : effectsSummary)</span>
									</div>
									<div class="fd-cut"></div>
								</div>
							}
						}
						@if (GetAvailableMovesForPicker().Count == 0)
						{
							<div class="inline-empty">
								<iconify icon="lucide:swords" Size=@(24) Color="rgba(255,255,255,0.3)" />
								<span class="inline-empty-text">No other moves available</span>
							</div>
						}
					}
					else if (showJournalView)
					{
						@* ══ 10A MILESTONE JOURNAL — register cards, scroll-direct.
						   The per-register accent (border tint, corner glow, icon
						   tile, tag, medallion rings) is COMPUTED INLINE from
						   GetJmAccent — a per-kind × per-element scss matrix
						   would be ~60 rules. All inline styles are always-
						   emitted (ghost-style law). Glow kinds crop their 180px
						   corner wash via the card's overflow:hidden (explicit
						   W+H — the record-tile precedent). Evolution cards wear
						   the beast's PRIMARY element accent + both forms'
						   sprites in tinted medallions; THE BEGINNING is
						   synthesized last from Monster fields. *@
						@foreach (var jm in GetJournalMilestones())
						{
							var jmAcc = GetJmAccent(jm.Kind);
							<div class="jm-card @jm.Kind" style="border-color: @(jmAcc.glow ? JmRgba(jmAcc.hex, 0.35f) : "#262038");">
								@if (jmAcc.glow)
								{
									<div class="jm-glow" style="background-image: radial-gradient(@JmRgba(jmAcc.hex, 0.14f) 0%, rgba(0, 0, 0, 0) 70%);"></div>
								}
								<div class="jm-tile" style="background-color: @JmRgba(jmAcc.hex, 0.12f);">
									<iconify icon="@GetJmIcon(jm.Kind)" Size=@(17) Color="@jmAcc.hex" />
								</div>
								<div class="jm-body">
									<div class="jm-title-row">
										<span class="jm-title">@jm.Title</span>
										@if (!string.IsNullOrEmpty(jm.Sub))
										{
											<span class="jm-sub">@jm.Sub</span>
										}
									</div>
									<div class="jm-meta">
										<span class="jm-tag" style="color: @jmAcc.hex;">@jm.Tag</span>
										@if (!string.IsNullOrEmpty(jm.Date))
										{
											<span class="jm-date">@jm.Date</span>
										}
									</div>
								</div>
								@if (jm.Kind == "evo" && !string.IsNullOrEmpty(jm.PreIcon))
								{
									<div class="jm-medal sm" style="background-color: @JmRgba(jmAcc.hex, 0.06f); border-color: @JmRgba(jmAcc.hex, 0.18f);">
										<img class="jm-medal-img sm" src="@jm.PreIcon" />
									</div>
									<span class="jm-evo-arrow" style="color: @jmAcc.hex;">→</span>
								}
								@if (!string.IsNullOrEmpty(jm.MedalIcon))
								{
									<div class="jm-medal" style="background-color: @JmRgba(jmAcc.hex, 0.08f); border-color: @JmRgba(jmAcc.hex, 0.25f);">
										<img class="jm-medal-img" src="@jm.MedalIcon" />
									</div>
								}
								<div class="fd-cut"></div>
							</div>
						}
					}
					else
					{
						@* ══ 1B STATS — header chip + six single-line stat rows +
						   quality/nature corner-cut tiles. Rows are EXPLICIT-width
						   flex (42/46/270/62/36 + 12 gaps = 504 — the mock's 5-col
						   grid translated; no display:grid in s&box). Bar fills are
						   EXPLICIT PX via GetStatBarPx — a % width under the skewed
						   .sb-bar ancestor is derived-width poison. The boost slot is
						   ALWAYS rendered so values stay aligned. This section stays
						   UN-frev'd so the bar widths re-tween on beast switch. *@
						@{
							var _hasTraits = SelectedMonster.Traits != null && SelectedMonster.Traits.Count > 0;
						}
						<div class="stats-section fd-zone">
							<div class="fd-head">
								<div class="fd-head-chip"><span>@L("ui.roster.stats")</span></div>
								<div class="fd-head-line"></div>
							</div>
							<div class="sb-row">
								<span class="sb-label hp">HP</span>
								<span class="sb-gene">@(SelectedMonster.Genetics.HPGene)/30</span>
								<div class="sb-bar"><div class="sb-fill hp" style="width: @GetStatBarPx(SelectedMonster.MaxHP)"></div></div>
								<span class="sb-value">@SelectedMonster.MaxHP</span>
								<div class="sb-boost">
									@if (GetStatVeteranBonus(SelectedMonster.MaxHP, true) > 0)
									{
										<span class="sb-boost-chip"><span>+@GetStatVeteranBonus(SelectedMonster.MaxHP, true)</span></span>
