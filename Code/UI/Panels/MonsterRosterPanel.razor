							</div>
						</div>

						<!-- Moves Section -->
						<div class="moves-section">
							<div class="section-title">
								@L("ui.roster.moves")
								@if (GetAvailableMovesCount() > 0)
								{
									<span class="moves-available-badge">@GetAvailableMovesCount() @L("ui.roster.available")</span>
								}
							</div>
							<div class="moves-grid-2x2">
								@{
									var moves = SelectedMonster.Moves ?? new List<MonsterMove>();
								}
								<!-- Row 1 -->
								<div class="moves-row">
									@for (int i = 0; i < 2; i++)
									{
										var slotIndex = i;
										@if (i < moves.Count)
										{
											var move = moves[i];
											var moveDef = MoveDatabase.GetMove(move.MoveId);
											if (moveDef != null)
											{
												var elementClass = moveDef.Element.ToString().ToLower();
												var isStab = IsMoveSTAB(moveDef);
												var effectsSummary = GetMoveEffectsSummary(moveDef);
												<div class="move-diamond-slot @elementClass @(GetAvailableMovesCount() > 0 ? "swappable" : "") @(isStab ? "stab" : "") has-move-tip @(IsDetailControlFocused($"move-{slotIndex}") ? "kb-focused" : "")" onclick="@(() => OpenMoveSwap(slotIndex))" onmouseover=@(() => SoundManager.PlayHover())>
													<div class="move-diamond-icon @elementClass">
														<img class="move-el-img" src="ui/icons/elements/element_white/@(GetElementIconName(moveDef.Element)).svg" />
													</div>
													<div class="move-diamond-info">
														<span class="move-diamond-name">@moveDef.Name</span>
														<div class="move-diamond-meta">
															<span class="move-cat @moveDef.Category.ToString().ToLower()">@moveDef.Category.ToString().Substring(0, 3).ToUpper()</span>
															@if (moveDef.BasePower > 0)
															{
																<span class="move-pwr">@moveDef.BasePower</span>
															}
															@if (isStab)
															{
																<span class="move-stab-badge">STAB</span>
															}
														</div>
													</div>
													<!-- Tooltip showing full description + accuracy + effects -->
													<div class="move-tooltip">
														<span class="move-tip-name">@moveDef.Name</span>
														<span class="move-tip-desc">@moveDef.Description</span>
														<div class="move-tip-stats">
															<span class="move-tip-stat">
																<span class="tip-label">ACC</span>
																<span class="tip-val">@moveDef.Accuracy%</span>
															</span>
															<span class="move-tip-stat">
																<span class="tip-label">PP</span>
																<span class="tip-val">@move.CurrentPP/@moveDef.MaxPP</span>
															</span>
															@if (moveDef.Priority != 0)
															{
																<span class="move-tip-stat">
																	<span class="tip-label">PRI</span>
																	<span class="tip-val">@(moveDef.Priority > 0 ? "+" : "")@moveDef.Priority</span>
																</span>
															}
														</div>
														@if (!string.IsNullOrEmpty(effectsSummary))
														{
															<span class="move-tip-effects">@effectsSummary</span>
														}
													</div>
												</div>
											}
										}
										else
										{
											<div class="move-diamond-slot empty @(IsDetailControlFocused($"move-{slotIndex}") ? "kb-focused" : "")" onclick="@(() => OpenMoveSwap(slotIndex))" onmouseover=@(() => SoundManager.PlayHover())>
												<div class="move-diamond-icon empty-icon">
													<span class="move-empty-plus">+</span>
												</div>
												<div class="move-diamond-info">
													<span class="move-diamond-name empty-text">Empty Slot</span>
												</div>
											</div>
										}
									}
								</div>
								<!-- Row 2 -->
								<div class="moves-row">
									@for (int i = 2; i < 4; i++)
									{
										var slotIndex = i;
										@if (i < moves.Count)
										{
											var move = moves[i];
											var moveDef = MoveDatabase.GetMove(move.MoveId);
											if (moveDef != null)
											{
												var elementClass = moveDef.Element.ToString().ToLower();
												var isStab = IsMoveSTAB(moveDef);
												var effectsSummary = GetMoveEffectsSummary(moveDef);
												<div class="move-diamond-slot @elementClass @(GetAvailableMovesCount() > 0 ? "swappable" : "") @(isStab ? "stab" : "") has-move-tip @(IsDetailControlFocused($"move-{slotIndex}") ? "kb-focused" : "")" onclick="@(() => OpenMoveSwap(slotIndex))" onmouseover=@(() => SoundManager.PlayHover())>
													<div class="move-diamond-icon @elementClass">
														<img class="move-el-img" src="ui/icons/elements/element_white/@(GetElementIconName(moveDef.Element)).svg" />
													</div>
													<div class="move-diamond-info">
														<span class="move-diamond-name">@moveDef.Name</span>
														<div class="move-diamond-meta">
															<span class="move-cat @moveDef.Category.ToString().ToLower()">@moveDef.Category.ToString().Substring(0, 3).ToUpper()</span>
															@if (moveDef.BasePower > 0)
															{
																<span class="move-pwr">@moveDef.BasePower</span>
															}
															@if (isStab)
															{
																<span class="move-stab-badge">STAB</span>
															}
														</div>
													</div>
													<!-- Tooltip showing full description + accuracy + effects -->
													<div class="move-tooltip">
														<span class="move-tip-name">@moveDef.Name</span>
														<span class="move-tip-desc">@moveDef.Description</span>
														<div class="move-tip-stats">
															<span class="move-tip-stat">
																<span class="tip-label">ACC</span>
																<span class="tip-val">@moveDef.Accuracy%</span>
															</span>
															<span class="move-tip-stat">
																<span class="tip-label">PP</span>
																<span class="tip-val">@move.CurrentPP/@moveDef.MaxPP</span>
															</span>
															@if (moveDef.Priority != 0)
															{
																<span class="move-tip-stat">
																	<span class="tip-label">PRI</span>
																	<span class="tip-val">@(moveDef.Priority > 0 ? "+" : "")@moveDef.Priority</span>
																</span>
															}
														</div>
														@if (!string.IsNullOrEmpty(effectsSummary))
														{
															<span class="move-tip-effects">@effectsSummary</span>
														}
													</div>
												</div>
											}
										}
										else
										{
											<div class="move-diamond-slot empty @(IsDetailControlFocused($"move-{slotIndex}") ? "kb-focused" : "")" onclick="@(() => OpenMoveSwap(slotIndex))" onmouseover=@(() => SoundManager.PlayHover())>
												<div class="move-diamond-icon empty-icon">
													<span class="move-empty-plus">+</span>
												</div>
												<div class="move-diamond-info">
													<span class="move-diamond-name empty-text">Empty Slot</span>
												</div>
											</div>
										}
									}
								</div>
							</div>
						</div>


						<!-- Lineage Section (for bred monsters) -->
						@if (SelectedMonster.Generation > 0 && (SelectedMonster.Parent1Id.HasValue || SelectedMonster.Parent2Id.HasValue))
						{
							<div class="lineage-section">
								<div class="section-title">@L("ui.roster.lineage")</div>
								<div class="lineage-info">
									<div class="lineage-row">
										<span class="lineage-label">@L("ui.roster.generation")</span>
										<span class="lineage-value">@SelectedMonster.Generation</span>
									</div>
									@if (SelectedMonster.Parent1Id.HasValue)
									{
										<div class="lineage-row">
											<span class="lineage-label">@L("ui.roster.source_1")</span>
											<span class="lineage-value">@GetParentName(SelectedMonster.Parent1Id.Value)</span>
										</div>
									}
									@if (SelectedMonster.Parent2Id.HasValue)
									{
										<div class="lineage-row">
											<span class="lineage-label">@L("ui.roster.source_2")</span>
											<span class="lineage-value">@GetParentName(SelectedMonster.Parent2Id.Value)</span>
										</div>
									}
								</div>
							</div>
						}

						<!-- Traits Section (sits between moves and battle mastery — traits
						     are character flavor that modify how moves work, so they
						     read naturally as a footnote to the moves above. Hidden
						     when the beast has no traits, so layout collapses cleanly). -->
						@if (SelectedMonster.Traits != null && SelectedMonster.Traits.Count > 0)
						{
							<div class="traits-section">
								<div class="section-title">@L("ui.roster.traits")</div>
								<div class="traits-list">
									@foreach (var traitId in SelectedMonster.Traits)
									{
										<div class="trait-card">
											<div class="trait-card-header">
												<iconify icon="@GetTraitIcon(traitId)" Size=@(12) Color="#a78bfa" />
												<span class="trait-card-name">@GetTraitName(traitId)</span>
											</div>
											<span class="trait-card-desc">@GetTraitDescription(traitId)</span>
										</div>
									}
								</div>
							</div>
						}

						<!-- Battle Mastery removed — mastery is now species-level in the Beastbook -->

					</div>

					}
				</div>
				}
				</div>
			}

			<div class="collection-main">
				<div @ref="rosterGridRef" class="roster-grid" onmouseup=@OnDragSelectEnd>
				@{
					// In fusion mode, use the breeding filter state (separate from the
					// collection filter state) so swapping in/out of fusion mode doesn't
					// disturb the player's primary collection sort/filter setup.
					var collectionMonsters = isFusionMode ? GetAvailableBreedingMonsters() : GetFilteredMonsters();
					var keyboardIdx = Math.Clamp(selectedMonsterIndex, 0, Math.Max(0, collectionMonsters.Count - 1));
				}
				@for (int i = 0; i < collectionMonsters.Count; i++)
				{
					var monster = collectionMonsters[i];
					var idx = i;
					var isKeyboardSelected = isKeyboardNavigationActive && i == keyboardIdx;
					var isSelectedForRelease = selectedForRelease.Contains(monster.Id);
					var isFusionParent1 = isFusionMode && Parent1?.Id == monster.Id;
					var isFusionParent2 = isFusionMode && Parent2?.Id == monster.Id;
					var isFusionParent = isFusionParent1 || isFusionParent2;
					var isFusionIncompatible = isFusionMode && Parent1 != null && !isFusionParent && monster.SpeciesId != Parent1.SpeciesId;
					// Beast-art editor is only active in "card" mode, when the
					// editor toolbar is enabled, and when no other interaction
					// mode (fusion / multi-select) is competing for clicks.
					var _mybCardEditing = ShowMyBeastsArtEditor && _myBeastsEditMode == "card" && !isFusionMode && !isMultiSelectMode;
					<div @ref="cardSizeRef" class="monster-card-wrapper @(isMultiSelectMode ? "multi-select-mode" : "") @(isSelectedForRelease ? "selected-for-release" : "") @(isFusionMode ? "fusion-mode" : "") @(isFusionParent ? "fusion-parent" : "") @(isFusionIncompatible ? "fusion-incompatible" : "") @(_mybCardEditing ? "myb-art-edit" : "")"
						 onclick=@(() => OnMonsterCardClicked(monster, idx))
						 onmousedown=@(() => { OnCardMouseDown(monster, idx); if (_mybCardEditing) StartMyBeastsArtDrag(_myBeastsTestSpeciesId ?? monster.SpeciesId); })
						 onmouseover=@(() => { OnCardMouseEnter(monster, idx); if (_mybCardEditing) OnMyBeastsArtHover(_myBeastsTestSpeciesId ?? monster.SpeciesId); })
						 onmouseout=@(() => { if (_mybCardEditing) OnMyBeastsArtLeave(_myBeastsTestSpeciesId ?? monster.SpeciesId); })
						 onmouseup=@OnDragSelectEnd>
						@if (justSelectedMonsterId.HasValue && justSelectedMonsterId.Value == monster.Id)
						{
							<!-- One-shot select pulse. Keyed on selectPulseVersion so
							     each click remounts the overlay and css-keyframes fire
							     fresh (s&box quirk: keyframes only run on first mount).
							     Removes itself visually via SCSS opacity: 0 end-state. -->
							<div class="select-pulse pulse-@selectPulseVersion"></div>
						}
						@if (isMultiSelectMode)
						{
							<div class="select-checkbox @(isSelectedForRelease ? "checked" : "")">
								@(isSelectedForRelease ? "✓" : "")
							</div>
						}
						@if (isFusionParent1)
						{
							<div class="parent-indicator p1">B1</div>
						}
						@if (isFusionParent2)
						{
							<div class="parent-indicator p2">B2</div>
						}
@{
							// Card is hovered if it matches the hoveredMonsterId
							var isThisCardHovered = hoveredMonsterId.HasValue && hoveredMonsterId.Value == monster.Id;
							// Card is selected if it's the SelectedMonster, keyboard selected, or hovered (for visual styling - purple glow)
							var isThisCardSelected = (SelectedMonster?.Id == monster.Id || isKeyboardSelected || isThisCardHovered);
							// Should animate if: hovered, OR (selected AND no other card is hovered)
							var shouldAnimate = isThisCardHovered || (isThisCardSelected && !hoveredMonsterId.HasValue);
						}
						<MonsterCard Monster=@monster
									 IsSelected=@isThisCardSelected
									 ShouldAnimate=@shouldAnimate
									 IsMini=@true
									 ShowGenes=@isFusionMode
									 AnimateOnHover=@true
									 AnimationFrame=@SpriteAnimator.GlobalFrame
									 OverrideArtSpeciesId=@(_mybCardEditing ? _myBeastsTestSpeciesId : null)
									 ArtVersion=@_myBeastsArtVersion
									 ClickAction=@(() => {})
									 HoverAction=@(() => OnMouseHoverCard(monster.Id))
									 LeaveAction=@OnMouseLeaveCard />
						@* Favorite quick-toggle — one click from the rail, no
						   select-then-diamond round trip. Same spot as the (hidden)
						   mini-fav star; suppressed in multi-select via SCSS. *@
						@if (!isMultiSelectMode)
						{
							<div class="card-fav-qt @(monster.IsFavorite ? "fav" : "")"
								 onclick=@(() => ToggleFavoriteFor(monster)) onclick:stopPropagation
								 onmouseover=@(() => SoundManager.PlayHover())>
								<iconify icon="lucide:star" Size=@(13) Color="@(monster.IsFavorite ? "#ffce3a" : "rgba(244, 241, 234, 0.7)")" />
							</div>
						}
						@* Hover-preview ring — the cheap flat-panel recipe (absolute
						   bordered div, opacity swap on :hover). The SELECTED beast
						   gets the one waving imperative ring instead (root level). *@
						<div class="card-ring"></div>
					</div>
				}

				@if (currentFilter == "all")
				{
					var totalMonsters = GetMonsterCount();
					var emptySlots = GetEmptySlotCount(totalMonsters);
					@for (int i = 0; i < emptySlots; i++)
					{
						<div class="empty-slot mini" onmouseover=@OnMouseLeaveCard>
							<div class="empty-slot-border"></div>
						</div>
					}
				}

				@if (GetFilteredMonsters().Count == 0 && currentFilter != "all")
				{
					<div class="empty-roster">
						<div class="empty-icon">?</div>
						<div class="empty-text">@L("ui.roster.no_monsters")</div>
						<div class="empty-hint">@L("ui.roster.no_filter_match")</div>
					</div>
				}
				</div>
			</div>
		</div>


			<!-- Release Confirmation Modal -->
			@if (showReleaseConfirm && monsterToRelease != null)
			{
				@{
					var _releaseSpecies = MonsterManager.Instance?.GetSpecies(monsterToRelease.SpeciesId);
					var _releaseElementClass = _releaseSpecies?.Element.ToString().ToLower() ?? "neutral";
				}
				<div class="bulk-release-overlay" onclick=@CancelRelease>
					<div class="bulk-release-panel" onclick:stopPropagation>
						<!-- Header with warning icon -->
						<div class="bulk-release-header">
							<div class="bulk-release-warning-icon">
								<iconify icon="lucide:triangle-alert" Size=@(28) Color="#ef4444" />
							</div>
							<div class="bulk-release-title-block">
								<span class="bulk-release-title">Release this Beast?</span>
								<span class="bulk-release-subtitle">This action cannot be undone</span>
							</div>
						</div>

						<!-- Single beast card -->
						<div class="bulk-release-list">
							<div class="bulk-release-card @($"element-{_releaseElementClass}")">
								<div class="bulk-release-card-portrait" style="background-image: url(@(_releaseSpecies?.IconPath ?? ""))"></div>
								<div class="bulk-release-card-info">
									<span class="bulk-release-card-name">@monsterToRelease.Nickname</span>
									<div class="bulk-release-card-meta">
										<span class="bulk-release-card-level">LV @monsterToRelease.Level</span>
										<img class="bulk-release-card-element" src="ui/icons/elements/element_white/@(_releaseElementClass).svg" />
									</div>
								</div>
							</div>
						</div>

						<!-- Action buttons -->
						<div class="bulk-release-buttons">
							<button class="bulk-release-btn cancel" onclick=@CancelRelease onmouseover=@(() => SoundManager.PlayHover())>
								<iconify icon="lucide:x" Size=@(16) Color="white" />
								<span>@L("ui.common.cancel")</span>
							</button>
							<button class="bulk-release-btn release" onclick=@ConfirmRelease onmouseover=@(() => SoundManager.PlayHover())>
								<iconify icon="lucide:trash-2" Size=@(16) Color="white" />
								<span>@L("ui.roster.release")</span>
							</button>
						</div>
					</div>
				</div>
			}

	
			<!-- Journal Modal -->
			@if (showJournalModal && SelectedMonster != null)
			{
				<div class="journal-modal-overlay" onclick=@CloseJournal>
					<div class="journal-modal" onclick:stopPropagation>
						<div class="journal-modal-header">
							<div class="journal-modal-title">
								<span class="journal-icon">📖</span>
								<span class="journal-name">@(string.IsNullOrEmpty(SelectedMonster.Nickname) ? GetSelectedSpeciesName() : SelectedMonster.Nickname)'s Journal</span>
							</div>
							<button class="close-btn" onclick=@CloseJournal><iconify icon="lucide:x" Size=@(15) Color="rgba(255, 255, 255, 0.85)" /></button>
						</div>
						<div class="journal-modal-content">
							@if (SelectedMonster.Journal != null && SelectedMonster.Journal.Count > 0)
							{
								@foreach (var entry in SelectedMonster.Journal.OrderByDescending(e => e.Timestamp))
								{
									<div class="journal-modal-entry @GetJournalEntryClass(entry.Type) @(!string.IsNullOrEmpty(entry.ZoneId) ? "has-background" : "") @(entry.Type == JournalEntryType.BossDefeat ? "has-monster" : "")" style="@GetEntryBackgroundStyle(entry)">
										<span class="entry-icon">@GetJournalEntryIcon(entry.Type)</span>
										<div class="entry-body">
											<div class="entry-text">@entry.Content</div>
											<div class="entry-meta">
												<div class="entry-badge @GetJournalEntryClass(entry.Type)">
													<span class="badge-text">@GetJournalEntryBadge(entry.Type)</span>
												</div>
												<div class="entry-timestamp">@entry.Timestamp.ToString("MMM d, yyyy") at @entry.Timestamp.ToString("h:mm tt")</div>
											</div>
										</div>
										@if (entry.Type == JournalEntryType.BossDefeat)
										{
											<div class="entry-monster">
												@if (!string.IsNullOrEmpty(entry.SpeciesId))
												{
													<img src="@GetJournalSpeciesIcon(entry.SpeciesId)" />
												}
												else
												{
													<span class="monster-placeholder">💀</span>
												}
											</div>
										}
									</div>
								}
							}
							else
							{
								<div class="journal-empty">@L("ui.roster.journal_empty")</div>
							}
						</div>
					</div>
				</div>
			}
		</div>
		</div>

	<!-- THE LIVING VIOLET RING — one waving selection cursor wrapping the
	     selected beast's card (menu/PawPad signature, flat-panel recipe).
	     Root-level absolute so it can wave per-frame without dirtying the
	     grid; position bound from UpdateGridRing each tick, wave via
	     imperative Style.Transform in ApplyGridRingWave. z 60: above the
	     grid cards, below the sidebar (80) / journal modal (100) /
	     header (500) — flat z-index law, no stacking contexts. -->
	<div @ref="gridRingRef" class="grid-ring @(gridRingVisible ? "on" : "") @(gridRingWarm < 2 ? "snap" : "") @(gridRingTight ? "tight" : "")"
		 style="left: @(gridRingL)px; top: @(gridRingT)px; width: @(gridRingW)px; height: @(gridRingH)px;"></div>

	<!-- Move Picker Modal (at root level for full coverage) -->

	<!-- Fusion confirmation popup REMOVED — replaced with the
	     two-stage in-button confirm on the FUSE CTA. See
	     pendingFusionConfirm + RunFusionConfirmTimeout in the code-behind. -->

	<!-- Fusion Result Modal — REVERTED to original simple structure
	     after multiple failed attempts at the v2 redesign. Keeping the
	     original markup that we know works; v2 redesign is shelved. -->
	@if (showResult && breedingResult != null)
	{
		<div class="result-overlay @(isFusionAnimating ? "animating" : "")">
			<!-- Result Panel - always visible, animation plays inside.
			     The `tier-X` class colors the panel border based on the
			     offspring's quality (gold for Perfect, purple for Excellent, etc) -->
			<div class="result-panel @(isFusionAnimating ? "fusing" : "") @(breedingResult?.Genetics != null ? $"tier-{breedingResult.Genetics.QualityRating.ToLower()}" : "")">
				<!-- Fusion Animation (inside panel) -->
				@if (isFusionAnimating)
				{
					<div class="fusion-animation-container @fusionPhase">
						<!-- DNA Helix Spirals -->
						<div class="dna-helix left">
							@for (int i = 0; i < 8; i++)
							{
								<div class="helix-particle p@(i)"></div>
							}
						</div>
						<div class="dna-helix right">
							@for (int i = 0; i < 8; i++)
							{
								<div class="helix-particle p@(i)"></div>
							}
						</div>

						<!-- Swirling energy particles -->
						<div class="energy-vortex">
							@for (int i = 0; i < 12; i++)
							{
								<div class="vortex-particle p@(i)"></div>
							}
						</div>

						<!-- Central fusion core -->
						<div class="fusion-core">
							<div class="core-inner"></div>
							<div class="core-ring r1"></div>
							<div class="core-ring r2"></div>
							<div class="core-ring r3"></div>
						</div>

						<!-- Flash effect -->
						<div class="fusion-flash"></div>
					</div>
				}

				<!-- Result Content (hidden during animation, revealed after) -->
				<div class="result-content-wrapper @(isFusionAnimating ? "hidden" : "revealed")">
					@{
						// Hero data — pulled up so the title row can also use the
						// quality class for its tier badge.
						var heroSpecies = MonsterManager.Instance?.GetSpecies(breedingResult.SpeciesId);
						var heroSprite = heroSpecies?.IconPath ?? "";
						var heroQualityClass = breedingResult.Genetics?.QualityRating?.ToLower() ?? "average";
						var heroQuality = breedingResult.Genetics?.QualityRating ?? "Average";
						var heroElement = heroSpecies?.Element.ToString().ToLower() ?? "neutral";
						var heroSecondaryElement = heroSpecies?.SecondaryElement?.ToString().ToLower();
						var heroRarity = heroSpecies?.BaseRarity.ToString() ?? "Common";
						var heroRarityClass = heroRarity.ToLower();
					}
					@{
						var rTotal = GetResultTotalGenes();
						var rDelta = rTotal - lastFusionExpectedTotal;
						var rvxClass = rDelta >= 3 ? "lucky" : rDelta <= -3 ? "harsh" : "ontarget";
						var rvxLabel = rDelta >= 3 ? "LUCKY" : rDelta <= -3 ? "HARSH" : "ON TARGET";
						var rvxSign = rDelta > 0 ? "+" : "";
						// Nature source — player-friendly labels
						var natSrc = GetNatureSource();
						var natSrcLabel = natSrc == "both" ? "inherited" : natSrc == "b1" ? $"from {lastFusionParent1?.Nickname ?? "B1"}" : natSrc == "b2" ? $"from {lastFusionParent2?.Nickname ?? "B2"}" : "random";
						// Element name for display
						var heroElementName = heroSpecies?.Element.ToString() ?? "Neutral";
					}

					<!-- Title -->
					<div class="result-title">
						<iconify icon="lucide:sparkles" Size=@(22) Color="#fbbf24" />
						<span>FUSION COMPLETE</span>
						<span class="result-tier-badge @heroQualityClass">@heroQuality</span>
					</div>

					<!-- Hero row: mini card + info side by side.
					     Uses IsMini (cleaner — just sprite + LV pill + name bar)
					     instead of IsCompact which duplicates PWR/rarity/element
					     that the right column already shows. -->
					<div class="result-content">
						<MonsterCard Monster=@breedingResult IsMini=@true ShowGenes=@true AnimationFrame=@SpriteAnimator.GlobalFrame />
						<div class="result-right">
							<div class="result-hero-name"><span>@(string.IsNullOrEmpty(breedingResult.Nickname) ? heroSpecies?.Name : breedingResult.Nickname)</span></div>
							<!-- Element type + Rarity -->
							<div class="result-hero-sub">
								<img class="result-hero-el" src="ui/icons/elements/background/@(heroElement).svg" />
								<span>@heroElementName</span>
								@if (heroSecondaryElement != null)
								{
									<span class="result-sep">/</span>
									<img class="result-hero-el secondary" src="ui/icons/elements/background/@(heroSecondaryElement).svg" />
									<span>@(heroSpecies.SecondaryElement?.ToString() ?? "")</span>
								}
								<span class="result-sep">·</span>
								<span class="result-hero-rarity @heroRarityClass">@heroRarity</span>
							</div>
							<!-- Power Rating -->
							<div class="result-hero-power">
								<iconify icon="lucide:zap" Size=@(14) Color="#fbbf24" />
								<span class="pwr-label">PWR</span>
								<span class="pwr-value">@breedingResult.PowerRating.ToString("N0")</span>
							</div>
							<!-- Gene total + bar -->
							<div class="result-gene-line">
								<iconify icon="lucide:dna" Size=@(13) Color="#c4b5fd" />
								<span class="result-gene-total">@rTotal</span>
								<span class="result-gene-max">/180</span>
							</div>
							<div class="result-gene-bar-bg">
								<div class="result-gene-bar-fill @heroQualityClass" style="width: @((rTotal / 180f * 100f).ToString("F0"))%"></div>
							</div>
						</div>
					</div>

					<!-- Roll vs Expected -->
					@if (lastFusionExpectedTotal > 0)
					{
						<div class="result-section result-rvx-row">
							<span class="result-section-label">RESULT</span>
							<span class="rvx-expected">~@lastFusionExpectedTotal expected</span>
							<span class="rvx-verdict @rvxClass">
								<span>@rvxSign@rDelta @rvxLabel</span>
							</span>
						</div>
					}

					<!-- Genetics — simple text grid, no boxes. Colored label +
					     white value inline. Two rows of three pairs. -->
					<div class="result-section">
						<span class="result-section-label">GENETICS</span>
					</div>
					<div class="result-stat-grid">
						<div class="result-stat-row">
							<div class="result-stat"><span class="stat-label hp">HP</span><span class="stat-val">@breedingResult.Genetics.HPGene</span></div>
							<div class="result-stat"><span class="stat-label atk">ATK</span><span class="stat-val">@breedingResult.Genetics.ATKGene</span></div>
							<div class="result-stat"><span class="stat-label def">DEF</span><span class="stat-val">@breedingResult.Genetics.DEFGene</span></div>
						</div>
						<div class="result-stat-row">
							<div class="result-stat"><span class="stat-label spa">SpA</span><span class="stat-val">@breedingResult.Genetics.SpAGene</span></div>
							<div class="result-stat"><span class="stat-label spd-def">SpD</span><span class="stat-val">@breedingResult.Genetics.SpDGene</span></div>
							<div class="result-stat"><span class="stat-label spd">SPD</span><span class="stat-val">@breedingResult.Genetics.SPDGene</span></div>
						</div>
					</div>

					<!-- Traits inherited -->
					@if (breedingResult.Traits != null && breedingResult.Traits.Count > 0)
					{
						<div class="result-section">
							<span class="result-section-label">TRAITS INHERITED</span>
							<div class="result-traits">
								@foreach (var trait in breedingResult.Traits)
								{
									var src = GetTraitSource(trait);
									var srcLabel = src == "both" ? "inherited"
										: src == "b1" ? $"from {lastFusionParent1?.Nickname ?? "parent"}"
										: src == "b2" ? $"from {lastFusionParent2?.Nickname ?? "parent"}"
										: "new";
									<span class="result-trait has-tooltip">
										<iconify icon="@GetTraitIcon(trait)" Size=@(11) Color="#fbbf24" />
										<span class="result-trait-name">@GetTraitName(trait)</span>
										<span class="result-trait-src @src">@srcLabel</span>
										<span class="result-popup-tip">@GetTraitDescription(trait)</span>
									</span>
								}
							</div>
						</div>
					}

					<!-- Nature -->
					<div class="result-section result-nature-row has-tooltip">
						<iconify icon="lucide:leaf" Size=@(14) Color="#86efac" />
						<span class="nature-name">@breedingResult.Genetics.Nature</span>
						<span class="nature-src @natSrc">@natSrcLabel</span>
						<span class="result-popup-tip">@breedingResult.Genetics.GetNatureDescription()</span>
					</div>

					<!-- CTAs -->
					<div class="result-cta-row">
						<button class="result-btn secondary" onclick=@CloseResult onmouseover=@(() => SoundManager.PlayHover())>
							<span>CONTINUE</span>
						</button>
						<button class="result-btn primary" onclick=@FuseAgain onmouseover=@(() => SoundManager.PlayHover())>
							<iconify icon="lucide:combine" Size=@(16) Color="#ffffff" />
							<span>FUSE AGAIN</span>
						</button>
					</div>
				</div>
			</div>
		</div>
	}
</div>

@if (showBulkReleaseConfirm && selectedForRelease.Count > 0)
{
	<div class="bulk-release-overlay" onclick=@CancelBulkRelease>
		<div class="bulk-release-panel" onclick:stopPropagation>
			<!-- Header with warning icon -->
			<div class="bulk-release-header">
				<div class="bulk-release-warning-icon">
					<iconify icon="lucide:triangle-alert" Size=@(28) Color="#ef4444" />
				</div>
				<div class="bulk-release-title-block">
					<span class="bulk-release-title">Release @selectedForRelease.Count @(selectedForRelease.Count == 1 ? "Beast" : "Beasts")?</span>
					<span class="bulk-release-subtitle">This action cannot be undone</span>
				</div>
			</div>

			<!-- Beast cards being released — show first 3 + "more" pill so
			     the popup stays a fixed compact size regardless of selection
			     count. Players don't need to see all N beasts to confirm,
			     they need to understand what kind of release this is. -->
			<div class="bulk-release-list">
				@foreach (var monsterId in selectedForRelease.Take(3))
				{
					var monster = MonsterManager.Instance?.OwnedMonsters?.FirstOrDefault(m => m.Id == monsterId);
					if (monster != null)
					{
						var species = MonsterManager.Instance?.GetSpecies(monster.SpeciesId);
						var elementClass = species?.Element.ToString().ToLower() ?? "neutral";
						<div class="bulk-release-card @($"element-{elementClass}")">
							<div class="bulk-release-card-portrait" style="background-image: url(@(species?.IconPath ?? ""))"></div>
							<div class="bulk-release-card-info">
								<span class="bulk-release-card-name">@monster.Nickname</span>
								<div class="bulk-release-card-meta">
									<span class="bulk-release-card-level">LV @monster.Level</span>
									<img class="bulk-release-card-element" src="ui/icons/elements/element_white/@(elementClass).svg" />
								</div>
							</div>
						</div>
					}
				}
				@if (selectedForRelease.Count > 3)
				{
					<div class="bulk-release-more-pill">
						<iconify icon="lucide:more-horizontal" Size=@(14) Color="rgba(255,255,255,0.5)" />
						<span>and @(selectedForRelease.Count - 3) more</span>
					</div>
				}
			</div>

			<!-- Action buttons -->
			<div class="bulk-release-buttons">
				<button class="bulk-release-btn cancel" onclick=@CancelBulkRelease onmouseover=@(() => SoundManager.PlayHover())>
					<iconify icon="lucide:x" Size=@(16) Color="white" />
					<span>@L("ui.common.cancel")</span>
				</button>
				<button class="bulk-release-btn release" onclick=@ConfirmBulkRelease onmouseover=@(() => SoundManager.PlayHover())>
					<iconify icon="lucide:trash-2" Size=@(16) Color="white" />
					<span>Release @selectedForRelease.Count</span>
				</button>
			</div>
		</div>
	</div>
}

@code {
	// Localization helper
	private string L( string key ) => LocalizationManager.Get( key );
	private string L( string key, params object[] args ) => LocalizationManager.Get( key, args );

	public Monster SelectedMonster { get; set; }
	public Action<Monster> OnSelect { get; set; }
	private bool isDetailClosing = false;

	private string currentFilter = "all";
	private string currentSort = "power";
	private string currentRarity = "all";
	private string currentNameFilter = "";
	private bool sortAscending = false;
	private FilterBar filterBar;

	// Fusion mode — when true, the My Beasts panel acts as a fusion
	// staging UI: clicking grid cards assigns them to parent slots
	// instead of the detail sidebar, and the right sidebar shows the
	// fusion controls (parents + breed action + genes preview) instead
	// of the detail view. Mutually exclusive with isMultiSelectMode.
	private bool isFusionMode = false;

	// Breeding state (used by fusion mode)
	private Monster Parent1 = null;
	private Monster Parent2 = null;
	private int selectedForSlot = 1; // Which slot is being selected for (1 or 2)
	private string breedingFilter = "all";
	private string breedingSort = "genes";
	private string breedingRarity = "all";
	private string breedingNameFilter = "";
	private bool breedingSortAscending = false;
	private FilterBar breedingFilterBar;
	private bool showResult = false;
	private Monster breedingResult = null;

	// Fusion result metadata — captured at the moment of fusing so the
	// result reveal panel can show "roll vs expected" variance and
	// derive trait/nature inheritance sources by comparing the offspring
	// against snapshots of the two parents.
	private Monster lastFusionParent1 = null;
	private Monster lastFusionParent2 = null;
	private int lastFusionExpectedTotal = 0;
	private string lastFusionExpectedQuality = "";
	private HashSet<string> lockedGenes = new();

	// Fusion animation state
	private bool isFusionAnimating = false;
	private string fusionPhase = "";
	private float fusionAnimationStart = 0;

	// Nickname editing state
	private bool isEditingNickname = false;
	private string editingNickname = "";
	private TextEntry nicknameInput;
	// Set when the edit opens; consumed one Tick later to .Focus() the
	// TextEntry once it has actually mounted (deferred-pending pattern).
	private bool nicknameFocusPending = false;

	// One-shot card-select pulse — a border flash that fires on the clicked
	// monster card. `selectPulseVersion` increments on every click so the
	// `.pulse-@N` CSS class remounts the overlay div in the DOM; @keyframes
	// in s&box only run on first mount, so keying on the version number is
	// how we re-fire the animation on subsequent clicks. Ported from the
	// shop's `.select-pulse` pattern (see ShopPanelContent).
	private Guid? justSelectedMonsterId = null;
	private int selectPulseVersion = 0;

	// Release confirmation state
	private bool showReleaseConfirm = false;
	private Monster monsterToRelease = null;

	// Two-stage in-button confirmation. First click on FUSE flips this
	// to true and the button morphs into "CONFIRM" — second click within
	// the timeout actually fuses. Replaces the old popup confirmation.
	// Cleared when parents change, when fusion mode exits, or after the
	// auto-revert timeout (~4s) if the player walks away.
	private bool pendingFusionConfirm = false;
	private int pendingConfirmToken = 0;

	// Multi-select release state
	private bool isMultiSelectMode = false;
	private HashSet<Guid> selectedForRelease = new();
	private bool showBulkReleaseConfirm = false;
	private int lastSelectedIndex = -1;
	private bool isDragSelecting = false;

	// Journal modal state
	private bool showJournalModal = false;

	// Item picker modal state
	private bool showItemPicker = false;
	private ItemDefinition hoveredPickerItem = null;

	// Move picker state
	private bool showMovePicker = false;
	private int selectedMoveSlot = -1;

	// Track if keyboard navigation is active (vs mouse)
	private bool isKeyboardNavigationActive = false;

	// @ref handles for measuring the live grid layout. The roster grid is a
	// responsive flex-wrap, so the column count must be measured, not hardcoded.
	private Panel rosterGridRef;
	private Panel cardSizeRef;

	// ── THE LIVING VIOLET RING (grid selection cursor) ──────────────────
	// One waving #9b6cff ring wrapping the selected beast's card — the
	// menu/PawPad signature on the flat-panel recipe (no 3D lean here, so
	// no projection: Box.Rect is layout space and flat panels paint at
	// layout). Position is recomputed every Tick from live rects rather
	// than event-latched — the grid scrolls and reflows on filter changes,
	// and this panel already re-renders per frame (SpriteAnimator.
	// GlobalFrame in BuildHash) so the markup style binding costs nothing
	// extra. The ink-lean wave is imperative Style.Transform per frame —
	// repaints the ring alone, never re-renders (PawPad v4.2 law).
	private Panel gridRingRef;
	private int gridRingL, gridRingT, gridRingW = 150, gridRingH = 180;
	private bool gridRingVisible;
	private bool gridRingTight; // detail-zone hosts are small — tighter inset/radius
	private int gridRingWarm; // <2 = snap to position (no glide) while first rects land

	// 10px box inset each side; the 4px border lives in SCSS. Declared
	// width/height are CONTENT-box (s&box has no border-box), so the
	// update subtracts the 8px of border to keep the ring concentric.
	private const int GridRingInset = 10;
	// Dossier controls are small — scale the concentric gap down.
	private const int DetailRingInset = 6;

	private void UpdateGridRing()
	{
		bool wasVisible = gridRingVisible;
		gridRingVisible = false;
		gridRingTight = false;

		// STAGE ZONE — one cursor language (user mandate 2026-07-02): when
		// keyboard focus hands over to the dossier, the SAME waving ring
		// wraps the focused control there (found via the .kb-focused class
		// the markup already assigns — action slabs, move slots, glyph
		// squares, picker rows). No separate ring system.
		if ( kbFocusZone == "detail" && !showResult && !isFusionMode && detailScrollRef != null )
		{
			var focused = FindPanelByClass( detailScrollRef, "kb-focused" );
			if ( focused == null ) return;
			WrapDetailRing( focused, wasVisible );
			return;
		}

		// MOUSE PATH — the same ring serves the pointer (user call
		// 2026-07-02: "we need the liquid ring around the detail buttons
		// too"). While the cursor rests on a dossier control the ring
		// flies over and wraps it; when it leaves, the ring glides home
		// to the selected grid card below.
		if ( !showResult && !isFusionMode && detailScrollRef != null && detailScrollRef.HasHovered )
		{
			var hovered = FindHoveredRingHost( detailScrollRef );
			if ( hovered != null && WrapDetailRing( hovered, wasVisible ) )
				return;
		}

		bool want = rosterGridRef != null && !showResult
			&& (isFusionMode ? isKeyboardNavigationActive : SelectedMonster != null);
		if ( !want ) return;

		// Find the selectedMonsterIndex-th card wrapper by fresh traversal
		// (loop @refs don't exist and panel refs die on hotload). Wrappers
		// are DIRECT children of the scroll grid (scroll-container law).
		Panel target = null;
		int n = 0;
		foreach ( var c in rosterGridRef.Children )
		{
			if ( !c.HasClass( "monster-card-wrapper" ) ) continue;
			if ( n == selectedMonsterIndex ) { target = c; break; }
			n++;
		}
		if ( target == null ) return;

		var rr = Box.Rect;
		var gr = rosterGridRef.Box.Rect;
		var cr = target.Box.Rect;
		if ( rr.Width < 1f || cr.Width < 1f ) return;

		// Scroll-clip discipline: s&box never clips this root-level ring to
		// the grid viewport, so hide it once the card has scrolled far
		// enough out that the ring would draw over header/footer chrome.
		// (Keyboard scroll-follow keeps the cursor card in view, so this
		// only fires transiently during manual wheel scrolling.)
		if ( cr.Top < gr.Top - 14f || cr.Bottom > gr.Bottom + 14f ) return;

		float sc = ScaleFromScreen;
		if ( sc <= 0.01f || float.IsNaN( sc ) || float.IsInfinity( sc ) ) sc = 1f;

		gridRingL = (int)(( cr.Left - rr.Left ) * sc) - GridRingInset;
		gridRingT = (int)(( cr.Top - rr.Top ) * sc) - GridRingInset;
		gridRingW = (int)(cr.Width * sc) + GridRingInset * 2 - 8;
		gridRingH = (int)(cr.Height * sc) + GridRingInset * 2 - 8;

		gridRingVisible = true;
		if ( !wasVisible ) gridRingWarm = 0;       // re-appearing → snap first, glide after
		else if ( gridRingWarm < 2 ) gridRingWarm++;
	}

	// Wrap the ring around a dossier control (tight inset), clipped
	// against the detail scroll viewport. Shared by the kb-focus and
	// mouse-hover detail paths. Returns false if the host is off-screen
	// or not yet laid out.
	private bool WrapDetailRing( Panel host, bool wasVisible )
	{
		var rrd = Box.Rect;
		var dvr = detailScrollRef.Box.Rect;
		var fr = host.Box.Rect;
		if ( rrd.Width < 1f || fr.Width < 1f ) return false;

		// Same scroll-clip discipline, against the detail viewport.
		if ( fr.Top < dvr.Top - 10f || fr.Bottom > dvr.Bottom + 10f ) return false;

		float scd = ScaleFromScreen;
		if ( scd <= 0.01f || float.IsNaN( scd ) || float.IsInfinity( scd ) ) scd = 1f;

		// Small hosts → tighter inset + radius (.tight in SCSS).
		gridRingL = (int)(( fr.Left - rrd.Left ) * scd) - DetailRingInset;
		gridRingT = (int)(( fr.Top - rrd.Top ) * scd) - DetailRingInset;
		gridRingW = (int)(fr.Width * scd) + DetailRingInset * 2 - 8;
		gridRingH = (int)(fr.Height * scd) + DetailRingInset * 2 - 8;
		gridRingTight = true;

		gridRingVisible = true;
		if ( !wasVisible ) gridRingWarm = 0;
		else if ( gridRingWarm < 2 ) gridRingWarm++;
		return true;
	}

	// Ring-eligible dossier controls for the mouse-hover path — kept in
	// sync with the markup's .kb-focused hosts (plus picker rows/back).
	private static readonly string[] RingHostClasses =
	{
		"action-v2", "detail-diamond", "nickname-btn", "nickname-key-hint",
		"move-diamond-slot", "inline-item", "picker-back",
	};

	// Deepest hovered descendant carrying a ring-host class. HasHovered
	// is only true along the single ancestor chain under the cursor, so
	// this walk descends one path — cheap per frame. Disabled controls
	// don't earn the ring (it promises actionability).
	private static Panel FindHoveredRingHost( Panel root )
	{
		if ( root == null || !root.HasHovered ) return null;
		foreach ( var child in root.Children )
		{
			if ( child is Panel p && p.HasHovered )
			{
				var hit = FindHoveredRingHost( p );
				if ( hit != null ) return hit;
			}
		}
		if ( root.HasClass( "disabled" ) ) return null;
		foreach ( var cls in RingHostClasses )
			if ( root.HasClass( cls ) ) return root;
		return null;
	}

	// The liquid ink-lean — the menu cursor's multi-sine at the PawPad's
	// ×0.6 amplitude + out-of-phase breathing (the "reads liquid, not
	// metronome" rebalance). Imperative transform: no re-render, and this
	// is a FLAT panel so per-frame writes are cheap (the 7fps law only
	// bites inside perspective-leaned subtrees).
	private void ApplyGridRingWave()
	{
		if ( gridRingRef == null || !gridRingVisible ) return;
		float wt = Time.Now;
		float skX = ( 2.0f * MathF.Sin( wt * 2.2f ) + 0.7f * MathF.Sin( wt * 3.5f + 1.1f ) ) * 0.6f;
		float skY = ( 2.3f * MathF.Sin( wt * 1.8f + 1.9f ) + 0.9f * MathF.Sin( wt * 2.9f ) ) * 0.6f;
		float rotZ = ( 1.1f * MathF.Sin( wt * 1.0f ) + 0.5f * MathF.Sin( wt * 2.4f + 0.5f ) ) * 0.6f;
		float brX = 1f + 0.013f * MathF.Sin( wt * 1.35f + 0.7f ) + 0.006f * MathF.Sin( wt * 2.7f );
		float brY = 1f + 0.013f * MathF.Sin( wt * 1.15f + 2.6f ) + 0.006f * MathF.Sin( wt * 2.3f + 1.4f );

		var t = new PanelTransform();
		t.AddRotation( 0f, 0f, rotZ );
		t.AddSkew( skX, skY, 0f );
		t.AddScale( new Vector2( brX, brY ) );
		gridRingRef.Style.Transform = t;
	}

	// ---- Grid <-> detail-panel keyboard focus switch -------------------
	// kbFocusZone is the zone the keyboard currently drives:
	//   "grid"   — WASD/arrows move the beast grid cursor (default)
	//   "detail" — arrows move a 2D positional cursor over the detail panel
	// Tab (Score) toggles grid -> detail; Tab or Q (Menu) returns to grid.
	//
	// The detail panel has a genuine TWO-COLUMN top region, so the cursor is
	// a real 2D positional model — see DetailFocusItem + GetDetailFocusItems().
	// Each control carries (Col, Band, Sub):
	//   Col  0 = left/main column, 1 = the diamond column on the right edge
	//   Band = vertical order within that column (0 at top)
	//   Sub  = horizontal index within a band (the ACTIONS triplet, the
	//          two-wide MOVES rows). Single controls have Sub 0.
	// W/S walk a column by Band; A/D move within a band by Sub and, off the
	// edge of a band, BRIDGE between the two columns landing on the control
	// whose Band is nearest. detailFocusIndex is a flat cursor into the list.
	private string kbFocusZone = "grid";
	private int detailFocusIndex = 0;

	// Cursor into the inline picker LIST (the move-swap / item picker that
	// opens inside the detail scroll). A flat row index — W/S walk it, Space
	// activates the row, Q/Tab close the picker. Seeded to 0 when a picker
	// opens. Only meaningful while showMovePicker || showItemPicker.
	private int pickerCursorIndex = 0;

	// One keyboard-focusable control in the detail panel, with its position
	// in the 2-column / banded layout.
	private struct DetailFocusItem
	{
		public string Id;
		public int Col;   // 0 = left/main column, 1 = diamond column
		public int Band;  // vertical order within the column
		public int Sub;   // horizontal index within the band
		public DetailFocusItem( string id, int col, int band, int sub )
		{ Id = id; Col = col; Band = band; Sub = sub; }
	}

	// @ref to the detail scroll container. The focused control itself is
	// found by walking this container's descendants for the `.kb-focused`
	// class (s&box has no native scroll-into-view, so we compute the target
	// offset from Box.Rect). Avoids needing a separate @ref per control.
	private Panel detailScrollRef;
	// Set true when the cursor moves; Tick() consumes it to run the
	// scroll-into-view AFTER layout has positioned the new focused element.
	private bool detailScrollFollowPending = false;

	// Recursively find the first descendant carrying `className`.
	private static Panel FindPanelByClass( Panel root, string className )
	{
		if ( root == null ) return null;
		if ( root.HasClass( className ) ) return root;
		foreach ( var child in root.Children )
		{
			if ( child is Panel p )
			{
				var hit = FindPanelByClass( p, className );
				if ( hit != null ) return hit;
			}
		}
		return null;
	}

	// Builds the 2D positional layout of focusable controls for the current
	// SelectedMonster. Two columns:
	//
	//   LEFT column (Col 0) — top-to-bottom:
	//     Band 0  nick                    (the nickname-edit pencil)
	//     Band 1  evolve                  (full-width, only when evolvable)
	//     Band 2  item / fuse / release   (the ACTIONS triplet, Sub 0/1/2)
	//     Band 3  move-0 / move-1         (MOVES row 1, Sub 0/1)
	//     Band 4  move-2 / move-3         (MOVES row 2, Sub 0/1)
	//
	//   DIAMOND column (Col 1) — the vertical stack on the panel's top-right:
	//     Band 0  diamond-showoff
	//     Band 1  diamond-journal         (only when the beast has a journal)
	//     Band 2  diamond-fav
	//
	// Conditional controls (Evolve, Journal) are simply omitted when not
	// rendered — the navigation methods operate on whatever is in the list,
	// so the cursor never lands on a control that isn't on screen. Bands are
	// NOT renumbered when Evolve is absent: the cross-column "nearest band"
	// mapping still works because it picks the closest available band.
	private List<DetailFocusItem> GetDetailFocusItems()
	{
		var items = new List<DetailFocusItem>();
		if ( SelectedMonster == null ) return items;

		// --- LEFT / MAIN column (Col 0) ---
		// Nickname pencil — hidden while editing (the TextEntry owns the keys).
		if ( !isEditingNickname )
			items.Add( new DetailFocusItem( "nick", 0, 0, 0 ) );

		// Evolve — own band, only when the beast can evolve.
		if ( CanSelectedMonsterEvolve() )
			items.Add( new DetailFocusItem( "evolve", 0, 1, 0 ) );

		// ACTIONS triplet — one band, three horizontal Subs.
		items.Add( new DetailFocusItem( "item",    0, 2, 0 ) );
		items.Add( new DetailFocusItem( "fuse",    0, 2, 1 ) );
		items.Add( new DetailFocusItem( "release", 0, 2, 2 ) );

		// MOVES 2x2 — two bands, two Subs each. All four slots always render
		// (empty slots included — clicking one opens the learn-move picker).
		items.Add( new DetailFocusItem( "move-0", 0, 3, 0 ) );
		items.Add( new DetailFocusItem( "move-1", 0, 3, 1 ) );
		items.Add( new DetailFocusItem( "move-2", 0, 4, 0 ) );
		items.Add( new DetailFocusItem( "move-3", 0, 4, 1 ) );

		// --- DIAMOND column (Col 1) ---
		items.Add( new DetailFocusItem( "diamond-showoff", 1, 0, 0 ) );
		if ( SelectedMonster.Journal != null && SelectedMonster.Journal.Count > 0 )
			items.Add( new DetailFocusItem( "diamond-journal", 1, 1, 0 ) );
		items.Add( new DetailFocusItem( "diamond-fav", 1, 2, 0 ) );

		return items;
	}

	// The control id currently under the detail-panel keyboard cursor, or
	// null if the detail zone isn't focused. Clamps the flat cursor to the
	// live item list so a control disappearing (e.g. Evolve after evolving)
	// never leaves the cursor pointing at nothing.
	private string GetFocusedDetailControl()
	{
		if ( kbFocusZone != "detail" || isFusionMode ) return null;
		var items = GetDetailFocusItems();
		if ( items.Count == 0 ) return null;
		int i = Math.Clamp( detailFocusIndex, 0, items.Count - 1 );
		return items[i].Id;
	}

	// Markup helper — true when `id` is the focused detail control.
	private bool IsDetailControlFocused( string id )
		=> GetFocusedDetailControl() == id;

	// Move keyboard focus to the detail panel (if a beast is selected).
	// Cursor starts on the first item (the nickname pencil, top-left).
	private void FocusDetailZone()
	{
		if ( SelectedMonster == null || isFusionMode ) return;
		kbFocusZone = "detail";
		detailFocusIndex = 0;
		detailScrollFollowPending = true;
		SoundManager.PlayClick();
	}

	// Return keyboard focus to the grid.
	private void FocusGridZone()
	{
		kbFocusZone = "grid";
		isKeyboardNavigationActive = true;
		SoundManager.PlayBack();
	}

	// Clickable affordance toggles between the two zones (mouse parity).
	private void ToggleKbFocusZone()
	{
		if ( kbFocusZone == "grid" ) FocusDetailZone();
		else FocusGridZone();
	}

	// Commit a cursor move to the item at `items[newIndex]`. No-ops (and stays
	// silent) when the move didn't change anything; otherwise plays the hover
	// blip and queues the scroll-into-view.
	private void SetDetailFocus( int newIndex )
	{
		if ( newIndex < 0 || newIndex == detailFocusIndex ) return;
		detailFocusIndex = newIndex;
		detailScrollFollowPending = true;
		SoundManager.PlayHover();
	}

	// Place the detail cursor on the control with the given id (silent — used
	// when returning from a sub-mode like nickname edit, not for normal nav).
	// Queues a scroll-into-view so the control is shown if it was off-screen.
	private void FocusDetailControl( string id )
	{
		var items = GetDetailFocusItems();
		for ( int i = 0; i < items.Count; i++ )
		{
			if ( items[i].Id == id )
			{
				detailFocusIndex = i;
				detailScrollFollowPending = true;
				return;
			}
		}
	}

	// --- 2D positional navigation over the two-column detail layout ---
	// W/S walk the CURRENT column by Band (keeping Sub where the band allows).
	// A/D move within a band by Sub and, off the edge of a band, BRIDGE to
	// the other column landing on the control whose Band is nearest.

	// W / Up — previous Band in the same column, nearest Sub. If that steps
	// off the TOP of the diamond column, bridge into the left/main column at
	// the nearest band so the diamond column isn't a dead-end at its top.
	private void MoveDetailUp()
	{
		var items = GetDetailFocusItems();
		if ( items.Count == 0 ) return;
		var cur = items[Math.Clamp( detailFocusIndex, 0, items.Count - 1 )];
		int step = FindBandStep( items, cur, -1 );
		if ( step < 0 && cur.Col == 1 )
			step = FindNearestInColumn( items, 0, cur.Band, true ); // bridge to left col, rightmost on tie
		SetDetailFocus( step );
	}

	// S / Down — next Band in the same column, nearest Sub. If that steps off
	// the BOTTOM of the diamond column, bridge into the left/main column at
	// the nearest band — landing on its RIGHTMOST control (closest to the
	// diamonds), e.g. Favorite -> ACTIONS row -> Release.
	private void MoveDetailDown()
	{
		var items = GetDetailFocusItems();
		if ( items.Count == 0 ) return;
		var cur = items[Math.Clamp( detailFocusIndex, 0, items.Count - 1 )];
		int step = FindBandStep( items, cur, 1 );
		if ( step < 0 && cur.Col == 1 )
			step = FindNearestInColumn( items, 0, cur.Band, true ); // bridge to left col, rightmost on tie
		SetDetailFocus( step );
	}

	// A / Left — step left within the band; off the left edge of the diamond
	// column, bridge to the nearest-Band control in the left/main column.
	private void MoveDetailLeft()
	{
		var items = GetDetailFocusItems();
		if ( items.Count == 0 ) return;
		var cur = items[Math.Clamp( detailFocusIndex, 0, items.Count - 1 )];

		// Within-band step left (the ACTIONS triplet / a MOVES row).
		int within = FindSubStep( items, cur, -1 );
		if ( within >= 0 ) { SetDetailFocus( within ); return; }

		// At the band's left edge: from the diamond column, cross to left col.
		// Land on the leftmost control of the nearest band (preferRightmost
		// false) — A reads as "go to the start of the row over there".
		if ( cur.Col == 1 )
			SetDetailFocus( FindNearestInColumn( items, 0, cur.Band, false ) );
	}

	// D / Right — step right within the band; off the right edge of the left
	// column, bridge to the nearest-Band diamond.
	private void MoveDetailRight()
	{
		var items = GetDetailFocusItems();
		if ( items.Count == 0 ) return;
		var cur = items[Math.Clamp( detailFocusIndex, 0, items.Count - 1 )];

		// Within-band step right (the ACTIONS triplet / a MOVES row).
		int within = FindSubStep( items, cur, 1 );
		if ( within >= 0 ) { SetDetailFocus( within ); return; }

		// At the band's right edge: from the left column, cross to diamonds.
		// The diamond column is single-Sub, so the tie preference is moot.
		if ( cur.Col == 0 )
			SetDetailFocus( FindNearestInColumn( items, 1, cur.Band, false ) );
	}

	// Index of the item one Sub-step (dir = -1 / +1) from `cur` within the
	// same Col+Band, or -1 if none (cur is at the band edge / band is 1-wide).
	private int FindSubStep( List<DetailFocusItem> items, DetailFocusItem cur, int dir )
	{
		int wantSub = cur.Sub + dir;
		for ( int i = 0; i < items.Count; i++ )
		{
			var it = items[i];
			if ( it.Col == cur.Col && it.Band == cur.Band && it.Sub == wantSub )
				return i;
		}
		return -1;
	}

	// Index of the control to land on when stepping one Band (dir = -1 / +1)
	// within `cur`'s column. Picks the next band that actually has controls
	// (so a missing Evolve band is skipped), and within that band the Sub
	// closest to the current Sub. Returns -1 if cur is already at the column
	// edge in that direction.
	private int FindBandStep( List<DetailFocusItem> items, DetailFocusItem cur, int dir )
	{
		int bestBand = -1;
		for ( int i = 0; i < items.Count; i++ )
		{
			var it = items[i];
			if ( it.Col != cur.Col ) continue;
			if ( dir > 0 && it.Band > cur.Band )
			{
				if ( bestBand < 0 || it.Band < bestBand ) bestBand = it.Band;
			}
			else if ( dir < 0 && it.Band < cur.Band )
			{
				if ( bestBand < 0 || it.Band > bestBand ) bestBand = it.Band;
			}
		}
		if ( bestBand < 0 ) return -1; // at column edge
		return FindNearestSubInBand( items, cur.Col, bestBand, cur.Sub );
	}

	// Index of the item in (col, band) whose Sub is closest to `wantSub`.
	private int FindNearestSubInBand( List<DetailFocusItem> items, int col, int band, int wantSub )
	{
		int best = -1, bestDist = int.MaxValue;
		for ( int i = 0; i < items.Count; i++ )
		{
			var it = items[i];
			if ( it.Col != col || it.Band != band ) continue;
			int d = Math.Abs( it.Sub - wantSub );
			if ( d < bestDist ) { bestDist = d; best = i; }
		}
		return best;
	}

	// Index of the control in `col` whose Band is closest to `wantBand` —
	// used to BRIDGE between the two columns.
	//   preferRightmost = false : on a Band tie, the leftmost (lowest-Sub)
	//     control wins. Used by A (diamond -> left column) so the cursor
	//     lands at the start of the row it crosses into.
	//   preferRightmost = true  : on a Band tie, the rightmost (highest-Sub)
	//     control wins. Used by W/S off the ends of the diamond column so the
	//     cursor lands on the control nearest the diamonds it came from.
	private int FindNearestInColumn( List<DetailFocusItem> items, int col, int wantBand, bool preferRightmost )
	{
		int best = -1, bestDist = int.MaxValue;
		for ( int i = 0; i < items.Count; i++ )
		{
			var it = items[i];
			if ( it.Col != col ) continue;
			int d = Math.Abs( it.Band - wantBand );
			bool tieWins = d == bestDist && best >= 0
				&& ( preferRightmost ? it.Sub > items[best].Sub : it.Sub < items[best].Sub );
			if ( d < bestDist || tieWins )
			{
				bestDist = d; best = i;
			}
		}
		return best;
	}

	// Activate the control under the detail cursor — dispatches to the same
	// handler the control's onclick uses, so keyboard and mouse are identical.
	private void ActivateFocusedDetailControl()
	{
		var id = GetFocusedDetailControl();
		if ( string.IsNullOrEmpty( id ) ) return;
		switch ( id )
		{
			case "nick": StartNicknameEdit(); break;
			case "diamond-showoff": ShowOffBeast(); break;
			case "diamond-journal": OpenJournal(); break;
			case "diamond-fav": ToggleFavorite(); break;
			case "evolve":
				if ( CanSelectedMonsterEvolve() ) OnEvolveClicked();
				else SoundManager.PlayDeny();
				break;
			case "item": OpenItemPicker(); break;
			case "fuse": OnBreedFromDetail(); break;
			case "release":
				if ( CanReleaseMonster() ) OnReleaseClicked();
				else SoundManager.PlayDeny();
				break;
			case "move-0": OpenMoveSwap( 0 ); break;
			case "move-1": OpenMoveSwap( 1 ); break;
			case "move-2": OpenMoveSwap( 2 ); break;
			case "move-3": OpenMoveSwap( 3 ); break;
		}
	}

	// True when the detail cursor is on the LAST navigable control — the
	// bottom move row (the highest Band in the left/main column). Used by
	// scroll-follow: on the last control, scroll all the way to the bottom
	// so the display-only TRAITS section below the moves comes into view
	// (traits are never a focus target, so scroll is the only way to see
	// them). Not relevant while a picker is open.
	private bool IsFocusedDetailControlLast()
	{
		if ( showItemPicker || showMovePicker ) return false;
		var items = GetDetailFocusItems();
		if ( items.Count == 0 ) return false;
		var cur = items[Math.Clamp( detailFocusIndex, 0, items.Count - 1 )];
		if ( cur.Col != 0 ) return false;
		int maxLeftBand = 0;
		foreach ( var it in items )
			if ( it.Col == 0 && it.Band > maxLeftBand ) maxLeftBand = it.Band;
		return cur.Band == maxLeftBand;
	}

	// Scroll the detail panel so the currently-focused control is fully
	// visible. s&box has no scroll-into-view; we compute the target offset
	// from screen-space Box.Rect. Called from Tick() one frame AFTER the
	// cursor moved, so layout has positioned the new focused element.
	private void ScrollFocusedDetailIntoView()
	{
		if ( detailScrollRef == null ) return;
		var focused = FindPanelByClass( detailScrollRef, "kb-focused" );
		if ( focused == null ) return;

		var view = detailScrollRef.Box.Rect;
		var ctrl = focused.Box.Rect;
		if ( view.Height <= 0f || ctrl.Height <= 0f ) return;

		float curOff = detailScrollRef.ScrollOffset.y;

		// Special case: cursor on the LAST navigable control (bottom move
		// row). The TRAITS section sits below it and is display-only — never
		// focusable — so the only way a keyboard player ever sees it is for
		// the scroll to go past the moves. Jump straight to the content
		// bottom so everything beneath the last move (the traits) is shown.
		if ( IsFocusedDetailControlLast() )
		{
			float bottomOff = Math.Max( 0f, detailScrollRef.ScrollSize.y );
			if ( Math.Abs( bottomOff - curOff ) > 0.5f )
				detailScrollRef.ScrollOffset = new Vector2( detailScrollRef.ScrollOffset.x, bottomOff );
			return;
		}

		// Control top/bottom in the scroll container's content space.
		float ctrlTop = ctrl.Top - view.Top + curOff;
		float ctrlBottom = ctrlTop + ctrl.Height;

		const float margin = 24f; // keep a little breathing room around the control
		float newOff = curOff;
		if ( ctrlTop - margin < curOff )
			newOff = ctrlTop - margin;                       // control above viewport
		else if ( ctrlBottom + margin > curOff + view.Height )
			newOff = ctrlBottom + margin - view.Height;       // control below viewport

		newOff = Math.Max( 0f, newOff );
		if ( Math.Abs( newOff - curOff ) > 0.5f )
			detailScrollRef.ScrollOffset = new Vector2( detailScrollRef.ScrollOffset.x, newOff );
	}

	// Track which card is being hovered (to prevent selected card from animating when hovering another)
	private Guid? hoveredMonsterId = null;

	// Evolution animation state
	private bool isEvolving = false;
	private string evolutionPhase = ""; // "shake", "glow", "transform", "burst"
	private string evolvedIconPath = "";

	// Public accessor for GameHUD to determine help category
	public bool IsFusionMode => isFusionMode;

	// Set by BreedingPanel's "VIEW BEAST" button — Tick() picks it up and selects the monster
	public static Guid PendingFocusMonsterId = Guid.Empty;

	private int GetMonsterCount()
	{
		return MonsterManager.Instance?.OwnedMonsters?.Count ?? 0;
	}


	private int GetMaxMonsters()
	{
		return MonsterManager.Instance?.MaxMonsters ?? 50;
	}

	private List<Monster> GetFilteredMonsters()
	{
		var monsters = MonsterManager.Instance?.OwnedMonsters ?? new List<Monster>();

		// Apply element filter
		if (currentFilter != "all")
		{
			var elementType = currentFilter switch
			{
				"fire" => ElementType.Fire,
				"water" => ElementType.Water,
				"earth" => ElementType.Earth,
				"wind" => ElementType.Wind,
				"electric" => ElementType.Electric,
				"ice" => ElementType.Ice,
				"nature" => ElementType.Nature,
				"metal" => ElementType.Metal,
				"shadow" => ElementType.Shadow,
				"spirit" => ElementType.Spirit,
				"neutral" => ElementType.Neutral,
				_ => ElementType.Neutral
			};

			monsters = monsters.Where(m =>
			{
				var species = MonsterManager.Instance?.GetSpecies(m.SpeciesId);
				return species?.Element == elementType;
			}).ToList();
		}

		// Apply rarity filter
		if (currentRarity != "all")
		{
			var rarityType = currentRarity switch
			{
				"common" => Rarity.Common,
				"uncommon" => Rarity.Uncommon,
				"rare" => Rarity.Rare,
				"epic" => Rarity.Epic,
				"legendary" => Rarity.Legendary,
				"mythic" => Rarity.Mythic,
				_ => Rarity.Common
			};

			monsters = monsters.Where(m =>
			{
				var species = MonsterManager.Instance?.GetSpecies(m.SpeciesId);
				return species?.BaseRarity == rarityType;
			}).ToList();
		}

		// Apply name filter (if searching by name)
		if (currentSort == "name" && !string.IsNullOrEmpty(currentNameFilter))
		{
			monsters = monsters.Where(m =>
			{
				var species = MonsterManager.Instance?.GetSpecies(m.SpeciesId);
				return species?.Name?.Equals(currentNameFilter, StringComparison.OrdinalIgnoreCase) == true ||
					   m.Nickname?.Equals(currentNameFilter, StringComparison.OrdinalIgnoreCase) == true;
			}).ToList();
		}

		// Apply sort (default is descending/high-to-low)
		monsters = currentSort switch
		{
			"genes" => sortAscending
				? monsters.OrderBy(m => GetMonsterTotalGenes(m)).ToList()
				: monsters.OrderByDescending(m => GetMonsterTotalGenes(m)).ToList(),
			"power" => sortAscending
				? monsters.OrderBy(m => m.PowerRating).ToList()
				: monsters.OrderByDescending(m => m.PowerRating).ToList(),
			"level" => sortAscending
				? monsters.OrderBy(m => m.Level).ToList()
				: monsters.OrderByDescending(m => m.Level).ToList(),
			"recent" => sortAscending
				? monsters.OrderBy(m => m.CaughtAt).ToList()
				: monsters.OrderByDescending(m => m.CaughtAt).ToList(),
			"rarity" => sortAscending
				? monsters.OrderBy(m => {
					var species = MonsterManager.Instance?.GetSpecies(m.SpeciesId);
					return (int)(species?.BaseRarity ?? Rarity.Common);
				}).ToList()
				: monsters.OrderByDescending(m => {
					var species = MonsterManager.Instance?.GetSpecies(m.SpeciesId);
					return (int)(species?.BaseRarity ?? Rarity.Common);
				}).ToList(),
			"basestats" => sortAscending
				? monsters.OrderBy(m => {
					var species = MonsterManager.Instance?.GetSpecies(m.SpeciesId);
					if (species == null) return 0;
					return species.BaseHP + species.BaseATK + species.BaseDEF + species.BaseSpA + species.BaseSpD + species.BaseSPD;
				}).ToList()
				: monsters.OrderByDescending(m => {
					var species = MonsterManager.Instance?.GetSpecies(m.SpeciesId);
					if (species == null) return 0;
					return species.BaseHP + species.BaseATK + species.BaseDEF + species.BaseSpA + species.BaseSpD + species.BaseSPD;
				}).ToList(),
			"fav" => sortAscending
				? monsters.OrderBy(m => m.IsFavorite).ThenBy(m => m.PowerRating).ToList()
				: monsters.OrderByDescending(m => m.IsFavorite).ThenByDescending(m => m.PowerRating).ToList(),
			"beastiary" => sortAscending
				? monsters.OrderByDescending(m => {
					var species = MonsterManager.Instance?.GetSpecies(m.SpeciesId);
					return species?.BeastiaryNumber ?? 9999;
				}).ToList()
				: monsters.OrderBy(m => {
					var species = MonsterManager.Instance?.GetSpecies(m.SpeciesId);
					return species?.BeastiaryNumber ?? 9999;
				}).ToList(),
			"name" => sortAscending
				? monsters.OrderByDescending(m => m.Nickname ?? MonsterManager.Instance?.GetSpecies(m.SpeciesId)?.Name ?? "").ToList()
				: monsters.OrderBy(m => m.Nickname ?? MonsterManager.Instance?.GetSpecies(m.SpeciesId)?.Name ?? "").ToList(),
			_ => monsters
		};

		return monsters;
	}

