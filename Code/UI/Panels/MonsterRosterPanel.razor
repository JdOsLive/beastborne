	// Keyboard paging for read-only facts content (journal W/S). Clamped;
	// silent when already at an end.
	private void NudgeFactsScroll( float dy )
	{
		if ( factsScrollRef == null ) return;
		float max = Math.Max( 0f, factsScrollRef.ScrollSize.y );
		float cur = factsScrollRef.ScrollOffset.y;
		float next = Math.Clamp( cur + dy, 0f, max );
		if ( Math.Abs( next - cur ) < 0.5f ) return;
		factsScrollRef.ScrollOffset = new Vector2( factsScrollRef.ScrollOffset.x, next );
		SoundManager.PlayHover();
	}

