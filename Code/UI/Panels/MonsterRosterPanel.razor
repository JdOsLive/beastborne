	private int GetMonsterTotalGenes(Monster m)
	{
		if (m?.Genetics == null) return 0;
		return m.Genetics.HPGene + m.Genetics.ATKGene + m.Genetics.DEFGene + m.Genetics.SpAGene + m.Genetics.SpDGene + m.Genetics.SPDGene;
	}

