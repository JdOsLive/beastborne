	// ═══ 10A MILESTONE JOURNAL (2026-07-05) ══════════════════════════
	// The in-column journal shows MILESTONE registers only — the grind
	// (expedition completions, generic notes) stays in data but is
	// filtered from display; the RECORD section owns the counters.

	private class JournalMilestone
	{
		public string Kind;      // ranked | milestone | boss | rename | evo | origin
		public string Title;
		public string Sub;       // dim suffix (rename: `was "Y"`)
		public string Tag;       // register label (BOSS FELLED, EVOLUTION, ...)
		public string Date;      // formatted, "" = undated (synthetic rows)
		public string MedalIcon; // 52px medallion sprite (boss / evo current form)
		public string PreIcon;   // 40px medallion sprite (evo pre-form)
	}

	private List<JournalMilestone> GetJournalMilestones()
	{
		var rows = new List<JournalMilestone>();
		var m = SelectedMonster;
		if (m == null) return rows;

		// Synthetic max-level milestone — display-time fallback for beasts
		// that CAPPED before the AddXP write hook existed (2026-07-05).
		// Skipped when a real logged entry is present (no doubles).
		bool hasLoggedMaxLevel = m.Journal != null && m.Journal.Any(x =>
			x.Type == JournalEntryType.Milestone && x.Content != null && x.Content.Contains("max level"));
		if (m.Level >= Monster.MaxLevel && !hasLoggedMaxLevel)
		{
			rows.Add(new JournalMilestone
			{
				Kind = "milestone",
				Title = $"Reached max level — LV {Monster.MaxLevel}",
				Tag = "MILESTONE",
				Date = ""
			});
		}

		if (m.Journal != null)
		{
			foreach (var e in m.Journal.OrderByDescending(x => x.Timestamp))
			{
				var date = e.Timestamp.ToString("MMM d, yyyy").ToUpper();
				switch (e.Type)
				{
					case JournalEntryType.BossDefeat:
						rows.Add(new JournalMilestone
						{
							Kind = "boss",
							Title = e.Content,
							Tag = "BOSS FELLED",
							Date = date,
							MedalIcon = GetJournalSpeciesIcon(e.SpeciesId)
						});
						break;

					case JournalEntryType.Evolution:
					{
						// Entries bake `Evolved from {A} into {B}! ...` — parse
						// the names to resolve BOTH forms' sprites (the entry
						// itself stores no speciesId). Fallback: current
						// species + its EvolvesFrom.
						string fromName = null, toName = null;
						var c = e.Content ?? "";
						var intoIdx = c.IndexOf(" into ");
						if (c.StartsWith("Evolved from ") && intoIdx > 0)
						{
							fromName = c.Substring(13, intoIdx - 13);
							var bangIdx = c.IndexOf('!', intoIdx);
							if (bangIdx > intoIdx)
								toName = c.Substring(intoIdx + 6, bangIdx - intoIdx - 6);
						}
						rows.Add(new JournalMilestone
						{
							Kind = "evo",
							Title = fromName != null ? $"Evolved from {fromName}!" : "Evolved!",
							Tag = "EVOLUTION",
							Date = date,
							PreIcon = FindSpeciesIconByName(fromName),
							MedalIcon = FindSpeciesIconByName(toName) ?? GetJournalSpeciesIcon(m.SpeciesId)
						});
						break;
					}

					case JournalEntryType.Milestone:
						rows.Add(new JournalMilestone
						{
							Kind = "milestone",
							Title = e.Content,
							Tag = "MILESTONE",
							Date = date
						});
						break;

					case JournalEntryType.General:
						// NAME CHANGE register — SaveNickname writes the
						// structured marker `Renamed to "X" — was "Y"`
						// (General type; a proper NameChange enum member is
						// proposed — Data is out of UI scope). Other General
						// entries are noise here.
						if (e.Content != null && e.Content.StartsWith("Renamed to "))
						{
							var sep = e.Content.IndexOf(" — ");
							rows.Add(new JournalMilestone
							{
								Kind = "rename",
								Title = sep > 0 ? e.Content.Substring(0, sep) : e.Content,
								Sub = sep > 0 ? e.Content.Substring(sep + 3) : "",
								Tag = "NAME CHANGE",
								Date = date
							});
						}
						break;

					// NameChange enum member landed 2026-07-05 — new renames
					// arrive typed; the General-prefix bridge above still
					// catches entries written before the member existed.
					case JournalEntryType.NameChange:
					{
						var sep2 = e.Content != null ? e.Content.IndexOf(" — ") : -1;
						rows.Add(new JournalMilestone
						{
							Kind = "rename",
							Title = sep2 > 0 ? e.Content.Substring(0, sep2) : (e.Content ?? "Renamed"),
							Sub = sep2 > 0 ? e.Content.Substring(sep2 + 3) : "",
							Tag = "NAME CHANGE",
							Date = date
						});
						break;
					}

					// RANKED register — live now that the enum member exists;
					// entries appear once Online Arena returns and writes them.
					case JournalEntryType.Ranked:
						rows.Add(new JournalMilestone
						{
							Kind = "ranked",
							Title = e.Content,
							Tag = "RANKED",
							Date = date
						});
						break;

					// Caught / Bred → synthesized as THE BEGINNING below;
					// Expedition → grind noise, lives in RECORD.
				}
			}
		}

		// THE BEGINNING — always the last entry, synthesized from the
		// Monster's own fields so it exists even for pre-journal beasts.
		rows.Add(new JournalMilestone
		{
			Kind = "origin",
			Title = m.IsBred ? "Born into the team" : "Caught in the wild",
			Tag = "THE BEGINNING",
			Date = m.ObtainedAt.ToString("MMM d, yyyy").ToUpper()
		});

		return rows;
	}

