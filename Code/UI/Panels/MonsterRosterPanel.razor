	// VIEW BEAST — leave the forge and land the roster ON the offspring;
	// routing through the normal selection path means the full beast-
	// switch choreography (stage pop, dais flare, cascade) plays as the
	// handoff (P5: the payoff moment gets the full entrance).
	private void OnViewFusedBeast()
	{
