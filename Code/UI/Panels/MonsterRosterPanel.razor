	// Fusion mode toggle — mutually exclusive with multi-select. When
	// entering, the right sidebar swaps from beast detail to fusion
	// staging and grid clicks assign parents instead of opening detail.
	// When exiting, parent slots and locked genes clear.
	private void ToggleFusionMode()
	{
		SoundManager.PlayClick();
		isFusionMode = !isFusionMode;
		// Fusion staging replaces the detail panel — detail-zone keyboard
		// focus is meaningless there, so always fall back to the grid.
		kbFocusZone = "grid";
		ClearPendingFusionConfirm();
		if (!isFusionMode)
		{
			Parent1 = null;
			Parent2 = null;
			selectedForSlot = 1;
			lockedGenes.Clear();
		}
		else
		{
			// Close detail panel and any conflicting modes when entering
			SelectedMonster = null;
			if (isMultiSelectMode)
			{
				isMultiSelectMode = false;
				selectedForRelease.Clear();
				lastSelectedIndex = -1;
				isDragSelecting = false;
			}
		}
	}

	private int GetMaxSelectableCount()
	{
		return (MonsterManager.Instance?.OwnedMonsters?.Count ?? 1) - 1;
	}

	private bool TrySelectMonster(Guid monsterId)
	{
		if (selectedForRelease.Contains(monsterId)) return false;
		if (selectedForRelease.Count >= GetMaxSelectableCount()) return false;
		selectedForRelease.Add(monsterId);
		return true;
	}

	private void OnMonsterCardClicked(Monster monster, int index)
	{
		if (isFusionMode)
		{
			// Fusion mode: clicking grid card assigns it to the active parent slot.
			// Reuses the same selection logic as the (now-removed) breeding view.
			OnBreedingMonsterClicked(monster);
			return;
		}

		if (isMultiSelectMode)
		{
			// Shift-click: select range from last click to this click
			if (Input.Down("run") && lastSelectedIndex >= 0)
			{
				var filteredMonsters = GetFilteredMonsters();
				int start = Math.Min(lastSelectedIndex, index);
				int end = Math.Max(lastSelectedIndex, index);
				int added = 0;

				for (int i = start; i <= end; i++)
				{
					if (i < filteredMonsters.Count)
					{
						if (TrySelectMonster(filteredMonsters[i].Id))
							added++;
					}
				}

				if (added > 0)
					SoundManager.PlaySelect();
				else
					SoundManager.PlayDeny();

				lastSelectedIndex = index;
				return;
			}

			// Normal click: toggle selection
			if (selectedForRelease.Contains(monster.Id))
			{
				selectedForRelease.Remove(monster.Id);
				SoundManager.PlayBack();
			}
			else
			{
				if (TrySelectMonster(monster.Id))
				{
					SoundManager.PlaySelect();
				}
				else
				{
					SoundManager.PlayDeny();
				}
			}

			lastSelectedIndex = index;
		}
		else
		{
			OnMonsterSelected(monster);
		}
	}

