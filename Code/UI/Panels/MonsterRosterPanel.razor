			// records don't render broken portraits after the 2026-04-21 rename.
			"forest_entrance" => "whispering_woods",
			"ember_cavern" => "ember_cavern",
			"tear_lake" => "lake_of_tears",
			_ => zoneId // Most IDs match the filename
