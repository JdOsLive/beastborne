		if (!isMultiSelectMode)
		{
			selectedForRelease.Clear();
			lastSelectedIndex = -1;
			isDragSelecting = false;
		}
		// Close detail panel when entering multi-select mode
		if (isMultiSelectMode)
		{
			SelectedMonster = null;
			// Mutually exclusive with fusion mode
			if (isFusionMode)
			{
				isFusionMode = false;
				Parent1 = null;
