	{
		editingNickname = SelectedMonster?.Nickname ?? "";
		isEditingNickname = true;
		// Auto-focus the text field so the player can type immediately with
		// no click. The TextEntry doesn't exist yet (the @if branch renders
		// it next frame), so .Focus() is deferred one Tick — same deferred-
		// pending pattern as detailScrollFollowPending.
		nicknameFocusPending = true;
		SoundManager.PlayClick();
	}

	private void OnNicknameChanged(PanelEvent e)
	{
		if (e.Target is TextEntry textEntry)
		{
			editingNickname = textEntry.Text ?? "";
		}
	}

	private void SaveNickname()
	{
		if (SelectedMonster != null && nicknameInput != null)
		{
			var newName = nicknameInput.Text?.Trim();
			if (!string.IsNullOrEmpty(newName))
			{
				var oldName = string.IsNullOrEmpty(SelectedMonster.Nickname)
					? GetSelectedSpeciesName()
					: SelectedMonster.Nickname;
				SelectedMonster.Nickname = newName;
				// 10A rename hook (2026-07-05): name changes are identity
				// milestones — the NameChange enum member landed same day, so
				// entries are properly typed. Content keeps the structured
				// `Renamed to "X" — was "Y"` form the display splits on.
				if (newName != oldName)
				{
					SelectedMonster.AddJournalEntry(
						$"Renamed to \"{newName}\" — was \"{oldName}\"",
						JournalEntryType.NameChange
					);
					MonsterManager.Instance?.SaveMonsters();
				}
			}
		}
		isEditingNickname = false;
		SoundManager.PlayClick();
	}

	private void CancelNicknameEdit()
	{
		isEditingNickname = false;
		editingNickname = "";
		SoundManager.PlayBack();
	}

