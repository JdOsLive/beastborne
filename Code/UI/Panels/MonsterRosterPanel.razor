	// Hex → rgba() string for the computed inline styles (the per-kind ×
	// per-element accent matrix would be ~60 scss rules; computed inline
	// values collapse it — always-emitted, so no ghost-style risk).
	private static string JmRgba(string hex, float a)
	{
		var r = Convert.ToInt32(hex.Substring(1, 2), 16);
		var g = Convert.ToInt32(hex.Substring(3, 2), 16);
		var b = Convert.ToInt32(hex.Substring(5, 2), 16);
		return $"rgba({r}, {g}, {b}, {a.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)})";
	}

