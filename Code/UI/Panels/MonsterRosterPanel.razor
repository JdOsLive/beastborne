	// Fusion mode toggle — mutually exclusive with multi-select. When
	// entering, the right sidebar swaps from beast detail to fusion
	// staging and grid clicks assign parents instead of opening detail.
	// When exiting, parent slots and locked genes clear.
	private void ToggleFusionMode()
	{
		SoundManager.PlayClick();
		SoundManager.PlaySwoosh();      // reactivity pass: the forge swap is a page turn too
		isFusionMode = !isFusionMode;
		// Fusion staging replaces the detail panel — detail-zone keyboard
		// focus is meaningless there, so always fall back to the grid.
		kbFocusZone = "grid";
		// A facts sub-view left open under fusion would pop back
		// unexpectedly on exit — close them all (10A journal included).
		showJournalView = false;
		showItemPicker = false;
		showMovePicker = false;
		ClearPendingFusionConfirm();
		if (!isFusionMode)
		{
			Parent1 = null;
			Parent2 = null;
			selectedForSlot = 1;
			lockedGenes.Clear();
		}
		else
		{
			// Close detail panel and any conflicting modes when entering
			SelectedMonster = null;
			if (isMultiSelectMode)
			{
				isMultiSelectMode = false;
				selectedForRelease.Clear();
				lastSelectedIndex = -1;
				isDragSelecting = false;
			}
		}
	}

	private int GetMaxSelectableCount()
	{
		return (MonsterManager.Instance?.OwnedMonsters?.Count ?? 1) - 1;
	}

	private bool TrySelectMonster(Guid monsterId)
	{
		if (selectedForRelease.Contains(monsterId)) return false;
		if (selectedForRelease.Count >= GetMaxSelectableCount()) return false;
		selectedForRelease.Add(monsterId);
		return true;
	}

	private void OnMonsterCardClicked(Monster monster, int index)
	{
		if (isFusionMode)
		{
			// Fusion mode: clicking grid card assigns it to the active parent slot.
			// Reuses the same selection logic as the (now-removed) breeding view.
			OnBreedingMonsterClicked(monster);
			return;
		}

		if (isMultiSelectMode)
		{
			// Shift-click: select range from last click to this click
			if (Input.Down("run") && lastSelectedIndex >= 0)
			{
				var filteredMonsters = GetFilteredMonsters();
				int start = Math.Min(lastSelectedIndex, index);
				int end = Math.Max(lastSelectedIndex, index);
				int added = 0;

				for (int i = start; i <= end; i++)
				{
					if (i < filteredMonsters.Count)
					{
						if (TrySelectMonster(filteredMonsters[i].Id))
							added++;
					}
				}

				if (added > 0)
					SoundManager.PlaySelect();
				else
					SoundManager.PlayDeny();

				lastSelectedIndex = index;
				return;
			}

			// Normal click: toggle selection
			if (selectedForRelease.Contains(monster.Id))
			{
				selectedForRelease.Remove(monster.Id);
				SoundManager.PlayBack();
			}
			else
			{
				if (TrySelectMonster(monster.Id))
				{
					SoundManager.PlaySelect();
				}
				else
				{
					SoundManager.PlayDeny();
				}
			}

			lastSelectedIndex = index;
		}
		else
		{
			OnMonsterSelected(monster);
		}
	}

	// Scroll offset captured at drag-select start — Tick pins the grid to
	// it while the drag is live (native drag-scroll suppression belt).
	private float dragSelectScrollLock = 0f;

	private void OnCardMouseDown(Monster monster, int index)
	{
		if (!isMultiSelectMode) return;
		isDragSelecting = true;
		dragSelectScrollLock = rosterGridRef?.ScrollOffset.y ?? 0f;
	}

	private void OnCardMouseEnter(Monster monster, int index)
	{
		// Always update hover state
		OnMouseHoverCard(monster.Id);

		// ═══ ONE-CURSOR HOVER-SELECT (2026-07-06, user: "when you switch
		// to mouse and hover over something it should switch to that" +
		// "the mouse also needs the liquid select ui thing") — in mouse
		// mode, hovering a grid card MOVES THE SELECTION (the menu's
		// OnButtonHover → selectedIndex contract): the index moves NOW so
		// the liquid ring glides immediately; the beast swap debounces
		// ~110ms (Tick commit) so a fast sweep doesn't strobe the stage
		// entrances. Hover blip only (OnMouseHoverCard) — the forward cue
		// stays on click. DISABLED in: kb mode (parked-cursor law),
		// fusion (grid hover stays the compatibility preview; picking is
		// a click), multi-select (drag-select owns the gesture), open
		// facts sub-views (a sweep must not yank the picker/journal to
		// another beast), result/evolution moments.
		if ( lastInputDevice == InputDevice.Mouse && !isFusionMode && !isMultiSelectMode
			&& !showItemPicker && !showMovePicker && !showJournalView
			&& !showResult && !isEvolving )
		{
			if ( SelectedMonster?.Id != monster.Id )
			{
				selectedMonsterIndex = index;   // ring target — glides now
				kbFocusZone = "grid";           // cursor continuity: kb resumes here
				pendingHoverSelect = monster;
				pendingHoverSelectAt = Time.Now;
			}
		}

		if (!isMultiSelectMode || !isDragSelecting) return;

		// Drag-select: select this card as we drag over it
		if (TrySelectMonster(monster.Id))
		{
			lastSelectedIndex = index;
		}
	}

	// Hover-select debounce — the beast under the cursor commits to
	// SelectedMonster after the dwell (Tick consumes). Cleared on kb
	// entry; clicks supersede it (commit immediately in OnMonsterSelected).
	private Monster pendingHoverSelect = null;
	private float pendingHoverSelectAt = 0f;

	private void CommitPendingHoverSelect()
	{
		if ( pendingHoverSelect == null ) return;
		if ( Time.Now - pendingHoverSelectAt < 0.11f ) return;
		var target = pendingHoverSelect;
		pendingHoverSelect = null;
		// Re-check the guards — mode/state may have shifted during the dwell.
		if ( lastInputDevice != InputDevice.Mouse || isFusionMode || isMultiSelectMode
			|| showItemPicker || showMovePicker || showJournalView
			|| showResult || isEvolving ) return;
		if ( SelectedMonster?.Id == target.Id ) return;
		SelectedMonster = target;
		isDetailClosing = false;
		isEditingNickname = false;
		// stageRevVersion bumps via Tick's edge-detect — stage pop, dais
		// flare, badge re-stamps and the facts cascade replay (accepted:
		// that IS the "switch to that" ask; the dwell keeps sweeps calm).
	}

	private void OnDragSelectEnd()
	{
		isDragSelecting = false;
	}

	private void OnReleaseSelectedClicked()
	{
		if (selectedForRelease.Count == 0)
		{
			SoundManager.PlayDeny();
			return;
		}

		showBulkReleaseConfirm = true;
		releaseKbCursor = 0; // destructive modals seed on CANCEL (2026-07-06)
		SoundManager.PlayClick();
	}

	private void CancelBulkRelease()
	{
		showBulkReleaseConfirm = false;
		SoundManager.PlayBack();
	}

	private async void ConfirmBulkRelease()
	{
		if (selectedForRelease.Count == 0) return;
		var _relIds = selectedForRelease.ToList();

		// P5 beat (multi): modal drops, every marked card fades together
		// (~0.18s), then the release commits and the grid reflows.
		showBulkReleaseConfirm = false;
		foreach (var id in _relIds) releasingIds.Add(id);
		SoundManager.PlayClick();
		StateHasChanged();
		await GameTask.DelaySeconds(0.18f);
		foreach (var id in _relIds) releasingIds.Remove(id);

		int released = MonsterManager.Instance?.ReleaseMonsters(_relIds) ?? 0;
		if (released > 0) SoundManager.PlaySuccess();

		// Reset multi-select state
		selectedForRelease.Clear();
		isMultiSelectMode = false;
		lastSelectedIndex = -1;
		isDragSelecting = false;
		SelectedMonster = null;
	}

