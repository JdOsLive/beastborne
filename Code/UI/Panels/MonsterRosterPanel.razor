	private List<string> GetMonsterNames()
	{
		var monsters = MonsterManager.Instance?.OwnedMonsters ?? new List<Monster>();
		var names = new HashSet<string>();

		foreach (var monster in monsters)
		{
			// Add nickname if it exists
			if (!string.IsNullOrEmpty(monster.Nickname))
				names.Add(monster.Nickname);

			// Add species name
			var species = MonsterManager.Instance?.GetSpecies(monster.SpeciesId);
			if (species != null && !string.IsNullOrEmpty(species.Name))
				names.Add(species.Name);
		}

		return names.OrderBy(n => n).ToList();
	}

	private void OnMonsterSelected(Monster monster)
	{
		if (SelectedMonster?.Id == monster.Id)
		{
			// ONE-CURSOR (2026-07-06): hover-select means the card under
			// the cursor is ALWAYS already selected by click time — the
			// old toggle would close the detail on every click. Click now
			// AFFIRMS: forward cue + select pulse, idempotent.
			SoundManager.PlayForward();
			justSelectedMonsterId = monster.Id;
			selectPulseVersion++;
			pendingHoverSelect = null; // click supersedes the dwell
			return;
		}
		pendingHoverSelect = null; // click commits immediately
		SoundManager.PlayForward();
		SelectedMonster = monster;
		isDetailClosing = false;
		isEditingNickname = false;

		// One-shot card-select pulse — keyed on selectPulseVersion so the
		// overlay div remounts each click, re-firing the @keyframes (s&box
		// quirk: keyframes only play on initial DOM mount). Pattern lifted
		// from ShopPanelContent.
		justSelectedMonsterId = monster.Id;
		selectPulseVersion++;

		// Sync keyboard index with mouse selection to prevent both showing as selected
		var monsters = GetFilteredMonsters();
		var index = monsters.FindIndex(m => m.Id == monster.Id);
		if (index >= 0)
		{
			selectedMonsterIndex = index;
		}

		OnSelect?.Invoke(monster);
	}

	private void OnPanelClicked()
	{
		// When user clicks with mouse, ensure we're in panel mode (not tab navigation)
		GameHUD.EnterPanel();
	}

	private void OnMouseHoverCard(Guid monsterId)
	{
		// KB-MODE GUARD (2026-07-06, deliberate deviation from "flip on
		// onmouseover"): keyboard scroll-follow slides cards UNDER a
		// parked cursor, firing SYNTHETIC onmouseover — honoring those
		// would yank the device back to mouse mid-keyboard (and blip the
		// hover sound per scrolled row). Real mouse motion flips the mode
		// via the root onmousemove FIRST; hover events are only honored
		// in mouse mode.
		if ( lastInputDevice == InputDevice.Keyboard ) return;
		if ( hoveredMonsterId == monsterId ) return;
		hoveredMonsterId = monsterId;
		SoundManager.PlayHover();
		StateHasChanged();
	}

	private void OnMouseLeaveCard()
	{
		// Only update if we were actually hovering something
		if (hoveredMonsterId == null) return;

		hoveredMonsterId = null;
		StateHasChanged();
	}

	private int GetEmptySlotCount(int currentCount)
	{
		// Show all remaining slots up to capacity
		int maxCapacity = GetMaxMonsters();
		int remainingSlots = maxCapacity - currentCount;
		return Math.Max(0, remainingSlots);
	}

