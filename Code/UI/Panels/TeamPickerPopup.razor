	private void OnHover( string key )
	{
		if ( _hoveredKey == key ) return;
		_hoveredKey = key;
		SoundManager.PlayHover();
	}

	private void OnCardHover( Guid id )
	{
		if ( _hoveredCardId == id ) return;
		_hoveredCardId = id;
	}

	/// <summary>The beast the FACTS column describes: the hovered card, else
	/// the keyboard card. Hover == focus (DOC-5 #6); a keyboard move clears
	/// the hover so the two never fight. LANE: input — device-mode gating.</summary>
	private Monster GetFocusedBeast( List<Monster> roster )
	{
		if ( roster == null || roster.Count == 0 ) return null;
		if ( _hoveredCardId.HasValue )
		{
			var h = roster.FirstOrDefault( m => m.Id == _hoveredCardId.Value );
			if ( h != null ) return h;
		}
		return roster[Math.Clamp( _kbIndex, 0, roster.Count - 1 )];
	}

	// LANE: input — the header cursor graph (ELEMENT · SORT · dir · BACK).
	// The FilterBar calls this on A/D from an OPEN menu; the Bag's
	// OnFilterBarSideStep (InventoryPanel.razor:1872) is the recipe.
	private void OnFilterBarSideStep( Panel trigger, int dir ) { }

	// Mouse wheel — scales the hovered slot's sprite when in slot-edit mode.
	public override void OnMouseWheel( Vector2 delta )
	{
		if ( ShowSlotEditor && !string.IsNullOrEmpty( _slotEditTestSpeciesId ) && !string.IsNullOrEmpty( _slotEditHoveredId ) )
		{
			var prev = _slotArtOverrides.TryGetValue( _slotEditHoveredId, out var ov )
				? ov
				: GetSlotArtFallback( _slotEditHoveredId );
			float newScale = Math.Clamp( prev.Scale + delta.y * 0.05f, 0.3f, 3.0f );
			_slotArtOverrides[_slotEditHoveredId] = (newScale, prev.OffX, prev.OffY);
			PersistSlotArtToDisk();
			StateHasChanged();
			return;
		}
		base.OnMouseWheel( delta );
	}

	protected override void OnAfterTreeRender( bool firstTime )
	{
		if ( firstTime )
		{
			Instance = this;
			if ( !_slotArtLoaded )
			{
				LoadSavedSlotArt();
				_slotArtLoaded = true;
			}
			// If Show(id) was called before this panel mounted (e.g. ExpeditionPanel
			// triggered "Embark Again" → WorldMap swapped in → picker constructed
			// AFTER the Show call), the static flags are already set. Finish the
			// pre-fill now that the instance exists.
			if ( IsVisible && !string.IsNullOrEmpty( PendingExpeditionId ) )
			{
				PreFillTeam( PendingExpeditionId );
			}
		}
	}

