	private void OnElementChanged( string e ) { _currentFilter = e; SoundManager.PlayClick(); }
	private void OnSortChanged( string s ) { _currentSort = s; SoundManager.PlayClick(); }
	private void OnRarityChanged( string r ) { _currentRarity = r; SoundManager.PlayClick(); }
	private void OnNameFilterChanged( string n ) { _currentNameFilter = n ?? ""; }
	private void OnSortDirectionChanged( bool asc ) { _sortAscending = asc; SoundManager.PlayClick(); }

	private List<string> GetMonsterNames()
	{
		var mm = MonsterManager.Instance;
		if ( mm == null ) return new();
		return mm.OwnedMonsters
			.Select( m => m.Nickname ?? mm.GetSpecies( m.SpeciesId )?.Name ?? m.SpeciesId )
			.Where( n => !string.IsNullOrEmpty( n ) )
			.Distinct()
			.OrderBy( n => n )
			.ToList();
	}

	// Copy of MonsterRosterPanel.GetFilteredMonsters (trimmed: no fusion/beastiary
	// modes) so filtering/sort behaviour reads identical to the roster panel.
	private List<Monster> GetFilteredMonsters()
	{
		var mm = MonsterManager.Instance;
		if ( mm == null ) return new();
		var monsters = mm.OwnedMonsters?.ToList() ?? new();

		if ( _currentFilter != "all" )
		{
			var elementType = _currentFilter switch
			{
				"fire" => ElementType.Fire,
				"water" => ElementType.Water,
				"earth" => ElementType.Earth,
				"wind" => ElementType.Wind,
				"electric" => ElementType.Electric,
				"ice" => ElementType.Ice,
				"nature" => ElementType.Nature,
				"metal" => ElementType.Metal,
				"shadow" => ElementType.Shadow,
				"spirit" => ElementType.Spirit,
				"neutral" => ElementType.Neutral,
				_ => ElementType.Neutral
			};
			monsters = monsters.Where( m => mm.GetSpecies( m.SpeciesId )?.Element == elementType ).ToList();
		}

		if ( _currentRarity != "all" )
		{
			var r = _currentRarity switch
			{
				"common" => Rarity.Common,
				"uncommon" => Rarity.Uncommon,
				"rare" => Rarity.Rare,
				"epic" => Rarity.Epic,
				"legendary" => Rarity.Legendary,
				"mythic" => Rarity.Mythic,
				_ => Rarity.Common
			};
			monsters = monsters.Where( m => mm.GetSpecies( m.SpeciesId )?.BaseRarity == r ).ToList();
		}

		if ( _currentSort == "name" && !string.IsNullOrEmpty( _currentNameFilter ) )
		{
			monsters = monsters.Where( m =>
				(mm.GetSpecies( m.SpeciesId )?.Name?.Equals( _currentNameFilter, StringComparison.OrdinalIgnoreCase ) ?? false)
				|| (m.Nickname?.Equals( _currentNameFilter, StringComparison.OrdinalIgnoreCase ) ?? false)
			).ToList();
		}

		monsters = _currentSort switch
		{
			"level" => _sortAscending ? monsters.OrderBy( m => m.Level ).ToList() : monsters.OrderByDescending( m => m.Level ).ToList(),
			"power" => _sortAscending ? monsters.OrderBy( m => m.PowerRating ).ToList() : monsters.OrderByDescending( m => m.PowerRating ).ToList(),
			"rarity" => _sortAscending
				? monsters.OrderBy( m => (int)(mm.GetSpecies( m.SpeciesId )?.BaseRarity ?? Rarity.Common) ).ToList()
				: monsters.OrderByDescending( m => (int)(mm.GetSpecies( m.SpeciesId )?.BaseRarity ?? Rarity.Common) ).ToList(),
			"recent" => _sortAscending ? monsters.OrderBy( m => m.CaughtAt ).ToList() : monsters.OrderByDescending( m => m.CaughtAt ).ToList(),
			"fav" => _sortAscending ? monsters.OrderBy( m => m.IsFavorite ).ThenBy( m => m.PowerRating ).ToList()
				: monsters.OrderByDescending( m => m.IsFavorite ).ThenByDescending( m => m.PowerRating ).ToList(),
			"name" => _sortAscending
				? monsters.OrderByDescending( m => m.Nickname ?? mm.GetSpecies( m.SpeciesId )?.Name ?? "" ).ToList()
				: monsters.OrderBy( m => m.Nickname ?? mm.GetSpecies( m.SpeciesId )?.Name ?? "" ).ToList(),
			_ => monsters
		};

		return monsters;
	}

	// ═══════════════════════════════════════════════════════════════
	// TYPE COVERAGE HINT
	// ═══════════════════════════════════════════════════════════════

	public enum TeamAdvantage { Empty, Weak, Disadvantage, Neutral, Advantage, Strong }

	/// <summary>
	/// Average effectiveness of the team's primary elements attacking into
	/// the zone's element. Labelled into rough buckets so the player gets a
	/// quick "are my types good?" read without seeing a matrix.
	/// </summary>
	private TeamAdvantage GetTeamCoverage( ElementType zoneElement )
	{
		var picks = _team.Where( m => m != null ).ToList();
		if ( picks.Count == 0 ) return TeamAdvantage.Empty;

		float total = 0f;
		foreach ( var m in picks )
		{
			var species = MonsterManager.Instance?.GetSpecies( m.SpeciesId );
			if ( species == null ) continue;

			float best = BattleAI.GetTypeEffectiveness( species.Element, zoneElement );
			if ( species.SecondaryElement.HasValue && species.SecondaryElement.Value != species.Element )
			{
				var alt = BattleAI.GetTypeEffectiveness( species.SecondaryElement.Value, zoneElement );
				if ( alt > best ) best = alt;
			}
			total += best;
		}

		float avg = total / picks.Count;
		if ( avg >= 1.9f ) return TeamAdvantage.Strong;
		if ( avg >= 1.3f ) return TeamAdvantage.Advantage;
		if ( avg >= 0.9f ) return TeamAdvantage.Neutral;
		if ( avg >= 0.6f ) return TeamAdvantage.Disadvantage;
		return TeamAdvantage.Weak;
	}

	private string GetCoverageLabel( TeamAdvantage a ) => a switch
	{
		TeamAdvantage.Strong => "STRONG ADVANTAGE",
		TeamAdvantage.Advantage => "ADVANTAGE",
		TeamAdvantage.Neutral => "NEUTRAL",
		TeamAdvantage.Disadvantage => "DISADVANTAGE",
		TeamAdvantage.Weak => "WEAK MATCHUP",
		_ => ""
	};

	private string GetCoverageClass( TeamAdvantage a ) => a switch
	{
		TeamAdvantage.Strong => "cov-strong",
		TeamAdvantage.Advantage => "cov-advantage",
		TeamAdvantage.Neutral => "cov-neutral",
		TeamAdvantage.Disadvantage => "cov-disadvantage",
		TeamAdvantage.Weak => "cov-weak",
		_ => ""
	};

	private string GetCoverageIcon( TeamAdvantage a ) => a switch
	{
		TeamAdvantage.Strong => "lucide:trending-up",
		TeamAdvantage.Advantage => "lucide:arrow-up-right",
		TeamAdvantage.Neutral => "lucide:minus",
		TeamAdvantage.Disadvantage => "lucide:arrow-down-right",
		TeamAdvantage.Weak => "lucide:trending-down",
		_ => "lucide:minus"
	};

	private string GetCoverageIconColor( TeamAdvantage a ) => a switch
	{
		TeamAdvantage.Strong => "#86efac",
		TeamAdvantage.Advantage => "#bef264",
		TeamAdvantage.Neutral => "#cbd5e1",
		TeamAdvantage.Disadvantage => "#fdba74",
