	public static void Show( string expeditionId )
	{
		PendingExpeditionId = expeditionId;
		IsVisible = true;
		if ( Instance != null )
		{
			Instance._hoveredKey = null;
			Instance._hoveredCardId = null;
			Instance._kbIndex = 0;
			Instance._hardMode = false; // difficulty re-arms per open
			Instance.PreFillTeam( expeditionId );
			Instance.NotifyTutorialIfTeamPopulated();
		}
		SoundManager.PlayPopup();
	}

	public static void Close()
	{
		IsVisible = false;
		if ( Instance != null )
		{
			Instance._hoveredKey = null;
			Instance.filterBar?.CloseAllDropdowns();
		}
		SoundManager.PlayPopdown();
	}

	public override void Tick()
	{
		base.Tick();
		if ( !IsVisible ) return;
		if ( !UIModalState.IsTopModal( "TeamPickerPopup" ) ) return;

		// LANE: input — the whole key map below is the run-0 binding kept
		// alive as a stopgap; the cursor graph (slots ⇄ grid ⇄ header ⇄
		// EMBARK, one ring) replaces it. Two changes landed here so the
		// header's R CYCLE cap tells the truth: R cycles the element (was
		// embark) and Enter embarks (was a second pick key).

		// An OPEN FilterBar menu owns W/S/Space/Q/A/D.
		if ( filterBar != null && filterBar.IsAnyDropdownOpen && filterBar.HandleKeyboard() ) return;

		// Back / close.
		if ( Input.Pressed( "Escape" ) || Input.Pressed( "Menu" ) || Input.Pressed( "run" ) )
		{
			Close();
			return;
		}

		// R = element cycle (the shown cycle key); Z/X (CyclePrev/Next) stay
		// the silent twins.
		if ( Input.Pressed( "reload" ) ) { CycleElementFilter( 1 ); return; }
		if ( Input.Pressed( "CyclePrev" ) ) { CycleElementFilter( -1 ); return; }
		if ( Input.Pressed( "CycleNext" ) ) { CycleElementFilter( 1 ); return; }

		// Enter embarks (OnEmbarkClicked self-guards on CanEmbark).
		if ( Input.Pressed( "Enter" ) )
		{
			OnEmbarkClicked();
			return;
		}

		// F = Auto-fill, C = Clear. Flashlight/View are the engine actions
		// bound to the F and C keys — reused here; GameHUD ignores them while
		// a modal is open, so there's no collision.
		if ( Input.Pressed( "Flashlight" ) ) { AutoFill(); StateHasChanged(); return; }
		if ( Input.Pressed( "View" ) ) { ClearTeam(); StateHasChanged(); return; }

		// 1 / 2 / 3 — preset slots: load if the slot holds a team, else save
		// the current team into it (deny if there's nothing to save). The
		// preset BUTTONS were cut in run 1; the keys still work.
		for ( int p = 0; p < 3; p++ )
		{
			if ( !Input.Pressed( "Slot" + ( p + 1 ) ) ) continue;
			var preset = GetPreset( p );
			bool slotHasData = preset != null && preset.MonsterIds.Count > 0;
			if ( slotHasData ) LoadPreset( p );
			else if ( _team.Any( t => t != null ) ) SavePreset( p );
			else SoundManager.PlayDeny();
			StateHasChanged();
			return;
		}

		var roster = GetFilteredMonsters();
		if ( roster.Count == 0 ) return;
		_kbIndex = Math.Clamp( _kbIndex, 0, roster.Count - 1 );

		// Space picks / un-picks the highlighted beast.
		if ( Input.Pressed( "Jump" ) )
		{
			OnRosterCardClicked( roster[_kbIndex] );
			StateHasChanged();
			return;
		}

		int prev = _kbIndex;
		if ( Input.Pressed( "Left" ) ) _kbIndex = Math.Max( 0, _kbIndex - 1 );
		else if ( Input.Pressed( "Right" ) ) _kbIndex = Math.Min( roster.Count - 1, _kbIndex + 1 );
		else if ( Input.Pressed( "Up" ) ) { if ( _kbIndex >= CARDS_PER_ROW ) _kbIndex -= CARDS_PER_ROW; }
		else if ( Input.Pressed( "Down" ) ) _kbIndex = Math.Min( roster.Count - 1, _kbIndex + CARDS_PER_ROW );

		if ( _kbIndex != prev )
		{
			SoundManager.PlayHover();
			_hoveredCardId = null; // the keyboard owns focus now (one cursor)
			// Cards are DIRECT children of the scroll grid — scroll by card index.
			UiGridScroll.ScrollIndexIntoView( pickerRosterScroll, _kbIndex, "tp-card" );
			StateHasChanged();
		}
	}

	/// <summary>
	/// Pre-fill the team with, in order of preference:
	/// 1. The last team used for this zone (from save data)
	/// 2. ExpeditionManager.SelectedTeam (persisted across in-session clicks)
	/// 3. Auto-pick: first 3 healthy beasts sorted by power
	/// All picks skip fainted beasts regardless of source.
	/// </summary>
	private void PreFillTeam( string zoneId )
	{
		_team = new() { null, null, null };
		var mm = MonsterManager.Instance;
		if ( mm == null ) return;

		// 1) Last-team-per-zone
		var lastIds = GetSaveData()?.LastTeamPerZone?.TryGetValue( zoneId, out var ids ) == true ? ids : null;
		if ( lastIds != null && lastIds.Count > 0 )
		{
			int slot = 0;
			foreach ( var id in lastIds )
			{
				if ( slot >= 3 ) break;
				var m = mm.OwnedMonsters.FirstOrDefault( x => x.Id == id );
				if ( m == null || m.CurrentHP <= 0 ) continue;
				_team[slot++] = m;
			}
			if ( _team.Any( t => t != null ) ) return;
		}

		// 2) Current SelectedTeam (alive)
		var current = ExpeditionManager.Instance?.SelectedTeam?
			.Where( m => m != null && m.CurrentHP > 0 )
			.ToList() ?? new();
		if ( current.Count > 0 )
		{
			for ( int i = 0; i < Math.Min( 3, current.Count ); i++ ) _team[i] = current[i];
			return;
		}

		// 3) Auto-pick best
		AutoFill();
	}

	/// <summary>
	/// Called after _team is populated by ANY of the PreFillTeam paths. Fires the
	/// tutorial event if at least one slot got filled — new players have a
	/// single starter that always auto-fills, never goes through the click path.
	/// </summary>
	private void NotifyTutorialIfTeamPopulated()
	{
		if ( _team.Any( t => t != null ) )
		{
			Beastborne.Core.TutorialManager.Instance?.NotifyEvent( "team.beast-added" );
		}
	}

	// ═══════════════════════════════════════════════════════════════
	// TEAM / ROSTER CLICK HANDLING
	// ═══════════════════════════════════════════════════════════════

	private void OnRosterCardClicked( Monster m )
	{
		if ( m == null || m.CurrentHP <= 0 )
		{
			SoundManager.PlayDeny();
			return;
		}

		// If already picked, un-pick (remove from team).
		int existing = _team.FindIndex( t => t?.Id == m.Id );
		if ( existing >= 0 )
		{
			_team[existing] = null;
			SoundManager.PlayClick();
			return;
		}

		// Otherwise, add to first empty slot. If full, swap into slot 0 (most
		// recent becomes slot 0; others shift). Keeps the click always useful.
		int empty = _team.FindIndex( t => t == null );
		if ( empty >= 0 )
		{
			_team[empty] = m;
		}
		else
		{
			_team[2] = _team[1];
			_team[1] = _team[0];
			_team[0] = m;
		}
		SoundManager.PlayClick();

		// Tutorial: notify that a beast was added to the team.
		Beastborne.Core.TutorialManager.Instance?.NotifyEvent( "team.beast-added" );
	}

	private void OnTeamSlotClicked( int idx )
	{
		if ( idx < 0 || idx >= _team.Count ) return;
		if ( _team[idx] == null ) return;
		// If a drop just fired on this slot, onclick will also fire (mousedown
		// and mouseup were both on this element). Suppress the default remove
		// behaviour when a drag committed here so drag-to-same-slot isn't
		// interpreted as "drag then click-to-clear."
		if ( _consumeNextClickForSlot == idx )
		{
			_consumeNextClickForSlot = null;
			return;
		}
		_team[idx] = null;
		SoundManager.PlayClick();
	}

	private int? _consumeNextClickForSlot;

	// ─── DRAG HANDLERS ─────────────────────────────────────────────

	private void OnSlotMouseDown( int idx )
	{
		if ( idx < 0 || idx >= _team.Count ) return;
		var beast = _team[idx];
		if ( beast == null ) return;
		_dragSource = beast;
		_dragFromSlot = idx;
	}

	private void OnRosterCardMouseDown( Monster m )
	{
		if ( m == null || m.CurrentHP <= 0 ) return;
		_dragSource = m;
		_dragFromSlot = null;
	}

	private void OnSlotMouseOver( int idx )
	{
		OnHover( "slot-" + idx );
		if ( _dragSource == null ) return;
		_dragHoverSlot = idx;
	}

	private void OnSlotMouseUp( int idx )
	{
		if ( _dragSource == null ) return;
		if ( idx < 0 || idx >= _team.Count )
		{
			CancelDragIfAny();
			return;
		}

		if ( _dragFromSlot.HasValue )
		{
			// Slot → slot: swap regardless of whether target is filled or empty.
			// Same-slot drag is a no-op (and onclick will fire normally).
			if ( _dragFromSlot.Value == idx )
			{
				CancelDragIfAny();
				return;
			}
			var tmp = _team[idx];
			_team[idx] = _team[_dragFromSlot.Value];
			_team[_dragFromSlot.Value] = tmp;
		}
		else
		{
			// Roster → slot: place the dragged beast in the target, displacing
			// whatever was there. If the dragged beast was already picked in a
			// different slot, clear that other slot first (no duplicates).
			int existing = _team.FindIndex( t => t?.Id == _dragSource.Id );
			if ( existing >= 0 && existing != idx ) _team[existing] = null;
			_team[idx] = _dragSource;
		}

		_consumeNextClickForSlot = idx;
		_dragSource = null;
		_dragFromSlot = null;
		_dragHoverSlot = null;
		SoundManager.PlayClick();
	}

	private void CancelDragIfAny()
	{
		if ( _dragSource == null && _dragHoverSlot == null ) return;
		_dragSource = null;
		_dragFromSlot = null;
		_dragHoverSlot = null;
	}

	private void AutoFill()
	{
		var mm = MonsterManager.Instance;
		if ( mm == null ) return;
		var taken = _team.Where( t => t != null ).Select( t => t.Id ).ToHashSet();
		var candidates = mm.OwnedMonsters
			.Where( m => m != null && m.CurrentHP > 0 && !taken.Contains( m.Id ) )
			.OrderByDescending( m => m.PowerRating )
			.ToList();
		int added = 0;
		for ( int i = 0; i < _team.Count; i++ )
		{
			if ( _team[i] != null ) continue;
			if ( added >= candidates.Count ) break;
			_team[i] = candidates[added++];
		}
		SoundManager.PlayClick();

		// Tutorial: notify if AutoFill actually added at least one beast.
		if ( added > 0 )
		{
			Beastborne.Core.TutorialManager.Instance?.NotifyEvent( "team.beast-added" );
		}
	}

	private void ClearTeam()
	{
		_team = new() { null, null, null };
		SoundManager.PlayClick();
	}

	private bool CanEmbark() => _team.Any( m => m != null && m.CurrentHP > 0 );

	private bool _isEmbarking;

	private void OnEmbarkClicked()
	{
		if ( _isEmbarking ) return;
		if ( !CanEmbark() )
		{
			SoundManager.PlayDeny();
			return;
		}
		var liveTeam = _team.Where( m => m != null && m.CurrentHP > 0 ).ToList();
		var em = ExpeditionManager.Instance;
		if ( em == null || string.IsNullOrEmpty( PendingExpeditionId ) )
		{
			SoundManager.PlayDeny();
			return;
		}

		// Remember this team for next time we open the picker on this zone.
		// If save data isn't ready, skip the preset write and still embark —
		// losing the "last team per zone" convenience is fine; silently
		// blocking embark is not.
		var data = EnsureSaveData();
		if ( data != null )
		{
			data.LastTeamPerZone[PendingExpeditionId] = liveTeam.Select( m => m.Id ).ToList();
			SaveService.Instance?.MarkDirty( "teampresets" );
		}
		else
		{
			Log.Warning( "[TeamPickerPopup] Save data null at embark time; skipping team-preset write and proceeding with expedition." );
		}

		_isEmbarking = true;
		SoundManager.PlayBattleStart();

		// Hand the whole cinematic off to BattleTransition's static orchestrator.
		// StartExpedition swaps WorldMapPanel out for ExpeditionPanel, which
		// destroys this picker — running the sequence on BattleTransition (a
		// persistent GameHUD child) keeps the async chain alive through the swap.
		var zoneId = PendingExpeditionId;
		var hardMode = _hardMode; // capture — the picker unmounts during the sequence
		_ = BattleTransition.PlayEmbarkSequence( () =>
		{
			em.SelectTeam( liveTeam );
			em.StartExpedition( zoneId, hardMode );
		} );

		IsVisible = false;
		_isEmbarking = false;
	}

