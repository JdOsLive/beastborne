	// ─────────── DEV: SLOT POSITIONING EDITOR ───────────────────
	// Pick any species (owned or not) and it renders in the team
	// slots so the dev can tune how the sprite frames in the slab.
	// Drag the sprite to adjust CardOffsetX/Y; mouse wheel scales.
	// Same data the Beastbook editor uses — saving propagates to
	// both surfaces. (The picker's own slot art no longer reads these
	// values as of 2026-09-04 — see the markup note.)
	private const bool ShowSlotEditor = false;
	private string _slotEditTestSpeciesId;
	private string _slotEditDraggingId;
	private string _slotEditHoveredId;
	private float _slotDragStartMouseX, _slotDragStartMouseY;
	private float _slotDragStartOffX, _slotDragStartOffY;
	private bool _slotDragNeedsAnchor;
	private System.Collections.Generic.Dictionary<string, (float Scale, float OffX, float OffY)> _slotArtOverrides = new();

	// Persistence — overrides survive between sessions so devs don't
	// lose work to a restart. Stored as JSON in FileSystem.Data.
	private const string SavedSlotArtFile = "slot_card_art.json";
	private class SavedSlotArt { public string Id { get; set; } public float Scale { get; set; } public float OffX { get; set; } public float OffY { get; set; } }
	private class SlotArtData { public List<SavedSlotArt> Cards { get; set; } = new(); }
	private bool _slotArtLoaded = false;

	private void LoadSavedSlotArt()
	{
		try
		{
			if ( !FileSystem.Data.FileExists( SavedSlotArtFile ) ) return;
			var json = FileSystem.Data.ReadAllText( SavedSlotArtFile );
			var data = System.Text.Json.JsonSerializer.Deserialize<SlotArtData>( json );
			if ( data?.Cards == null ) return;
			foreach ( var c in data.Cards )
			{
				if ( string.IsNullOrEmpty( c.Id ) ) continue;
				_slotArtOverrides[c.Id] = (c.Scale, c.OffX, c.OffY);
			}
			Log.Info( $"[SlotEdit] Loaded {data.Cards.Count} override(s) from {SavedSlotArtFile}" );
		}
		catch ( System.Exception ex )
		{
			Log.Warning( $"[SlotEdit] Failed to load saved overrides: {ex.Message}" );
		}
	}

	private void PersistSlotArtToDisk()
	{
		try
		{
			var data = new SlotArtData();
			foreach ( var kvp in _slotArtOverrides )
			{
				data.Cards.Add( new SavedSlotArt { Id = kvp.Key, Scale = kvp.Value.Scale, OffX = kvp.Value.OffX, OffY = kvp.Value.OffY } );
			}
			var json = System.Text.Json.JsonSerializer.Serialize( data, new System.Text.Json.JsonSerializerOptions { WriteIndented = true } );
			FileSystem.Data.WriteAllText( SavedSlotArtFile, json );
		}
		catch ( System.Exception ex )
		{
			Log.Warning( $"[SlotEdit] Failed to write overrides: {ex.Message}" );
		}
	}

	private (float Scale, float OffX, float OffY) GetSlotArt( MonsterSpecies species )
	{
		if ( species == null ) return (1f, 0f, 0f);
		if ( _slotArtOverrides.TryGetValue( species.Id, out var ov ) ) return ov;
		return (species.CardScale, species.CardOffsetX, species.CardOffsetY);
	}

	private List<MonsterSpecies> GetAllTestableSpecies()
	{
		var all = MonsterManager.Instance?.GetAllSpecies() ?? new();
		return all.OrderBy( s => s.BeastiaryNumber ).ToList();
	}

	private void SlotEditPrevSpecies()
	{
		Log.Info( "[SlotEdit] PREV clicked" );
		var all = GetAllTestableSpecies();
		if ( all.Count == 0 ) return;
		var idx = string.IsNullOrEmpty( _slotEditTestSpeciesId )
			? all.Count - 1
			: all.FindIndex( s => s.Id == _slotEditTestSpeciesId ) - 1;
		if ( idx < 0 ) idx = all.Count - 1;
		_slotEditTestSpeciesId = all[idx].Id;
		SoundManager.PlayHover();
		StateHasChanged();
	}

	private void SlotEditNextSpecies()
	{
		Log.Info( "[SlotEdit] NEXT clicked" );
		var all = GetAllTestableSpecies();
		if ( all.Count == 0 ) return;
		var idx = string.IsNullOrEmpty( _slotEditTestSpeciesId )
			? 0
			: all.FindIndex( s => s.Id == _slotEditTestSpeciesId ) + 1;
		if ( idx >= all.Count ) idx = 0;
		_slotEditTestSpeciesId = all[idx].Id;
		SoundManager.PlayHover();
		StateHasChanged();
	}

	private void SlotEditClearTest()
	{
		_slotEditTestSpeciesId = null;
		StateHasChanged();
	}

	private void StartDragSlotArt( MonsterSpecies species )
	{
		if ( !ShowSlotEditor || species == null || string.IsNullOrEmpty( _slotEditTestSpeciesId ) ) return;
		var art = GetSlotArt( species );
		_slotEditDraggingId = species.Id;
		_slotDragStartOffX = art.OffX;
		_slotDragStartOffY = art.OffY;
		_slotDragNeedsAnchor = true;
		StateHasChanged();
	}

	private void OnSlotEditDragMove( PanelEvent e )
	{
		if ( string.IsNullOrEmpty( _slotEditDraggingId ) ) return;
		if ( _slotDragNeedsAnchor )
		{
			_slotDragStartMouseX = MousePosition.x;
			_slotDragStartMouseY = MousePosition.y;
			_slotDragNeedsAnchor = false;
			return;
		}
		float dx = ( MousePosition.x - _slotDragStartMouseX ) / 0.65f;
		float dy = ( MousePosition.y - _slotDragStartMouseY ) / 0.65f;
		var prev = _slotArtOverrides.TryGetValue( _slotEditDraggingId, out var ov )
			? ov
			: GetSlotArtFallback( _slotEditDraggingId );
		_slotArtOverrides[_slotEditDraggingId] = (prev.Scale, _slotDragStartOffX + dx, _slotDragStartOffY + dy);
		PersistSlotArtToDisk();
		StateHasChanged();
	}

	private void OnSlotEditDragEnd( PanelEvent e )
	{
		_slotEditDraggingId = null;
		StateHasChanged();
	}

	private (float Scale, float OffX, float OffY) GetSlotArtFallback( string speciesId )
	{
		var sp = MonsterManager.Instance?.GetSpecies( speciesId );
		return sp == null ? (1f, 0f, 0f) : (sp.CardScale, sp.CardOffsetX, sp.CardOffsetY);
	}

	private void OnSlotEditCardEnter( string speciesId )
	{
		if ( !ShowSlotEditor ) return;
		_slotEditHoveredId = speciesId;
	}

	private void OnSlotEditCardLeave( string speciesId )
	{
		if ( _slotEditHoveredId == speciesId ) _slotEditHoveredId = null;
	}

	private void PrintSlotArt()
	{
		Log.Info( $"[SlotEdit] SAVE clicked. Overrides count = {_slotArtOverrides.Count}, current test species = '{_slotEditTestSpeciesId}'" );
		if ( _slotArtOverrides.Count == 0 )
		{
			Log.Info( "[SlotEdit] No overrides yet — drag a slot or scroll over it first." );
			return;
		}
		PersistSlotArtToDisk();
		Log.Info( $"[SlotEdit] Saved {_slotArtOverrides.Count} override(s) → FileSystem.Data/{SavedSlotArtFile}" );
		Log.Info( "─── Slot card-art overrides — paste into MonsterManager.cs ───" );
		var ci = System.Globalization.CultureInfo.InvariantCulture;
		foreach ( var kvp in _slotArtOverrides )
		{
			var sp = MonsterManager.Instance?.GetSpecies( kvp.Key );
			var name = sp?.Name ?? kvp.Key;
			Log.Info( $"// {name} ({kvp.Key})" );
			Log.Info( $"CardScale = {kvp.Value.Scale.ToString( "0.###", ci )}f," );
			Log.Info( $"CardOffsetX = {kvp.Value.OffX.ToString( "0.#", ci )}f," );
			Log.Info( $"CardOffsetY = {kvp.Value.OffY.ToString( "0.#", ci )}f," );
		}
		Log.Info( "─────────────────────────────────────────────────────────────" );
		SoundManager.PlayClick();
	}

	private void ResetSlotArt()
	{
		_slotArtOverrides.Clear();
		PersistSlotArtToDisk();
		Log.Info( "[SlotEdit] Cleared all overrides." );
		SoundManager.PlayClick();
		StateHasChanged();
	}

