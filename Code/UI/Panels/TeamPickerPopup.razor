	// ═══════════════════════════════════════════════════════════════
	// LANE: motion (2026-09-04) — the beats' STATE. Every one-shot on a
	// volatile host (`.focused` flips the class string per hop = remount,
	// DOC-4 #14) is WINDOWED: a RealTime deadline stamps a class for just
	// longer than its keyframe, then the class drops (one remount onto an
	// already-settled element — the guild's windowed gp-pop recipe).
	// Deadlines are sign-checked and clamped (the Time-reset law, learnings
	// 2026-07-01). Everything here sits in BuildHash so a lapsing window
	// re-renders and drops its class.
	// ═══════════════════════════════════════════════════════════════
	private const float LadderWindow = 0.7f;   // tpCard0-7 run 0.62s
	private const float PopWindow = 0.35f;     // pick / seg pops run 0.18–0.30s
	private const float LandWindow = 0.4f;     // tpSlotLand 0.30s
	private const float EmptiedWindow = 0.3f;  // tpSlotEmptied 0.14s
	private const float AfWindow = 0.5f;       // tpAfSlot0-2 run 0.32s
	private const float ClosingWindow = 0.12f; // the exit latch (back is faster than forward)
	private const float EmbarkGoWindow = 0.6f; // the blackout's 0.35s fade-in + margin

	private static bool Win( float until )
	{
		if ( until <= 0f ) return false;
		float dt = until - RealTime.Now;
		return dt > 0f && dt < 5f; // a stale or future-skewed stamp reads lapsed
	}

	// CARD LADDER — armed on open and whenever the list re-forms (element /
	// sort / direction). Rung by index (8 rungs; cards past the cap ride the
	// last one), EXCEPT the cursor card and any card the cursor has touched
	// in this window — their class strings changed, and a remount would
	// replay the rung (hold + fade = a blink), so they mount whole (the
	// guild RowLadderClass). After the window every card is "" (the one
	// remount at expiry lands on already-opaque cards).
	private float _ladderUntil = -1f;
	private readonly HashSet<int> _ladderTouched = new();
	private bool LadderArmed => Win( _ladderUntil );
	private void ArmCardLadder() { _ladderUntil = RealTime.Now + LadderWindow; _ladderTouched.Clear(); }

	private string CardLadderClass( int idx, bool focused )
	{
		if ( !LadderArmed ) return "";
		if ( focused ) { _ladderTouched.Add( idx ); return ""; }
		if ( _ladderTouched.Contains( idx ) ) return "";
		return "tp-rr" + Math.Min( idx, 7 );
	}

	// PICK / UN-PICK pop — the one beast just toggled (dim + check land, or lift).
	private Guid _pickPopId = Guid.Empty;
	private bool _pickPopAdd;
	private float _pickPopUntil = -1f;
	private void StampPickPop( Guid id, bool add ) { _pickPopId = id; _pickPopAdd = add; _pickPopUntil = RealTime.Now + PopWindow; }
	private string PickPopClass( Guid id ) => Win( _pickPopUntil ) && _pickPopId == id ? (_pickPopAdd ? "pick-pop" : "unpick-pop") : "";

	// SLOT beats — bit masks per slot (a drop can re-land two slots at once);
	// the AUTO-FILL / preset ladder stores each slot's rung by fill order.
	private int _landedMask, _emptiedMask;
	private float _landedUntil = -1f, _emptiedUntil = -1f;
	private readonly int[] _afRung = { -1, -1, -1 };
	private float _afUntil = -1f;

	private void StampLanded( int slot )
	{
		if ( slot < 0 || slot > 2 ) return;
		if ( !Win( _landedUntil ) ) _landedMask = 0;
		_landedMask |= 1 << slot;
		_emptiedMask &= ~(1 << slot);
		_landedUntil = RealTime.Now + LandWindow;
	}

	private void StampEmptied( int slot )
	{
		if ( slot < 0 || slot > 2 ) return;
		if ( !Win( _emptiedUntil ) ) _emptiedMask = 0;
		_emptiedMask |= 1 << slot;
		_landedMask &= ~(1 << slot);
		_emptiedUntil = RealTime.Now + EmptiedWindow;
	}

	private void StampAutoFill( List<int> slotsInOrder )
	{
		for ( int i = 0; i < 3; i++ ) _afRung[i] = -1;
		if ( slotsInOrder == null || slotsInOrder.Count == 0 ) return;
		for ( int k = 0; k < slotsInOrder.Count; k++ )
		{
			int s = slotsInOrder[k];
			if ( s >= 0 && s < 3 ) _afRung[s] = Math.Min( k, 2 );
		}
		_afUntil = RealTime.Now + AfWindow;
	}

	private string SlotFxClass( int slot )
	{
		if ( slot < 0 || slot > 2 ) return "";
		if ( Win( _afUntil ) && _afRung[slot] >= 0 ) return "tp-af" + _afRung[slot];
		if ( Win( _landedUntil ) && (_landedMask & (1 << slot)) != 0 ) return "landed";
		if ( Win( _emptiedUntil ) && (_emptiedMask & (1 << slot)) != 0 ) return "emptied";
		return "";
	}

	// NORMAL | HARD arm pop — the segment carries the window; the rule targets
	// the active cell (and "+100%" under HARD).
	private float _segPopUntil = -1f;
	private string SegPopClass() => Win( _segPopUntil ) ? "seg-pop" : "";

	// EMBARK press flash — the ONE HDR tick on this page, held under the
	// blackout's fade-in (the blackout IS the exit; the picker stays up under it).
	private float _embarkGoUntil = -1f;
	private bool EmbarkGo => Win( _embarkGoUntil );

	// EXIT LATCH (Close → 0.12s `.closing` fade → Tick flips IsVisible) and the
	// dev replay hop (dev_pickerfx open: unmount this frame, re-Show the next).
	private float _closingUntil = -1f;
	private bool Closing => Win( _closingUntil );
	private string _reopenId;

	private void ResetMotionWindows()
	{
		_pickPopUntil = -1f; _pickPopId = Guid.Empty;
		_landedUntil = -1f; _emptiedUntil = -1f; _landedMask = 0; _emptiedMask = 0;
		_afUntil = -1f; for ( int i = 0; i < 3; i++ ) _afRung[i] = -1;
		_segPopUntil = -1f;
		_embarkGoUntil = -1f;
	}

	private bool IsLeftStop( int slot ) => _zone == CursorZone.Left && (int)_leftStop == slot;
	private bool IsLeftStop( LeftStop s ) => _zone == CursorZone.Left && _leftStop == s;

	private void SetLeft( LeftStop s )
	{
		_zone = CursorZone.Left;
		_leftStop = s;
		if ( s == LeftStop.AutoFill || s == LeftStop.Difficulty ) _controlsMemory = s;
	}

	/// <summary>Open-edge seed (DOC-5 #12; Show() is reached by mouse and keyboard
	/// alike): EMBARK when the last run's team came back valid — the fast path is
	/// one Space — else the grid's first card. Device resets to mouse; the first
	/// nav key takes it.</summary>
	private void SeedCursor( bool fromLastRun )
	{
		_kbIndex = 0;
		_headerCursor = 0;
		_headerReturnZone = CursorZone.Grid;
		_controlsMemory = LeftStop.Difficulty;
		_leftStop = LeftStop.Embark;
		_zone = fromLastRun && CanEmbark() ? CursorZone.Left : CursorZone.Grid;
		lastInputDevice = InputDevice.Mouse;
		_kbTakeoverMousePos = new Vector2( -9999f, -9999f );
		_hoveredKey = null;
		_denyFlashUntil = -1f;
		_openEdge = true;
		ResetMotionWindows(); // LANE: motion — no beat carries over an open
		ArmCardLadder();      // LANE: motion — the grid cascades on first render (both open paths land here)
	}

	// ── Device flag ──────────────────────────────────────────────
	private void SetInputDevice( InputDevice dev )
	{
		if ( lastInputDevice == dev ) return;
		lastInputDevice = dev;
		if ( dev == InputDevice.Keyboard )
		{
			_kbTakeoverMousePos = Mouse.Position;
			return;
		}
		// The mouse owns the page again: whatever already sits under it is
		// the cursor (onmouseover only fires on ENTERING an element).
		SyncCursorToHovered();
	}

	private void OnRootMouseMove()
	{
		if ( IsKbMode && (Mouse.Position - _kbTakeoverMousePos).Length >= 3f )
			SetInputDevice( InputDevice.Mouse );
	}

	private void SyncCursorToHovered()
	{
		if ( embarkRef != null && embarkRef.HasHovered ) { SetLeft( LeftStop.Embark ); return; }
		if ( autoFillRef != null && autoFillRef.HasHovered ) { SetLeft( LeftStop.AutoFill ); return; }
		if ( segRef != null && segRef.HasHovered ) { SetLeft( LeftStop.Difficulty ); return; }
		for ( int i = 0; i < 3; i++ )
		{
			var sp = SlotPanel( i );
			if ( sp != null && sp.HasHovered ) { SetLeft( (LeftStop)i ); return; }
		}
		var cards = CardPanels();
		for ( int i = 0; i < cards.Count; i++ )
		{
			if ( !cards[i].HasHovered ) continue;
			_zone = CursorZone.Grid;
			_kbIndex = i;
			return;
		}
	}

	// The two BbButtons expose no page-level onmouseover — poll their hover
	// per tick in mouse mode (two panels; free). A disabled EMBARK is
	// pointer-inert, so the mouse can never park the cursor on a dead primary.
	private void SyncButtonHover()
	{
		if ( embarkRef != null && embarkRef.HasHovered && !IsLeftStop( LeftStop.Embark ) ) SetLeft( LeftStop.Embark );
		else if ( autoFillRef != null && autoFillRef.HasHovered && !IsLeftStop( LeftStop.AutoFill ) ) SetLeft( LeftStop.AutoFill );
	}

	// ── Hover = the same cursor (mouse mode only) ────────────────
	private void OnHover( string key )
	{
		if ( IsKbMode ) return;
		if ( _hoveredKey == key ) return;
		_hoveredKey = key;
		SoundManager.PlayHover();
	}

	private void OnCardHover( int idx )
	{
		if ( IsKbMode ) return;
		if ( _zone == CursorZone.Grid && _kbIndex == idx ) return;
		_zone = CursorZone.Grid;
		_kbIndex = idx;
	}

	private void OnSegHover( string key )
	{
		OnHover( key );
		if ( IsKbMode ) return;
		SetLeft( LeftStop.Difficulty );
	}

	/// <summary>The beast the FACTS column describes = the beast under the ONE
	/// cursor: the grid card (hover moves the same index in mouse mode), a filled
	/// slot when the cursor sits on it, else the first team member, else the grid
	/// card again. Never null while there is anything to describe.</summary>
	private Monster GetFocusedBeast( List<Monster> roster )
	{
		Monster gridBeast = roster != null && roster.Count > 0 ? roster[Math.Clamp( _kbIndex, 0, roster.Count - 1 )] : null;
		if ( _zone == CursorZone.Left )
		{
			int slot = (int)_leftStop;
			if ( slot <= 2 && _team[slot] != null ) return _team[slot];
			return _team.FirstOrDefault( t => t != null ) ?? gridBeast;
		}
		return gridBeast ?? _team.FirstOrDefault( t => t != null );
	}

	// ── Geometry (live Box.Rects — the graph encodes what is ON SCREEN, DOC-5 #21) ──
	private static Rect? PanelRect( Panel p ) => p == null || p.Box.Rect.Width < 1f ? (Rect?)null : p.Box.Rect;
	private static float CenterY( Rect r ) => (r.Top + r.Bottom) * 0.5f;

	private Panel SlotPanel( int i )
	{
		if ( slotsRef == null ) return null;
		int n = 0;
		foreach ( var c in slotsRef.Children )
		{
			if ( !c.HasClass( "tp-slot" ) ) continue;
			if ( n == i ) return c;
			n++;
		}
		return null;
	}

	private List<Panel> CardPanels() => pickerRosterScroll == null
		? new List<Panel>()
		: pickerRosterScroll.Children.Where( c => c.HasClass( "tp-card" ) ).ToList();

	private Panel LeftStopPanel( LeftStop s ) => s switch
	{
		LeftStop.AutoFill => autoFillRef,
		LeftStop.Difficulty => segRef,
		LeftStop.Embark => embarkRef,
		_ => SlotPanel( (int)s )
	};

	private Rect? LeftStopRect( LeftStop s ) => PanelRect( LeftStopPanel( s ) );

	// A off the grid's first column → the LEFT stop nearest by Y. The 44 row
	// is represented by NORMAL|HARD (its grid-side half); AUTO-FILL is one A
	// further.
	private void EnterLeftNearest( Rect? from )
	{
		LeftStop best = LeftStop.Slot0;
		float bestD = float.MaxValue;
		if ( from.HasValue )
		{
			float y = CenterY( from.Value );
			foreach ( var s in new[] { LeftStop.Slot0, LeftStop.Slot1, LeftStop.Slot2, LeftStop.Difficulty, LeftStop.Embark } )
			{
				var r = LeftStopRect( s );
				if ( r == null ) continue;
				float d = MathF.Abs( CenterY( r.Value ) - y );
				if ( d < bestD ) { bestD = d; best = s; }
			}
		}
		SetLeft( best );
		SoundManager.PlayHover();
	}

	// D off a LEFT stop → the grid's first-column card nearest by Y among the
	// cards INSIDE the viewport (a scrolled-away row is not on screen).
	private void EnterGridNearest( Rect? from )
	{
		var cards = CardPanels();
		if ( cards.Count == 0 ) { SoundManager.PlayDeny(); return; }
		int best = 0;
		float bestD = float.MaxValue;
		if ( from.HasValue && pickerRosterScroll != null )
		{
			var gr = pickerRosterScroll.Box.Rect;
			float y = CenterY( from.Value );
			for ( int i = 0; i < cards.Count; i += CARDS_PER_ROW )
			{
				var r = cards[i].Box.Rect;
				if ( r.Height < 1f || r.Top < gr.Top - 14f || r.Bottom > gr.Bottom + 14f ) continue;
				float d = MathF.Abs( CenterY( r ) - y );
				if ( d < bestD ) { bestD = d; best = i; }
			}
		}
		_zone = CursorZone.Grid;
		_kbIndex = best;
		RequestScrollFollow();
		SoundManager.PlayHover();
	}

	// ── HEADER zone — measured by class at the page layer (the Bag's
	// CollectHeaderControls recipe): the FilterBar's two triggers + the
	// direction toggle. BACK is a Q cap, not a stop.
	private List<Panel> CollectHeaderControls()
	{
		var outList = new List<Panel>();
		if ( toolbarRef != null ) CollectHeaderControlsRec( toolbarRef, outList );
		return outList;
	}

	private static void CollectHeaderControlsRec( Panel root, List<Panel> outList )
	{
		foreach ( var c in root.Children )
		{
			if ( c.HasClass( "dropdown-btn" ) || c.HasClass( "sort-direction-btn" ) )
			{
				outList.Add( c );
				continue;
			}
			CollectHeaderControlsRec( c, outList );
		}
	}

	private void EnterHeader( CursorZone from )
	{
		var hdr = CollectHeaderControls();
		if ( hdr.Count == 0 ) return;
		_headerReturnZone = from;
		_zone = CursorZone.Header;
		_headerCursor = Math.Clamp( _headerCursor, 0, hdr.Count - 1 );
		if ( from == CursorZone.Grid ) gridScrollGlideTarget = 0f; // leaving upward glides the grid to its top (DOC-5 #13)
		SoundManager.PlayHover();
	}

	private void LeaveHeaderDown()
	{
		_zone = _headerReturnZone;
		if ( _zone == CursorZone.Left ) _leftStop = LeftStop.Slot0; // the only LEFT → header route is off slot 0
		else RequestScrollFollow();
		SoundManager.PlayHover();
	}

	private void HandleHeaderKeys( int dir, bool confirm )
	{
		var hdr = CollectHeaderControls();
		if ( hdr.Count == 0 ) { _zone = _headerReturnZone; return; }
		_headerCursor = Math.Clamp( _headerCursor, 0, hdr.Count - 1 );
		if ( confirm )
		{
			// Exactly what a click does: a menu opens (its Toggle seeds the row
			// cursor; FilterBar.HandleKeyboard owns the keys from the next tick),
			// the direction toggle flips.
			hdr[_headerCursor].CreateEvent( "onclick" );
			SoundManager.PlayClick();
			return;
		}
		switch ( dir )
		{
			case 2: if ( _headerCursor > 0 ) { _headerCursor--; SoundManager.PlayHover(); } return;
			case 3: if ( _headerCursor < hdr.Count - 1 ) { _headerCursor++; SoundManager.PlayHover(); } return;
			case 1: LeaveHeaderDown(); return;
			case 0: return; // the header is the modal's top edge (silent)
		}
	}

	// A/D inside an OPEN FilterBar menu (FilterBar.OnKbSideStep): the menu has
	// closed; hop the header cursor to the trigger's neighbour. Menubar
	// convention: a neighbouring dropdown OPENS (ELEMENT ↔ SORT browse with
	// A/D alone); the direction toggle just takes the cursor.
	private void OnFilterBarSideStep( Panel trigger, int dir )
	{
		var hdr = CollectHeaderControls();
		if ( hdr.Count == 0 ) return;
		int from = trigger != null ? hdr.IndexOf( trigger ) : -1;
		if ( from < 0 ) from = Math.Clamp( _headerCursor, 0, hdr.Count - 1 );
		int to = Math.Clamp( from + dir, 0, hdr.Count - 1 );
		SetInputDevice( InputDevice.Keyboard );
		if ( _zone != CursorZone.Header ) _headerReturnZone = _zone;
		_zone = CursorZone.Header;
		_headerCursor = to;
		if ( to != from && hdr[to].HasClass( "dropdown-btn" ) ) hdr[to].CreateEvent( "onclick" );
		else SoundManager.PlayHover();
	}

	// KB-FOCUSED LOOK = THE HOVER LOOK on the header (no ring there), stamped
	// IMPERATIVELY every tick — a FilterBar re-render rewrites the class
	// attribute, so a one-shot stamp would be wiped (the Bag's recipe).
	// Cleared from every chip on index change, zone leave, close, mouse mode.
	private void SyncHeaderKbFocus()
	{
		bool active = IsVisible && IsKbMode && _zone == CursorZone.Header;
		if ( !active && !hdrKbFocusStamped ) return;
		var ctrls = CollectHeaderControls();
		bool any = false;
		for ( int i = 0; i < ctrls.Count; i++ )
		{
			bool on = active && i == _headerCursor;
			ctrls[i].SetClass( "kb-focused", on );
			any |= on;
		}
		hdrKbFocusStamped = any;
	}

	// ── LEFT zone ────────────────────────────────────────────────
	private void HandleLeftKeys( int dir, bool confirm )
	{
		var stop = _leftStop;
		if ( confirm )
		{
			switch ( stop )
			{
				case LeftStop.Slot0:
				case LeftStop.Slot1:
				case LeftStop.Slot2:
				{
					int s = (int)stop;
					if ( _team[s] != null ) { StampPickPop( _team[s].Id, false ); StampEmptied( s ); _team[s] = null; SoundManager.PlayClick(); } // LANE: motion — the removal beats
					else EnterGridNearest( LeftStopRect( stop ) ); // PICK A BEAST — walk to the roster
					return;
				}
				case LeftStop.AutoFill: AutoFill(); return;
				case LeftStop.Difficulty: SetHardMode( !_hardMode ); return; // denies itself when HARD is locked
				case LeftStop.Embark: TryEmbark(); return;
			}
		}
		switch ( dir )
		{
			case 0: // W
				switch ( stop )
				{
					case LeftStop.Slot0: EnterHeader( CursorZone.Left ); return;
					case LeftStop.Slot1: SetLeft( LeftStop.Slot0 ); break;
					case LeftStop.Slot2: SetLeft( LeftStop.Slot1 ); break;
					case LeftStop.AutoFill:
					case LeftStop.Difficulty: SetLeft( LeftStop.Slot2 ); break;
					case LeftStop.Embark: SetLeft( _controlsMemory ); break;
				}
				SoundManager.PlayHover();
				return;
			case 1: // S
				switch ( stop )
				{
					case LeftStop.Slot0: SetLeft( LeftStop.Slot1 ); break;
					case LeftStop.Slot1: SetLeft( LeftStop.Slot2 ); break;
					case LeftStop.Slot2: SetLeft( _controlsMemory ); break;
					case LeftStop.AutoFill:
					case LeftStop.Difficulty: SetLeft( LeftStop.Embark ); break;
					default: return; // EMBARK is the column's foot (silent)
				}
				SoundManager.PlayHover();
				return;
			case 2: // A — the column is the modal's left edge; only the segment reacts
				if ( stop == LeftStop.Difficulty )
				{
					if ( _hardMode ) SetHardMode( false );
					else { SetLeft( LeftStop.AutoFill ); SoundManager.PlayHover(); }
				}
				return;
			case 3: // D
				if ( stop == LeftStop.AutoFill ) { SetLeft( LeftStop.Difficulty ); SoundManager.PlayHover(); return; }
				if ( stop == LeftStop.Difficulty && !_hardMode && IsHardUnlocked() ) { SetHardMode( true ); return; }
				EnterGridNearest( LeftStopRect( stop ) );
				return;
		}
	}

	// ── GRID zone ────────────────────────────────────────────────
	private void HandleGridKeys( int dir, bool confirm, List<Monster> roster )
	{
		int n = roster.Count;
		if ( n == 0 )
		{
			// Empty under a filter: W → header (R cycles from there too), A → the
			// LEFT column; the rest is silent, confirm denies.
			if ( dir == 0 ) EnterHeader( CursorZone.Grid );
			else if ( dir == 2 ) EnterLeftNearest( PanelRect( pickerRosterScroll ) );
			else if ( confirm ) SoundManager.PlayDeny();
			return;
		}
		_kbIndex = Math.Clamp( _kbIndex, 0, n - 1 );
		if ( confirm ) { OnRosterCardClicked( roster[_kbIndex] ); return; }

		int col = _kbIndex % CARDS_PER_ROW;
		int row = _kbIndex / CARDS_PER_ROW;
		int lastRow = (n - 1) / CARDS_PER_ROW;
		int prev = _kbIndex;
		switch ( dir )
		{
			case 0: // W
				if ( row > 0 ) _kbIndex -= CARDS_PER_ROW;
				else { EnterHeader( CursorZone.Grid ); return; }
				break;
			case 1: // S — the last row is the grid's foot (silent; nothing below)
				if ( row < lastRow ) _kbIndex = Math.Min( n - 1, _kbIndex + CARDS_PER_ROW );
				break;
			case 2: // A
				if ( col > 0 ) _kbIndex--;
				else { EnterLeftNearest( PanelRect( CardPanels().ElementAtOrDefault( _kbIndex ) ) ); return; }
				break;
			case 3: // D — column 4 is the grid's right edge; FACTS is display-only (silent)
				if ( col < CARDS_PER_ROW - 1 && _kbIndex + 1 < n ) _kbIndex++;
				break;
		}
		if ( _kbIndex != prev )
		{
			SoundManager.PlayHover();
			RequestScrollFollow();
		}
	}

	// ── EMBARK by key — deny + the reason on the label for 1.2s ──
	private float _denyFlashUntil = -1f;
	private bool EmbarkDenying => RealTime.Now < _denyFlashUntil;
	private string EmbarkClass() => "tp-embark" + (EmbarkDenying ? " deny" : "") + (EmbarkGo ? " go" : ""); // LANE: motion — `.deny` blip · `.go` press flash

	private void TryEmbark()
	{
		if ( !CanEmbark() )
		{
			_denyFlashUntil = RealTime.Now + 1.2f;
			SoundManager.PlayDeny();
			return;
		}
		OnEmbarkClicked();
	}

	// ── The key map (gated on the top modal by Tick) ─────────────
	private void TickInput()
	{
		bool menuOpen = filterBar != null && filterBar.IsAnyDropdownOpen;

		// R = element cycle (the shown cycle key); Z/X (CyclePrev/Next) the
		// silent twins. An open menu closes first — the chip then shows the result.
		if ( Input.Pressed( "Reload" ) ) { SetInputDevice( InputDevice.Keyboard ); if ( menuOpen ) filterBar.CloseAllDropdowns(); CycleElementFilter( 1 ); return; }
		if ( Input.Pressed( "CyclePrev" ) ) { SetInputDevice( InputDevice.Keyboard ); if ( menuOpen ) filterBar.CloseAllDropdowns(); CycleElementFilter( -1 ); return; }
		if ( Input.Pressed( "CycleNext" ) ) { SetInputDevice( InputDevice.Keyboard ); if ( menuOpen ) filterBar.CloseAllDropdowns(); CycleElementFilter( 1 ); return; }

		// An OPEN FilterBar menu owns W/S/Space/Q/A/D (Q closes the menu first
		// and claims PanelHandledBackKey inside HandleKeyboard).
		if ( menuOpen && filterBar.HandleKeyboard() ) { SetInputDevice( InputDevice.Keyboard ); return; }

		// Q = close the picker (claimed so GameHUD never doubles it). Escape /
		// Shift are the shell's pre-existing pair — kept, not new bindings.
		if ( Input.Pressed( "Menu" ) || Input.Pressed( "Escape" ) || Input.Pressed( "run" ) )
		{
			if ( Input.Pressed( "Menu" ) ) GameHUD.PanelHandledBackKey = true;
			SoundManager.PlayBack();
			Close();
			return;
		}

		// F = Auto-fill, C = Clear. Flashlight/View are the engine actions
		// bound to the F and C keys — reused here; GameHUD ignores them while
		// a modal is open, so there's no collision.
		if ( Input.Pressed( "Flashlight" ) ) { SetInputDevice( InputDevice.Keyboard ); AutoFill(); return; }
		if ( Input.Pressed( "View" ) ) { SetInputDevice( InputDevice.Keyboard ); ClearTeam(); return; }

		// 1 / 2 / 3 — preset slots: load if the slot holds a team, else save
		// the current team into it (deny if there's nothing to save). The
		// preset BUTTONS were cut in run 1; the keys still work.
		for ( int p = 0; p < 3; p++ )
		{
			if ( !Input.Pressed( "Slot" + (p + 1) ) ) continue;
			SetInputDevice( InputDevice.Keyboard );
			var preset = GetPreset( p );
			bool slotHasData = preset != null && preset.MonsterIds.Count > 0;
			if ( slotHasData ) LoadPreset( p );
			else if ( _team.Any( t => t != null ) ) SavePreset( p );
			else SoundManager.PlayDeny();
			return;
		}

		int dir = -1; // 0 up · 1 down · 2 left · 3 right
		if ( Input.Pressed( "Up" ) ) dir = 0;
		else if ( Input.Pressed( "Down" ) ) dir = 1;
		else if ( Input.Pressed( "Left" ) ) dir = 2;
		else if ( Input.Pressed( "Right" ) ) dir = 3;
		bool confirm = UiInput.ConfirmPressed(); // Space advertised · Enter / E silent twins
		if ( dir < 0 && !confirm ) return;

		SetInputDevice( InputDevice.Keyboard );
		switch ( _zone )
		{
			case CursorZone.Header: HandleHeaderKeys( dir, confirm ); break;
			case CursorZone.Left: HandleLeftKeys( dir, confirm ); break;
			default: HandleGridKeys( dir, confirm, GetFilteredMonsters() ); break;
		}
	}

	// ── THE LIVING RING — one costume (every host is r16 → r26) ──
	private int ringL, ringT, ringW, ringH;
	private bool ringVisible;
	private int ringWarm;
	private const int RingInset = 10; // host r16 + 10 → ring r26

	private string RingClass() => "tp-ring " + (ringVisible ? "on " : "") + (ringWarm < 2 ? "snap" : "");

	private Rect? ResolveRingHost()
	{
		if ( filterBar != null && filterBar.IsAnyDropdownOpen ) return null; // the menu owns the keys — no second cursor under it
		switch ( _zone )
		{
			case CursorZone.Header: return null; // the header wears `.kb-focused`
			case CursorZone.Left: return LeftStopRect( _leftStop );
			default:
			{
				if ( pickerRosterScroll == null ) return null;
				var gr = pickerRosterScroll.Box.Rect;
				if ( gr.Width < 2f ) return null;
				var card = CardPanels().ElementAtOrDefault( _kbIndex );
				if ( card == null ) return null;
				var r = card.Box.Rect;
				// Scrolled out of the viewport → self-hide (a scroll never clips the ring).
				if ( r.Width < 2f || r.Top < gr.Top - 14f || r.Bottom > gr.Bottom + 14f ) return null;
				return r;
			}
		}
	}

	private void UpdateRing()
	{
		bool wasVisible = ringVisible;
		ringVisible = false;
		if ( !IsVisible || modalRef == null ) return;
		var mr = modalRef.Box.Rect;
		if ( mr.Width < 2f ) return;
		var host = ResolveRingHost();
		if ( host == null ) return;
		var cr = host.Value;

		float sc = ScaleFromScreen;
		if ( sc <= 0.01f || float.IsNaN( sc ) || float.IsInfinity( sc ) ) sc = 1f;

		// RING CENTERING LAW: Style.Left/Top place the PADDING box and the 4px
		// border draws outside it → L/T = host − inset + 4, W/H = host + 2·inset − 8.
		ringL = (int)((cr.Left - mr.Left) * sc) - RingInset + 4;
		ringT = (int)((cr.Top - mr.Top) * sc) - RingInset + 4;
		ringW = (int)(cr.Width * sc) + RingInset * 2 - 8;
		ringH = (int)(cr.Height * sc) + RingInset * 2 - 8;

		ringVisible = true;
		if ( !wasVisible ) ringWarm = 0;
		else if ( ringWarm < 2 ) ringWarm++;
	}

	// LANE: motion owns the wave's character — the hub numbers verbatim.
	private void ApplyRingWave()
	{
		if ( ringRef == null || !ringVisible ) return;
		float wt = Time.Now;
		float skX = (2.0f * MathF.Sin( wt * 2.2f ) + 0.7f * MathF.Sin( wt * 3.5f + 1.1f )) * 0.6f;
		float skY = (2.3f * MathF.Sin( wt * 1.8f + 1.9f ) + 0.9f * MathF.Sin( wt * 2.9f )) * 0.6f;
		float rotZ = (1.1f * MathF.Sin( wt * 1.0f ) + 0.5f * MathF.Sin( wt * 2.4f + 0.5f )) * 0.6f;
		float brX = 1f + 0.013f * MathF.Sin( wt * 1.35f + 0.7f ) + 0.006f * MathF.Sin( wt * 2.7f );
		float brY = 1f + 0.013f * MathF.Sin( wt * 1.15f + 2.6f ) + 0.006f * MathF.Sin( wt * 2.3f + 1.4f );

		var t = new PanelTransform();
		t.AddRotation( 0f, 0f, rotZ );
		t.AddSkew( skX, skY, 0f );
		t.AddScale( new Vector2( brX, brY ) );
		ringRef.Style.Transform = t;
	}

	// ── KB SCROLL-FOLLOW — the Bag's glide recipe (DOC-5 #13): endpoint
	// rows scroll fully to top / bottom, the middle keeps the card in view;
	// a 0.30/frame exponential glide, retried until the card has a rect.
	private bool _scrollFollowPending;
	private int _scrollFollowFrames;
	private float gridScrollGlideTarget = -1f;

	private void RequestScrollFollow() { _scrollFollowPending = true; _scrollFollowFrames = 0; }

	private void UpdateScrollFollow()
	{
		if ( pickerRosterScroll == null ) return;
		if ( _scrollFollowPending )
		{
			if ( ++_scrollFollowFrames > 12 || _zone != CursorZone.Grid ) _scrollFollowPending = false;
			var cards = CardPanels();
			if ( _zone == CursorZone.Grid && _kbIndex >= 0 && _kbIndex < cards.Count && cards[_kbIndex].Box.Rect.Height > 1f )
			{
				_scrollFollowPending = false;
				int row = _kbIndex / CARDS_PER_ROW;
				int lastRow = (cards.Count - 1) / CARDS_PER_ROW;
				float curOff = pickerRosterScroll.ScrollOffset.y;
				float? t;
				if ( row == 0 ) t = curOff > 0.5f ? 0f : null;
				else if ( row == lastRow )
				{
					float max = Math.Max( 0f, pickerRosterScroll.ScrollSize.y );
					t = Math.Abs( max - curOff ) > 0.5f ? max : null;
				}
				else t = UiGridScroll.ComputeOffset( pickerRosterScroll, cards[_kbIndex] );
				if ( t.HasValue ) gridScrollGlideTarget = t.Value;
			}
		}

		if ( gridScrollGlideTarget < 0f ) return;
		float now = pickerRosterScroll.ScrollOffset.y;
		float delta = gridScrollGlideTarget - now;
		if ( Math.Abs( delta ) < 1.5f )
		{
			pickerRosterScroll.ScrollOffset = new Vector2( pickerRosterScroll.ScrollOffset.x, gridScrollGlideTarget );
			gridScrollGlideTarget = -1f;
			return;
		}
		pickerRosterScroll.ScrollOffset = new Vector2( pickerRosterScroll.ScrollOffset.x, now + delta * 0.30f );
	}

	// ── dev_picker [expeditionId] — open the picker from the console so the
	// session can screenshot it without clicking the map. Default = the
	// frontier zone (the last one CanStartExpedition allows), else the first.
	// The picker mounts under the world map: open the EXPEDITION tab first.
	[ConCmd( "dev_picker" )]
	public static void DevPicker( string expeditionId = null )
	{
		var em = ExpeditionManager.Instance;
		if ( em == null ) { Log.Warning( "[dev_picker] ExpeditionManager is not up." ); return; }
		if ( string.IsNullOrWhiteSpace( expeditionId ) )
		{
			Expedition pick = null;
			foreach ( var e in em.Expeditions ) if ( em.CanStartExpedition( e.Id ) ) pick = e;
			pick ??= em.Expeditions.FirstOrDefault();
			expeditionId = pick?.Id;
		}
		if ( string.IsNullOrEmpty( expeditionId ) || em.GetExpedition( expeditionId ) == null )
		{
			Log.Warning( $"[dev_picker] unknown expedition '{expeditionId}'. Known: {string.Join( ", ", em.Expeditions.Select( e => e.Id ) )}" );
			return;
		}
		if ( Instance == null )
		{
			Log.Warning( "[dev_picker] the picker is not mounted — open the EXPEDITION tab (world map) first." );
			return;
		}
		Show( expeditionId );
		Log.Info( $"[dev_picker] opened on '{expeditionId}' · cursor={Instance._zone}/{(Instance._zone == CursorZone.Left ? Instance._leftStop.ToString() : Instance._kbIndex.ToString())}" );
	}

	// ── dev_pickerfx <beat> — LANE: motion. Replay the beats without a mouse
	// (the dev_fusefx pattern, DOC-4 #20; verify END STATES — every card
	// present, console clean). Beats:
	//   open    — unmount this frame, re-Show next tick: modal rise + zone
	//             ladder + card cascade (the whole open choreography)
	//   cascade — re-arm the card ladder alone (the element/sort re-form)
	//   pick    — toggle the first live roster card (pick pop / un-pick lift +
	//             the slot landing / emptied beats)
	//   fill    — CLEAR then AUTO-FILL: the 3-rung slot ladder
	//   clear   — every filled slot crosses to empty
	//   hard    — toggle NORMAL | HARD (the arm pop; denies when locked)
	//   deny    — the EMBARK red blip + the 1.2s reason window, forced
	//   go      — the EMBARK press flash (the HDR tick) WITHOUT embarking
	//   close   — the 0.12s exit latch
	[ConCmd( "dev_pickerfx" )]
	public static void DevPickerFx( string beat = "open" )
	{
		var p = Instance;
		if ( p == null || !IsVisible ) { Log.Warning( "[dev_pickerfx] open the picker first (dev_picker)." ); return; }
		switch ( (beat ?? "open").ToLowerInvariant() )
		{
			case "open":
				p._closingUntil = -1f;
				p._reopenId = PendingExpeditionId;
				IsVisible = false; // the @if unmounts this frame; Tick re-Shows next frame so the mount keyframes replay
				break;
			case "cascade": p.ArmCardLadder(); break;
			case "pick":
			{
				var roster = p.GetFilteredMonsters();
				var first = roster.FirstOrDefault( m => m.CurrentHP > 0 );
				if ( first == null ) { Log.Warning( "[dev_pickerfx] no live beast in the roster." ); return; }
				p.OnRosterCardClicked( first );
				break;
			}
			case "fill": p.ClearTeam(); p.AutoFill(); break;
			case "clear": p.ClearTeam(); break;
			case "hard": p.SetHardMode( !p._hardMode ); break;
			case "deny": p._denyFlashUntil = RealTime.Now + 1.2f; SoundManager.PlayDeny(); break;
			case "go": p._embarkGoUntil = RealTime.Now + EmbarkGoWindow; break;
			case "close": Close(); break;
			default:
				Log.Warning( $"[dev_pickerfx] unknown beat '{beat}' — open | cascade | pick | fill | clear | hard | deny | go | close" );
				return;
		}
		Log.Info( $"[dev_pickerfx] {beat}" );
	}


	// Mouse wheel — scales the hovered slot's sprite when in slot-edit mode.
	public override void OnMouseWheel( Vector2 delta )
	{
		if ( ShowSlotEditor && !string.IsNullOrEmpty( _slotEditTestSpeciesId ) && !string.IsNullOrEmpty( _slotEditHoveredId ) )
		{
			var prev = _slotArtOverrides.TryGetValue( _slotEditHoveredId, out var ov )
				? ov
				: GetSlotArtFallback( _slotEditHoveredId );
			float newScale = Math.Clamp( prev.Scale + delta.y * 0.05f, 0.3f, 3.0f );
			_slotArtOverrides[_slotEditHoveredId] = (newScale, prev.OffX, prev.OffY);
			PersistSlotArtToDisk();
			StateHasChanged();
			return;
		}
		base.OnMouseWheel( delta );
	}

	protected override void OnAfterTreeRender( bool firstTime )
	{
		if ( firstTime )
		{
			Instance = this;
			if ( !_slotArtLoaded )
			{
				LoadSavedSlotArt();
				_slotArtLoaded = true;
			}
			// If Show(id) was called before this panel mounted (e.g. ExpeditionPanel
			// triggered "Embark Again" → WorldMap swapped in → picker constructed
			// AFTER the Show call), the static flags are already set. Finish the
			// pre-fill now that the instance exists.
			if ( IsVisible && !string.IsNullOrEmpty( PendingExpeditionId ) )
			{
				SeedCursor( PreFillTeam( PendingExpeditionId ) );
			}
		}
	}

