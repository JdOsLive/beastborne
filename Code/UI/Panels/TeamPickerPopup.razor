	/// <summary>Recommended level shown in the header — boosted when hard mode is armed.</summary>
	private int GetDisplayLevel( Expedition exp )
	{
		if ( exp == null ) return 0;
		return _hardMode
			? (int)Math.Floor( exp.BaseEnemyLevel * ExpeditionManager.HARD_MODE_LEVEL_MULT )
			: exp.BaseEnemyLevel;
	}

	/// <summary>CTA label — plus the hard-mode variant.</summary>
	private string GetEmbarkLabel( int filled )
	{
		if ( EmbarkDenying && !CanEmbark() ) return filled == 0 ? "PICK A BEAST" : "TEAM IS KO"; // the deny reason (LANE: input)
		if ( !CanEmbark() ) return filled == 0 ? "PICK A BEAST" : "EMBARK";
		return _hardMode ? "EMBARK · HARD" : "EMBARK";
	}

