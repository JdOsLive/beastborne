	// LANE: motion — belt-and-suspenders for the exit latch: if the page is
	// torn down while the 0.12s fade runs, the static must not stay TRUE
	// (the next WorldMap mount would re-open the picker unasked).
	public override void OnDeleted()
	{
		if ( Instance == this && _closingUntil > 0f ) { _closingUntil = -1f; IsVisible = false; }
		base.OnDeleted();
	}

	public static void Show( string expeditionId )
	{
		PendingExpeditionId = expeditionId;
		IsVisible = true;
		if ( Instance != null )
		{
			Instance._closingUntil = -1f; // LANE: motion — a Show mid-fade cancels the exit latch
			Instance._reopenId = null;
			Instance._isEmbarking = false; // re-armed per open (the embark path leaves it true — the blackout owns that exit)
			Instance._hardMode = false; // difficulty re-arms per open
			bool fromLastRun = Instance.PreFillTeam( expeditionId );
			Instance.SeedCursor( fromLastRun ); // EMBARK when the last run's team is back and valid, else card 0
			Instance.NotifyTutorialIfTeamPopulated();
		}
		SoundManager.PlayPopup();
	}

	// LANE: motion — the ONE close path (Q, BACK, shield) arms the 0.12s EXIT
	// LATCH instead of unmounting (the settings sub-view recipe): the root
	// wears `.closing` (opacity 0, pointer-events none), IsVisible stays true
	// so the modal keeps painting through the fade and Q stays claimed, and
	// Tick flips IsVisible when the latch lapses. Idempotent while closing;
	// a no-op mid-embark (the blackout owns that exit).
	public static void Close()
	{
		if ( Instance == null ) { IsVisible = false; SoundManager.PlayPopdown(); return; }
		if ( !IsVisible || Instance._isEmbarking || Instance.Closing ) return;
		Instance._closingUntil = RealTime.Now + ClosingWindow;
		Instance._hoveredKey = null;
		Instance.ringVisible = false;
		Instance.gridScrollGlideTarget = -1f;
		Instance._scrollFollowPending = false;
		Instance.filterBar?.CloseAllDropdowns();
		SoundManager.PlayPopdown();
	}

	public override void Tick()
	{
		base.Tick();
		if ( !IsVisible )
		{
			ringVisible = false;
			// LANE: motion — dev_pickerfx open: the modal unmounted last frame; re-Show
			// now so its mount keyframes (rise + zone ladder + cascade) replay.
			if ( _reopenId != null ) { var id = _reopenId; _reopenId = null; Show( id ); }
			return;
		}

		// LANE: motion — EXIT LATCH running: nothing takes input mid-exit, the ring
		// stays hidden (it fades with the root); the real unmount lands at expiry.
		if ( _closingUntil > 0f )
		{
			if ( !Win( _closingUntil ) ) { _closingUntil = -1f; IsVisible = false; }
			ringVisible = false;
			return;
		}

		// OPEN EDGE (DOC-5 #12) — the refs exist now: the roster starts at its
		// top and the ring lands (no glide) on the seeded stop.
		if ( _openEdge )
		{
			_openEdge = false;
			if ( pickerRosterScroll != null ) pickerRosterScroll.ScrollOffset = new Vector2( 0f, 0f );
			gridScrollGlideTarget = -1f;
			_scrollFollowPending = false;
			ringWarm = 0;
		}

		// LANE: motion — EMBARK pressed: the blackout is the exit; the picker holds
		// still and deaf under it (IsVisible flips inside the blackout callback).
		if ( _isEmbarking ) { UpdateRing(); ApplyRingWave(); return; }

		// LANE: input — the key map lives in TickInput; only the TOP modal reads
		// keys (a ConfirmDialog over the picker owns them while it is up).
		if ( UIModalState.IsTopModal( "TeamPickerPopup" ) ) TickInput();
		if ( Closing ) return; // LANE: motion — Q / BACK just armed the latch; the ring must not re-show this frame

		if ( !IsKbMode ) SyncButtonHover();
		SyncHeaderKbFocus();
		UpdateScrollFollow();
		UpdateRing();
		ApplyRingWave();
	}

	/// <summary>
	/// Pre-fill the team with, in order of preference:
	/// 1. The last team used for this zone (from save data)
	/// 2. ExpeditionManager.SelectedTeam (persisted across in-session clicks)
	/// 3. Auto-pick: first 3 healthy beasts sorted by power
	/// All picks skip fainted beasts regardless of source. Returns true when
	/// source 1 (the last run's team) filled at least one slot — the cursor
	/// then opens on EMBARK (one Space re-runs the zone).
	/// </summary>
	private bool PreFillTeam( string zoneId )
	{
		_team = new() { null, null, null };
		var mm = MonsterManager.Instance;
		if ( mm == null ) return false;

		// 1) Last-team-per-zone
		var lastIds = GetSaveData()?.LastTeamPerZone?.TryGetValue( zoneId, out var ids ) == true ? ids : null;
		if ( lastIds != null && lastIds.Count > 0 )
		{
			int slot = 0;
			foreach ( var id in lastIds )
			{
				if ( slot >= 3 ) break;
				var m = mm.OwnedMonsters.FirstOrDefault( x => x.Id == id );
				if ( m == null || m.CurrentHP <= 0 ) continue;
				_team[slot++] = m;
			}
			if ( _team.Any( t => t != null ) ) return true;
		}

		// 2) Current SelectedTeam (alive)
		var current = ExpeditionManager.Instance?.SelectedTeam?
			.Where( m => m != null && m.CurrentHP > 0 )
			.ToList() ?? new();
		if ( current.Count > 0 )
		{
			for ( int i = 0; i < Math.Min( 3, current.Count ); i++ ) _team[i] = current[i];
			return false;
		}

		// 3) Auto-pick best (silent — the LEFT zone's own rung is the entrance; LANE: motion)
		AutoFillCore( false );
		return false;
	}

	/// <summary>
	/// Called after _team is populated by ANY of the PreFillTeam paths. Fires the
	/// tutorial event if at least one slot got filled — new players have a
	/// single starter that always auto-fills, never goes through the click path.
	/// </summary>
	private void NotifyTutorialIfTeamPopulated()
	{
		if ( _team.Any( t => t != null ) )
		{
			Beastborne.Core.TutorialManager.Instance?.NotifyEvent( "team.beast-added" );
		}
	}

	// ═══════════════════════════════════════════════════════════════
	// TEAM / ROSTER CLICK HANDLING
	// ═══════════════════════════════════════════════════════════════

	private void OnRosterCardClicked( Monster m )
	{
		if ( m == null || m.CurrentHP <= 0 )
		{
			SoundManager.PlayDeny();
			return;
		}

		// If already picked, un-pick (remove from team).
		int existing = _team.FindIndex( t => t?.Id == m.Id );
		if ( existing >= 0 )
		{
			_team[existing] = null;
			StampPickPop( m.Id, false ); // LANE: motion — the card lifts back, the slot crosses to empty
			StampEmptied( existing );
			SoundManager.PlayClick();
			return;
		}

		// Otherwise, add to the first empty slot. A FULL team denies (LANE:
		// input 2026-09-04 — one honest rule for click and Space alike: un-pick
		// a card or a slot first; the run-0 silent swap-into-slot-0 is gone).
		int empty = _team.FindIndex( t => t == null );
		if ( empty < 0 )
		{
			SoundManager.PlayDeny();
			return;
		}
		_team[empty] = m;
		StampPickPop( m.Id, true ); // LANE: motion — the card dims + the check lands, the slot flashes + its tile fades in
		StampLanded( empty );
		SoundManager.PlayClick();

		// Tutorial: notify that a beast was added to the team.
		Beastborne.Core.TutorialManager.Instance?.NotifyEvent( "team.beast-added" );
	}

	private void OnTeamSlotClicked( int idx )
	{
		if ( idx < 0 || idx >= _team.Count ) return;
		if ( _team[idx] == null ) return;
		// If a drop just fired on this slot, onclick will also fire (mousedown
		// and mouseup were both on this element). Suppress the default remove
		// behaviour when a drag committed here so drag-to-same-slot isn't
		// interpreted as "drag then click-to-clear."
		if ( _consumeNextClickForSlot == idx )
		{
			_consumeNextClickForSlot = null;
			return;
		}
		StampPickPop( _team[idx].Id, false ); // LANE: motion — the removal beats
		StampEmptied( idx );
		_team[idx] = null;
		SoundManager.PlayClick();
	}

	private int? _consumeNextClickForSlot;

	// ─── DRAG HANDLERS ─────────────────────────────────────────────

	private void OnSlotMouseDown( int idx )
	{
		if ( idx < 0 || idx >= _team.Count ) return;
		var beast = _team[idx];
		if ( beast == null ) return;
		_dragSource = beast;
		_dragFromSlot = idx;
	}

	private void OnRosterCardMouseDown( Monster m )
	{
		if ( m == null || m.CurrentHP <= 0 ) return;
		_dragSource = m;
		_dragFromSlot = null;
	}

	private void OnSlotMouseOver( int idx )
	{
		OnHover( "slot-" + idx );
		if ( !IsKbMode && idx >= 0 && idx < 3 ) SetLeft( (LeftStop)idx ); // hover = the same cursor (DOC-5 #6)
		if ( _dragSource == null ) return;
		_dragHoverSlot = idx;
	}

	private void OnSlotMouseUp( int idx )
	{
		if ( _dragSource == null ) return;
		if ( idx < 0 || idx >= _team.Count )
		{
			CancelDragIfAny();
			return;
		}

		if ( _dragFromSlot.HasValue )
		{
			// Slot → slot: swap regardless of whether target is filled or empty.
			// Same-slot drag is a no-op (and onclick will fire normally).
			if ( _dragFromSlot.Value == idx )
			{
				CancelDragIfAny();
				return;
			}
			var tmp = _team[idx];
			_team[idx] = _team[_dragFromSlot.Value];
			_team[_dragFromSlot.Value] = tmp;
			StampLanded( idx ); // LANE: motion — both ends re-land (or the source empties)
			if ( tmp != null ) StampLanded( _dragFromSlot.Value ); else StampEmptied( _dragFromSlot.Value );
		}
		else
		{
			// Roster → slot: place the dragged beast in the target, displacing
			// whatever was there. If the dragged beast was already picked in a
			// different slot, clear that other slot first (no duplicates).
			int existing = _team.FindIndex( t => t?.Id == _dragSource.Id );
			if ( existing >= 0 && existing != idx ) { _team[existing] = null; StampEmptied( existing ); } // LANE: motion
			_team[idx] = _dragSource;
			StampLanded( idx ); // LANE: motion — the drop lands like a pick
			StampPickPop( _dragSource.Id, true );
		}

		_consumeNextClickForSlot = idx;
		_dragSource = null;
		_dragFromSlot = null;
		_dragHoverSlot = null;
		SoundManager.PlayClick();
	}

	private void CancelDragIfAny()
	{
		if ( _dragSource == null && _dragHoverSlot == null ) return;
		_dragSource = null;
		_dragFromSlot = null;
		_dragHoverSlot = null;
	}

	private void AutoFill() => AutoFillCore( true ); // method group for BbButton.OnClick / F / dev_pickerfx

	// LANE: motion — `animate` false on the open pre-fill (the LEFT zone's own
	// rung is the entrance there); true from the button / F key: the slots
	// that were filled land in the 3-rung ladder, in fill order.
	private void AutoFillCore( bool animate )
	{
		var mm = MonsterManager.Instance;
		if ( mm == null ) return;
		var taken = _team.Where( t => t != null ).Select( t => t.Id ).ToHashSet();
		var candidates = mm.OwnedMonsters
			.Where( m => m != null && m.CurrentHP > 0 && !taken.Contains( m.Id ) )
			.OrderByDescending( m => m.PowerRating )
			.ToList();
		int added = 0;
		var addedSlots = new List<int>();
		for ( int i = 0; i < _team.Count; i++ )
		{
			if ( _team[i] != null ) continue;
			if ( added >= candidates.Count ) break;
			_team[i] = candidates[added++];
			addedSlots.Add( i );
		}
		if ( animate && addedSlots.Count > 0 ) StampAutoFill( addedSlots );
		SoundManager.PlayClick();

		// Tutorial: notify if AutoFill actually added at least one beast.
		if ( added > 0 )
		{
			Beastborne.Core.TutorialManager.Instance?.NotifyEvent( "team.beast-added" );
		}
	}

	private void ClearTeam()
	{
		for ( int i = 0; i < 3; i++ ) if ( _team[i] != null ) StampEmptied( i ); // LANE: motion — every filled slot crosses to empty
		_team = new() { null, null, null };
		SoundManager.PlayClick();
	}

	private bool CanEmbark() => _team.Any( m => m != null && m.CurrentHP > 0 );

	private bool _isEmbarking;

	private void OnEmbarkClicked()
	{
		if ( _isEmbarking ) return;
		if ( !CanEmbark() )
		{
			SoundManager.PlayDeny();
			return;
		}
		var liveTeam = _team.Where( m => m != null && m.CurrentHP > 0 ).ToList();
		var em = ExpeditionManager.Instance;
		if ( em == null || string.IsNullOrEmpty( PendingExpeditionId ) )
		{
			SoundManager.PlayDeny();
			return;
		}

		// Remember this team for next time we open the picker on this zone.
		// If save data isn't ready, skip the preset write and still embark —
		// losing the "last team per zone" convenience is fine; silently
		// blocking embark is not.
		var data = EnsureSaveData();
		if ( data != null )
		{
			data.LastTeamPerZone[PendingExpeditionId] = liveTeam.Select( m => m.Id ).ToList();
			SaveService.Instance?.MarkDirty( "teampresets" );
		}
		else
		{
			Log.Warning( "[TeamPickerPopup] Save data null at embark time; skipping team-preset write and proceeding with expedition." );
		}

		_isEmbarking = true;
		_embarkGoUntil = RealTime.Now + EmbarkGoWindow; // LANE: motion — the press flash (the ONE HDR tick), held under the blackout's fade-in
		SoundManager.PlayBattleStart();

		// Hand the whole cinematic off to BattleTransition's static orchestrator.
		// StartExpedition swaps WorldMapPanel out for ExpeditionPanel, which
		// destroys this picker — running the sequence on BattleTransition (a
		// persistent GameHUD child) keeps the async chain alive through the swap.
		var zoneId = PendingExpeditionId;
		var hardMode = _hardMode; // capture — the picker unmounts during the sequence
		_ = BattleTransition.PlayEmbarkSequence( () =>
		{
			// LANE: motion — the blackout IS the exit: the picker stays up (still,
			// deaf — Tick short-circuits on _isEmbarking) until the black covers it,
			// then IsVisible flips HERE. BattleTransition persists, so this runs
			// even though StartExpedition destroys the picker right after; with no
			// BattleTransition instance the sequence invokes this synchronously.
			IsVisible = false;
			em.SelectTeam( liveTeam );
			em.StartExpedition( zoneId, hardMode );
		} );
		// _isEmbarking stays true for this instance's remaining life; Show() re-arms it per open.
	}

	// ═══════════════════════════════════════════════════════════════
	// FILTER / SORT  (mirrors MonsterRosterPanel wiring)
	// ═══════════════════════════════════════════════════════════════

	private void OnElementChanged( string e ) { _currentFilter = e; _kbIndex = 0; ArmCardLadder(); if ( _zone == CursorZone.Grid ) RequestScrollFollow(); SoundManager.PlayClick(); } // LANE: motion — the list re-forms: re-cascade

	// Element-filter cycle order for R (and the Z/X twins).
	private static readonly string[] _elementFilterCycle =
		{ "all", "fire", "water", "earth", "wind", "electric", "ice", "nature", "metal", "shadow", "spirit", "neutral" };

	private void CycleElementFilter( int dir )
	{
		int i = System.Array.IndexOf( _elementFilterCycle, _currentFilter );
		if ( i < 0 ) i = 0;
		i = ( i + dir + _elementFilterCycle.Length ) % _elementFilterCycle.Length;
		OnElementChanged( _elementFilterCycle[i] );
	}
	private void OnSortChanged( string s ) { _currentSort = s; _kbIndex = 0; ArmCardLadder(); if ( _zone == CursorZone.Grid ) RequestScrollFollow(); SoundManager.PlayClick(); } // LANE: motion — re-cascade
	private void OnSortDirectionChanged( bool asc ) { _sortAscending = asc; _kbIndex = 0; ArmCardLadder(); if ( _zone == CursorZone.Grid ) RequestScrollFollow(); SoundManager.PlayClick(); } // LANE: motion — re-cascade

	// Copy of MonsterRosterPanel.GetFilteredMonsters (trimmed: no fusion/beastiary
	// modes, no name search) so filtering/sort behaviour reads identical.
	private List<Monster> GetFilteredMonsters()
	{
		var mm = MonsterManager.Instance;
		if ( mm == null ) return new();
		var monsters = mm.OwnedMonsters?.ToList() ?? new();

		if ( _currentFilter != "all" )
		{
			var elementType = _currentFilter switch
			{
				"fire" => ElementType.Fire,
				"water" => ElementType.Water,
				"earth" => ElementType.Earth,
				"wind" => ElementType.Wind,
				"electric" => ElementType.Electric,
				"ice" => ElementType.Ice,
				"nature" => ElementType.Nature,
				"metal" => ElementType.Metal,
				"shadow" => ElementType.Shadow,
				"spirit" => ElementType.Spirit,
				_ => ElementType.Neutral
			};
			monsters = monsters.Where( m => mm.GetSpecies( m.SpeciesId )?.Element == elementType ).ToList();
		}

		if ( _currentRarity != "all" )
		{
			var r = _currentRarity switch
			{
				"common" => Rarity.Common,
				"uncommon" => Rarity.Uncommon,
				"rare" => Rarity.Rare,
				"epic" => Rarity.Epic,
				"legendary" => Rarity.Legendary,
				"mythic" => Rarity.Mythic,
				_ => Rarity.Common
			};
			monsters = monsters.Where( m => mm.GetSpecies( m.SpeciesId )?.BaseRarity == r ).ToList();
		}

		monsters = _currentSort switch
		{
			"level" => _sortAscending ? monsters.OrderBy( m => m.Level ).ToList() : monsters.OrderByDescending( m => m.Level ).ToList(),
			"power" => _sortAscending ? monsters.OrderBy( m => m.PowerRating ).ToList() : monsters.OrderByDescending( m => m.PowerRating ).ToList(),
			"rarity" => _sortAscending
				? monsters.OrderBy( m => (int)(mm.GetSpecies( m.SpeciesId )?.BaseRarity ?? Rarity.Common) ).ToList()
				: monsters.OrderByDescending( m => (int)(mm.GetSpecies( m.SpeciesId )?.BaseRarity ?? Rarity.Common) ).ToList(),
			"recent" => _sortAscending ? monsters.OrderBy( m => m.CaughtAt ).ToList() : monsters.OrderByDescending( m => m.CaughtAt ).ToList(),
			"fav" => _sortAscending ? monsters.OrderBy( m => m.IsFavorite ).ThenBy( m => m.PowerRating ).ToList()
				: monsters.OrderByDescending( m => m.IsFavorite ).ThenByDescending( m => m.PowerRating ).ToList(),
			"name" => _sortAscending
				? monsters.OrderByDescending( m => m.Nickname ?? mm.GetSpecies( m.SpeciesId )?.Name ?? "" ).ToList()
				: monsters.OrderBy( m => m.Nickname ?? mm.GetSpecies( m.SpeciesId )?.Name ?? "" ).ToList(),
			_ => monsters
		};

		return monsters;
	}

	// ═══════════════════════════════════════════════════════════════
	// BEAST STATUS HELPERS
	// ═══════════════════════════════════════════════════════════════

	private bool HasLowPP( Monster m )
	{
		// MonsterMove only tracks CurrentPP — MaxPP lives on the MoveDefinition
		// in MoveDatabase. Any move at or below 25% of its max counts as "low".
		if ( m?.Moves == null ) return false;
		foreach ( var move in m.Moves )
		{
			if ( move == null ) continue;
			var def = MoveDatabase.GetMove( move.MoveId );
			if ( def == null || def.MaxPP <= 0 ) continue;
			if ( move.CurrentPP <= def.MaxPP / 4 ) return true;
		}
		return false;
	}

	// ═══════════════════════════════════════════════════════════════
	// PRESETS (keys 1/2/3 — the buttons were cut in run 1)
	// ═══════════════════════════════════════════════════════════════

	private TeamPresetSaveData GetSaveData() => SaveService.Instance?.CurrentBlob?.TeamPresets;

	private TeamPresetSaveData EnsureSaveData()
	{
		var blob = SaveService.Instance?.CurrentBlob;
		if ( blob == null ) return null;
		blob.TeamPresets ??= new TeamPresetSaveData();
		while ( blob.TeamPresets.Presets.Count < 3 ) blob.TeamPresets.Presets.Add( new TeamPreset() );
		return blob.TeamPresets;
	}

	private TeamPreset GetPreset( int idx )
	{
		var data = GetSaveData();
		if ( data?.Presets == null || idx < 0 || idx >= data.Presets.Count ) return null;
		return data.Presets[idx];
	}

	private string GetDefaultPresetName( int idx ) => idx switch
	{
		0 => "A",
		1 => "B",
		2 => "C",
		_ => "?"
	};

	private void SavePreset( int idx )
	{
		var data = EnsureSaveData();
		if ( data == null ) return;
		var preset = data.Presets[idx];
		preset.MonsterIds = _team.Where( m => m != null ).Select( m => m.Id ).ToList();
		preset.UpdatedTicks = DateTime.UtcNow.Ticks;
		if ( string.IsNullOrEmpty( preset.Name ) ) preset.Name = GetDefaultPresetName( idx );
		SaveService.Instance?.MarkDirty( "teampresets" );
		NotificationManager.Instance?.AddNotification(
			NotificationType.Success,
			"Preset saved",
			$"Team {preset.Name} stored." );
		SoundManager.PlaySuccess();
	}

	private void LoadPreset( int idx )
	{
		var preset = GetPreset( idx );
		if ( preset == null || preset.MonsterIds.Count == 0 )
		{
			SoundManager.PlayDeny();
			return;
		}
		var mm = MonsterManager.Instance;
		if ( mm == null ) return;

		var prevTeam = _team; // LANE: motion — slots that go empty cross over
		_team = new() { null, null, null };
		int slot = 0;
		var landed = new List<int>();
		foreach ( var id in preset.MonsterIds )
		{
			if ( slot >= 3 ) break;
			var m = mm.OwnedMonsters.FirstOrDefault( x => x.Id == id );
			if ( m == null ) continue; // silently skip released beasts
			_team[slot] = m;
			landed.Add( slot );
			slot++;
		}
		StampAutoFill( landed ); // LANE: motion — a preset lands like AUTO-FILL (the 3-rung ladder)
		for ( int i = 0; i < 3; i++ ) if ( prevTeam[i] != null && _team[i] == null ) StampEmptied( i );
		SoundManager.PlayClick();
	}

	// ═══════════════════════════════════════════════════════════════
	// RERENDER TRIGGERS — every field that paints (DOC-7 #22)
	// ═══════════════════════════════════════════════════════════════

	protected override int BuildHash()
	{
		var h = new HashCode();
		h.Add( IsVisible );
		h.Add( PendingExpeditionId );
		h.Add( _currentFilter );
		h.Add( _currentSort );
		h.Add( _currentRarity );
		h.Add( _sortAscending );
		foreach ( var t in _team )
		{
			h.Add( t?.Id ?? Guid.Empty );
			h.Add( t?.CurrentHP ?? -1 ); // slot HP bar + KO badge
		}
		// LANE: input — the one cursor (facts column + `.focused` + ring follow it)
		h.Add( lastInputDevice );
		h.Add( _zone );
		h.Add( _kbIndex );
		h.Add( _leftStop );
		h.Add( _headerCursor );
		h.Add( ringVisible );
		h.Add( ringWarm );
		h.Add( ringL ); h.Add( ringT ); h.Add( ringW ); h.Add( ringH );
		h.Add( EmbarkDenying );
		// LANE: motion — the windowed beats (a lapsing window must re-render to drop its class)
		h.Add( LadderArmed );
		h.Add( PickPopClass( _pickPopId ) );
		h.Add( Win( _landedUntil ) ? _landedMask : 0 );
		h.Add( Win( _emptiedUntil ) ? _emptiedMask : 0 );
		h.Add( Win( _afUntil ) ? (_afRung[0] + 1) * 16 + (_afRung[1] + 1) * 4 + (_afRung[2] + 1) : 0 );
		h.Add( SegPopClass() );
		h.Add( EmbarkGo );
		h.Add( Closing );
		h.Add( _hardMode );
		h.Add( IsHardUnlocked() );
		h.Add( _dragSource?.Id ?? Guid.Empty );
		h.Add( _dragHoverSlot ?? -1 );
		h.Add( _slotEditTestSpeciesId );
		h.Add( _slotEditDraggingId );
		var mm = MonsterManager.Instance;
		h.Add( mm?.OwnedMonsters?.Count ?? 0 );
		return h.ToHashCode();
	}
}
