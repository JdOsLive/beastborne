@namespace Beastborne.UI.Panels
@using Sandbox;
@using Sandbox.UI;
@using System;
@using System.Collections.Generic;
@using System.Linq;
@using System.Threading.Tasks;
@using Beastborne.Core;
@using Beastborne.Data;
@using Beastborne.Systems;
@using Beastborne.UI;
@using Beastborne.UI.Components;
@using Beastborne.UI.Primitives;
@inherits Panel

@*
	TEAM PICKER — option B (user ruling 2026-09-04): a 1720×920 popup over
	the dimmed map with a FACTS column for the beast under the cursor.
	LAYOUT lane, pipeline run 5 part 2. Design: expedition-revision-2.html §2
	(B) + the run-1 expedition-mock-page.html slot anatomy (.sl1).

	ZONE MAP (padding-box — declared width/height INCLUDES padding, borders
	add on top; DOC-1 #4):
	  shield  rgba(4,6,15,.8) full-viewport, flex-centres the modal (NEVER
	          translate(-50%,-50%) on the modal — DOC-7 #15, the 6-hour bug)
	  modal   1720×920 r22 pad 24 → inner lane 1672 × 872
	  header  1672×74: identity (kicker 14 · title 38/42 · sub 16 + 2 = 74)
	          · toolbar right slot (FilterBar ELEMENT · SORT · dir · R CYCLE ·
	          BACK Q) — filters live in the header's right slot (DOC-1 #8)
	  gap 24
	  body    1672×774 row: LEFT 400 · 24 · CENTER 824 · 24 · FACTS 400
	          400 + 24 + 824 + 24 + 400 = 1672 ✓ (zero slack)
	    LEFT 400 column: team row 32 · 16 · slots 3×176 + 2×16 = 560 · 24 ·
	          controls 44 (AUTO-FILL 194 · 12 · NORMAL|HARD 194) · 42 ·
	          EMBARK 56  →  32+16+560+24+44+42+56 = 774 ✓
	    CENTER 824 = wrap grid 814 (5 × 150 + 4 × 16) + 10 scrollbar lane;
	          rows 168 + 16 gap → 4 rows = 720 of 774 (scrolls)
	    FACTS 400: identity 120 (hero 120×120 · 16 · text 264) · 24 · MOVES
	          kicker 16 · 8 · 4 rows 32 + 3×8 = 152 · 24 · TRAIT 40 = 384;
	          the rest is the modal surface (display-only column, never a
	          cursor stop — rev-2 §2 keys)

	Why 5-wide, not 6: 6 × 150 + 5 × 12 = 960 needs CENTER ≥ 972 with a
	scrollbar lane → FACTS 252, under the briefed 300; 5-wide at gap 16 =
	814 + 10 lane = 824 and the remainder goes to FACTS as 400 (mirrors
	LEFT — symmetric wings), not into a void beside the grid.

	Kept from the flow (unchanged): Show()/Close()/IsVisible, PreFillTeam,
	drag-drop between roster and slots, hard-mode gate, presets on 1/2/3,
	C clear, F auto-fill, the embark hand-off to BattleTransition.
	Cut (run-1 cuts stand): zone hero + lore, search, rarity filter, preset
	buttons, CLEAR button, the Z/X hint row, coverage pill, "ROSTER n / N".
*@

@{
	var expedition = ExpeditionManager.Instance?.GetExpedition( PendingExpeditionId );
}

<root class="@RootClass" onmousemove=@OnRootMouseMove>
	<div class="tp-shield" onclick=@Close></div>

	@if ( IsVisible && expedition != null )
	{
		var filled = _team.Count( m => m != null );
		var roster = GetFilteredMonsters();
		var recommendedLevel = expedition.BaseEnemyLevel;
		var teamPower = (int)_team.Where( m => m != null ).Sum( m => m.PowerRating );
		var hardUnlocked = IsHardUnlocked();
		var focus = GetFocusedBeast( roster );

		<div class="tp-modal" @ref="modalRef">
			@* ═══ DEV: SLOT POSITION EDITOR ════════════════════════
			   Hidden behind ShowSlotEditor. Retained verbatim (dev tool).
			   NOTE 2026-09-04: the slot art now uses the house integer-fit /
			   viewport-crop (FitStyle) instead of CardScale/CardOffset, so
			   the editor's Scale/Offset no longer drive this surface — it
			   still edits the shared species data the Beastbook reads. *@
			@if ( ShowSlotEditor )
			{
				@{
					var allTestable = GetAllTestableSpecies();
					var currentIdx = string.IsNullOrEmpty( _slotEditTestSpeciesId )
						? -1
						: allTestable.FindIndex( s => s.Id == _slotEditTestSpeciesId );
					var currentSp = currentIdx >= 0 ? allTestable[currentIdx] : null;
				}
				<div class="slot-editor-toolbar">
					<div class="set-label">SLOT</div>
					<button class="set-btn nav" onclick=@SlotEditPrevSpecies>
						<iconify icon="lucide:chevron-left" Size=@(14) Color="#cbd5e1" />
					</button>
					<div class="set-current-species">
						<span>@(currentSp?.Name ?? "OFF")</span>
					</div>
					<button class="set-btn nav" onclick=@SlotEditNextSpecies>
						<iconify icon="lucide:chevron-right" Size=@(14) Color="#cbd5e1" />
					</button>
					<button class="set-btn nav" onclick=@SlotEditClearTest>
						<iconify icon="lucide:x" Size=@(13) Color="#f87171" />
					</button>
					@if ( !string.IsNullOrEmpty( _slotEditTestSpeciesId ) )
					{
						<button class="set-btn save" onclick=@PrintSlotArt>
							<iconify icon="lucide:save" Size=@(13) Color="#4ade80" />
							<span>SAVE</span>
						</button>
						<button class="set-btn reset" onclick=@ResetSlotArt>
							<iconify icon="lucide:refresh-ccw" Size=@(13) Color="#f87171" />
							<span>RESET</span>
						</button>
						<div class="set-hint">
							<span>drag · scroll</span>
							@if ( _slotArtOverrides.Count > 0 )
							{
								<span class="set-count">@_slotArtOverrides.Count edited</span>
							}
						</div>
					}
				</div>
			}

			@* ═══ HEADER 1672×74 — identity left, filters + BACK in the right
			   slot (the Bag .bag-toolbar recipe). On the modal surface, no slab
			   under the title (DOC-1 #7). *@
			<div class="tp-header">
				<div class="tp-identity">
					<span class="tp-kicker">EXPEDITION</span>
					<span class="tp-title">@expedition.Name</span>
					<div class="tp-sub-row">
						<span class="tp-sub-lv">@LevelText( expedition )</span>
						@if ( _hardMode )
						{
							<span class="tp-sub-dot">·</span>
							<span class="tp-sub-hard">HARD</span>
						}
					</div>
				</div>

				@* LANE: input (wired 2026-09-04) — the HEADER zone of the cursor
				   graph: W off the grid's top row (or off slot 0) lands here; A/D
				   walk ELEMENT · SORT · dir (`.kb-focused` slab, no ring — the Bag
				   recipe, stamped per tick by SyncHeaderKbFocus); Space opens a
				   menu and FilterBar.HandleKeyboard owns W/S/Space/Q/A/D inside it;
				   S returns to where you left; Q closes the picker (an open menu
				   first). BACK is a Q cap, not a stop. KbMode = the page's ONE
				   device flag (DOC-5 #5). *@
				<div class="tp-toolbar" @ref="toolbarRef">
					@* The shipped ELEMENT dropdown (ElementItems + the two-tone
					   active chip) — R cycles it (CycleElementFilter). Sort is a
					   custom beast list so "name" is a plain sort, never the
					   name-search popup (search is cut). No rarity, no search. *@
					<FilterBar @ref="filterBar"
							   CurrentElement=@_currentFilter
							   OnElementChanged=@OnElementChanged
							   ItemSorts=@BeastSorts
							   CurrentSort=@_currentSort
							   SortAscending=@_sortAscending
							   OnSortChanged=@OnSortChanged
							   OnSortDirectionChanged=@OnSortDirectionChanged
							   ShowRarityFilter=@false
							   ShowSearchChip=@false
							   KbMode=@IsKbMode
							   OnKbSideStep=@OnFilterBarSideStep />
					<div class="tp-filter-hint">
						<span class="tp-cap">R</span>
						<span class="tp-filter-hint-text">CYCLE</span>
					</div>
					<div class="tp-back" onclick=@Close onmouseover=@(() => OnHover("tp-back"))>
						<span class="tp-back-label">BACK</span>
						<span class="tp-back-cap">Q</span>
					</div>
				</div>
			</div>

			@* ═══ BODY 1672×774 — LEFT 400 · 24 · CENTER 824 · 24 · FACTS 400 *@
			<div class="tp-body">

				@* ── LEFT 400: team row · 3 slots · controls · EMBARK ── *@
				<div class="tp-left">
					<div class="tp-team-row">
						<span class="tp-team-kicker">YOUR TEAM</span>
						<span class="tp-team-count">@TeamCountText( filled )</span>
						<div class="tp-team-line"></div>
						<span class="tp-team-pwr-k">PWR</span>
						<span class="tp-team-pwr-v">@teamPower</span>
					</div>

					@* LANE: input (wired) — LEFT zone stops 0-2: W/S walk the column
					   (slot 0 → header above, controls row below), D → the grid's
					   nearest row by Y, Space removes the beast (an empty slot's Space
					   walks you to the roster). Hover parks the same cursor here in
					   mouse mode. `.focused` = the slab step; the living ring wraps it. *@
					<div class="tp-slots" @ref="slotsRef" onmouseup=@CancelDragIfAny>
						@for ( int i = 0; i < 3; i++ )
						{
							var slotIdx = i;
							var beast = _team[slotIdx];
							var dragHover = _dragHoverSlot == slotIdx && _dragSource != null;
							var editTestSpecies = !string.IsNullOrEmpty( _slotEditTestSpeciesId )
								? MonsterManager.Instance?.GetSpecies( _slotEditTestSpeciesId )
								: null;
							var species = editTestSpecies != null
								? editTestSpecies
								: ( beast != null ? MonsterManager.Instance?.GetSpecies( beast.SpeciesId ) : null );

							@* LANE: motion — SlotFxClass: `landed` (pick / drop, .4s) · `emptied`
							   (remove, .3s) · `tp-af0-2` (AUTO-FILL / preset ladder, .5s). Windowed
							   because `.focused` flips this class string per hop (= remount) —
							   an un-windowed mount keyframe would replay on every cursor move. *@
							<div class="tp-slot @(species != null ? "filled" : "empty") @(dragHover ? "drag-hover" : "") @(IsLeftStop( slotIdx ) ? "focused" : "") @SlotFxClass( slotIdx )"
								 onclick=@(() => OnTeamSlotClicked(slotIdx))
								 onmousedown=@(() => OnSlotMouseDown(slotIdx))
								 onmouseup=@(() => OnSlotMouseUp(slotIdx))
								 onmouseover=@(() => OnSlotMouseOver(slotIdx))>
								@if ( species != null )
								{
									var hpPct = beast != null ? Math.Clamp( beast.HPPercent, 0f, 1f ) : 1f;
									var hpClass = hpPct > 0.6f ? "healthy" : hpPct > 0.25f ? "wounded" : "critical";
									var hpPx = (int)Math.Round( 150f * hpPct ); // bar is pinned 150 — px, never %
									var isKo = beast != null && beast.CurrentHP <= 0;
									var lowLevel = beast != null && !isKo && beast.Level < recommendedLevel - 5;
									var ppLow = beast != null && !isKo && HasLowPP( beast );
									var editing = ShowSlotEditor && !string.IsNullOrEmpty( _slotEditTestSpeciesId );

									@* Beast tile 128×128 r11 — integer scale for 64/128 sources,
									   viewport crop for 256s (DOC-6 #11/#13). pointer-inert unless
									   the dev editor is live. *@
									<div class="tp-slot-art @(editing ? "slot-edit" : "")"
										 onmousedown=@(() => StartDragSlotArt(species))
										 onmouseover=@(() => OnSlotEditCardEnter(species?.Id))
										 onmouseout=@(() => OnSlotEditCardLeave(species?.Id))>
										<img class="tp-sprite" src="@(species.IconPath ?? "ui/monsters/placeholder.png")" style="@FitStyle( species, 128, 128 )" />
									</div>

									<div class="tp-slot-info">
										<div class="tp-slot-name-row">
											<span class="tp-slot-name">@BeastName( beast, species )</span>
											@if ( isKo )
											{
												<div class="tp-badge ko"><span class="tp-badge-text">KO</span></div>
											}
											else if ( lowLevel )
											{
												<div class="tp-badge under"><span class="tp-badge-text">UNDER LV</span></div>
											}
											@if ( ppLow )
											{
												<div class="tp-badge pp"><span class="tp-badge-text">PP LOW</span></div>
											}
										</div>
										<div class="tp-slot-meta">
											<span class="tp-slot-lv">@LevelText( beast )</span>
											<img class="tp-el-icon" src="ui/icons/elements/background/@(ElementKey( species.Element )).png" />
											@if ( species.SecondaryElement.HasValue && species.SecondaryElement.Value != species.Element )
											{
												<img class="tp-el-icon" src="ui/icons/elements/background/@(ElementKey( species.SecondaryElement.Value )).png" />
											}
											<span class="tp-slot-pwr">@PwrText( beast )</span>
										</div>
										<div class="tp-slot-hp">
											<div class="tp-hp-bar">
												<div class="tp-hp-fill @hpClass" style="width: @(hpPx)px;"></div>
											</div>
											<span class="tp-hp-text">@HpText( beast )</span>
										</div>
									</div>

									<div class="tp-slot-x">
										<iconify class="tp-slot-x-glyph" icon="lucide:x" Size=@(16) Color="rgba(214, 206, 236, 0.7)" />
									</div>
								}
								else
								{
									<iconify class="tp-slot-plus" icon="lucide:plus" Size=@(28) Color="rgba(214, 206, 236, 0.35)" />
									<span class="tp-slot-empty-label">PICK A BEAST</span>
								}
							</div>
						}
					</div>

					@* Controls 400×44: AUTO-FILL · F (secondary 194) · NORMAL | HARD
					   segmented 194. Pressables are rounded slabs — never skewed. *@
					<div class="tp-controls">
						<BbButton @ref="autoFillRef" Tier="secondary" Size=@(44) Label="AUTO-FILL" KeyCap="F" Class="tp-autofill" OnClick=@AutoFill />
						@* LANE: input — ONE stop for the pair: A/D arm NORMAL/HARD while
						   focused (A on NORMAL walks to AUTO-FILL, D on HARD/locked walks
						   to the grid); Space toggles. Ring r26 wraps the 44 slab. *@
						<div class="tp-seg @(IsLeftStop( LeftStop.Difficulty ) ? "focused" : "") @SegPopClass()" @ref="segRef">
							<div class="tp-seg-opt @(!_hardMode ? "active" : "")"
								 onclick=@(() => SetHardMode(false))
								 onmouseover=@(() => OnSegHover("diff-normal"))>
								<span class="tp-seg-label">NORMAL</span>
							</div>
							<div class="tp-seg-opt hard @(_hardMode ? "active" : "") @(hardUnlocked ? "" : "locked")"
								 onclick=@(() => SetHardMode(true))
								 onmouseover=@(() => OnSegHover("diff-hard"))>
								@if ( !hardUnlocked )
								{
									<iconify class="tp-seg-glyph" icon="lucide:lock" Size=@(12) Color="rgba(214, 206, 236, 0.6)" />
								}
								<span class="tp-seg-label">HARD</span>
								@if ( hardUnlocked )
								{
									<span class="tp-seg-bonus">+100%</span>
								}
							</div>
						</div>
					</div>

					@* EMBARK 400×56 — the ONE gold primary; locked it stays big and
					   dims (DOC-1 #9). LANE: input (wired) — the LEFT column's foot:
					   Space/Enter/E embark when the cursor is here (the universal
					   confirm — no cap; DOC-5 #1), an invalid team gets a deny blip
					   and the label reads the reason for 1.2s (`.deny` is the MOTION
					   hook). The picker opens with the cursor HERE when the last run's
					   team came back valid, else on the grid's first card. *@
					<BbButton @ref="embarkRef" Tier="primary" Size=@(56) Label=@GetEmbarkLabel( filled ) Disabled=@(!CanEmbark()) Class=@EmbarkClass() OnClick=@OnEmbarkClicked />
				</div>

				@* ── CENTER 824: the roster scroll grid — cards are DIRECT children
				   of the scroll (DOC-1 #12), 5-wide, width + max-width pinned. *@
				<div class="tp-center">
					<div class="tp-grid @(roster.Count == 0 ? "empty" : "")" @ref="pickerRosterScroll">
						@if ( roster.Count == 0 )
						{
							<span class="tp-empty-title">@EmptyGridTitle()</span>
							<span class="tp-empty-sub">R cycles the element</span>
						}
						else
						{
							@for ( int ci = 0; ci < roster.Count; ci++ )
							{
								var cardIdx = ci;
								var beast = roster[cardIdx];
								var sp = MonsterManager.Instance?.GetSpecies( beast.SpeciesId );
								var isPicked = _team.Any( t => t?.Id == beast.Id );
								var isKo = beast.CurrentHP <= 0;
								var kbFocused = _zone == CursorZone.Grid && _kbIndex == cardIdx;
								@* LANE: input (wired) — GRID zone, true 2-D: W/S rows (scroll-
								   follow glide), A/D clamp; W off row 0 → header, A off column 0 →
								   LEFT nearest by Y, D off column 4 is silent (FACTS is display-
								   only). `.focused` is the ONE cursor class in both modes (hover
								   moves the same index — DOC-5 #6); the living ring rides it and
								   self-hides when the card scrolls out (scroll never clips it). *@
								@* LANE: motion — CardLadderClass: `tp-rrN` while the ladder is armed
								   (open / element / sort — the list re-forms); the cursor card is
								   exempt (its class flips per hop). PickPopClass: `pick-pop` /
								   `unpick-pop` windowed .35s on the beast just (un)picked. *@
								<div class="tp-card @(isPicked ? "picked" : "") @(isKo ? "ko" : "") @(kbFocused ? "focused" : "") @CardLadderClass( cardIdx, kbFocused ) @PickPopClass( beast.Id )"
									 onclick=@(() => OnRosterCardClicked(beast))
									 onmousedown=@(() => OnRosterCardMouseDown(beast))
									 onmouseover=@(() => OnCardHover(cardIdx))>
									<div class="tp-card-art">
										<img class="tp-sprite" src="@(sp?.IconPath ?? "ui/monsters/placeholder.png")" style="@FitStyle( sp, 150, 104 )" />
									</div>
									<div class="tp-card-pwr">
										<span class="tp-card-pwr-k">PWR</span>
										<span class="tp-card-pwr-v">@beast.PowerRating</span>
									</div>
									<div class="tp-card-foot">
										<span class="tp-card-name">@BeastName( beast, sp )</span>
										@if ( sp != null )
										{
											<img class="tp-el-icon" src="ui/icons/elements/background/@(ElementKey( sp.Element )).png" />
										}
									</div>
									<div class="tp-card-lv"><span class="tp-card-lv-text">@LevelText( beast )</span></div>
									@if ( isPicked )
									{
										<div class="tp-card-check">
											<iconify class="tp-card-check-glyph" icon="lucide:check" Size=@(12) Color="#04160a" />
										</div>
									}
									@if ( isKo )
									{
										<div class="tp-card-ko"><span class="tp-card-ko-text">KO</span></div>
									}
								</div>
							}
						}
					</div>
				</div>

				@* ── FACTS 400: the beast under the cursor (hover, else the kb card).
				   Display-only — never a cursor stop. identity → moves → trait
				   (DOC-6 #14). LANE: motion — a swap fade when `focus` changes. *@
				<div class="tp-facts">
					@if ( focus == null )
					{
						<span class="tp-facts-empty-title">@EmptyGridTitle()</span>
						<span class="tp-facts-empty-sub">R cycles the element filter</span>
					}
					else
					{
						var fsp = MonsterManager.Instance?.GetSpecies( focus.SpeciesId );
						var fel = fsp != null ? ElementKey( fsp.Element ) : "neutral";
						var ftone = BbTokens.Element( fel );
						var fkey = "fk-" + focus.Id.ToString( "N" ); // LANE: motion — the render key: a class change IS a remount (DOC-4 #5), so the art + words replay their 0.12s crossfade per beast

						<div class="tp-facts-id">
							@* Framed beast tile — the pennant fill (page accent blended .70
							   toward the slab, DOC-6 #11). LANE: color — the blend value. *@
							<div class="tp-facts-hero" style="background-color: @HeroFill();">
								<img class="tp-sprite tp-facts-art @fkey" src="@(fsp?.IconPath ?? "ui/monsters/placeholder.png")" style="@FitStyle( fsp, 120, 120 )" />
							</div>
							<div class="tp-facts-text tp-facts-swap @fkey">
								<span class="tp-facts-name">@BeastName( focus, fsp )</span>
								@* LANE: color — element two-tone from BbTokens.Element (fill + rim ink). *@
								<div class="tp-el-chip" style="background-color: @ftone.Fill;">
									<img class="tp-el-icon" src="ui/icons/elements/background/@(fel).png" />
									<span class="tp-el-chip-label" style="color: @ftone.Rim;">@fel.ToUpperInvariant()</span>
								</div>
								<div class="tp-facts-line">
									<span class="tp-facts-lv">@LevelText( focus )</span>
									<span class="tp-facts-dot">·</span>
									<span class="tp-facts-pwr">@PwrText( focus )</span>
									<span class="tp-facts-dot">·</span>
									<span class="tp-facts-hp">@("HP " + HpText( focus ))</span>
								</div>
							</div>
						</div>

						<span class="tp-facts-kicker">MOVES</span>
						<div class="tp-moves tp-facts-swap @fkey">
							@for ( int mi = 0; mi < Monster.MaxMoves; mi++ )
							{
								var mv = focus.Moves != null && mi < focus.Moves.Count ? focus.Moves[mi] : null;
								var def = mv != null ? MoveDatabase.GetMove( mv.MoveId ) : null;
								var mtone = BbTokens.Element( def != null ? ElementKey( def.Element ) : "" );
								<div class="tp-move @(def == null ? "none" : "")">
									@* LANE: color — the element seam rim. *@
									<div class="tp-move-seam" style="background-color: @(def != null ? mtone.Rim : "rgba(214, 206, 236, 0.15)");"></div>
									<span class="tp-move-name">@(def?.Name ?? "—")</span>
									@if ( def != null )
									{
										<span class="tp-move-pwr">@MovePwrText( def )</span>
										<span class="tp-move-pp">@MovePpText( mv, def )</span>
									}
								</div>
							}
						</div>

						<div class="tp-trait tp-facts-swap @fkey">
							<span class="tp-trait-k">TRAIT</span>
							<span class="tp-trait-v">@TraitText( focus )</span>
						</div>
					}
				</div>
			</div>

			@* LANE: input — THE LIVING VIOLET RING, the one cursor (the Bag/hub
			   recipe: real bordered child, `4px solid #9b6cff * 5`, r26 = host 16
			   + inset 10; L/T = host − 10 + 4, W/H = host + 20 − 8). Absolute in
			   the modal (no padding-box bias: the modal has no border), z 400 —
			   above both columns, under the header (500) so an open menu paints
			   over it. Hidden on the HEADER (`.kb-focused` there), while a menu
			   is open, and when its grid card scrolls out of the viewport. *@
			<div @ref="ringRef" class="@RingClass()"
				 style="left: @(ringL)px; top: @(ringT)px; width: @(ringW)px; height: @(ringH)px;"></div>
		</div>

		@* Drag shield — fullscreen overlay during slot-art drag (dev editor). *@
		@if ( !string.IsNullOrEmpty( _slotEditDraggingId ) )
		{
			<div class="slot-edit-drag-shield"
				 onmousemove=@OnSlotEditDragMove
				 onmouseup=@OnSlotEditDragEnd></div>
		}
	}
</root>

@code {
	public static TeamPickerPopup Instance { get; private set; }
	public static new bool IsVisible { get; private set; }
	public static string PendingExpeditionId { get; private set; }

