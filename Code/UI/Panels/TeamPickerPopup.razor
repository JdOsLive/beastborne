	// ═══════════════════════════════════════════════════════════════
	// LANE: input (2026-09-04) — ONE CURSOR, ONE DEVICE FLAG (DOC-5 #5/#6).
	// Zones: HEADER (FilterBar ELEMENT · SORT · dir — `.kb-focused` slab, no
	// ring) · LEFT (slot 0-2 · AUTO-FILL · NORMAL|HARD · EMBARK — ring) · GRID
	// (5-wide cards — ring + scroll-follow glide). FACTS is display-only,
	// never a stop. Hover moves the SAME cursor in mouse mode; any nav /
	// confirm key takes the keyboard and stamps the mouse position; the mouse
	// reclaims only after REAL travel (≥3px, root onmousemove) and the element
	// already under it becomes the cursor (last input wins). Hover handlers
	// ignore events in kb mode (DOC-5 #15 — scroll-follow fires synthetic
	// hovers under a parked cursor).
	//
	// GRAPH (spatially honest — W/S follows the vertical order on screen):
	//   HEADER  [ELEMENT] ⇄A/D⇄ [SORT] ⇄ [dir]      S → back where you left
	//     ↑W (grid row 0 · slot 0)
	//   LEFT    slot0 → slot1 → slot2 → {AUTO-FILL ⇄D⇄ NORMAL|HARD} → EMBARK
	//           D off any LEFT stop → the grid's first-column card nearest by Y
	//   GRID    W/S rows · A/D clamp · A off column 0 → LEFT stop nearest by Y
	//           D off column 4 silent (FACTS) · S off the last row silent
	// ═══════════════════════════════════════════════════════════════
	private enum InputDevice { Mouse, Keyboard }
	private enum CursorZone { Grid, Left, Header }
	private enum LeftStop { Slot0 = 0, Slot1 = 1, Slot2 = 2, AutoFill = 3, Difficulty = 4, Embark = 5 }

	private InputDevice lastInputDevice = InputDevice.Mouse;
	private bool IsKbMode => lastInputDevice == InputDevice.Keyboard;
	private Vector2 _kbTakeoverMousePos = new Vector2( -9999f, -9999f );
	private string RootClass => "team-picker-root " + (IsVisible ? "visible " : "") + (Closing ? "closing " : "") + (IsKbMode ? "kbd-mode" : "mouse-mode"); // LANE: motion — `.closing` = the 0.12s exit latch

	private const int CARDS_PER_ROW = 5; // CENTER 824 = 5 × 150 + 4 × 16 + 10 lane
	private CursorZone _zone = CursorZone.Grid;
	private int _kbIndex = 0;                                // GRID card (render order of GetFilteredMonsters)
	private LeftStop _leftStop = LeftStop.Embark;            // LEFT stop
	private LeftStop _controlsMemory = LeftStop.Difficulty;  // which half of the 44 row W/S land on
	private int _headerCursor = 0;                           // index into CollectHeaderControls()
	private CursorZone _headerReturnZone = CursorZone.Grid;  // S from the header goes back where you left
	private bool _openEdge;                                  // consumed by Tick once the refs exist
	private string _hoveredKey;

