@namespace Beastborne.UI.Panels
@using Sandbox;
@using Sandbox.UI;
@using System;
@using System.Collections.Generic;
@using System.Linq;
@using System.Threading.Tasks;
@using Beastborne.Core;
@using Beastborne.Data;
@using Beastborne.Systems;
@using Beastborne.UI.Components;
@inherits Panel

@{
	var expedition = ExpeditionManager.Instance?.GetExpedition( PendingExpeditionId );
}

<root class="team-picker-root @_rootVisibleClass">
	<div class="picker-overlay" onclick=@Close></div>

	@if ( IsVisible && expedition != null )
	{
		var filled = _team.Count( m => m != null );
		var roster = GetFilteredMonsters();
		var coverage = GetTeamCoverage( expedition.Element );
		var recommendedLevel = expedition.BaseEnemyLevel;

		<div class="picker-modal">
			@* ═══ DEV: SLOT POSITION EDITOR ════════════════════════
			   Hidden behind ShowSlotEditor. Pick any species (whether
			   you own it or not) and it renders in all 3 team slots
			   for visual positioning checks. Drag the sprite on a
			   slot to adjust CardOffsetX/Y; mouse wheel scales the
			   sprite. Same data the Beastbook editor edits — saving
			   updates both surfaces. SAVE → CONSOLE dumps overrides
			   as paste-ready C# for MonsterManager.cs. *@
			@if ( ShowSlotEditor )
			{
				@{
					var allTestable = GetAllTestableSpecies();
					var currentIdx = string.IsNullOrEmpty( _slotEditTestSpeciesId )
						? -1
						: allTestable.FindIndex( s => s.Id == _slotEditTestSpeciesId );
					var currentSp = currentIdx >= 0 ? allTestable[currentIdx] : null;
				}
				<div class="slot-editor-toolbar">
					<div class="set-label">SLOT</div>
					<button class="set-btn nav" onclick=@SlotEditPrevSpecies>
						<iconify icon="lucide:chevron-left" Size=@(14) Color="#cbd5e1" />
					</button>
					<div class="set-current-species">
						<span>@(currentSp?.Name ?? "OFF")</span>
					</div>
					<button class="set-btn nav" onclick=@SlotEditNextSpecies>
						<iconify icon="lucide:chevron-right" Size=@(14) Color="#cbd5e1" />
					</button>
					<button class="set-btn nav" onclick=@SlotEditClearTest>
						<iconify icon="lucide:x" Size=@(13) Color="#f87171" />
					</button>
					@if ( !string.IsNullOrEmpty( _slotEditTestSpeciesId ) )
					{
						<button class="set-btn save" onclick=@PrintSlotArt>
							<iconify icon="lucide:save" Size=@(13) Color="#4ade80" />
							<span>SAVE</span>
						</button>
						<button class="set-btn reset" onclick=@ResetSlotArt>
							<iconify icon="lucide:refresh-ccw" Size=@(13) Color="#f87171" />
							<span>RESET</span>
						</button>
						<div class="set-hint">
							<span>drag · scroll</span>
							@if ( _slotArtOverrides.Count > 0 )
							{
								<span class="set-count">@_slotArtOverrides.Count edited</span>
							}
						</div>
					}
				</div>
			}

			<!-- ═══ HEADER ═══ -->
			<div class="picker-header">
				<div class="ph-left">
					<div class="ph-kicker">EMBARK</div>
					<div class="ph-title-row">
						<span class="ph-title">@expedition.Name</span>
						@if ( expedition.HasBoss )
						{
							<div class="ph-boss-chip">
								<iconify icon="lucide:skull" Size=@(13) Color="#fca5a5" />
								<span>BOSS</span>
							</div>
						}
					</div>
					<div class="ph-meta-row">
						<span class="ph-meta-pill">
							<iconify icon="lucide:swords" Size=@(12) Color="#fde68a" />
							<span>Lv @recommendedLevel</span>
						</span>
						<span class="ph-meta-pill">
							<iconify icon="lucide:layers" Size=@(12) Color="#c4b5fd" />
							<span>@expedition.Waves waves</span>
						</span>
					</div>
				</div>
				<button class="close-btn ph-close" onclick=@Close onmouseover=@(() => OnHover("tp-close"))>
					<iconify icon="lucide:x" Size=@(15) Color="rgba(255, 255, 255, 0.85)" />
				</button>
			</div>

			<!-- ═══ TWO-COLUMN BODY ═══ -->
			<!-- Left: zone hero + team + controls. Right: filter bar + roster
				 grid. Embark CTA is outside this block so it can span the
				 whole modal width at the bottom. -->
			<div class="picker-body">
				<div class="picker-left">

				<!-- Zone hero image (placeholder until 3D-scene portraits land) -->
				<div class="zone-hero-image">
					@if ( !string.IsNullOrEmpty( expedition.BackgroundImage ) )
					{
						<img class="zone-hero-img" src="@expedition.BackgroundImage" />
					}
					else
					{
						<div class="zone-hero-placeholder">
							<iconify icon="lucide:image" Size=@(36) Color="#64748b" />
						</div>
					}
					<div class="zone-hero-gradient"></div>
					<div class="zone-hero-stamp">
						<span class="zhs-kicker">RECOMMENDED</span>
						<span class="zhs-level">Lv. @recommendedLevel</span>
					</div>
				</div>

				<!-- Lore snippet -->
				@if ( !string.IsNullOrEmpty( expedition.Description ) )
				{
					<div class="zone-lore-text">@expedition.Description</div>
				}

				<!-- ═══ TEAM SLOTS ═══ -->
				<div class="picker-team-section">
				<div class="ps-head-row">
					<span class="ps-label">YOUR TEAM</span>
					<span class="ps-count">@filled / 3</span>
					@{
						var teamPower = (int)_team.Where( m => m != null ).Sum( m => m.PowerRating );
					}
					@if ( teamPower > 0 )
					{
						<div class="ps-power">
							<iconify icon="lucide:swords" Size=@(12) Color="#fde68a" />
							<span class="ps-power-label">PWR</span>
							<span class="ps-power-value">@teamPower</span>
						</div>
					}
					@* Team coverage pill removed — relies on zone element which
					   isn't a meaningful expedition attribute right now. *@
				</div>

				<div class="team-slots" onmouseup=@CancelDragIfAny>
					@for ( int i = 0; i < 3; i++ )
					{
						var slotIdx = i;
						var beast = _team[slotIdx];
						var dragHover = _dragHoverSlot == slotIdx && _dragSource != null;
						<div class="team-slot @(beast != null ? "filled" : "empty") @(dragHover ? "drag-hover" : "")"
							 onclick=@(() => OnTeamSlotClicked(slotIdx))
							 onmousedown=@(() => OnSlotMouseDown(slotIdx))
							 onmouseup=@(() => OnSlotMouseUp(slotIdx))
							 onmouseover=@(() => OnSlotMouseOver(slotIdx))>
							@{
								// Slot-edit override: when the dev picks a test species,
								// every slot renders that species (without needing to
								// own it). Falls back to the real beast in the slot.
								var editTestSpecies = !string.IsNullOrEmpty( _slotEditTestSpeciesId )
									? MonsterManager.Instance?.GetSpecies( _slotEditTestSpeciesId )
									: null;
								var displaySpecies = editTestSpecies != null
									? editTestSpecies
									: ( beast != null ? MonsterManager.Instance?.GetSpecies( beast.SpeciesId ) : null );
							}
							@if ( beast != null || displaySpecies != null )
							{
								var species = displaySpecies;
								var hpPct = beast != null ? beast.HPPercent * 100f : 100f;
								var hpClass = hpPct > 60f ? "healthy" : hpPct > 25f ? "wounded" : "critical";
								var heldItem = ( beast != null && !string.IsNullOrEmpty( beast.HeldItemId ) )
									? ItemManager.Instance?.GetItem( beast.HeldItemId )
									: null;
								var lowLevel = beast != null && beast.Level < recommendedLevel - 5;
								var ppLow = beast != null && HasLowPP( beast );

								@{
									// Reuse the BeastiaryPanel grid-card per-species positioning
									// so the sprite sits perfectly in the slot art frame. Multiplier
									// 0.65 matches the evo-stage pattern (smaller frame than 172px
									// grid card → proportionally smaller offsets). Overrides from
									// the slot editor (if active) shadow the species data.
									var slotCi = System.Globalization.CultureInfo.InvariantCulture;
									var slotArt = GetSlotArt( species );
									var slotScale = slotArt.Scale;
									var slotOffX = slotArt.OffX * 0.65f;
									var slotOffY = slotArt.OffY * 0.65f;
									var slotSpriteStyle = $"transform: translate({slotOffX.ToString("F2", slotCi)}px, {slotOffY.ToString("F2", slotCi)}px) scale({slotScale.ToString("F2", slotCi)}); transform-origin: center bottom;";
								}
								<div class="slot-art-wrap @(ShowSlotEditor && !string.IsNullOrEmpty(_slotEditTestSpeciesId) ? "slot-edit" : "")"
									 onmousedown=@(() => StartDragSlotArt(species))
									 onmouseover=@(() => OnSlotEditCardEnter(species?.Id))
									 onmouseout=@(() => OnSlotEditCardLeave(species?.Id))>
									<div class="slot-art-portrait" style="@slotSpriteStyle">
										<img class="slot-art" src="@(species?.IconPath ?? "ui/monsters/placeholder.png")" />
									</div>
									@if ( beast != null && beast.IsFavorite )
									{
										<div class="slot-fav">
											<iconify icon="lucide:star" Size=@(11) Color="#fbbf24" />
										</div>
									}
									@if ( heldItem != null )
									{
										<div class="slot-item-badge">
											<iconify icon="lucide:package" Size=@(10) Color="#c4b5fd" />
										</div>
									}
									@if ( ppLow )
									{
										<div class="slot-pp-warn">
											<iconify icon="lucide:battery-low" Size=@(10) Color="#fca5a5" />
										</div>
									}
								</div>

								<div class="slot-info">
									<div class="slot-name-row">
										<span class="slot-name">@(beast?.Nickname ?? species?.Name ?? beast?.SpeciesId ?? "?")</span>
										@if ( lowLevel )
										{
											<div class="slot-underlevel-chip">
												<iconify icon="lucide:alert-triangle" Size=@(9) Color="#fca5a5" />
											</div>
										}
									</div>
									<div class="slot-meta-row">
										<span class="slot-lv">Lv @(beast?.Level.ToString() ?? "?")</span>
										@if ( species != null )
										{
											<img class="slot-el" src="ui/icons/elements/background/@(species.Element.ToString().ToLower()).svg" />
											@if ( species.SecondaryElement.HasValue && species.SecondaryElement.Value != species.Element )
											{
												<img class="slot-el" src="ui/icons/elements/background/@(species.SecondaryElement.Value.ToString().ToLower()).svg" />
											}
										}
									</div>
									<div class="slot-hp-row">
										<span class="slot-hp-text @hpClass">@(beast?.CurrentHP.ToString() ?? "—") / @(beast?.MaxHP.ToString() ?? "—")</span>
										<div class="slot-hp-bar">
											<div class="slot-hp-fill @hpClass" style="width: @(hpPct)%"></div>
										</div>
									</div>
								</div>

								<div class="slot-remove">
									<iconify icon="lucide:x" Size=@(14) Color="#cbd5e1" />
								</div>
							}
							else
							{
								<div class="slot-empty-inner">
									<iconify icon="lucide:plus" Size=@(28) Color="#cbd5e1" />
									<span class="slot-empty-label">EMPTY SLOT</span>
								</div>
							}
						</div>
					}
				</div>

				<!-- Controls: split into two rows so nothing collapses.
					 Row 1: Auto-fill + Clear (team actions).
					 Row 2: PRESETS label + A/B/C slots (saved loadouts). -->
				<div class="ps-controls-row">
					<button class="ctrl-btn" onclick=@AutoFill onmouseover=@(() => OnHover("autofill"))>
						<div class="cb-key picker-cap"><span>F</span></div>
						<iconify icon="lucide:wand-2" Size=@(13) Color="#a78bfa" />
						<span>Auto-fill</span>
					</button>
					<button class="ctrl-btn" onclick=@ClearTeam onmouseover=@(() => OnHover("clearteam"))>
						<div class="cb-key picker-cap"><span>C</span></div>
						<iconify icon="lucide:eraser" Size=@(13) Color="#94a3b8" />
						<span>Clear</span>
					</button>
				</div>

				<div class="ps-presets-row">
					<span class="ps-preset-label">PRESETS</span>
					@for ( int p = 0; p < 3; p++ )
					{
						var pIdx = p;
						var preset = GetPreset( pIdx );
						var label = preset != null && preset.MonsterIds.Count > 0
							? (preset.Name ?? GetDefaultPresetName( pIdx ))
							: GetDefaultPresetName( pIdx );
						var hasData = preset != null && preset.MonsterIds.Count > 0;
						<div class="preset-slot @(hasData ? "saved" : "empty")">
							<button class="preset-btn @(hasData ? "saved" : "")"
									onclick=@(() => LoadPreset(pIdx))
									onmouseover=@(() => OnHover("preset-load-" + pIdx))>
								<div class="cb-key picker-cap"><span>@(pIdx + 1)</span></div>
								<iconify icon="@(hasData ? "lucide:bookmark-check" : "lucide:bookmark")" Size=@(12) Color="@(hasData ? "#a78bfa" : "#64748b")" />
								<span>@label</span>
							</button>
							<button class="preset-save-btn @(filled > 0 ? "" : "disabled")"
									onclick=@(() => SavePreset(pIdx))
									onmouseover=@(() => OnHover("preset-save-" + pIdx))>
								<iconify icon="lucide:save" Size=@(11) Color="#cbd5e1" />
							</button>
						</div>
					}
				</div>
			</div>

					@* Compact red Persona-stamp CTA — pinned at the bottom of
					   the LEFT column so the right roster grid can extend the
					   full modal height. *@
					<button class="picker-embark-btn @(CanEmbark() ? "ready" : "disabled")"
							onclick=@OnEmbarkClicked
							onmouseover=@(() => OnHover("embark-cta"))>
						<div class="cb-key picker-cap picker-cap-embark"><span>R</span></div>
						<iconify icon="lucide:compass" Size=@(22) Color="#ffffff" />
						<span class="embark-label">@(CanEmbark() ? "EMBARK" : (filled == 0 ? "PICK A BEAST" : "FILL YOUR TEAM"))</span>
					</button>

				</div> <!-- /.picker-left -->

				<div class="picker-right">

				<!-- ═══ FILTERS ═══ -->
				<!-- The cycle-element hint sits on its OWN row directly under
					 the FilterBar, hard-aligned to the LEFT edge so it reads as
					 an annotation attached to the element dropdown (the
					 left-most filter) — not as floating text by the sort
					 controls on the far right. -->
				<div class="picker-filters">
				<FilterBar @ref="filterBar"
						   CurrentElement=@_currentFilter
						   CurrentSort=@_currentSort
						   CurrentRarity=@_currentRarity
						   SortAscending=@_sortAscending
						   ShowBeastiarySort=@false
						   ShowRarityFilter=@true
						   HideMonsterOnlySorts=@false
						   OnElementChanged=@OnElementChanged
						   OnSortChanged=@OnSortChanged
						   OnRarityChanged=@OnRarityChanged
						   OnNameFilterChanged=@OnNameFilterChanged
						   OnSortDirectionChanged=@OnSortDirectionChanged
						   AvailableNames=@GetMonsterNames() />
					<div class="picker-cycle-hint">
						<iconify class="pch-arrow" icon="lucide:corner-left-up" Size=@(14) Color="rgba(196, 181, 253, 0.9)" />
						<div class="cb-key picker-cap"><span>&lt;</span></div>
						<div class="cb-key picker-cap"><span>&gt;</span></div>
						<span class="pch-label">cycle element</span>
					</div>
			</div>

			<!-- ═══ ROSTER HEADER (sibling of grid, NOT wrapping it — matches
				 BeastiaryPanel structure where the working grid is a direct
				 child of its column-flex parent with no intermediate wrapper) -->
			<div class="ps-head-row roster-head-row">
				<span class="ps-label">ROSTER</span>
				<span class="ps-count">@roster.Count / @(MonsterManager.Instance?.OwnedMonsters?.Count ?? 0)</span>
			</div>

			<!-- ═══ ROSTER GRID — NO flex-wrap.
				 s&box's flex-wrap engine consistently allocates only ~640px
				 of wrap budget regardless of parent width (confirmed via
				 hardcoded 1000px on picker-right + every CSS workaround
				 imaginable). Bypassing flex-wrap by manually slicing the
				 roster into rows of 5 in code-behind — each row is its own
				 single-line flex container which lays out reliably. -->
			<div class="picker-roster-scroll" @ref="pickerRosterScroll">
				@if ( roster.Count == 0 )
				{
					<div class="roster-empty">
						<iconify icon="lucide:search-x" Size=@(28) Color="#64748b" />
						<span>No beasts match</span>
					</div>
				}
				else
				{
					@{
						var rosterChunks = new List<List<Monster>>();
						for ( int i = 0; i < roster.Count; i += CARDS_PER_ROW )
						{
							var chunk = new List<Monster>();
							for ( int j = i; j < Math.Min( i + CARDS_PER_ROW, roster.Count ); j++ )
								chunk.Add( roster[j] );
							rosterChunks.Add( chunk );
						}
					}
					@foreach ( var rowChunk in rosterChunks )
					{
						<div class="picker-roster-row">
							@foreach ( var m in rowChunk )
							{
								var beast = m;
								var isPicked = _team.Any( t => t?.Id == beast.Id );
								var isFainted = beast.CurrentHP <= 0;
								var isUnpickable = isFainted;
								<div class="picker-card-wrapper @(isPicked ? "picked" : "") @(isFainted ? "fainted" : "") @(isUnpickable ? "unpickable" : "") @(_kbIndex >= 0 && _kbIndex < roster.Count && roster[_kbIndex].Id == beast.Id ? "kb-selected" : "")"
									 onclick=@(() => OnRosterCardClicked(beast))
									 onmousedown=@(() => OnRosterCardMouseDown(beast))
									 onmouseover=@(() => OnCardHover(beast.Id))>
									<MonsterCard Monster=@beast
												 IsSelected=@isPicked
												 ShouldAnimate=@(_hoveredCardId == beast.Id && !isFainted)
												 IsMini=@true
												 ShowGenes=@false
												 AnimateOnHover=@true
												 AnimationFrame=@SpriteAnimator.GlobalFrame
												 ClickAction=@(() => {})
												 HoverAction=@(() => {})
												 LeaveAction=@(() => {}) />
									@if ( isFainted )
									{
										<div class="card-fainted-overlay">
											<span>KO</span>
										</div>
									}
									@if ( isPicked )
									{
										<div class="card-picked-check">
											<iconify icon="lucide:check" Size=@(14) Color="#ffffff" />
										</div>
									}
								</div>
							}
						</div>
					}
				}
			</div>

				</div> <!-- /.picker-right -->
			</div> <!-- /.picker-body -->
		</div>

		@* Drag shield — fullscreen overlay during slot-art drag. *@
		@if ( !string.IsNullOrEmpty( _slotEditDraggingId ) )
		{
			<div class="slot-edit-drag-shield"
				 onmousemove=@OnSlotEditDragMove
				 onmouseup=@OnSlotEditDragEnd></div>
		}
	}
</root>

@code {
	public static TeamPickerPopup Instance { get; private set; }
	public static new bool IsVisible { get; private set; }
	public static string PendingExpeditionId { get; private set; }

	private string _rootVisibleClass => IsVisible ? "visible" : "";

	// ─────────── DEV: SLOT POSITIONING EDITOR ───────────────────
	// Pick any species (owned or not) and it renders in the team
	// slots so the dev can tune how the sprite frames in the slab.
	// Drag the sprite to adjust CardOffsetX/Y; mouse wheel scales.
	// Same data the Beastbook editor uses — saving propagates to
	// both surfaces.
	private const bool ShowSlotEditor = false;
	private string _slotEditTestSpeciesId;
	private string _slotEditDraggingId;
	private string _slotEditHoveredId;
	private float _slotDragStartMouseX, _slotDragStartMouseY;
	private float _slotDragStartOffX, _slotDragStartOffY;
	private bool _slotDragNeedsAnchor;
	private System.Collections.Generic.Dictionary<string, (float Scale, float OffX, float OffY)> _slotArtOverrides = new();

	// Persistence — overrides survive between sessions so devs don't
	// lose work to a restart. Stored as JSON in FileSystem.Data.
	private const string SavedSlotArtFile = "slot_card_art.json";
	private class SavedSlotArt { public string Id { get; set; } public float Scale { get; set; } public float OffX { get; set; } public float OffY { get; set; } }
	private class SlotArtData { public List<SavedSlotArt> Cards { get; set; } = new(); }
	private bool _slotArtLoaded = false;

	private void LoadSavedSlotArt()
	{
		try
		{
			if ( !FileSystem.Data.FileExists( SavedSlotArtFile ) ) return;
			var json = FileSystem.Data.ReadAllText( SavedSlotArtFile );
			var data = System.Text.Json.JsonSerializer.Deserialize<SlotArtData>( json );
			if ( data?.Cards == null ) return;
			foreach ( var c in data.Cards )
			{
				if ( string.IsNullOrEmpty( c.Id ) ) continue;
				_slotArtOverrides[c.Id] = (c.Scale, c.OffX, c.OffY);
			}
			Log.Info( $"[SlotEdit] Loaded {data.Cards.Count} override(s) from {SavedSlotArtFile}" );
		}
		catch ( System.Exception ex )
		{
			Log.Warning( $"[SlotEdit] Failed to load saved overrides: {ex.Message}" );
		}
	}

	private void PersistSlotArtToDisk()
	{
		try
		{
			var data = new SlotArtData();
			foreach ( var kvp in _slotArtOverrides )
			{
				data.Cards.Add( new SavedSlotArt { Id = kvp.Key, Scale = kvp.Value.Scale, OffX = kvp.Value.OffX, OffY = kvp.Value.OffY } );
			}
			var json = System.Text.Json.JsonSerializer.Serialize( data, new System.Text.Json.JsonSerializerOptions { WriteIndented = true } );
			FileSystem.Data.WriteAllText( SavedSlotArtFile, json );
		}
		catch ( System.Exception ex )
		{
			Log.Warning( $"[SlotEdit] Failed to write overrides: {ex.Message}" );
		}
	}

	private (float Scale, float OffX, float OffY) GetSlotArt( MonsterSpecies species )
	{
		if ( species == null ) return (1f, 0f, 0f);
		if ( _slotArtOverrides.TryGetValue( species.Id, out var ov ) ) return ov;
		return (species.CardScale, species.CardOffsetX, species.CardOffsetY);
	}

	private List<MonsterSpecies> GetAllTestableSpecies()
	{
		var all = MonsterManager.Instance?.GetAllSpecies() ?? new();
		return all.OrderBy( s => s.BeastiaryNumber ).ToList();
	}

	private void SlotEditPrevSpecies()
	{
		Log.Info( "[SlotEdit] PREV clicked" );
		var all = GetAllTestableSpecies();
		if ( all.Count == 0 ) return;
		var idx = string.IsNullOrEmpty( _slotEditTestSpeciesId )
			? all.Count - 1
			: all.FindIndex( s => s.Id == _slotEditTestSpeciesId ) - 1;
		if ( idx < 0 ) idx = all.Count - 1;
		_slotEditTestSpeciesId = all[idx].Id;
		SoundManager.PlayHover();
		StateHasChanged();
	}

	private void SlotEditNextSpecies()
	{
		Log.Info( "[SlotEdit] NEXT clicked" );
		var all = GetAllTestableSpecies();
		if ( all.Count == 0 ) return;
		var idx = string.IsNullOrEmpty( _slotEditTestSpeciesId )
			? 0
			: all.FindIndex( s => s.Id == _slotEditTestSpeciesId ) + 1;
		if ( idx >= all.Count ) idx = 0;
		_slotEditTestSpeciesId = all[idx].Id;
		SoundManager.PlayHover();
		StateHasChanged();
	}

	private void SlotEditClearTest()
	{
		_slotEditTestSpeciesId = null;
		StateHasChanged();
	}

	private void StartDragSlotArt( MonsterSpecies species )
	{
		Log.Info( $"[SlotEdit] StartDragSlotArt called. species={species?.Id}, testSpecies={_slotEditTestSpeciesId}, show={ShowSlotEditor}" );
		if ( !ShowSlotEditor || species == null || string.IsNullOrEmpty( _slotEditTestSpeciesId ) ) return;
		var art = GetSlotArt( species );
		_slotEditDraggingId = species.Id;
		_slotDragStartOffX = art.OffX;
		_slotDragStartOffY = art.OffY;
		_slotDragNeedsAnchor = true;
		StateHasChanged();
	}

	private void OnSlotEditDragMove( PanelEvent e )
	{
		if ( string.IsNullOrEmpty( _slotEditDraggingId ) ) return;
		if ( _slotDragNeedsAnchor )
		{
			_slotDragStartMouseX = MousePosition.x;
			_slotDragStartMouseY = MousePosition.y;
			_slotDragNeedsAnchor = false;
			return;
		}
		// Multiplier 1/0.65 ≈ 1.54 — drag pixel input maps to species
		// CardOffsetX/Y space (which the slot multiplies by 0.65 when
		// rendering), so visual drag distance matches sprite movement.
		float dx = ( MousePosition.x - _slotDragStartMouseX ) / 0.65f;
		float dy = ( MousePosition.y - _slotDragStartMouseY ) / 0.65f;
		var prev = _slotArtOverrides.TryGetValue( _slotEditDraggingId, out var ov )
			? ov
			: GetSlotArtFallback( _slotEditDraggingId );
		_slotArtOverrides[_slotEditDraggingId] = (prev.Scale, _slotDragStartOffX + dx, _slotDragStartOffY + dy);
		PersistSlotArtToDisk();
		StateHasChanged();
	}

	private void OnSlotEditDragEnd( PanelEvent e )
	{
		_slotEditDraggingId = null;
		StateHasChanged();
	}

	private (float Scale, float OffX, float OffY) GetSlotArtFallback( string speciesId )
	{
		var sp = MonsterManager.Instance?.GetSpecies( speciesId );
		return sp == null ? (1f, 0f, 0f) : (sp.CardScale, sp.CardOffsetX, sp.CardOffsetY);
	}

	private void OnSlotEditCardEnter( string speciesId )
	{
		if ( !ShowSlotEditor ) return;
		_slotEditHoveredId = speciesId;
	}

	private void OnSlotEditCardLeave( string speciesId )
	{
		if ( _slotEditHoveredId == speciesId ) _slotEditHoveredId = null;
	}

	private void PrintSlotArt()
	{
		Log.Info( $"[SlotEdit] SAVE clicked. Overrides count = {_slotArtOverrides.Count}, current test species = '{_slotEditTestSpeciesId}'" );
		if ( _slotArtOverrides.Count == 0 )
		{
			Log.Info( "[SlotEdit] No overrides yet — drag a slot or scroll over it first." );
			return;
		}

		// 1) Persist to disk so the next session loads them automatically.
		PersistSlotArtToDisk();
		Log.Info( $"[SlotEdit] Saved {_slotArtOverrides.Count} override(s) → FileSystem.Data/{SavedSlotArtFile}" );

		// 2) Log each line separately for paste-back into MonsterManager.cs
		//    (s&box's Log.Info silently truncates multi-line strings).
		Log.Info( "─── Slot card-art overrides — paste into MonsterManager.cs ───" );
		var ci = System.Globalization.CultureInfo.InvariantCulture;
		foreach ( var kvp in _slotArtOverrides )
		{
			var sp = MonsterManager.Instance?.GetSpecies( kvp.Key );
			var name = sp?.Name ?? kvp.Key;
			Log.Info( $"// {name} ({kvp.Key})" );
			Log.Info( $"CardScale = {kvp.Value.Scale.ToString( "0.###", ci )}f," );
			Log.Info( $"CardOffsetX = {kvp.Value.OffX.ToString( "0.#", ci )}f," );
			Log.Info( $"CardOffsetY = {kvp.Value.OffY.ToString( "0.#", ci )}f," );
		}
		Log.Info( "─────────────────────────────────────────────────────────────" );
		SoundManager.PlayClick();
	}

	private void ResetSlotArt()
	{
		_slotArtOverrides.Clear();
		PersistSlotArtToDisk();
		Log.Info( "[SlotEdit] Cleared all overrides." );
		SoundManager.PlayClick();
		StateHasChanged();
	}

	// Team state — fixed-size 3 to keep slot logic simple. nulls = empty slots.
	private List<Monster> _team = new() { null, null, null };

	// Filter/sort state — mirrors MonsterRosterPanel naming for copy-paste sanity.
	private string _currentFilter = "all";
	private string _currentSort = "level";
	private string _currentRarity = "all";
	private string _currentNameFilter = "";
	private bool _sortAscending = false;

	private Guid? _hoveredCardId;
	private string _hoveredKey;

	// Keyboard navigation. The roster grid is a fixed 5-wide layout.
	private const int CARDS_PER_ROW = 5;
	private int _kbIndex = 0;
	private Panel pickerRosterScroll;
	private FilterBar filterBar;

	// ─── DRAG-DROP STATE ───
	// _dragSource is the beast currently being dragged (from roster OR a team slot).
	// _dragFromSlot is the index of the source team slot, or null if dragging from
	// the roster. _dragHoverSlot drives the yellow drop-target highlight.
	//
	// s&box Razor doesn't expose HTML5 drag events, so this is pure mouse-event
	// drag: onmousedown starts, onmouseup on a slot commits, onmouseup anywhere
	// else (via the .team-slots container's onmouseup) cancels.
	private Monster _dragSource;
	private int? _dragFromSlot;
	private int? _dragHoverSlot;

	private void OnHover( string key )
	{
		if ( _hoveredKey == key ) return;
		_hoveredKey = key;
		SoundManager.PlayHover();
	}

	private void OnCardHover( Guid id )
	{
		if ( _hoveredCardId == id ) return;
		_hoveredCardId = id;
	}

	// Mouse wheel — scales the hovered slot's sprite when in slot-edit mode.
	public override void OnMouseWheel( Vector2 delta )
	{
		if ( ShowSlotEditor && !string.IsNullOrEmpty( _slotEditTestSpeciesId ) && !string.IsNullOrEmpty( _slotEditHoveredId ) )
		{
			var prev = _slotArtOverrides.TryGetValue( _slotEditHoveredId, out var ov )
				? ov
				: GetSlotArtFallback( _slotEditHoveredId );
			float newScale = Math.Clamp( prev.Scale + delta.y * 0.05f, 0.3f, 3.0f );
			_slotArtOverrides[_slotEditHoveredId] = (newScale, prev.OffX, prev.OffY);
			PersistSlotArtToDisk();
			StateHasChanged();
			return;
		}
		base.OnMouseWheel( delta );
	}

	protected override void OnAfterTreeRender( bool firstTime )
	{
		if ( firstTime )
		{
			Instance = this;
			// Load persisted slot-edit overrides regardless of editor
			// state — without this, turning the editor OFF means the
			// slot reverts to the species' base CardScale/CardOffsetX/Y
			// values from MonsterManager.cs and any tuning you did in
			// the editor disappears. Loading always means edits stick
			// even before you commit them to MonsterManager.cs.
			if ( !_slotArtLoaded )
			{
				LoadSavedSlotArt();
				_slotArtLoaded = true;
			}
			// If Show(id) was called before this panel mounted (e.g. ExpeditionPanel
			// triggered "Embark Again" → WorldMap swapped in → picker constructed
			// AFTER the Show call), the static flags are already set. Finish the
			// pre-fill now that the instance exists.
			if ( IsVisible && !string.IsNullOrEmpty( PendingExpeditionId ) )
			{
				PreFillTeam( PendingExpeditionId );
			}
		}
	}

	// ═══════════════════════════════════════════════════════════════
	// LIFECYCLE
	// ═══════════════════════════════════════════════════════════════

	public static void Show( string expeditionId )
	{
		PendingExpeditionId = expeditionId;
		IsVisible = true;
		if ( Instance != null )
		{
			Instance._hoveredKey = null;
			Instance._hoveredCardId = null;
			Instance._kbIndex = 0;
			Instance.PreFillTeam( expeditionId );
			Instance.NotifyTutorialIfTeamPopulated();
		}
		SoundManager.PlayPopup();
	}

	public static void Close()
	{
		IsVisible = false;
		if ( Instance != null ) Instance._hoveredKey = null;
		SoundManager.PlayPopdown();
	}

	public override void Tick()
	{
		base.Tick();
		if ( !IsVisible ) return;
		if ( !UIModalState.IsTopModal( "TeamPickerPopup" ) ) return;

		// Back / close.
		if ( Input.Pressed( "Escape" ) || Input.Pressed( "Menu" ) || Input.Pressed( "run" ) )
		{
			Close();
			return;
		}

		// R embarks (OnEmbarkClicked self-guards on CanEmbark).
		if ( Input.Pressed( "reload" ) )
		{
			OnEmbarkClicked();
			return;
		}

		// F = Auto-fill, C = Clear. Flashlight/View are the engine actions
		// bound to the F and C keys — reused here; GameHUD ignores them while
		// a modal is open, so there's no collision.
		if ( Input.Pressed( "Flashlight" ) ) { AutoFill(); StateHasChanged(); return; }
		if ( Input.Pressed( "View" ) ) { ClearTeam(); StateHasChanged(); return; }

		// 1 / 2 / 3 — preset slots: load if the slot holds a team, else save
		// the current team into it (deny if there's nothing to save).
		for ( int p = 0; p < 3; p++ )
		{
			if ( !Input.Pressed( "Slot" + ( p + 1 ) ) ) continue;
			var preset = GetPreset( p );
			bool slotHasData = preset != null && preset.MonsterIds.Count > 0;
			if ( slotHasData ) LoadPreset( p );
			else if ( _team.Any( t => t != null ) ) SavePreset( p );
			else SoundManager.PlayDeny();
			StateHasChanged();
			return;
		}

		// , / . cycle the element filter (the <,> keys). [ / ] stay reserved
		// for the global radio track skip.
		if ( Input.Pressed( "CyclePrev" ) ) { CycleElementFilter( -1 ); return; }
		if ( Input.Pressed( "CycleNext" ) ) { CycleElementFilter( 1 ); return; }

		var roster = GetFilteredMonsters();
		if ( roster.Count == 0 ) return;
		_kbIndex = Math.Clamp( _kbIndex, 0, roster.Count - 1 );

		// Space / Enter adds or removes the highlighted beast.
		if ( Input.Pressed( "Jump" ) || Input.Pressed( "Enter" ) )
		{
			OnRosterCardClicked( roster[_kbIndex] );
			StateHasChanged();
			return;
		}

		int prev = _kbIndex;
		if ( Input.Pressed( "Left" ) ) _kbIndex = Math.Max( 0, _kbIndex - 1 );
		else if ( Input.Pressed( "Right" ) ) _kbIndex = Math.Min( roster.Count - 1, _kbIndex + 1 );
		else if ( Input.Pressed( "Up" ) ) { if ( _kbIndex >= CARDS_PER_ROW ) _kbIndex -= CARDS_PER_ROW; }
		else if ( Input.Pressed( "Down" ) ) _kbIndex = Math.Min( roster.Count - 1, _kbIndex + CARDS_PER_ROW );

		if ( _kbIndex != prev )
		{
			SoundManager.PlayHover();
			// Scroll the row holding the selection into view (the grid renders
			// fixed 5-wide rows, so row index = card index / CARDS_PER_ROW).
			UiGridScroll.ScrollIndexIntoView( pickerRosterScroll, _kbIndex / CARDS_PER_ROW, "picker-roster-row" );
			StateHasChanged();
		}
	}

	/// <summary>
	/// Pre-fill the team with, in order of preference:
	/// 1. The last team used for this zone (from save data)
	/// 2. ExpeditionManager.SelectedTeam (persisted across in-session clicks)
	/// 3. Auto-pick: first 3 healthy beasts sorted by power
	/// All picks skip fainted beasts regardless of source.
	/// </summary>
	private void PreFillTeam( string zoneId )
	{
		_team = new() { null, null, null };
		var mm = MonsterManager.Instance;
		if ( mm == null ) return;

		// 1) Last-team-per-zone
		var lastIds = GetSaveData()?.LastTeamPerZone?.TryGetValue( zoneId, out var ids ) == true ? ids : null;
		if ( lastIds != null && lastIds.Count > 0 )
		{
			int slot = 0;
			foreach ( var id in lastIds )
			{
				if ( slot >= 3 ) break;
				var m = mm.OwnedMonsters.FirstOrDefault( x => x.Id == id );
				if ( m == null || m.CurrentHP <= 0 ) continue;
				_team[slot++] = m;
			}
			if ( _team.Any( t => t != null ) ) return;
		}

		// 2) Current SelectedTeam (alive)
		var current = ExpeditionManager.Instance?.SelectedTeam?
			.Where( m => m != null && m.CurrentHP > 0 )
			.ToList() ?? new();
		if ( current.Count > 0 )
		{
			for ( int i = 0; i < Math.Min( 3, current.Count ); i++ ) _team[i] = current[i];
			return;
		}

		// 3) Auto-pick best
		AutoFill();
	}

	/// <summary>
	/// Called after _team is populated by ANY of the PreFillTeam paths. Fires the
	/// tutorial event if at least one slot got filled — new players have a
	/// single starter that always auto-fills, never goes through the click path.
	/// </summary>
	private void NotifyTutorialIfTeamPopulated()
	{
		if ( _team.Any( t => t != null ) )
		{
			Beastborne.Core.TutorialManager.Instance?.NotifyEvent( "team.beast-added" );
		}
	}

	// ═══════════════════════════════════════════════════════════════
	// TEAM / ROSTER CLICK HANDLING
	// ═══════════════════════════════════════════════════════════════

	private void OnRosterCardClicked( Monster m )
	{
		if ( m == null || m.CurrentHP <= 0 )
		{
			SoundManager.PlayDeny();
			return;
		}

		// If already picked, un-pick (remove from team).
		int existing = _team.FindIndex( t => t?.Id == m.Id );
		if ( existing >= 0 )
		{
			_team[existing] = null;
			SoundManager.PlayClick();
			return;
		}

		// Otherwise, add to first empty slot. If full, swap into slot 0 (most
		// recent becomes slot 0; others shift). Keeps the click always useful.
		int empty = _team.FindIndex( t => t == null );
		if ( empty >= 0 )
		{
			_team[empty] = m;
		}
		else
		{
			_team[2] = _team[1];
			_team[1] = _team[0];
			_team[0] = m;
		}
		SoundManager.PlayClick();

		// Tutorial: notify that a beast was added to the team.
		Beastborne.Core.TutorialManager.Instance?.NotifyEvent( "team.beast-added" );
	}

	private void OnTeamSlotClicked( int idx )
	{
		if ( idx < 0 || idx >= _team.Count ) return;
		if ( _team[idx] == null ) return;
		// If a drop just fired on this slot, onclick will also fire (mousedown
		// and mouseup were both on this element). Suppress the default remove
		// behaviour when a drag committed here so drag-to-same-slot isn't
		// interpreted as "drag then click-to-clear."
		if ( _consumeNextClickForSlot == idx )
		{
			_consumeNextClickForSlot = null;
			return;
		}
		_team[idx] = null;
		SoundManager.PlayClick();
	}

	private int? _consumeNextClickForSlot;

	// ─── DRAG HANDLERS ─────────────────────────────────────────────

	private void OnSlotMouseDown( int idx )
	{
		if ( idx < 0 || idx >= _team.Count ) return;
		var beast = _team[idx];
		if ( beast == null ) return;
		_dragSource = beast;
		_dragFromSlot = idx;
	}

	private void OnRosterCardMouseDown( Monster m )
	{
		if ( m == null || m.CurrentHP <= 0 ) return;
		_dragSource = m;
		_dragFromSlot = null;
	}

	private void OnSlotMouseOver( int idx )
	{
		OnHover( "slot-" + idx );
		if ( _dragSource == null ) return;
		_dragHoverSlot = idx;
	}

	private void OnSlotMouseUp( int idx )
	{
		if ( _dragSource == null ) return;
		if ( idx < 0 || idx >= _team.Count )
		{
			CancelDragIfAny();
			return;
		}

		if ( _dragFromSlot.HasValue )
		{
			// Slot → slot: swap regardless of whether target is filled or empty.
			// Same-slot drag is a no-op (and onclick will fire normally).
			if ( _dragFromSlot.Value == idx )
			{
				CancelDragIfAny();
				return;
			}
			var tmp = _team[idx];
			_team[idx] = _team[_dragFromSlot.Value];
			_team[_dragFromSlot.Value] = tmp;
		}
		else
		{
			// Roster → slot: place the dragged beast in the target, displacing
			// whatever was there. If the dragged beast was already picked in a
			// different slot, clear that other slot first (no duplicates).
			int existing = _team.FindIndex( t => t?.Id == _dragSource.Id );
			if ( existing >= 0 && existing != idx ) _team[existing] = null;
			_team[idx] = _dragSource;
		}

		_consumeNextClickForSlot = idx;
		_dragSource = null;
		_dragFromSlot = null;
		_dragHoverSlot = null;
		SoundManager.PlayClick();
	}

	private void CancelDragIfAny()
	{
		if ( _dragSource == null && _dragHoverSlot == null ) return;
		_dragSource = null;
		_dragFromSlot = null;
		_dragHoverSlot = null;
	}

	private void AutoFill()
	{
		var mm = MonsterManager.Instance;
		if ( mm == null ) return;
		var taken = _team.Where( t => t != null ).Select( t => t.Id ).ToHashSet();
		var candidates = mm.OwnedMonsters
			.Where( m => m != null && m.CurrentHP > 0 && !taken.Contains( m.Id ) )
			.OrderByDescending( m => m.PowerRating )
			.ToList();
		int added = 0;
		for ( int i = 0; i < _team.Count; i++ )
		{
			if ( _team[i] != null ) continue;
			if ( added >= candidates.Count ) break;
			_team[i] = candidates[added++];
		}
		SoundManager.PlayClick();

		// Tutorial: notify if AutoFill actually added at least one beast.
		// New players have a single starter that lands here without ever
		// clicking the roster card path.
		if ( added > 0 )
		{
			Beastborne.Core.TutorialManager.Instance?.NotifyEvent( "team.beast-added" );
		}
	}

	private void ClearTeam()
	{
		_team = new() { null, null, null };
		SoundManager.PlayClick();
	}

	private bool CanEmbark() => _team.Any( m => m != null && m.CurrentHP > 0 );

	private bool _isEmbarking;

	private void OnEmbarkClicked()
	{
		// ERROR IN EDITOR, WHEN COMPILED EMBARK DOES NOT WORK, SOMETHING IS WRONG
		// 03:59:51   Generic "Object reference not set to an instance of an object." when running panel event "onclick" from "Sandbox.UI.Button"

		if ( _isEmbarking ) return;
		if ( !CanEmbark() )
		{
			SoundManager.PlayDeny();
			return;
		}
		var liveTeam = _team.Where( m => m != null && m.CurrentHP > 0 ).ToList();
		var em = ExpeditionManager.Instance;
		if ( em == null || string.IsNullOrEmpty( PendingExpeditionId ) )
		{
			SoundManager.PlayDeny();
			return;
		}

		// Remember this team for next time we open the picker on this zone.
		// If save data isn't ready (cloud blob not yet hydrated, save quarantined,
		// or first boot before SaveService.CurrentBlob exists), skip the preset
		// write and still embark — losing the "last team per zone" convenience is
		// fine; silently blocking embark is not. The save-quarantine fix (online-2)
		// addresses the upstream "CurrentBlob is null" cases.
		var data = EnsureSaveData();
		if ( data != null )
		{
			data.LastTeamPerZone[PendingExpeditionId] = liveTeam.Select( m => m.Id ).ToList();
			SaveService.Instance?.MarkDirty( "teampresets" );
		}
		else
		{
			Log.Warning( "[TeamPickerPopup] Save data null at embark time; skipping team-preset write and proceeding with expedition." );
		}

		_isEmbarking = true;
		SoundManager.PlayBattleStart();

		// Hand the whole cinematic off to BattleTransition's static orchestrator.
		// Critical: StartExpedition triggers GameHUD to swap WorldMapPanel out for
		// ExpeditionPanel, which destroys this picker. If we awaited the sequence
		// here, the continuation would die and Hide() would never fire, leaving
		// the screen stuck on the black overlay and BattleView's UI permanently
		// gated by `!BattleTransition.IsActive`. Running the sequence on
		// BattleTransition (a persistent GameHUD child) keeps the async chain
		// alive through the panel swap.
		var zoneId = PendingExpeditionId;
		_ = BattleTransition.PlayEmbarkSequence( () =>
		{
			em.SelectTeam( liveTeam );
			em.StartExpedition( zoneId );
		} );

		IsVisible = false;
		_isEmbarking = false;
	}

	// ═══════════════════════════════════════════════════════════════
	// FILTER / SORT  (mirrors MonsterRosterPanel wiring)
	// ═══════════════════════════════════════════════════════════════

	private void OnElementChanged( string e ) { _currentFilter = e; SoundManager.PlayClick(); }

	// Element-filter cycle order for the [ / ] hotkeys.
	private static readonly string[] _elementFilterCycle =
		{ "all", "fire", "water", "earth", "wind", "electric", "ice", "nature", "metal", "shadow", "spirit", "neutral" };

	private void CycleElementFilter( int dir )
	{
		int i = System.Array.IndexOf( _elementFilterCycle, _currentFilter );
		if ( i < 0 ) i = 0;
		i = ( i + dir + _elementFilterCycle.Length ) % _elementFilterCycle.Length;
		OnElementChanged( _elementFilterCycle[i] );
	}
	private void OnSortChanged( string s ) { _currentSort = s; SoundManager.PlayClick(); }
	private void OnRarityChanged( string r ) { _currentRarity = r; SoundManager.PlayClick(); }
	private void OnNameFilterChanged( string n ) { _currentNameFilter = n ?? ""; }
	private void OnSortDirectionChanged( bool asc ) { _sortAscending = asc; SoundManager.PlayClick(); }

	private List<string> GetMonsterNames()
	{
		var mm = MonsterManager.Instance;
		if ( mm == null ) return new();
		return mm.OwnedMonsters
			.Select( m => m.Nickname ?? mm.GetSpecies( m.SpeciesId )?.Name ?? m.SpeciesId )
			.Where( n => !string.IsNullOrEmpty( n ) )
			.Distinct()
			.OrderBy( n => n )
			.ToList();
	}

	// Copy of MonsterRosterPanel.GetFilteredMonsters (trimmed: no fusion/beastiary
	// modes) so filtering/sort behaviour reads identical to the roster panel.
	private List<Monster> GetFilteredMonsters()
	{
		var mm = MonsterManager.Instance;
		if ( mm == null ) return new();
		var monsters = mm.OwnedMonsters?.ToList() ?? new();

		if ( _currentFilter != "all" )
		{
			var elementType = _currentFilter switch
			{
				"fire" => ElementType.Fire,
				"water" => ElementType.Water,
				"earth" => ElementType.Earth,
				"wind" => ElementType.Wind,
				"electric" => ElementType.Electric,
				"ice" => ElementType.Ice,
				"nature" => ElementType.Nature,
				"metal" => ElementType.Metal,
				"shadow" => ElementType.Shadow,
				"spirit" => ElementType.Spirit,
				// "neutral" => ElementType.Neutral,
				_ => ElementType.Neutral
			};
			monsters = monsters.Where( m => mm.GetSpecies( m.SpeciesId )?.Element == elementType ).ToList();
		}

		if ( _currentRarity != "all" )
		{
			var r = _currentRarity switch
			{
				"common" => Rarity.Common,
				"uncommon" => Rarity.Uncommon,
				"rare" => Rarity.Rare,
				"epic" => Rarity.Epic,
				"legendary" => Rarity.Legendary,
				"mythic" => Rarity.Mythic,
				_ => Rarity.Common
			};
			monsters = monsters.Where( m => mm.GetSpecies( m.SpeciesId )?.BaseRarity == r ).ToList();
		}

		if ( _currentSort == "name" && !string.IsNullOrEmpty( _currentNameFilter ) )
		{
			monsters = monsters.Where( m =>
				(mm.GetSpecies( m.SpeciesId )?.Name?.Equals( _currentNameFilter, StringComparison.OrdinalIgnoreCase ) ?? false)
				|| (m.Nickname?.Equals( _currentNameFilter, StringComparison.OrdinalIgnoreCase ) ?? false)
			).ToList();
		}

		monsters = _currentSort switch
		{
			"level" => _sortAscending ? monsters.OrderBy( m => m.Level ).ToList() : monsters.OrderByDescending( m => m.Level ).ToList(),
			"power" => _sortAscending ? monsters.OrderBy( m => m.PowerRating ).ToList() : monsters.OrderByDescending( m => m.PowerRating ).ToList(),
			"rarity" => _sortAscending
				? monsters.OrderBy( m => (int)(mm.GetSpecies( m.SpeciesId )?.BaseRarity ?? Rarity.Common) ).ToList()
				: monsters.OrderByDescending( m => (int)(mm.GetSpecies( m.SpeciesId )?.BaseRarity ?? Rarity.Common) ).ToList(),
			"recent" => _sortAscending ? monsters.OrderBy( m => m.CaughtAt ).ToList() : monsters.OrderByDescending( m => m.CaughtAt ).ToList(),
			"fav" => _sortAscending ? monsters.OrderBy( m => m.IsFavorite ).ThenBy( m => m.PowerRating ).ToList()
				: monsters.OrderByDescending( m => m.IsFavorite ).ThenByDescending( m => m.PowerRating ).ToList(),
			"name" => _sortAscending
				? monsters.OrderByDescending( m => m.Nickname ?? mm.GetSpecies( m.SpeciesId )?.Name ?? "" ).ToList()
				: monsters.OrderBy( m => m.Nickname ?? mm.GetSpecies( m.SpeciesId )?.Name ?? "" ).ToList(),
			_ => monsters
		};

		return monsters;
	}

	// ═══════════════════════════════════════════════════════════════
	// TYPE COVERAGE HINT
	// ═══════════════════════════════════════════════════════════════

	public enum TeamAdvantage { Empty, Weak, Disadvantage, Neutral, Advantage, Strong }

	/// <summary>
	/// Average effectiveness of the team's primary elements attacking into
	/// the zone's element. Labelled into rough buckets so the player gets a
	/// quick "are my types good?" read without seeing a matrix.
	/// </summary>
	private TeamAdvantage GetTeamCoverage( ElementType zoneElement )
	{
		var picks = _team.Where( m => m != null ).ToList();
		if ( picks.Count == 0 ) return TeamAdvantage.Empty;

		float total = 0f;
		foreach ( var m in picks )
		{
			var species = MonsterManager.Instance?.GetSpecies( m.SpeciesId );
			if ( species == null ) continue;

			float best = BattleAI.GetTypeEffectiveness( species.Element, zoneElement );
			if ( species.SecondaryElement.HasValue && species.SecondaryElement.Value != species.Element )
			{
				var alt = BattleAI.GetTypeEffectiveness( species.SecondaryElement.Value, zoneElement );
				if ( alt > best ) best = alt;
			}
			total += best;
		}

		float avg = total / picks.Count;
		if ( avg >= 1.9f ) return TeamAdvantage.Strong;
		if ( avg >= 1.3f ) return TeamAdvantage.Advantage;
		if ( avg >= 0.9f ) return TeamAdvantage.Neutral;
		if ( avg >= 0.6f ) return TeamAdvantage.Disadvantage;
		return TeamAdvantage.Weak;
	}

	private string GetCoverageLabel( TeamAdvantage a ) => a switch
	{
		TeamAdvantage.Strong => "STRONG ADVANTAGE",
		TeamAdvantage.Advantage => "ADVANTAGE",
		TeamAdvantage.Neutral => "NEUTRAL",
		TeamAdvantage.Disadvantage => "DISADVANTAGE",
		TeamAdvantage.Weak => "WEAK MATCHUP",
		_ => ""
	};

	private string GetCoverageClass( TeamAdvantage a ) => a switch
	{
		TeamAdvantage.Strong => "cov-strong",
		TeamAdvantage.Advantage => "cov-advantage",
		TeamAdvantage.Neutral => "cov-neutral",
		TeamAdvantage.Disadvantage => "cov-disadvantage",
		TeamAdvantage.Weak => "cov-weak",
		_ => ""
	};

	private string GetCoverageIcon( TeamAdvantage a ) => a switch
	{
		TeamAdvantage.Strong => "lucide:trending-up",
		TeamAdvantage.Advantage => "lucide:arrow-up-right",
		TeamAdvantage.Neutral => "lucide:minus",
		TeamAdvantage.Disadvantage => "lucide:arrow-down-right",
		TeamAdvantage.Weak => "lucide:trending-down",
		_ => "lucide:minus"
	};

	private string GetCoverageIconColor( TeamAdvantage a ) => a switch
