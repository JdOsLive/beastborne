	/// <summary>
	/// Sprite fit for a TW×TH window: INTEGER upscale when the source fits
	/// (64 → 2× in 128; 128 → 1×), otherwise the house viewport crop
	/// (0.45 horizontal — sprites face left; 0.22 vertical — the head band).
	/// Inline width/height/margins, whole px; no object-fit, no filter, no
	/// transform on the img (DOC-6 #11/#13, DOC-7 #18). Host: overflow
	/// hidden + align/justify flex-start (in-flow children DO clip).
	/// </summary>
	private static string FitStyle( MonsterSpecies s, int tw, int th )
	{
		var d = BbEmblem.SpriteDims( s );
		int sw = Math.Max( 1, d.w ), sh = Math.Max( 1, d.h );
		int scale = Math.Max( 1, Math.Min( tw / sw, th / sh ) );
		int w = sw * scale, h = sh * scale;
		int ml = w > tw ? -(int)Math.Round( ( w - tw ) * 0.45f ) : ( tw - w ) / 2;
		int mt = h > th ? -(int)Math.Round( ( h - th ) * 0.22f ) : ( th - h ) / 2;
		return $"width: {w}px; height: {h}px; min-width: {w}px; margin-left: {ml}px; margin-top: {mt}px;";
	}

