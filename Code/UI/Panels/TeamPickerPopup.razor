	private TeamPresetSaveData GetSaveData() => SaveService.Instance?.CurrentBlob?.TeamPresets;

	private TeamPresetSaveData EnsureSaveData()
	{
		var blob = SaveService.Instance?.CurrentBlob;
		if ( blob == null ) return null;
		blob.TeamPresets ??= new TeamPresetSaveData();
		while ( blob.TeamPresets.Presets.Count < 3 ) blob.TeamPresets.Presets.Add( new TeamPreset() );
		return blob.TeamPresets;
	}

	private TeamPreset GetPreset( int idx )
	{
		var data = GetSaveData();
		if ( data?.Presets == null || idx < 0 || idx >= data.Presets.Count ) return null;
		return data.Presets[idx];
	}

	private string GetDefaultPresetName( int idx ) => idx switch
	{
		0 => "A",
		1 => "B",
		2 => "C",
		_ => "?"
	};

	private void SavePreset( int idx )
	{
		var data = EnsureSaveData();
		if ( data == null ) return;
		var preset = data.Presets[idx];
		preset.MonsterIds = _team.Where( m => m != null ).Select( m => m.Id ).ToList();
		preset.UpdatedTicks = DateTime.UtcNow.Ticks;
		if ( string.IsNullOrEmpty( preset.Name ) ) preset.Name = GetDefaultPresetName( idx );
		SaveService.Instance?.MarkDirty( "teampresets" );
		NotificationManager.Instance?.AddNotification(
			NotificationType.Success,
			"Preset saved",
			$"Team {preset.Name} stored." );
		SoundManager.PlaySuccess();
	}

	private void LoadPreset( int idx )
	{
		var preset = GetPreset( idx );
		if ( preset == null || preset.MonsterIds.Count == 0 )
		{
			SoundManager.PlayDeny();
			return;
		}
		var mm = MonsterManager.Instance;
		if ( mm == null ) return;

		_team = new() { null, null, null };
		int slot = 0;
		foreach ( var id in preset.MonsterIds )
		{
			if ( slot >= 3 ) break;
			var m = mm.OwnedMonsters.FirstOrDefault( x => x.Id == id );
			if ( m == null ) continue; // silently skip released beasts
			_team[slot++] = m;
		}
		SoundManager.PlayClick();
	}

	// ═══════════════════════════════════════════════════════════════
	// RERENDER TRIGGERS — every field that paints (DOC-7 #22)
	// ═══════════════════════════════════════════════════════════════

	protected override int BuildHash()
	{
		var h = new HashCode();
		h.Add( IsVisible );
		h.Add( PendingExpeditionId );
		h.Add( _currentFilter );
		h.Add( _currentSort );
		h.Add( _currentRarity );
		h.Add( _sortAscending );
		foreach ( var t in _team )
		{
			h.Add( t?.Id ?? Guid.Empty );
			h.Add( t?.CurrentHP ?? -1 ); // slot HP bar + KO badge
		}
		h.Add( _hoveredCardId ?? Guid.Empty ); // facts column follows the cursor
		h.Add( _kbIndex );
		h.Add( _hardMode );
		h.Add( IsHardUnlocked() );
		h.Add( _dragSource?.Id ?? Guid.Empty );
		h.Add( _dragHoverSlot ?? -1 );
		h.Add( _slotEditTestSpeciesId );
		h.Add( _slotEditDraggingId );
		var mm = MonsterManager.Instance;
		h.Add( mm?.OwnedMonsters?.Count ?? 0 );
		return h.ToHashCode();
	}
