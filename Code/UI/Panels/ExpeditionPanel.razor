		ExpeditionManager.Instance?.CancelExpedition();

		// Reset local UI state
		currentView = "list";
		selectedExpedition = null;
		selectedTeam.Clear();
		currentWave = 0;
		battleGold = 0;
		battleXP = 0;
		battleTokens = 0;
