@namespace Beastborne.UI.Panels
@using Sandbox;
@using Sandbox.UI;
@using Beastborne.Core;
@using Beastborne.Data;
@using Beastborne.Systems;
@using Beastborne.UI;
@using Beastborne.UI.Components;
@using System.Linq;
@using System.Collections.Generic;
@using Beastborne.Battle3D;
@inherits Panel

<div class="expedition-panel @(currentView == "team" ? "team-view" : "") @(currentView == "battle" ? "battle-mode" : "") @GetExpeditionBackgroundClass() @(currentView == "battle" && BattleSceneController.Instance?.IsActive == true ? "battle-3d" : "")" onclick=@OnPanelClicked>
	@* The old expedition LIST and RESULT views are gone: WorldMapPanel is the
	   entry point and ExpeditionResultPopup (a GameHUD child) shows results. *@
	@if (currentView == "team")
	{
		<!-- Team Selection View -->
		<div class="team-view @(teamViewEntered ? "entered" : "") @(isTransitioningToBattle ? "transitioning-out" : "") @(isTransitioningToList ? "transitioning-back" : "")">
		<div class="roster-header">
			<div class="header-left">
				<button class="back-btn" onclick=@GoToList onmouseover=@(() => SoundManager.PlayHover())><img class="back-icon" src="ui/icons/buttons/back.svg" /><img class="back-icon-anim" src="ui/icons/animated/back.webp" /></button>
				<div class="roster-title">@selectedExpedition?.Name</div>
			</div>
			<div class="header-filters">
				<FilterBar @ref="expeditionFilterBar"
						   CurrentElement=@expeditionFilter
						   CurrentSort=@expeditionSort
						   CurrentRarity=@expeditionRarity
						   ShowBeastiarySort=@true
						   ShowRarityFilter=@true
						   OnElementChanged=@OnExpeditionElementChanged
						   OnSortChanged=@OnExpeditionSortChanged
						   OnRarityChanged=@OnExpeditionRarityChanged
						   OnNameFilterChanged=@OnExpeditionNameFilterChanged
						   AvailableNames=@GetExpeditionMonsterNames() />
			</div>
			@{
				var hovered = GetHoveredMonster();
			}
			<div class="header-tooltip-strip">
				@if (hovered != null)
				{
					var species = MonsterManager.Instance?.GetSpecies(hovered.SpeciesId);
					<span class="tooltip-name">@(hovered.Nickname ?? species?.Name ?? "Unknown")</span>
					<span class="tooltip-level">@($"Lv{hovered.Level}")</span>
					<span class="tooltip-element @(species?.Element.ToString().ToLower() ?? "neutral")">@species?.Element</span>
					<span class="tooltip-stat"><span class="stat-name">HP</span><span class="stat-val">@hovered.MaxHP</span></span>
					<span class="tooltip-stat"><span class="stat-name">ATK</span><span class="stat-val">@hovered.ATK</span></span>
					<span class="tooltip-stat"><span class="stat-name">DEF</span><span class="stat-val">@hovered.DEF</span></span>
					<span class="tooltip-stat"><span class="stat-name">SpA</span><span class="stat-val">@hovered.SpA</span></span>
					<span class="tooltip-stat"><span class="stat-name">SpD</span><span class="stat-val">@hovered.SpD</span></span>
					<span class="tooltip-stat"><span class="stat-name">SPD</span><span class="stat-val">@hovered.SPD</span></span>
					@if (hovered.Traits != null && hovered.Traits.Count > 0)
					{
						@foreach (var traitId in hovered.Traits)
						{
							var trait = TraitDatabase.GetTrait(traitId);
							if (trait != null)
							{
								<span class="trait-badge">@trait.Name</span>
							}
						}
					}
				}
				else
				{
					<span class="tooltip-hint">Hover over a beast for details</span>
				}
			</div>
			<div class="header-right">
				<div class="team-counter">
					<span class="count-current">@selectedTeam.Count</span>
					<span class="count-divider">/</span>
					<span class="count-max">3</span>
				</div>
			</div>
		</div>

		<div class="team-selection">
			<!-- Left side: Monster grid -->
			<div class="selection-left">

				<!-- Monster grid -->
				<div class="available-monsters" @ref="availMonstersGrid">
						@{ var availMonsters = GetAvailableMonsters(); }
						@for (int mi = 0; mi < availMonsters.Count; mi++)
						{
							var m = availMonsters[mi];
							var isSelected = selectedTeam.Contains(m);
							var isHovered = hoveredMonsterId.HasValue && hoveredMonsterId.Value == m.Id;
							<div class="monster-option @(isSelected ? "in-team" : "") @(mi == selectedMonsterIndex ? "kb-selected" : "")">
								<MonsterCard Monster=@m IsCompact=@true AnimateOnHover=@true AnimationFrame=@SpriteAnimator.GlobalFrame
											 ShouldAnimate=@isHovered
											 ClickAction=@(() => ToggleMonster(m))
											 HoverAction=@(() => OnMonsterHover(m.Id))
											 LeaveAction=@OnMonsterLeave />
							</div>
						}
						@if (availMonsters.Count == 0)
						{
							<div class="no-monsters">
								<div class="empty-icon">?</div>
								<div class="empty-text">@L("ui.expedition.no_beasts")</div>
								<div class="empty-hint">@L("ui.expedition.no_beasts_hint")</div>
							</div>
						}
					</div>
				</div>

				<!-- Right side: Team Slots -->
				<div class="team-section">
				<div class="team-label">@L("ui.expedition.your_team")</div>
				<div class="selected-team">
					@for (int i = 0; i < 3; i++)
					{
						var index = i;
						var monster = selectedTeam.Count > index ? selectedTeam[index] : null;
						<div class="team-slot @(monster != null ? "filled" : "empty")"
							 onclick=@(() => { if (monster != null) RemoveFromTeam(monster); })>
							@if (monster != null)
							{
								<MonsterCard Monster=@monster IsCompact=@true AnimateOnHover=@true AnimationFrame=@SpriteAnimator.GlobalFrame />
							}
							else
							{
								<div class="slot-empty">
									<span class="slot-number">@(index + 1)</span>
									<span class="slot-label">@L("ui.expedition.empty")</span>
								</div>
							}
						</div>
					}
				</div>

				@{
					var expeditionHardUnlocked = IsHardModeUnlocked(selectedExpedition?.Id);
				}
				<div class="difficulty-toggle">
					<div class="diff-toggle-label">DIFFICULTY</div>
					<div class="diff-toggle-pills">
						<div class="diff-pill @(!hardModeEnabled ? "active" : "")"
							 onclick=@(() => SelectDifficulty(false))
							 onmouseover=@(() => SoundManager.PlayHover())>
							<span>NORMAL</span>
						</div>
						<div class="diff-pill hard @(hardModeEnabled ? "active" : "") @(!expeditionHardUnlocked ? "locked" : "")"
							 onclick=@(() => SelectDifficulty(true))
							 onmouseover=@(() => SoundManager.PlayHover())>
							@if (!expeditionHardUnlocked)
							{
								<span class="diff-lock">🔒</span>
							}
							<span class="diff-hard-label">HARD</span>
							@if (expeditionHardUnlocked)
							{
								<span class="diff-hard-bonus">+100% REWARDS</span>
							}
						</div>
					</div>
				</div>

				<button class="btn-primary btn-start @(selectedTeam.Count == 0 ? "disabled" : "") @(hardModeEnabled ? "hard-mode" : "")"
						onclick=@StartExpedition>
					<span class="btn-start-hard-label @(hardModeEnabled ? "visible" : "hidden")">HARD MODE</span>
					<span>BEGIN EXPEDITION</span>
				</button>
			</div>
		</div>
		</div>
	}
	else if (currentView == "battle")
	{
		<!-- Battle View -->
		<BattleView OnBattleEnd=@OnBattleComplete OnExpeditionCancelled=@OnExpeditionCancelled ExpeditionId="@(selectedExpedition?.Id ?? "")" />
	}

	@* ── Tier 3 expedition-CLEAR celebration ──────────────────────────────
	   One-shot "ZONE CLEARED" burst on a full zone clear. The @key bumps every
	   clear so the node is FRESHLY MOUNTED each time — which is exactly when
	   s&box @keyframes fire, so the slam + ray sweep + spark ring replay on
	   every clear without a transition two-step. pointer-events:none so it
	   never blocks the global result popup that lands on top of it. *@
	@if ( showClearCelebrate )
	{
		<div class="clear-celebrate" @key="clearCelebrateVersion">
			<div class="cc-flash"></div>
			<div class="cc-rays"></div>
			<div class="cc-ring"></div>
			<div class="cc-banner">
				<div class="cc-kicker">EXPEDITION</div>
				<div class="cc-title">ZONE CLEARED</div>
				<div class="cc-underline"></div>
			</div>
		</div>
	}

</div>

@code {
	// Localization helper
	private string L( string key ) => LocalizationManager.Get( key );
	private string L( string key, params object[] args ) => LocalizationManager.Get( key, args );

	private string currentView = "list";
	private Expedition selectedExpedition;
	private List<Monster> selectedTeam = new();
	private bool hardModeEnabled = false;
	private bool isTransitioningToBattle = false;
	private bool isTransitioningToList = false;

	// Team-view entrance: the `.team-view` mounts in its pre-entrance state, then
	// `teamViewEntered` flips true one frame later so CSS TRANSITIONS (not @keyframes,
	// which only fire on first DOM mount) drive the staggered slide-in. Re-entering
	// the team view resets this to false → the cascade replays every open.
	private bool teamViewEntered = false;

	// Tier 3 expedition-CLEAR celebration. When OnBattleComplete resolves a full
	// zone clear, ExpeditionPanel mounts a one-shot "ZONE CLEARED" burst overlay
	// (render-keyed so it replays on every clear) that lands the milestone beat
	// the panel itself owns, behind the global ExpeditionResultPopup.
	private bool showClearCelebrate = false;
	private int clearCelebrateVersion = 0;



	private int currentWave = 0;
	private int battleGold = 0;
	private int battleXP = 0;
	private int battleTokens = 0;

	// Team selection filter/sort state
	private string expeditionFilter = "all";
	private string expeditionSort = "power";
	private string expeditionRarity = "all";
	private string expeditionNameFilter = "";
	private FilterBar expeditionFilterBar;

	// Hover tooltip state (matches MonsterRosterPanel pattern)
	private Guid? hoveredMonsterId = null;

	private void OnMonsterHover(Guid monsterId)
	{
		if (hoveredMonsterId != monsterId)
		{
			hoveredMonsterId = monsterId;
			StateHasChanged();
		}
	}

	private void OnMonsterLeave()
	{
		if (hoveredMonsterId != null)
		{
			hoveredMonsterId = null;
			StateHasChanged();
		}
	}

	private Monster GetHoveredMonster()
	{
		if (!hoveredMonsterId.HasValue) return null;
		return MonsterManager.Instance?.OwnedMonsters?.FirstOrDefault(m => m.Id == hoveredMonsterId.Value);
	}


	// Keyboard navigation
	private int selectedExpeditionIndex = 0;
	private int selectedMonsterIndex = 0;
	private Panel availMonstersGrid;

	private void OnPanelClicked()
	{
		// When user clicks with mouse, ensure we're in panel mode (not tab navigation)
		GameHUD.EnterPanel();
	}

	protected override void OnAfterTreeRender(bool firstTime)
	{
		if (firstTime)
		{
			SyncWithBackgroundExpedition();

			// Subscribe to hard mode unlock so we can toast + refresh the toggle
			var expMgr = ExpeditionManager.Instance;
			if (expMgr != null)
				expMgr.OnHardModeUnlocked += OnHardModeUnlockedForExpedition;
		}
	}

	public override void OnDeleted()
	{
		base.OnDeleted();
		var expMgr = ExpeditionManager.Instance;
		if (expMgr != null)
			expMgr.OnHardModeUnlocked -= OnHardModeUnlockedForExpedition;
	}

	private void OnHardModeUnlockedForExpedition(string expeditionId)
	{
		// The manager already fires the notification; we just need to force a re-render
		// so the toggle becomes clickable for the newly unlocked zone.
		StateHasChanged();
	}

	public override void Tick()
	{
		base.Tick();

		// Check if we need to sync with a running expedition
		// This handles returning from background mode
		var expMgr = ExpeditionManager.Instance;
		if (expMgr?.CurrentExpedition != null && BattleManager.Instance?.IsInBattle == true)
		{
			// There's an active battle but we're not showing it
			if (currentView != "battle")
			{
				Log.Info($"ExpeditionPanel.Tick: Battle active but view is '{currentView}', syncing...");
				SyncWithBackgroundExpedition();
				StateHasChanged();
			}
			// Force UI updates while battle is active to ensure animations play
			else if (currentView == "battle")
			{
				StateHasChanged();
			}
		}
	}

	/// <summary>
	/// Called by GameHUD to handle keyboard input (child panels don't auto-tick in s&box Razor)
	/// </summary>
	public void TickInput()
	{
		HandleKeyboardInput();
		// Keep the keyboard-selected beast on screen in the team picker.
		if ( currentView == "team"
			&& ( Input.Pressed( "Left" ) || Input.Pressed( "Right" ) || Input.Pressed( "Up" ) || Input.Pressed( "Down" ) ) )
			UiGridScroll.ScrollIndexIntoView( availMonstersGrid, selectedMonsterIndex, "monster-option" );
	}

	// Live column count for the team-picker grid (responsive flex-wrap with a
	// gap). Counts cards sharing the first row's Y — gap-agnostic, unlike a
	// width/card-width division. Falls back to 4 before the first layout pass.
	private int GetTeamGridColumns()
	{
		if ( availMonstersGrid == null ) return 4;
		int count = 0;
		float rowTop = 0f;
		bool started = false;
		foreach ( var c in availMonstersGrid.Children )
		{
			if ( !c.HasClass( "monster-option" ) ) continue;
			var rect = c.Box.Rect;
			if ( rect.Width <= 0f ) return 4;
			if ( !started ) { rowTop = rect.Top; started = true; count = 1; }
			else if ( Math.Abs( rect.Top - rowTop ) <= 1f ) count++;
			else break;
		}
		return count > 0 ? count : 4;
	}

	private void HandleKeyboardInput()
	{
		// While a battle is in progress the battle UI (BattleView) owns the
		// keyboard — it handles move/target/swap input itself. The expedition
		// panel must not also consume the global edge-triggered presses.
		if (BattleManager.Instance?.IsInBattle == true) return;

		// A blocking popup is open — it owns the keyboard.
		if (UIModalState.AnyModalOpen) return;

		// List view - expedition selection
		if (currentView == "list")
		{
			var expeditions = GetExpeditions();
			if (expeditions.Count == 0)
			{
				// No expeditions - W/Up exits to tabs
				if (Input.Pressed("Up"))
				{
					GameHUD.ExitPanel();
				}
				return;
			}

			selectedExpeditionIndex = Math.Clamp(selectedExpeditionIndex, 0, expeditions.Count - 1);

			// Grid navigation (assume 2 columns)
			int columns = 2;

			if (Input.Pressed("Left"))
			{
				selectedExpeditionIndex = Math.Max(0, selectedExpeditionIndex - 1);
				SoundManager.PlayHover();
			}
			else if (Input.Pressed("Right"))
			{
				selectedExpeditionIndex = Math.Min(expeditions.Count - 1, selectedExpeditionIndex + 1);
				SoundManager.PlayHover();
			}
			else if (Input.Pressed("Up"))
			{
				// If at top row, exit to tab navigation
				if (selectedExpeditionIndex < columns)
				{
					GameHUD.ExitPanel();
				}
				else
				{
					selectedExpeditionIndex = Math.Max(0, selectedExpeditionIndex - columns);
					SoundManager.PlayHover();
				}
			}
			else if (Input.Pressed("Down"))
			{
				selectedExpeditionIndex = Math.Min(expeditions.Count - 1, selectedExpeditionIndex + columns);
				SoundManager.PlayHover();
			}
			else if (Input.Pressed("Jump") || Input.Pressed("Enter"))
			{
				var exp = expeditions[selectedExpeditionIndex];
				if (CanStartExpedition(exp))
				{
					SelectExpedition(exp);
					// If already selected, go to team
					if (selectedExpedition?.Id == exp.Id)
					{
						GoToTeam();
					}
				}
			}
			// Resume running expedition
			else if (Input.Pressed("reload") && IsExpeditionRunning())
			{
				ResumeExpedition();
			}
		}
		// Team view - monster selection
		else if (currentView == "team")
		{
			var monsters = GetAvailableMonsters();

			// Navigation
			if (monsters.Count > 0)
			{
				selectedMonsterIndex = Math.Clamp(selectedMonsterIndex, 0, monsters.Count - 1);
				int columns = GetTeamGridColumns();

				if (Input.Pressed("Left"))
				{
					selectedMonsterIndex = Math.Max(0, selectedMonsterIndex - 1);
					SoundManager.PlayHover();
				}
				else if (Input.Pressed("Right"))
				{
					selectedMonsterIndex = Math.Min(monsters.Count - 1, selectedMonsterIndex + 1);
					SoundManager.PlayHover();
				}
				else if (Input.Pressed("Up"))
				{
					// If at top row, go back to list
					if (selectedMonsterIndex < columns)
					{
						GoToList();
					}
					else
					{
						selectedMonsterIndex = Math.Max(0, selectedMonsterIndex - columns);
						SoundManager.PlayHover();
					}
				}
				else if (Input.Pressed("Down"))
				{
					selectedMonsterIndex = Math.Min(monsters.Count - 1, selectedMonsterIndex + columns);
					SoundManager.PlayHover();
				}
				else if (Input.Pressed("Jump") || Input.Pressed("Enter"))
				{
					// Add monster to team
					ToggleMonster(monsters[selectedMonsterIndex]);
				}
			}
			else if (Input.Pressed("Up"))
			{
				// Empty team grid — Up still backs out to the world map.
				GoToList();
			}

			// Enter to start expedition
			if (Input.Pressed("reload") && selectedTeam.Count > 0)
			{
				StartExpedition();
			}
			// Back to list — an INTERNAL sub-view move (team -> list), not an
			// exit to the tab bar, so claim the back key (GameHUD ticks after
			// this panel and would otherwise also see the Q and exit to tabs).
			else if (Input.Pressed("Menu") || Input.Pressed("run"))
			{
				GoToList();
				GameHUD.PanelHandledBackKey = true;
			}
			// Remove from team with number keys
			else if (Input.Pressed("Slot1") && selectedTeam.Count > 0)
			{
				RemoveFromTeam(selectedTeam[0]);
			}
			else if (Input.Pressed("Slot2") && selectedTeam.Count > 1)
			{
				RemoveFromTeam(selectedTeam[1]);
			}
			else if (Input.Pressed("Slot3") && selectedTeam.Count > 2)
			{
				RemoveFromTeam(selectedTeam[2]);
			}
		}
	}

	/// <summary>
	/// Sync panel state with any running background expedition
	/// </summary>
	private void SyncWithBackgroundExpedition()
	{
		var expMgr = ExpeditionManager.Instance;
		if (expMgr == null) return;

		var oldView = currentView;

		// If there's an expedition running (background or not), sync to it
		if (expMgr.CurrentExpedition != null)
		{
			selectedExpedition = expMgr.CurrentExpedition;
			selectedTeam = new List<Monster>(expMgr.SelectedTeam);
			currentWave = expMgr.CurrentWave;
			battleGold = expMgr.AccumulatedGold;
			battleXP = expMgr.AccumulatedXP;

			// If battle is in progress, show battle view
			if (BattleManager.Instance?.IsInBattle == true)
			{
				currentView = "battle";
			}
			// Post-battle result state: ResolveExpedition kept CurrentExpedition
			// alive so the 3D scene could stay rendered behind the popup. Keep
			// currentView on "battle" too so the scene + UI chrome don't flip
			// to the stale "list" card view.
			else if (ExpeditionResultPopup.IsVisible)
			{
				currentView = "battle";
			}
			// Stale state: CurrentExpedition is set but we're neither in battle
			// nor showing the result popup. This happens when the player loses,
			// the popup shows, they leave the tab WITHOUT clicking through, then
			// come back. ExpeditionPanel re-mounts fresh (currentView = "list"),
			// sees the stale expedition and would render the old card list.
			// Finalize so GameHUD swaps us back to the WorldMap.
			else
			{
				Log.Info("[ExpeditionPanel] Detected stale resolved-expedition state — finalizing to kick back to map");
				expMgr.FinalizeExpedition();
			}
		}

		if (oldView != currentView)
		{
			Log.Info($"SyncWithBackgroundExpedition: View changed from '{oldView}' to '{currentView}'");
		}
	}

	private List<Expedition> GetExpeditions()
	{
		return ExpeditionManager.Instance?.Expeditions?.ToList() ?? new();
	}

	private bool CanStartExpedition(Expedition expedition)
	{
		var tamer = TamerManager.Instance?.CurrentTamer;
		return tamer != null && tamer.Level >= expedition.RequiredLevel;
	}

	private string GetExpeditionBackgroundClass()
	{
		// Return CSS class for the expedition panel background (team select & battle)
		var expedition = selectedExpedition ?? ExpeditionManager.Instance?.CurrentExpedition;
		if (expedition == null) return "";

		return expedition.Id switch
		{
			"saltmoor_cove" => "expedition-bg-saltmoor_cove",
			"saltmoor_forest" => "expedition-bg-saltmoor_forest",
			"old_saltmoor" => "expedition-bg-old_saltmoor",
			_ => ""
		};
	}

	private void SelectExpedition(Expedition expedition)
	{
		if (CanStartExpedition(expedition))
		{
			selectedExpedition = expedition;
			SoundManager.PlaySelect();
			StateHasChanged();
		}
		else
		{
			SoundManager.PlayDeny();
		}
	}

	private bool IsHardModeUnlocked(string expeditionId = null)
	{
		return ExpeditionManager.Instance?.IsHardModeUnlocked(expeditionId) ?? false;
	}

	private void SelectDifficulty(bool hard)
	{
		// Can't select hard mode if not unlocked. Use the selected expedition's
		// id explicitly — the no-arg form falls back to CurrentExpedition, which
		// is null at the pre-embark team-view screen and would wrongly deny.
		if (hard && !IsHardModeUnlocked(selectedExpedition?.Id))
		{
			SoundManager.PlayDeny();
			return;
		}

		hardModeEnabled = hard;
		// hardModeEnabled is panel-local UI state; it's passed into
		// ExpeditionManager.StartExpedition(id, hardMode) at embark time
		// — the manager no longer caches a global flag (deleted with the
		// Hard Mode v1.2.0 ship; per-expedition Expedition.IsHardMode is
		// the source of truth at runtime).

		SoundManager.PlaySelect();
		StateHasChanged();
	}

	// FilterBar callback handlers
	private void OnExpeditionElementChanged(string element)
	{
		expeditionFilter = element;
		StateHasChanged();
	}

	private void OnExpeditionSortChanged(string sort)
	{
		expeditionSort = sort;
		StateHasChanged();
	}

	private void OnExpeditionRarityChanged(string rarity)
	{
		expeditionRarity = rarity;
		StateHasChanged();
	}

	private void OnExpeditionNameFilterChanged(string name)
	{
		expeditionNameFilter = name;
		StateHasChanged();
	}

	private List<string> GetExpeditionMonsterNames()
	{
		var monsters = MonsterManager.Instance?.OwnedMonsters ?? new List<Monster>();
		var names = new HashSet<string>();

		foreach (var monster in monsters)
		{
			if (!string.IsNullOrEmpty(monster.Nickname))
				names.Add(monster.Nickname);

			var species = MonsterManager.Instance?.GetSpecies(monster.SpeciesId);
			if (species != null && !string.IsNullOrEmpty(species.Name))
				names.Add(species.Name);
		}

		return names.OrderBy(n => n).ToList();
	}

	private int GetTotalGenes(Monster m)
	{
		if (m?.Genetics == null) return 0;
		return m.Genetics.HPGene + m.Genetics.ATKGene + m.Genetics.DEFGene +
			   m.Genetics.SpAGene + m.Genetics.SpDGene + m.Genetics.SPDGene;
	}

	private List<Monster> GetAvailableMonsters()
	{
		var monsters = MonsterManager.Instance?.OwnedMonsters
			?.Where(m => !selectedTeam.Contains(m))
			?.ToList() ?? new();

		// Element filter
		if (expeditionFilter != "all")
		{
			var elementType = expeditionFilter switch
			{
				"fire" => ElementType.Fire,
				"water" => ElementType.Water,
				"earth" => ElementType.Earth,
				"wind" => ElementType.Wind,
				"electric" => ElementType.Electric,
				"ice" => ElementType.Ice,
				"nature" => ElementType.Nature,
				"metal" => ElementType.Metal,
				"shadow" => ElementType.Shadow,
				"spirit" => ElementType.Spirit,
				"neutral" => ElementType.Neutral,
				_ => ElementType.Neutral
			};

			monsters = monsters.Where(m =>
			{
				var species = MonsterManager.Instance?.GetSpecies(m.SpeciesId);
				return species?.Element == elementType;
			}).ToList();
		}

		// Rarity filter
		if (expeditionRarity != "all")
		{
			var rarityType = expeditionRarity switch
			{
				"common" => Rarity.Common,
				"uncommon" => Rarity.Uncommon,
				"rare" => Rarity.Rare,
				"epic" => Rarity.Epic,
				"legendary" => Rarity.Legendary,
				"mythic" => Rarity.Mythic,
				_ => Rarity.Common
			};

			monsters = monsters.Where(m =>
			{
				var species = MonsterManager.Instance?.GetSpecies(m.SpeciesId);
				return species?.BaseRarity == rarityType;
			}).ToList();
		}

		// Name filter
		if (expeditionSort == "name" && !string.IsNullOrEmpty(expeditionNameFilter))
		{
			monsters = monsters.Where(m =>
			{
				var species = MonsterManager.Instance?.GetSpecies(m.SpeciesId);
				return species?.Name?.Equals(expeditionNameFilter, StringComparison.OrdinalIgnoreCase) == true ||
					   m.Nickname?.Equals(expeditionNameFilter, StringComparison.OrdinalIgnoreCase) == true;
			}).ToList();
		}

		// Sorting
		monsters = expeditionSort switch
		{
			"fav" => monsters.OrderByDescending(m => m.IsFavorite)
							.ThenByDescending(m => m.PowerRating).ToList(),
			"power" => monsters.OrderByDescending(m => m.PowerRating).ToList(),
			"level" => monsters.OrderByDescending(m => m.Level).ToList(),
			"genes" => monsters.OrderByDescending(m => GetTotalGenes(m)).ToList(),
			"rarity" => monsters.OrderByDescending(m => {
				var species = MonsterManager.Instance?.GetSpecies(m.SpeciesId);
				return (int)(species?.BaseRarity ?? Rarity.Common);
			}).ThenByDescending(m => m.PowerRating).ToList(),
			"recent" => monsters.OrderByDescending(m => m.CaughtAt).ToList(),
			"beastiary" => monsters.OrderBy(m => {
				var species = MonsterManager.Instance?.GetSpecies(m.SpeciesId);
				return species?.BeastiaryNumber ?? 9999;
			}).ToList(),
			"name" => monsters.OrderBy(m => m.Nickname ?? MonsterManager.Instance?.GetSpecies(m.SpeciesId)?.Name ?? "").ToList(),
			_ => monsters.OrderByDescending(m => m.PowerRating).ToList()
		};

		return monsters;
	}

	private void ToggleMonster(Monster monster)
	{
		Log.Info($"ToggleMonster called for: {monster?.Nickname ?? "null"}");
		if (monster == null) return;

		if (selectedTeam.Contains(monster))
		{
			selectedTeam.Remove(monster);
			SoundManager.PlayBack();
			Log.Info($"Removed {monster.Nickname} from team. Team count: {selectedTeam.Count}");
		}
		else if (selectedTeam.Count < 3)
		{
			selectedTeam.Add(monster);
			SoundManager.PlaySelect();
			Log.Info($"Added {monster.Nickname} to team. Team count: {selectedTeam.Count}");
		}
		else
		{
			SoundManager.PlayDeny();
		}

		StateHasChanged();
	}

	private void RemoveFromTeam(Monster monster)
	{
		selectedTeam.Remove(monster);
		SoundManager.PlayBack();
		StateHasChanged();
	}

	private async void StartExpedition()
	{
		Log.Info($"StartExpedition called. Team count: {selectedTeam.Count}, Expedition: {selectedExpedition?.Id ?? "null"}");
		if (selectedTeam.Count == 0 || selectedExpedition == null || isTransitioningToBattle)
		{
			Log.Warning($"Cannot start expedition: Team count={selectedTeam.Count}, Expedition={selectedExpedition?.Id ?? "null"}");
			SoundManager.PlayDeny();
			return;
		}

		SoundManager.PlayBattleStart();
		isTransitioningToBattle = true;

		// Step 1: Fade to black
		BattleTransition.FadeIn();
		await Task.Delay(350);
		BattleTransition.Hold();

		// Step 2: Screen is fully black — start the battle behind it
		battleGold = 0;
		battleXP = 0;
		battleTokens = 0;

		ExpeditionManager.Instance?.SelectTeam(selectedTeam);
		ExpeditionManager.Instance?.StartExpedition(selectedExpedition.Id, hardModeEnabled);

		currentWave = 1;
		currentView = "battle";
		isTransitioningToBattle = false;
		StateHasChanged();

		// Step 3: Let the 3D scene set up behind the black screen
		await Task.Delay(1200);

		// Step 4: Slide out, revealing the battle
		BattleTransition.FadeOut();
		await Task.Delay(700);
		BattleTransition.Hide();

		// Step 5: Now show the UI panels (they were hidden during transition)
		// BattleView re-renders and panel slide animations play now
		StateHasChanged();

	}

	private void OnBattleComplete(bool playerWon)
	{
		// Background mode: ExpeditionManager.OnBattleEndBackground handles the
		// entire resolve/teardown path while the player is on another tab.
		// Don't double-fire rewards + popup from the foreground handler.
		if (ExpeditionManager.Instance?.IsRunningInBackground == true)
		{
			Log.Info("OnBattleComplete: skipping — expedition is in background mode, manager handles it");
			return;
		}

		Log.Info($"OnBattleComplete: playerWon={playerWon}, currentWave={currentWave}, totalWaves={selectedExpedition?.Waves ?? 0}");

		var result = BattleManager.Instance?.CurrentResult;
		if (result != null)
		{
			battleGold += result.TotalGold;
			battleXP += result.TotalXP;

			// Track item drops from the battle
			if (result.ItemDrops?.Count > 0)
			{
				ExpeditionManager.Instance?.AddAccumulatedItems(result.ItemDrops);
				Log.Info($"OnBattleComplete: Added {result.ItemDrops.Count} item drops to accumulated items");
			}
		}

		// Note: Catchable enemies are now stored in BattleView.HandleBattleEnd before this callback runs

		// Determine if we're continuing to next wave (need transition-friendly exit)
		bool willContinue = playerWon && currentWave < (selectedExpedition?.Waves ?? 0);

		// Use transition-friendly exit if we're continuing, otherwise full exit
		if (willContinue)
		{
			BattleManager.Instance?.PrepareForNextWave();
			BattleManager.Instance?.ExitBattleForTransition();
		}
		else
		{
			BattleManager.Instance?.ExitBattle();
		}

		// Contracting is now handled mid-battle via the CONTRACT diamond button
		// Clear any remaining catchable enemies
		ExpeditionManager.Instance?.ClearCatchableEnemies();

		// Track wave cleared for missions (foreground path)
		if (playerWon)
		{
			MissionManager.Instance?.TrackWaveCleared();
		}

		// If player won and there are more waves, continue (don't exit battle - just start next wave)
		if (playerWon && currentWave < (selectedExpedition?.Waves ?? 0))
		{
			Log.Info($"OnBattleComplete: Continuing to next wave");
			ContinueExpedition();
			return;
		}
		else
		{
			// Either lost or completed all waves - show final result
			Log.Info($"OnBattleComplete: Showing result view");

			// Stash zone + team now so the popup has them for Retry / Embark
			// Again. ResolveExpedition awards rewards but keeps CurrentExpedition
			// and SelectedTeam alive so the 3D battle scene stays rendered
			// behind the popup — the player drives the teardown from the
			// popup's action buttons, not the battle-end event.
			var resultZoneId = selectedExpedition?.Id;
			var resultWave = currentWave;
			var resultTeam = new List<Monster>( selectedTeam );

			// Foreground result flow — awards rewards, fires events, but does
			// NOT null CurrentExpedition. FinalizeExpedition (called from the
			// popup buttons) handles that.
			ExpeditionManager.Instance?.ResolveExpedition(playerWon);

			// Track boss tokens that were just awarded (if won)
			if (playerWon)
			{
				battleTokens = ExpeditionManager.Instance?.LastAwardedBossTokens ?? 0;
			}

			// Tier 3 milestone beat: a successful FULL zone clear earns a one-shot
			// "ZONE CLEARED" burst the panel renders itself (render-keyed so it
			// replays on every clear). Defeats and partial exits skip it — the
			// celebration must feel earned, never fire on a loss.
			// Fire the global result popup. Keep currentView = "battle" so the
			// BattleView + 3D scene stay visible behind the modal.
			// On a win, ZONE CLEARED plays FIRST and the result popup follows it —
			// both used to fire at once, so the celebration played hidden behind
			// the popup's backdrop.
			// Snapshot the reward fields now — the popup may open ~1.1s later.
			var resultGold = battleGold;
			var resultXP = battleXP;
			var resultTokens = battleTokens;
			void ShowResult() => ExpeditionResultPopup.Show(
				won: playerWon,
				wave: resultWave,
				zoneId: resultZoneId,
				gold: resultGold,
				xp: resultXP,
				tokens: resultTokens,
				team: resultTeam );
			if ( playerWon )
				_ = FireClearCelebrate( ShowResult );
			else
				ShowResult();
		}

		StateHasChanged();
	}

	// Tier 3 expedition-CLEAR celebration. Mounts a render-keyed burst overlay
	// (the version bump forces a fresh DOM node so the transition replays even on
	// a back-to-back clear), holds briefly, then unmounts and hands off to
	// `then` (the result popup) so the two beats play in sequence, not stacked.
	private async Task FireClearCelebrate( Action then = null )
	{
		// Bump the @key so the overlay mounts FRESH — that fresh mount is what
		// makes the @keyframes play (re-using the node would not replay them).
		clearCelebrateVersion++;
		showClearCelebrate = true;
		SoundManager.PlaySuccess();
		StateHasChanged();
		// Hold the burst, then tear it down. The result popup carries the screen
		// from here, so the celebration is a quick "you did it" punctuation.
		await Task.Delay( 1100 );
		showClearCelebrate = false;
		StateHasChanged();
		then?.Invoke();
	}

	private void OnExpeditionCancelled()
	{
		Log.Info("Expedition cancelled by user");

		// Reset local state
		selectedExpedition = null;
		selectedTeam.Clear();
		currentWave = 0;
		battleGold = 0;
		battleXP = 0;
		battleTokens = 0;

		// Return to expedition list
		currentView = "list";
		StateHasChanged();
	}

	private void ContinueExpedition()
	{
		SoundManager.PlayForward();

		// Start next wave (ExpeditionManager increments the wave counter)
		ExpeditionManager.Instance?.StartNextWave();
		currentWave = ExpeditionManager.Instance?.CurrentWave ?? currentWave + 1;

		Log.Info($"ContinueExpedition: Wave={currentWave}, IsInBattle={BattleManager.Instance?.IsInBattle}");
	}

	private async void GoToList()
	{
		if (isTransitioningToList) return;

		SoundManager.PlayBack();

		// Start slide-out transition
		isTransitioningToList = true;
		StateHasChanged();

		// Wait for animation
		await Task.Delay(250);

		currentView = "list";
		isTransitioningToList = false;
		teamViewEntered = false; // re-arm the entrance cascade for next time
		StateHasChanged();
	}

	private async void GoToTeam()
	{
		SoundManager.PlayForward();
		// Reset hard mode to match the newly selected expedition's unlocked state.
		// hardModeEnabled is local UI state — no manager-side cache to clear post-v1.2.0.
		hardModeEnabled = false;
		currentView = "team";
		// Arm the transition-driven entrance cascade: mount in the pre-entered
		// state, then flip `.entered` next frame so transitions fire (and replay
		// on every re-open, unlike @keyframes).
		teamViewEntered = false;
		StateHasChanged();
		await Task.Delay( 30 );
		teamViewEntered = true;
		StateHasChanged();
	}

	private bool IsExpeditionRunning()
	{
		return ExpeditionManager.Instance?.CurrentExpedition != null
			&& currentView == "list";
	}

	private void ResumeExpedition()
	{
		// Sync local state with the running expedition
		var expMgr = ExpeditionManager.Instance;
		if (expMgr?.CurrentExpedition != null)
		{
			selectedExpedition = expMgr.CurrentExpedition;
			selectedTeam = new List<Monster>(expMgr.SelectedTeam);
			currentWave = expMgr.CurrentWave;
			battleGold = expMgr.AccumulatedGold;
			battleXP = expMgr.AccumulatedXP;
		}

		// Disable background mode so UI takes over
		ExpeditionManager.Instance?.DisableBackgroundMode();

		// Go to battle view
		currentView = "battle";
		StateHasChanged();
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add(currentView);
		hash.Add(selectedExpedition?.Id);
		hash.Add(selectedTeam.Count);
		hash.Add(currentWave);
		hash.Add(battleGold);
		hash.Add(battleXP);
		hash.Add(SpriteAnimator.GlobalFrame);
		hash.Add(MonsterManager.Instance?.OwnedMonsters?.Count ?? 0);
		foreach (var m in selectedTeam)
			hash.Add(m.Id);
		hash.Add(GetAvailableMonsters().Count);
		// Include hovered monster for tooltip
		hash.Add(hoveredMonsterId);
		// Keyboard-cursor index on the team-select grid — drives the
		// `.kb-selected` class; without it the cursor only repainted because
		// sprite animation forced a re-render every frame.
		hash.Add(selectedMonsterIndex);
		// Include running expedition state for the cancel bar
		hash.Add(ExpeditionManager.Instance?.CurrentExpedition?.Id);
		hash.Add(ExpeditionManager.Instance?.CurrentWave ?? 0);
		// Include transition states
		hash.Add(isTransitioningToBattle);
		hash.Add(isTransitioningToList);
		// Team-view entrance cascade + clear-celebration overlay
		hash.Add(teamViewEntered);
		hash.Add(showClearCelebrate);
		hash.Add(clearCelebrateVersion);
		hash.Add(hardModeEnabled);
		return hash.ToHashCode();
	}
}
