@namespace Beastborne.UI.Panels
@using Sandbox;
@using Sandbox.UI;
@using Beastborne.Core;
@using Beastborne.Data;
@using Beastborne.Systems;
@using Beastborne.UI;
@using Beastborne.UI.Components;
@using System.Linq;
@using System.Collections.Generic;
@using Beastborne.Battle3D;
@inherits Panel

<div class="expedition-panel @(currentView == "team" ? "team-view" : "") @(currentView == "battle" ? "battle-mode" : "") @GetExpeditionBackgroundClass() @(currentView == "battle" && BattleSceneController.Instance?.IsActive == true ? "battle-3d" : "")" onclick=@OnPanelClicked>
	@* ═══════════════════════════════════════════════════════════════
	   POST-WORLDMAP: the "list" and "result" currentView branches below
	   are legacy UI from before WorldMapPanel became the expedition entry
	   point and ExpeditionResultPopup (a global GameHUD child) took over
	   the result screen. The markup is kept for reference but gated off
	   via `false` so it can never render and confuse the player (the
	   "came back to old expedition screen" bug was this stale path
	   reaching render because currentView defaulted to "list" on re-mount).
	   SyncWithBackgroundExpedition now auto-finalizes stale resolved
	   expeditions, and the "list" view specifically bails to nothing so
	   the world-map swap happens on the next render.
	   ═══════════════════════════════════════════════════════════════ *@
	@if (false && currentView == "list")
	{
		<!-- Expedition List View -->
		<div class="panel-header">
			<div class="header-text">
				<img class="panel-title-icon" src="ui/icons/expedition.svg" />
				<div class="panel-title">@L("ui.expedition.title")</div>
			</div>
			<div class="expedition-controls">
			<!-- Difficulty Dropdown -->
			<div class="dropdown-container">
				<button class="dropdown-btn @(hardModeEnabled ? "hard-active" : "")" onclick=@ToggleDifficultyDropdown onmouseover=@(() => SoundManager.PlayHover())>
					<img class="dropdown-icon-svg" src="@(hardModeEnabled ? "ui/icons/sort/skull.svg" : "ui/icons/sword.svg")" />
					<span class="dropdown-label">@(hardModeEnabled ? L("ui.expedition.hard") : L("ui.expedition.normal"))</span>
					<span class="dropdown-arrow @(difficultyDropdownOpen ? "open" : "")">▼</span>
				</button>
				@if (difficultyDropdownOpen)
				{
					<div class="dropdown-menu">
						<div class="dropdown-item @(hardModeEnabled == false ? "active" : "")" onclick=@(() => SelectDifficulty(false)) onmouseover=@(() => SoundManager.PlayHover())>
							<img class="item-icon-svg" src="ui/icons/sword.svg" />
							<span class="item-label">@L("ui.expedition.normal")</span>
						</div>
						<div class="dropdown-item hard @(hardModeEnabled ? "active" : "") @(IsHardModeUnlocked() ? "" : "locked")" onclick=@(() => SelectDifficulty(true)) onmouseover=@(() => SoundManager.PlayHover())>
							@if (!IsHardModeUnlocked())
							{
								<span class="item-icon">🔒</span>
							}
							else
							{
								<img class="item-icon-svg" src="ui/icons/sort/skull.svg" />
							}
							<span class="item-label">@L("ui.expedition.hard")</span>
							@if (!IsHardModeUnlocked())
							{
								<span class="item-hint">@L("ui.expedition.unlock_cartographer")</span>
							}
							else
							{
								<span class="item-hint">@L("ui.expedition.hard_mode_benefit")</span>
							}
						</div>
					</div>
				}
			</div>

			<!-- Auto Contract Dropdown -->
			<div class="dropdown-container">
				<button class="dropdown-btn @(autoNegotiate ? "active" : "")" onclick=@ToggleCatchDropdown onmouseover=@(() => SoundManager.PlayHover())>
					<span class="dropdown-label">@L("ui.expedition.auto_contract")</span>
					<span class="dropdown-value @(autoNegotiate ? "enabled" : "")">@GetCatchStrategyLabel()</span>
					<span class="dropdown-arrow @(catchDropdownOpen ? "open" : "")">▼</span>
				</button>
				@if (catchDropdownOpen)
				{
					<div class="dropdown-menu catch-menu">
						<div class="dropdown-item @(!autoNegotiate ? "active" : "")" onclick=@(() => SelectCatchStrategy(-2)) onmouseover=@(() => SoundManager.PlayHover())>
							<img class="item-icon-svg" src="ui/icons/sort/x-circle.svg" />
							<span class="item-label">@L("ui.expedition.off")</span>
						</div>
						<div class="dropdown-divider"></div>
						<div class="dropdown-item @(autoNegotiate && autoNegotiateStrategy == -1 ? "active" : "")" onclick=@(() => SelectCatchStrategy(-1)) onmouseover=@(() => SoundManager.PlayHover())>
							<img class="item-icon-svg" src="ui/icons/sort/skip.svg" />
							<span class="item-label">@L("ui.expedition.skip")</span>
						</div>
						<div class="dropdown-item @(autoNegotiate && autoNegotiateStrategy == 0 ? "active" : "")" onclick=@(() => SelectCatchStrategy(0)) onmouseover=@(() => SoundManager.PlayHover())>
							<img class="item-icon-svg" src="ui/icons/sort/generous.svg" />
							<span class="item-label">@L("ui.expedition.generous")</span>
							<span class="item-cost">3<img class="currency-icon" src="ui/icons/currency/ink.svg" /></span>
						</div>
						<div class="dropdown-item @(autoNegotiate && autoNegotiateStrategy == 1 ? "active" : "")" onclick=@(() => SelectCatchStrategy(1)) onmouseover=@(() => SoundManager.PlayHover())>
							<img class="item-icon-svg" src="ui/icons/sort/handshake.svg" />
							<span class="item-label">@L("ui.expedition.fair")</span>
							<span class="item-cost">2<img class="currency-icon" src="ui/icons/currency/ink.svg" /></span>
						</div>
						<div class="dropdown-item @(autoNegotiate && autoNegotiateStrategy == 2 ? "active" : "")" onclick=@(() => SelectCatchStrategy(2)) onmouseover=@(() => SoundManager.PlayHover())>
							<img class="item-icon-svg" src="ui/icons/sort/strict.svg" />
							<span class="item-label">@L("ui.expedition.strict")</span>
							<span class="item-cost">1<img class="currency-icon" src="ui/icons/currency/ink.svg" /></span>
						</div>
						<div class="dropdown-item @(autoNegotiate && autoNegotiateStrategy == 3 ? "active" : "")" onclick=@(() => SelectCatchStrategy(3)) onmouseover=@(() => SoundManager.PlayHover())>
							<img class="item-icon-svg" src="ui/icons/currency/money.svg" />
							<span class="item-label">@L("ui.expedition.golden")</span>
							<span class="item-cost">2<img class="currency-icon" src="ui/icons/currency/ink.svg" />+<img class="currency-icon" src="ui/icons/currency/money.svg" /></span>
						</div>
						<div class="dropdown-divider"></div>
						<div class="dropdown-item" onclick=@OpenContractTargetSearch onmouseover=@(() => SoundManager.PlayHover())>
							<img class="item-icon-svg" src="ui/icons/sort/target.svg" />
							<span class="item-label">@(autoContractTargetSpecies != null ? L("ui.expedition.change_target") : L("ui.expedition.target_beast"))</span>
						</div>
						@if (autoContractTargetSpecies != null)
						{
							<div class="dropdown-item" onclick=@ClearContractTarget onmouseover=@(() => SoundManager.PlayHover())>
								<img class="item-icon-svg" src="ui/icons/sort/x-circle.svg" />
								<span class="item-label">@L("ui.expedition.clear_target")</span>
							</div>
						}
					</div>
				}
			</div>
		</div>
		</div>

		<div class="expedition-grid">
			@foreach (var expedition in GetExpeditions())
			{
				var isLocked = !CanStartExpedition(expedition);
				var isCleared = IsCleared(expedition);
				<div class="expedition-card @(isLocked ? "locked" : "") @(isCleared ? "cleared" : "") @(selectedExpedition?.Id == expedition.Id ? "selected" : "") @GetBackgroundClass(expedition) @(!hasAnimatedCards ? "animate-entrance" : "")"
					 onclick=@(() => SelectExpedition(expedition))>

					@if (!string.IsNullOrEmpty(GetBackgroundClass(expedition)))
					{
						<div class="card-gradient-overlay"></div>
					}

					<div class="card-element @expedition.Element.ToString().ToLower()">
						<img class="element-icon" src="ui/icons/elements/element_white/@(GetElementIconName(expedition.Element)).svg" />
					</div>

					<div class="card-body">
						<div class="card-title">@expedition.Name</div>
						<div class="card-desc">@expedition.Description</div>

						<div class="card-stats">
							<div class="stat-badge">
								<img class="stat-badge-icon" src="ui/icons/expedition_badges/waves.svg" />
								<span class="stat-value">@expedition.Waves Waves</span>
							</div>
							<div class="stat-badge @(hardModeEnabled ? "hard-mode" : "")">
								<img class="stat-badge-icon" src="ui/icons/expedition_badges/level.svg" />
								<span class="stat-value">Lv.@GetDisplayLevel(expedition)+</span>
							</div>
						</div>

						<div class="card-rewards">
							<div class="reward-badge gold @(hardModeEnabled ? "boosted" : "")">
								<img class="currency-icon" src="ui/icons/currency/money.svg" />
								<span>@GetDisplayGold(expedition)</span>
							</div>
							<div class="reward-badge xp @(hardModeEnabled ? "boosted" : "")">
								<img class="currency-icon" src="ui/icons/expedition_badges/xp.svg" />
								<span>@GetDisplayXP(expedition)</span>
							</div>
						</div>

						<div class="card-info-buttons">
							<div class="monsters-info-btn" onclick=@((e) => { e.StopPropagation(); ShowMonstersPopup(expedition); })>
								<img class="monsters-icon" src="ui/icons/beast.svg" />
								<span class="monsters-label">@L("ui.expedition.beasts")</span>
							</div>
							<div class="monsters-info-btn drops-btn" onclick=@((e) => { e.StopPropagation(); ShowDropsPopup(expedition); })>
								<img class="monsters-icon" src="ui/icons/expedition_badges/drops.svg" />
								<span class="monsters-label">@L("ui.expedition.drops")</span>
							</div>
						</div>
					</div>

					@if (isLocked)
					{
						<div class="locked-overlay">
							<span class="lock-icon">🔒</span>
							<span class="lock-text">Tamer Lv.@expedition.RequiredLevel</span>
						</div>
					}

					@if (isCleared)
					{
						<div class="cleared-mark">✓</div>
					}

					@if (selectedExpedition?.Id == expedition.Id)
					{
						<button class="card-select-team-btn" onclick=@((e) => { e.StopPropagation(); GoToTeam(); })>
							SELECT TEAM ▸
						</button>
					}
				</div>
			}
		</div>

		@if (showMonstersPopup && monstersPopupExpedition != null)
		{
			<div class="monsters-popup-overlay" onclick=@CloseMonstersPopup>
				<div class="monsters-popup" onclick=@((e) => e.StopPropagation())>
					<div class="popup-header">
						<span class="popup-title">@monstersPopupExpedition.Name</span>
						<button class="popup-close" onclick=@CloseMonstersPopup>×</button>
					</div>
					<div class="popup-content">
						@{
							var bossPool = BossPoolDatabase.GetPool(monstersPopupExpedition.Id);
							var bossSpeciesIds = bossPool?.Bosses?.Select(b => b.SpeciesId).ToHashSet() ?? new HashSet<string>();
							var regularSpecies = monstersPopupExpedition.PossibleSpecies.Where(s => !bossSpeciesIds.Contains(s)).ToList();
						}

						<!-- Regular Encounters Section -->
						<div class="popup-section">
							<div class="section-header">
								<span class="section-title">@L("ui.expedition.regular_encounters")</span>
								<span class="section-count">@regularSpecies.Count beasts</span>
							</div>
							<div class="monsters-grid">
								@foreach (var speciesId in regularSpecies)
								{
									var species = GetSpecies(speciesId);
									if (species != null)
									{
										var isDiscovered = IsSpeciesDiscovered(speciesId);
										var isSeen = IsSpeciesSeen(speciesId);
										<div class="monster-card @(isDiscovered ? "discovered" : isSeen ? "seen" : "unknown")">
											<div class="monster-sprite-container">
												@if (isDiscovered || isSeen)
												{
													<img class="monster-sprite" src="@species.IconPath" />
												}
												else
												{
													<div class="monster-sprite-unknown">?</div>
												}
												<div class="monster-status-badge @(isDiscovered ? "discovered" : isSeen ? "seen" : "unknown")">
													@if (isDiscovered) { <span>✓</span> }
													else if (isSeen) { <span>👁</span> }
													else { <span>?</span> }
												</div>
											</div>
											<div class="monster-details">
												@if (isDiscovered || isSeen)
												{
													<span class="monster-name">@species.Name</span>
													<div class="monster-element @species.Element.ToString().ToLower()">
														<img class="element-icon-inline" src="ui/icons/elements/transparent/@(GetElementIconName(species.Element)).svg" />
														<span>@species.Element</span>
													</div>
													<span class="monster-rarity @species.BaseRarity.ToString().ToLower()">@species.BaseRarity</span>
												}
												else
												{
													<span class="monster-name unknown">???</span>
													<span class="monster-element unknown">Unknown</span>
													<span class="monster-rarity unknown">???</span>
												}
											</div>
										</div>
									}
								}
							</div>
						</div>

						<!-- Boss Section -->
						@if (bossPool != null && bossPool.Bosses.Count > 0)
						{
							<div class="popup-section boss-section">
								<div class="section-header boss">
									<span class="section-title">@L("ui.expedition.boss_pool")</span>
									<span class="section-count">1 random boss per run</span>
								</div>
								<div class="monsters-grid boss-grid">
									@foreach (var boss in bossPool.Bosses)
									{
										var species = GetSpecies(boss.SpeciesId);
										if (species != null)
										{
											var isDiscovered = IsSpeciesDiscovered(boss.SpeciesId);
											var isSeen = IsSpeciesSeen(boss.SpeciesId);
											<div class="monster-card boss-card @(isDiscovered ? "discovered" : isSeen ? "seen" : "unknown")">
												<div class="monster-sprite-container">
													@if (isDiscovered || isSeen)
													{
														<img class="monster-sprite" src="@species.IconPath" />
													}
													else
													{
														<div class="monster-sprite-unknown">?</div>
													}
													<div class="boss-badge">BOSS</div>
													<div class="monster-status-badge @(isDiscovered ? "discovered" : isSeen ? "seen" : "unknown")">
														@if (isDiscovered) { <span>✓</span> }
														else if (isSeen) { <span>👁</span> }
														else { <span>?</span> }
													</div>
												</div>
												<div class="monster-details">
													@if (isDiscovered || isSeen)
													{
														<span class="monster-name">@species.Name</span>
														<div class="monster-element @species.Element.ToString().ToLower()">
															<img class="element-icon-inline" src="ui/icons/elements/transparent/@(GetElementIconName(species.Element)).svg" />
															<span>@species.Element</span>
														</div>
														<span class="monster-rarity @species.BaseRarity.ToString().ToLower()">@species.BaseRarity</span>
													}
													else
													{
														<span class="monster-name unknown">???</span>
														<span class="monster-element unknown">Unknown</span>
														<span class="monster-rarity unknown">???</span>
													}
												</div>
											</div>
										}
									}
								</div>
							</div>
						}
					</div>
				</div>
			</div>
		}

		@if (showDropsPopup && dropsPopupExpedition != null)
		{
			<div class="monsters-popup-overlay drops-popup-overlay" onclick=@CloseDropsPopup>
				<div class="monsters-popup drops-popup" onclick=@((e) => e.StopPropagation())>
					<div class="popup-header">
						<span class="popup-title">@dropsPopupExpedition.Name - Possible Drops</span>
						<button class="popup-close" onclick=@CloseDropsPopup>×</button>
					</div>
					<div class="popup-content">
						@{
							var drops = GetExpeditionDrops(dropsPopupExpedition);
							var consumables = drops.Where(d => d.Category == ItemCategory.Consumable).ToList();
							var heldItems = drops.Where(d => d.Category == ItemCategory.HeldItem).ToList();
							var relics = drops.Where(d => d.Category == ItemCategory.Relic).ToList();
						}

						@if (heldItems.Any())
						{
							<!-- Held Items Section -->
							<div class="popup-section">
								<div class="section-header held">
									<img class="section-icon-svg" src="ui/icons/sword.svg" /><span class="section-title">Held Items</span>
									<span class="section-count">@heldItems.Count items</span>
								</div>
								<div class="items-grid">
									@foreach (var item in heldItems.OrderBy(i => i.Rarity))
									{
										<div class="item-card @GetRarityClass(item.Rarity)">
											<div class="item-icon-container">
												<img class="item-icon" src="@item.IconPath" />
											</div>
											<div class="item-details">
												<span class="item-name">@item.Name</span>
												<span class="item-rarity @GetRarityClass(item.Rarity)">@item.Rarity</span>
												<span class="item-desc">@item.Description</span>
											</div>
										</div>
									}
								</div>
							</div>
						}

						@if (consumables.Any())
						{
							<!-- Consumables Section -->
							<div class="popup-section">
								<div class="section-header consumable">
									<span class="section-title">🧪 Consumables</span>
									<span class="section-count">@consumables.Count items</span>
								</div>
								<div class="items-grid">
									@foreach (var item in consumables.OrderBy(i => i.Rarity))
									{
										<div class="item-card @GetRarityClass(item.Rarity)">
											<div class="item-icon-container">
												<img class="item-icon" src="@item.IconPath" />
											</div>
											<div class="item-details">
												<span class="item-name">@item.Name</span>
												<span class="item-rarity @GetRarityClass(item.Rarity)">@item.Rarity</span>
												<span class="item-desc">@item.Description</span>
											</div>
										</div>
									}
								</div>
							</div>
						}

						@if (relics.Any())
						{
							<!-- Relics Section -->
							<div class="popup-section">
								<div class="section-header relic">
									<span class="section-title">🏺 Relics</span>
									<span class="section-count">@relics.Count items</span>
								</div>
								<div class="items-grid">
									@foreach (var item in relics.OrderBy(i => i.Rarity))
									{
										<div class="item-card @GetRarityClass(item.Rarity)">
											<div class="item-icon-container">
												<img class="item-icon" src="@item.IconPath" />
											</div>
											<div class="item-details">
												<span class="item-name">@item.Name</span>
												<span class="item-rarity @GetRarityClass(item.Rarity)">@item.Rarity</span>
												<span class="item-desc">@item.Description</span>
											</div>
										</div>
									}
								</div>
							</div>
						}

						@if (!drops.Any())
						{
							<div class="no-drops">
								<img class="empty-icon-svg" src="ui/icons/sort/box.svg" />
								<span class="empty-text">@L("ui.expedition.no_special_drops")</span>
								<span class="empty-hint">@L("ui.expedition.no_special_drops_hint")</span>
							</div>
						}
					</div>
				</div>
			</div>
		}

		@if (IsExpeditionRunning())
		{
			<div class="running-expedition-bar">
				<div class="running-info">
					<img class="running-icon-svg" src="ui/icons/sword.svg" />
					<span class="running-text">@GetRunningExpeditionName() - Wave @GetRunningWave()</span>
				</div>
				<div class="running-actions">
					<button class="btn-secondary" onclick=@ResumeExpedition>
						RESUME
					</button>
					<button class="btn-danger" onclick=@CancelExpedition>
						CANCEL
					</button>
				</div>
			</div>
		}

		@if (contractTargetSearchOpen)
		{
			<div class="monsters-popup-overlay contract-search-overlay" onclick=@CloseContractTargetSearch>
				<div class="contract-search-popup" onclick=@((e) => e.StopPropagation())>
					<div class="contract-search-header">
						<span class="contract-search-title">@L("ui.expedition.target_beast")</span>
						<button class="contract-search-close" onclick=@CloseContractTargetSearch>×</button>
					</div>
					<div class="contract-search-input-wrapper">
						<TextEntry class="contract-search-input" @ref="contractTargetSearchInput" Text="@contractTargetSearchText" Placeholder="Type to filter..." />
					</div>
					<div class="contract-search-results">
						@foreach (var species in GetFilteredSpecies())
						{
							<div class="contract-search-result @(autoContractTargetSpecies == species.Id ? "active" : "")" onclick=@(() => SelectContractTarget(species))>
								<span class="result-number">#@species.BeastiaryNumber</span>
								<img class="result-element-icon" src="ui/icons/elements/background/@(GetElementIconName(species.Element)).svg" />
								<span class="result-name">@species.Name</span>
							</div>
						}
						@if (GetFilteredSpecies().Count == 0)
						{
							<div class="contract-search-empty">@L("ui.battle.no_matches")</div>
						}
					</div>
				</div>
			</div>
		}
	}
	else if (currentView == "team")
	{
		<!-- Team Selection View -->
		<div class="team-view @(isTransitioningToBattle ? "transitioning-out" : "") @(isTransitioningToList ? "transitioning-back" : "")">
		<div class="roster-header">
			<div class="header-left">
				<button class="back-btn" onclick=@GoToList onmouseover=@(() => SoundManager.PlayHover())><img class="back-icon" src="ui/icons/buttons/back.svg" /><img class="back-icon-anim" src="ui/icons/animated/back.webp" /></button>
				<div class="roster-title">@selectedExpedition?.Name</div>
			</div>
			<div class="header-filters">
				<FilterBar @ref="expeditionFilterBar"
						   CurrentElement=@expeditionFilter
						   CurrentSort=@expeditionSort
						   CurrentRarity=@expeditionRarity
						   ShowBeastiarySort=@true
						   ShowRarityFilter=@true
						   OnElementChanged=@OnExpeditionElementChanged
						   OnSortChanged=@OnExpeditionSortChanged
						   OnRarityChanged=@OnExpeditionRarityChanged
						   OnNameFilterChanged=@OnExpeditionNameFilterChanged
						   AvailableNames=@GetExpeditionMonsterNames() />
			</div>
			@{
				var hovered = GetHoveredMonster();
			}
			<div class="header-tooltip-strip">
				@if (hovered != null)
				{
					var species = MonsterManager.Instance?.GetSpecies(hovered.SpeciesId);
					<span class="tooltip-name">@(hovered.Nickname ?? species?.Name ?? "Unknown")</span>
					<span class="tooltip-level">@($"Lv{hovered.Level}")</span>
					<span class="tooltip-element @(species?.Element.ToString().ToLower() ?? "neutral")">@species?.Element</span>
					<span class="tooltip-stat"><span class="stat-name">HP</span><span class="stat-val">@hovered.MaxHP</span></span>
					<span class="tooltip-stat"><span class="stat-name">ATK</span><span class="stat-val">@hovered.ATK</span></span>
					<span class="tooltip-stat"><span class="stat-name">DEF</span><span class="stat-val">@hovered.DEF</span></span>
					<span class="tooltip-stat"><span class="stat-name">SpA</span><span class="stat-val">@hovered.SpA</span></span>
					<span class="tooltip-stat"><span class="stat-name">SpD</span><span class="stat-val">@hovered.SpD</span></span>
					<span class="tooltip-stat"><span class="stat-name">SPD</span><span class="stat-val">@hovered.SPD</span></span>
					@if (hovered.Traits != null && hovered.Traits.Count > 0)
					{
						@foreach (var traitId in hovered.Traits)
						{
							var trait = TraitDatabase.GetTrait(traitId);
							if (trait != null)
							{
								<span class="trait-badge">@trait.Name</span>
							}
						}
					}
				}
				else
				{
					<span class="tooltip-hint">Hover over a beast for details</span>
				}
			</div>
			<div class="header-right">
				<div class="team-counter">
					<span class="count-current">@selectedTeam.Count</span>
					<span class="count-divider">/</span>
					<span class="count-max">3</span>
				</div>
			</div>
		</div>

		<div class="team-selection">
			<!-- Left side: Monster grid -->
			<div class="selection-left">

				<!-- Monster grid -->
				<div class="available-monsters" @ref="availMonstersGrid">
						@{ var availMonsters = GetAvailableMonsters(); }
						@for (int mi = 0; mi < availMonsters.Count; mi++)
						{
							var m = availMonsters[mi];
							var isSelected = selectedTeam.Contains(m);
							var isHovered = hoveredMonsterId.HasValue && hoveredMonsterId.Value == m.Id;
							<div class="monster-option @(isSelected ? "in-team" : "") @(mi == selectedMonsterIndex ? "kb-selected" : "")">
								<MonsterCard Monster=@m IsCompact=@true AnimateOnHover=@true AnimationFrame=@SpriteAnimator.GlobalFrame
											 ShouldAnimate=@isHovered
											 ClickAction=@(() => ToggleMonster(m))
											 HoverAction=@(() => OnMonsterHover(m.Id))
											 LeaveAction=@OnMonsterLeave />
							</div>
						}
						@if (availMonsters.Count == 0)
						{
							<div class="no-monsters">
								<div class="empty-icon">?</div>
								<div class="empty-text">@L("ui.expedition.no_beasts")</div>
								<div class="empty-hint">@L("ui.expedition.no_beasts_hint")</div>
							</div>
						}
					</div>
				</div>

				<!-- Right side: Team Slots -->
				<div class="team-section">
				<div class="team-label">@L("ui.expedition.your_team")</div>
				<div class="selected-team">
					@for (int i = 0; i < 3; i++)
					{
						var index = i;
						var monster = selectedTeam.Count > index ? selectedTeam[index] : null;
						<div class="team-slot @(monster != null ? "filled" : "empty")"
							 onclick=@(() => { if (monster != null) RemoveFromTeam(monster); })>
							@if (monster != null)
							{
								<MonsterCard Monster=@monster IsCompact=@true AnimateOnHover=@true AnimationFrame=@SpriteAnimator.GlobalFrame />
							}
							else
							{
								<div class="slot-empty">
									<span class="slot-number">@(index + 1)</span>
									<span class="slot-label">@L("ui.expedition.empty")</span>
								</div>
							}
						</div>
					}
				</div>

				@{
					var expeditionHardUnlocked = IsHardModeUnlocked(selectedExpedition?.Id);
				}
				<div class="difficulty-toggle">
					<div class="diff-toggle-label">DIFFICULTY</div>
					<div class="diff-toggle-pills">
						<div class="diff-pill @(!hardModeEnabled ? "active" : "")"
							 onclick=@(() => SelectDifficulty(false))
							 onmouseover=@(() => SoundManager.PlayHover())>
							<span>NORMAL</span>
						</div>
						<div class="diff-pill hard @(hardModeEnabled ? "active" : "") @(!expeditionHardUnlocked ? "locked" : "")"
							 onclick=@(() => SelectDifficulty(true))
							 onmouseover=@(() => SoundManager.PlayHover())>
							@if (!expeditionHardUnlocked)
							{
								<span class="diff-lock">🔒</span>
							}
							<span class="diff-hard-label">HARD</span>
							@if (expeditionHardUnlocked)
							{
								<span class="diff-hard-bonus">+100% REWARDS</span>
							}
						</div>
					</div>
				</div>

				<button class="btn-primary btn-start @(selectedTeam.Count == 0 ? "disabled" : "") @(hardModeEnabled ? "hard-mode" : "")"
						onclick=@StartExpedition>
					<span class="btn-start-hard-label @(hardModeEnabled ? "visible" : "hidden")">HARD MODE</span>
					<span>BEGIN EXPEDITION</span>
				</button>
			</div>
		</div>
		</div>
	}
	else if (currentView == "battle")
	{
		<!-- Battle View -->
		<BattleView OnBattleEnd=@OnBattleComplete OnExpeditionCancelled=@OnExpeditionCancelled ExpeditionId="@(selectedExpedition?.Id ?? "")" />
	}
	else if (false && currentView == "result")
	{
		<!-- LEGACY: result view is now rendered by the global
			 ExpeditionResultPopup (mounted in GameHUD) so it survives the
			 panel-swap that fires when the expedition ends. This inline
			 branch is unreachable — kept for reference only. -->
		<!-- Result Popup — dark backdrop + centered modal so the run's end
			 feels like a moment instead of a navigation. -->
		@{
			var isExpeditionComplete = lastBattleWon && currentWave >= (selectedExpedition?.Waves ?? 0);
		}
		<div class="result-popup-root @(lastBattleWon ? "victory" : "defeat")">
			<div class="result-popup-backdrop"></div>
			<div class="result-popup-modal">

				<div class="result-popup-banner">
					@if (isExpeditionComplete)
					{
						<div class="result-popup-icon victory">
							<img src="ui/icons/rarity/gold.svg" />
						</div>
						<div class="result-popup-kicker">EXPEDITION COMPLETE</div>
						<div class="result-popup-title">VICTORY</div>
						<div class="result-popup-subtitle">@selectedExpedition?.Name conquered</div>
					}
					else
					{
						<div class="result-popup-icon defeat">
							<img src="ui/icons/sort/skull.svg" />
						</div>
						<div class="result-popup-kicker">EXPEDITION FAILED</div>
						<div class="result-popup-title">DEFEATED</div>
						<div class="result-popup-subtitle">Your team fell on Wave @currentWave of @(selectedExpedition?.Waves ?? 0)</div>
					}
				</div>

				@if (lastBattleWon)
				{
					<div class="result-popup-rewards">
						<div class="result-reward-row">
							<img class="result-reward-icon" src="ui/icons/currency/money.svg" />
							<span class="result-reward-label">GOLD EARNED</span>
							<span class="result-reward-amount gold">+@battleGold</span>
						</div>
						<div class="result-reward-row">
							<img class="result-reward-icon" src="ui/icons/expedition_badges/xp.svg" />
							<span class="result-reward-label">TAMER XP</span>
							<span class="result-reward-amount xp">+@battleXP</span>
						</div>
						@if (battleTokens > 0)
						{
							<div class="result-reward-row">
								<img class="result-reward-icon" src="ui/icons/currency/token.svg" />
								<span class="result-reward-label">BOSS TOKENS</span>
								<span class="result-reward-amount tokens">+@battleTokens</span>
							</div>
						}
					</div>
				}

				<div class="result-popup-actions">
					@if (lastBattleWon)
					{
						<button class="result-btn primary" onclick=@EmbarkAgain>
							<iconify icon="lucide:compass" Size=@(16) Color="#ffffff" />
							<span>EMBARK AGAIN</span>
						</button>
						<button class="result-btn secondary" onclick=@ReturnToList>
							<iconify icon="lucide:map" Size=@(14) Color="#cbd5e1" />
							<span>RETURN TO MAP</span>
						</button>
					}
					else
					{
						<button class="result-btn primary" onclick=@(() => RetryExpedition(false))>
							<iconify icon="lucide:rotate-ccw" Size=@(16) Color="#ffffff" />
							<span>RETRY</span>
						</button>
						<button class="result-btn secondary" onclick=@EmbarkAgain>
							<iconify icon="lucide:users" Size=@(14) Color="#cbd5e1" />
							<span>CHANGE TEAM</span>
						</button>
						<button class="result-btn ghost" onclick=@ReturnToList>
							<iconify icon="lucide:map" Size=@(14) Color="#94a3b8" />
							<span>MAP</span>
						</button>
					}
				</div>
			</div>
		</div>
	}

</div>

@code {
	// Localization helper
	private string L( string key ) => LocalizationManager.Get( key );
	private string L( string key, params object[] args ) => LocalizationManager.Get( key, args );

	private string currentView = "list";
	private Expedition selectedExpedition;
	private List<Monster> selectedTeam = new();
	private bool autoNegotiate = false;
	private bool hardModeEnabled = false;
	private bool isTransitioningToBattle = false;
	private bool isTransitioningToList = false;
	private int autoNegotiateStrategy = 0;
	private string autoContractTargetSpecies
	{
		get => ExpeditionManager.Instance?.AutoContractTargetSpecies;
		set { if (ExpeditionManager.Instance != null) ExpeditionManager.Instance.AutoContractTargetSpecies = value; }
	}
	private bool hasAnimatedCards = false;

	// Dropdown states
	private bool difficultyDropdownOpen = false;
	private bool catchDropdownOpen = false;

	// Contract target search popup
	private bool contractTargetSearchOpen = false;
	private string contractTargetSearchText = "";
	private TextEntry contractTargetSearchInput;

	private bool lastBattleWon = false;
	private int currentWave = 0;
	private int battleGold = 0;
	private int battleXP = 0;
	private int battleTokens = 0;

	// Team selection filter/sort state
	private string expeditionFilter = "all";
	private string expeditionSort = "power";
	private string expeditionRarity = "all";
	private string expeditionNameFilter = "";
	private FilterBar expeditionFilterBar;

	// Hover tooltip state (matches MonsterRosterPanel pattern)
	private Guid? hoveredMonsterId = null;

	private void OnMonsterHover(Guid monsterId)
	{
		if (hoveredMonsterId != monsterId)
		{
			hoveredMonsterId = monsterId;
			StateHasChanged();
		}
	}

	private void OnMonsterLeave()
	{
		if (hoveredMonsterId != null)
		{
			hoveredMonsterId = null;
			StateHasChanged();
		}
	}

	private Monster GetHoveredMonster()
	{
		if (!hoveredMonsterId.HasValue) return null;
		return MonsterManager.Instance?.OwnedMonsters?.FirstOrDefault(m => m.Id == hoveredMonsterId.Value);
	}

	// Monsters popup state
	private bool showMonstersPopup = false;
	private Expedition monstersPopupExpedition;
	private bool showDropsPopup = false;
	private Expedition dropsPopupExpedition;

	// Keyboard navigation
	private int selectedExpeditionIndex = 0;
	private int selectedMonsterIndex = 0;
	private Panel availMonstersGrid;
	private int selectedTeamSlotIndex = 0;

	private void OnPanelClicked()
	{
		// When user clicks with mouse, ensure we're in panel mode (not tab navigation)
		GameHUD.EnterPanel();
	}

	protected override void OnAfterTreeRender(bool firstTime)
	{
		if (firstTime)
		{
			SyncWithBackgroundExpedition();
			_ = MarkCardsAnimated();

			// Subscribe to hard mode unlock so we can toast + refresh the toggle
			var expMgr = ExpeditionManager.Instance;
			if (expMgr != null)
				expMgr.OnHardModeUnlocked += OnHardModeUnlockedForExpedition;
		}
	}

	public override void OnDeleted()
	{
		base.OnDeleted();
		var expMgr = ExpeditionManager.Instance;
		if (expMgr != null)
			expMgr.OnHardModeUnlocked -= OnHardModeUnlockedForExpedition;
	}

	private void OnHardModeUnlockedForExpedition(string expeditionId)
	{
		// The manager already fires the notification; we just need to force a re-render
		// so the toggle becomes clickable for the newly unlocked zone.
		StateHasChanged();
	}

	private async Task MarkCardsAnimated()
	{
		await Task.Delay(600); // Wait for staggered animation to complete
		hasAnimatedCards = true;
		StateHasChanged();
	}

	public override void Tick()
	{
		base.Tick();

		// Update contract target search text from input
		if (contractTargetSearchInput != null && contractTargetSearchOpen)
		{
			contractTargetSearchText = contractTargetSearchInput.Text ?? "";
		}

		// Check if we need to sync with a running expedition
		// This handles returning from background mode
		var expMgr = ExpeditionManager.Instance;
		if (expMgr?.CurrentExpedition != null && BattleManager.Instance?.IsInBattle == true)
		{
			// There's an active battle but we're not showing it
			if (currentView != "battle")
			{
				Log.Info($"ExpeditionPanel.Tick: Battle active but view is '{currentView}', syncing...");
				SyncWithBackgroundExpedition();
				StateHasChanged();
			}
			// Force UI updates while battle is active to ensure animations play
			else if (currentView == "battle")
			{
				StateHasChanged();
			}
		}
	}

	/// <summary>
	/// Called by GameHUD to handle keyboard input (child panels don't auto-tick in s&box Razor)
	/// </summary>
	public void TickInput()
	{
		HandleKeyboardInput();
		// Keep the keyboard-selected beast on screen in the team picker.
		if ( currentView == "team"
			&& ( Input.Pressed( "Left" ) || Input.Pressed( "Right" ) || Input.Pressed( "Up" ) || Input.Pressed( "Down" ) ) )
			UiGridScroll.ScrollIndexIntoView( availMonstersGrid, selectedMonsterIndex, "monster-option" );
	}

	// Live column count for the team-picker grid (responsive flex-wrap with a
	// gap). Counts cards sharing the first row's Y — gap-agnostic, unlike a
	// width/card-width division. Falls back to 4 before the first layout pass.
	private int GetTeamGridColumns()
	{
		if ( availMonstersGrid == null ) return 4;
		int count = 0;
		float rowTop = 0f;
		bool started = false;
		foreach ( var c in availMonstersGrid.Children )
		{
			if ( !c.HasClass( "monster-option" ) ) continue;
			var rect = c.Box.Rect;
			if ( rect.Width <= 0f ) return 4;
			if ( !started ) { rowTop = rect.Top; started = true; count = 1; }
			else if ( Math.Abs( rect.Top - rowTop ) <= 1f ) count++;
			else break;
		}
		return count > 0 ? count : 4;
	}

	private void HandleKeyboardInput()
	{
		// While a battle is in progress the battle UI (BattleView) owns the
		// keyboard — it handles move/target/swap input itself. The expedition
		// panel must not also consume the global edge-triggered presses.
		if (BattleManager.Instance?.IsInBattle == true) return;

		// A blocking popup is open — it owns the keyboard.
		if (UIModalState.AnyModalOpen) return;

		// List view - expedition selection
		if (currentView == "list")
		{
			var expeditions = GetExpeditions();
			if (expeditions.Count == 0)
			{
				// No expeditions - W/Up exits to tabs
				if (Input.Pressed("Up"))
				{
					GameHUD.ExitPanel();
				}
				return;
			}

			selectedExpeditionIndex = Math.Clamp(selectedExpeditionIndex, 0, expeditions.Count - 1);

			// Grid navigation (assume 2 columns)
			int columns = 2;

			if (Input.Pressed("Left"))
			{
				selectedExpeditionIndex = Math.Max(0, selectedExpeditionIndex - 1);
				SoundManager.PlayHover();
			}
			else if (Input.Pressed("Right"))
			{
				selectedExpeditionIndex = Math.Min(expeditions.Count - 1, selectedExpeditionIndex + 1);
				SoundManager.PlayHover();
			}
			else if (Input.Pressed("Up"))
			{
				// If at top row, exit to tab navigation
				if (selectedExpeditionIndex < columns)
				{
					GameHUD.ExitPanel();
				}
				else
				{
					selectedExpeditionIndex = Math.Max(0, selectedExpeditionIndex - columns);
					SoundManager.PlayHover();
				}
			}
			else if (Input.Pressed("Down"))
			{
				selectedExpeditionIndex = Math.Min(expeditions.Count - 1, selectedExpeditionIndex + columns);
				SoundManager.PlayHover();
			}
			else if (Input.Pressed("Jump") || Input.Pressed("Enter"))
			{
				var exp = expeditions[selectedExpeditionIndex];
				if (CanStartExpedition(exp))
				{
					SelectExpedition(exp);
					// If already selected, go to team
					if (selectedExpedition?.Id == exp.Id)
					{
						GoToTeam();
					}
				}
			}
			// Resume running expedition
			else if (Input.Pressed("reload") && IsExpeditionRunning())
			{
				ResumeExpedition();
			}
		}
		// Team view - monster selection
		else if (currentView == "team")
		{
			var monsters = GetAvailableMonsters();

			// Navigation
			if (monsters.Count > 0)
			{
				selectedMonsterIndex = Math.Clamp(selectedMonsterIndex, 0, monsters.Count - 1);
				int columns = GetTeamGridColumns();

				if (Input.Pressed("Left"))
				{
					selectedMonsterIndex = Math.Max(0, selectedMonsterIndex - 1);
					SoundManager.PlayHover();
				}
				else if (Input.Pressed("Right"))
				{
					selectedMonsterIndex = Math.Min(monsters.Count - 1, selectedMonsterIndex + 1);
					SoundManager.PlayHover();
				}
				else if (Input.Pressed("Up"))
				{
					// If at top row, go back to list
					if (selectedMonsterIndex < columns)
					{
						GoToList();
					}
					else
					{
						selectedMonsterIndex = Math.Max(0, selectedMonsterIndex - columns);
						SoundManager.PlayHover();
					}
				}
				else if (Input.Pressed("Down"))
				{
					selectedMonsterIndex = Math.Min(monsters.Count - 1, selectedMonsterIndex + columns);
					SoundManager.PlayHover();
				}
				else if (Input.Pressed("Jump") || Input.Pressed("Enter"))
				{
					// Add monster to team
					ToggleMonster(monsters[selectedMonsterIndex]);
				}
			}
			else if (Input.Pressed("Up"))
			{
				// Empty team grid — Up still backs out to the world map.
				GoToList();
			}

			// Enter to start expedition
			if (Input.Pressed("reload") && selectedTeam.Count > 0)
			{
				StartExpedition();
			}
			// Back to list — an INTERNAL sub-view move (team -> list), not an
			// exit to the tab bar, so claim the back key (GameHUD ticks after
			// this panel and would otherwise also see the Q and exit to tabs).
			else if (Input.Pressed("Menu") || Input.Pressed("run"))
			{
				GoToList();
				GameHUD.PanelHandledBackKey = true;
			}
			// Remove from team with number keys
			else if (Input.Pressed("Slot1") && selectedTeam.Count > 0)
			{
				RemoveFromTeam(selectedTeam[0]);
			}
			else if (Input.Pressed("Slot2") && selectedTeam.Count > 1)
			{
				RemoveFromTeam(selectedTeam[1]);
			}
			else if (Input.Pressed("Slot3") && selectedTeam.Count > 2)
			{
				RemoveFromTeam(selectedTeam[2]);
			}
		}
		// Result view
		else if (currentView == "result")
		{
			if (Input.Pressed("Jump") || Input.Pressed("Enter") || Input.Pressed("Menu"))
			{
				if (lastBattleWon && currentWave < (selectedExpedition?.Waves ?? 0))
				{
					ContinueExpedition();
				}
				else
				{
					ReturnToList();
				}
				// Q here dismisses the result view internally — claim it so
				// GameHUD doesn't also exit to the tab bar this frame.
				if (Input.Pressed("Menu")) GameHUD.PanelHandledBackKey = true;
			}
		}
	}

	/// <summary>
	/// Sync panel state with any running background expedition
	/// </summary>
	private void SyncWithBackgroundExpedition()
	{
		var expMgr = ExpeditionManager.Instance;
		if (expMgr == null) return;

		var oldView = currentView;

		// Sync toggle states
		autoNegotiate = expMgr.AutoNegotiate;
		autoNegotiateStrategy = expMgr.AutoNegotiateStrategy;

		// If there's an expedition running (background or not), sync to it
		if (expMgr.CurrentExpedition != null)
		{
			selectedExpedition = expMgr.CurrentExpedition;
			selectedTeam = new List<Monster>(expMgr.SelectedTeam);
			currentWave = expMgr.CurrentWave;
			battleGold = expMgr.AccumulatedGold;
			battleXP = expMgr.AccumulatedXP;

			// If battle is in progress, show battle view
			if (BattleManager.Instance?.IsInBattle == true)
			{
				currentView = "battle";
			}
			// Post-battle result state: ResolveExpedition kept CurrentExpedition
			// alive so the 3D scene could stay rendered behind the popup. Keep
			// currentView on "battle" too so the scene + UI chrome don't flip
			// to the stale "list" card view.
			else if (ExpeditionResultPopup.IsVisible)
			{
				currentView = "battle";
			}
			// Stale state: CurrentExpedition is set but we're neither in battle
			// nor showing the result popup. This happens when the player loses,
			// the popup shows, they leave the tab WITHOUT clicking through, then
			// come back. ExpeditionPanel re-mounts fresh (currentView = "list"),
			// sees the stale expedition and would render the old card list.
			// Finalize so GameHUD swaps us back to the WorldMap.
			else
			{
				Log.Info("[ExpeditionPanel] Detected stale resolved-expedition state — finalizing to kick back to map");
				expMgr.FinalizeExpedition();
			}
		}

		if (oldView != currentView)
		{
			Log.Info($"SyncWithBackgroundExpedition: View changed from '{oldView}' to '{currentView}'");
		}
	}

	private List<Expedition> GetExpeditions()
	{
		return ExpeditionManager.Instance?.Expeditions?.ToList() ?? new();
	}

	private bool CanStartExpedition(Expedition expedition)
	{
		var tamer = TamerManager.Instance?.CurrentTamer;
		return tamer != null && tamer.Level >= expedition.RequiredLevel;
	}

	private bool IsCleared(Expedition expedition)
	{
		var expeditions = GetExpeditions();
		var index = expeditions.IndexOf(expedition);
		var tamer = TamerManager.Instance?.CurrentTamer;
		return tamer != null && index < tamer.HighestExpeditionCleared;
	}

	private string GetElementIconName(ElementType element)
	{
		return element.ToString().ToLower();
	}

	private int GetDisplayLevel(Expedition expedition)
	{
		if (hardModeEnabled)
			return (int)Math.Floor(expedition.BaseEnemyLevel * ExpeditionManager.HARD_MODE_LEVEL_MULT);
		return expedition.BaseEnemyLevel;
	}

