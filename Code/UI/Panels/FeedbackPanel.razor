	private void BeginResolve(int id)
	{
		resolvingId = id;
		resolveNoteDraft = "";
		SoundManager.PlayClick();
		StateHasChanged();
	}

	private void CancelResolve()
	{
		resolvingId = null;
		resolveNoteDraft = "";
		SoundManager.PlayBack();
		StateHasChanged();
	}

	private async void ConfirmResolve(int id)
	{
		SoundManager.PlayForward();
		var updated = await FeedbackApiClient.PatchAsync(id, resolved: true, resolvedNote: resolveNoteDraft?.Trim());
		resolvingId = null;
		resolveNoteDraft = "";
		if (updated != null) await RefreshAsync();
		else StateHasChanged();
	}

	private async void ReopenEntry(int id)
	{
		SoundManager.PlayClick();
		var updated = await FeedbackApiClient.PatchAsync(id, resolved: false, resolvedNote: "");
		if (updated != null) await RefreshAsync();
	}

	private async void DeleteEntry(int id)
	{
		SoundManager.PlayClick();
		var ok = await FeedbackApiClient.DeleteAsync(id);
		if (ok)
		{
			expandedId = null;
			await RefreshAsync();
		}
	}

