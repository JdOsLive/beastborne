	// HELPERS
	// ==========================================

	private bool IsDev()
	{
		var id = Connection.Local?.SteamId ?? 0;
		return id == 76561198088759073;
	}

	private string GetAuthorName()
	{
		var tamer = TamerManager.Instance?.CurrentTamer;
		if (tamer != null && !string.IsNullOrEmpty(tamer.Name)) return tamer.Name;
		return Connection.Local?.DisplayName ?? "Anonymous";
	}

	private string GetGameVersion() => "1.2.1";

	private string FormatTag(string tag)
	{
		if (string.IsNullOrEmpty(tag)) return "";
		var all = BugTags.Concat(SuggestionTags).FirstOrDefault(t => t.Id == tag);
		return all?.Label ?? tag;
	}

	private string FormatDate(string isoDate)
	{
		if (string.IsNullOrEmpty(isoDate)) return "";
		if (!DateTime.TryParse(isoDate, out var dt)) return isoDate;
		var delta = DateTime.UtcNow - dt.ToUniversalTime();
		if (delta.TotalMinutes < 1) return "just now";
		if (delta.TotalMinutes < 60) return $"{(int)delta.TotalMinutes}m ago";
		if (delta.TotalHours < 24) return $"{(int)delta.TotalHours}h ago";
		if (delta.TotalDays < 30) return $"{(int)delta.TotalDays}d ago";
		return dt.ToLocalTime().ToString("MMM d");
	}

