	private async void OnVoteClick(int entryId)
	{
		SoundManager.PlayClick();
		var result = await FeedbackApiClient.ToggleVoteAsync(entryId);
		if (result == null) return;

		var entry = entries.FirstOrDefault(e => e.Id == entryId);
		if (entry != null)
		{
			entry.Votes = result.Votes;
			entry.VotedByMe = result.VotedByMe;
		}
		StateHasChanged();
	}

	private void OnHover(string key)
	{
		// Keyboard mode: scroll-follow slides rows under a parked cursor and
		// fires synthetic mouseovers — ignore them (no blip, no cursor steal).
		if (_kbMode) return;

		// Hover == focus: the mouse writes the same cursor the keyboard walks.
		var rows = GetKbRows();
		for (int r = 0; r < rows.Count; r++)
		{
			if (rows[r].Contains(key)) { _kbKey = key; _kbRow = r; break; }
		}

		if (_lastHoveredKey == key) return;
		_lastHoveredKey = key;
		SoundManager.PlayHover();
	}

	// ==========================================
	// KEYBOARD NAV
	// ==========================================

	private string Kb(string key) => _kbKey == key ? "kb-focused" : "";
	private string KbRow(bool focused) => focused ? "kb-row" : "";

	// Active chip tint is inline; drop its border-color while the chip holds
	// the keyboard cursor so the .kb-focused ring (class border) shows.
	private string ChipStyle(string color, bool isActive, string key, float bgAlpha, float borderAlpha)
	{
		if (!isActive) return "";
		var border = (_kbMode && _kbKey == key) ? "" : "border-color: " + Hex2Rgba(color, borderAlpha) + "; ";
		return "background-color: " + Hex2Rgba(color, bgAlpha) + "; " + border + "color: " + color + ";";
	}

	private void OnModalMouseMove()
	{
		if (!_kbMode) return;
		_kbMode = false;
		StateHasChanged();
	}

	// Render-order nav rows for the current view. Keys match the OnHover ids.
	private List<List<string>> GetKbRows()
	{
		var rows = new List<List<string>>();
		if (composerOpen)
		{
			rows.Add(new List<string> { "composer-close" });
			rows.Add(GetTagsForType(composerType).Select(t => "ctag-" + t.Id).ToList());
			rows.Add(new List<string> { "field-title" });
			rows.Add(new List<string> { "field-what" });
			if (composerType == "bug")
			{
				rows.Add(new List<string> { "field-steps" });
				rows.Add(new List<string> { "field-expected", "field-actual" });
			}
			rows.Add(new List<string> { "composer-cancel", "composer-submit" });
			return rows;
		}

		var header = new List<string>();
		if (myResolvedUnreadCount > 0 && currentTab != "mine") header.Add("dev-reply-chip");
		header.Add("close");
		rows.Add(header);

		rows.Add(new List<string> { "tab-bugs", "tab-ideas", "tab-resolved", "tab-mine" });

		var toolbar = new List<string> { "sort-top", "sort-new", "tag-all" };
		toolbar.AddRange(GetTagsForCurrentTab().Select(t => "tag-" + t.Id));
		if (currentTab == "bugs" || currentTab == "ideas") toolbar.Add("new-post");
		rows.Add(toolbar);

		if (!isLoading)
		{
			if (filteredEntries.Count == 0)
			{
				if (currentTab != "resolved") rows.Add(new List<string> { "empty-cta" });
			}
			else
			{
				foreach (var e in filteredEntries)
					rows.Add(new List<string> { "vote-" + e.Id, "entry-" + e.Id });
			}
		}

		rows.Add(new List<string> { "refresh" });
		return rows;
	}

	private static bool IsEntryRow(List<string> row) => row.Count == 2 && row[1].StartsWith("entry-");

	private bool AnyFieldFocused() =>
		(titleInput?.HasFocus ?? false) || (whatInput?.HasFocus ?? false) ||
		(versionInput?.HasFocus ?? false) || (stepsInput?.HasFocus ?? false) ||
		(expectedInput?.HasFocus ?? false) || (actualInput?.HasFocus ?? false) ||
		(resolveNoteInput?.HasFocus ?? false);

	private void BlurFields()
	{
		titleInput?.Blur();
		whatInput?.Blur();
		versionInput?.Blur();
		stepsInput?.Blur();
		expectedInput?.Blur();
		actualInput?.Blur();
		resolveNoteInput?.Blur();
	}

	private void TickKeyboard()
	{
		if (!UIModalState.IsTopModal("FeedbackPanel")) return;
		if (NavManager.RoutedThisFrame) return; // the key that opened us
		// (No ChatPanel.IsChatFocused gate: it now reads true for OUR fields too,
		// and the fieldFocused block below must still run for Tab-out.)

		// Typing must never drive nav. Skip while a TextEntry has focus AND
		// for one frame after it loses it (the Enter/Esc that blurred the field
		// is still "Pressed" this frame). Tab leaves the field.
		bool fieldFocused = AnyFieldFocused();
		if (fieldFocused || _fieldFocusedLastFrame)
		{
			_fieldFocusedLastFrame = fieldFocused;
			if (fieldFocused && Input.Pressed("Score"))
			{
				BlurFields();
				_kbMode = true;
				SoundManager.PlayHover();
			}
			return;
		}

		// ── Q — back out one level: composer → resolve form → expanded entry → close ──
		if (Input.Pressed("Menu"))
		{
			GameHUD.PanelHandledBackKey = true;
			if (composerOpen) CloseComposer();
			else if (resolvingId != null) CancelResolve();
			else if (expandedId != null)
			{
				expandedId = null;
				SoundManager.PlayBack();
				StateHasChanged();
			}
			else
			{
				Hide();
				NavManager.MarkRouted();
			}
			return;
		}

		// ── WASD (+ arrows via Up/Down) — move the cursor ──
		if (Input.Pressed("Forward") || Input.Pressed("Up")) { KbMove(-1, 0); return; }
		if (Input.Pressed("Backward") || Input.Pressed("Down")) { KbMove(1, 0); return; }
		if (Input.Pressed("Left")) { KbMove(0, -1); return; }
		if (Input.Pressed("Right")) { KbMove(0, 1); return; }

		// ── Space / Enter / E — activate the focused control ──
		if (UiInput.ConfirmPressed())
		{
			_kbMode = true;
			KbActivate(_kbKey);
		}
	}

	private void KbMove(int dRow, int dCol)
	{
		var rows = GetKbRows();
		if (rows.Count == 0) return;

		int r = -1, c = 0;
		for (int i = 0; i < rows.Count && r < 0; i++)
		{
			int j = rows[i].IndexOf(_kbKey);
			if (j >= 0) { r = i; c = j; }
		}

		string next;
		if (r < 0)
		{
			// Cursor key vanished (list reloaded / tab changed) — re-seat on the
			// same row index without moving.
			r = Math.Clamp(_kbRow, 0, rows.Count - 1);
			next = rows[r][IsEntryRow(rows[r]) ? 1 : 0];
		}
		else if (dRow != 0)
		{
			int nr = Math.Clamp(r + dRow, 0, rows.Count - 1);
			int nc = (IsEntryRow(rows[nr]) && !IsEntryRow(rows[r]))
				? 1 // entering the list lands on the entry body, not the vote
				: Math.Min(c, rows[nr].Count - 1);
			r = nr;
			next = rows[r][nc];
		}
		else
		{
			next = rows[r][Math.Clamp(c + dCol, 0, rows[r].Count - 1)];
		}

		_kbMode = true;
		_kbRow = r;
		if (next != _kbKey)
		{
			_kbKey = next;
			SoundManager.PlayHover();
		}
		_scrollFollowTries = 4;
		StateHasChanged();
	}

	private void KbActivate(string key)
	{
		if (string.IsNullOrEmpty(key)) return;
		int id;

		switch (key)
		{
			case "close": Hide(); NavManager.MarkRouted(); return;
			case "dev-reply-chip": SelectTab("mine"); return;
			case "sort-top": SelectSort("top"); return;
			case "sort-new": SelectSort("new"); return;
			case "tag-all": SelectTag(null); return;
			case "new-post": OpenComposer(); return;
			case "refresh": OnManualRefresh(); return;
			case "empty-cta":
				if (currentTab == "bugs" || currentTab == "ideas") OpenComposer();
				else if (currentTab == "mine") SelectTab("bugs");
				return;
			case "composer-close":
			case "composer-cancel": CloseComposer(); return;
			case "composer-submit":
				if (CanSubmit()) Submit();
				else SoundManager.PlayDeny();
				return;
			case "field-title": FocusField(titleInput); return;
			case "field-what": FocusField(whatInput); return;
			case "field-steps": FocusField(stepsInput); return;
			case "field-expected": FocusField(expectedInput); return;
			case "field-actual": FocusField(actualInput); return;
		}

		if (key.StartsWith("tab-")) SelectTab(key.Substring(4));
		else if (key.StartsWith("tag-")) SelectTag(key.Substring(4));
		else if (key.StartsWith("ctag-")) SelectComposerTag(key.Substring(5));
		else if (key.StartsWith("entry-") && int.TryParse(key.Substring(6), out id)) ToggleExpand(id);
		else if (key.StartsWith("vote-") && int.TryParse(key.Substring(5), out id)) OnVoteClick(id);
	}

	private void FocusField(TextEntry field)
	{
		if (field == null) return;
		field.Focus();
		_fieldFocusedLastFrame = true; // swallow the rest of this frame's keys
		SoundManager.PlayClick();
	}

	// Keep the focused scroll row in view (Inventory satGrid scroll-follow math).
	// Retries a few ticks because the .kb-row class lands on the next render.
	private void TickScrollFollow()
	{
		if (_scrollFollowTries <= 0) return;
		_scrollFollowTries--;

		var scroll = composerOpen ? composerScrollRef : entryScrollRef;
		if (scroll == null) return;

		Panel target = null;
		foreach (var ch in scroll.Children)
		{
			if (ch.HasClass("kb-row")) { target = ch; break; }
		}
		if (target == null) return;

		var gr = scroll.Box.Rect;
		var cr = target.Box.Rect;
		if (gr.Height <= 0f || cr.Height <= 0f) return;

		float curOff = scroll.ScrollOffset.y;
		float top = cr.Top - gr.Top + curOff;
		float bot = top + cr.Height;
		const float margin = 16f;
		float newOff = curOff;
		if (top - margin < curOff) newOff = top - margin;
		else if (bot + margin > curOff + gr.Height) newOff = bot + margin - gr.Height;
		newOff = Math.Max(0f, newOff);
		if (Math.Abs(newOff - curOff) > 0.5f)
			scroll.ScrollOffset = new Vector2(scroll.ScrollOffset.x, newOff);
	}

