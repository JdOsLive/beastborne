	// ==========================================
	// RENDER FRAGMENTS — match HelpPanel/OptionsPanel canonical lambda form.
	// ==========================================

	private RenderFragment RenderEmpty() => __builder =>
	{
		<div class="fb-empty">
			<div class="empty-frame">
				<div class="empty-frame-bg"></div>
				<iconify class="empty-icon" icon="@GetEmptyIcon()" Size=@(56) Color="rgba(196, 181, 253, 0.85)" />
			</div>
			<div class="empty-text">
				<span class="empty-title">@GetEmptyTitle()</span>
				<span class="empty-body">@GetEmptyBody()</span>
			</div>
			@if (currentTab == "bugs" || currentTab == "ideas")
			{
				<button class="empty-cta @(currentTab == "ideas" ? "is-idea" : "is-bug")"
						onclick=@OpenComposer
						onmouseover=@(() => OnHover("empty-cta"))>
					<iconify icon="@(currentTab == "bugs" ? "lucide:bug" : "lucide:lightbulb")" Size=@(13) Color="#ffffff" />
					<span>@(currentTab == "bugs" ? "REPORT FIRST BUG" : "POST FIRST IDEA")</span>
				</button>
			}
			else if (currentTab == "mine")
			{
				<button class="empty-cta is-bug"
						onclick=@(() => SelectTab("bugs"))
						onmouseover=@(() => OnHover("empty-cta"))>
					<iconify icon="lucide:arrow-left" Size=@(13) Color="#ffffff" />
					<span>BROWSE BUGS</span>
				</button>
			}
		</div>
	};

	private RenderFragment RenderEntry(FeedbackEntry entry) => __builder =>
	{
		var color = GetTagColor(entry.Tag);
		var isExpanded = expandedId == entry.Id;
		var isResolved = entry.Resolved;
		<div class="fb-entry @(isExpanded ? "expanded" : "") @(isResolved ? "resolved" : "")"
			 onclick=@(() => ToggleExpand(entry.Id))
			 onmouseover=@(() => OnHover("entry-" + entry.Id))>

			@* Left vote column *@
			<div class="entry-vote-col" onclick=@((e) => { e.StopPropagation(); OnVoteClick(entry.Id); })>
				<div class="vote-btn @(entry.VotedByMe ? "voted" : "")"
					 onmouseover=@(() => OnHover("vote-" + entry.Id))>
					<iconify class="vote-arrow" icon="lucide:chevron-up" Size=@(18) Color="@(entry.VotedByMe ? "#ffffff" : "#a78bfa")" />
				</div>
				<span class="vote-count @(entry.VotedByMe ? "voted" : "")">@entry.Votes</span>
			</div>

			@* Tag rail — color-coded vertical strip on the LEFT edge of the entry *@
			<div class="entry-rail" style="background-color: @color;"></div>

			@* Body column *@
			<div class="entry-body">
				<div class="entry-header-row">
					<span class="entry-title">@entry.Title</span>
					<div class="tag-pill"
						 style="background-color: @Hex2Rgba(color, 0.18f); border-color: @Hex2Rgba(color, 0.55f); color: @color;">
						<div class="tag-pill-dot" style="background-color: @color;"></div>
						<span>@FormatTag(entry.Tag)</span>
					</div>
					@if (isResolved)
					{
						<div class="resolved-pill">
							<iconify icon="lucide:check" Size=@(11) Color="#4ade80" />
							<span>RESOLVED</span>
						</div>
					}
				</div>
				<div class="entry-meta">
					<iconify icon="lucide:user" Size=@(11) Color="rgba(255, 255, 255, 0.4)" />
					<span class="entry-author">@entry.AuthorName</span>
					<span class="entry-meta-dot">·</span>
					<iconify icon="lucide:clock-3" Size=@(11) Color="rgba(255, 255, 255, 0.4)" />
					<span class="entry-date">@FormatDate(entry.CreatedAt)</span>
				</div>

				@if (isExpanded)
				{
					<div class="entry-content">
						<div class="entry-body-text">@entry.Body</div>

						@if (isResolved && !string.IsNullOrEmpty(entry.ResolvedNote))
						{
							<div class="resolved-note">
								<div class="resolved-note-head">
									<div class="dev-badge">
										<iconify icon="lucide:wrench" Size=@(11) Color="#4ade80" />
										<span>DEV REPLY</span>
									</div>
								</div>
								<span class="resolved-note-text">@entry.ResolvedNote</span>
							</div>
						}

						@if (IsDev())
						{
							<div class="admin-row" onclick=@((e) => e.StopPropagation())>
								<div class="admin-row-label">
									<iconify icon="lucide:shield" Size=@(11) Color="rgba(252, 165, 165, 0.7)" />
									<span>ADMIN</span>
								</div>
								<div class="admin-row-actions">
									@if (!isResolved)
									{
										<button class="admin-btn resolve"
												onclick=@(() => BeginResolve(entry.Id))
												onmouseover=@(() => OnHover("admin-resolve-" + entry.Id))>
											<iconify icon="lucide:check" Size=@(12) Color="#4ade80" />
											<span>Resolve</span>
										</button>
									}
									else
									{
										<button class="admin-btn"
												onclick=@(() => ReopenEntry(entry.Id))
												onmouseover=@(() => OnHover("admin-reopen-" + entry.Id))>
											<iconify icon="lucide:rotate-ccw" Size=@(12) Color="rgba(255, 255, 255, 0.8)" />
											<span>Reopen</span>
										</button>
									}
									<button class="admin-btn delete"
											onclick=@(() => DeleteEntry(entry.Id))
											onmouseover=@(() => OnHover("admin-del-" + entry.Id))>
										<iconify icon="lucide:trash-2" Size=@(12) Color="#fca5a5" />
										<span>Delete</span>
									</button>
								</div>
							</div>

							@if (resolvingId == entry.Id)
							{
								<div class="resolve-form" onclick=@((e) => e.StopPropagation())>
									<span class="field-label">DEV REPLY <span class="field-hint">— what changed, which version</span></span>
									<TextEntry class="composer-input"
											   @ref="resolveNoteInput"
											   Text=@resolveNoteDraft
											   Placeholder="Fixed in v0.8.1 — reduced fusion popup latency to 200ms" />
									<div class="resolve-actions">
										<button class="cancel-btn"
												onclick=@CancelResolve
												onmouseover=@(() => OnHover("resolve-cancel-" + entry.Id))>
											<span>CANCEL</span>
										</button>
										<button class="submit-btn"
												onclick=@(() => ConfirmResolve(entry.Id))
												onmouseover=@(() => OnHover("resolve-confirm-" + entry.Id))>
											<iconify icon="lucide:check-circle" Size=@(13) Color="#ffffff" />
											<span>MARK RESOLVED</span>
										</button>
									</div>
								</div>
							}
						}
					</div>
				}
			</div>

			@* Right chevron — rotates 180 when expanded *@
			<div class="entry-chevron-col">
				<iconify class="entry-chevron @(isExpanded ? "expanded" : "")"
						 icon="lucide:chevron-down"
						 Size=@(15)
						 Color="rgba(255, 255, 255, 0.4)" />
			</div>
		</div>
	};
}
