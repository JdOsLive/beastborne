		"ideas" => selectedTag != null ? "No ideas here yet" : "Be the first idea-haver",
		"resolved" => "Nothing resolved yet",
		"mine" => "You haven't posted yet",
		_ => "Nothing here"
	};

	private string GetEmptyBody() => currentTab switch
	{
