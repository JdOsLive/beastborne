	private List<MemberApiData> viewingGuildMembers = new();
	private bool isLoadingMembers = false;

	private async void ViewGuildDetail( GuildAdvertisement guild )
	{
		SoundManager.PlayForward();
		viewingGuild = guild;
		viewingGuildMembers = new();
		isLoadingMembers = true;

		try
		{
			var detail = await GuildApiClient.GetAsync<GuildDetailResponse>( $"guilds/{guild.GuildId}" );
			if ( detail?.Members != null )
			{
				viewingGuildMembers = detail.Members.OrderBy( m => m.Role ).ThenBy( m => m.Name ).ToList();
			}
		}
		catch ( Exception e )
		{
			Log.Warning( $"Failed to load guild members: {e.Message}" );
		}
		finally
		{
			isLoadingMembers = false;
		}
	}

	private List<GuildAdvertisement> apiGuilds = new();
	private bool isLoadingGuilds = false;

	// Browse search — filters visible guilds by name OR tag as you type.
	// Uses TextEntry + polling pattern (TextEntry doesn't expose onchange).
	private TextEntry browseSearchInput;
	private string browseSearchQuery = "";

	private List<GuildAdvertisement> GetVisibleGuilds()
	{
		// Combine RPC-discovered guilds (nearby) with API-fetched guilds (all)
		var rpcGuilds = GuildManager.Instance?.VisibleGuilds?.Values?.ToList() ?? new();
		var combined = new Dictionary<string, GuildAdvertisement>();

		// API guilds first (more complete data)
		foreach ( var g in apiGuilds )
			combined[g.GuildId] = g;

		// RPC guilds override (more up-to-date online counts)
		foreach ( var g in rpcGuilds )
			combined[g.GuildId] = g;

		var all = combined.Values.ToList();

		// Filter by search query (name OR tag, case-insensitive contains).
		if ( !string.IsNullOrWhiteSpace( browseSearchQuery ) )
		{
			var q = browseSearchQuery.Trim();
			all = all.Where( g =>
				(g.GuildName != null && g.GuildName.Contains( q, StringComparison.OrdinalIgnoreCase )) ||
				(g.GuildTag != null && g.GuildTag.Contains( q, StringComparison.OrdinalIgnoreCase ))
			).ToList();
		}

		return all;
	}

	private async void LoadGuildsFromApi()
	{
		if ( isLoadingGuilds ) return;
		isLoadingGuilds = true;

		var result = await (GuildManager.Instance?.BrowseGuildsFromApi() ?? Task.FromResult( new List<GuildAdvertisement>() ));
		apiGuilds = result;
		isLoadingGuilds = false;
	}

