	// ── LANDING zone math (audit closeout) — ONE source for the markup, the
	// kb walk and the hover handlers (stale-map law). Lane 1840 × 928.
	//   left slab   = 216, or 288 + 80n for n invites, capped at the lane (928)
	//   rec slab h  = 928 − 16 gap − leftH                    (696 … 216)
	//   rows fit    = floor((h − band 36 − list pad 28) / 100) clamped 0..6
	//                 (row 88 + gap 12 = 100 per row)
	//   slab up     = fit ≥ 2 (under two rows the invites take the lane alone)
	//   rows shown  = min(fit, recruiting count) while the slab is up
	private static int LandingLeftH( int n ) => n == 0 ? 216 : Math.Min( 928, 288 + 80 * n );
	private static int LandingRecH( int n ) => 928 - 16 - LandingLeftH( n );
	private static int LandingRecFit( int n ) => Math.Clamp( ( LandingRecH( n ) - 36 - 28 ) / 100, 0, 6 );
	private static bool LandingRecSlabUp( int n ) => LandingRecFit( n ) >= 2;
	private static int LandingRecCount( int n, int open ) => LandingRecSlabUp( n ) ? Math.Min( LandingRecFit( n ), open ) : 0;
