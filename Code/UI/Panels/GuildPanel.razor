	private string FormatGoalReset()
	{
		var ts = (GuildManager.Instance?.WeeklyGoalsResetAt ?? DateTime.UtcNow) - DateTime.UtcNow;
		if ( ts <= TimeSpan.Zero ) return "RESETS SOON";
		if ( ts.TotalDays >= 1 ) return $"RESETS MON · {(int)ts.TotalDays}D {ts.Hours}H";
		return $"RESETS MON · {ts.Hours}H {ts.Minutes}M";
	}

	// TOP CONTRIBUTOR — the week's highest guild XP; ties break to the
	// earliest join date (main-session ruling). Null when nobody scored.
	private static GuildMemberInfo GetTopContributor( List<GuildMemberInfo> members )
	{
		if ( members == null || members.Count == 0 ) return null;
		var top = members
			.Where( m => m.WeeklyGuildXP > 0 )
			.OrderByDescending( m => m.WeeklyGuildXP )
			.ThenBy( m => m.JoinedAt )
			.FirstOrDefault();
		return top;
	}

	// In-voice glyph — guild voice ROOMS don't exist yet (VoiceChatManager
	// has zero guild references), so "in voice" = the member sits in ANY
	// voice room this lobby can see. When guild rooms land, tighten this to
	// the guild's own room.
	private static bool IsMemberInVoice( GuildMemberInfo m )
	{
		if ( m == null || m.SteamId <= 0 ) return false;
		var rooms = VoiceChatManager.Instance?.Rooms;
		if ( rooms == null ) return false;
		foreach ( var room in rooms )
		{
			if ( room?.Members == null ) continue;
			foreach ( var rm in room.Members )
				if ( rm != null && rm.SteamId == m.SteamId ) return true;
		}
		return false;
	}

	// ── Overlay scrollbar geometry (the Beastbook UpdateDossierScrollbar
	//    recipe, generalized for the roster + log lists). Track top/height
	//    are pinned in the scss (the bands are fixed); only thumb geometry
	//    and the .on arming class are written per tick. Ratio math: rect px
	//    and scroll px are commensurate, so viewH/contentH and offset/maxOff
	//    are unit-free — only the track length needs style-space px.
	private void UpdateOverlayScrollbar( Panel track, Panel thumb, Panel scroll, ref int trackHCache, ref int thumbHCache, ref int thumbTopCache )
	{
		if ( track == null || thumb == null || scroll == null ) return;

		float maxOff = scroll.ScrollSize.y;
		if ( maxOff < 2f ) { track.SetClass( "on", false ); return; }

		var sr = scroll.Box.Rect;
		if ( sr.Height < 1f ) return;

		float sc = ScaleFromScreen;
		if ( sc <= 0.01f || float.IsNaN( sc ) || float.IsInfinity( sc ) ) sc = 1f;

		int trackH = (int)(sr.Height * sc) - 4;
		if ( trackH < 30 ) return;
		float viewH = sr.Height;
		float contentH = viewH + maxOff;
		int thumbH = Math.Max( 24, (int)(trackH * (viewH / contentH)) );
		int thumbTop = (int)((trackH - thumbH) * (scroll.ScrollOffset.y / maxOff));

		if ( trackH != trackHCache ) { track.Style.Height = Length.Pixels( trackH ); trackHCache = trackH; }
		if ( thumbH != thumbHCache ) { thumb.Style.Height = Length.Pixels( thumbH ); thumbHCache = thumbH; }
		if ( thumbTop != thumbTopCache ) { thumb.Style.Top = Length.Pixels( thumbTop ); thumbTopCache = thumbTop; }
		track.SetClass( "on", true );
	}
