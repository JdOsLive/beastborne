	// ── Bar fills — px widths written from code (the GoalBarPx pattern:
	//    percent widths on absolute children paint full-width in s&box).
	//    Widths mirror the scss tracks: identity XP 440 · goal 480 ·
	//    roster weekly 260.
	private const int IdentXpBarW = 440;
	private const int WeekGoalBarW = 480;
	private const int RosterWeekBarW = 260;

	private int GuildXpBarPx()
		=> (int)Math.Round( IdentXpBarW * Math.Clamp( GetGuildXPPercent() / 100f, 0f, 1f ) );

	private static int WeekGoalBarPx( GuildWeeklyGoal g )
		=> (int)Math.Round( WeekGoalBarW * Math.Clamp( ( g?.PercentComplete ?? 0f ) / 100f, 0f, 1f ) );

	// Scaled to the WEEK'S MAX contributor — zero renders an empty track.
	private static int RosterWeekBarPx( int weeklyXp, int weekMax )
		=> weekMax <= 0 ? 0 : (int)Math.Round( RosterWeekBarW * Math.Clamp( weeklyXp / (float)weekMax, 0f, 1f ) );

