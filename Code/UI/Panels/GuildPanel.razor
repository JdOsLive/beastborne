	// "asked 2h ago" — the pending row's waiting time (FormatLastSeen family).
	private static string FormatAskedAgo( DateTime requestedAt )
	{
		var diff = DateTime.UtcNow - requestedAt;
		if ( diff.TotalMinutes < 2 ) return "just now";
		if ( diff.TotalMinutes < 60 ) return $"{(int)diff.TotalMinutes}m ago";
		if ( diff.TotalHours < 24 ) return $"{(int)diff.TotalHours}h ago";
		if ( diff.TotalDays < 2 ) return "yesterday";
		return $"{(int)diff.TotalDays}d ago";
	}

	// BEAST tile sources — the first 8, deduped, every one with a sprite:
	//   0. the SAVED pick (so the active tile is always on the row)
	//   1. your favourite, then your roster (MonsterManager.OwnedMonsters,
	//      in roster order)
	//   2. the members' favourites — online broadcast profiles first
	//      (ChatManager.PlayerProfiles by ConnectionId), then any TamerCard
	//      you hold for an offline member.
	// Saved value = "beast:<speciesId>" — the one canonical emblem key.
	private List<MonsterSpecies> GetEmblemBeastChoices()
	{
		var mm = MonsterManager.Instance;
		var result = new List<MonsterSpecies>();
		if ( mm == null ) return result;
		var seen = new HashSet<string>();
		void Add( string speciesId )
		{
			if ( string.IsNullOrEmpty( speciesId ) || result.Count >= 8 || !seen.Add( speciesId ) ) return;
			var s = mm.GetSpecies( speciesId );
			if ( s != null && !string.IsNullOrEmpty( s.IconPath ) ) result.Add( s );
		}

		if ( ( emblemIcon ?? "" ).StartsWith( "beast:" ) ) Add( emblemIcon.Substring( 6 ) );
		Add( TamerManager.Instance?.CurrentTamer?.FavoriteMonsterSpeciesId );
		foreach ( var m in mm.OwnedMonsters ?? new List<Monster>() )
			Add( m?.SpeciesId );

		var members = GuildManager.Instance?.Members;
		if ( members != null )
		{
			var profiles = ChatManager.Instance?.PlayerProfiles;
			var cards = TamerManager.Instance?.CurrentTamer?.CollectedCards;
			foreach ( var member in members )
			{
				if ( member == null ) continue;
				if ( !string.IsNullOrEmpty( member.ConnectionId ) && profiles != null
					&& profiles.TryGetValue( member.ConnectionId, out var profile ) )
					Add( profile?.FavoriteMonsterSpeciesId );
				Add( cards?.FirstOrDefault( c => c != null && c.SteamId == member.SteamId )?.FavoriteMonsterSpeciesId );
			}
		}
		return result;
	}

	// TEMP dev instrument (run 2 LAYOUT): jump the guild page into a state
	// for screenshots. `dev_guildview settings` → the sub-view ·
	// `dev_guildview pending` → seeds two FAKE join requests into the
	// client-side list (you must be an officer to see PENDING; ACCEPT/DENY
	// on a fake would hit the server — screenshots only) and scrolls the
	// roster to them · `dev_guildview off` → clears the fakes, back to the page.
	private static GuildPanel _devGuild;
	private static readonly List<GuildJoinRequest> _devFakeRequests = new();

	[ConCmd( "dev_guildview" )]
	public static void DevGuildView( string mode = "settings" )
	{
		var p = _devGuild;
		var gm = GuildManager.Instance;
		if ( p == null || gm == null ) { Log.Warning( "[dev_guildview] Guild page not mounted." ); return; }
		switch ( mode )
		{
			case "settings":
				p.guildView = "myguild";
				p.showSettingsView = true;
				p._kbIndex = 0;
				break;
			case "pending":
				p.guildView = "myguild";
				p.showSettingsView = false;
				if ( _devFakeRequests.Count == 0 && gm.JoinRequests != null )
				{
					var now = DateTime.UtcNow;
					_devFakeRequests.Add( new GuildJoinRequest { SteamId = 0, PlayerName = "Thistledown", Level = 12, RequestedAt = now.AddHours( -2 ) } );
					_devFakeRequests.Add( new GuildJoinRequest { SteamId = 0, PlayerName = "Kestrel_9", Level = 31, RequestedAt = now.AddDays( -1 ) } );
					gm.JoinRequests.AddRange( _devFakeRequests );
				}
				if ( !gm.IsOfficer ) Log.Warning( "[dev_guildview] PENDING renders for officers only — you are not one in this guild." );
				p.ScrollRosterToPending();
				break;
			case "off":
				p.showSettingsView = false;
				foreach ( var f in _devFakeRequests ) gm.JoinRequests?.Remove( f );
				_devFakeRequests.Clear();
				break;
			default:
				Log.Info( "[dev_guildview] modes: settings | pending | off" );
				return;
		}
		p.StateHasChanged();
		Log.Info( $"[dev_guildview] -> {mode}" );
	}

