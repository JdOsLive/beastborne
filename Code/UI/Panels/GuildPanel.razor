		// MOTD: Enter SAVES — submit is the natural commit for a one-liner.
		WireTextEntry( motdDraftInput, () => { SaveMotd(); SoundManager.PlaySuccess(); StateHasChanged(); } );
		// Invite picker search: Enter/Esc hand the keyboard back to row 0.
		WireTextEntry( pickerSearchInput, () => BlurToRow( pickerSearchInput ) );
		// Browse search chip (run 3): Enter/Esc hand back to head stop 0.
		WireTextEntry( browseSearchInput, () => BlurToRow( browseSearchInput ) );
	}

	public override void Tick()
	{
		base.Tick();
		SpriteAnimator.Update();

		// Poll browse-search input — TextEntry has no onchange in s&box, so
		// we sync the backing field every tick when the browse view is open.
		if ( guildView == "browse" && browseSearchInput != null )
		{
			var t = browseSearchInput.Text ?? "";
			if ( t != browseSearchQuery )
			{
				browseSearchQuery = t;
			}
		}
		// LANE: input (run 3) — the search chip's typing state is READ off the
		// entry (TypingOwnsKeys grammar; no Tab-toggle flag any more). Drives
		// the .guild-kb-search-focused class only.
		_kbSearchFocused = guildView == "browse" && viewingGuild == null && browseSearchInput != null && browseSearchInput.HasFocus;

		// LANE: input (run 3, DOC-5 §12) — VIEW OPEN EDGES. The no-guild views
		// seed their cursor when they appear (by key OR click): landing →
		// BROWSE · browse → row 0 (or the row that opened the detail, coming
		// back) · detail → its first button · create → NAME · plaza → its first
		// zone, but ONLY arriving from a successful create (the plaza's own
		// open behaviour — first nav press lights the cursor — is untouched).
		{
			string viewKey = guildView == "browse" ? ( viewingGuild != null ? "browse-detail" : "browse" )
				: guildView == "myguild" ? ( InGuildLive() ? "plaza" : "create" )
				: "landing";
			if ( viewKey != _kbViewEdge )
			{
				SeedViewCursor( viewKey, _kbViewEdge );
				_kbViewEdge = viewKey;
				// The landing's RECRUITING NOW slab reads the same list as browse
				// — fetch on ITS open edge too (guarded by isLoadingGuilds; the
				// list re-cascades when the fetch lands, the browse recipe).
				if ( viewKey == "landing" ) LoadGuildsFromApi();
			}
		}

		// Poll the invite picker's search entry (no onchange). A changed
		// filter parks the cursor back on the search row — the typist is
		// there anyway, and the row count under it just changed.
		if ( showPicker && pickerMode == "invite" && pickerSearchInput != null )
		{
			var t = pickerSearchInput.Text ?? "";
			if ( t != pickerSearch )
			{
				pickerSearch = t;
				_kbIndex = 0;
			}
		}

		// Poll the settings sub-view's description editor while open — keeps
		// the draft in sync so SaveSettingsAndClose() picks up the latest text
		// (no onchange). 200-char cap enforced here too (the "N / 200" counter).
		if ( showSettingsView && settingsDescInput != null )
		{
			var t = settingsDescInput.Text ?? "";
			if ( t.Length > 200 ) { t = t.Substring( 0, 200 ); settingsDescInput.Text = t; }
			if ( t != settingsDescription )
			{
				settingsDescription = t;
			}
		}

		// Poll the CREATE form's description entry (no onchange) — the draft
		// rides into ApplyCreatePicks when the guild lands. 200-char cap.
		if ( guildView == "myguild" && !InGuildLive() && createDescInput != null )
		{
			var t = createDescInput.Text ?? "";
			if ( t.Length > 200 ) { t = t.Substring( 0, 200 ); createDescInput.Text = t; }
			if ( t != createDescription ) createDescription = t;
		}

		// Overlay scrollbars — imperative geometry (no BuildHash pollution).
		if ( guildView == "myguild" && (GuildManager.Instance?.IsInGuild ?? false) )
		{
			UpdateOverlayScrollbar( rosterSbTrackRef, rosterSbThumbRef, rosterScrollRef, ref _rsbTrackH, ref _rsbThumbH, ref _rsbThumbTop );
			UpdateOverlayScrollbar( logSbTrackRef, logSbThumbRef, logScrollRef, ref _lsbTrackH, ref _lsbThumbH, ref _lsbThumbTop );

			// LANE: input — THE LOG's cursor class is stamped imperatively
			// (SetClass, the overlay-scrollbar precedent): a volatile markup
			// class would remount the row and replay its gpLogRowN entrance
			// ladder on every cursor hop (DOC-4 §14 / motion's comment).
			SyncLogCursorClasses();

			// LANE: motion — GuildLevel edge → the LV stamp's Tier-3 gold
			// snap. First sighting only records (no pop on page open).
			var gpLvNow = GuildManager.Instance?.Guild?.Level ?? 0;
			if ( gpLvNow > 0 )
			{
				if ( _lastSeenGuildLevel > 0 && gpLvNow > _lastSeenGuildLevel )
					_lvPopUntil = RealTime.Now + 0.6f;
				_lastSeenGuildLevel = gpLvNow;
			}

			// LANE: motion (run 2) — pending-row marks, the joined watch, the
			// log ripple expiry, the ladder re-arm edge.
			TickMotionBeats();
		}

		// LANE: motion (run 3) — view exit latch expiry, row-ladder arms, invite
		// fold pruning, the guild-lands edges (landing / create → plaza).
		TickNoGuildMotion();

		// LANE: motion — settings EXIT latch expiry → the real unmount.
		if ( showSettingsView && _settingsClosingUntil > 0f && RealTime.Now >= _settingsClosingUntil )
		{
			_settingsClosingUntil = -1f;
			showSettingsView = false;
			StateHasChanged();
		}

		// Settings drawer open edge — reset the keyboard row cursor to the
		// first row so it doesn't carry a stale index (e.g. the Settings tile's
		// index 2) in from whatever zone opened it.
		if ( showSettingsView && !_settingsWasOpen )
			_kbIndex = 0;
		// Drawer CLOSE edge — the description entry must never keep typing
		// focus behind a closed drawer (DOC-5 §18: clear on every exit path).
		if ( !showSettingsView && _settingsWasOpen )
			settingsDescInput?.Blur();
		_settingsWasOpen = showSettingsView;

		// S1 — overlay open edges seed each overlay's cursor on its safe stop
		// (mouse opens too; the Open* helpers already seeded — idempotent).
		if ( showMemberMenu && !_memberMenuWasOpen ) SeedMemberMenuCursor();
		_memberMenuWasOpen = showMemberMenu;
		if ( showPicker && !_pickerWasOpen ) { _kbIndex = 0; pickerSearch = ""; }
		// Picker CLOSE edge — the search entry must never keep typing focus
		// behind a closed modal (DOC-5 §18; the drawer's description recipe).
		if ( !showPicker && _pickerWasOpen ) pickerSearchInput?.Blur();
		_pickerWasOpen = showPicker;

		// LANE: input (B-1) — the PENDING zone is volatile (rows fold, the
		// server removes them, another officer may act first): keep the
		// cursor on a standing row or slide it into the roster when the zone
		// empties. Cheap no-op unless the cursor is in the zone.
		PlazaValidatePendingCursor();

		// Deferred TextEntry focus (S3/S5) — one frame after the confirm key.
		if ( _focusEntryPending != null )
		{
			_focusEntryFrames--;
			if ( _focusEntryFrames <= 0 )
			{
				_focusEntryPending.Focus();
				_focusEntryPending = null;
			}
		}

		// S4 — MOTD editor focus latch: wait for the entry to MOUNT (ref
		// non-null), then two frames, then Focus() (the phone chat-box latch).
		if ( _motdFocusLatch > 0 && editingMotd && motdDraftInput != null )
		{
			_motdFocusLatch--;
			if ( _motdFocusLatch == 0 ) motdDraftInput.Focus();
		}

		// Perk-ladder open edge — same rule (opens by mouse OR Space on the
		// next-unlock chip; the row cursor must not carry a stale index).
		if ( showPerkLadder && !_ladderWasOpen )
			_ladderKbIndex = 0;
		_ladderWasOpen = showPerkLadder;
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add( SpriteAnimator.GlobalFrame );
		hash.Add( guildView );
		hash.Add( showRaidTeamSelect );
		hash.Add( showRaidBattle );
		hash.Add( showRaidResults );
		hash.Add( showPicker );
		// Invite picker — search text, the live row count (the directory
		// lands async; lobby/cards churn), the "Loading players…" flag and
		// the PENDING flips (SentInviteSteamIds grows when the API confirms).
		hash.Add( pickerSearch );
		if ( showPicker && pickerMode == "invite" )
		{
			hash.Add( GetPickerCandidates().Count );
			hash.Add( CompetitiveManager.Instance?.PlayerDirectoryLoading ?? false );
			hash.Add( GuildManager.Instance?.SentInviteSteamIds?.Count ?? 0 );
		}
		hash.Add( showSettingsView );
		hash.Add( showMemberMenu );
		hash.Add( raidViewOpen );
		// ── Settings sub-view form state (run 2) — every rendered fact: the
		//    preview + active chips/tiles, the "N / 200" counter, and the
		//    SAVE ↔ NO CHANGES swap. Role/claim gate the danger rows.
		hash.Add( emblemColor );
		hash.Add( emblemIcon );
		hash.Add( (int)settingsJoinMode );
		hash.Add( settingsMinLevel );
		hash.Add( settingsDescription );
		hash.Add( (int)(GuildManager.Instance?.Membership?.Role ?? 0) );
		hash.Add( GuildManager.Instance?.CanClaimLeadership() ?? false );
		hash.Add( showPerkLadder );
		hash.Add( browseSearchQuery );
		// ── No-guild views (run 3) — every rendered fact: sort, loading, the
		//    open detail, the create draft, the dev override, the toast, the
		//    invite count, the gates (level / gold / cooldown), the row count.
		hash.Add( browseSort );
		hash.Add( isLoadingGuilds );
		hash.Add( viewingGuild?.GuildId );
		hash.Add( isLoadingMembers );
		hash.Add( viewingGuildMembers.Count );
		hash.Add( createDescription );
		hash.Add( _devNoGuild );
		hash.Add( _devNoRecruits ); // landing0 dev flag (the rec list reads it)
		hash.Add( errorMessage );
		hash.Add( GuildManager.Instance?.PendingInvites?.Count ?? 0 );
		hash.Add( GuildManager.Instance?.IsOnHopCooldown() ?? false );
		hash.Add( TamerManager.Instance?.CurrentTamer?.Gold ?? 0 );
		hash.Add( GetTamerLevel() );
		if ( guildView == "browse" || guildView == "landing" ) hash.Add( GetVisibleGuilds().Count );
		hash.Add( editingMotd );
		// ── Keyboard nav state — every field that drives a kb-selected cursor
		//    must be in the hash or the panel won't re-render on key presses.
		hash.Add( _kbActive );
		hash.Add( _kbZone );
		hash.Add( _kbIndex );
		hash.Add( _kbPendBtn );     // PENDING row ACCEPT/DENY sub-cursor (BbButton Focused)
		hash.Add( _kbLandBtn );     // landing invite row ACCEPT/DECLINE sub-cursor
		hash.Add( _kbBrowseBtn );   // browse row ⇄ JOIN sub-cursor
		hash.Add( _kbSearchFocused );
		hash.Add( _gpKbdMode );     // .kbd-mode/.mouse-mode root class
		hash.Add( _ladderKbIndex ); // perk-ladder row cursor
		// (run-2 input fields — _gpKbTakeoverPos, the *WasOpen edges,
		//  _pickerReturnsToDrawer, the focus latches — drive NO markup and
		//  are deliberately unhashed: hashing the parked-mouse stamp would
		//  re-render the tree on every keypress, the very re-dispatch B1 kills.)
		// ── Motion render-keys — the windowed pop classes must attach AND
		//    drop on time (the booleans flip when the windows expire).
		hash.Add( _claimPopGoalId );
		hash.Add( RealTime.Now < _claimPopUntil );
		hash.Add( RealTime.Now < _lvPopUntil );
		// run 2 motion keys — exit latch class, leaving rows, joined window,
		// ladder arm window + live ripple count, freeze root class.
		hash.Add( SettingsClosing );
		hash.Add( _prowLeaving.Count );
		foreach ( var lk in _prowLeaving.Keys ) hash.Add( lk );
		hash.Add( _joinedPopSteamId );
		hash.Add( RealTime.Now < _joinedPopUntil );
		hash.Add( RealTime.Now < _logLadderUntil );
		hash.Add( ActiveLogNewCount() );
		hash.Add( _gpFxFreeze );
		// run 3 motion keys (LANE: motion) — view exit latch (class attach/drop),
		// row ladder window, invite rows leaving, sort pop, sent flash, the
		// no-guild branch flags (the create @if reads _createUp).
		hash.Add( ViewLeaving );
		hash.Add( _viewExitClass );
		hash.Add( RealTime.Now < _rowLadderUntil );
		hash.Add( _irowLeaving.Count );
		foreach ( var ik in _irowLeaving.Keys ) hash.Add( ik );
		hash.Add( RealTime.Now < _sortPopUntil );
		hash.Add( _sentPopGuildId );
		hash.Add( RealTime.Now < _sentPopUntil );
		hash.Add( _createUp );
		hash.Add( _landingUp );
		// ── Emblem resolve inputs (BbEmblem.ResolveBeast) — icon/color/owner
		//    plus everything the leader-favorite default chain reads: your own
		//    favorite, the member list (owner ConnectionId), and the online
		//    profile set (broadcast favorites).
		var gmH = GuildManager.Instance;
		hash.Add( gmH?.Guild?.EmblemIcon );
		hash.Add( gmH?.Guild?.EmblemColor );
		hash.Add( gmH?.Guild?.OwnerSteamId ?? 0 );
		hash.Add( gmH?.Members?.Count ?? 0 );
		hash.Add( TamerManager.Instance?.CurrentTamer?.FavoriteMonsterSpeciesId );
		hash.Add( ChatManager.Instance?.PlayerProfiles?.Count ?? 0 );
		// ── Guild page zones (rebuild 2026-08-31) — every rendered fact:
		//    identity (level/XP/MOTD), roster rows (presence, weekly XP,
		//    last-seen day bucket, voice), THE WEEK (progress/claimed),
		//    THE LOG (count + newest stamp), header chips (request count).
		hash.Add( gmH?.Guild?.Level ?? 0 );
		hash.Add( gmH?.Guild?.GuildXP ?? 0 );
		hash.Add( gmH?.Guild?.Motd );
		hash.Add( gmH?.IsOfficer == true ? (gmH.JoinRequests?.Count ?? 0) : 0 );
		foreach ( var mh in gmH?.Members ?? new List<GuildMemberInfo>() )
		{
			hash.Add( mh.IsOnline );
			hash.Add( mh.WeeklyGuildXP );
			hash.Add( (int)(DateTime.UtcNow - mh.LastSeen).TotalHours );
			hash.Add( IsMemberInVoice( mh ) );
		}
		foreach ( var gh in gmH?.WeeklyGoals ?? new List<GuildWeeklyGoal>() )
			hash.Add( gh.Progress + (gh.Claimed ? 1_000_000 : 0) );
		hash.Add( gmH?.ActivityLog?.Count ?? 0 );
		hash.Add( gmH?.ActivityLog?.Count > 0 ? gmH.ActivityLog[0].Timestamp : default );
		hash.Add( _logVisibleRows ); // grouped-log row count (run 3 — folded SYSTEM runs)
		return hash.ToHashCode();
	}

	// ════════════════════════════════════════════════════════════════════════
	// KEYBOARD NAVIGATION
	// Dispatched from OnlineHubPanel.TickInput() while the Guild section is up.
	// Per-view scheme:
	//   landing — LEFT column BROWSE → invite rows (A/D = ACCEPT ⇄ DECLINE),
	//             RIGHT column CREATE (D from the left); Space activates;
	//             Q → hub (claimed). Seeded on BROWSE at open.
	//   browse  — head (search · MEMBERS · LEVEL; A/D) above the rows (W/S,
	//             A/D = row ⇄ JOIN); Space = detail / join; R = sort toggle;
	//             Q → landing/plaza (claimed). Detail: A/D+W/S JOIN ⇄ BACK.
	//   myguild (plaza) — Tab cycles zones (tiles → roster → perks → danger);
	//             arrows nav within a zone; Space activates; Q backs to landing
	//             or exits the section if already at the plaza root.
	//   myguild (raid) — Up/Down through the raid scene actions; Q closes raid.
	//   create  — W/S through name/tag/colour/beast/description/join/level/FOUND; A/D cycle chips.
	// Blocking sub-states (member menu, settings drawer, requests / picker /
	// raid-team-select / raid-results modals, MOTD / description editors) OWN
	// the keyboard: their handler runs first and returns.
	// ════════════════════════════════════════════════════════════════════════
	public void TickInput()
	{
		// ---- Blocking sub-states first — they own the keyboard entirely. ----
		if ( showRaidBattle ) return;            // BattleView handles its own input

		if ( showRaidResults )
		{
			if ( UiInput.ConfirmPressed() || Input.Pressed( "Menu" ) )
			{
				showRaidResults = false;
				if ( Input.Pressed( "Menu" ) ) GameHUD.PanelHandledBackKey = true;
				StateHasChanged();
			}
			return;
		}

		if ( showPerkLadder ) { TickPerkLadderInput(); return; }
		if ( showPicker ) { TickPickerInput(); return; }
		if ( showMemberMenu && selectedMember != null ) { TickMemberMenuInput(); return; }
		if ( showSettingsView ) { TickSettingsDrawerInput(); return; }
		if ( editingMotd ) { TickEditorInput(); return; }

		// LANE: motion (run 3) — a view is fading out under the exit latch;
		// nothing takes input mid-exit. Q stays OURS (the settings S-H rule): a
		// fast double-tap must not fall through to the hub. Claim it, act on nothing.
		if ( ViewLeaving )
		{
			if ( Input.Pressed( "Menu" ) ) GameHUD.PanelHandledBackKey = true;
			return;
		}

		// ---- View dispatch ----
		switch ( guildView )
		{
			case "landing": TickLandingInput(); break;
			case "browse":  TickBrowseInput(); break;
			case "myguild": TickMyGuildInput(); break;
		}
	}

	// Light the cursor on the first nav keypress without moving — mirrors the
	// SkillTree / Roster pattern. Returns true if it just engaged this frame.
	private bool EngageKb( string zone )
	{
		if ( _kbActive && _kbZone == zone ) return false;
		_kbActive = true;
		_kbZone = zone;
		_kbIndex = 0;
		SoundManager.PlayHover();
		StateHasChanged();
		return true;
	}

	private bool NavPressed() =>
		Input.Pressed( "Up" ) || Input.Pressed( "Down" ) ||
		Input.Pressed( "Left" ) || Input.Pressed( "Right" );

	private void MoveKb( int count, int delta )
	{
		if ( count <= 0 ) return;
		_kbIndex = Math.Clamp( _kbIndex + delta, 0, count - 1 );
		SoundManager.PlayHover();
		StateHasChanged();
	}

	// ── LANDING (run 3 + audit closeout, LANE: input) ───────────────────────
	// The cursor graph is the screen (DOC-5 §21). Two slabs side by side,
	// a third full-width under them:
	//   LEFT  column — BROWSE (0) · invite ROWS (1..n; the row is the stop,
	//                  _kbLandBtn = ACCEPT 0 / DECLINE 1)      W/S walk it
	//   RIGHT column — CREATE (n+1), the slab's only stop, at BROWSE's height
	//   RECRUITING   — rows n+2 .. n+1+m (m = LandingRecCount: the rows that
	//                  FIT under the pair; 0 when the slab is dropped or the
	//                  list is empty). _kbLandBtn = the row 0 / JOIN 1.
	// A/D: BROWSE → D → CREATE · CREATE → A → BROWSE (same height, honest) ·
	// on an invite row A/D step ACCEPT ⇄ DECLINE and D past DECLINE hops to
	// CREATE (the plaza's column-hop grammar: one stop on the right, so it
	// takes it). On a rec row A/D = row ⇄ JOIN; D past JOIN CLAMPS (CREATE
	// sits above it — a hop there would contradict the screen).
	// W/S: the LEFT column flows INTO the rec rows (S past the last left
	// stop → rec row 0; W off rec row 0 → the last left stop) — one cursor,
	// top to bottom (DOC-5 §11); an empty rec zone is skipped (= the old
	// clamp). CREATE: W/S silent (nothing above; the rec slab is entered
	// from the left column — one edge). Space: BROWSE / CREATE / ACCEPT /
	// DECLINE as before · rec row → browse with that guild's detail open ·
	// rec JOIN → RequestJoinRow (gated → deny). The markup shares this map
	// (stale-map law). Q → hub (OnBack), claimed so it never reaches the
	// SYSTEM menu.
	private void TickLandingInput()
	{
		var gm = GuildManager.Instance;
		var invites = gm?.PendingInvites ?? new List<GuildInvite>();
		int n = invites.Count;
		int createIdx = n + 1;
		var recGuilds = LandingRecGuilds();
		int m = LandingRecCount( n, recGuilds.Count );
		int recFirst = createIdx + 1;          // n + 2
		int last = m > 0 ? recFirst + m - 1 : createIdx; // the graph's last index
		int lastLeft = n;                      // BROWSE (0) or the last invite row

		// Q — leave the guild page for the hub (the landing IS the page root
		// when you have no guild). Claimed: an unclaimed Q here would reach
		// GameHUD and open the SYSTEM menu on top of the hub's own back.
		if ( Input.Pressed( "Menu" ) )
		{
			OnBackClicked();
			GameHUD.PanelHandledBackKey = true;
			return;
		}

		if ( NavPressed() ) StampKb();

		// The invite list is volatile (ACCEPT/DECLINE land async, the server
		// prunes, a new invite arrives). Every index past the rows moves with
		// n, so a cursor on CREATE / a rec row shifts by the delta and stays
		// on the SAME control; a cursor on a row that vanished stays in the
		// ROWS (n == 0 → BROWSE) — never slides onto CREATE or into the rec
		// list because the arithmetic moved under it.
		if ( _landPrevN >= 0 && n != _landPrevN && _kbActive && _kbZone == "landing" )
		{
			if ( _kbIndex > _landPrevN ) _kbIndex += n - _landPrevN;          // CREATE / rec rows ride the shift
			else if ( _kbIndex >= 1 && n < _landPrevN ) { _kbIndex = Math.Min( _kbIndex, n ); _kbLandBtn = 0; }
			StateHasChanged();
		}
		_landPrevN = n;

		if ( !_kbActive || _kbZone != "landing" )
		{
			if ( NavPressed() ) { SeedViewCursor( "landing", _kbViewEdge ); }
			return;
		}

		// The rec zone shrinks when an invite lands (fewer rows fit) or the
		// list refreshes shorter: a cursor past the end steps back to the last
		// rec row, or to the last left stop when the zone is gone.
		if ( _kbIndex > last ) { _kbIndex = m > 0 ? last : lastLeft; _kbLandBtn = 0; StateHasChanged(); }
		_kbIndex = Math.Clamp( _kbIndex, 0, last );
		bool onCreate = _kbIndex == createIdx;
		bool onRow = _kbIndex >= 1 && _kbIndex <= n;
		bool onRec = m > 0 && _kbIndex >= recFirst;
		int recI = onRec ? _kbIndex - recFirst : -1;
		bool recHasBtn = onRec && BrowseRowHasJoin( recGuilds[recI] );
		if ( !onRow && !onRec ) _kbLandBtn = 0;
		if ( onRec && !recHasBtn && _kbLandBtn != 0 ) { _kbLandBtn = 0; StateHasChanged(); }

		// W/S — the LEFT column (0..n) flows into the rec rows (n+2..); CREATE
		// has nothing above/below.
		if ( Input.Pressed( "Up" ) || Input.Pressed( "Down" ) )
		{
			if ( onCreate ) return;
			bool down = Input.Pressed( "Down" );
			int next;
			if ( onRec )
			{
				next = down ? Math.Min( _kbIndex + 1, last ) : ( recI == 0 ? lastLeft : _kbIndex - 1 );
			}
			else
			{
				next = down
					? ( _kbIndex < n ? _kbIndex + 1 : ( m > 0 ? recFirst : _kbIndex ) ) // past the last left stop → rec row 0 (or clamp)
					: Math.Max( 0, _kbIndex - 1 );
			}
			if ( next == _kbIndex ) return; // top/bottom of the walk — silent
			_kbIndex = next;
			_kbLandBtn = 0; // entering a row lands on its verb / the row itself
			if ( _kbIndex >= 1 && _kbIndex <= n ) UiGridScroll.ScrollIndexIntoView( landingInvRef, _kbIndex - 1, "gl-irow" );
			else if ( landingInvRef != null && _kbIndex == 0 ) landingInvRef.ScrollOffset = new Vector2( landingInvRef.ScrollOffset.x, 0f );
			else if ( landingInvRef != null && _kbIndex >= recFirst ) landingInvRef.ScrollOffset = new Vector2( landingInvRef.ScrollOffset.x, landingInvRef.ScrollSize.y ); // leaving downward → the invite list rests at its bottom (endpoint semantics)
			SoundManager.PlayHover();
			StateHasChanged();
			return;
		}

		// A/D — the column hop + the ACCEPT ⇄ DECLINE pair + the rec row ⇄ JOIN pair.
		if ( Input.Pressed( "Left" ) )
		{
			if ( onCreate ) { _kbIndex = 0; _kbLandBtn = 0; SoundManager.PlayHover(); StateHasChanged(); }
			else if ( ( onRow || onRec ) && _kbLandBtn == 1 ) { _kbLandBtn = 0; SoundManager.PlayHover(); StateHasChanged(); }
			return; // BROWSE / ACCEPT / a rec row — nothing to the left
		}
		if ( Input.Pressed( "Right" ) )
		{
			if ( onCreate ) return; // nothing to the right
			if ( onRec )
			{
				// row → JOIN; JOIN → clamp (CREATE is ABOVE this slab, not beside it).
				if ( recHasBtn && _kbLandBtn == 0 ) { _kbLandBtn = 1; SoundManager.PlayHover(); StateHasChanged(); }
				return;
			}
			if ( onRow && _kbLandBtn == 0 ) { _kbLandBtn = 1; SoundManager.PlayHover(); StateHasChanged(); return; }
			_kbIndex = createIdx; // BROWSE → CREATE · DECLINE → CREATE (column hop)
			_kbLandBtn = 0;
			SoundManager.PlayHover();
			StateHasChanged();
			return;
		}

		if ( UiInput.ConfirmPressed() )
		{
			if ( _kbIndex == 0 ) { OnBrowsePressed(); return; }
			if ( onCreate ) { OnCreatePressed(); return; } // gated → deny blip inside
			if ( onRec )
			{
				var rg = recGuilds[recI];
				if ( _kbLandBtn == 1 && recHasBtn )
				{
					if ( BrowseJoinGated() ) { SoundManager.PlayDeny(); return; }
					RequestJoinRow( rg );
					return;
				}
				OpenRecruitRow( rg ); // → browse, that guild's detail open
				return;
			}
			var invite = invites[_kbIndex - 1];
			if ( _kbLandBtn == 0 )
			{
				// ACCEPT is Disabled while the join gate fails (level / hop
				// cooldown) — the same check the markup dims it with.
				bool canJoin = GetTamerLevel() >= GuildManager.MIN_LEVEL_TO_JOIN && !( gm?.IsOnHopCooldown() ?? false );
				if ( !canJoin ) { SoundManager.PlayDeny(); return; }
				AcceptInviteWithFold( invite ); // LANE: motion — fold + sound, the same path as the click
			}
			else
			{
				DeclineInviteWithCollapse( invite ); // LANE: motion — collapse + sound, the same path as the click
			}
			StateHasChanged();
		}
	}

	// ── BROWSE (run 3, LANE: input) ─────────────────────────────────────────
	// Two zones, one cursor, geometry-honest (DOC-5 §21):
	//   "browse-head" — search chip 0 · MEMBERS 1 · LEVEL 2 (the header's
	//                   right slot). A/D across; S → the list; W silent.
	//                   Space: 0 focuses the TextEntry (TypingOwnsKeys
	//                   grammar — Tab/Enter/Esc hand back, cursor stays on
	//                   the chip; Q types a 'q'); 1/2 apply that sort.
	//   "browse-grid" — the rows (or the ONE REFRESH stop when the list is
	//                   empty). W/S walk rows with scroll-follow; W off row
	//                   0 → the head stop last used; A/D = row ⇄ its
	//                   JOIN/REQUEST (_kbBrowseBtn; rows without a button
	//                   hold 0). Space: row → the detail · button → join.
	// R toggles the sort pair from anywhere (the cap sits by LEVEL).
	// Q → landing (or the plaza when in a guild) — claimed.
	private void TickBrowseInput()
	{
		// Guild-detail sub-view owns the keyboard while a guild is selected.
		if ( viewingGuild != null )
		{
			if ( Input.Pressed( "Menu" ) )
			{
				OnDetailBackPressed();
				GameHUD.PanelHandledBackKey = true;
				return;
			}
			TickBrowseDetailInput();
			return;
		}

		// Typing owns the keyboard while the search entry has focus (Q types
		// a 'q'; Tab here / Enter+Esc via the entry's events hand it back).
		// A click-focus also drags the cursor onto head stop 0.
		if ( TypingOwnsKeys( browseSearchInput, 0, "browse-head" ) ) return;

		// Q — back to the plaza / landing (internal back, claim the key).
		if ( Input.Pressed( "Menu" ) )
		{
			OnBrowseBackPressed();
			GameHUD.PanelHandledBackKey = true;
			return;
		}

		if ( NavPressed() ) StampKb();

		// R — the page's cycle key: toggle the sort pair (silent; the cap by
		// LEVEL advertises it). The cursor stays where it is.
		if ( Input.Pressed( "Reload" ) )
		{
			SetBrowseSort( browseSort == "members" ? "level" : "members" );
			return;
		}

		var guilds = GetVisibleGuilds();
		int rows = guilds.Count;
		int gridCount = Math.Max( 1, rows ); // 0 rows → the REFRESH stop

		bool inHead = _kbActive && _kbZone == "browse-head";
		bool inGrid = _kbActive && _kbZone == "browse-grid";
		if ( !inHead && !inGrid )
		{
			if ( NavPressed() ) SeedViewCursor( "browse", _kbViewEdge );
			return;
		}

		if ( inHead )
		{
			_kbIndex = Math.Clamp( _kbIndex, 0, 2 );
			_kbBrowseHeadIdx = _kbIndex;
			if ( Input.Pressed( "Left" ) ) { if ( _kbIndex > 0 ) { _kbIndex--; _kbBrowseHeadIdx = _kbIndex; SoundManager.PlayHover(); StateHasChanged(); } return; }
			if ( Input.Pressed( "Right" ) ) { if ( _kbIndex < 2 ) { _kbIndex++; _kbBrowseHeadIdx = _kbIndex; SoundManager.PlayHover(); StateHasChanged(); } return; }
			if ( Input.Pressed( "Up" ) ) return; // nothing above the header
			if ( Input.Pressed( "Down" ) )
			{
				_kbZone = "browse-grid";
				_kbIndex = 0;
				_kbBrowseBtn = 0;
				if ( browseScrollRef != null ) browseScrollRef.ScrollOffset = new Vector2( browseScrollRef.ScrollOffset.x, 0f );
				SoundManager.PlayHover();
				StateHasChanged();
				return;
			}
			if ( UiInput.ConfirmPressed() )
			{
				switch ( _kbIndex )
				{
					case 0: RequestEntryFocus( browseSearchInput ); break;
					case 1: SetBrowseSort( "members" ); break;
					case 2: SetBrowseSort( "level" ); break;
				}
			}
			return;
		}

		// ── the grid ──
		_kbIndex = Math.Clamp( _kbIndex, 0, gridCount - 1 );
		bool hasBtn = rows > 0 && BrowseRowHasJoin( guilds[_kbIndex] );
		if ( !hasBtn && _kbBrowseBtn != 0 ) { _kbBrowseBtn = 0; StateHasChanged(); }

		if ( Input.Pressed( "Up" ) )
		{
			if ( _kbIndex == 0 )
			{
				// Off the top of the list → the header's right slot.
				_kbZone = "browse-head";
				_kbIndex = Math.Clamp( _kbBrowseHeadIdx, 0, 2 );
				_kbBrowseBtn = 0;
				if ( browseScrollRef != null ) browseScrollRef.ScrollOffset = new Vector2( browseScrollRef.ScrollOffset.x, 0f );
				SoundManager.PlayHover();
				StateHasChanged();
				return;
			}
			_kbIndex--;
			_kbBrowseBtn = 0;
			UiGridScroll.ScrollIndexIntoView( browseScrollRef, _kbIndex, "gb-row" );
			SoundManager.PlayHover();
			StateHasChanged();
			return;
		}
		if ( Input.Pressed( "Down" ) )
		{
			if ( _kbIndex >= gridCount - 1 ) return; // bottom — silent
			_kbIndex++;
			_kbBrowseBtn = 0;
			UiGridScroll.ScrollIndexIntoView( browseScrollRef, _kbIndex, "gb-row" );
			SoundManager.PlayHover();
			StateHasChanged();
			return;
		}
		if ( Input.Pressed( "Left" ) )
		{
			if ( _kbBrowseBtn == 1 ) { _kbBrowseBtn = 0; SoundManager.PlayHover(); StateHasChanged(); }
			return;
		}
		if ( Input.Pressed( "Right" ) )
		{
			if ( hasBtn && _kbBrowseBtn == 0 ) { _kbBrowseBtn = 1; SoundManager.PlayHover(); StateHasChanged(); }
			return;
		}

		if ( UiInput.ConfirmPressed() )
		{
			if ( rows == 0 )
			{
				if ( isLoadingGuilds ) { SoundManager.PlayDeny(); return; }
				OnRefreshGuildsPressed();
				return;
			}
			var g = guilds[_kbIndex];
			if ( _kbBrowseBtn == 1 && hasBtn )
			{
				// JOIN is Disabled under the same gate the markup dims it with.
				if ( BrowseJoinGated() ) { SoundManager.PlayDeny(); return; }
				RequestJoinRow( g );
				return;
			}
			_browseReturnIdx = _kbIndex;
			OpenGuildDetail( g ); // LANE: motion — the sub latch; ResetKb runs in its commit, then the Tick view edge seeds "browse-detail"
		}
	}

	// Detail: [JOIN/REQUEST] · BACK TO LIST — a two-stop ROW (.gb-dactions is
	// a flex row), so A/D step it; W/S are a SILENT clamp (a horizontal pair
	// has nothing above or below — audit closeout, DOC-5 §21).
	// Q is handled by the caller (→ list, claimed).
	private void TickBrowseDetailInput()
	{
		if ( NavPressed() ) StampKb();

		var inGuild = InGuildLive();
		bool locked = viewingGuild.JoinMode == GuildJoinMode.Closed || viewingGuild.JoinMode == GuildJoinMode.InviteOnly;
		bool canJoin = !inGuild && !locked;
		int count = canJoin ? 2 : 1; // [join], back  — or just back

		if ( !_kbActive || _kbZone != "browse-detail" )
		{
			if ( NavPressed() ) SeedViewCursor( "browse-detail", _kbViewEdge );
			return;
		}

		_kbIndex = Math.Clamp( _kbIndex, 0, count - 1 );
		if ( Input.Pressed( "Up" ) || Input.Pressed( "Down" ) ) return; // silent — the pair is horizontal
		if ( Input.Pressed( "Left" ) ) { if ( _kbIndex > 0 ) MoveKb( count, -1 ); return; }
		if ( Input.Pressed( "Right" ) ) { if ( _kbIndex < count - 1 ) MoveKb( count, 1 ); return; }

		if ( UiInput.ConfirmPressed() )
		{
			if ( canJoin && _kbIndex == 0 )
			{
				if ( BrowseJoinGated() ) { SoundManager.PlayDeny(); return; }
				OnDetailJoinPressed();
			}
			else OnDetailBackPressed();
		}
	}

	// ── No-guild view helpers (LANE: input, run 3) ──────────────────────────
	// The row shows a JOIN/REQUEST button (not in a guild; Open / Request).
	private bool BrowseRowHasJoin( GuildAdvertisement g )
		=> g != null && !InGuildLive() && g.JoinMode != GuildJoinMode.Closed && g.JoinMode != GuildJoinMode.InviteOnly;

	// The JOIN buttons' Disabled gate (markup gbGated): in a guild, under
	// level, or on the hop cooldown.
	private bool BrowseJoinGated()
		=> InGuildLive() || GetTamerLevel() < GuildManager.MIN_LEVEL_TO_JOIN || ( GuildManager.Instance?.IsOnHopCooldown() ?? false );

	// MEMBERS / LEVEL — one path for click, Space and R. Re-selecting the
	// active sort is a quiet no-op.
	private void SetBrowseSort( string sort )
	{
		if ( browseSort == sort ) return;
		browseSort = sort;
		_sortPopUntil = RealTime.Now + 0.4f; // LANE: motion — windowed gp-pop on the chip that just went active (0.4s > the 0.22s stamp pop)
		SoundManager.PlayClick();
		if ( _kbActive && _kbZone == "browse-grid" && browseScrollRef != null )
			UiGridScroll.ScrollIndexIntoView( browseScrollRef, _kbIndex, "gb-row" );
		StateHasChanged();
	}

	// View OPEN EDGE seeding (DOC-5 §12) — called from Tick when the view key
	// changes, and by the engage branches when a nav key arrives with no
	// cursor lit. `prev` is the view we came from.
	private void SeedViewCursor( string key, string prev )
	{
		switch ( key )
		{
			case "landing":
				// BROWSE (0) — the walk's first stop; the rec rows (n+2..) are
				// reached by S through the left column (TickLandingInput).
				_kbActive = true; _kbZone = "landing"; _kbIndex = 0; _kbLandBtn = 0;
				_landPrevN = GuildManager.Instance?.PendingInvites?.Count ?? 0;
				break;
			case "browse":
			{
				_kbActive = true; _kbZone = "browse-grid"; _kbBrowseBtn = 0;
				int rows = GetVisibleGuilds().Count;
				_kbIndex = prev == "browse-detail" ? Math.Clamp( _browseReturnIdx, 0, Math.Max( 0, rows - 1 ) ) : 0;
				if ( prev != "browse-detail" ) _kbBrowseHeadIdx = 0;
				if ( _kbIndex > 0 ) UiGridScroll.ScrollIndexIntoView( browseScrollRef, _kbIndex, "gb-row" );
				break;
			}
			case "browse-detail":
				_kbActive = true; _kbZone = "browse-detail"; _kbIndex = 0;
				break;
			case "create":
				_kbActive = true; _kbZone = "create"; _kbIndex = CreateRowName;
				break;
			case "plaza":
				// Only the create → plaza hand-off seeds (a fresh guild, the
				// player's hands still on WASD). Any other arrival keeps the
				// plaza's shipped behaviour (first nav press lights it).
				if ( prev != "create" ) return;
				{
					var gm = GuildManager.Instance;
					var members = gm?.Members ?? new List<GuildMemberInfo>();
					_kbActive = true; _kbZone = "chips"; _kbIndex = 0;
					if ( PlazaZoneCount( "chips", gm, members ) <= 0 ) _kbZone = "unlock";
				}
				break;
			default:
				return;
		}
		StateHasChanged();
	}

	// ── One-cursor hover for the no-guild views (DOC-5 §6) — same contract as
	//    PlazaHover: ignored while the keyboard drove last (synthetic hovers
	//    under a parked pointer during scroll-follow), moves the SAME
	//    zone/index the keys walk, guard against re-firing on the same stop.
	private bool SetHoverCursor( string zone, int idx )
	{
		if ( _kbActive && _kbZone == zone && _kbIndex == idx ) return false;
		_kbActive = true;
		_kbZone = zone;
		_kbIndex = idx;
		SoundManager.PlayHover();
		StateHasChanged();
		return true;
	}

	// Landing slab bodies — the two CTAs are BbButtons (no hover callback of
	// their own), so the body catches the bubbled onmouseover and walks the
	// target: .gl-cta inside .gl-slab-create → CREATE, else → BROWSE. Rows
	// have their own handler (a target inside .gl-irow is ignored here).
	private void LandingHover( PanelEvent e )
	{
		if ( _gpKbdMode || guildView != "landing" ) return;
		bool isCta = false, inCreate = false;
		for ( var p = e?.Target; p != null; p = p.Parent )
		{
			if ( p.HasClass( "gl-irow" ) ) return;
			if ( p.HasClass( "gl-cta" ) ) isCta = true;
			if ( p.HasClass( "gl-slab-create" ) ) { inCreate = true; break; }
			if ( p.HasClass( "gl-slab" ) ) break;
		}
		if ( !isCta ) return;
		int n = GuildManager.Instance?.PendingInvites?.Count ?? 0;
		if ( SetHoverCursor( "landing", inCreate ? n + 1 : 0 ) ) _kbLandBtn = 0;
	}

	// Landing invite row — the row is the stop; over ACCEPT (.gp-pacc) or
	// DECLINE (.gl-pdec) the sub-cursor seats there (the PendingRowHover
	// recipe); over the row's text it keeps its seat (ACCEPT on a fresh row).
	private void LandingRowHover( int rowIdx, PanelEvent e )
	{
		if ( _gpKbdMode || guildView != "landing" ) return;
		int btn = -1;
		for ( var p = e?.Target; p != null; p = p.Parent )
		{
			if ( p.HasClass( "gl-irow" ) ) break;
			if ( p.HasClass( "gp-pacc" ) ) { btn = 0; break; }
			if ( p.HasClass( "gl-pdec" ) ) { btn = 1; break; }
		}
		if ( SetHoverCursor( "landing", rowIdx ) ) { _kbLandBtn = btn < 0 ? 0 : btn; return; }
		if ( btn < 0 || btn == _kbLandBtn ) return;
		_kbLandBtn = btn;
		SoundManager.PlayHover();
		StateHasChanged();
	}

	// SEE ALL · BROWSE band chip — not a cursor stop (BROWSE is its kb twin);
	// hover sound only, and only while the mouse drives (DOC-5 §15).
	private void LandingRecSeeHover()
	{
		if ( _gpKbdMode || guildView != "landing" ) return;
		SoundManager.PlayHover();
	}

	// Landing RECRUITING row — the row is the stop (rowIdx = n+2+i); over its
	// JOIN/REQUEST (.gb-join) the sub-cursor seats on the button (the
	// BrowseRowHover recipe); over the row's text it seats on the row.
	private void LandingRecHover( int rowIdx, PanelEvent e )
	{
		if ( _gpKbdMode || guildView != "landing" ) return;
		int btn = 0;
		for ( var p = e?.Target; p != null; p = p.Parent )
		{
			if ( p.HasClass( "gb-row" ) ) break;
			if ( p.HasClass( "gb-join" ) ) { btn = 1; break; }
		}
		if ( SetHoverCursor( "landing", rowIdx ) ) { _kbLandBtn = btn; return; }
		if ( btn == _kbLandBtn ) return;
		_kbLandBtn = btn;
		SoundManager.PlayHover();
		StateHasChanged();
	}

	// Browse header stops (search 0 · MEMBERS 1 · LEVEL 2).
	private void BrowseHeadHover( int idx )
	{
		if ( _gpKbdMode || guildView != "browse" || viewingGuild != null ) return;
		if ( SetHoverCursor( "browse-head", idx ) ) _kbBrowseHeadIdx = idx;
	}

	// Browse row (or the empty block's REFRESH at 0) — over the row's JOIN
	// (.gb-join) the sub-cursor seats on the button.
	private void BrowseRowHover( int idx, PanelEvent e )
	{
		if ( _gpKbdMode || guildView != "browse" || viewingGuild != null ) return;
		int btn = 0;
		for ( var p = e?.Target; p != null; p = p.Parent )
		{
			if ( p.HasClass( "gb-row" ) || p.HasClass( "gb-empty" ) ) break;
			if ( p.HasClass( "gb-join" ) ) { btn = 1; break; }
		}
		if ( SetHoverCursor( "browse-grid", idx ) ) { _kbBrowseBtn = btn; return; }
		if ( btn == _kbBrowseBtn ) return;
		_kbBrowseBtn = btn;
		SoundManager.PlayHover();
		StateHasChanged();
	}

	// Detail actions row — JOIN (.gb-djoin → 0) · BACK TO LIST (.gb-dback →
	// backIdx: 1 when JOIN renders, else 0).
	private void BrowseDetailHover( PanelEvent e, int backIdx )
	{
		if ( _gpKbdMode || guildView != "browse" || viewingGuild == null ) return;
		int idx = -1;
		for ( var p = e?.Target; p != null; p = p.Parent )
		{
			if ( p.HasClass( "gb-dactions" ) ) break;
			if ( p.HasClass( "gb-djoin" ) ) { idx = 0; break; }
			if ( p.HasClass( "gb-dback" ) ) { idx = backIdx; break; }
		}
		if ( idx < 0 ) return;
		SetHoverCursor( "browse-detail", idx );
	}

	// Create form rows — every row host carries this (fields, chip rows, the
	// description wrap); the FOUND row walks its target for the button.
	private void CreateHover( int row )
	{
		if ( _gpKbdMode || guildView != "myguild" || InGuildLive() ) return;
		SetHoverCursor( "create", row );
	}

	private void CreateFootHover( PanelEvent e )
	{
		if ( _gpKbdMode || guildView != "myguild" || InGuildLive() ) return;
		for ( var p = e?.Target; p != null; p = p.Parent )
		{
			if ( p.HasClass( "gc-foot" ) ) return;
			if ( p.HasClass( "gs-save" ) ) { SetHoverCursor( "create", CreateRowFound ); return; }
		}
	}

	// ── MYGUILD ──────────────────────────────────────────────────────────────
	private void TickMyGuildInput()
	{
		// No guild → the create form is shown under guildView == "myguild".
		if ( !InGuildLive() ) { TickCreateInput(); return; }

		var gm = GuildManager.Instance;
		var raid = gm?.CurrentRaidBoss;

		// Raid team-select sub-state owns the keyboard.
		if ( showRaidTeamSelect && raid != null ) { TickRaidTeamSelectInput(); return; }

		// Raid encounter view (monument clicked).
		if ( raidViewOpen && raid != null ) { TickRaidViewInput(); return; }

		TickPlazaInput();
	}

	// Guild-page zones in the mock's documented walk order (LANE: input,
	// wired 2026-09-01): header chips → next-unlock chip → announcement
	// (pencil / write-row) → PENDING request rows (officers, pinned at the
	// roster's top; A/D = ACCEPT ↔ DENY, Space fires the focused button) →
	// ROSTER rows → THE WEEK's goal rows → THE LOG rows (info stops, Space
	// no-op). W/S flow VERTICALLY as one continuous cursor INSIDE THE COLUMN
	// the cursor sits in (DOC-5 §21 — the graph encodes the screen; the page
	// is two columns below the header: LEFT = unlock → pending → roster,
	// RIGHT = announcement → week → log, the header chips are the shared top
	// row of both). A/D HOP COLUMNS (unlock ⇄ announcement in the top band;
	// pending/roster ⇄ week/log at the spatially nearest row — rect-measured)
	// and step within the chip pair / the ACCEPT-DENY pair.
	// No Tab (playtest ruling), no AcceptsFocus. Empty zones skip on cross.
	// Every conditional stop is counted from the SAME live logic as the
	// markup's if-chain (stale-map law, DOC-5 §12). PENDING is volatile:
	// folding rows (_prowLeaving) are not stops, and the zone vanishes
	// cleanly when the list empties (PlazaValidatePendingCursor, in Tick).
	private static readonly string[] _plazaZones = { "chips", "unlock", "info", "pending", "roster", "week", "log" }; // membership only — W/S walk the column arrays below

	// LANE: input — the two W/S columns, top → bottom as painted. "chips" is
	// the header row above BOTH columns (S from a chip lands on the unlock
	// chip, the top band's first stop, as before). Fix 2026-09-04: W from
	// THIS WEEK used to land on the roster's LAST row (linear walk through
	// _plazaZones) — it now climbs to the ANNOUNCEMENT, and S from the
	// announcement drops into THIS WEEK, not PENDING.
	private static readonly string[] _plazaLeftColumn  = { "chips", "unlock", "pending", "roster" };
	private static readonly string[] _plazaRightColumn = { "chips", "info", "week", "log" };

	// The column a zone's W/S walk lives in. "chips" (index 0 in both)
	// resolves LEFT so S from the header keeps landing on the unlock chip.
	private static string[] PlazaColumnFor( string zone )
		=> Array.IndexOf( _plazaRightColumn, zone ) > 0 ? _plazaRightColumn : _plazaLeftColumn;

	private void TickPlazaInput()
	{
		var gm = GuildManager.Instance;
		var members = gm?.Members ?? new List<GuildMemberInfo>();

		// Q — leave the plaza. The plaza is the Guild section root, so Q here
		// should exit the section; let it fall through to GameHUD (do NOT
		// claim the key — GameHUD handles section exit).

		// Any nav key = the keyboard drove last (device contract leg 1).
		if ( NavPressed() ) StampKb();

		bool zoneIsPlaza = Array.IndexOf( _plazaZones, _kbZone ) >= 0;
		if ( !_kbActive || !zoneIsPlaza )
		{
			// First nav keypress just lights the cursor on the first
			// non-empty zone (chips are officer-conditional).
			if ( NavPressed() )
			{
				_kbActive = true;
				_kbZone = "chips";
				_kbIndex = 0;
				if ( PlazaZoneCount( "chips", gm, members ) <= 0 ) _kbZone = "unlock";
				SoundManager.PlayHover();
				StateHasChanged();
			}
			return;
		}

		// ── Vertical flow (W/S) — crosses zone boundaries. Roster / week /
		//    log are the multi-row zones: W/S step a row inside them and only
		//    cross out at the list's true top / bottom edge. Every other zone
		//    is a single row, so any W/S there immediately crosses zones. ──
		if ( Input.Pressed( "Up" ) )    { PlazaVertical( gm, members, -1 ); return; }
		if ( Input.Pressed( "Down" ) )  { PlazaVertical( gm, members,  1 ); return; }

		// ── Horizontal flow (A/D) — column hops + the chip pair. ──
		if ( Input.Pressed( "Left" ) )  { PlazaHorizontal( gm, members, -1 ); return; }
		if ( Input.Pressed( "Right" ) ) { PlazaHorizontal( gm, members,  1 ); return; }

		// ── Space/Enter/E — activate the focused control. ──
		if ( UiInput.ConfirmPressed() )
			PlazaActivate( gm, members );
	}

	// Count of focusable items in a plaza zone. 0 = empty zone (skip on cross).
	private int PlazaZoneCount( string zone, GuildManager gm, List<GuildMemberInfo> members )
	{
		switch ( zone )
		{
			// INVITE (officer) · REQUESTS·N (officer, N>0) · SETTINGS
			// (everyone — LEAVE lives in the settings DANGER slab). One live
			// list feeds the markup and this count (GetPlazaChips).
			case "chips":  return GetPlazaChips( gm ).Count;
			case "unlock": return 1;                                   // the next-unlock chip
			case "info":   return GetPlazaInfoPencils( gm ).Count;     // announcement pencil / write-row
			case "pending": return PlazaPendingLiveCount( gm );        // join-request rows still standing (folding rows excluded)
			case "roster": return GetPlazaRosterMembers( members ).Count;
			case "week":   return gm.WeeklyGoals?.Count ?? 0;          // goal rows (claim when claimable)
			case "log":    return CountLogRows( gm );                   // GROUPED feed rows (run 3 — the rendered list, not ActivityLog.Count); info stops, Space no-op
		}
		return 0;
	}

	// Vertical move. `dir` = -1 up / +1 down. The roster / week / log lists
	// step one row and only cross out at their true top/bottom edge; every
	// other zone is a single row, so any W/S there immediately crosses zones.
	private void PlazaVertical( GuildManager gm, List<GuildMemberInfo> members, int dir )
	{
		int count = PlazaZoneCount( _kbZone, gm, members );

		if ( _kbZone == "pending" )
		{
			// PENDING rows — step to the next row still standing (folding rows
			// are skipped); the ACCEPT/DENY column is kept (grid-honest).
			int next = PlazaPendingStep( gm, _kbIndex, dir );
			if ( next >= 0 )
			{
				_kbIndex = next;
				SoundManager.PlayHover();
				PlazaScrollFollow();
				StateHasChanged();
				return;
			}
			// Off the top/bottom edge — fall through to the zone cross.
		}
		else if ( (_kbZone == "roster" || _kbZone == "week" || _kbZone == "log") && count > 0 )
		{
			int next = _kbIndex + dir;
			if ( next >= 0 && next < count )
			{
				_kbIndex = next;
				SoundManager.PlayHover();
				PlazaScrollFollow();
				StateHasChanged();
				return;
			}
			// Off the top/bottom edge — fall through to the zone cross.
		}

		PlazaCrossZone( gm, members, dir );
	}

	// Keep the focused row on screen in whichever scroll list owns the
	// cursor (roster + log scroll; the week's 3 goal rows never do).
	private void PlazaScrollFollow()
	{
		if ( _kbZone == "roster" )
			UiGridScroll.ScrollIndexIntoView( rosterScrollRef, _kbIndex, "gp-mrow" );
		else if ( _kbZone == "pending" )
			UiGridScroll.ScrollIndexIntoView( rosterScrollRef, _kbIndex, "gp-prow" ); // same scroller, pinned at its top
		else if ( _kbZone == "log" )
			UiGridScroll.ScrollIndexIntoView( logScrollRef, _kbIndex, "gp-lrow" );
	}

	// Cross to the next/previous non-empty plaza zone IN THE CURRENT COLUMN
	// (DOC-5 §21). Going DOWN lands on the new zone's FIRST item; going UP
	// lands on its LAST item. The bottom of a column is a no-op (roster[last]
	// S / log[last] S stay put — nothing is painted below them); the top of
	// the right column with no announcement stop falls back to the header
	// chips, then the unlock chip (the header row, never the roster).
	// `quiet` = no hover cue (the automatic slide after a pending row folds —
	// the ACCEPT/DENY cue already played). Returns false when no zone in that
	// direction has a stop.
	private bool PlazaCrossZone( GuildManager gm, List<GuildMemberInfo> members, int dir, bool quiet = false )
	{
		var column = PlazaColumnFor( _kbZone );
		int zi = Array.IndexOf( column, _kbZone );
		if ( zi < 0 ) zi = 0;
		for ( int step = 0; step <= column.Length; step++ )
		{
			int ni = zi + dir * ( step + 1 );
			string zone;
			if ( ni >= 0 && ni < column.Length )
				zone = column[ni];
			else if ( dir < 0 && column == _plazaRightColumn && ni == -1 )
				zone = "unlock";                               // right column ran out above the chips — the header row's other stop
			else
				return false;                                  // top/bottom of the column — no-op
			int c = PlazaZoneCount( zone, gm, members );
			if ( c <= 0 ) continue;                            // empty zone — skip through
			_kbZone = zone;
			if ( zone == "pending" )
			{
				// Index is a position in the FULL request list (markup order);
				// land on the first / last row still standing, on ACCEPT.
				var list = GetPlazaPendingRequests( gm );
				_kbIndex = dir > 0 ? PlazaPendingStep( gm, -1, 1 ) : PlazaPendingStep( gm, list.Count, -1 );
				_kbPendBtn = 0;
			}
			else
				_kbIndex = dir > 0 ? 0 : c - 1;                // down→first item, up→last
			if ( !quiet ) SoundManager.PlayHover();
			// Pending/roster/log rows live in overflow:scroll lists — keep the
			// focused row on screen (deferred-scroll not needed: rows pre-exist).
			PlazaScrollFollow();
			StateHasChanged();
			return true;
		}
		return false;
	}

	// Horizontal move (A/D) — the COLUMN-HOP grammar (LANE: input): the page
	// is two columns wide below the header, so A/D cross columns at the
	// spatially nearest row (rect-measured — the kb graph encodes geometry,
	// DOC-5 §21). Inside the header's chip pair, A/D step between the chips
	// (the only truly horizontal zone).
	private void PlazaHorizontal( GuildManager gm, List<GuildMemberInfo> members, int dir )
	{
		switch ( _kbZone )
		{
			case "chips":
			{
				// INVITE ↔ REQUESTS·N ↔ SETTINGS (left → right, live list).
				int count = PlazaZoneCount( "chips", gm, members );
				if ( count <= 0 ) return;
				int next = Math.Clamp( _kbIndex + dir, 0, count - 1 );
				if ( next == _kbIndex ) return;
				_kbIndex = next;
				SoundManager.PlayHover();
				StateHasChanged();
				return;
			}
			case "unlock":
			{
				// D → the announcement stop (right of the identity band).
				// A → nothing (the emblem/XP to the left are not stops).
				if ( dir > 0 && PlazaZoneCount( "info", gm, members ) > 0 )
				{
					_kbZone = "info";
					_kbIndex = 0;
					SoundManager.PlayHover();
					StateHasChanged();
				}
				return;
			}
			case "info":
			{
				// A → back to the next-unlock chip.
				if ( dir < 0 )
				{
					_kbZone = "unlock";
					_kbIndex = 0;
					SoundManager.PlayHover();
					StateHasChanged();
				}
				return;
			}
			case "pending":
			{
				// A/D step ACCEPT ↔ DENY inside the row (the MOTD Save/Cancel
				// grammar). DENY is the roster column's right edge, so D from
				// DENY hops to the right column (geometry law, DOC-5 §21); A
				// from ACCEPT is a no-op (the row's text is not a stop).
				if ( dir < 0 )
				{
					if ( _kbPendBtn == 0 ) return;
					_kbPendBtn = 0;
					SoundManager.PlayHover();
					StateHasChanged();
					return;
				}
				if ( _kbPendBtn == 0 )
				{
					_kbPendBtn = 1;
					SoundManager.PlayHover();
					StateHasChanged();
					return;
				}
				PlazaHopRight( gm, members );
				return;
			}
			case "roster":
			{
				// D → the right column (week goal or log row nearest in Y).
				if ( dir > 0 ) PlazaHopRight( gm, members );
				return;
			}
			case "week":
			case "log":
			{
				// A → back to the left column (pending or roster) at the nearest row.
				if ( dir < 0 ) PlazaHopLeft( gm, members );
				return;
			}
		}
	}

	// ── Column-hop rect math — nearest-row matching is measured from live
	//    Box.Rects (screen space), so it stays honest under scrolling and
	//    the roomy/dense roster row height switch. NaN rects (first frame)
	//    fall back to the target column's first stop. ──

	private Panel NthChildWithClass( Panel container, string cls, int index )
	{
		if ( container == null || index < 0 ) return null;
		int n = 0;
		foreach ( var c in container.Children )
		{
			if ( !c.HasClass( cls ) ) continue;
			if ( n == index ) return c;
			n++;
		}
		return null;
	}

	private float RowCenterY( Panel container, string cls, int index )
	{
		var p = NthChildWithClass( container, cls, index );
		if ( p == null ) return float.NaN;
		var r = p.Box.Rect;
		if ( r.Height <= 0f ) return float.NaN;
		return r.Top + r.Height * 0.5f;
	}

	// Pending/roster → right column: pick the week goal / log row whose center
	// is nearest the focused row's center.
	private void PlazaHopRight( GuildManager gm, List<GuildMemberInfo> members )
	{
		int goalCount = PlazaZoneCount( "week", gm, members );
		int logCount = PlazaZoneCount( "log", gm, members );
		if ( goalCount <= 0 && logCount <= 0 ) return;

		float curY = _kbZone == "pending"
			? RowCenterY( rosterScrollRef, "gp-prow", _kbIndex )
			: RowCenterY( rosterScrollRef, "gp-mrow", _kbIndex );
		string bestZone = null;
		int bestIdx = 0;
		float bestD = float.MaxValue;

		for ( int j = 0; j < goalCount; j++ )
		{
			float y = RowCenterY( weekBodyRef, "gp-goal", j );
			float d = (float.IsNaN( y ) || float.IsNaN( curY )) ? float.MaxValue * 0.5f : Math.Abs( y - curY );
			if ( d < bestD ) { bestD = d; bestZone = "week"; bestIdx = j; }
		}
		for ( int k = 0; k < logCount; k++ )
		{
			float y = RowCenterY( logScrollRef, "gp-lrow", k );
			float d = (float.IsNaN( y ) || float.IsNaN( curY )) ? float.MaxValue * 0.5f : Math.Abs( y - curY );
			if ( d < bestD ) { bestD = d; bestZone = "log"; bestIdx = k; }
		}
		if ( bestZone == null ) { bestZone = goalCount > 0 ? "week" : "log"; bestIdx = 0; }

		_kbZone = bestZone;
		_kbIndex = bestIdx;
		SoundManager.PlayHover();
		PlazaScrollFollow();
		StateHasChanged();
	}

	// Week/log → left column: nearest PENDING (still standing) or roster row
	// by center Y. Landing on a pending row seats DENY — the button nearest
	// the column the cursor came from (geometry law).
	private void PlazaHopLeft( GuildManager gm, List<GuildMemberInfo> members )
	{
		int rosterCount = PlazaZoneCount( "roster", gm, members );
		var pending = GetPlazaPendingRequests( gm );
		if ( rosterCount <= 0 && PlazaPendingLiveCount( gm ) <= 0 ) return;

		float curY = _kbZone == "week"
			? RowCenterY( weekBodyRef, "gp-goal", _kbIndex )
			: RowCenterY( logScrollRef, "gp-lrow", _kbIndex );

		string bestZone = null;
		int best = 0;
		float bestD = float.MaxValue;
		for ( int p = 0; p < pending.Count; p++ )
		{
			if ( IsProwLeaving( pending[p] ) ) continue;
			float y = RowCenterY( rosterScrollRef, "gp-prow", p );
			float d = (float.IsNaN( y ) || float.IsNaN( curY )) ? float.MaxValue * 0.5f : Math.Abs( y - curY );
			if ( d < bestD ) { bestD = d; bestZone = "pending"; best = p; }
		}
		for ( int i = 0; i < rosterCount; i++ )
		{
			float y = RowCenterY( rosterScrollRef, "gp-mrow", i );
			float d = (float.IsNaN( y ) || float.IsNaN( curY )) ? float.MaxValue * 0.5f : Math.Abs( y - curY );
			if ( d < bestD ) { bestD = d; bestZone = "roster"; best = i; }
		}
		if ( bestZone == null ) { bestZone = rosterCount > 0 ? "roster" : "pending"; best = rosterCount > 0 ? 0 : PlazaPendingStep( gm, -1, 1 ); }

		_kbZone = bestZone;
		_kbIndex = best;
		if ( bestZone == "pending" ) _kbPendBtn = 1;
		SoundManager.PlayHover();
		PlazaScrollFollow();
		StateHasChanged();
	}

	// Activate (Space/Enter) the focused control in the current zone.
	private void PlazaActivate( GuildManager gm, List<GuildMemberInfo> members )
	{
		switch ( _kbZone )
		{
			case "chips":
			{
				var chips = GetPlazaChips( gm );
				if ( chips.Count == 0 ) return;
				int i = Math.Clamp( _kbIndex, 0, chips.Count - 1 );
				switch ( chips[i] )
				{
					case "invite":   OnInviteClicked(); break;
					case "requests": GoToPending(); SoundManager.PlayForward(); break;
					default:         OpenSettingsView(); SoundManager.PlayClick(); break;
				}
				StateHasChanged();
				break;
			}
			case "unlock":
			{
				showPerkLadder = true;
				SoundManager.PlayForward();
				StateHasChanged();
				break;
			}
			case "info":
			{
				var pencils = GetPlazaInfoPencils( gm );
				if ( pencils.Count == 0 ) return;
				StartEditMotd();
				SoundManager.PlayClick();
				StateHasChanged();
				break;
			}
			case "pending":
			{
				// Space/Enter/E fire the FOCUSED button (ACCEPT by default). The
				// fold/collapse helpers own the beat + the server call and then
				// slide the cursor off the leaving row (PlazaValidatePendingCursor).
				var list = GetPlazaPendingRequests( gm );
				if ( _kbIndex < 0 || _kbIndex >= list.Count ) return;
				var r = list[_kbIndex];
				if ( IsProwLeaving( r ) ) return;
				if ( _kbPendBtn == 1 ) DenyPendingWithCollapse( r );
				else AcceptPendingWithFold( r );
				break;
			}
			case "roster":
			{
				var ordered = GetPlazaRosterMembers( members );
				if ( ordered.Count == 0 ) return;
				int i = Math.Clamp( _kbIndex, 0, ordered.Count - 1 );
				OpenMemberMenu( ordered[i] );
				SoundManager.PlayClick();
				StateHasChanged();
				break;
			}
			case "week":
			{
				// Goal rows are info stops; Space claims only when claimable.
				var goals = gm.WeeklyGoals ?? new List<GuildWeeklyGoal>();
				if ( goals.Count == 0 ) return;
				int i = Math.Clamp( _kbIndex, 0, goals.Count - 1 );
				var g = goals[i];
				if ( g.Completed && !g.Claimed )
				{
					// LANE: motion — routes through the pop helper so the kb
					// claim gets the same Tier-2 flash + sound as the click.
					ClaimGoalWithPop( g );
				}
				break;
			}
			case "log":
			{
				// Log rows are read-only info stops — Space is a deliberate
				// no-op (the row taps nothing; there is nothing to press).
				break;
			}
		}
	}

	// ── One-cursor mouse hover (LANE: input, DOC-5 §6) — hovering a plaza
	//    stop moves the SAME zone/index cursor the keyboard walks, so
	//    guild-kb-selected is the ONE cursor in both modes and W/S continue
	//    from wherever the mouse parked it. Ignored while the keyboard drove
	//    last (_gpKbdMode): kb scroll-follow slides rows under a parked
	//    pointer and fires SYNTHETIC onmouseover — last input wins, and the
	//    root's onmousemove (real movement only) is the flip-back edge. ──
	private void PlazaHover( string zone, int idx )
	{
		if ( _gpKbdMode ) return;
		// Blocking sub-states own the cursor fields — a stray hover on the
		// page below must not corrupt them (the MOTD editor has no backdrop).
		if ( editingMotd || showPerkLadder || showSettingsView || showMemberMenu || showPicker ) return;
		if ( _kbActive && _kbZone == zone && _kbIndex == idx ) return;
		_kbActive = true;
		_kbZone = zone;
		_kbIndex = idx;
		SoundManager.PlayHover();
		StateHasChanged();
	}

	// Device flip: any nav keypress = keyboard drove last. Re-stamps the
	// pointer's parked position on EVERY nav press (B1) — the mouse-mode edge
	// measures travel from the last keypress, so a slow drift never
	// accumulates into a false flip.
	private void StampKb()
	{
		_gpKbTakeoverPos = Mouse.Position;
		if ( _gpKbdMode ) return;
		_gpKbdMode = true;
		StateHasChanged();
	}

	// Root onmousemove — the mouse-mode edge. B1 (run-2 audit, DOC-5 §5):
	// the engine re-dispatches onmousemove on re-render/re-layout under a
	// PARKED cursor, so an unguarded flip fired on every W/S press — device
	// flipped mid-frame, the row under the pointer re-hovered, the cursor
	// snapped back. Mouse mode is reclaimed only by REAL travel (>= 3px since
	// the keyboard took over) — the roster's OnRootMouseMove recipe.
	private void OnGpPageMouseMove()
	{
		if ( !_gpKbdMode ) return;
		if ( ( Mouse.Position - _gpKbTakeoverPos ).Length < 3f ) return;
		_gpKbdMode = false;
		StateHasChanged();
	}

	// ── Live focusable-item lists per zone — rebuilt each call so conditional
	//    controls match the markup exactly. ──

	// The announcement's one "info" stop: the officer pencil (MOTD set) or
	// the write-row (MOTD empty). Hidden while the editor is open.
	private List<string> GetPlazaInfoPencils( GuildManager gm )
	{
		var pencils = new List<string>();
		if ( gm.IsOfficer && !editingMotd ) pencils.Add( "motd" );
		return pencils;
	}

	// Roster rows in render order (online → role → arena points).
	private List<GuildMemberInfo> GetPlazaRosterMembers( List<GuildMemberInfo> members )
	{
		return members
			.OrderByDescending( m => m.IsOnline )
			.ThenByDescending( m => m.Role )
			.ThenByDescending( m => m.ArenaPoints )
			.ToList();
	}

	// ── PENDING zone (LANE: input, run-2 closeout B-1) ──────────────────────
	// The request list in MARKUP order — the same `pendingRequests` the
	// roster renders (officers only; everyone else sees no PENDING block).
	// _kbIndex in this zone is a position in THIS list (folding rows
	// included, so it matches the Nth .gp-prow child the scroller measures);
	// folding rows (_prowLeaving) are simply never stops.
	private List<GuildJoinRequest> GetPlazaPendingRequests( GuildManager gm )
	{
		if ( gm == null || !gm.IsOfficer ) return new List<GuildJoinRequest>();
		return gm.JoinRequests ?? new List<GuildJoinRequest>();
	}

	// Rows still standing = the zone's stop count (0 → the zone is skipped).
	private int PlazaPendingLiveCount( GuildManager gm )
	{
		int n = 0;
		foreach ( var r in GetPlazaPendingRequests( gm ) ) if ( !IsProwLeaving( r ) ) n++;
		return n;
	}

	// Next standing row from `from` (exclusive) in `dir`; -1 when none.
	// PlazaPendingStep( gm, -1, 1 ) = first standing row · ( gm, count, -1 ) = last.
	private int PlazaPendingStep( GuildManager gm, int from, int dir )
	{
		var list = GetPlazaPendingRequests( gm );
		for ( int i = from + dir; i >= 0 && i < list.Count; i += dir )
			if ( !IsProwLeaving( list[i] ) ) return i;
		return -1;
	}

	// The zone is VOLATILE (rows fold on ACCEPT/DENY, the server removes
	// them, other officers may act first). Called every Tick while the cursor
	// sits in the zone and right after a fold: a cursor on a folding /
	// vanished row moves to the next standing row (down, else up); when the
	// zone has emptied it slides into the first member row (or the nearest
	// non-empty zone below, else above) — so the zone vanishes cleanly.
	private void PlazaValidatePendingCursor()
	{
		if ( !_kbActive || _kbZone != "pending" ) return;
		// Blocking sub-states borrow _kbIndex for their own cursor while the
		// plaza's _kbZone sits idle — never touch it under them.
		if ( guildView != "myguild" || showSettingsView || showMemberMenu || showPicker || showPerkLadder || editingMotd || raidViewOpen ) return;
		var gm = GuildManager.Instance;
		if ( gm == null ) { ResetKb(); return; }
		var list = GetPlazaPendingRequests( gm );
		if ( _kbIndex >= 0 && _kbIndex < list.Count && !IsProwLeaving( list[_kbIndex] ) ) return;

		int from = Math.Clamp( _kbIndex, -1, list.Count );
		int next = PlazaPendingStep( gm, from, 1 );
		if ( next < 0 ) next = PlazaPendingStep( gm, Math.Min( from, list.Count ), -1 );
		if ( next >= 0 )
		{
			_kbIndex = next;
			_kbPendBtn = 0;
			PlazaScrollFollow();
			StateHasChanged();
			return;
		}

		// Zone empty — slide to the first member row / next stop (quiet: the
		// ACCEPT/DENY cue already played). Falls back upward, then to a reset.
		var members = gm.Members ?? new List<GuildMemberInfo>();
		if ( PlazaCrossZone( gm, members, 1, quiet: true ) ) return;
		if ( PlazaCrossZone( gm, members, -1, quiet: true ) ) return;
		ResetKb();
		StateHasChanged();
	}

	// REQUESTS·N chip (click or Space): scroll the roster to its top AND seat
	// the cursor on the first standing pending row, ACCEPT focused — the chip
	// hands the player straight to the verb. (In mouse mode the pointer is
	// still on the chip, so its next hover re-takes the cursor — last input
	// wins; the scroll is the mouse user's payoff.)
	private void GoToPending()
	{
		ScrollRosterToPending();
		var gm = GuildManager.Instance;
		int first = PlazaPendingStep( gm, -1, 1 );
		if ( first < 0 ) return;
		_kbActive = true;
		_kbZone = "pending";
		_kbIndex = first;
		_kbPendBtn = 0;
		StateHasChanged();
	}

	// Hover on a pending row moves the ONE cursor onto it (DOC-5 §6) and, when
	// the pointer is over ACCEPT or DENY, seats the button sub-cursor there
	// (e.Target → up to the row; the BbButton root carries gp-pacc/gp-pdeny
	// via Class). Over the row's text the sub-cursor keeps its seat (ACCEPT
	// on a fresh row). Ignored in kb mode (synthetic hovers under a parked
	// pointer during scroll-follow) and while a sub-state owns the keys.
	private void PendingRowHover( int idx, PanelEvent e )
	{
		if ( _gpKbdMode ) return;
		if ( editingMotd || showPerkLadder || showSettingsView || showMemberMenu || showPicker ) return;
		var gm = GuildManager.Instance;
		var list = GetPlazaPendingRequests( gm );
		if ( idx < 0 || idx >= list.Count || IsProwLeaving( list[idx] ) ) return; // folding row — inert

		int btn = -1;
		for ( var p = e?.Target; p != null; p = p.Parent )
		{
			if ( p.HasClass( "gp-prow" ) ) break;
			if ( p.HasClass( "gp-pacc" ) ) { btn = 0; break; }
			if ( p.HasClass( "gp-pdeny" ) ) { btn = 1; break; }
		}

		bool rowChanged = !( _kbActive && _kbZone == "pending" && _kbIndex == idx );
		if ( rowChanged )
		{
			_kbActive = true;
			_kbZone = "pending";
			_kbIndex = idx;
			_kbPendBtn = btn < 0 ? 0 : btn;
			SoundManager.PlayHover();
			StateHasChanged();
			return;
		}
		if ( btn < 0 || btn == _kbPendBtn ) return;
		_kbPendBtn = btn;
		SoundManager.PlayHover();
		StateHasChanged();
	}

	// ── PERK LADDER overlay (LANE: input) — W/S walk the perk rows (info
	//    stops, no press stamp); Q/Space/Enter/E close (Space opened it from
	//    the chip, Space closes it from inside — a read-and-dismiss surface).
	//    Esc stays unbound (engine-reserved, DOC-5 §2). Gated on
	//    showPerkLadder by the TickInput dispatch chain; the row cursor
	//    resets on the OPEN EDGE in Tick (opens by mouse too).
	private void TickPerkLadderInput()
	{
		if ( NavPressed() ) StampKb();

		int count = WiredPerks.Count;
		if ( Input.Pressed( "Up" ) || Input.Pressed( "Down" ) )
		{
			int dir = Input.Pressed( "Down" ) ? 1 : -1;
			int next = Math.Clamp( _ladderKbIndex + dir, 0, Math.Max( 0, count - 1 ) );
			if ( next != _ladderKbIndex )
			{
				_ladderKbIndex = next;
				SoundManager.PlayHover();
				StateHasChanged();
			}
			return;
		}

		if ( Input.Pressed( "Menu" ) || UiInput.ConfirmPressed() )
		{
			showPerkLadder = false;
			SoundManager.PlayBack();
			if ( Input.Pressed( "Menu" ) ) GameHUD.PanelHandledBackKey = true;
			StateHasChanged();
		}
	}

	// Ladder hover — same one-cursor / last-input-wins contract as
	// PlazaHover, on the ladder's own row cursor.
	private void LadderHover( int idx )
	{
		if ( !showPerkLadder || _gpKbdMode ) return;
		if ( _ladderKbIndex == idx ) return;
		_ladderKbIndex = idx;
		SoundManager.PlayHover();
		StateHasChanged();
	}

	// THE LOG's cursor class, stamped imperatively per tick (SetClass — the
	// overlay-scrollbar precedent). A volatile MARKUP class would remount
	// each row and replay its gpLogRowN entrance ladder on every cursor hop
	// (DOC-4 §14); SetClass mutates the live panel without a razor remount.
	private void SyncLogCursorClasses()
	{
		if ( logScrollRef == null ) return;
		bool active = _kbActive && _kbZone == "log";
		int n = 0;
		foreach ( var c in logScrollRef.Children )
		{
			if ( !c.HasClass( "gp-lrow" ) ) continue;
			c.SetClass( "guild-kb-selected", active && n == _kbIndex );
			n++;
		}
	}

	// ── RAID ENCOUNTER VIEW ──────────────────────────────────────────────────
	private void TickRaidViewInput()
	{
		// Q — close the raid view, back to plaza.
		if ( Input.Pressed( "Menu" ) )
		{
			SoundManager.PlayBack();
			raidViewOpen = false;
			ResetKb();
			GameHUD.PanelHandledBackKey = true;
			StateHasChanged();
			return;
		}

		// Space/Enter — attack the boss when attempts remain. Only one focusable
		// action in this view, so no list nav is needed.
		if ( UiInput.ConfirmPressed() )
		{
			if ( GuildManager.Instance?.CanAttemptRaid() ?? false )
				OnAttackRaidBoss();
		}
	}

	// ── RAID TEAM SELECT ─────────────────────────────────────────────────────
	private void TickRaidTeamSelectInput()
	{
		// Q — cancel team select.
		if ( Input.Pressed( "Menu" ) )
		{
			showRaidTeamSelect = false;
			raidTeamSelection.Clear();
			SoundManager.PlayBack();
			ResetKb();
			GameHUD.PanelHandledBackKey = true;
			StateHasChanged();
			return;
		}

		var monsters = GetRaidAvailableMonsters();
		if ( monsters.Count == 0 )
		{
			// No monsters — Space confirms only if a team is somehow set.
			if ( ( UiInput.ConfirmPressed() ) && raidTeamSelection.Count == 3 )
				StartRaidBattle();
			return;
		}

		if ( !_kbActive || _kbZone != "raid-select" )
		{
			if ( NavPressed() ) EngageKb( "raid-select" );
			return;
		}

		// Grid nav over the available-monster grid (4 cols matches the layout).
		const int cols = 4;
		if ( Input.Pressed( "Left" ) ) MoveKb( monsters.Count, -1 );
		else if ( Input.Pressed( "Right" ) ) MoveKb( monsters.Count, 1 );
		else if ( Input.Pressed( "Up" ) ) MoveKb( monsters.Count, -cols );
		else if ( Input.Pressed( "Down" ) ) MoveKb( monsters.Count, cols );
		else if ( Input.Pressed( "Jump" ) || Input.Pressed( "Use" ) )
		{
			// Space (E silent twin) — toggle the focused monster.
			_kbIndex = Math.Clamp( _kbIndex, 0, monsters.Count - 1 );
			ToggleRaidTeamMember( monsters[_kbIndex] );
			StateHasChanged();
		}
		else if ( Input.Pressed( "Enter" ) )
		{
			// Enter — confirm the attack when 3 are picked.
			if ( raidTeamSelection.Count == 3 ) StartRaidBattle();
		}
	}

	// ── CREATE FORM (run 3) ─────────────────────────────────────────────────
	// Rows in screen order (left column top→bottom, then the FOUND foot):
	//   name 0 · tag 1 · color 2 · beast 3 · description 4 · joinmode 5 ·
	//   minlevel 6 · FOUND 7.  Name / tag / description are TextEntry stops:
	// Space/Enter/E focuses the box; typing then owns the keyboard until Tab /
	// Enter / Esc hand it back (cursor stays on the field). A/D cycle the chip
	// rows (the settings CycleSettingsRow grammar). Q → landing.
	private const int CreateRowName = 0, CreateRowTag = 1, CreateRowColor = 2, CreateRowBeast = 3,
		CreateRowDesc = 4, CreateRowJoin = 5, CreateRowLevel = 6, CreateRowFound = 7, CreateRowCount = 8;

	private void TickCreateInput()
	{
		// Typing owns the keyboard (Q types a 'q', it does not leave the form).
		if ( TypingOwnsKeys( createNameInput, CreateRowName, "create" ) ) return;
		if ( TypingOwnsKeys( createTagInput, CreateRowTag, "create" ) ) return;
		if ( TypingOwnsKeys( createDescInput, CreateRowDesc, "create" ) ) return;

		// Q — leave the create form, back to landing.
		if ( Input.Pressed( "Menu" ) )
		{
			OnCreateBackPressed();
			GameHUD.PanelHandledBackKey = true;
			return;
		}

		if ( NavPressed() ) StampKb();

		const int rowCount = CreateRowCount;

		if ( !_kbActive || _kbZone != "create" )
		{
			if ( NavPressed() ) SeedViewCursor( "create", _kbViewEdge );
			return;
		}

		if ( Input.Pressed( "Up" ) ) { MoveKb( rowCount, -1 ); return; }
		if ( Input.Pressed( "Down" ) ) { MoveKb( rowCount, 1 ); return; }

		_kbIndex = Math.Clamp( _kbIndex, 0, rowCount - 1 );

		if ( Input.Pressed( "Left" ) || Input.Pressed( "Right" ) )
		{
			int dir = Input.Pressed( "Right" ) ? 1 : -1;
			switch ( _kbIndex )
			{
				case CreateRowColor:
				{
					int i = Array.IndexOf( EmblemColors, emblemColor );
					i = ( i + dir + EmblemColors.Length ) % EmblemColors.Length;
					emblemColor = EmblemColors[i];
					break;
				}
				case CreateRowBeast:
				{
					var choices = GetEmblemBeastChoices();
					if ( choices.Count == 0 ) return;
					var cur = ( emblemIcon ?? "" ).StartsWith( "beast:" ) ? emblemIcon.Substring( 6 ) : "";
					int i = choices.FindIndex( s => s.Id == cur );
					i = i < 0 ? ( dir > 0 ? 0 : choices.Count - 1 ) : ( i + dir + choices.Count ) % choices.Count;
					emblemIcon = "beast:" + choices[i].Id;
					break;
				}
				case CreateRowJoin:
				{
					int i = Array.IndexOf( JoinModeChips, settingsJoinMode );
					i = ( i + dir + JoinModeChips.Length ) % JoinModeChips.Length;
					settingsJoinMode = JoinModeChips[i];
					break;
				}
				case CreateRowLevel:
				{
					int i = Array.IndexOf( MinLevelChips, settingsMinLevel );
					if ( i < 0 ) i = 0;
					i = ( i + dir + MinLevelChips.Length ) % MinLevelChips.Length;
					settingsMinLevel = MinLevelChips[i];
					break;
				}
				default:
					return; // text rows / FOUND — not cyclable
			}
			SoundManager.PlayClick();
			StateHasChanged();
			return;
		}

		if ( UiInput.ConfirmPressed() )
		{
			switch ( _kbIndex )
			{
				case CreateRowFound: if ( CreateGateOpen() ) OnCreateGuild(); else SoundManager.PlayDeny(); break;
				case CreateRowName:  RequestEntryFocus( createNameInput ); break;
				case CreateRowTag:   RequestEntryFocus( createTagInput ); break;
				case CreateRowDesc:  RequestEntryFocus( createDescInput ); break;
			}
		}
	}

	// ── SETTINGS SUB-VIEW (kb rows) ──────────────────────────────────────────
	// Live ordered list of focusable rows in the sub-view's read order (left
	// column top→bottom, then right). Rebuilt each call so the conditional
	// rows (officer form rows; danger actions by role; Save for officers)
	// line up with the markup. Row ids (run 2 — the drawer's "icon" row is
	// now "beast"; "cancel" is gone — BACK TO GUILD · Q is the back):
	//   color · beast · description · joinmode · minlevel   (officers)
	//   · claim? · transfer? · leave · disband? · save?
	// LANE: input — the sub-view's real pass (A/D inside chip rows, HOLD on
	// the danger buttons, the column hop) builds on this list.
	private List<string> GetSettingsDrawerRows()
	{
		var gm = GuildManager.Instance;
		var rows = new List<string>();
		if ( gm?.IsOfficer ?? false ) rows.AddRange( new[] { "color", "beast", "description", "joinmode", "minlevel" } );
		if ( gm?.CanClaimLeadership() ?? false ) rows.Add( "claim" );
		if ( (gm?.IsLeader ?? false) && (gm?.Members?.Count ?? 0) > 1 ) rows.Add( "transfer" );
		rows.Add( "leave" );
		if ( gm?.IsLeader ?? false ) rows.Add( "disband" );
		if ( gm?.IsOfficer ?? false ) rows.Add( "save" );
		return rows;
	}

	private void TickSettingsDrawerInput()
	{
		// LANE: motion — the view is fading out; nothing takes input mid-exit.
		// LANE: input (run-2 closeout S-H, DOC-5 §1) — Q is still OURS during
		// the 0.12s latch: a fast double-tap must not fall to the hub's
		// BackToHub and leave the guild page. Claim it, act on nothing.
		if ( SettingsClosing )
		{
			if ( Input.Pressed( "Menu" ) ) GameHUD.PanelHandledBackKey = true;
			return;
		}

		// S3 — typing owns the keyboard while the description entry has focus
		// (Tab hands it back here; Enter/Esc via the entry's own events). Q
		// types a 'q' while focused; unfocused Q is the drawer's back (below).
		if ( TypingOwnsKeys( settingsDescInput, GetSettingsDrawerRows().IndexOf( "description" ) ) ) return;

		// Q — close the drawer (internal back, claim the key).
		if ( Input.Pressed( "Menu" ) )
		{
			CloseSettingsView(); // LANE: motion — the 0.12s exit latch (one close path)
			SoundManager.PlayBack();
			ResetKb();
			GameHUD.PanelHandledBackKey = true;
			StateHasChanged();
			return;
		}

		var rows = GetSettingsDrawerRows();
		if ( rows.Count == 0 ) return;
		_kbIndex = Math.Clamp( _kbIndex, 0, rows.Count - 1 );

		// Up/Down move the row cursor — flag a deferred scroll-follow so the
		// drawer body keeps the focused row on screen (body is overflow:scroll).
		if ( Input.Pressed( "Up" ) ) { MoveKb( rows.Count, -1 ); return; }
		if ( Input.Pressed( "Down" ) ) { MoveKb( rows.Count, 1 ); return; }

		var row = rows[_kbIndex];

		// Left/Right — on a chip row this cycles the focused option (the
		// sub-view has no cancel/save pair any more; SAVE stands alone).
		// LANE: input — A/D should walk the chips visually in-row (per-tile
		// cursor) in the sub-view pass; cycling the value is the interim.
		if ( Input.Pressed( "Left" ) || Input.Pressed( "Right" ) )
		{
			int dir = Input.Pressed( "Right" ) ? 1 : -1;
			CycleSettingsRow( row, dir );
			return;
		}

		// Space/Enter/E — activate. Buttons fire; danger rows open their
		// confirm dialogs; a radio row steps forward (so the keyboard works
		// even without Left/Right); the description row hands the keyboard
		// to its TextEntry (S3 — deferred a frame so the Space isn't typed).
		if ( UiInput.ConfirmPressed() )
		{
			if ( row == "save" )
			{
				SaveSettingsAndClose(); // S13 — one save path, one chime
				ResetKb();
				StateHasChanged();
			}
			else if ( row == "description" ) { RequestEntryFocus( settingsDescInput ); }
			else if ( row == "claim" )    { OnClaimLeadership(); SoundManager.PlayPopup(); }
			else if ( row == "transfer" ) { OnTransferOwnership(); }
			else if ( row == "leave" )    { OnLeaveGuild(); SoundManager.PlayPopup(); }
			else if ( row == "disband" )  { OnDisbandGuild(); SoundManager.PlayPopup(); }
			else
			{
				CycleSettingsRow( row, 1 );
			}
		}
	}

	// Step one drawer setting forward/back. Mirrors each row's onclick mutation
	// so keyboard edits land identically to mouse clicks.
	private void CycleSettingsRow( string row, int dir )
	{
		switch ( row )
		{
			case "color":
			{
				int i = Array.IndexOf( EmblemColors, emblemColor );
				i = ( i + dir + EmblemColors.Length ) % EmblemColors.Length;
				emblemColor = EmblemColors[i];
				break;
			}
			case "beast":
			{
				// The BEAST tiles (run 2) — "beast:<speciesId>" is the emblem.
				var choices = GetEmblemBeastChoices();
				if ( choices.Count == 0 ) return;
				var cur = ( emblemIcon ?? "" ).StartsWith( "beast:" ) ? emblemIcon.Substring( 6 ) : "";
				int i = choices.FindIndex( s => s.Id == cur );
				i = i < 0 ? ( dir > 0 ? 0 : choices.Count - 1 ) : ( i + dir + choices.Count ) % choices.Count;
				emblemIcon = "beast:" + choices[i].Id;
				break;
			}
			case "joinmode":
			{
				// Only the three CHIP modes cycle — `Closed` has no chip.
				var modes = JoinModeChips;
				int i = Array.IndexOf( modes, settingsJoinMode );
				if ( i < 0 ) i = 0;
				i = ( i + dir + modes.Length ) % modes.Length;
				settingsJoinMode = modes[i];
				break;
			}
			case "minlevel":
			{
				var lvls = MinLevelChips;
				int i = Array.IndexOf( lvls, settingsMinLevel );
				if ( i < 0 ) i = 0;
				i = ( i + dir + lvls.Length ) % lvls.Length;
				settingsMinLevel = lvls[i];
				break;
			}
			default:
				return; // description / danger rows / save — not cyclable
		}
		SoundManager.PlayClick();
		StateHasChanged();
	}

	// kb-selected predicate for the settings drawer rows (drawer owns the
	// keyboard whenever open, so the cursor shows immediately).
	private bool IsSettingsRowKb( string row )
	{
		if ( !showSettingsView ) return false;
		var rows = GetSettingsDrawerRows();
		int i = Math.Clamp( _kbIndex, 0, rows.Count - 1 );
		return i >= 0 && i < rows.Count && rows[i] == row;
	}

	// ── MEMBER CONTEXT MENU ──────────────────────────────────────────────────
	// Live action list in render order (mirrors the markup's @if chain).
	private List<string> GetMemberMenuActions( GuildManager gm, GuildMemberInfo sm )
	{
		var actions = new List<string>();
		if ( gm != null && sm != null )
		{
			var canManage = gm.IsOfficer && sm.SteamId != (Connection.Local?.SteamId ?? 0) && sm.Role < gm.Membership.Role;
			if ( canManage && gm.IsLeader && sm.Role < GuildRole.Warden ) actions.Add( "promote" );
			if ( canManage && gm.IsLeader && sm.Role > GuildRole.Wanderer && sm.Role < GuildRole.Beastlord ) actions.Add( "demote" );
			if ( canManage ) actions.Add( "kick" );
		}
		actions.Add( "close" );
		return actions;
	}

	// S1 (DOC-5 §12/§14) — the menu's cursor seeds on CLOSE (its safe stop),
	// never on the roster row index it was opened from (leader on row 1 →
	// [promote, kick, close] used to open ON KICK).
	private void SeedMemberMenuCursor()
	{
		_kbIndex = GetMemberMenuActions( GuildManager.Instance, selectedMember ).Count - 1;
	}

	// One opener for click AND Space — seeds at open so no frame paints the
	// roster index; Tick's open edge is the net for any other path.
	private void OpenMemberMenu( GuildMemberInfo m )
	{
		selectedMember = m;
		showMemberMenu = true;
		SeedMemberMenuCursor();
	}

	private void TickMemberMenuInput()
	{
		var gm = GuildManager.Instance;
		var sm = selectedMember;
		var actions = GetMemberMenuActions( gm, sm );

		// Device contract leg 1 (S-A): a nav key = the keyboard drove last, so
		// the overlay's hover rules drop and MemberMenuHover ignores hovers.
		if ( NavPressed() ) StampKb();

		if ( Input.Pressed( "Menu" ) )
		{
			showMemberMenu = false;
			selectedMember = null;
			SoundManager.PlayBack();
			GameHUD.PanelHandledBackKey = true;
			StateHasChanged();
			return;
		}

		if ( Input.Pressed( "Up" ) ) { MoveKb( actions.Count, -1 ); return; }
		if ( Input.Pressed( "Down" ) ) { MoveKb( actions.Count, 1 ); return; }

		if ( UiInput.ConfirmPressed() )
		{
			_kbIndex = Math.Clamp( _kbIndex, 0, actions.Count - 1 );
			switch ( actions[_kbIndex] )
			{
				case "promote": gm.PromoteMember( sm.SteamId ); SoundManager.PlaySelect(); break;
				case "demote":  gm.DemoteMember( sm.SteamId ); SoundManager.PlayClick(); break;
				case "kick":    ConfirmKick( sm ); SoundManager.PlayPopup(); break;
				case "close":   SoundManager.PlayBack(); break;
			}
			showMemberMenu = false;
			selectedMember = null;
			StateHasChanged();
		}
	}

	// ── PICKER MODAL (invite / transfer) ─────────────────────────────────────
	// INVITE kb graph (2026-09-02): row 0 = the search field (a TextEntry
	// STOP — Space/Enter/E focus it, deferred a frame; while typing every key
	// types and Tab / Enter (onsubmit) / Esc (oncancel) hand the keyboard
	// back to row 0); rows 1..N = candidates in list order (ONLINE NOW then
	// EVERYONE). W/S walk 0..N. Space on a row INVITES (picker stays open —
	// the row flips to PENDING; a PENDING row refuses). Q closes.
	// TRANSFER keeps its old graph: rows 0..N-1, Space picks and closes.
	private void TickPickerInput()
	{
		var isInvite = pickerMode == "invite";

		// S3/S5 — the search entry owns typing while focused (same grammar as
		// the settings description field). Must run BEFORE the Q check so a
		// typed "q" never closes the picker.
		if ( isInvite && TypingOwnsKeys( pickerSearchInput, 0 ) ) return;

		if ( NavPressed() ) StampKb(); // S-A — see TickMemberMenuInput

		if ( Input.Pressed( "Menu" ) )
		{
			ClosePicker(); // B2 — returns to the drawer when opened from it
			SoundManager.PlayBack();
			ResetKb();
			GameHUD.PanelHandledBackKey = true;
			StateHasChanged();
			return;
		}

		var gm = GuildManager.Instance;
		List<InviteCandidate> invitees = null;
		List<GuildMemberInfo> eligible = null;
		int rows;
		if ( isInvite )
		{
			invitees = GetPickerCandidates(); // the SAME call the markup makes
			rows = 1 + invitees.Count;        // + the search row
		}
		else
		{
			eligible = gm?.Members?.Where( m => m.SteamId != (Connection.Local?.SteamId ?? 0) && m.Role >= GuildRole.Tamer ).ToList() ?? new();
			rows = eligible.Count;
			if ( rows == 0 ) return;
		}

		if ( Input.Pressed( "Up" ) ) { MoveKb( rows, -1 ); return; }
		if ( Input.Pressed( "Down" ) ) { MoveKb( rows, 1 ); return; }

		if ( UiInput.ConfirmPressed() )
		{
			_kbIndex = Math.Clamp( _kbIndex, 0, rows - 1 );
			if ( isInvite )
			{
				if ( _kbIndex == 0 )
				{
					RequestEntryFocus( pickerSearchInput ); // S3 — deferred so the Space isn't typed
					StateHasChanged();
					return;
				}
				PickerInvite( invitees[_kbIndex - 1] );
				return;
			}
			gm?.TransferOwnership( eligible[_kbIndex].SteamId );
			ClosePicker();
			SoundManager.PlaySuccess();
			ResetKb();
			StateHasChanged();
		}
	}

	// ── INLINE EDITOR (MOTD) ─────────────────────────────────────────────────
	// The entry takes focus on open (S4 latch). While it owns typing: Enter
	// SAVES (onsubmit), Esc (oncancel) / Tab hand the keyboard back, every
	// other key types. Unfocused: Q cancels; A/D walk the Save↔Cancel pair
	// (side-by-side row — spatially honest); Space/Enter/E fires the focused
	// button; W climbs back into the text box (it sits ABOVE the pair).
	// Cursor seeded on SAVE (index 0) by StartEditMotd — a non-destructive
	// commit, so confirm-default is the right seat.
	private void TickEditorInput()
	{
		if ( TypingOwnsKeys( motdDraftInput, -1 ) ) return;

		if ( Input.Pressed( "Menu" ) )
		{
			if ( editingMotd ) CancelMotd();
			SoundManager.PlayBack();
			GameHUD.PanelHandledBackKey = true;
			StateHasChanged();
			return;
		}

		// W — back up into the text box (spatially above Save/Cancel).
		if ( Input.Pressed( "Up" ) )
		{
			StampKb();
			RequestEntryFocus( motdDraftInput );
			return;
		}

		if ( Input.Pressed( "Left" ) || Input.Pressed( "Right" ) )
		{
			StampKb();
			int next = Input.Pressed( "Right" ) ? 1 : 0;
			if ( next != _kbIndex )
			{
				_kbIndex = next;
				SoundManager.PlayHover();
				StateHasChanged();
			}
			return;
		}

		if ( UiInput.ConfirmPressed() )
		{
			if ( _kbIndex == 1 ) { CancelMotd(); SoundManager.PlayBack(); }
			else { SaveMotd(); SoundManager.PlaySuccess(); }
			StateHasChanged();
		}
	}

	// Editor pair hover — one-cursor on Save/Cancel.
	private void MotdEditorHover( int idx )
	{
		if ( !editingMotd || _gpKbdMode ) return;
		if ( _kbIndex == idx ) return;
		_kbIndex = idx;
		SoundManager.PlayHover();
		StateHasChanged();
	}

	// ── Overlay one-cursor hovers (run-2 closeout S-A, DOC-5 §5/§6) — the
	//    member menu and the invite/transfer picker are siblings of .gp-page,
	//    so their hover moves the SAME _kbIndex the keyboard walks and
	//    guild-kb-selected stays the one lit row. Mouse mode only. ──
	private void MemberMenuHover( int idx )
	{
		if ( !showMemberMenu || _gpKbdMode ) return;
		if ( _kbIndex == idx ) return;
		_kbIndex = idx;
		SoundManager.PlayHover();
		StateHasChanged();
	}

	private void PickerHover( int idx )
	{
		if ( !showPicker || _gpKbdMode ) return;
		if ( _kbIndex == idx ) return;
		_kbIndex = idx;
		SoundManager.PlayHover();
		StateHasChanged();
	}

	// ── TEXT-ENTRY GRAMMAR (LANE: input — S3/S5, DOC-5 §11/§18) ─────────────
	// Every TextEntry on this page is a kb STOP on its row:
	//   Space/Enter/E on the row → the box takes focus (deferred one frame so
	//     the confirm key itself is never typed);
	//   while typing → keys type; Tab (here), Enter (onsubmit) or Esc (the
	//     entry's own oncancel event — no Input "Escape" bind, DOC-5 §2)
	//     hand the keyboard back with the cursor still on that row;
	//   Q while unfocused → the surface's normal back.
	// Exception: the MOTD editor's Enter SAVES (submit IS the commit there).
	private void WireTextEntry( TextEntry entry, Action onSubmit )
	{
		if ( entry == null || _wiredEntries.Contains( entry ) ) return;
		_wiredEntries.Add( entry );
		entry.AddEventListener( "onsubmit", ( e ) => onSubmit?.Invoke() );
		entry.AddEventListener( "oncancel", ( e ) => BlurToRow( entry ) );
	}

	private void RequestEntryFocus( TextEntry entry )
	{
		if ( entry == null ) return;
		_focusEntryPending = entry;
		_focusEntryFrames = 1;
		SoundManager.PlayClick();
	}

	// Give the keyboard back; the cursor is already parked on the entry's
	// row (Space put it there, or TypingOwnsKeys dragged it on click-focus).
	private void BlurToRow( TextEntry entry )
	{
		if ( entry == null ) return;
		entry.Blur();
		_entryBlurAt = RealTime.Now; // same-frame latch — see TypingOwnsKeys
		SoundManager.PlayHover();
		StateHasChanged();
	}

	// True while `entry` owns typing (or just stopped, within the blur
	// latch — the Enter that blurred via onsubmit is still edge-true this
	// Tick and must not re-fire as a row confirm). Handles the one exit key
	// that reaches TickInput (Tab) and swallows everything else so WASD/Q
	// type instead of steering. A mouse click-focus also drags the ONE
	// cursor onto the entry's row (DOC-5 §6) so Tab lands where the box is.
	private bool TypingOwnsKeys( TextEntry entry, int rowIndex, string zone = null )
	{
		if ( entry == null ) return false;
		if ( RealTime.Now - _entryBlurAt < 0.05f ) return true;
		if ( !entry.HasFocus ) return false;
		if ( rowIndex >= 0 && ( _kbIndex != rowIndex || ( zone != null && ( !_kbActive || _kbZone != zone ) ) ) )
		{
			if ( zone != null ) { _kbActive = true; _kbZone = zone; }
			_kbIndex = rowIndex;
			StateHasChanged();
		}
		if ( Input.Pressed( "Score" ) ) BlurToRow( entry );
		if ( Input.Pressed( "Menu" ) ) GameHUD.PanelHandledBackKey = true; // AUDIT run 3: a typed 'q' is swallowed here but was never CLAIMED — OnlineHubPanel.TickInput (Menu && !PanelHandledBackKey) then ran BackToHub and left the guild section mid-word (learnings 2026-09-02: swallow AND claim)
		return true;
	}

