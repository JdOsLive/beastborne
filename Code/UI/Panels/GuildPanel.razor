@namespace Beastborne.UI.Panels
@using System
@using System.Linq
@using System.Collections.Generic
@using Sandbox
@using Sandbox.UI
@using Beastborne.Core
@using Beastborne.Data
@using Beastborne.Systems
@using Beastborne.UI.Components
@using Beastborne.UI.Primitives
@inherits Panel

<div class="guild-panel">

@if ( guildView == "landing" )
{
	@{
		var gmL = GuildManager.Instance;
		var inGuildL = gmL?.IsInGuild ?? false;
		var guildL = gmL?.Guild;
		var inviteCount = gmL?.PendingInvites?.Count ?? 0;
		var visibleGuilds = GetVisibleGuilds();
		var levelGated = GetTamerLevel() < GuildManager.MIN_LEVEL_TO_JOIN;
	}

	<!-- GUILD LANDING — Persona-5 style, hero+actions split.
	     When in a guild: hero card is your guild + actions row of Browse/Invites.
	     When not in a guild: hero card is "Form a Guild" (browse OR create) + Invites action. -->
	<div class="guild-landing-v2">

		<!-- LEVEL GATE — fullscreen takeover when below level 10 -->
		@if ( levelGated )
		{
			<div class="landing-gate-card">
				<div class="landing-gate-icon-wrap">
					<iconify icon="lucide:lock-keyhole" Size=@(72) Color="rgba(255, 200, 100, 0.85)" />
				</div>
				<span class="landing-gate-title">@L("ui.guild.guilds")</span>
				<span class="landing-gate-rule">@string.Format(L("ui.guild.requires_level"), GuildManager.MIN_LEVEL_TO_JOIN)</span>
				<span class="landing-gate-sub">@string.Format(L("ui.guild.your_level"), GetTamerLevel())</span>
			</div>
		}
		else
		{

		<!-- PENDING INVITES BANNER (above hero — high-priority alert) -->
		@if ( inviteCount > 0 )
		{
			<div class="landing-invites-banner">
				<div class="landing-invites-header">
					<iconify icon="lucide:mailbox" Size=@(16) Color="#fbbf24" />
					<span class="landing-invites-title">@L("ui.guild.pending_invites")</span>
					<span class="landing-invites-count">@inviteCount</span>
				</div>
				@{ var inviteKbIdx = 0; }
				@foreach ( var invite in gmL.PendingInvites )
				{
					var acceptIdx = inviteKbIdx;
					var denyIdx = inviteKbIdx + 1;
					inviteKbIdx += 2;
					<div class="invite-row">
						<div class="invite-info">
							<span class="invite-guild">[@invite.GuildTag] @invite.GuildName</span>
							<span class="invite-from">@L("ui.guild.from") @invite.InviterName</span>
						</div>
						<div class="invite-actions">
							<div class="guild-btn accept-btn @(IsLandingKb( acceptIdx ) ? "guild-kb-selected" : "")" onclick=@(() => { AcceptInvite( invite ); SoundManager.PlaySelect(); })>
								<iconify icon="lucide:check" Size=@(13) Color="#ffffff" />
								<span>@L("ui.guild.accept")</span>
							</div>
							<div class="guild-btn deny-btn @(IsLandingKb( denyIdx ) ? "guild-kb-selected" : "")" onclick=@(() => { DeclineInvite( invite ); SoundManager.PlayDeny(); })>
								<iconify icon="lucide:x" Size=@(13) Color="#ffffff" />
								<span>@L("ui.guild.deny")</span>
							</div>
						</div>
					</div>
				}
			</div>
		}

		@{ var heroKbIdx = inviteCount * 2; var browseKbIdx = heroKbIdx + 1; }
		<!-- HERO CARD — adapts to in-guild vs no-guild state -->
		@if ( inGuildL )
		{
			<div class="landing-hero-card has-guild @(IsLandingKb( heroKbIdx ) ? "guild-kb-selected" : "")"
				 onmouseover=@(() => { if (hoveredLandingCard != "myguild") { hoveredLandingCard = "myguild"; SoundManager.PlayHover(); } })
				 onmouseout=@(() => hoveredLandingCard = null)
				 onclick=@(() => { SoundManager.PlayForward(); guildView = "myguild"; errorMessage = ""; })>

				<!-- Halftone bg layer (P5 stamp aesthetic) -->
				<div class="landing-hero-bg"></div>

				<!-- Big emblem — beast emblems (beast:<id> / leader-favorite
				     default) render the species sprite as a NATIVE-PX 88×88
				     viewport crop (BbEmblem, the framed-tile recipe — no
				     scaling); legacy lucide keys keep the glyph. -->
				@{
					var heroEmblemBeast = BbEmblem.ResolveBeast( guildL?.EmblemIcon, guildL?.OwnerSteamId ?? 0, gmL?.Members );
					// Precomputed (nested call commas are Razor-attribute hazards).
					var heroEmblemCrop = heroEmblemBeast != null ? BbEmblem.CropStyleFor( heroEmblemBeast, 88, 88 ) : "";
				}
				<div class="landing-hero-emblem-wrap">
					<div class="landing-hero-emblem @(heroEmblemBeast != null ? "beast-tile" : "") shape-@(guildL?.EmblemShape ?? "square")" style="background-color: @(guildL?.EmblemColor ?? "#7c3aed")">
						@if ( heroEmblemBeast != null )
						{
							<img class="emblem-beast-img" src="@heroEmblemBeast.IconPath" style="@heroEmblemCrop" />
						}
						else
						{
							<iconify icon="@GetEmblemIcon( guildL?.EmblemIcon ?? "shield" )" Size=@(56) Color="#ffffff" />
						}
					</div>
				</div>

				<!-- Guild identity stack -->
				<div class="landing-hero-info">
					<div class="landing-hero-titlerow">
						<span class="landing-hero-name">@(guildL?.Name ?? L("ui.guild.my_guild"))</span>
						<span class="landing-hero-tag">[@(guildL?.Tag ?? "")]</span>
					</div>
					<div class="landing-hero-statsrow">
						<div class="landing-hero-stat">
							<iconify icon="lucide:trending-up" Size=@(13) Color="#a78bfa" />
							<span class="landing-hero-stat-value">Lv @(guildL?.Level ?? 1)</span>
						</div>
						<div class="landing-hero-stat">
							<iconify icon="lucide:users" Size=@(13) Color="#a78bfa" />
							<span class="landing-hero-stat-value">@(gmL.Members?.Count ?? 0)</span>
							<span class="landing-hero-stat-label">@L("ui.guild.members")</span>
						</div>
						<div class="landing-hero-stat">
							<iconify icon="lucide:circle" Size=@(11) Color="#4ade80" />
							<span class="landing-hero-stat-value">@gmL.OnlineCount</span>
							<span class="landing-hero-stat-label">@L("ui.guild.online")</span>
						</div>
						<div class="landing-hero-stat">
							<iconify icon="lucide:trophy" Size=@(13) Color="@GuildManager.GetGuildRankColor(gmL.GuildRankTier)" />
							<span class="landing-hero-stat-value" style="color: @GuildManager.GetGuildRankColor(gmL.GuildRankTier)">@gmL.GuildRankTier</span>
						</div>
					</div>
				</div>

				<!-- CTA chevron -->
				<div class="landing-hero-cta">
					<span class="landing-hero-cta-text">@L("ui.guild.enter")</span>
					<iconify icon="lucide:arrow-right" Size=@(20) Color="#ffffff" />
				</div>
			</div>
		}
		else
		{
			<!-- No guild — Create CTA hero -->
			<div class="landing-hero-card no-guild @(IsLandingKb( heroKbIdx ) ? "guild-kb-selected" : "")"
				 onmouseover=@(() => { if (hoveredLandingCard != "myguild") { hoveredLandingCard = "myguild"; SoundManager.PlayHover(); } })
				 onmouseout=@(() => hoveredLandingCard = null)
				 onclick=@(() => { SoundManager.PlayForward(); guildView = "myguild"; errorMessage = ""; })>

				<div class="landing-hero-bg"></div>

				<div class="landing-hero-emblem-wrap">
					<div class="landing-hero-emblem shape-square placeholder-emblem">
						<iconify icon="lucide:plus" Size=@(56) Color="#a78bfa" />
					</div>
				</div>

				<div class="landing-hero-info">
					<div class="landing-hero-titlerow">
						<span class="landing-hero-name">@L("ui.guild.create_a_guild")</span>
					</div>
					<div class="landing-hero-statsrow">
						<div class="landing-hero-stat">
							<iconify icon="lucide:coins" Size=@(13) Color="#fbbf24" />
							<span class="landing-hero-stat-value">@($"{GuildManager.GUILD_CREATION_COST:N0}")</span>
							<span class="landing-hero-stat-label">@L("ui.guild.gold_cost")</span>
						</div>
						<div class="landing-hero-stat">
							<iconify icon="lucide:users" Size=@(13) Color="#a78bfa" />
							<span class="landing-hero-stat-value">@GuildManager.BASE_MAX_MEMBERS</span>
							<span class="landing-hero-stat-label">@L("ui.guild.max_members")</span>
						</div>
						<div class="landing-hero-stat">
							<iconify icon="lucide:zap" Size=@(13) Color="#a78bfa" />
							<span class="landing-hero-stat-value">10</span>
							<span class="landing-hero-stat-label">@L("ui.guild.tab_perks")</span>
						</div>
					</div>
				</div>

				<div class="landing-hero-cta">
					<span class="landing-hero-cta-text">@L("ui.guild.start")</span>
					<iconify icon="lucide:arrow-right" Size=@(20) Color="#ffffff" />
				</div>
			</div>
		}

		<!-- ACTION ROW — Browse + (Invites if not already in banner above) -->
		<div class="landing-actions-row">
			<div class="landing-action-card browse-action @(hoveredLandingCard == "browse" ? "selected" : "") @(IsLandingKb( browseKbIdx ) ? "guild-kb-selected" : "")"
				 onmouseover=@(() => { if (hoveredLandingCard != "browse") { hoveredLandingCard = "browse"; SoundManager.PlayHover(); } })
				 onmouseout=@(() => hoveredLandingCard = null)
				 onclick=@(() => { SoundManager.PlayForward(); guildView = "browse"; errorMessage = ""; viewingGuild = null; LoadGuildsFromApi(); })>
				<div class="landing-action-icon">
					<iconify icon="lucide:search" Size=@(28) Color="#a78bfa" />
				</div>
				<div class="landing-action-text">
					<span class="landing-action-title">@L("ui.guild.browse")</span>
					<span class="landing-action-sub">@(visibleGuilds.Count > 0 ? string.Format("{0} {1}", visibleGuilds.Count, L("ui.guild.found")) : L("ui.guild.view_guilds"))</span>
				</div>
				<iconify icon="lucide:chevron-right" Size=@(18) Color="rgba(255,255,255,0.5)" />
			</div>

			@if ( inviteCount == 0 )
			{
				<div class="landing-action-card invites-action @(hoveredLandingCard == "invites" ? "selected" : "")"
					 onmouseover=@(() => { if (hoveredLandingCard != "invites") { hoveredLandingCard = "invites"; SoundManager.PlayHover(); } })
					 onmouseout=@(() => hoveredLandingCard = null)>
					<div class="landing-action-icon">
						<iconify icon="lucide:mailbox" Size=@(28) Color="rgba(255,255,255,0.4)" />
					</div>
					<div class="landing-action-text">
						<span class="landing-action-title">@L("ui.guild.invites")</span>
						<span class="landing-action-sub">@L("ui.guild.none")</span>
					</div>
				</div>
			}
		</div>

		<!-- Hop cooldown notice -->
		@if ( gmL?.IsOnHopCooldown() ?? false )
		{
			<div class="hop-cooldown-notice">
				<iconify icon="lucide:clock" Size=@(14) Color="rgba(255, 200, 100, 0.85)" />
				<span class="cooldown-text">@string.Format(L("ui.guild.hop_cooldown"), FormatCooldown())</span>
			</div>
		}

		}
	</div>
}
else if ( guildView == "browse" )
{
	<!-- BROWSE GUILDS VIEW — P5 stamp slab header + scrollable card list. -->
	<div class="browse-topbar">
		<!-- Title slab — angular stamp w/ italic uppercase, matches plaza-banner aesthetic -->
		<div class="browse-title-slab">
			<div class="browse-title-cut"></div>
			<iconify class="browse-title-icon" icon="lucide:search" Size=@(18) Color="#fbbf24" />
			<span class="browse-title-text">@L("ui.guild.browse_title")</span>
		</div>

		<!-- Search input — filters visible guilds by name/tag as you type.
		     Polled in Tick() since TextEntry doesn't expose onchange. -->
		<div class="browse-search-wrap @(_kbSearchFocused ? "guild-kb-search-focused" : "")">
			<iconify class="browse-search-icon" icon="lucide:search" Size=@(14) Color="rgba(167, 139, 250, 0.85)" />
			<TextEntry class="browse-search-input" @ref="browseSearchInput" Text="@browseSearchQuery" Placeholder="Search guild name or tag…" />
			@if ( !string.IsNullOrEmpty( browseSearchQuery ) )
			{
				<button class="browse-search-clear" onclick=@(() => { browseSearchQuery = ""; if (browseSearchInput != null) browseSearchInput.Text = ""; SoundManager.PlayBack(); })>
					<iconify icon="lucide:x" Size=@(12) Color="rgba(255, 255, 255, 0.65)" />
				</button>
			}
		</div>

		<!-- Refresh -->
		<button class="plaza-icon-btn" onclick=@(() => { SoundManager.PlayClick(); LoadGuildsFromApi(); })>
			<iconify icon="lucide:refresh-cw" Size=@(16) Color="rgba(255,255,255,0.85)" />
		</button>
		<!-- Back -->
		<button class="plaza-icon-btn" onclick=@(() => { SoundManager.PlayBack(); guildView = (GuildManager.Instance?.IsInGuild ?? false) ? "myguild" : "landing"; viewingGuild = null; errorMessage = ""; })>
			<iconify icon="lucide:arrow-left" Size=@(16) Color="rgba(255,255,255,0.85)" />
		</button>
	</div>
	<div class="guild-content-card" @ref="browseScrollRef">
	<div class="guild-browse-view">

		@if ( viewingGuild != null )
		{
			<!-- GUILD DETAIL -->
			<div class="guild-detail">
				<div class="detail-header">
					<!-- Ads carry no OwnerSteamId, so the leader-favorite default
					     can't resolve here — beast: picks render, empty falls to
					     the shield glyph. 80×80 window (.guild-detail override). -->
					@{
						var detailEmblemBeast = BbEmblem.ResolveBeast( viewingGuild.EmblemIcon );
						var detailEmblemCrop = detailEmblemBeast != null ? BbEmblem.CropStyleFor( detailEmblemBeast, 80, 80 ) : "";
					}
					<div class="detail-emblem @(detailEmblemBeast != null ? "beast-tile" : "") shape-@(viewingGuild.EmblemShape ?? "square")" style="background-color: @viewingGuild.EmblemColor">
						@if ( detailEmblemBeast != null )
						{
							<img class="emblem-beast-img" src="@detailEmblemBeast.IconPath" style="@detailEmblemCrop" />
						}
						else
						{
							<iconify class="detail-emblem-icon" icon="@GetEmblemIcon( viewingGuild.EmblemIcon )" Size=@(32) Color="#ffffff" />
						}
					</div>
					<div class="detail-header-info">
						<div class="detail-name-row">
							<span class="detail-name">@viewingGuild.GuildName</span>
							<span class="detail-level-badge">@($"Lv {viewingGuild.Level}")</span>
							<span class="detail-tag">@($"[{viewingGuild.GuildTag}]")</span>
						</div>
						<span class="detail-owner">@L("ui.guild.founded_by") @viewingGuild.OwnerName</span>
					</div>
				</div>

				@if ( !string.IsNullOrEmpty( viewingGuild.Description ) )
				{
					<div class="detail-description">
						<span class="detail-desc-text">@viewingGuild.Description</span>
					</div>
				}

				<div class="detail-stats-row">
					<div class="detail-stat">
						<span class="detail-stat-value">@viewingGuild.MemberCount</span>
						<span class="detail-stat-label">@L("ui.guild.members")</span>
					</div>
					<div class="detail-stat">
						<span class="detail-stat-value">@viewingGuild.OnlineCount</span>
						<span class="detail-stat-label">@L("ui.guild.online")</span>
					</div>
					<div class="detail-stat">
						<span class="detail-stat-value">@($"{viewingGuild.TotalRP:N0}")</span>
						<span class="detail-stat-label">@L("ui.guild.total_rp")</span>
					</div>
				</div>

				<div class="detail-requirements">
					<span class="detail-req-title">@L("ui.guild.requirements")</span>
					<div class="detail-req-row">
						<span class="detail-req-item">Join: @viewingGuild.JoinMode</span>
						<span class="detail-req-item">Min Level: @(viewingGuild.MinLevel > 1 ? $"Lv {viewingGuild.MinLevel}" : "None")</span>
						<span class="detail-req-item">Min Rank: @viewingGuild.MinRank</span>
					</div>
				</div>

				<div class="detail-members-section">
					<span class="detail-members-title">@($"Members ({viewingGuildMembers.Count})")</span>
					@if ( isLoadingMembers )
					{
						<span class="detail-members-loading">@L("ui.guild.loading_members")</span>
					}
					else if ( viewingGuildMembers.Count > 0 )
					{
						<div class="detail-members-list">
							@foreach ( var member in viewingGuildMembers )
							{
								<div class="detail-member-chip">
									<iconify class="chip-role" icon="@GuildManager.GetRoleIcon( (GuildRole)member.Role )" Size=@(12) Color="@GuildManager.GetRoleColor( (GuildRole)member.Role )" />
									<span class="chip-name">@member.Name</span>
									<span class="chip-level">@($"{member.Level}")</span>
								</div>
							}
						</div>
					}
					else
					{
						<span class="detail-members-loading">@L("ui.guild.no_members")</span>
					}
				</div>

				@{
					var detailLocked = viewingGuild.JoinMode == GuildJoinMode.Closed || viewingGuild.JoinMode == GuildJoinMode.InviteOnly;
					var detailCanJoin = !(GuildManager.Instance?.IsInGuild ?? false) && !detailLocked;
					var detailBackIdx = detailCanJoin ? 1 : 0;
				}
				<div class="detail-actions">
					@if ( !(GuildManager.Instance?.IsInGuild ?? false) )
					{
						@if ( detailLocked )
						{
							<span class="detail-locked">@L("ui.guild.invite_only")</span>
						}
						else
						{
							<div class="guild-btn join-btn detail-join-btn @(IsBrowseDetailKb( 0 ) ? "guild-kb-selected" : "")" onclick=@(() => { RequestJoin( viewingGuild ); SoundManager.PlaySelect(); viewingGuild = null; })>
								<span>@(viewingGuild.JoinMode == GuildJoinMode.Open ? L("ui.guild.join_guild") : L("ui.guild.request_join"))</span>
							</div>
						}
					}
					<div class="guild-btn secondary-btn detail-back-btn @(IsBrowseDetailKb( detailBackIdx ) ? "guild-kb-selected" : "")" onclick=@(() => { SoundManager.PlayBack(); viewingGuild = null; })>
						<span>@L("ui.guild.back_to_list")</span>
					</div>
				</div>
			</div>
		}
		else
		{
			<!-- GUILD LIST -->
			@if ( isLoadingGuilds )
			{
				<span class="browse-loading">Loading guilds...</span>
			}
			@{
				var guilds = GetVisibleGuilds();
			}
			@if ( guilds.Count == 0 && !isLoadingGuilds )
			{
				<span class="browse-empty">@L("ui.guild.no_guilds")</span>
			}

			@* 3-column grid via explicit row triples — flex-wrap on a scroll
			   container miscalculates height in s&box, so we chunk manually
			   into rows of 3. Empty placeholders fill incomplete trailing
			   rows so each row's cards stay 1/3 width. *@
			@for ( int i = 0; i < guilds.Count; i += 3 )
			{
				var iCopy = i;
				<div class="browse-row-3">
					@for ( int j = 0; j < 3; j++ )
					{
						var idx = iCopy + j;
						if ( idx < guilds.Count )
						{
							var guild = guilds[idx];
							var isLocked = guild.JoinMode == GuildJoinMode.Closed || guild.JoinMode == GuildJoinMode.InviteOnly;
							<div class="browse-card-v2 @(IsBrowseGridKb( idx ) ? "guild-kb-selected" : "")" onclick=@(() => ViewGuildDetail( guild ))>
								<div class="browse-card-edge" style="background-color: @guild.EmblemColor"></div>

								@{
									var rowEmblemBeast = BbEmblem.ResolveBeast( guild.EmblemIcon );
									var rowEmblemCrop = rowEmblemBeast != null ? BbEmblem.CropStyleFor( rowEmblemBeast, 48, 48 ) : "";
								}
								<div class="browse-card-emblem @(rowEmblemBeast != null ? "beast-tile" : "") shape-@(guild.EmblemShape ?? "square")" style="background-color: @guild.EmblemColor">
									@if ( rowEmblemBeast != null )
									{
										<img class="emblem-beast-img" src="@rowEmblemBeast.IconPath" style="@rowEmblemCrop" />
									}
									else
									{
										<iconify icon="@GetEmblemIcon( guild.EmblemIcon )" Size=@(22) Color="#ffffff" />
									}
								</div>

								<div class="browse-card-info">
									<div class="browse-card-titlerow">
										<div class="browse-card-tag-pill">
											<span>@guild.GuildTag</span>
										</div>
										<span class="browse-card-name">@guild.GuildName</span>
									</div>
									<div class="browse-card-meta-row">
										<div class="browse-card-meta-chip">
											<iconify icon="lucide:users" Size=@(11) Color="rgba(167, 139, 250, 0.9)" />
											<span>@guild.MemberCount</span>
										</div>
										<div class="browse-card-meta-chip">
											<iconify icon="lucide:trending-up" Size=@(11) Color="rgba(167, 139, 250, 0.9)" />
											<span>@($"{guild.TotalRP:N0}") RP</span>
										</div>
										@if ( isLocked )
										{
											<div class="browse-card-meta-chip locked-chip">
												<iconify icon="lucide:lock" Size=@(10) Color="rgba(252, 165, 165, 0.85)" />
												<span>@L("ui.guild.invite_only")</span>
											</div>
										}
									</div>
								</div>

								<div class="browse-card-level-stamp">
									<span>Lv @guild.Level</span>
								</div>
							</div>
						}
						else
						{
							<div class="browse-card-empty"></div>
						}
					}
				</div>
			}
		}
	</div>
	</div>
}
else if ( guildView == "myguild" )
{
	@if ( !(GuildManager.Instance?.IsInGuild ?? false) )
	{
		<!-- NO GUILD - CREATE (Persona-stamp pass) -->
		<div class="guild-create-root">

			<!-- Header strip — matches the rest of the Guild sub-panels.
			     Title slab + skewed yellow corner stamp + back button. -->
			<div class="create-header-stamp">
				<div class="create-header-titleblock">
					<iconify icon="lucide:hammer" Size=@(18) Color="#a78bfa" />
					<div class="create-header-textcol">
						<span class="create-header-title">FOUND A GUILD</span>
						<span class="create-header-sub">Stamp your colors on the Public Square</span>
					</div>
				</div>
				<div class="create-header-tag"><span>NEW · GUILD</span></div>
				<button class="create-back-btn" onclick=@(() => { SoundManager.PlayBack(); guildView = "landing"; errorMessage = ""; })>
					<iconify icon="lucide:arrow-left" Size=@(13) Color="rgba(255,255,255,0.85)" />
					<span>BACK</span>
				</button>
			</div>

			@if ( GetTamerLevel() < GuildManager.MIN_LEVEL_TO_JOIN )
			{
				<div class="create-level-gate-stamp">
					<div class="gate-stamp-iconwrap">
						<iconify icon="lucide:lock" Size=@(28) Color="#fbbf24" />
					</div>
					<div class="gate-stamp-text">
						<span class="gate-stamp-title">@string.Format(L("ui.guild.requires_level"), GuildManager.MIN_LEVEL_TO_JOIN)</span>
						<span class="gate-stamp-sub">@string.Format(L("ui.guild.your_level"), GetTamerLevel())</span>
					</div>
				</div>
			}
			else
			{
				<div class="create-stamp-grid">

					<!-- LEFT: Identity + Emblem stack -->
					<div class="create-stamp-form">

						<!-- Identity card -->
						<div class="create-stamp-section">
							<div class="create-stamp-section-head">
								<iconify icon="lucide:tag" Size=@(13) Color="#a78bfa" />
								<span>IDENTITY</span>
							</div>

							<!-- LANE: input (S5) — name/tag are kb stops 0/1: Space/Enter/E
							     focuses the box; Tab / Enter / Esc hand the keyboard back
							     with the cursor on the field (TickCreateInput). -->
							<div class="create-stamp-field @(IsCreateKb( 0 ) ? "guild-kb-selected" : "")">
								<span class="create-stamp-field-label">GUILD NAME</span>
								<TextEntry class="create-stamp-input" @ref="createNameInput" Text=@createName />
								<span class="create-stamp-field-hint">3–24 characters · must be unique</span>
							</div>

							<div class="create-stamp-field @(IsCreateKb( 1 ) ? "guild-kb-selected" : "")">
								<span class="create-stamp-field-label">TAG</span>
								<TextEntry class="create-stamp-input tag" @ref="createTagInput" Text=@createTag />
								<span class="create-stamp-field-hint">2–5 characters · shown next to your name in chat</span>
							</div>
						</div>

						<!-- Emblem card -->
						<div class="create-stamp-section">
							<div class="create-stamp-section-head">
								<iconify icon="lucide:shield" Size=@(13) Color="#a78bfa" />
								<span>EMBLEM</span>
							</div>

							<span class="create-stamp-pick-caption">COLOR</span>
							<div class="create-stamp-pick-row @(IsCreateKb( 2 ) ? "guild-kb-selected" : "")">
								@foreach ( var color in EmblemColors )
								{
									<div class="emblem-swatch @(emblemColor == color ? "selected" : "")" style="background-color: @color" onclick=@(() => { emblemColor = color; SoundManager.PlayClick(); })></div>
								}
							</div>

							<span class="create-stamp-pick-caption">ICON</span>
							<div class="create-stamp-pick-row @(IsCreateKb( 3 ) ? "guild-kb-selected" : "")">
								@foreach ( var icon in EmblemIcons )
								{
									<div class="emblem-icon-option @(emblemIcon == icon.Key ? "selected" : "")" onclick=@(() => { emblemIcon = icon.Key; SoundManager.PlayClick(); })>
										<iconify icon="@icon.Value" Size=@(18) Color="#ffffff" />
									</div>
								}
							</div>

							<span class="create-stamp-pick-caption">SHAPE</span>
							<div class="create-stamp-pick-row @(IsCreateKb( 4 ) ? "guild-kb-selected" : "")">
								@foreach ( var shape in EmblemShapes )
								{
									<div class="emblem-shape-option @(emblemShape == shape.Key ? "selected" : "")" onclick=@(() => { emblemShape = shape.Key; SoundManager.PlayClick(); })>
										<iconify icon="@shape.Value" Size=@(16) Color="#ffffff" />
									</div>
								}
							</div>
						</div>

					</div>

					<!-- RIGHT: Live preview + cost + CTA -->
					<div class="create-stamp-preview">
						<span class="create-stamp-preview-eyebrow">PREVIEW</span>
						<!-- Create flow only offers lucide keys today, but the preview
						     goes through the shared resolve so a beast pick renders the
						     day the beast picker lands (110×110 window — 96px sources
						     centre with air, native px). -->
						@{
							var createEmblemBeast = BbEmblem.ResolveBeast( emblemIcon );
							var createEmblemCrop = createEmblemBeast != null ? BbEmblem.CropStyleFor( createEmblemBeast, 110, 110 ) : "";
						}
						<div class="create-stamp-preview-emblem @(createEmblemBeast != null ? "beast-tile" : "") shape-@emblemShape" style="background-color: @emblemColor">
							@if ( createEmblemBeast != null )
							{
								<img class="emblem-beast-img" src="@createEmblemBeast.IconPath" style="@createEmblemCrop" />
							}
							else
							{
								<iconify icon="@GetEmblemIcon( emblemIcon )" Size=@(56) Color="#ffffff" />
							}
						</div>
						<span class="create-stamp-preview-name">@(string.IsNullOrEmpty( createNameInput?.Text ) ? "Guild Name" : createNameInput.Text)</span>
						<div class="create-stamp-preview-meta">
							<div class="create-stamp-preview-stamp tag-stamp"><span>[@(string.IsNullOrEmpty( createTagInput?.Text ) ? "TAG" : createTagInput.Text)]</span></div>
							<div class="create-stamp-preview-stamp lv-stamp"><span>LV 1</span></div>
						</div>

						<div class="create-stamp-cost">
							<iconify icon="lucide:coins" Size=@(13) Color="#fbbf24" />
							<span class="cost-amount">@($"{GuildManager.GUILD_CREATION_COST:N0}")</span>
							<span class="cost-label">gold to found</span>
						</div>

						<button class="create-stamp-cta @(IsCreateKb( 5 ) ? "guild-kb-selected" : "")" onclick=@OnCreateGuild>
							<iconify icon="lucide:hammer" Size=@(15) Color="#ffffff" />
							<span>FOUND GUILD</span>
						</button>

						@if ( !string.IsNullOrEmpty( errorMessage ) )
						{
							<div class="create-stamp-error">
								<iconify icon="lucide:triangle-alert" Size=@(12) Color="#fca5a5" />
								<span>@errorMessage</span>
							</div>
						}
					</div>

				</div>

				@if ( GuildManager.Instance?.IsOnHopCooldown() ?? false )
				{
					<div class="create-stamp-cooldown">
						<iconify icon="lucide:hourglass" Size=@(12) Color="#fbbf24" />
						<span>@string.Format(L("ui.guild.hop_cooldown"), FormatCooldown())</span>
					</div>
				}
			}
		</div>
	}
	else
	{
		@{
			var gm = GuildManager.Instance;
			var guild = gm?.Guild;
			var members = gm?.Members ?? new List<GuildMemberInfo>();
			var pendingRequests = gm.IsOfficer ? (gm.JoinRequests ?? new List<GuildJoinRequest>()) : new List<GuildJoinRequest>();
			var raid = gm?.CurrentRaidBoss;
			// rankColor CUT — GuildRankTier reads "Bronze" forever while the
			// arena is dormant (guild-systems-review + brief cuts ledger).
		}

		@if ( raidViewOpen && raid != null && !showRaidTeamSelect && !showRaidBattle )
		{
			<!-- RAID ENCOUNTER — full takeover when monument clicked -->
			@{
				var elementColor = GetElementAccentColor();
			}
			<div class="guild-raid-scene">
				<div class="raid-scene-topbar">
					<!-- Title slab — clean Persona-stamp, no corner-cut decoration -->
					<div class="raid-title-slab">
						<iconify class="raid-title-icon" icon="lucide:swords" Size=@(16) Color="#ef4444" />
						<span class="raid-title-text">@L("ui.guild.tab_raids")</span>
						<span class="raid-title-sep">—</span>
						<span class="raid-title-boss">@raid.BossName</span>
					</div>
					<div class="raid-topbar-spacer"></div>
					<button class="plaza-icon-btn" onclick=@(() => { SoundManager.PlayBack(); raidViewOpen = false; })>
						<iconify icon="lucide:arrow-left" Size=@(16) Color="rgba(255,255,255,0.85)" />
					</button>
				</div>

				<!-- BOSS HERO — Persona-stamp slab. Corner-cut / halftone / BOSS stamp
				     decorations removed for clean slab vocabulary. -->
				<div class="raid-boss-hero p5-stamp" style="border-color: @(elementColor)55">
					<div class="raid-hero-top">
						<div class="raid-hero-sprite-col">
							<div class="raid-boss-sprite" style="background-image: url(@GetRaidBossSpritePath())"></div>
						</div>
						<div class="raid-hero-info-col">
							<span class="raid-boss-name" style="color: @elementColor">@raid.BossName</span>
							<div class="raid-boss-tags">
								<!-- Meta-pill stamps (Persona vocabulary, no rotation) -->
								<div class="raid-stamp-pill element-stamp" style="background-color: @elementColor">
									<span>@raid.BossElement</span>
								</div>
								<div class="raid-stamp-pill level-stamp">
									<span>Lv @raid.BossLevel</span>
								</div>
								<div class="raid-stamp-pill rarity-stamp">
									<span>@GetRaidBossRarity()</span>
								</div>
							</div>
							<div class="raid-desc-row"><span class="raid-boss-desc">@GetRaidBossDescription()</span></div>
							<div class="raid-boss-meta">
								<span class="raid-meta-text">Period @raid.PeriodNumber</span>
								<span class="raid-meta-sep">·</span>
								<span class="raid-meta-text">@L("ui.guild.until_ko")</span>
							</div>
						</div>
					</div>
					<div class="raid-hero-timer">
						<iconify icon="lucide:hourglass" Size=@(14) Color="rgba(255, 200, 100, 0.9)" />
						<span class="raid-timer-label">@L("ui.guild.rotates_in")</span>
						<span class="raid-timer-sep">·</span>
						<span class="raid-timer-value">@FormatRaidTimer() remaining</span>
					</div>
				</div>

				<div class="raid-action-bar p5-stamp">
					<div class="raid-attempts-info">
						<div class="raid-attempt-pips">
							@for ( int i = 0; i < gm.GetRaidAttemptsPerDay(); i++ )
							{
								var used = i < gm.GetRaidAttemptsToday();
								<div class="raid-pip @(used ? "used" : "available")" style="@(!used ? $"border-color: {elementColor}" : "")"></div>
							}
						</div>
						<!-- "X / Y USED" stamp badge — clearer than just dots -->
						<div class="raid-attempts-stamp">
							<span class="raid-attempts-num">@gm.GetRaidAttemptsToday()</span>
							<span class="raid-attempts-sep">/</span>
							<span class="raid-attempts-max">@gm.GetRaidAttemptsPerDay()</span>
							<span class="raid-attempts-tag">USED</span>
						</div>
					</div>
					@if ( gm.CanAttemptRaid() )
					{
						<div class="raid-attack-slab @(raidViewOpen ? "guild-kb-selected" : "")" onclick=@OnAttackRaidBoss>
							<iconify icon="lucide:swords" Size=@(15) Color="#ffffff" />
							<span>@L("ui.guild.attack_boss")</span>
						</div>
					}
					else
					{
						<span class="attempts-exhausted">@L("ui.guild.no_attempts")</span>
					}
				</div>

				<div class="raid-info-columns">
					<div class="raid-combos-card p5-stamp">
						<span class="raid-section-title">@L("ui.guild.combo_bonuses")</span>
						<div class="combo-entry">
							<div class="combo-edge" style="background-color: #ef4444"></div>
							<iconify class="combo-icon" icon="lucide:swords" Size=@(13) Color="#ef4444" /><span class="combo-label">@L("ui.guild.type_advantage")</span><span class="combo-mult">1.5x</span>
						</div>
						<div class="combo-entry">
							<div class="combo-edge" style="background-color: #f59e0b"></div>
							<iconify class="combo-icon" icon="lucide:trending-down" Size=@(13) Color="#f59e0b" /><span class="combo-label">@L("ui.guild.underdog")</span><span class="combo-mult">1.5x</span>
						</div>
						<div class="combo-entry">
							<div class="combo-edge" style="background-color: #22d3ee"></div>
							<iconify class="combo-icon" icon="lucide:link" Size=@(13) Color="#22d3ee" /><span class="combo-label">@L("ui.guild.evolution_chain")</span><span class="combo-mult">1.4x</span>
						</div>
						<div class="combo-entry">
							<div class="combo-edge" style="background-color: #a78bfa"></div>
							<iconify class="combo-icon" icon="lucide:sparkles" Size=@(13) Color="#a78bfa" /><span class="combo-label">@L("ui.guild.elemental_unity")</span><span class="combo-mult">1.3x</span>
						</div>
						<div class="combo-entry">
							<div class="combo-edge" style="background-color: #60a5fa"></div>
							<iconify class="combo-icon" icon="lucide:diamond" Size=@(13) Color="#60a5fa" /><span class="combo-label">@L("ui.guild.rarity_rush")</span><span class="combo-mult">1.25x</span>
						</div>
						<div class="combo-entry">
							<div class="combo-edge" style="background-color: #f472b6"></div>
							<iconify class="combo-icon" icon="lucide:palette" Size=@(13) Color="#f472b6" /><span class="combo-label">@L("ui.guild.diversity")</span><span class="combo-mult">1.2x</span>
						</div>
					</div>
					<div class="raid-personal-card p5-stamp">
						<span class="raid-section-title">@L("ui.guild.your_best")</span>
						@{
							var myBest = GetMyBestRaidScore();
						}
						@if ( myBest != null )
						{
							<span class="personal-score" style="color: @elementColor">@($"{myBest.TotalScore:N0}")</span>
							<div class="personal-detail-row">
								<span class="personal-detail-label">@L("ui.guild.raw_damage")</span>
								<span class="personal-detail-value">@($"{myBest.RawDamage:N0}")</span>
							</div>
							<div class="personal-detail-row">
								<span class="personal-detail-label">@L("ui.guild.combo")</span>
								<span class="personal-detail-value">@($"{myBest.ComboMultiplier:F1}")x</span>
							</div>
							<div class="personal-detail-row">
								<span class="personal-detail-label">@L("ui.guild.rounds_survived")</span>
								<span class="personal-detail-value">@myBest.RoundsUsed</span>
							</div>
						}
						else
						{
							<div class="personal-empty">
								<iconify class="personal-empty-icon" icon="lucide:target" Size=@(28) Color="rgba(255,255,255,0.35)" />
								<span class="personal-empty-text">@L("ui.guild.no_attempts_yet")</span>
								<span class="personal-empty-hint">Attack the boss to set your score!</span>
							</div>
						}
					</div>
				</div>

				<div class="raid-leaderboard-card p5-stamp">
					<div class="raid-lb-header">
						<span class="raid-section-title">@L("ui.guild.guild_leaderboard")</span>
						<span class="raid-lb-total">Total: @($"{raid.GuildTotalScore:N0}")</span>
					</div>
					@{
						var scores = raid.BestScores.Values.OrderByDescending( s => s.TotalScore ).ToList();
					}
					@if ( scores.Count > 0 )
					{
						<div class="raid-lb-list">
							@foreach ( var score in scores )
							{
								var rank = scores.IndexOf( score ) + 1;
								var rankClass = rank == 1 ? "gold" : rank == 2 ? "silver" : rank == 3 ? "bronze" : "";
								<div class="raid-lb-row">
									<span class="raid-lb-rank @rankClass">@rank</span>
									<span class="raid-lb-name">@score.PlayerName</span>
									<span class="raid-lb-combo">@($"{score.ComboMultiplier:F1}")x</span>
									<span class="raid-lb-score">@($"{score.TotalScore:N0}")</span>
								</div>
							}
						</div>
					}
					else
					{
						<span class="raid-lb-empty">@L("ui.guild.no_scores")</span>
					}
				</div>
			</div>
		}
		else if ( showRaidTeamSelect && raid != null )
		{
			<!-- RAID TEAM SELECTION (unchanged from old) -->
			<div class="raid-team-selection">
				<div class="raid-select-header">
					<div class="raid-select-boss">
						<span class="raid-select-boss-name">VS @(raid?.BossName)</span>
						<div class="raid-select-boss-detail">
							<span>@(raid?.BossElement)</span>
							<span class="raid-detail-sep">·</span>
							<span>@($"Lv {raid?.BossLevel}")</span>
							<span class="raid-detail-sep">·</span>
							<span>@L("ui.guild.until_ko")</span>
						</div>
					</div>
					<div class="raid-select-counter">
						<span class="raid-select-counter-num">@raidTeamSelection.Count</span>
						<span class="raid-select-counter-sep">/</span>
						<span class="raid-select-counter-max">3</span>
					</div>
				</div>

				<div class="raid-select-body">
					<div class="raid-select-grid">
						@{ var raidSelKbIdx = 0; }
						@foreach ( var monster in GetRaidAvailableMonsters() )
						{
							var m = monster;
							var inTeam = raidTeamSelection.Contains( m );
							var thisRaidSelIdx = raidSelKbIdx; raidSelKbIdx++;
							<div class="raid-select-option @(inTeam ? "in-team" : "") @(IsRaidSelectKb( thisRaidSelIdx ) ? "guild-kb-selected" : "")">
								<MonsterCard Monster=@m IsCompact=@true AnimateOnHover=@true AnimationFrame=@SpriteAnimator.GlobalFrame
											 ClickAction=@(() => ToggleRaidTeamMember( m )) />
							</div>
						}
					</div>

					<div class="raid-select-sidebar">
						<span class="raid-sidebar-label">@L("ui.guild.raid_team")</span>
						<div class="raid-sidebar-slots">
							@for ( int slotIdx = 0; slotIdx < 3; slotIdx++ )
							{
								var idx = slotIdx;
								var slotMonster = raidTeamSelection.Count > idx ? raidTeamSelection[idx] : null;
								<div class="raid-sidebar-slot @(slotMonster != null ? "filled" : "empty")"
									 onclick=@(() => { if ( slotMonster != null ) { raidTeamSelection.Remove( slotMonster ); SoundManager.PlayBack(); } })>
									@if ( slotMonster != null )
									{
										<MonsterCard Monster=@slotMonster IsCompact=@true AnimationFrame=@SpriteAnimator.GlobalFrame />
									}
									else
									{
										<div class="raid-slot-empty">
											<span class="raid-slot-number">@(idx + 1)</span>
											<span class="raid-slot-label">@L("ui.guild.empty")</span>
										</div>
									}
								</div>
							}
						</div>

						@{
							var comboPreview = GetRaidComboPreview();
						}
						<div class="raid-combo-preview @(comboPreview.Multiplier > 1f ? "active" : "")">
							<span class="raid-combo-label">@L("ui.guild.combo")</span>
							@if ( comboPreview.Multiplier > 1f )
							{
								<span class="raid-combo-name">@comboPreview.ComboName</span>
								<span class="raid-combo-mult">@($"{comboPreview.Multiplier:F1}")x</span>
							}
							else if ( raidTeamSelection.Count < 3 )
							{
								<span class="raid-combo-hint">Pick 3 to see combo</span>
							}
							else
							{
								<span class="raid-combo-hint">@L("ui.guild.no_combo")</span>
							}
						</div>

						<div class="guild-btn raid-attack-btn @(raidTeamSelection.Count < 3 ? "disabled" : "")" onclick=@(() => { if ( raidTeamSelection.Count == 3 ) StartRaidBattle(); })>
							<span>@L("ui.guild.attack_boss")</span>
						</div>
						<div class="guild-btn secondary-btn" onclick=@(() => { showRaidTeamSelect = false; raidTeamSelection.Clear(); SoundManager.PlayBack(); })>
							<span>@L("ui.common.cancel")</span>
						</div>
					</div>
				</div>
			</div>
		}
		else
		{
			<!-- ═══════════════════════════════════════════════════════════════
			     THE GUILD PAGE (2026-08-31 rebuild — guild-mock-page.html).
			     Kin to the hub: ONLINE BLUE chrome, filled #15121f slabs,
			     recessed 36px bands, radius 0 zones, NO hairlines. Guild
			     personality (EmblemColor) lives inside the emblem tile +
			     the [TAG] whisper only.

			     ZONE MAP (1920×1080 design, PADDING-BOX — declared sizes
			     INCLUDE padding, borders add on top):
			       HEADER   1920×110 declared + 2px seam border = 112 visual
			       BODY     pad 16/24/24/24, gap 16 → lanes: 1920−48 = 1872
			         TOP BAND  160: IDENTITY 1088 + 16 gap + ANNOUNCEMENT 768 = 1872 ✓
			         COLUMNS   752: ROSTER 1088 + 16 + right col 768 = 1872 ✓
			                   right col: THE WEEK 336 + 16 + THE LOG 400 = 752 ✓
			       column check: 112 + 16 + 160 + 16 + 752 + 24 = 1080 ✓
			     (The hub suppresses its own .oh-header for this section —
			     OnlineHubPanel.razor, currentSection != "guild".) -->
			@{
				// ── Precomputed zone data (nested calls / ternaries are
				//    Razor-attribute hazards — compute everything up front).
				var gpColor = guild.EmblemColor ?? "#3f8fe0";
				var gpFill = BbEmblem.BlendTowardSlab( gpColor, 0.70f );
				var gpEmblemBeast = BbEmblem.ResolveBeast( guild.EmblemIcon, guild.OwnerSteamId, members );
				var gpEmblemCrop = gpEmblemBeast != null ? BbEmblem.CropStyleFor( gpEmblemBeast, 112, 112 ) : "";
				var gpMembers = GetPlazaRosterMembers( members );
				int gpHere = gm.OnlineCount;
				var gpHereClass = gpHere > 0 ? "gp-here on" : "gp-here";
				// Weekly-XP bars scale to the WEEK'S MAX (honest zeroes render
				// an empty track + "0" — never a fake sliver).
				int gpWeekMax = gpMembers.Count > 0 ? Math.Max( 1, gpMembers.Max( mm => mm.WeeklyGuildXP ) ) : 1;
				var gpTop = GetTopContributor( gpMembers );
				long gpLocalId = (long)(Connection.Local?.SteamId ?? 0);
				bool gpDense = gpMembers.Count >= 12;   // roomy 120px rows → 64px scroll stop at 12+
				var gpGoals = gm.WeeklyGoals ?? new List<GuildWeeklyGoal>();
				var gpLog = (gm.ActivityLog ?? new List<GuildLogEntry>()).OrderByDescending( e => e.Timestamp ).ToList();
				var gpNext = GetNextUnlockPerk();
				int gpActivePerks = GetActivePerkCount();
				long gpXpToNext = Math.Max( 0L, GetGuildXPNeededForNext() - GetGuildXPInLevel() );
				var gpXpLine = gpXpToNext > 0 ? $"{gpXpToNext:N0} XP TO LV {guild.Level + 1}" : "MAX LEVEL";
				// Announcement stone: officers always see it (edit / write-row);
				// plain members only when a MOTD exists — else IDENTITY spans
				// the full 1872 top band.
				bool gpAnnVisible = gm.IsOfficer || !string.IsNullOrEmpty( guild.Motd );
				var gpUnlockName = gpNext != null ? $"{gpNext.Name.ToUpper()} — {gpNext.Short.ToUpper()}" : "ALL PERKS ACTIVE";
				var gpUnlockKick = gpNext != null ? $"NEXT · LV {gpNext.Level}" : "GUILD PERKS";
				var gpLadderChip = $"LV {guild.Level} · {gpActivePerks} ACTIVE";
				// LANE: motion — windowed pop classes (level-up stamp snap /
				// claim flash). Present only inside their ~0.6s windows so
				// kb-remounts and page re-opens replay nothing.
				var gpLvPop = RealTime.Now < _lvPopUntil ? "gp-pop" : "";
				var gpLadderOpen = showPerkLadder ? "open" : "";
			}
			<!-- LANE: input — device-mode root (DOC-5 §5): _gpKbdMode drives
			     .kbd-mode/.mouse-mode; every gp :hover is CSS-gated under
			     .mouse-mode so a parked pointer can't keep a second row lit
			     while the player keyboards. onmousemove is the flip-back-to-
			     mouse edge, GUARDED on >= 3px of real travel since the last
			     keypress (B1, run-2 audit): the engine re-dispatches
			     onmousemove on re-render under a PARKED cursor. -->
			<div class="gp-page @(_gpKbdMode ? "kbd-mode" : "mouse-mode")" onmousemove=@OnGpPageMouseMove>

				<!-- ── HEADER — the hub's .oh-header anatomy wearing the GUILD'S
				     NAME (kicker GUILD → 64px italic-900 title → [TAG] whisper →
				     blue seam slabs → BbHeaderWaves blue → 2px seam strip).
				     Host recipe: waves first child, host paints NO fill.
				     LANE: motion (attached) — gpZoneHeader mount fade, rung 0
				     of the zone cascade (plaza branch mounts fresh per open). -->
				<div class="gp-header">
					<BbHeaderWaves Accent=@("blue") />
					<div class="gp-h-identity">
						<span class="gp-kicker">GUILD</span>
						<div class="gp-title-row">
							<span class="gp-title">@guild.Name</span>
							<div class="gp-tag"><span>[@guild.Tag]</span></div>
							<div class="gp-seam"></div>
							<div class="gp-seam dim"></div>
						</div>
					</div>
					<!-- Right slot (run 2). BACK cap = the hub's .hb-back recipe
					     (30 r11 · italic-900 12 label · 11/800 Q cap — audit S6),
					     then the house header-chip trio (32 r11 slabs; ACTIONS
					     NEVER SKEW): INVITE (officer) · REQUESTS·N (officer, N>0 —
					     scrolls the roster to PENDING) · SETTINGS (everyone: LEAVE
					     GUILD lives in the settings DANGER slab). Chip ids come
					     from GetPlazaChips() — the SAME live list the kb walk
					     counts (stale-map law). In the SETTINGS sub-view the slot
					     holds ONLY BACK TO GUILD · Q. Row math: back 30 + gap 12 +
					     chips (32 each, gaps 12), right pad 32 (header).
					     LANE: input — header chips are the kb walk's first stops;
					     the back caps are mouse-only (Q is the key, already wired). -->
					<div class="gp-toolbar">
						@if ( showSettingsView )
						{
							<div class="gp-back" onmouseover=@(() => SoundManager.PlayHover()) onclick=@OnSettingsBackClicked>
								<span class="gp-back-label">BACK TO GUILD</span>
								<span class="gp-back-cap">Q</span>
							</div>
						}
						else
						{
							<div class="gp-back" onmouseover=@(() => SoundManager.PlayHover()) onclick=@OnBackClicked>
								<span class="gp-back-label">BACK TO HUB</span>
								<span class="gp-back-cap">Q</span>
							</div>
							@{
								var gpChips = GetPlazaChips( gm );
								int gpInviteIdx = gpChips.IndexOf( "invite" );
								int gpRequestsIdx = gpChips.IndexOf( "requests" );
								int gpSettingsChipIdx = gpChips.IndexOf( "settings" );
							}
							@if ( gpInviteIdx >= 0 )
							{
								<div class="gp-chip @(IsPlazaKb( "chips", gpInviteIdx ) ? "guild-kb-selected" : "")" onmouseover=@(() => PlazaHover( "chips", gpInviteIdx )) onclick=@(() => OnInviteClicked())>
									<iconify class="gp-chip-glyph" icon="lucide:user-plus" Size=@(13) Color="#a79dbe" />
									<span class="gp-chip-label">INVITE</span>
								</div>
							}
							@if ( gpRequestsIdx >= 0 )
							{
								<div class="gp-chip @(IsPlazaKb( "chips", gpRequestsIdx ) ? "guild-kb-selected" : "")" onmouseover=@(() => PlazaHover( "chips", gpRequestsIdx )) onclick=@(() => { ScrollRosterToPending(); SoundManager.PlayForward(); })>
									<span class="gp-chip-label">REQUESTS</span>
									<div class="gp-chip-n"><span class="gp-chip-nt">@pendingRequests.Count</span></div>
								</div>
							}
							<div class="gp-chip @(IsPlazaKb( "chips", gpSettingsChipIdx ) ? "guild-kb-selected" : "")" onmouseover=@(() => PlazaHover( "chips", gpSettingsChipIdx )) onclick=@(() => { OpenSettingsView(); SoundManager.PlayClick(); })>
								<iconify class="gp-chip-glyph" icon="lucide:settings" Size=@(13) Color="#a79dbe" />
								<span class="gp-chip-label">SETTINGS</span>
							</div>
						}
					</div>
				</div>

				@if ( showSettingsView )
				{
					<!-- ═══ SETTINGS SUB-VIEW (run 2 — guild-mock-page.html addendum A).
					     The slide-in drawer is dead: settings is a sub-view of the
					     page under the SAME header; the toolbar above holds only
					     BACK TO GUILD · Q. PADDING-BOX zone map (declared sizes
					     INCLUDE padding, borders add):
					       BODY pad 16/24/24/24, gap 16 → lanes 1872 × 928
					         (1080 − 112 header − 16 − 24 = 928)
					       LEFT 1088: IDENTITY 1088×368 + 16 + RECRUITING 1088×544
					                  = 928 ✓ (lands on y 1056)
					       RIGHT 768: DANGER 768×472 (y 128–600) + spacer 408 +
					                  SAVE row 48 (y 1008–1056) = 928 ✓
					                  SAVE 320 right-aligned: x 1896 − 320 = 1576 ✓
					     No name / tag fields (no API). No nav pills, no hint rows.
					     Non-officers: the left slabs render READ-ONLY (.gs-ro) and
					     the SAVE row is absent — DANGER still carries LEAVE.
					     LANE: motion — the four slabs wear the existing gpZone*
					     rungs (band/roster/week/log) on mount; an exit fade and a
					     BACK transition are motion's to dress (the sub-view is an
					     if-mount, so its exit can't animate as built).
					     LANE: input — rows are GetSettingsDrawerRows() ids (color ·
					     beast · description · joinmode · minlevel · danger rows ·
					     save); A/D inside a chip row + HOLD-to-confirm on the
					     danger buttons are input's pass. -->
					@{
						// Preview resolves the PENDING pick exactly as the live
						// emblem will (BbEmblem chain: beast key → the Beastlord's
						// favourite → legacy lucide → shield). Everything the markup
						// needs is computed up front (Razor-attribute hazards).
						var gsBeast = BbEmblem.ResolveBeast( emblemIcon, guild.OwnerSteamId, members );
						var gsFill = BbEmblem.BlendTowardSlab( emblemColor, 0.70f );
						var gsCrop112 = gsBeast != null ? BbEmblem.CropStyleFor( gsBeast, 112, 112 ) : "";
						var gsCrop44 = gsBeast != null ? BbEmblem.CropStyleFor( gsBeast, 44, 44 ) : "";
						var gsChoices = GetEmblemBeastChoices();
						var gsActiveBeastId = ( emblemIcon ?? "" ).StartsWith( "beast:" ) ? emblemIcon.Substring( 6 ) : "";
						int gsActiveTile = gsChoices.FindIndex( s => s.Id == gsActiveBeastId );
						var gsActiveName = gsActiveTile >= 0 ? gsChoices[gsActiveTile].Name.ToUpper() : "";
						var gsNameOffset = $"margin-left: {gsActiveTile * 52}px"; // tile 44 + gap 8
						var gsDescLen = ( settingsDescription ?? "" ).Length;
						var gsCounter = $"{gsDescLen} / 200";
						var gsDirty = SettingsDirty();
						var gsJoinNote = JoinModeNote( settingsJoinMode );
						var gsLevelNote = MinLevelNote( settingsMinLevel );
						bool gsOfficer = gm.IsOfficer;
						var gsRo = gsOfficer ? "" : "gs-ro";
						bool gsCanClaim = gm.CanClaimLeadership();
						bool gsCanTransfer = gm.IsLeader && members.Count > 1;
						var gsDisbandNote = $"deletes {guild.Name} for all {members.Count} members · leader only · no undo";
						var gsSaveTier = gsDirty ? "primary" : "ghost";
						var gsSaveLabel = gsDirty ? "SAVE CHANGES" : "NO CHANGES";
						var gsSaveCap = gsDirty ? "SPACE" : "";
					}
					<div class="gp-body">
						<div class="gs-cols">

							<!-- LEFT 1088 -->
							<div class="gs-left">

								<!-- IDENTITY 1088×368 — band 36 + body (pad 24 L/R, top 24).
								     Body row: 24 + preview col 112 + gap 24 + pick col 904
								     + 24 = 1088 ✓. Pick col: kicker 60–74 · COLOUR chips
								     80–116 (8 × 44×36 r8, gap 8 = 408) · BEAST kicker
								     152–166 · tiles 168–212 (8 × 44×44 r9, gap 8 = 408)
								     · name 222–236 · fallback 264–278 (slab-relative y).
								     Preview col: HERO 112 r12 at y 60 · PREVIEW kicker
								     184 · twin 44 r9 at 204 (the hub guild-zone head). -->
								<div class="gs-ident @gsRo">
									<div class="gp-band">
										<div class="gp-chipstamp"><span>IDENTITY</span></div>
										<div class="gp-band-spacer"></div>
										<div class="gp-darkchip"><span>@(gsOfficer ? "EMBLEM · SAVED WITH THE REST" : "OFFICERS EDIT THESE")</span></div>
									</div>
									<div class="gs-ident-body">
										<div class="gs-preview-col">
											<div class="gs-preview @(gsBeast != null ? "beast-tile" : "")" style="background-color: @gsFill">
												@if ( gsBeast != null )
												{
													<img class="emblem-beast-img" src="@gsBeast.IconPath" style="@gsCrop112" />
												}
												else
												{
													<iconify class="gs-preview-glyph" icon="@GetEmblemIcon( emblemIcon )" Size=@(64) Color="#ffffff" />
												}
											</div>
											<span class="gs-kick dim gs-preview-kick">PREVIEW</span>
											<div class="gs-twin-row">
												<div class="gs-twin @(gsBeast != null ? "beast-tile" : "")" style="background-color: @gsFill">
													@if ( gsBeast != null )
													{
														<img class="emblem-beast-img" src="@gsBeast.IconPath" style="@gsCrop44" />
													}
													else
													{
														<iconify class="gs-twin-glyph" icon="@GetEmblemIcon( emblemIcon )" Size=@(24) Color="#ffffff" />
													}
												</div>
												<div class="gs-twin-note">
													<span class="gs-note">as the hub</span>
													<span class="gs-note">sees it · 44</span>
												</div>
											</div>
										</div>
										<div class="gs-pick-col">
											<span class="gs-kick">COLOUR</span>
											<!-- COLOUR — the tile GROUND behind the beast. Chips are
											     UPRIGHT 44×36 r8 (DOC-6 actions-never-skew: no NEW
											     pressable skews; the two-tone active is the FilterBar
											     family's). LANE: input — A/D walk the chips in-row. -->
											<div class="gs-chips @(IsSettingsRowKb( "color" ) ? "guild-kb-selected" : "")">
												@foreach ( var color in EmblemColors )
												{
													var c = color;
													<div class="gs-cchip @(emblemColor == c ? "on" : "")" onclick=@(() => { emblemColor = c; SoundManager.PlayClick(); })>
														<div class="gs-swatch" style="background-color: @c"></div>
													</div>
												}
												<span class="gs-note gs-row-note">the tile ground behind the beast</span>
											</div>
											<span class="gs-kick gs-kick-beast">BEAST</span>
											<!-- BEAST — THE emblem (EmblemIcon = "beast:<speciesId>").
											     8 species tiles 44×44 r9 (declared 40 + 2px rim), the
											     species sprite as a native-px 40×40 crop (no filter /
											     transform / object-fit). Sources: your roster first,
											     then the members' favourites (GetEmblemBeastChoices). -->
											<div class="gs-chips tiles @(IsSettingsRowKb( "beast" ) ? "guild-kb-selected" : "")">
												@foreach ( var species in gsChoices )
												{
													var s = species;
													var sCrop = BbEmblem.CropStyleFor( s, 40, 40 );
													<div class="gs-btile @(gsActiveBeastId == s.Id ? "on" : "")" onclick=@(() => { emblemIcon = "beast:" + s.Id; SoundManager.PlayClick(); })>
														<img class="emblem-beast-img" src="@s.IconPath" style="@sCrop" />
													</div>
												}
												@if ( gsChoices.Count == 0 )
												{
													<span class="gs-note gs-row-note">no beasts to pick from yet — contract one first</span>
												}
											</div>
											@if ( gsActiveTile >= 0 )
											{
												<div class="gs-bname-host" style="@gsNameOffset"><span class="gs-bname">@gsActiveName</span></div>
											}
											else
											{
												<div class="gs-bname-host"><span class="gs-bname dim">NO PICK</span></div>
											}
											<span class="gs-note gs-fallback">No pick — the Beastlord's favourite shows</span>
										</div>
									</div>
								</div>

								<!-- RECRUITING 1088×544 — band 36 + body (pad 24). Slab-
								     relative y: DESCRIPTION kicker 60–74 · entry 736×240 r8
								     at 80–320 (counter dim bottom-right) · JOIN MODE kicker
								     360–374 · chips 36 at 380–416 · MIN LEVEL kicker 448–462
								     · chips 468–504 · bottom pad 40 → 544 ✓.
								     LANE: input — the description row is a kb STOP that
								     hands focus to the TextEntry (S3, already wired via
								     settingsDescInput); chips A/D in-row. -->
								<div class="gs-recruit @gsRo">
									<div class="gp-band">
										<div class="gp-chipstamp"><span>RECRUITING</span></div>
										<div class="gp-band-spacer"></div>
									</div>
									<div class="gs-recruit-body">
										<div class="gs-kick-row">
											<span class="gs-kick">DESCRIPTION</span>
											<span class="gs-note">what tamers read before they ask to join</span>
										</div>
										<div class="gs-entry-wrap @(IsSettingsRowKb( "description" ) ? "guild-kb-selected" : "")">
											<TextEntry class="gs-desc-input" @ref="settingsDescInput" Text=@settingsDescription Placeholder="Pitch your guild to recruits…" Multiline=@(true) MaxLength=@(200) />
											<div class="gs-counter"><span class="gs-counter-t">@gsCounter</span></div>
										</div>
										<div class="gs-kick-row gs-gap-join">
											<span class="gs-kick">JOIN MODE</span>
										</div>
										<div class="gs-chips @(IsSettingsRowKb( "joinmode" ) ? "guild-kb-selected" : "")">
											@foreach ( var joinMode in JoinModeChips )
											{
												var mode = joinMode;
												<div class="gs-tchip @(settingsJoinMode == mode ? "on" : "")" onclick=@(() => { settingsJoinMode = mode; SoundManager.PlayClick(); })>
													<span class="gs-tchip-t">@JoinModeLabel( mode )</span>
												</div>
											}
											<span class="gs-note gs-row-note">@gsJoinNote</span>
										</div>
										<div class="gs-kick-row gs-gap-level">
											<span class="gs-kick">MIN LEVEL</span>
										</div>
										<div class="gs-chips @(IsSettingsRowKb( "minlevel" ) ? "guild-kb-selected" : "")">
											@foreach ( var level in MinLevelChips )
											{
												var lvl = level;
												<div class="gs-tchip lvl @(settingsMinLevel == lvl ? "on" : "")" onclick=@(() => { settingsMinLevel = lvl; SoundManager.PlayClick(); })>
													<span class="gs-tchip-t">@lvl</span>
												</div>
											}
											<span class="gs-note gs-row-note">@gsLevelNote</span>
										</div>
									</div>
								</div>
							</div>

							<!-- RIGHT 768 — DANGER at the top, SAVE at the foot; the
							     middle is deliberately EMPTY (danger far from the primary). -->
							<div class="gs-right">

								<!-- DANGER 768×472 — band 36 + pad 24 + 4 rows × 88 + 3 × 12
								     + pad 24 = 472 ✓. Row: text col (title 17/800 + note
								     12/700 dim) · spacer · BbButton danger 320×44 r11 + HOLD
								     cap. CLAIM is CONDITIONAL (absent, not disabled).
								     LANE: input — HOLD-to-confirm (~0.9s, the skills-reset
								     grammar) replaces the ConfirmDialog calls below; until
								     then the dialogs keep every action working. -->
								<div class="gs-danger">
									<div class="gp-band">
										<div class="gp-chipstamp danger"><span>DANGER</span></div>
										<div class="gp-band-spacer"></div>
									</div>
									<div class="gs-danger-body">
										@if ( gsCanClaim )
										{
											<div class="gs-drow">
												<div class="gs-drow-text">
													<span class="gs-dtitle">CLAIM LEADERSHIP</span>
													<span class="gs-dnote">Beastlord away 30+ days · you're the highest rank online</span>
												</div>
												<div class="gs-drow-spacer"></div>
												<BbButton Tier="danger" Size=@(44) Label="CLAIM LEADERSHIP" HoldToConfirm=@true Class="gs-dbtn" HoverSound=@false Focused=@(IsSettingsRowKb( "claim" )) OnClick=@OnClaimPressed />
											</div>
										}
										@if ( gsCanTransfer )
										{
											<div class="gs-drow">
												<div class="gs-drow-text">
													<span class="gs-dtitle">TRANSFER LEADERSHIP</span>
													<span class="gs-dnote">hand the Beastlord role to another member · leader only</span>
												</div>
												<div class="gs-drow-spacer"></div>
												<BbButton Tier="danger" Size=@(44) Label="TRANSFER" HoldToConfirm=@true Class="gs-dbtn" HoverSound=@false Focused=@(IsSettingsRowKb( "transfer" )) OnClick=@OnTransferPressed />
											</div>
										}
										<div class="gs-drow">
											<div class="gs-drow-text">
												<span class="gs-dtitle">LEAVE GUILD</span>
												<span class="gs-dnote">you keep your Beasts and gold · your weekly XP stays with the guild</span>
											</div>
											<div class="gs-drow-spacer"></div>
											<BbButton Tier="danger" Size=@(44) Label="LEAVE GUILD" HoldToConfirm=@true Class="gs-dbtn" HoverSound=@false Focused=@(IsSettingsRowKb( "leave" )) OnClick=@OnLeavePressed />
										</div>
										@if ( gm.IsLeader )
										{
											<div class="gs-drow">
												<div class="gs-drow-text">
													<span class="gs-dtitle">DISBAND</span>
													<span class="gs-dnote">@gsDisbandNote</span>
												</div>
												<div class="gs-drow-spacer"></div>
												<BbButton Tier="danger" Size=@(44) Label="DISBAND" HoldToConfirm=@true Class="gs-dbtn" HoverSound=@false Focused=@(IsSettingsRowKb( "disband" )) OnClick=@OnDisbandPressed />
											</div>
										}
									</div>
								</div>

								<div class="gs-right-spacer"></div>

								@if ( gsOfficer )
								{
									<!-- SAVE 320×48 r16 — the view's ONE gold primary, right-
									     aligned at the column's foot. ONE BbButton whose tier /
									     label / cap swap by attribute (no if-swap ghosting):
									     dirty → gold SAVE CHANGES + SPACE cap; clean → ghost
									     NO CHANGES, disabled. Fires SaveSettingsAndClose (the
									     one save path). -->
									<div class="gs-save-row">
										<BbButton Tier=@gsSaveTier Size=@(44) Label=@gsSaveLabel KeyCap=@gsSaveCap Disabled=@(!gsDirty) Class="gs-save" HoverSound=@false Focused=@(IsSettingsRowKb( "save" )) OnClick=@OnSavePressed />
									</div>
								}
							</div>
						</div>
					</div>
				}
				else
				{
				<div class="gp-body">

					<!-- ── TOP BAND 1872×160 — IDENTITY left, ANNOUNCEMENT right.
					     IDENTITY row math (1088, pad 16 L/R): 16 + emblem 112 +
					     gap 20 + mid 560 + spacer(≥28) + chip 336 + 16 = 1088 ✓
					     When the stone hides, .full = 1872 and the spacer grows. -->
					<div class="gp-top-band">
						<div class="gp-ident @(gpAnnVisible ? "" : "full")">
							<!-- HERO emblem — the framed-tile recipe (112×112 r12,
							     fill = BlendTowardSlab(EmblemColor, .70), native-px
							     sprite crop; no filter / transform / object-fit). -->
							<div class="gp-emblem @(gpEmblemBeast != null ? "beast-tile" : "")" style="background-color: @gpFill">
								@if ( gpEmblemBeast != null )
								{
									<img class="emblem-beast-img" src="@gpEmblemBeast.IconPath" style="@gpEmblemCrop" />
								}
								else
								{
									<iconify class="gp-emblem-glyph" icon="@GetEmblemIcon( guild.EmblemIcon )" Size=@(64) Color="#ffffff" />
								}
							</div>
							<div class="gp-ident-mid">
								<div class="gp-ident-row">
									<!-- LV stamp — non-interactive identity mark (skew OK).
									     LANE: motion — gp-pop = Tier-3 gold stamp snap on a
									     GuildLevel edge (windowed in Tick). -->
									<div class="gp-lv-stamp @gpLvPop"><span>@($"LV {guild.Level}")</span></div>
									<span class="gp-members-line">@($"{members.Count} MEMBERS ·")</span>
									<span class="@gpHereClass">@($"{gpHere} HERE")</span>
								</div>
								<!-- ONE XP bar (440×10) + ONE rounded number — the
								     shipped "92.64909%" double readout dies here. -->
								<div class="gp-xp-bar"><div class="gp-xp-fill" style="width: @(GuildXpBarPx())px"></div></div>
								<span class="gp-xp-line">@gpXpLine</span>
							</div>
							<div class="gp-ident-spacer"></div>
							<!-- NEXT-UNLOCK chip 336×92 r11 — PRESSABLE, opens the
							     PERK LADDER. Names only perks that WORK (honesty
							     rule — Lv20 unwired / Lv25+45 raid-gated / Lv40+50
							     copy-only are absent from WiredPerks).
							     LANE: input — Space/E opens; a W/S stop (zone "unlock"). -->
							<div class="gp-unlock @(IsPlazaKb( "unlock", 0 ) ? "guild-kb-selected" : "")" onmouseover=@(() => PlazaHover( "unlock", 0 )) onclick=@(() => { showPerkLadder = true; SoundManager.PlayForward(); })>
								<span class="gp-unlock-kick">@gpUnlockKick</span>
								<span class="gp-unlock-name">@gpUnlockName</span>
								<div class="gp-unlock-foot">
									<span class="gp-unlock-count">@($"{gpActivePerks} PERKS ACTIVE ·")</span>
									<span class="gp-unlock-view">VIEW ALL</span>
									<iconify class="gp-unlock-arrow" icon="lucide:chevron-right" Size=@(12) Color="#6fb1f0" />
								</div>
							</div>
						</div>

						@if ( gpAnnVisible )
						{
							<!-- ── ANNOUNCEMENT 768×160 — the officer's voice.
							     Existing MOTD edit plumbing, inline pencil. No
							     byline: the server stores neither author nor
							     write-time for the MOTD (render nothing, honest). -->
							<div class="gp-ann">
								<div class="gp-band">
									<div class="gp-chipstamp"><span>ANNOUNCEMENT</span></div>
									<div class="gp-band-spacer"></div>
									@if ( gm.IsOfficer && !editingMotd && !string.IsNullOrEmpty( guild.Motd ) )
									{
										<!-- LANE: input — the "info" zone's one stop -->
										<div class="gp-ann-edit @(IsPlazaKb( "info", 0 ) ? "guild-kb-selected" : "")" onmouseover=@(() => PlazaHover( "info", 0 )) onclick=@(() => { StartEditMotd(); SoundManager.PlayClick(); })>
											<iconify class="gp-pi" icon="lucide:pencil" Size=@(12) Color="rgba(244, 241, 234, 0.6)" />
										</div>
									}
								</div>
								<div class="gp-ann-body">
									@if ( editingMotd )
									{
										<TextEntry class="gp-ann-input" @ref="motdDraftInput" Text=@motdDraft />
										<!-- LANE: input — the entry takes focus on open (S4 latch).
										     While typing: Enter SAVES (onsubmit), Esc/Tab hand the
										     keyboard back (cursor on Save). Then A/D walk
										     Save↔Cancel, Space/Enter/E fires, Q cancels, W climbs
										     back into the text box (TickEditorInput). -->
										<div class="gp-ann-actions">
											<div class="guild-btn accept-btn @(IsMotdEditorKb( 0 ) ? "guild-kb-selected" : "")" onmouseover=@(() => MotdEditorHover( 0 )) onclick=@(() => { SaveMotd(); SoundManager.PlaySuccess(); })><span>@L("ui.guild.save")</span></div>
											<div class="guild-btn deny-btn @(IsMotdEditorKb( 1 ) ? "guild-kb-selected" : "")" onmouseover=@(() => MotdEditorHover( 1 )) onclick=@CancelMotd><span>@L("ui.common.cancel")</span></div>
										</div>
									}
									else if ( !string.IsNullOrEmpty( guild.Motd ) )
									{
										<span class="gp-ann-text">@guild.Motd</span>
									}
									else
									{
										<!-- officer empty state — the slim write-row
										     (plain members never see the stone) -->
										<div class="gp-ann-empty @(IsPlazaKb( "info", 0 ) ? "guild-kb-selected" : "")" onmouseover=@(() => PlazaHover( "info", 0 )) onclick=@(() => { StartEditMotd(); SoundManager.PlayClick(); })>
											<iconify class="gp-pi" icon="lucide:pencil" Size=@(12) Color="rgba(244, 241, 234, 0.6)" />
											<span class="gp-ann-empty-t">Write an announcement</span>
										</div>
									}
								</div>
							</div>
						}
					</div>

					<!-- ── COLUMNS 1872×752 ── -->
					<div class="gp-cols">

						<!-- ROSTER 1088×752 — the heart, expanded. Band 36 (opaque,
						     gap 0 to the list — scroll-leak law). Rows are DIRECT
						     children of the scroll child. Row math (roomy): band 36
						     + pad 18 + 5×120 + 4×20 + pad 18 = 752 ✓ at 5 members.
						     Row lane: list pad 12 L/R → 1064; row 1060 declared +
						     4px left seam border = 1064 ✓.
						     LANE: motion (attached) — zone fade rung 2 (gpZoneRoster);
					     rows get NO per-row cascade: guild-kb-selected is
					     volatile → class change = remount = the entrance would
					     replay on every cursor hop (DOC-4 §14). Scrollbar =
					     .gp-sb opacity arm/fade + hover thumb brighten. -->
						<div class="gp-roster">
							<div class="gp-band">
								<div class="gp-chipstamp"><span>ROSTER</span></div>
								<div class="gp-band-spacer"></div>
								<div class="gp-darkchip"><span>@($"{members.Count} / {gm.GetMaxMembers()}")</span></div>
							</div>
							<div class="gp-roster-list @(gpDense ? "dense" : "")" @ref="rosterScrollRef">
								@{
									int gpRosterIdx = 0;
									// PENDING (run 2 — addendum B): officers only, N>0; at
									// N = 0 the section is ABSENT (not empty), and the roomy
									// 752 math below holds untouched.
									bool gpShowPending = gm.IsOfficer && pendingRequests.Count > 0;
								}
								@if ( gpShowPending )
								{
									<!-- PENDING — the requests modal is dead; requests are rows
									     in the roster's own recipe, pinned at the TOP of the
									     list. FLAT-CHILDREN LAW: the two kicker rows and every
									     pending row are DIRECT children of the scroll child.
									     Kicker row 1064×24 · rows 1060 + 4 seam = 1064, 72 tall,
									     gap 8: 16 pad + head 44 + 20 + text 400 + spacer 356
									     + ACCEPT 104 + 16 + DENY 88 + 16 pad = 1060 ✓.
									     LANE: input — pending rows are cursor stops (W/S rows,
									     A/D ACCEPT↔DENY, Space = ACCEPT); REQUESTS·N seats the
									     cursor on the first pending row.
									     LANE: motion — NO entrance ladder (volatile rows: they
									     leave on accept/deny); a Tier-2 fold-into-MEMBERS on
									     accept and a collapse on deny are motion's. -->
									<div class="gp-rkick">
										<span class="gp-rkick-t">@($"PENDING · {pendingRequests.Count}")</span>
										<span class="gp-rkick-x">officers only — accept or deny</span>
									</div>
									@{ int gpPendIdx = 0; }
									@foreach ( var request in pendingRequests )
									{
										var r = request;
										var pIdx = gpPendIdx; gpPendIdx++;
										var pSub = $"LV {r.Level} · asked {FormatAskedAgo( r.RequestedAt )}";
										<div class="gp-prow @(pIdx % 2 == 1 ? "alt" : "")">
											<div class="gp-head">
												@if ( r.SteamId > 0 )
												{
													<img class="gp-head-img" src="@($"avatar:{r.SteamId}")" />
												}
												else
												{
													<iconify class="gp-head-glyph" icon="lucide:user-round" Size=@(18) Color="rgba(214, 206, 236, 0.55)" />
												}
											</div>
											<div class="gp-prow-text">
												<span class="gp-mname">@r.PlayerName</span>
												<span class="gp-prow-sub">@pSub</span>
											</div>
											<div class="gp-prow-spacer"></div>
											<BbButton Tier="secondary" Size=@(34) Label="ACCEPT" Class="gp-pacc" HoverSound=@false OnClick=@(() => { gm.ApproveJoinRequest( r ); SoundManager.PlaySelect(); }) />
											<BbButton Tier="ghost" Size=@(34) Label="DENY" Class="gp-pdeny" HoverSound=@false OnClick=@(() => { gm.DenyJoinRequest( r ); SoundManager.PlayDeny(); }) />
										</div>
									}
									<div class="gp-rkick dim">
										<span class="gp-rkick-t">@($"MEMBERS · {members.Count}")</span>
									</div>
								}
								@foreach ( var member in gpMembers )
								{
									var m = member;
									var mIdx = gpRosterIdx; gpRosterIdx++;
									var mRoleColor = GuildManager.GetRoleColor( m.Role );
									var mIsYou = m.SteamId == gpLocalId && gpLocalId > 0;
									var mNew = (DateTime.UtcNow - m.JoinedAt).TotalDays < 7.0;
									var mGone = !m.IsOnline && (DateTime.UtcNow - m.LastSeen).TotalDays >= 30.0;
									var mTopContrib = gpTop != null && m.SteamId == gpTop.SteamId && m.WeeklyGuildXP > 0;
									var mVoice = IsMemberInVoice( m );
									var mWeekPx = RosterWeekBarPx( m.WeeklyGuildXP, gpWeekMax );
									var mRoleText = m.Role >= GuildRole.Warden ? GuildManager.GetRoleDisplayName( m.Role ).ToUpper() : "";
									<!-- LANE: input — row click/Space = member action modal (kept).
									     Hover moves the ONE cursor (PlazaHover — one-cursor law);
									     the old hoveredMember side-state is retired. -->
									<div class="gp-mrow @(mIdx % 2 == 1 ? "alt" : "") @(mGone ? "faded" : "") @(IsPlazaKb( "roster", mIdx ) ? "guild-kb-selected" : "")"
										 onmouseover=@(() => PlazaHover( "roster", mIdx ))
										 onclick=@(() => { OpenMemberMenu( m ); SoundManager.PlayClick(); })>
										<div class="gp-head" style="border-color: @mRoleColor">
											@if ( m.SteamId > 0 )
											{
												<img class="gp-head-img" src="@($"avatar:{m.SteamId}")" />
											}
											else
											{
												<iconify class="gp-head-glyph" icon="lucide:user-round" Size=@(18) Color="rgba(214, 206, 236, 0.55)" />
											}
										</div>
										<div class="gp-mname-col">
											<div class="gp-mname-row">
												<span class="gp-mname">@m.Name</span>
												@if ( mIsYou )
												{
													<div class="gp-you"><span class="gp-you-t">YOU</span></div>
												}
												@if ( mNew )
												{
													<div class="gp-newtag"><span class="gp-new-t">NEW</span></div>
												}
												@if ( mVoice )
												{
													<iconify class="gp-voice" icon="lucide:volume-2" Size=@(14) Color="#4ade80" />
												}
											</div>
											@if ( mRoleText != "" )
											{
												<span class="gp-mrole" style="color: @mRoleColor">@mRoleText</span>
											}
										</div>
										<div class="gp-mweek-col">
											<span class="gp-mweek-cap">WEEKLY GUILD XP</span>
											<div class="gp-mweek-row">
												<span class="gp-mweek-val @(m.WeeklyGuildXP == 0 ? "zero" : "")">@($"{m.WeeklyGuildXP:N0}")</span>
												@if ( mTopContrib )
												{
													<iconify class="gp-crown" icon="lucide:crown" Size=@(13) Color="#ffce3a" />
												}
											</div>
											<div class="gp-mweek-bar"><div class="gp-mweek-fill" style="width: @(mWeekPx)px"></div></div>
										</div>
										<div class="gp-mrow-spacer"></div>
										@if ( m.IsOnline )
										{
											<div class="gp-presence on"><div class="gp-dot"></div><span class="gp-presence-t">HERE</span></div>
										}
										else
										{
											<div class="gp-presence"><span class="gp-presence-t">@FormatLastSeenShort( m.LastSeen )</span></div>
										}
									</div>
								}
							</div>
							<!-- slim overlay scrollbar — imperative px thumb (the
							     Beastbook recipe); geometry written per tick. -->
							<div @ref="rosterSbTrackRef" class="gp-sb"><div @ref="rosterSbThumbRef" class="gp-sb-thumb"></div></div>
						</div>

						<!-- RIGHT COLUMN 768×752 -->
						<div class="gp-right">

							@if ( raid != null )
							{
								<!-- RAID MONUMENT — kept coded, renders NOTHING while
								     RaidsEnabled=false (raid is null). When raids flip
								     on, this block re-appears above THE WEEK and the
								     column compresses (a future pass re-derives the
								     752 split). -->
								<div class="raid-monument" onclick=@(() => { SoundManager.PlayForward(); raidViewOpen = true; })>
									<div class="raid-monument-header">
										<iconify icon="lucide:swords" Size=@(13) Color="#fca5a5" />
										<span class="raid-monument-title">RAID</span>
									</div>
									<div class="raid-monument-content">
										<div class="raid-monument-sprite" style="background-image: url(@GetRaidBossSpritePath())"></div>
										<div class="raid-monument-info">
											<span class="raid-monument-name">@raid.BossName</span>
											<span class="raid-monument-element">@raid.BossElement · Lv @raid.BossLevel</span>
										</div>
									</div>
									<div class="raid-monument-cta">
										<span>ENTER</span>
										<iconify icon="lucide:arrow-right" Size=@(13) Color="#ffffff" />
									</div>
								</div>
							}

							<!-- THE WEEK 768×336 — unmissable. Band 36 (big chip) +
							     3 goal rows. Row math: band 36 + pad 12 + 3×82 +
							     2×8 + pad 26 = 336 ✓. Goal lane: 768 − 32 = 736;
							     bar 480×8 px-fill (GoalBarPx pattern — percent
							     widths on absolute children paint full-width). -->
							<div class="gp-week">
								<div class="gp-band">
									<div class="gp-chipstamp big"><span>THE WEEK</span></div>
									<div class="gp-band-spacer"></div>
									<div class="gp-darkchip"><span>@FormatGoalReset()</span></div>
								</div>
								<div class="gp-week-body" @ref="weekBodyRef">
									@if ( gpGoals.Count == 0 )
									{
										<span class="gp-week-empty">No goals this week.</span>
									}
									@{ int gpGoalIdx = 0; }
									@foreach ( var goal in gpGoals )
									{
										var g = goal;
										var gIdx = gpGoalIdx; gpGoalIdx++;
										var gClaimable = g.Completed && !g.Claimed;
										// LANE: motion — windowed claim-flash class (set by
										// ClaimGoalWithPop; absent outside the window).
										var gPop = (_claimPopGoalId != null && g.Id == _claimPopGoalId && RealTime.Now < _claimPopUntil) ? "gp-pop" : "";
										<div class="gp-goal @gPop @(IsPlazaKb( "week", gIdx ) ? "guild-kb-selected" : "")" onmouseover=@(() => PlazaHover( "week", gIdx ))>
											<div class="gp-goal-top">
												<span class="gp-goal-name">@(g.Title?.ToUpper())</span>
												<div class="gp-goal-spacer"></div>
												<span class="gp-goal-count">@($"{g.Progress:N0} / {g.Target:N0}")</span>
											</div>
											<span class="gp-goal-blurb">@GoalBlurb( g )</span>
											<div class="gp-goal-foot">
												<div class="gp-goal-bar"><div class="gp-goal-fill" style="width: @(WeekGoalBarPx( g ))px"></div></div>
												<div class="gp-goal-spacer"></div>
												@if ( gClaimable )
												{
													<span class="gp-goal-xp gold">@($"+{g.XpReward:N0} XP")</span>
													<!-- gold = the page's ONLY gold (primary law).
													     LANE: motion (attached) — ClaimGoalWithPop keys the
													     row's Tier-2 flash (0.3s) + success sound; press =
													     darker gradient (:active). CLAIM is a sanctioned
													     gold moment (claiming the reward IS the commit).
													     LANE: input — Space claims on the focused row. -->
													<div class="gp-claim" onclick=@(() => ClaimGoalWithPop( g ))><span class="gp-claim-t">CLAIM</span></div>
												}
												else if ( g.Claimed )
												{
													<span class="gp-goal-xp done">CLAIMED</span>
												}
												else
												{
													<span class="gp-goal-xp">@($"+{g.XpReward:N0} XP")</span>
												}
											</div>
										</div>
									}
								</div>
							</div>

							<!-- THE LOG 768×400 — GuildManager.ActivityLog rendered
							     at last (parsed on every fetch, cap 50). Newest
							     first; ~8 rows visible (band 36 + pad 10 + 8×38 +
							     7×2 = 364 ≤ 400), the rest scroll. OnLogUpdated →
							     OnRefresh → StateHasChanged (already subscribed).
							     LANE: motion (attached) — zone fade rung 4 +
							     gpLogRow0–7 percentage-ladder row cascade (log rows
							     carry no volatile classes, so mount keyframes are
							     safe); scrollbar arm/fade + hover thumb brighten. -->
							<div class="gp-log">
								<div class="gp-band">
									<div class="gp-chipstamp"><span>THE LOG</span></div>
								</div>
								@if ( gpLog.Count == 0 )
								{
									<div class="gp-log-empty"><span>Nothing logged yet — the week is young.</span></div>
								}
								else
								{
									<!-- LANE: input — log rows are the walk's last stops (zone
									     "log": info focus, Space no-op). The cursor class is
									     stamped IMPERATIVELY (SyncLogCursorClasses / SetClass)
									     — a volatile markup class would remount the row and
									     replay its gpLogRowN entrance ladder on every hop. -->
									<div class="gp-log-list" @ref="logScrollRef">
										@{ int gpLogRowIdx = 0; }
										@foreach ( var entry in gpLog )
										{
											var e = entry;
											var lIdx = gpLogRowIdx; gpLogRowIdx++;
											<div class="gp-lrow @(lIdx % 2 == 1 ? "alt" : "")" onmouseover=@(() => PlazaHover( "log", lIdx ))>
												@if ( !string.IsNullOrEmpty( e.PlayerName ) )
												{
													<span class="gp-log-actor">@e.PlayerName</span>
												}
												<span class="gp-log-text">@LogActionText( e )</span>
												<div class="gp-lrow-spacer"></div>
												<span class="gp-log-time">@FormatLogTimeShort( e.Timestamp )</span>
											</div>
										}
									</div>
									<div @ref="logSbTrackRef" class="gp-sb"><div @ref="logSbThumbRef" class="gp-sb-thumb"></div></div>
								}
							</div>
						</div>
					</div>
				</div>
				}

				<!-- ── PERK LADDER — the next-unlock chip, pressed. Centered
				     via FLEX on the root (never translate(-50%) — transform
				     poisons descendant flex). Lists every WIRED stop only:
				     LV 5/10/15/30/35 — LV 20/25/40/45/50 render NOTHING
				     (honesty rule). Modal math: band 36 + pad 16 + 5×56 +
				     4×8 + pad 16 = 380 tall, 560 wide (rows 528).
				     LANE: input — Q closes (wired below); W/S walk = info
				     rows, no press stamp. LANE: motion (attached) — ALWAYS
				     MOUNTED + .open class toggle (the class-toggle recipe) so
				     the opacity fade replays every open AND close animates
				     (0.2s in / 0.12s out; a fresh if-mount can't animate its
				     exit). Closed = opacity 0 + pointer-events none. -->
				<div class="gp-ladder-root @gpLadderOpen" onclick=@(() => { showPerkLadder = false; SoundManager.PlayBack(); })>
						<div class="gp-ladder" onclick:stopPropagation>
							<div class="gp-band">
								<div class="gp-chipstamp"><span>GUILD PERKS</span></div>
								<div class="gp-band-spacer"></div>
								<div class="gp-darkchip"><span>@gpLadderChip</span></div>
							</div>
							<!-- LANE: input — W/S walk the perk rows (info stops, no press);
							     hover moves the same cursor. Space/Enter/E/Q close. -->
							<div class="gp-ladder-body">
								@{ int gpPkIdx = 0; }
								@foreach ( var wp in WiredPerks )
								{
									var wpUnlocked = guild.Level >= wp.Level;
									var wpNext = gpNext != null && wp.Level == gpNext.Level;
									var wpIdx = gpPkIdx; gpPkIdx++;
									<div class="gp-pk @(wpUnlocked ? "" : "dim") @(IsLadderKb( wpIdx ) ? "guild-kb-selected" : "")" onmouseover=@(() => LadderHover( wpIdx ))>
										<span class="gp-pk-lv">@($"LV {wp.Level}")</span>
										<div class="gp-pk-col">
											<span class="gp-pk-name">@wp.Name.ToUpper()</span>
											<span class="gp-pk-effect">@wp.Effect</span>
										</div>
										<div class="gp-pk-spacer"></div>
										@if ( wpNext )
										{
											<div class="gp-pk-next"><span>NEXT</span></div>
										}
									</div>
								}
							</div>
						</div>
					</div>
			</div>
		}

		<!-- MEMBER ACTION MODAL — promote/demote/kick (officer-only) on member click -->
		@if ( showMemberMenu && selectedMember != null )
		{
			@{
				var sm = selectedMember;
				var canManage = gm.IsOfficer && sm.SteamId != (Connection.Local?.SteamId ?? 0) && sm.Role < gm.Membership.Role;
			}
			<div class="confirm-overlay" onclick=@(() => { showMemberMenu = false; selectedMember = null; })>
				<div class="member-menu" onclick:stopPropagation>
					<div class="member-menu-header">
						<div class="member-menu-portrait" style="border-color: @GuildManager.GetRoleColor( sm.Role )">
							<iconify icon="@GetAvatarIcon( sm )" Size=@(32) Color="@GuildManager.GetRoleColor( sm.Role )" />
						</div>
						<div class="member-menu-info">
							<span class="member-menu-name">@sm.Name</span>
							<span class="member-menu-role" style="color: @GuildManager.GetRoleColor( sm.Role )">@GuildManager.GetRoleDisplayName( sm.Role )</span>
							<span class="member-menu-stats">Lv @sm.Level · @sm.ArenaRank · @sm.ArenaPoints RP</span>
						</div>
					</div>
					<div class="member-menu-actions">
						@{ var menuKbIdx = 0; }
						@if ( canManage && gm.IsLeader && sm.Role < GuildRole.Warden )
						{
							var promoteIdx = menuKbIdx; menuKbIdx++;
							<button class="member-menu-action @(IsMemberMenuKb( promoteIdx ) ? "guild-kb-selected" : "")" onclick=@(() => { gm.PromoteMember( sm.SteamId ); SoundManager.PlaySelect(); showMemberMenu = false; selectedMember = null; })>
								<iconify icon="lucide:chevron-up" Size=@(14) Color="#4ade80" />
								<span>Promote</span>
							</button>
						}
						@if ( canManage && gm.IsLeader && sm.Role > GuildRole.Wanderer && sm.Role < GuildRole.Beastlord )
						{
							var demoteIdx = menuKbIdx; menuKbIdx++;
							<button class="member-menu-action @(IsMemberMenuKb( demoteIdx ) ? "guild-kb-selected" : "")" onclick=@(() => { gm.DemoteMember( sm.SteamId ); SoundManager.PlayClick(); showMemberMenu = false; selectedMember = null; })>
								<iconify icon="lucide:chevron-down" Size=@(14) Color="#fbbf24" />
								<span>Demote</span>
							</button>
						}
						@if ( canManage )
						{
							var kickIdx = menuKbIdx; menuKbIdx++;
							<button class="member-menu-action danger @(IsMemberMenuKb( kickIdx ) ? "guild-kb-selected" : "")" onclick=@(() => { ConfirmKick( sm ); SoundManager.PlayPopup(); showMemberMenu = false; selectedMember = null; })>
								<iconify icon="lucide:user-x" Size=@(14) Color="#f87171" />
								<span>Kick</span>
							</button>
						}
						@{ var closeIdx = menuKbIdx; menuKbIdx++; }
						<button class="member-menu-action @(IsMemberMenuKb( closeIdx ) ? "guild-kb-selected" : "")" onclick=@(() => { showMemberMenu = false; selectedMember = null; })>
							<iconify icon="lucide:x" Size=@(14) Color="rgba(255,255,255,0.6)" />
							<span>Close</span>
						</button>
					</div>
				</div>
			</div>
		}


		<!-- Raid Battle Overlay -->
		@if ( showRaidBattle )
		{
			<div class="raid-battle-container">
				<BattleView IsRaidBattle=@true OnBattleEnd=@OnRaidBattleComplete />
			</div>
		}

		<!-- Confirm Dialog -->
		@* Confirm dialogs use shared <ConfirmDialog> component (mounted globally in GameHUD) *@

		<!-- Raid Results Overlay -->
		@if ( showRaidResults )
		{
			<div class="confirm-overlay">
				<div class="raid-results-card">
					<span class="raid-results-title">Raid Complete!</span>
					<div class="raid-result-row">
						<span class="raid-result-label">Raw Damage</span>
						<span class="raid-result-value">@($"{raidResultDamage:N0}")</span>
					</div>
					<div class="raid-result-row">
						<span class="raid-result-label">Combo: @raidResultComboName</span>
						<span class="raid-result-value">@($"{raidResultComboMultiplier:F1}")x</span>
					</div>
					<div class="raid-result-total">
						<span class="raid-result-label">Total Score</span>
						<span class="raid-result-score">@($"{raidResultScore:N0}")</span>
					</div>
					<div class="guild-btn raid-attack-btn" onclick=@(() => showRaidResults = false)>
						<span>Continue</span>
					</div>
				</div>
			</div>
		}

		<!-- Picker Overlay -->
		@if ( showPicker )
		{
			<div class="confirm-overlay" onclick=@(() => { ClosePicker(); })>
				<div class="picker-dialog" onclick:stopPropagation>
					<div class="picker-header-row">
						@{ var pickerIcon = pickerMode == "invite" ? "lucide:user-plus" : "lucide:shield-check"; }
						<iconify icon="@pickerIcon" Size=@(15) Color="#fbbf24" />
						<span class="picker-title">@pickerTitle</span>
						<button class="settings-modal-close picker-close-btn" onclick=@(() => ClosePicker())>
							<iconify icon="lucide:x" Size=@(14) Color="rgba(255,255,255,0.7)" />
						</button>
					</div>
					<div class="picker-list">
						@if ( pickerMode == "invite" )
						{
							@{
								var candidates = GuildManager.Instance?.GetInvitableCandidates() ?? Enumerable.Empty<InviteCandidate>();
							}
							@if ( !candidates.Any() )
							{
								<span class="picker-empty">No players available to invite</span>
							}
							@{ var pickerKbIdx = 0; }
							@foreach ( var c in candidates )
							{
								var cRef = c;
								var thisPickerIdx = pickerKbIdx; pickerKbIdx++;
								<div class="picker-item @(IsPickerKb( thisPickerIdx ) ? "guild-kb-selected" : "")" onclick=@(() => { GuildManager.Instance?.InvitePlayer( cRef.ConnectionId, cRef.Name, cRef.SteamId ); ClosePicker(); SoundManager.PlaySuccess(); })>
									<img class="picker-avatar" src="avatar:@cRef.SteamId" />
									<span class="picker-name">@cRef.Name</span>
									@if ( cRef.IsOnline )
									{
										<span class="picker-online-dot">●</span>
									}
									else if ( cRef.Level > 0 )
									{
										<span class="picker-level">Lv @cRef.Level</span>
									}
								</div>
							}
						}
						else if ( pickerMode == "transfer" )
						{
							@{
								var eligibleMembers = GuildManager.Instance?.Members?.Where( m => m.SteamId != (Connection.Local?.SteamId ?? 0) && m.Role >= GuildRole.Tamer ).ToList() ?? new();
							}
							@if ( eligibleMembers.Count == 0 )
							{
								<span class="picker-empty">No eligible members</span>
							}
							@{ var transferKbIdx = 0; }
							@foreach ( var member in eligibleMembers )
							{
								var thisTransferIdx = transferKbIdx; transferKbIdx++;
								<div class="picker-item @(IsPickerKb( thisTransferIdx ) ? "guild-kb-selected" : "")" onclick=@(() => { GuildManager.Instance?.TransferOwnership( member.SteamId ); ClosePicker(); SoundManager.PlaySuccess(); })>
									<span class="picker-name">@member.Name</span>
									<span class="picker-role">@member.Role</span>
								</div>
							}
						}
					</div>
				</div>
			</div>
		}
	}
}

@if ( !string.IsNullOrEmpty( errorMessage ) && guildView == "myguild" )
{
	<div class="guild-error-toast">
		<span>@errorMessage</span>
	</div>
}

</div>

@code {
	// Localization helper
	private string L( string key ) => LocalizationManager.Get( key );
	private string L( string key, params object[] args ) => LocalizationManager.Get( key, args );

	public Action OnBack { get; set; }

	// State
	private string guildView = "landing"; // "landing", "browse", "myguild"
	private string hoveredLandingCard = null;
	// (dead tab system / member search / permission matrix CUT — guild
	// rebuild 2026-08-31, guild-systems-review §2 dead code.)

	// ── Motion state (LANE: motion, attached 2026-09-01) — windowed
	//    render-keys for the two one-shot beats. The gp-pop class renders
	//    only while RealTime.Now < *_Until, so it is ABSENT on later
	//    kb-cursor remounts / page re-opens and the keyframe can't replay
	//    (volatile-class law). Both windows are in BuildHash.
	private string _claimPopGoalId = null;
	private float _claimPopUntil = -1f;
	private int _lastSeenGuildLevel = -1;
	private float _lvPopUntil = -1f;

	// Plaza state — one scene, no tabs. SETTINGS is a SUB-VIEW of the page
	// (run 2): the same header stays mounted, the body swaps (if-mount) so
	// the zone rungs replay on the way back. Requests have no modal any
	// more — PENDING rows live at the top of the roster list.
	private bool showSettingsView = false;
	private bool showMemberMenu = false;
	private GuildMemberInfo selectedMember = null;
	private bool raidViewOpen = false;
	// PERK LADDER overlay — opened by the identity band's next-unlock chip.
	private bool showPerkLadder = false;
	// ── LANE: input (2026-09-01) — guild-page device + overlay cursors ──
	// One device flag (DOC-5 §5): true while the keyboard drove last. The
	// gp-page root wears .kbd-mode/.mouse-mode from it; gp :hover rules are
	// gated under .mouse-mode; PlazaHover/LadderHover ignore events while
	// kb-mode (kb scroll fires synthetic onmouseover under a parked
	// pointer). Root onmousemove flips back — it only fires on REAL moves.
	private bool _gpKbdMode = false;
	// B1 (run-2 audit, DOC-5 §5) — where the pointer sat at the LAST nav
	// keypress. The engine re-dispatches onmousemove on re-render under a
	// PARKED cursor (roster OnRootMouseMove trace), so mouse mode is only
	// reclaimed by REAL travel (>= 3px from this stamp).
	private Vector2 _gpKbTakeoverPos = new Vector2( -9999f, -9999f );
	// S1 (DOC-5 §12) — overlay open edges. Each overlay seeds its OWN cursor
	// on its safe stop when it opens (Open* helpers seed at the click so no
	// frame paints the opener's stale index; the Tick edges are the net for
	// any other opener). Member menu → Close · picker → first · requests → first.
	private bool _memberMenuWasOpen = false;
	private bool _pickerWasOpen = false;
	// B2 — the transfer picker is opened FROM the settings sub-view. The
	// sub-view is IN-FLOW now (no z1000 drawer), so it stays mounted under
	// the picker's .confirm-overlay; ClosePicker(returnsToDrawer) keeps the
	// contract — it re-asserts the view open on any picker close.
	private bool _pickerReturnsToDrawer = false;
	// S3/S4/S5 — TextEntry grammar plumbing. Focus is DEFERRED a frame so the
	// Space/E that asked for it is never typed into the box; the MOTD entry
	// also has to MOUNT first (2-frame latch after the ref exists — the phone
	// chat-box recipe). _entryBlurAt is the same-frame latch: the Enter that
	// blurred via onsubmit is still edge-true this Tick and must not re-focus.
	private TextEntry _focusEntryPending = null;
	private int _focusEntryFrames = 0;
	private int _motdFocusLatch = 0;
	private float _entryBlurAt = -999f;
	private readonly HashSet<Panel> _wiredEntries = new();
	// Perk-ladder row cursor (info stops). Reset on the ladder's OPEN EDGE
	// in Tick (DOC-5 §12 — the ladder opens by mouse too).
	private int _ladderKbIndex = 0;
	private bool _ladderWasOpen = false;
	private string createName = "";
	private string createTag = "";
	private string errorMessage = "";

	// TextEntry refs
	private TextEntry createNameInput;
	private TextEntry createTagInput;
	private TextEntry motdDraftInput;
	// Settings sub-view description editor — polled in Tick (no onchange).
	private TextEntry settingsDescInput;

	// Browse detail
	private GuildAdvertisement viewingGuild = null;

	// MOTD editing
	private bool editingMotd = false;
	private string motdDraft = "";
	// (Plaza description stone CUT — description lives in the settings
	// sub-view's RECRUITING slab; see settingsDescInput.)

	// Emblem editing
	private string emblemColor = "#7c3aed";
	private string emblemIcon = "dragon";
	private string emblemShape = "square";

	// Settings editing
	private GuildJoinMode settingsJoinMode = GuildJoinMode.Request;
	private int settingsMinLevel = 1;
	private string settingsMinRank = "Unranked";
	private bool settingsAutoKick = false;
	private int settingsInactiveDays = 3;
	private string settingsDescription = "";

	// ── Keyboard navigation ─────────────────────────────────────────────────
	// One linear cursor per view. _kbZone names the focusable region inside a
	// view (a view can have several — e.g. the plaza has tiles/roster/perks/
	// danger). _kbIndex walks the items inside the active zone. _kbActive gates
	// the kb-selected cursor visual so a mouse-only session stays clean until
	// the player actually presses a nav key. _kbSearchFocused tracks whether the
	// browse search TextEntry currently owns typing (Tab moves focus out).
	private bool _kbActive = false;
	private string _kbZone = "";
	private int _kbIndex = 0;
	private bool _kbSearchFocused = false;
	// Tracks the settings sub-view open edge so the row cursor resets to the
	// first row whenever the drawer opens — by keyboard OR by mouse click.
	private bool _settingsWasOpen = false;
	// Set when the settings row cursor moves; consumed one Tick later so the
	// scroll-follow reads the NEW focused row's Box.Rect after layout has
	// re-rendered the `guild-kb-selected` class onto it (deferred-scroll
	// pattern — same as MonsterRosterPanel's detail scroll-follow).
	private bool _settingsScrollPending = false;
	// Scroll containers for keyboard scroll-follow (UiGridScroll).
	private Panel browseScrollRef;   // .guild-content-card — browse guild list
	private Panel settingsScrollRef; // (run 2: the settings sub-view does not scroll — stays null; ScrollSettingsRowIntoView no-ops)
	private Panel rosterScrollRef;   // .gp-roster-list — roster rows
	private Panel logScrollRef;      // .gp-log-list — activity log rows
	private Panel weekBodyRef;       // .gp-week-body — goal rows (A/D column-hop rect math)

	// ── Overlay scrollbars (roster + log) — the Beastbook hand-rolled
	//    recipe: scrollbar-color/-width don't parse, so track/thumb geometry
	//    is written imperatively per tick (ratio math, style-space px).
	//    LANE: motion (attached) — .gp-sb opacity 0↔.on 0.2s arm/fade +
	//    column-hover thumb brighten (the full Beastbook recipe).
	private Panel rosterSbTrackRef;
	private Panel rosterSbThumbRef;
	private Panel logSbTrackRef;
	private Panel logSbThumbRef;
	private int _rsbTrackH = -1, _rsbThumbH = -1, _rsbThumbTop = -1;
	private int _lsbTrackH = -1, _lsbThumbH = -1, _lsbThumbTop = -1;

	// Confirm dialog state moved to shared ConfirmDialog component (mounted globally in GameHUD)

	// Picker overlay
	private bool showPicker = false;
	private string pickerTitle = "";
	private string pickerMode = "";
	private List<Monster> raidTeamSelection = new();
	private bool showRaidTeamSelect = false;

	// Raid battle
	private bool showRaidBattle = false;
	private bool showRaidResults = false;
	private int raidResultDamage = 0;
	private string raidResultComboName = "";
	private float raidResultComboMultiplier = 1f;
	private int raidResultScore = 0;

	// Emblem options
	private static readonly string[] EmblemColors = new[]
	{
		"#7c3aed", "#ef4444", "#f59e0b", "#10b981",
		"#3b82f6", "#ec4899", "#6366f1", "#14b8a6"
	};

	// Emblem icon picker: key (saved on Guild) → lucide iconify name.
	// The map is SHARED now (BbEmblem.LucideMap, Code/UI/BbEmblem.cs) — one
	// source for this picker, the settings picker, the hub guild zone, and
	// every glyph fallback. Adding a new emblem = add it there. Beyond the
	// keys, an EmblemIcon can also be "beast:<speciesId>" (a species sprite —
	// resolved via BbEmblem.ResolveBeast at every render site; the beast
	// PICKER lands with the guild page rebuild).
	private static Dictionary<string, string> EmblemIcons => BbEmblem.LucideMap;

	private static readonly Dictionary<string, string> EmblemShapes = new()
	{
		{ "square",  "lucide:square" },
		{ "rounded", "ph:square" },
		{ "circle",  "lucide:circle" }
	};

	private static IEnumerable<T[]> ChunkArray<T>( T[] source, int size )
	{
		for ( int i = 0; i < source.Length; i += size )
		{
			var chunk = new T[Math.Min( size, source.Length - i )];
			Array.Copy( source, i, chunk, 0, chunk.Length );
			yield return chunk;
		}
	}

	protected override void OnAfterTreeRender( bool firstTime )
	{
		_devGuild = this; // dev_guildview handle
		if ( firstTime )
		{
			// In-guild players go straight to the plaza — no need to view a
			// summary card with an Enter button first. The landing is only the
			// no-guild state (Create/Browse/Invites).
			if ( GuildManager.Instance?.IsInGuild ?? false )
			{
				guildView = "myguild";
			}

			if ( GuildManager.Instance != null )
			{
				GuildManager.Instance.OnGuildUpdated += OnRefresh;
				GuildManager.Instance.OnMembersUpdated += OnRefresh;
				GuildManager.Instance.OnLogUpdated += OnRefresh;
				GuildManager.Instance.OnGuildError += OnError;

				// THE WEEK renders here now (QuestPanel's guild block is cut) —
				// seed instantly, then pull the authoritative server list.
				GuildManager.Instance.EnsureWeeklyGoalsSeeded();
				_ = GuildManager.Instance.RefreshWeeklyGoals();

				// Init emblem editor with current values
				if ( GuildManager.Instance.Guild != null )
				{
					emblemColor = GuildManager.Instance.Guild.EmblemColor;
					emblemIcon = GuildManager.Instance.Guild.EmblemIcon;
					emblemShape = GuildManager.Instance.Guild.EmblemShape;

					settingsJoinMode = GuildManager.Instance.Guild.JoinMode;
					settingsMinLevel = GuildManager.Instance.Guild.MinLevel;
					settingsMinRank = GuildManager.Instance.Guild.MinRank;
					settingsAutoKick = GuildManager.Instance.Guild.AutoKickInactive;
					settingsInactiveDays = GuildManager.Instance.Guild.InactiveDays;
					settingsDescription = GuildManager.Instance.Guild.Description ?? "";
				}
			}
		}

		// LANE: input (S3/S5) — TextEntry exit grammar. Enter (onsubmit) and
		// Esc (the entry's own oncancel — never an Input "Escape" bind, DOC-5
		// §2) hand the keyboard back to the row. Wired per INSTANCE, every
		// render, because the MOTD/create entries are re-created on mount.
		WireTextEntry( settingsDescInput, () => BlurToRow( settingsDescInput ) );
		WireTextEntry( createNameInput, () => BlurToRow( createNameInput ) );
		WireTextEntry( createTagInput, () => BlurToRow( createTagInput ) );
		// MOTD: Enter SAVES — submit is the natural commit for a one-liner.
		WireTextEntry( motdDraftInput, () => { SaveMotd(); SoundManager.PlaySuccess(); StateHasChanged(); } );
	}

	public override void Tick()
	{
		base.Tick();
		SpriteAnimator.Update();

		// Poll browse-search input — TextEntry has no onchange in s&box, so
		// we sync the backing field every tick when the browse view is open.
		if ( guildView == "browse" && browseSearchInput != null )
		{
			var t = browseSearchInput.Text ?? "";
			if ( t != browseSearchQuery )
			{
				browseSearchQuery = t;
			}
		}

		// Poll the settings sub-view's description editor while open — keeps
		// the draft in sync so SaveSettingsAndClose() picks up the latest text
		// (no onchange). 200-char cap enforced here too (the "N / 200" counter).
		if ( showSettingsView && settingsDescInput != null )
		{
			var t = settingsDescInput.Text ?? "";
			if ( t.Length > 200 ) { t = t.Substring( 0, 200 ); settingsDescInput.Text = t; }
			if ( t != settingsDescription )
			{
				settingsDescription = t;
			}
		}

		// Overlay scrollbars — imperative geometry (no BuildHash pollution).
		if ( guildView == "myguild" && (GuildManager.Instance?.IsInGuild ?? false) )
		{
			UpdateOverlayScrollbar( rosterSbTrackRef, rosterSbThumbRef, rosterScrollRef, ref _rsbTrackH, ref _rsbThumbH, ref _rsbThumbTop );
			UpdateOverlayScrollbar( logSbTrackRef, logSbThumbRef, logScrollRef, ref _lsbTrackH, ref _lsbThumbH, ref _lsbThumbTop );

			// LANE: input — THE LOG's cursor class is stamped imperatively
			// (SetClass, the overlay-scrollbar precedent): a volatile markup
			// class would remount the row and replay its gpLogRowN entrance
			// ladder on every cursor hop (DOC-4 §14 / motion's comment).
			SyncLogCursorClasses();

			// LANE: motion — GuildLevel edge → the LV stamp's Tier-3 gold
			// snap. First sighting only records (no pop on page open).
			var gpLvNow = GuildManager.Instance?.Guild?.Level ?? 0;
			if ( gpLvNow > 0 )
			{
				if ( _lastSeenGuildLevel > 0 && gpLvNow > _lastSeenGuildLevel )
					_lvPopUntil = RealTime.Now + 0.6f;
				_lastSeenGuildLevel = gpLvNow;
			}
		}

		// Settings drawer open edge — reset the keyboard row cursor to the
		// first row so it doesn't carry a stale index (e.g. the Settings tile's
		// index 2) in from whatever zone opened it.
		if ( showSettingsView && !_settingsWasOpen )
			_kbIndex = 0;
		// Drawer CLOSE edge — the description entry must never keep typing
		// focus behind a closed drawer (DOC-5 §18: clear on every exit path).
		if ( !showSettingsView && _settingsWasOpen )
			settingsDescInput?.Blur();
		_settingsWasOpen = showSettingsView;

		// S1 — overlay open edges seed each overlay's cursor on its safe stop
		// (mouse opens too; the Open* helpers already seeded — idempotent).
		if ( showMemberMenu && !_memberMenuWasOpen ) SeedMemberMenuCursor();
		_memberMenuWasOpen = showMemberMenu;
		if ( showPicker && !_pickerWasOpen ) _kbIndex = 0;
		_pickerWasOpen = showPicker;

		// Deferred TextEntry focus (S3/S5) — one frame after the confirm key.
		if ( _focusEntryPending != null )
		{
			_focusEntryFrames--;
			if ( _focusEntryFrames <= 0 )
			{
				_focusEntryPending.Focus();
				_focusEntryPending = null;
			}
		}

		// S4 — MOTD editor focus latch: wait for the entry to MOUNT (ref
		// non-null), then two frames, then Focus() (the phone chat-box latch).
		if ( _motdFocusLatch > 0 && editingMotd && motdDraftInput != null )
		{
			_motdFocusLatch--;
			if ( _motdFocusLatch == 0 ) motdDraftInput.Focus();
		}

		// Perk-ladder open edge — same rule (opens by mouse OR Space on the
		// next-unlock chip; the row cursor must not carry a stale index).
		if ( showPerkLadder && !_ladderWasOpen )
			_ladderKbIndex = 0;
		_ladderWasOpen = showPerkLadder;

		// Deferred settings scroll-follow (no-op in run 2: the sub-view does not
		// scroll; settingsScrollRef stays null) — runs the Tick AFTER the row
		// cursor moved, so layout has re-rendered `guild-kb-selected` onto the
		// new focused row and its Box.Rect is current.
		if ( _settingsScrollPending )
		{
			_settingsScrollPending = false;
			ScrollSettingsRowIntoView();
		}
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add( SpriteAnimator.GlobalFrame );
		hash.Add( guildView );
		hash.Add( showRaidTeamSelect );
		hash.Add( showRaidBattle );
		hash.Add( showRaidResults );
		hash.Add( showPicker );
		hash.Add( showSettingsView );
		hash.Add( showMemberMenu );
		hash.Add( raidViewOpen );
		// ── Settings sub-view form state (run 2) — every rendered fact: the
		//    preview + active chips/tiles, the "N / 200" counter, and the
		//    SAVE ↔ NO CHANGES swap. Role/claim gate the danger rows.
		hash.Add( emblemColor );
		hash.Add( emblemIcon );
		hash.Add( (int)settingsJoinMode );
		hash.Add( settingsMinLevel );
		hash.Add( settingsDescription );
		hash.Add( (int)(GuildManager.Instance?.Membership?.Role ?? 0) );
		hash.Add( GuildManager.Instance?.CanClaimLeadership() ?? false );
		hash.Add( showPerkLadder );
		hash.Add( browseSearchQuery );
		hash.Add( editingMotd );
		// ── Keyboard nav state — every field that drives a kb-selected cursor
		//    must be in the hash or the panel won't re-render on key presses.
		hash.Add( _kbActive );
		hash.Add( _kbZone );
		hash.Add( _kbIndex );
		hash.Add( _kbSearchFocused );
		hash.Add( _gpKbdMode );     // .kbd-mode/.mouse-mode root class
		hash.Add( _ladderKbIndex ); // perk-ladder row cursor
		// (run-2 input fields — _gpKbTakeoverPos, the *WasOpen edges,
		//  _pickerReturnsToDrawer, the focus latches — drive NO markup and
		//  are deliberately unhashed: hashing the parked-mouse stamp would
		//  re-render the tree on every keypress, the very re-dispatch B1 kills.)
		// ── Motion render-keys — the windowed pop classes must attach AND
		//    drop on time (the booleans flip when the windows expire).
		hash.Add( _claimPopGoalId );
		hash.Add( RealTime.Now < _claimPopUntil );
		hash.Add( RealTime.Now < _lvPopUntil );
		// ── Emblem resolve inputs (BbEmblem.ResolveBeast) — icon/color/owner
		//    plus everything the leader-favorite default chain reads: your own
		//    favorite, the member list (owner ConnectionId), and the online
		//    profile set (broadcast favorites).
		var gmH = GuildManager.Instance;
		hash.Add( gmH?.Guild?.EmblemIcon );
		hash.Add( gmH?.Guild?.EmblemColor );
		hash.Add( gmH?.Guild?.OwnerSteamId ?? 0 );
		hash.Add( gmH?.Members?.Count ?? 0 );
		hash.Add( TamerManager.Instance?.CurrentTamer?.FavoriteMonsterSpeciesId );
		hash.Add( ChatManager.Instance?.PlayerProfiles?.Count ?? 0 );
		// ── Guild page zones (rebuild 2026-08-31) — every rendered fact:
		//    identity (level/XP/MOTD), roster rows (presence, weekly XP,
		//    last-seen day bucket, voice), THE WEEK (progress/claimed),
		//    THE LOG (count + newest stamp), header chips (request count).
		hash.Add( gmH?.Guild?.Level ?? 0 );
		hash.Add( gmH?.Guild?.GuildXP ?? 0 );
		hash.Add( gmH?.Guild?.Motd );
		hash.Add( gmH?.IsOfficer == true ? (gmH.JoinRequests?.Count ?? 0) : 0 );
		foreach ( var mh in gmH?.Members ?? new List<GuildMemberInfo>() )
		{
			hash.Add( mh.IsOnline );
			hash.Add( mh.WeeklyGuildXP );
			hash.Add( (int)(DateTime.UtcNow - mh.LastSeen).TotalHours );
			hash.Add( IsMemberInVoice( mh ) );
		}
		foreach ( var gh in gmH?.WeeklyGoals ?? new List<GuildWeeklyGoal>() )
			hash.Add( gh.Progress + (gh.Claimed ? 1_000_000 : 0) );
		hash.Add( gmH?.ActivityLog?.Count ?? 0 );
		hash.Add( gmH?.ActivityLog?.Count > 0 ? gmH.ActivityLog[0].Timestamp : default );
		return hash.ToHashCode();
	}

	// ════════════════════════════════════════════════════════════════════════
	// KEYBOARD NAVIGATION
	// Dispatched from OnlineHubPanel.TickInput() while the Guild section is up.
	// Per-view scheme:
	//   landing — Up/Down walk the invite rows + hero + browse action, Space
	//             activates. Q falls through to GameHUD (exit Guild section).
	//   browse  — Tab toggles search-field ⇄ guild grid; arrows nav the 3-col
	//             grid; in guild-detail Up/Down walks join/back; Q backs out.
	//   myguild (plaza) — Tab cycles zones (tiles → roster → perks → danger);
	//             arrows nav within a zone; Space activates; Q backs to landing
	//             or exits the section if already at the plaza root.
	//   myguild (raid) — Up/Down through the raid scene actions; Q closes raid.
	//   create  — Up/Down through emblem pickers + Found button.
	// Blocking sub-states (member menu, settings drawer, requests / picker /
	// raid-team-select / raid-results modals, MOTD / description editors) OWN
	// the keyboard: their handler runs first and returns.
	// ════════════════════════════════════════════════════════════════════════
	public void TickInput()
	{
		// ---- Blocking sub-states first — they own the keyboard entirely. ----
		if ( showRaidBattle ) return;            // BattleView handles its own input

		if ( showRaidResults )
		{
			if ( UiInput.ConfirmPressed() || Input.Pressed( "Menu" ) )
			{
				showRaidResults = false;
				if ( Input.Pressed( "Menu" ) ) GameHUD.PanelHandledBackKey = true;
				StateHasChanged();
			}
			return;
		}

		if ( showPerkLadder ) { TickPerkLadderInput(); return; }
		if ( showPicker ) { TickPickerInput(); return; }
		if ( showMemberMenu && selectedMember != null ) { TickMemberMenuInput(); return; }
		if ( showSettingsView ) { TickSettingsDrawerInput(); return; }
		if ( editingMotd ) { TickEditorInput(); return; }

		// ---- View dispatch ----
		switch ( guildView )
		{
			case "landing": TickLandingInput(); break;
			case "browse":  TickBrowseInput(); break;
			case "myguild": TickMyGuildInput(); break;
		}
	}

	// Light the cursor on the first nav keypress without moving — mirrors the
	// SkillTree / Roster pattern. Returns true if it just engaged this frame.
	private bool EngageKb( string zone )
	{
		if ( _kbActive && _kbZone == zone ) return false;
		_kbActive = true;
		_kbZone = zone;
		_kbIndex = 0;
		SoundManager.PlayHover();
		StateHasChanged();
		return true;
	}

	private bool NavPressed() =>
		Input.Pressed( "Up" ) || Input.Pressed( "Down" ) ||
		Input.Pressed( "Left" ) || Input.Pressed( "Right" );

	private void MoveKb( int count, int delta )
	{
		if ( count <= 0 ) return;
		_kbIndex = Math.Clamp( _kbIndex + delta, 0, count - 1 );
		SoundManager.PlayHover();
		StateHasChanged();
	}

	// ── LANDING ──────────────────────────────────────────────────────────────
	// Flat vertical list: [invite rows ×2 each (accept/deny pairs)] then hero,
	// then browse action. We keep it simple — focus walks a flat index over a
	// dynamically built action list.
	private void TickLandingInput()
	{
		var gm = GuildManager.Instance;
		var levelGated = GetTamerLevel() < GuildManager.MIN_LEVEL_TO_JOIN;
		if ( levelGated ) return; // nothing actionable — Q exits via GameHUD

		var invites = gm?.PendingInvites ?? new List<GuildInvite>();
		// Action count: 2 per invite (accept, deny) + hero card + browse action.
		int count = invites.Count * 2 + 2;

		if ( !_kbActive || _kbZone != "landing" )
		{
			if ( NavPressed() ) EngageKb( "landing" );
			return;
		}

		if ( Input.Pressed( "Up" ) ) { MoveKb( count, -1 ); return; }
		if ( Input.Pressed( "Down" ) ) { MoveKb( count, 1 ); return; }

		if ( UiInput.ConfirmPressed() )
		{
			_kbIndex = Math.Clamp( _kbIndex, 0, count - 1 );
			int inviteSlots = invites.Count * 2;
			if ( _kbIndex < inviteSlots )
			{
				var invite = invites[_kbIndex / 2];
				if ( _kbIndex % 2 == 0 ) { AcceptInvite( invite ); SoundManager.PlaySelect(); }
				else { DeclineInvite( invite ); SoundManager.PlayDeny(); }
			}
			else if ( _kbIndex == inviteSlots ) // hero card
			{
				SoundManager.PlayForward();
				guildView = "myguild";
				errorMessage = "";
				ResetKb();
			}
			else // browse action
			{
				SoundManager.PlayForward();
				guildView = "browse";
				errorMessage = "";
				viewingGuild = null;
				LoadGuildsFromApi();
				ResetKb();
			}
			StateHasChanged();
		}
	}

	// ── BROWSE ───────────────────────────────────────────────────────────────
	private void TickBrowseInput()
	{
		// Guild-detail sub-view owns the keyboard while a guild is selected.
		if ( viewingGuild != null )
		{
			if ( Input.Pressed( "Menu" ) )
			{
				SoundManager.PlayBack();
				viewingGuild = null;
				ResetKb();
				GameHUD.PanelHandledBackKey = true;
				StateHasChanged();
				return;
			}
			TickBrowseDetailInput();
			return;
		}

		// Q — back to plaza/landing (internal back, claim the key).
		if ( Input.Pressed( "Menu" ) )
		{
			SoundManager.PlayBack();
			guildView = (GuildManager.Instance?.IsInGuild ?? false) ? "myguild" : "landing";
			viewingGuild = null;
			errorMessage = "";
			ResetKb();
			GameHUD.PanelHandledBackKey = true;
			StateHasChanged();
			return;
		}

		// Tab — toggle focus between the search field and the guild grid.
		if ( Input.Pressed( "Score" ) )
		{
			_kbSearchFocused = !_kbSearchFocused;
			if ( _kbSearchFocused )
			{
				browseSearchInput?.Focus();
				_kbActive = false;
			}
			else
			{
				browseSearchInput?.Blur();
				EngageKb( "browse-grid" );
			}
			SoundManager.PlayHover();
			StateHasChanged();
			return;
		}

		// While the search field owns typing, swallow nav so the player can
		// type freely — only Tab (above) / Q move focus out.
		if ( _kbSearchFocused ) return;

		var guilds = GetVisibleGuilds();
		if ( guilds.Count == 0 ) return;

		if ( !_kbActive || _kbZone != "browse-grid" )
		{
			if ( NavPressed() ) EngageKb( "browse-grid" );
			return;
		}

		const int cols = 3; // browse grid is a fixed 3-col row layout
		if ( Input.Pressed( "Left" ) ) MoveKb( guilds.Count, -1 );
		else if ( Input.Pressed( "Right" ) ) MoveKb( guilds.Count, 1 );
		else if ( Input.Pressed( "Up" ) ) MoveKb( guilds.Count, -cols );
		else if ( Input.Pressed( "Down" ) ) MoveKb( guilds.Count, cols );
		else if ( UiInput.ConfirmPressed() )
		{
			_kbIndex = Math.Clamp( _kbIndex, 0, guilds.Count - 1 );
			ViewGuildDetail( guilds[_kbIndex] );
			ResetKb();
			return;
		}

		// Keep the focused card on screen — browse cards live in .browse-row-3
		// rows inside the .guild-content-card scroll container. Scroll to the
		// row that holds the focused card.
		if ( NavPressed() )
			UiGridScroll.ScrollIndexIntoView( browseScrollRef, _kbIndex / cols, "browse-row-3" );
	}

	private void TickBrowseDetailInput()
	{
		var inGuild = GuildManager.Instance?.IsInGuild ?? false;
		bool locked = viewingGuild.JoinMode == GuildJoinMode.Closed || viewingGuild.JoinMode == GuildJoinMode.InviteOnly;
		bool canJoin = !inGuild && !locked;
		int count = canJoin ? 2 : 1; // [join], back  — or just back

		if ( !_kbActive || _kbZone != "browse-detail" )
		{
			if ( NavPressed() ) EngageKb( "browse-detail" );
			return;
		}

		if ( Input.Pressed( "Up" ) ) { MoveKb( count, -1 ); return; }
		if ( Input.Pressed( "Down" ) ) { MoveKb( count, 1 ); return; }

		if ( UiInput.ConfirmPressed() )
		{
			_kbIndex = Math.Clamp( _kbIndex, 0, count - 1 );
			if ( canJoin && _kbIndex == 0 )
			{
				RequestJoin( viewingGuild );
				SoundManager.PlaySelect();
				viewingGuild = null;
				ResetKb();
			}
			else // back to list
			{
				SoundManager.PlayBack();
				viewingGuild = null;
				ResetKb();
			}
			StateHasChanged();
		}
	}

	// ── MYGUILD ──────────────────────────────────────────────────────────────
	private void TickMyGuildInput()
	{
		// No guild → the create form is shown under guildView == "myguild".
		if ( !(GuildManager.Instance?.IsInGuild ?? false) ) { TickCreateInput(); return; }

		var gm = GuildManager.Instance;
		var raid = gm?.CurrentRaidBoss;

		// Raid team-select sub-state owns the keyboard.
		if ( showRaidTeamSelect && raid != null ) { TickRaidTeamSelectInput(); return; }

		// Raid encounter view (monument clicked).
		if ( raidViewOpen && raid != null ) { TickRaidViewInput(); return; }

		TickPlazaInput();
	}

	// Guild-page zones in the mock's documented walk order (LANE: input,
	// wired 2026-09-01): header chips → next-unlock chip → announcement
	// (pencil / write-row) → ROSTER rows → THE WEEK's goal rows → THE LOG
	// rows (info stops, Space no-op). W/S flow VERTICALLY as one continuous
	// cursor, crossing zone boundaries automatically; A/D HOP COLUMNS
	// (unlock ⇄ announcement in the top band; roster ⇄ week/log at the
	// spatially nearest row — rect-measured) and step within the chip pair.
	// No Tab (playtest ruling), no AcceptsFocus. Empty zones skip on cross.
	// Every conditional stop is counted from the SAME live logic as the
	// markup's if-chain (stale-map law, DOC-5 §12).
	private static readonly string[] _plazaZones = { "chips", "unlock", "info", "roster", "week", "log" };

	private void TickPlazaInput()
	{
		var gm = GuildManager.Instance;
		var members = gm?.Members ?? new List<GuildMemberInfo>();

		// Q — leave the plaza. The plaza is the Guild section root, so Q here
		// should exit the section; let it fall through to GameHUD (do NOT
		// claim the key — GameHUD handles section exit).

		// Any nav key = the keyboard drove last (device contract leg 1).
		if ( NavPressed() ) StampKb();

		bool zoneIsPlaza = Array.IndexOf( _plazaZones, _kbZone ) >= 0;
		if ( !_kbActive || !zoneIsPlaza )
		{
			// First nav keypress just lights the cursor on the first
			// non-empty zone (chips are officer-conditional).
			if ( NavPressed() )
			{
				_kbActive = true;
				_kbZone = "chips";
				_kbIndex = 0;
				if ( PlazaZoneCount( "chips", gm, members ) <= 0 ) _kbZone = "unlock";
				SoundManager.PlayHover();
				StateHasChanged();
			}
			return;
		}

		// ── Vertical flow (W/S) — crosses zone boundaries. Roster / week /
		//    log are the multi-row zones: W/S step a row inside them and only
		//    cross out at the list's true top / bottom edge. Every other zone
		//    is a single row, so any W/S there immediately crosses zones. ──
		if ( Input.Pressed( "Up" ) )    { PlazaVertical( gm, members, -1 ); return; }
		if ( Input.Pressed( "Down" ) )  { PlazaVertical( gm, members,  1 ); return; }

		// ── Horizontal flow (A/D) — column hops + the chip pair. ──
		if ( Input.Pressed( "Left" ) )  { PlazaHorizontal( gm, members, -1 ); return; }
		if ( Input.Pressed( "Right" ) ) { PlazaHorizontal( gm, members,  1 ); return; }

		// ── Space/Enter/E — activate the focused control. ──
		if ( UiInput.ConfirmPressed() )
			PlazaActivate( gm, members );
	}

	// Count of focusable items in a plaza zone. 0 = empty zone (skip on cross).
	private int PlazaZoneCount( string zone, GuildManager gm, List<GuildMemberInfo> members )
	{
		switch ( zone )
		{
			// INVITE (officer) · REQUESTS·N (officer, N>0) · SETTINGS
			// (everyone — LEAVE lives in the settings DANGER slab). One live
			// list feeds the markup and this count (GetPlazaChips).
			case "chips":  return GetPlazaChips( gm ).Count;
			case "unlock": return 1;                                   // the next-unlock chip
			case "info":   return GetPlazaInfoPencils( gm ).Count;     // announcement pencil / write-row
			case "roster": return GetPlazaRosterMembers( members ).Count;
			case "week":   return gm.WeeklyGoals?.Count ?? 0;          // goal rows (claim when claimable)
			case "log":    return gm.ActivityLog?.Count ?? 0;          // feed rows (info stops, Space no-op)
		}
		return 0;
	}

	// Vertical move. `dir` = -1 up / +1 down. The roster / week / log lists
	// step one row and only cross out at their true top/bottom edge; every
	// other zone is a single row, so any W/S there immediately crosses zones.
	private void PlazaVertical( GuildManager gm, List<GuildMemberInfo> members, int dir )
	{
		int count = PlazaZoneCount( _kbZone, gm, members );

		if ( (_kbZone == "roster" || _kbZone == "week" || _kbZone == "log") && count > 0 )
		{
			int next = _kbIndex + dir;
			if ( next >= 0 && next < count )
			{
				_kbIndex = next;
				SoundManager.PlayHover();
				PlazaScrollFollow();
				StateHasChanged();
				return;
			}
			// Off the top/bottom edge — fall through to the zone cross.
		}

		PlazaCrossZone( gm, members, dir );
	}

	// Keep the focused row on screen in whichever scroll list owns the
	// cursor (roster + log scroll; the week's 3 goal rows never do).
	private void PlazaScrollFollow()
	{
		if ( _kbZone == "roster" )
			UiGridScroll.ScrollIndexIntoView( rosterScrollRef, _kbIndex, "gp-mrow" );
		else if ( _kbZone == "log" )
			UiGridScroll.ScrollIndexIntoView( logScrollRef, _kbIndex, "gp-lrow" );
	}

	// Cross to the next/previous non-empty plaza zone. Going DOWN lands on the
	// new zone's FIRST item; going UP lands on its LAST item.
	private void PlazaCrossZone( GuildManager gm, List<GuildMemberInfo> members, int dir )
	{
		int zi = Array.IndexOf( _plazaZones, _kbZone );
		if ( zi < 0 ) zi = 0;
		for ( int step = 0; step < _plazaZones.Length; step++ )
		{
			int ni = zi + dir * ( step + 1 );
			if ( ni < 0 || ni >= _plazaZones.Length ) return; // top/bottom of page — no-op
			var zone = _plazaZones[ni];
			int c = PlazaZoneCount( zone, gm, members );
			if ( c <= 0 ) continue;                            // empty zone — skip through
			_kbZone = zone;
			_kbIndex = dir > 0 ? 0 : c - 1;                    // down→first item, up→last
			SoundManager.PlayHover();
			// Roster/log rows live in overflow:scroll lists — keep the focused
			// row on screen (deferred-scroll not needed: rows pre-exist).
			PlazaScrollFollow();
			StateHasChanged();
			return;
		}
	}

	// Horizontal move (A/D) — the COLUMN-HOP grammar (LANE: input): the page
	// is two columns wide below the header, so A/D cross columns at the
	// spatially nearest row (rect-measured — the kb graph encodes geometry,
	// DOC-5 §21). Inside the header's chip pair, A/D step between the chips
	// (the only truly horizontal zone).
	private void PlazaHorizontal( GuildManager gm, List<GuildMemberInfo> members, int dir )
	{
		switch ( _kbZone )
		{
			case "chips":
			{
				// INVITE ↔ REQUESTS·N ↔ SETTINGS (left → right, live list).
				int count = PlazaZoneCount( "chips", gm, members );
				if ( count <= 0 ) return;
				int next = Math.Clamp( _kbIndex + dir, 0, count - 1 );
				if ( next == _kbIndex ) return;
				_kbIndex = next;
				SoundManager.PlayHover();
				StateHasChanged();
				return;
			}
			case "unlock":
			{
				// D → the announcement stop (right of the identity band).
				// A → nothing (the emblem/XP to the left are not stops).
				if ( dir > 0 && PlazaZoneCount( "info", gm, members ) > 0 )
				{
					_kbZone = "info";
					_kbIndex = 0;
					SoundManager.PlayHover();
					StateHasChanged();
				}
				return;
			}
			case "info":
			{
				// A → back to the next-unlock chip.
				if ( dir < 0 )
				{
					_kbZone = "unlock";
					_kbIndex = 0;
					SoundManager.PlayHover();
					StateHasChanged();
				}
				return;
			}
			case "roster":
			{
				// D → the right column (week goal or log row nearest in Y).
				if ( dir > 0 ) PlazaHopRight( gm, members );
				return;
			}
			case "week":
			case "log":
			{
				// A → back to the roster at the nearest row.
				if ( dir < 0 ) PlazaHopLeft( gm, members );
				return;
			}
		}
	}

	// ── Column-hop rect math — nearest-row matching is measured from live
	//    Box.Rects (screen space), so it stays honest under scrolling and
	//    the roomy/dense roster row height switch. NaN rects (first frame)
	//    fall back to the target column's first stop. ──

	private Panel NthChildWithClass( Panel container, string cls, int index )
	{
		if ( container == null || index < 0 ) return null;
		int n = 0;
		foreach ( var c in container.Children )
		{
			if ( !c.HasClass( cls ) ) continue;
			if ( n == index ) return c;
			n++;
		}
		return null;
	}

	private float RowCenterY( Panel container, string cls, int index )
	{
		var p = NthChildWithClass( container, cls, index );
		if ( p == null ) return float.NaN;
		var r = p.Box.Rect;
		if ( r.Height <= 0f ) return float.NaN;
		return r.Top + r.Height * 0.5f;
	}

	// Roster → right column: pick the week goal / log row whose center is
	// nearest the focused roster row's center.
	private void PlazaHopRight( GuildManager gm, List<GuildMemberInfo> members )
	{
		int goalCount = PlazaZoneCount( "week", gm, members );
		int logCount = PlazaZoneCount( "log", gm, members );
		if ( goalCount <= 0 && logCount <= 0 ) return;

		float curY = RowCenterY( rosterScrollRef, "gp-mrow", _kbIndex );
		string bestZone = null;
		int bestIdx = 0;
		float bestD = float.MaxValue;

		for ( int j = 0; j < goalCount; j++ )
		{
			float y = RowCenterY( weekBodyRef, "gp-goal", j );
			float d = (float.IsNaN( y ) || float.IsNaN( curY )) ? float.MaxValue * 0.5f : Math.Abs( y - curY );
			if ( d < bestD ) { bestD = d; bestZone = "week"; bestIdx = j; }
		}
		for ( int k = 0; k < logCount; k++ )
		{
			float y = RowCenterY( logScrollRef, "gp-lrow", k );
			float d = (float.IsNaN( y ) || float.IsNaN( curY )) ? float.MaxValue * 0.5f : Math.Abs( y - curY );
			if ( d < bestD ) { bestD = d; bestZone = "log"; bestIdx = k; }
		}
		if ( bestZone == null ) { bestZone = goalCount > 0 ? "week" : "log"; bestIdx = 0; }

		_kbZone = bestZone;
		_kbIndex = bestIdx;
		SoundManager.PlayHover();
		PlazaScrollFollow();
		StateHasChanged();
	}

	// Week/log → roster: nearest roster row by center Y.
	private void PlazaHopLeft( GuildManager gm, List<GuildMemberInfo> members )
	{
		int rosterCount = PlazaZoneCount( "roster", gm, members );
		if ( rosterCount <= 0 ) return;

		float curY = _kbZone == "week"
			? RowCenterY( weekBodyRef, "gp-goal", _kbIndex )
			: RowCenterY( logScrollRef, "gp-lrow", _kbIndex );

		int best = 0;
		float bestD = float.MaxValue;
		for ( int i = 0; i < rosterCount; i++ )
		{
			float y = RowCenterY( rosterScrollRef, "gp-mrow", i );
			float d = (float.IsNaN( y ) || float.IsNaN( curY )) ? float.MaxValue * 0.5f : Math.Abs( y - curY );
			if ( d < bestD ) { bestD = d; best = i; }
		}

		_kbZone = "roster";
		_kbIndex = best;
		SoundManager.PlayHover();
		PlazaScrollFollow();
		StateHasChanged();
	}

	// Activate (Space/Enter) the focused control in the current zone.
	private void PlazaActivate( GuildManager gm, List<GuildMemberInfo> members )
	{
		switch ( _kbZone )
		{
			case "chips":
			{
				var chips = GetPlazaChips( gm );
				if ( chips.Count == 0 ) return;
				int i = Math.Clamp( _kbIndex, 0, chips.Count - 1 );
				switch ( chips[i] )
				{
					case "invite":   OnInviteClicked(); break;
					case "requests": ScrollRosterToPending(); SoundManager.PlayForward(); break;
					default:         OpenSettingsView(); SoundManager.PlayClick(); break;
				}
				StateHasChanged();
				break;
			}
			case "unlock":
			{
				showPerkLadder = true;
				SoundManager.PlayForward();
				StateHasChanged();
				break;
			}
			case "info":
			{
				var pencils = GetPlazaInfoPencils( gm );
				if ( pencils.Count == 0 ) return;
				StartEditMotd();
				SoundManager.PlayClick();
				StateHasChanged();
				break;
			}
			case "roster":
			{
				var ordered = GetPlazaRosterMembers( members );
				if ( ordered.Count == 0 ) return;
				int i = Math.Clamp( _kbIndex, 0, ordered.Count - 1 );
				OpenMemberMenu( ordered[i] );
				SoundManager.PlayClick();
				StateHasChanged();
				break;
			}
			case "week":
			{
				// Goal rows are info stops; Space claims only when claimable.
				var goals = gm.WeeklyGoals ?? new List<GuildWeeklyGoal>();
				if ( goals.Count == 0 ) return;
				int i = Math.Clamp( _kbIndex, 0, goals.Count - 1 );
				var g = goals[i];
				if ( g.Completed && !g.Claimed )
				{
					// LANE: motion — routes through the pop helper so the kb
					// claim gets the same Tier-2 flash + sound as the click.
					ClaimGoalWithPop( g );
				}
				break;
			}
			case "log":
			{
				// Log rows are read-only info stops — Space is a deliberate
				// no-op (the row taps nothing; there is nothing to press).
				break;
			}
		}
	}

	// ── One-cursor mouse hover (LANE: input, DOC-5 §6) — hovering a plaza
	//    stop moves the SAME zone/index cursor the keyboard walks, so
	//    guild-kb-selected is the ONE cursor in both modes and W/S continue
	//    from wherever the mouse parked it. Ignored while the keyboard drove
	//    last (_gpKbdMode): kb scroll-follow slides rows under a parked
	//    pointer and fires SYNTHETIC onmouseover — last input wins, and the
	//    root's onmousemove (real movement only) is the flip-back edge. ──
	private void PlazaHover( string zone, int idx )
	{
		if ( _gpKbdMode ) return;
		// Blocking sub-states own the cursor fields — a stray hover on the
		// page below must not corrupt them (the MOTD editor has no backdrop).
		if ( editingMotd || showPerkLadder || showSettingsView || showMemberMenu || showPicker ) return;
		if ( _kbActive && _kbZone == zone && _kbIndex == idx ) return;
		_kbActive = true;
		_kbZone = zone;
		_kbIndex = idx;
		SoundManager.PlayHover();
		StateHasChanged();
	}

	// Device flip: any nav keypress = keyboard drove last. Re-stamps the
	// pointer's parked position on EVERY nav press (B1) — the mouse-mode edge
	// measures travel from the last keypress, so a slow drift never
	// accumulates into a false flip.
	private void StampKb()
	{
		_gpKbTakeoverPos = Mouse.Position;
		if ( _gpKbdMode ) return;
		_gpKbdMode = true;
		StateHasChanged();
	}

	// Root onmousemove — the mouse-mode edge. B1 (run-2 audit, DOC-5 §5):
	// the engine re-dispatches onmousemove on re-render/re-layout under a
	// PARKED cursor, so an unguarded flip fired on every W/S press — device
	// flipped mid-frame, the row under the pointer re-hovered, the cursor
	// snapped back. Mouse mode is reclaimed only by REAL travel (>= 3px since
	// the keyboard took over) — the roster's OnRootMouseMove recipe.
	private void OnGpPageMouseMove()
	{
		if ( !_gpKbdMode ) return;
		if ( ( Mouse.Position - _gpKbTakeoverPos ).Length < 3f ) return;
		_gpKbdMode = false;
		StateHasChanged();
	}

	// ── Live focusable-item lists per zone — rebuilt each call so conditional
	//    controls match the markup exactly. ──

	// The announcement's one "info" stop: the officer pencil (MOTD set) or
	// the write-row (MOTD empty). Hidden while the editor is open.
	private List<string> GetPlazaInfoPencils( GuildManager gm )
	{
		var pencils = new List<string>();
		if ( gm.IsOfficer && !editingMotd ) pencils.Add( "motd" );
		return pencils;
	}

	// Roster rows in render order (online → role → arena points).
	private List<GuildMemberInfo> GetPlazaRosterMembers( List<GuildMemberInfo> members )
	{
		return members
			.OrderByDescending( m => m.IsOnline )
			.ThenByDescending( m => m.Role )
			.ThenByDescending( m => m.ArenaPoints )
			.ToList();
	}

	// ── PERK LADDER overlay (LANE: input) — W/S walk the perk rows (info
	//    stops, no press stamp); Q/Space/Enter/E close (Space opened it from
	//    the chip, Space closes it from inside — a read-and-dismiss surface).
	//    Esc stays unbound (engine-reserved, DOC-5 §2). Gated on
	//    showPerkLadder by the TickInput dispatch chain; the row cursor
	//    resets on the OPEN EDGE in Tick (opens by mouse too).
	private void TickPerkLadderInput()
	{
		if ( NavPressed() ) StampKb();

		int count = WiredPerks.Count;
		if ( Input.Pressed( "Up" ) || Input.Pressed( "Down" ) )
		{
			int dir = Input.Pressed( "Down" ) ? 1 : -1;
			int next = Math.Clamp( _ladderKbIndex + dir, 0, Math.Max( 0, count - 1 ) );
			if ( next != _ladderKbIndex )
			{
				_ladderKbIndex = next;
				SoundManager.PlayHover();
				StateHasChanged();
			}
			return;
		}

		if ( Input.Pressed( "Menu" ) || UiInput.ConfirmPressed() )
		{
			showPerkLadder = false;
			SoundManager.PlayBack();
			if ( Input.Pressed( "Menu" ) ) GameHUD.PanelHandledBackKey = true;
			StateHasChanged();
		}
	}

	// Ladder hover — same one-cursor / last-input-wins contract as
	// PlazaHover, on the ladder's own row cursor.
	private void LadderHover( int idx )
	{
		if ( !showPerkLadder || _gpKbdMode ) return;
		if ( _ladderKbIndex == idx ) return;
		_ladderKbIndex = idx;
		SoundManager.PlayHover();
		StateHasChanged();
	}

	// THE LOG's cursor class, stamped imperatively per tick (SetClass — the
	// overlay-scrollbar precedent). A volatile MARKUP class would remount
	// each row and replay its gpLogRowN entrance ladder on every cursor hop
	// (DOC-4 §14); SetClass mutates the live panel without a razor remount.
	private void SyncLogCursorClasses()
	{
		if ( logScrollRef == null ) return;
		bool active = _kbActive && _kbZone == "log";
		int n = 0;
		foreach ( var c in logScrollRef.Children )
		{
			if ( !c.HasClass( "gp-lrow" ) ) continue;
			c.SetClass( "guild-kb-selected", active && n == _kbIndex );
			n++;
		}
	}

	// ── RAID ENCOUNTER VIEW ──────────────────────────────────────────────────
	private void TickRaidViewInput()
	{
		// Q — close the raid view, back to plaza.
		if ( Input.Pressed( "Menu" ) )
		{
			SoundManager.PlayBack();
			raidViewOpen = false;
			ResetKb();
			GameHUD.PanelHandledBackKey = true;
			StateHasChanged();
			return;
		}

		// Space/Enter — attack the boss when attempts remain. Only one focusable
		// action in this view, so no list nav is needed.
		if ( UiInput.ConfirmPressed() )
		{
			if ( GuildManager.Instance?.CanAttemptRaid() ?? false )
				OnAttackRaidBoss();
		}
	}

	// ── RAID TEAM SELECT ─────────────────────────────────────────────────────
	private void TickRaidTeamSelectInput()
	{
		// Q — cancel team select.
		if ( Input.Pressed( "Menu" ) )
		{
			showRaidTeamSelect = false;
			raidTeamSelection.Clear();
			SoundManager.PlayBack();
			ResetKb();
			GameHUD.PanelHandledBackKey = true;
			StateHasChanged();
			return;
		}

		var monsters = GetRaidAvailableMonsters();
		if ( monsters.Count == 0 )
		{
			// No monsters — Space confirms only if a team is somehow set.
			if ( ( UiInput.ConfirmPressed() ) && raidTeamSelection.Count == 3 )
				StartRaidBattle();
			return;
		}

		if ( !_kbActive || _kbZone != "raid-select" )
		{
			if ( NavPressed() ) EngageKb( "raid-select" );
			return;
		}

		// Grid nav over the available-monster grid (4 cols matches the layout).
		const int cols = 4;
		if ( Input.Pressed( "Left" ) ) MoveKb( monsters.Count, -1 );
		else if ( Input.Pressed( "Right" ) ) MoveKb( monsters.Count, 1 );
		else if ( Input.Pressed( "Up" ) ) MoveKb( monsters.Count, -cols );
		else if ( Input.Pressed( "Down" ) ) MoveKb( monsters.Count, cols );
		else if ( Input.Pressed( "Jump" ) || Input.Pressed( "Use" ) )
		{
			// Space (E silent twin) — toggle the focused monster.
			_kbIndex = Math.Clamp( _kbIndex, 0, monsters.Count - 1 );
			ToggleRaidTeamMember( monsters[_kbIndex] );
			StateHasChanged();
		}
		else if ( Input.Pressed( "Enter" ) )
		{
			// Enter — confirm the attack when 3 are picked.
			if ( raidTeamSelection.Count == 3 ) StartRaidBattle();
		}
	}

	// ── CREATE FORM ──────────────────────────────────────────────────────────
	// Rows (S5, top-to-bottom on screen): name(0) · tag(1) · color(2) ·
	// icon(3) · shape(4) · FOUND(5). Name/tag are TextEntry stops: Space/
	// Enter/E focuses the box; typing then owns the keyboard until Tab /
	// Enter / Esc hand it back (cursor stays on the field).
	private const int CreateRowName = 0, CreateRowTag = 1, CreateRowColor = 2,
		CreateRowIcon = 3, CreateRowShape = 4, CreateRowFound = 5, CreateRowCount = 6;

	private void TickCreateInput()
	{
		// Typing owns the keyboard (Q types a 'q', it does not leave the form).
		if ( TypingOwnsKeys( createNameInput, CreateRowName, "create" ) ) return;
		if ( TypingOwnsKeys( createTagInput, CreateRowTag, "create" ) ) return;

		// Q — leave the create form, back to landing.
		if ( Input.Pressed( "Menu" ) )
		{
			SoundManager.PlayBack();
			guildView = "landing";
			errorMessage = "";
			ResetKb();
			GameHUD.PanelHandledBackKey = true;
			StateHasChanged();
			return;
		}

		if ( GetTamerLevel() < GuildManager.MIN_LEVEL_TO_JOIN ) return; // level-gated

		// Each picker group is one row stepped with Up/Down; Left/Right cycles
		// the option inside the focused group (no-op on the text rows).
		const int rowCount = CreateRowCount;

		if ( !_kbActive || _kbZone != "create" )
		{
			if ( NavPressed() ) EngageKb( "create" );
			return;
		}

		if ( Input.Pressed( "Up" ) ) { MoveKb( rowCount, -1 ); return; }
		if ( Input.Pressed( "Down" ) ) { MoveKb( rowCount, 1 ); return; }

		_kbIndex = Math.Clamp( _kbIndex, 0, rowCount - 1 );

		if ( Input.Pressed( "Left" ) || Input.Pressed( "Right" ) )
		{
			int dir = Input.Pressed( "Right" ) ? 1 : -1;
			if ( _kbIndex == CreateRowColor ) // color
			{
				int ci = Array.IndexOf( EmblemColors, emblemColor );
				ci = ( ci + dir + EmblemColors.Length ) % EmblemColors.Length;
				emblemColor = EmblemColors[ci];
				SoundManager.PlayClick();
			}
			else if ( _kbIndex == CreateRowIcon ) // icon
			{
				var keys = EmblemIcons.Keys.ToList();
				int ki = keys.IndexOf( emblemIcon );
				if ( ki < 0 ) ki = 0;
				ki = ( ki + dir + keys.Count ) % keys.Count;
				emblemIcon = keys[ki];
				SoundManager.PlayClick();
			}
			else if ( _kbIndex == CreateRowShape ) // shape
			{
				var keys = EmblemShapes.Keys.ToList();
				int si = keys.IndexOf( emblemShape );
				if ( si < 0 ) si = 0;
				si = ( si + dir + keys.Count ) % keys.Count;
				emblemShape = keys[si];
				SoundManager.PlayClick();
			}
			StateHasChanged();
			return;
		}

		if ( UiInput.ConfirmPressed() )
		{
			if ( _kbIndex == CreateRowFound ) OnCreateGuild();
			else if ( _kbIndex == CreateRowName ) RequestEntryFocus( createNameInput );
			else if ( _kbIndex == CreateRowTag ) RequestEntryFocus( createTagInput );
		}
	}

	// ── SETTINGS SUB-VIEW (kb rows) ──────────────────────────────────────────
	// Live ordered list of focusable rows in the sub-view's read order (left
	// column top→bottom, then right). Rebuilt each call so the conditional
	// rows (officer form rows; danger actions by role; Save for officers)
	// line up with the markup. Row ids (run 2 — the drawer's "icon" row is
	// now "beast"; "cancel" is gone — BACK TO GUILD · Q is the back):
	//   color · beast · description · joinmode · minlevel   (officers)
	//   · claim? · transfer? · leave · disband? · save?
	// LANE: input — the sub-view's real pass (A/D inside chip rows, HOLD on
	// the danger buttons, the column hop) builds on this list.
	private List<string> GetSettingsDrawerRows()
	{
		var gm = GuildManager.Instance;
		var rows = new List<string>();
		if ( gm?.IsOfficer ?? false ) rows.AddRange( new[] { "color", "beast", "description", "joinmode", "minlevel" } );
		if ( gm?.CanClaimLeadership() ?? false ) rows.Add( "claim" );
		if ( (gm?.IsLeader ?? false) && (gm?.Members?.Count ?? 0) > 1 ) rows.Add( "transfer" );
		rows.Add( "leave" );
		if ( gm?.IsLeader ?? false ) rows.Add( "disband" );
		if ( gm?.IsOfficer ?? false ) rows.Add( "save" );
		return rows;
	}

	private void TickSettingsDrawerInput()
	{
		// S3 — typing owns the keyboard while the description entry has focus
		// (Tab hands it back here; Enter/Esc via the entry's own events). Q
		// types a 'q' while focused; unfocused Q is the drawer's back (below).
		if ( TypingOwnsKeys( settingsDescInput, GetSettingsDrawerRows().IndexOf( "description" ) ) ) return;

		// Q — close the drawer (internal back, claim the key).
		if ( Input.Pressed( "Menu" ) )
		{
			showSettingsView = false;
			SoundManager.PlayBack();
			ResetKb();
			GameHUD.PanelHandledBackKey = true;
			StateHasChanged();
			return;
		}

		var rows = GetSettingsDrawerRows();
		if ( rows.Count == 0 ) return;
		_kbIndex = Math.Clamp( _kbIndex, 0, rows.Count - 1 );

		// Up/Down move the row cursor — flag a deferred scroll-follow so the
		// drawer body keeps the focused row on screen (body is overflow:scroll).
		if ( Input.Pressed( "Up" ) ) { MoveKb( rows.Count, -1 ); _settingsScrollPending = true; return; }
		if ( Input.Pressed( "Down" ) ) { MoveKb( rows.Count, 1 ); _settingsScrollPending = true; return; }

		var row = rows[_kbIndex];

		// Left/Right — on a chip row this cycles the focused option (the
		// sub-view has no cancel/save pair any more; SAVE stands alone).
		// LANE: input — A/D should walk the chips visually in-row (per-tile
		// cursor) in the sub-view pass; cycling the value is the interim.
		if ( Input.Pressed( "Left" ) || Input.Pressed( "Right" ) )
		{
			int dir = Input.Pressed( "Right" ) ? 1 : -1;
			CycleSettingsRow( row, dir );
			return;
		}

		// Space/Enter/E — activate. Buttons fire; danger rows open their
		// confirm dialogs; a radio row steps forward (so the keyboard works
		// even without Left/Right); the description row hands the keyboard
		// to its TextEntry (S3 — deferred a frame so the Space isn't typed).
		if ( UiInput.ConfirmPressed() )
		{
			if ( row == "save" )
			{
				SaveSettingsAndClose(); // S13 — one save path, one chime
				ResetKb();
				StateHasChanged();
			}
			else if ( row == "description" ) { RequestEntryFocus( settingsDescInput ); }
			else if ( row == "claim" )    { OnClaimLeadership(); SoundManager.PlayPopup(); }
			else if ( row == "transfer" ) { OnTransferOwnership(); }
			else if ( row == "leave" )    { OnLeaveGuild(); SoundManager.PlayPopup(); }
			else if ( row == "disband" )  { OnDisbandGuild(); SoundManager.PlayPopup(); }
			else
			{
				CycleSettingsRow( row, 1 );
			}
		}
	}

	// Step one drawer setting forward/back. Mirrors each row's onclick mutation
	// so keyboard edits land identically to mouse clicks.
	private void CycleSettingsRow( string row, int dir )
	{
		switch ( row )
		{
			case "color":
			{
				int i = Array.IndexOf( EmblemColors, emblemColor );
				i = ( i + dir + EmblemColors.Length ) % EmblemColors.Length;
				emblemColor = EmblemColors[i];
				break;
			}
			case "beast":
			{
				// The BEAST tiles (run 2) — "beast:<speciesId>" is the emblem.
				var choices = GetEmblemBeastChoices();
				if ( choices.Count == 0 ) return;
				var cur = ( emblemIcon ?? "" ).StartsWith( "beast:" ) ? emblemIcon.Substring( 6 ) : "";
				int i = choices.FindIndex( s => s.Id == cur );
				i = i < 0 ? ( dir > 0 ? 0 : choices.Count - 1 ) : ( i + dir + choices.Count ) % choices.Count;
				emblemIcon = "beast:" + choices[i].Id;
				break;
			}
			case "joinmode":
			{
				// Only the three CHIP modes cycle — `Closed` has no chip.
				var modes = JoinModeChips;
				int i = Array.IndexOf( modes, settingsJoinMode );
				if ( i < 0 ) i = 0;
				i = ( i + dir + modes.Length ) % modes.Length;
				settingsJoinMode = modes[i];
				break;
			}
			case "minlevel":
			{
				var lvls = MinLevelChips;
				int i = Array.IndexOf( lvls, settingsMinLevel );
				if ( i < 0 ) i = 0;
				i = ( i + dir + lvls.Length ) % lvls.Length;
				settingsMinLevel = lvls[i];
				break;
			}
			default:
				return; // description / danger rows / save — not cyclable
		}
		SoundManager.PlayClick();
		StateHasChanged();
	}

	// kb-selected predicate for the settings drawer rows (drawer owns the
	// keyboard whenever open, so the cursor shows immediately).
	private bool IsSettingsRowKb( string row )
	{
		if ( !showSettingsView ) return false;
		var rows = GetSettingsDrawerRows();
		int i = Math.Clamp( _kbIndex, 0, rows.Count - 1 );
		return i >= 0 && i < rows.Count && rows[i] == row;
	}

	// Scroll the settings body so the focused row is visible (run 2: no-op —
	// the sub-view is fixed-height, settingsScrollRef is null). The row
	// carries `guild-kb-selected`; scope the search to the drawer body so it
	// can't pick up a same-class element elsewhere in the panel.
	private void ScrollSettingsRowIntoView()
	{
		if ( settingsScrollRef == null ) return;
		var target = FindKbPanel( settingsScrollRef, "guild-kb-selected" );
		UiGridScroll.IntoView( settingsScrollRef, target );
	}

	// ── MEMBER CONTEXT MENU ──────────────────────────────────────────────────
	// Live action list in render order (mirrors the markup's @if chain).
	private List<string> GetMemberMenuActions( GuildManager gm, GuildMemberInfo sm )
	{
		var actions = new List<string>();
		if ( gm != null && sm != null )
		{
			var canManage = gm.IsOfficer && sm.SteamId != (Connection.Local?.SteamId ?? 0) && sm.Role < gm.Membership.Role;
			if ( canManage && gm.IsLeader && sm.Role < GuildRole.Warden ) actions.Add( "promote" );
			if ( canManage && gm.IsLeader && sm.Role > GuildRole.Wanderer && sm.Role < GuildRole.Beastlord ) actions.Add( "demote" );
			if ( canManage ) actions.Add( "kick" );
		}
		actions.Add( "close" );
		return actions;
	}

	// S1 (DOC-5 §12/§14) — the menu's cursor seeds on CLOSE (its safe stop),
	// never on the roster row index it was opened from (leader on row 1 →
	// [promote, kick, close] used to open ON KICK).
	private void SeedMemberMenuCursor()
	{
		_kbIndex = GetMemberMenuActions( GuildManager.Instance, selectedMember ).Count - 1;
	}

	// One opener for click AND Space — seeds at open so no frame paints the
	// roster index; Tick's open edge is the net for any other path.
	private void OpenMemberMenu( GuildMemberInfo m )
	{
		selectedMember = m;
		showMemberMenu = true;
		SeedMemberMenuCursor();
	}

	private void TickMemberMenuInput()
	{
		var gm = GuildManager.Instance;
		var sm = selectedMember;
		var actions = GetMemberMenuActions( gm, sm );

		if ( Input.Pressed( "Menu" ) )
		{
			showMemberMenu = false;
			selectedMember = null;
			SoundManager.PlayBack();
			GameHUD.PanelHandledBackKey = true;
			StateHasChanged();
			return;
		}

		if ( Input.Pressed( "Up" ) ) { MoveKb( actions.Count, -1 ); return; }
		if ( Input.Pressed( "Down" ) ) { MoveKb( actions.Count, 1 ); return; }

		if ( UiInput.ConfirmPressed() )
		{
			_kbIndex = Math.Clamp( _kbIndex, 0, actions.Count - 1 );
			switch ( actions[_kbIndex] )
			{
				case "promote": gm.PromoteMember( sm.SteamId ); SoundManager.PlaySelect(); break;
				case "demote":  gm.DemoteMember( sm.SteamId ); SoundManager.PlayClick(); break;
				case "kick":    ConfirmKick( sm ); SoundManager.PlayPopup(); break;
				case "close":   SoundManager.PlayBack(); break;
			}
			showMemberMenu = false;
			selectedMember = null;
			StateHasChanged();
		}
	}

	// ── PICKER MODAL (invite / transfer) ─────────────────────────────────────
	private void TickPickerInput()
	{
		if ( Input.Pressed( "Menu" ) )
		{
			ClosePicker(); // B2 — returns to the drawer when opened from it
			SoundManager.PlayBack();
			ResetKb();
			GameHUD.PanelHandledBackKey = true;
			StateHasChanged();
			return;
		}

		var gm = GuildManager.Instance;
		List<(string connId, string name, long steam)> items = new();
		if ( pickerMode == "invite" )
		{
			foreach ( var c in gm?.GetInvitableCandidates() ?? Enumerable.Empty<InviteCandidate>() )
				items.Add( (c.ConnectionId, c.Name, c.SteamId) );
		}
		else if ( pickerMode == "transfer" )
		{
			var eligible = gm?.Members?.Where( m => m.SteamId != (Connection.Local?.SteamId ?? 0) && m.Role >= GuildRole.Tamer ).ToList() ?? new();
			foreach ( var m in eligible )
				items.Add( (null, m.Name, m.SteamId) );
		}
		if ( items.Count == 0 ) return;

		if ( Input.Pressed( "Up" ) ) { MoveKb( items.Count, -1 ); return; }
		if ( Input.Pressed( "Down" ) ) { MoveKb( items.Count, 1 ); return; }

		if ( UiInput.ConfirmPressed() )
		{
			_kbIndex = Math.Clamp( _kbIndex, 0, items.Count - 1 );
			var it = items[_kbIndex];
			if ( pickerMode == "invite" )
				gm?.InvitePlayer( it.connId, it.name, it.steam );
			else if ( pickerMode == "transfer" )
				gm?.TransferOwnership( it.steam );
			ClosePicker();
			SoundManager.PlaySuccess();
			ResetKb();
			StateHasChanged();
		}
	}

	// ── INLINE EDITOR (MOTD) ─────────────────────────────────────────────────
	// The entry takes focus on open (S4 latch). While it owns typing: Enter
	// SAVES (onsubmit), Esc (oncancel) / Tab hand the keyboard back, every
	// other key types. Unfocused: Q cancels; A/D walk the Save↔Cancel pair
	// (side-by-side row — spatially honest); Space/Enter/E fires the focused
	// button; W climbs back into the text box (it sits ABOVE the pair).
	// Cursor seeded on SAVE (index 0) by StartEditMotd — a non-destructive
	// commit, so confirm-default is the right seat.
	private void TickEditorInput()
	{
		if ( TypingOwnsKeys( motdDraftInput, -1 ) ) return;

		if ( Input.Pressed( "Menu" ) )
		{
			if ( editingMotd ) CancelMotd();
			SoundManager.PlayBack();
			GameHUD.PanelHandledBackKey = true;
			StateHasChanged();
			return;
		}

		// W — back up into the text box (spatially above Save/Cancel).
		if ( Input.Pressed( "Up" ) )
		{
			StampKb();
			RequestEntryFocus( motdDraftInput );
			return;
		}

		if ( Input.Pressed( "Left" ) || Input.Pressed( "Right" ) )
		{
			StampKb();
			int next = Input.Pressed( "Right" ) ? 1 : 0;
			if ( next != _kbIndex )
			{
				_kbIndex = next;
				SoundManager.PlayHover();
				StateHasChanged();
			}
			return;
		}

		if ( UiInput.ConfirmPressed() )
		{
			if ( _kbIndex == 1 ) { CancelMotd(); SoundManager.PlayBack(); }
			else { SaveMotd(); SoundManager.PlaySuccess(); }
			StateHasChanged();
		}
	}

	// Editor pair hover — one-cursor on Save/Cancel.
	private void MotdEditorHover( int idx )
	{
		if ( !editingMotd || _gpKbdMode ) return;
		if ( _kbIndex == idx ) return;
		_kbIndex = idx;
		SoundManager.PlayHover();
		StateHasChanged();
	}

	// ── TEXT-ENTRY GRAMMAR (LANE: input — S3/S5, DOC-5 §11/§18) ─────────────
	// Every TextEntry on this page is a kb STOP on its row:
	//   Space/Enter/E on the row → the box takes focus (deferred one frame so
	//     the confirm key itself is never typed);
	//   while typing → keys type; Tab (here), Enter (onsubmit) or Esc (the
	//     entry's own oncancel event — no Input "Escape" bind, DOC-5 §2)
	//     hand the keyboard back with the cursor still on that row;
	//   Q while unfocused → the surface's normal back.
	// Exception: the MOTD editor's Enter SAVES (submit IS the commit there).
	private void WireTextEntry( TextEntry entry, Action onSubmit )
	{
		if ( entry == null || _wiredEntries.Contains( entry ) ) return;
		_wiredEntries.Add( entry );
		entry.AddEventListener( "onsubmit", ( e ) => onSubmit?.Invoke() );
		entry.AddEventListener( "oncancel", ( e ) => BlurToRow( entry ) );
	}

	private void RequestEntryFocus( TextEntry entry )
	{
		if ( entry == null ) return;
		_focusEntryPending = entry;
		_focusEntryFrames = 1;
		SoundManager.PlayClick();
	}

	// Give the keyboard back; the cursor is already parked on the entry's
	// row (Space put it there, or TypingOwnsKeys dragged it on click-focus).
	private void BlurToRow( TextEntry entry )
	{
		if ( entry == null ) return;
		entry.Blur();
		_entryBlurAt = RealTime.Now; // same-frame latch — see TypingOwnsKeys
		SoundManager.PlayHover();
		StateHasChanged();
	}

	// True while `entry` owns typing (or just stopped, within the blur
	// latch — the Enter that blurred via onsubmit is still edge-true this
	// Tick and must not re-fire as a row confirm). Handles the one exit key
	// that reaches TickInput (Tab) and swallows everything else so WASD/Q
	// type instead of steering. A mouse click-focus also drags the ONE
	// cursor onto the entry's row (DOC-5 §6) so Tab lands where the box is.
	private bool TypingOwnsKeys( TextEntry entry, int rowIndex, string zone = null )
	{
		if ( entry == null ) return false;
		if ( RealTime.Now - _entryBlurAt < 0.05f ) return true;
		if ( !entry.HasFocus ) return false;
		if ( rowIndex >= 0 && ( _kbIndex != rowIndex || ( zone != null && ( !_kbActive || _kbZone != zone ) ) ) )
		{
			if ( zone != null ) { _kbActive = true; _kbZone = zone; }
			_kbIndex = rowIndex;
			StateHasChanged();
		}
		if ( Input.Pressed( "Score" ) ) BlurToRow( entry );
		return true;
	}

	// ── kb-selected predicates — one per focusable region. Each returns true
	//    only when the cursor is active, parked in the matching zone, and on
	//    the given index. The markup applies `guild-kb-selected` accordingly.
	private bool IsLandingKb( int idx ) => _kbActive && _kbZone == "landing" && _kbIndex == idx;
	private bool IsBrowseGridKb( int idx ) => _kbActive && _kbZone == "browse-grid" && _kbIndex == idx;
	private bool IsBrowseDetailKb( int idx ) => _kbActive && _kbZone == "browse-detail" && _kbIndex == idx;
	// One generic predicate for the rebuilt guild page's zones
	// (chips / unlock / info / roster / week / log).
	private bool IsPlazaKb( string zone, int idx ) => _kbActive && _kbZone == zone && _kbIndex == idx;
	// Perk-ladder rows — the overlay owns the keyboard whenever open, so its
	// cursor shows immediately (modal predicate family below).
	private bool IsLadderKb( int idx ) => showPerkLadder && _ladderKbIndex == idx;
	// MOTD editor Save(0)/Cancel(1) pair.
	private bool IsMotdEditorKb( int idx ) => editingMotd && _kbIndex == idx;
	private bool IsCreateKb( int idx ) => _kbActive && _kbZone == "create" && _kbIndex == idx;
	private bool IsRaidSelectKb( int idx ) => _kbActive && _kbZone == "raid-select" && _kbIndex == idx;
	// Modals own the keyboard whenever open, so their cursor shows immediately.
	private bool IsMemberMenuKb( int idx ) => showMemberMenu && _kbIndex == idx;
