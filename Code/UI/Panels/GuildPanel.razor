	// Tree-walk helper — find the first descendant carrying `cls`. Used for live
	// column measurement (the roster grid is flex-wrap).
	private Panel FindKbPanel( string cls )
	{
		return FindKbPanel( this, cls );
	}

	private Panel FindKbPanel( Panel root, string cls )
	{
		if ( root == null ) return null;
		foreach ( var c in root.Children )
		{
			if ( c.HasClass( cls ) ) return c;
			var found = FindKbPanel( c, cls );
			if ( found != null ) return found;
		}
		return null;
	}

