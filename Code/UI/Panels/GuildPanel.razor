	//   Short = the identity-band chip's one-liner · Effect = the ladder row.
	// ════════════════════════════════════════════════════════════════════════
	private record WiredPerk( int Level, string Name, string Short, string Effect );

	private static readonly List<WiredPerk> WiredPerks = new()
	{
		new( 5,  "Coffer Cut",      "+5% expedition gold",  "+5% gold from every expedition reward" ),
		new( 10, "Pack Mentor",     "+10% Tamer XP",        "+10% Tamer XP for every member, from every source" ),
		new( 15, "Wider Banner",    "roster cap 35",        "Roster cap raised from 30 to 35 members" ),
		new( 30, "Sharper Eye",     "+10% contract rate",   "+10% contract rate on every wild encounter" ),
		new( 35, "Halls of Renown", "roster cap 40",        "Roster cap raised to 40 members" )
	};

	// First wired perk above the guild's level — null when everything wired
	// is already active (LV 35+).
	private WiredPerk GetNextUnlockPerk()
	{
		int lvl = GuildManager.Instance?.Guild?.Level ?? 1;
		return WiredPerks.FirstOrDefault( p => p.Level > lvl );
	}

	private int GetActivePerkCount()
	{
		int lvl = GuildManager.Instance?.Guild?.Level ?? 1;
		return WiredPerks.Count( p => p.Level <= lvl );
	}

	// ── Bar fills — px widths written from code (the GoalBarPx pattern:
	//    percent widths on absolute children paint full-width in s&box).
	//    Widths mirror the scss tracks: identity XP 440 · goal 480 ·
	//    roster weekly 260.
	private const int IdentXpBarW = 440;
	private const int WeekGoalBarW = 480;
	private const int RosterWeekBarW = 260;

	private int GuildXpBarPx()
		=> (int)Math.Round( IdentXpBarW * Math.Clamp( GetGuildXPPercent() / 100f, 0f, 1f ) );

	private static int WeekGoalBarPx( GuildWeeklyGoal g )
		=> (int)Math.Round( WeekGoalBarW * Math.Clamp( ( g?.PercentComplete ?? 0f ) / 100f, 0f, 1f ) );

	// Scaled to the WEEK'S MAX contributor — zero renders an empty track.
	private static int RosterWeekBarPx( int weeklyXp, int weekMax )
		=> weekMax <= 0 ? 0 : (int)Math.Round( RosterWeekBarW * Math.Clamp( weeklyXp / (float)weekMax, 0f, 1f ) );

	// The goal explains itself — every pool entry ships a Description
	// ("Clear 75 expeditions as a guild"); same string family the hub's
	// guild zone renders (OnlineHubPanel.GoalBlurb — promote to a shared
	// util when a pass may touch that file; its Type-switch fallback only
	// fires for a server goal without a Description).
	private static string GoalBlurb( GuildWeeklyGoal g ) => g?.Description ?? "";

	private string FormatGoalReset()
	{
		var ts = (GuildManager.Instance?.WeeklyGoalsResetAt ?? DateTime.UtcNow) - DateTime.UtcNow;
		if ( ts <= TimeSpan.Zero ) return "RESETS SOON";
		if ( ts.TotalDays >= 1 ) return $"RESETS MON · {(int)ts.TotalDays}D {ts.Hours}H";
		return $"RESETS MON · {ts.Hours}H {ts.Minutes}M";
	}

	// TOP CONTRIBUTOR — the week's highest guild XP; ties break to the
	// earliest join date (main-session ruling). Null when nobody scored.
	private static GuildMemberInfo GetTopContributor( List<GuildMemberInfo> members )
	{
		if ( members == null || members.Count == 0 ) return null;
		var top = members
			.Where( m => m.WeeklyGuildXP > 0 )
			.OrderByDescending( m => m.WeeklyGuildXP )
			.ThenBy( m => m.JoinedAt )
			.FirstOrDefault();
		return top;
	}

	// In-voice glyph — guild voice ROOMS don't exist yet (VoiceChatManager
	// has zero guild references), so "in voice" = the member sits in ANY
	// voice room this lobby can see. When guild rooms land, tighten this to
	// the guild's own room.
	private static bool IsMemberInVoice( GuildMemberInfo m )
	{
		if ( m == null || m.SteamId <= 0 ) return false;
		var rooms = VoiceChatManager.Instance?.Rooms;
		if ( rooms == null ) return false;
		foreach ( var room in rooms )
		{
			if ( room?.Members == null ) continue;
			foreach ( var rm in room.Members )
				if ( rm != null && rm.SteamId == m.SteamId ) return true;
		}
		return false;
	}

	// ── Overlay scrollbar geometry (the Beastbook UpdateDossierScrollbar
	//    recipe, generalized for the roster + log lists). Track top/height
	//    are pinned in the scss (the bands are fixed); only thumb geometry
	//    and the .on arming class are written per tick. Ratio math: rect px
	//    and scroll px are commensurate, so viewH/contentH and offset/maxOff
	//    are unit-free — only the track length needs style-space px.
	// LANE: motion — the CLAIM commit with its Tier-2 payload: keys the
	// goal row's windowed gold flash (gp-pop, 0.6s window > 0.3s anim)
	// and plays the success cue. Both the click and the kb Space route
	// here so the beat is identical. Sanctioned gold moment (the mock's
	// Tier-2 CLAIM ruling); the ration holds — no other gp control
	// plays a gold/success beat.
	private void ClaimGoalWithPop( GuildWeeklyGoal g )
	{
		if ( g == null || !g.Completed || g.Claimed ) return;
		_claimPopGoalId = g.Id;
		_claimPopUntil = RealTime.Now + 0.6f;
		GuildManager.Instance?.ClaimWeeklyGoal( g.Id );
		SoundManager.PlaySuccess();
		StateHasChanged();
	}

	private void UpdateOverlayScrollbar( Panel track, Panel thumb, Panel scroll, ref int trackHCache, ref int thumbHCache, ref int thumbTopCache )
	{
		if ( track == null || thumb == null || scroll == null ) return;

		float maxOff = scroll.ScrollSize.y;
		if ( maxOff < 2f ) { track.SetClass( "on", false ); return; }

		var sr = scroll.Box.Rect;
		if ( sr.Height < 1f ) return;

		float sc = ScaleFromScreen;
		if ( sc <= 0.01f || float.IsNaN( sc ) || float.IsInfinity( sc ) ) sc = 1f;

		int trackH = (int)(sr.Height * sc) - 4;
		if ( trackH < 30 ) return;
		float viewH = sr.Height;
		float contentH = viewH + maxOff;
		int thumbH = Math.Max( 24, (int)(trackH * (viewH / contentH)) );
		int thumbTop = (int)((trackH - thumbH) * (scroll.ScrollOffset.y / maxOff));

		if ( trackH != trackHCache ) { track.Style.Height = Length.Pixels( trackH ); trackHCache = trackH; }
		if ( thumbH != thumbHCache ) { thumb.Style.Height = Length.Pixels( thumbH ); thumbHCache = thumbH; }
		if ( thumbTop != thumbTopCache ) { thumb.Style.Top = Length.Pixels( thumbTop ); thumbTopCache = thumbTop; }
		track.SetClass( "on", true );
	}
