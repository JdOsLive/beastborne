	// LV 45 are raid-gated, LV 40 + LV 50 are copy-only cosmetics — none may
	// render. When a dormant perk gets wired, add its row here and it appears
	// in the ladder + next-unlock chip with zero other changes.
	//   Short = the identity-band chip's one-liner · Effect = the ladder row.
	// ════════════════════════════════════════════════════════════════════════
	private record WiredPerk( int Level, string Name, string Short, string Effect );

	private static readonly List<WiredPerk> WiredPerks = new()
	{
		new( 5,  "Coffer Cut",      "+5% expedition gold",  "+5% gold from every expedition reward" ),
		new( 10, "Pack Mentor",     "+10% Tamer XP",        "+10% Tamer XP for every member, from every source" ),
		new( 15, "Wider Banner",    "roster cap 35",        "Roster cap raised from 30 to 35 members" ),
		new( 30, "Sharper Eye",     "+10% contract rate",   "+10% contract rate on every wild encounter" ),
		new( 35, "Halls of Renown", "roster cap 40",        "Roster cap raised to 40 members" )
	};

	// First wired perk above the guild's level — null when everything wired
	// is already active (LV 35+).
	private WiredPerk GetNextUnlockPerk()
	{
		int lvl = GuildManager.Instance?.Guild?.Level ?? 1;
		return WiredPerks.FirstOrDefault( p => p.Level > lvl );
	}

	private int GetActivePerkCount()
	{
		int lvl = GuildManager.Instance?.Guild?.Level ?? 1;
		return WiredPerks.Count( p => p.Level <= lvl );
	}

	// ── Bar fills — px widths written from code (the GoalBarPx pattern:
	//    percent widths on absolute children paint full-width in s&box).
	//    Widths mirror the scss tracks: identity XP 440 · goal 480 ·
	//    roster weekly 260.
	private const int IdentXpBarW = 440;
	private const int WeekGoalBarW = 480;
	private const int RosterWeekBarW = 200; // run 3 — the inline week stat's bar (was 260 under the label)

	private int GuildXpBarPx()
		=> (int)Math.Round( IdentXpBarW * Math.Clamp( GetGuildXPPercent() / 100f, 0f, 1f ) );

	private static int WeekGoalBarPx( GuildWeeklyGoal g )
		=> (int)Math.Round( WeekGoalBarW * Math.Clamp( ( g?.PercentComplete ?? 0f ) / 100f, 0f, 1f ) );

	// Scaled to the WEEK'S MAX contributor — zero renders an empty track.
	private static int RosterWeekBarPx( int weeklyXp, int weekMax )
		=> weekMax <= 0 ? 0 : (int)Math.Round( RosterWeekBarW * Math.Clamp( weeklyXp / (float)weekMax, 0f, 1f ) );

	// The goal explains itself — every pool entry ships a Description
	// ("Clear 75 expeditions as a guild"); same string family the hub's
	// guild zone renders (OnlineHubPanel.GoalBlurb — promote to a shared
	// util when a pass may touch that file; its Type-switch fallback only
	// fires for a server goal without a Description).
	private static string GoalBlurb( GuildWeeklyGoal g ) => g?.Description ?? "";

	private string FormatGoalReset()
	{
		var ts = (GuildManager.Instance?.WeeklyGoalsResetAt ?? DateTime.UtcNow) - DateTime.UtcNow;
		if ( ts <= TimeSpan.Zero ) return "RESETS SOON";
		if ( ts.TotalDays >= 1 ) return $"RESETS MON · {(int)ts.TotalDays}D {ts.Hours}H";
		return $"RESETS MON · {ts.Hours}H {ts.Minutes}M";
	}

	// TOP CONTRIBUTOR — the week's highest guild XP; ties break to the
	// earliest join date (main-session ruling). Null when nobody scored.
	private static GuildMemberInfo GetTopContributor( List<GuildMemberInfo> members )
	{
		if ( members == null || members.Count == 0 ) return null;
		var top = members
			.Where( m => m.WeeklyGuildXP > 0 )
			.OrderByDescending( m => m.WeeklyGuildXP )
			.ThenBy( m => m.JoinedAt )
			.FirstOrDefault();
		return top;
	}

	// In-voice glyph — guild voice ROOMS don't exist yet (VoiceChatManager
	// has zero guild references), so "in voice" = the member sits in ANY
	// voice room this lobby can see. When guild rooms land, tighten this to
	// the guild's own room.
	private static bool IsMemberInVoice( GuildMemberInfo m )
	{
		if ( m == null || m.SteamId <= 0 ) return false;
		var rooms = VoiceChatManager.Instance?.Rooms;
		if ( rooms == null ) return false;
		foreach ( var room in rooms )
		{
			if ( room?.Members == null ) continue;
			foreach ( var rm in room.Members )
				if ( rm != null && rm.SteamId == m.SteamId ) return true;
		}
		return false;
	}

	// ── Overlay scrollbar geometry (the Beastbook UpdateDossierScrollbar
	//    recipe, generalized for the roster + log lists). Track top/height
	//    are pinned in the scss (the bands are fixed); only thumb geometry
	//    and the .on arming class are written per tick. Ratio math: rect px
	//    and scroll px are commensurate, so viewH/contentH and offset/maxOff
	//    are unit-free — only the track length needs style-space px.
	// ═══ LANE: motion (run 2) — pending-row beats, joined beat, log ladder ═══

	// Pending rows are keyed by SteamId + name (the dev fakes share SteamId 0).
	private static string ProwKey( GuildJoinRequest r ) => r == null ? "" : $"{r.SteamId}|{r.PlayerName}";
	private bool IsProwLeaving( GuildJoinRequest r ) => r != null && _prowLeaving.ContainsKey( ProwKey( r ) );
	private string ProwLeavingClass( GuildJoinRequest r )
		=> r != null && _prowLeaving.TryGetValue( ProwKey( r ), out var lv ) ? (lv.accept ? "gp-leaving-acc" : "gp-leaving-deny") : "";

	// ACCEPT — stamp the fold, arm the joined watch, then the real call. The
	// row folds NOW (Tier 2, 0.2s) and stays folded (`both`) until the server
	// round-trip removes the request; OnError clears the mark (row returns).
	private void AcceptPendingWithFold( GuildJoinRequest r )
	{
		var gm = GuildManager.Instance;
		if ( gm == null || r == null || IsProwLeaving( r ) ) return;
		_prowLeaving[ProwKey( r )] = (true, RealTime.Now);
		if ( r.SteamId > 0 ) { _joinWatchSteamId = r.SteamId; _joinWatchUntil = RealTime.Now + 8f; }
		gm.ApproveJoinRequest( r );
		SoundManager.PlaySelect();
		PlazaValidatePendingCursor(); // LANE: input — the cursor never rides a folding row
		StateHasChanged();
	}

	// DENY — quiet 0.16s collapse, then the real call.
	private void DenyPendingWithCollapse( GuildJoinRequest r )
	{
		var gm = GuildManager.Instance;
		if ( gm == null || r == null || IsProwLeaving( r ) ) return;
		_prowLeaving[ProwKey( r )] = (false, RealTime.Now);
		gm.DenyJoinRequest( r );
		SoundManager.PlayDeny();
		PlazaValidatePendingCursor(); // LANE: input — the cursor never rides a folding row
		StateHasChanged();
	}

	private bool IsJoinedPop( long steamId ) => steamId > 0 && steamId == _joinedPopSteamId && RealTime.Now < _joinedPopUntil;

	// Log entries are REBUILT from the server on every fetch (no stable
	// identity) — key by content.
	private static string LogKey( GuildLogEntry e ) => e == null ? "" : $"{e.Timestamp.Ticks}|{e.Action}|{e.PlayerName}|{e.Details}";

	// ── THE LOG view rows (run 3) ──
	// The visible list is a VIEW of ActivityLog, built once per render:
	//   1. GROUPING — CONSECUTIVE entries with the same actor ("" for
	//      SYSTEM), the same Action AND the same rendered text fold into ONE
	//      row that carries the NEWEST entry (its timestamp shows) and a
	//      Count for the ×N chip: "Weekly stats reset ×6", "JdOs updated the
	//      guild ×3" (run 3 follow-up — actor rows fold too). Distinct
	//      actions, or the same action by different actors, stay separate.
	//   2. IDENTITY — the row's motion key is the newest entry's LogKey
	//      (LogRowMotionClass( row.Entry, idx )), so a fresh reset landing
	//      on top of a folded run is a NEW key = the gp-lnew ripple, exactly
	//      as an ungrouped new row would; the ladder rungs stay by index.
	//   3. COPY — server copy that restates the actor ("ONEearKID was
	//      approved by JdOs" under an actor span "ONEearKID") loses the
	//      leading name; "Weekly stats have been reset" → "Weekly stats
	//      reset" (plain words). Core untouched — this is the client's read.
	private sealed class GuildLogRow
	{
		public GuildLogEntry Entry;   // newest entry of the run — timestamp + motion key
		public string Actor = "";     // "" = no actor span (SYSTEM)
		public string Text = "";
		public int Count = 1;         // > 1 = the ×N chip
	}

	private int _logVisibleRows = 0;  // set at render from gpLogRows.Count → BuildHash

	private static bool IsSystemLogEntry( GuildLogEntry e )
		=> e != null && ( string.IsNullOrWhiteSpace( e.PlayerName ) || string.Equals( e.PlayerName.Trim(), "System", StringComparison.OrdinalIgnoreCase ) );

	private static string LogRowText( GuildLogEntry e )
	{
		if ( e == null ) return "";
		var text = LogActionText( e );
		if ( !IsSystemLogEntry( e ) && !string.IsNullOrEmpty( text ) && text.StartsWith( e.PlayerName, StringComparison.OrdinalIgnoreCase ) )
		{
			var rest = text.Substring( e.PlayerName.Length ).TrimStart();
			if ( rest.Length > 0 ) text = rest;   // "X was approved by Y" → "was approved by Y" (actor span already says X)
		}
		if ( string.Equals( text, "Weekly stats have been reset", StringComparison.OrdinalIgnoreCase ) ) text = "Weekly stats reset";
		return text;
	}

	// `sorted` = newest first (the razor's gpLog). Pure — no panel state.
	private static List<GuildLogRow> BuildLogRows( List<GuildLogEntry> sorted )
	{
		var rows = new List<GuildLogRow>();
		if ( sorted == null ) return rows;
		for ( int i = 0; i < sorted.Count; i++ )
		{
			var e = sorted[i];
			if ( e == null ) continue;
			var text = LogRowText( e );
			var actor = IsSystemLogEntry( e ) ? "" : ( e.PlayerName ?? "" );
			var row = new GuildLogRow { Entry = e, Actor = actor, Text = text, Count = 1 };
			// Fold the run: same actor + same Action + same rendered text.
			while ( i + 1 < sorted.Count )
			{
				var n = sorted[i + 1];
				if ( n == null ) break;
				var nActor = IsSystemLogEntry( n ) ? "" : ( n.PlayerName ?? "" );
				if ( !string.Equals( nActor, actor, StringComparison.OrdinalIgnoreCase ) ) break;
				if ( !string.Equals( n.Action, e.Action, StringComparison.Ordinal ) ) break;
				if ( !string.Equals( LogRowText( n ), text, StringComparison.Ordinal ) ) break;
				row.Count++; i++;
			}
			rows.Add( row );
		}
		return rows;
	}

	// Grouped row count for callers outside the render (the kb walk).
	private static int CountLogRows( GuildManager gm )
		=> BuildLogRows( ( gm?.ActivityLog ?? new List<GuildLogEntry>() ).OrderByDescending( e => e.Timestamp ).ToList() ).Count;

	// Called from the plaza body's render (else-branch head): arms the ladder
	// on the body's FIRST render after each (re)mount — first open and every
	// return from settings. Tick clears _plazaBodyRendered while the body is
	// away. Render-time mutation is deliberate: arming from Tick would paint
	// one frame of un-laddered rows before the rungs land (a blink).
	private void ArmLogLadderOnMount()
	{
		if ( _plazaBodyRendered ) return;
		_plazaBodyRendered = true;
		_logLadderUntil = RealTime.Now + 0.9f; // the 0.84s ladder + slack
		_logNewUntil.Clear();
	}

	// Motion class per log row. ARMED → rung by index (rows 8+ share rung 7)
	// and every key is recorded. After → "" for known keys; a key seen for
	// the FIRST time ripples (gp-lnew, 0.35s). Under either diff model no
	// existing row replays: keyed rows keep their class string, positional
	// rows only change class where the new entry sits.
	private string LogRowMotionClass( GuildLogEntry e, int lIdx )
	{
		var key = LogKey( e );
		if ( RealTime.Now < _logLadderUntil )
		{
			_logKnownKeys.Add( key );
			return lIdx >= 7 ? "gp-lr7" : "gp-lr" + lIdx;
		}
		if ( _logKnownKeys.Add( key ) ) _logNewUntil[key] = RealTime.Now + 0.35f;
		return _logNewUntil.TryGetValue( key, out var until ) && RealTime.Now < until ? "gp-lnew" : "";
	}

	private int ActiveLogNewCount()
	{
		int n = 0;
		foreach ( var kv in _logNewUntil ) if ( RealTime.Now < kv.Value ) n++;
		return n;
	}

	// Per-tick housekeeping for the run-2 beats (myguild only).
	private void TickMotionBeats()
	{
		var gm = GuildManager.Instance;
		if ( gm == null ) return;

		// The plaza body is away (settings view up) → the ladder re-arms on
		// its next first render.
		if ( showSettingsView ) _plazaBodyRendered = false;

		// Leaving marks: drop when the request is gone (server confirmed) or
		// after 6s (a lost round-trip must not leave a ghost fold).
		if ( _prowLeaving.Count > 0 )
		{
			List<string> drop = null;
			foreach ( var kv in _prowLeaving )
			{
				bool present = false;
				if ( gm.JoinRequests != null )
					foreach ( var jr in gm.JoinRequests ) if ( ProwKey( jr ) == kv.Key ) { present = true; break; }
				if ( !present || RealTime.Now - kv.Value.at > 6f ) (drop ??= new()).Add( kv.Key );
			}
			if ( drop != null ) foreach ( var k in drop ) _prowLeaving.Remove( k );
		}

		// Joined watch: the accepted tamer's row appears → window gp-joined on
		// it (the class is present from the row's FIRST mount, so the keyframe
		// fires with the row). Give up after 8s.
		if ( _joinWatchSteamId > 0 )
		{
			bool here = false;
			if ( gm.Members != null )
				foreach ( var mm in gm.Members ) if ( mm != null && mm.SteamId == _joinWatchSteamId ) { here = true; break; }
			if ( here )
			{
				_joinedPopSteamId = _joinWatchSteamId;
				_joinedPopUntil = RealTime.Now + 0.8f;
				_joinWatchSteamId = 0;
			}
			else if ( RealTime.Now > _joinWatchUntil ) _joinWatchSteamId = 0;
		}

		// Expired ripples leave the dictionary (BuildHash reads the live count).
		if ( _logNewUntil.Count > 0 )
		{
			List<string> gone = null;
			foreach ( var kv in _logNewUntil ) if ( RealTime.Now >= kv.Value ) (gone ??= new()).Add( kv.Key );
			if ( gone != null ) foreach ( var k in gone ) _logNewUntil.Remove( k );
		}
	}

	// ═══ LANE: motion (run 3) — the NO-GUILD views: exit latch, row ladder,
	//     invite folds, the guild-lands edges ═══

	// Arm the view exit latch: the root wears `cls` for 0.12s, then Tick runs
	// `commit` (the state flip that unmounts the branch). Idempotent while a
	// latch is live — a second press mid-fade is a no-op, its state unchanged.
	private void BeginViewExit( string cls, Action commit )
	{
		if ( ViewLeaving ) return;
		_viewExitClass = cls ?? "";
		_viewExitCommit = commit;
		_viewExitUntil = RealTime.Now + 0.12f;
		StateHasChanged();
	}

	// Row ladder — 0.7s of rungs + slack. Touched rows forget on arm.
	private void ArmRowLadder()
	{
		_rowLadderUntil = RealTime.Now + 0.75f;
		_rowLadderTouched.Clear();
	}

	// Called from the lists' render heads (first render after each mount —
	// the ArmLogLadderOnMount recipe; Tick clears the flags while the list is
	// away). Render-time mutation is deliberate: arming from Tick would paint
	// one frame of un-laddered rows first (a blink).
	private void ArmBrowseLadderOnMount()
	{
		if ( _browseListRendered ) return;
		_browseListRendered = true;
		ArmRowLadder();
	}

	private void ArmLandingLadderOnMount()
	{
		if ( _landingListRendered ) return;
		_landingListRendered = true;
		ArmRowLadder();
	}

	// Motion class for a list row while the ladder is armed: rung by index
	// (8 rungs; rows 8+ mount static), EXCEPT rows the cursor has touched in
	// this window — the cursor row's class string changes on every hop, and a
	// remount would replay the rung (hold + fade = a blink), so touched rows
	// carry nothing and mount whole. After the window every row is "" (the
	// one remount at expiry lands on already-opaque rows — the log's law).
	private string RowLadderClass( int idx, bool rowKb )
	{
		if ( RealTime.Now >= _rowLadderUntil ) return "";
		if ( rowKb ) { _rowLadderTouched.Add( idx ); return ""; }
		if ( _rowLadderTouched.Contains( idx ) ) return "";
		return idx >= 8 ? "" : "gp-rr" + idx;
	}

	// Landing invite rows — keyed by the invite's three strings (no id on
	// GuildInvite; Core is read-only for this lane).
	private static string IrowKey( GuildInvite i ) => i == null ? "" : $"{i.GuildTag}|{i.GuildName}|{i.InviterName}";
	private string IrowLeavingClass( GuildInvite i )
		=> i != null && _irowLeaving.TryGetValue( IrowKey( i ), out var lv ) ? ( lv.accept ? "gp-leaving-acc" : "gp-leaving-deny" ) : "";

	// ACCEPT — the row folds NOW (gpProwAccept, 0.2s, `both`) and stays folded
	// until the invite leaves PendingInvites or the guild lands (the Tick edge
	// fades the landing to the plaza); OnError gives the row back.
	private void AcceptInviteWithFold( GuildInvite i )
	{
		if ( i == null || _irowLeaving.ContainsKey( IrowKey( i ) ) ) return;
		_irowLeaving[IrowKey( i )] = (true, RealTime.Now);
		AcceptInvite( i );
		SoundManager.PlaySelect();
		StateHasChanged();
	}

	// DECLINE — the quiet 0.16s collapse (no colour — a refusal is not a beat).
	private void DeclineInviteWithCollapse( GuildInvite i )
	{
		if ( i == null || _irowLeaving.ContainsKey( IrowKey( i ) ) ) return;
		_irowLeaving[IrowKey( i )] = (false, RealTime.Now);
		DeclineInvite( i );
		SoundManager.PlayDeny();
		StateHasChanged();
	}

	// Per-tick housekeeping for the run-3 beats (every view).
	private void TickNoGuildMotion()
	{
		// Exit latch expiry → the stored commit (the real branch swap).
		if ( _viewExitUntil > 0f && RealTime.Now >= _viewExitUntil )
		{
			_viewExitUntil = -1f;
			var commit = _viewExitCommit;
			_viewExitCommit = null;
			commit?.Invoke();
			StateHasChanged();
		}

		// The lists' first-render arms reset while they are away; so do the
		// branch flags (the guild-lands edge only fires on a branch that rendered).
		bool browseListUp = guildView == "browse" && viewingGuild == null;
		if ( !browseListUp ) _browseListRendered = false;
		if ( guildView != "landing" ) { _landingListRendered = false; _landingUp = false; }
		if ( guildView != "myguild" ) _createUp = false;

		// Browse data landing: a fetch that fills an EMPTY list (the open-time
		// load) or one the player asked for (REFRESH) re-cascades the rows.
		// Rows already on screen keep their class strings (no remount) unless
		// the window had expired — then they replay too, which IS the refresh.
		if ( browseListUp && _wasLoadingGuilds && !isLoadingGuilds && ( _browseRowsRendered == 0 || _browseRearmOnLoad ) )
		{
			_browseRearmOnLoad = false;
			ArmRowLadder();
		}
		_wasLoadingGuilds = isLoadingGuilds;

		// Invite rows leaving: drop when the invite is gone (server confirmed)
		// or after 6s (a lost round-trip must not leave a ghost fold).
		if ( _irowLeaving.Count > 0 )
		{
			var invites = GuildManager.Instance?.PendingInvites;
			List<string> drop = null;
			foreach ( var kv in _irowLeaving )
			{
				bool present = false;
				if ( invites != null )
					foreach ( var iv in invites ) if ( IrowKey( iv ) == kv.Key ) { present = true; break; }
				if ( !present || RealTime.Now - kv.Value.at > 6f ) (drop ??= new()).Add( kv.Key );
			}
			if ( drop != null ) foreach ( var k in drop ) _irowLeaving.Remove( k );
		}

		// The guild LANDS under a no-guild view (an ACCEPT came back on the
		// landing / FOUND GUILD came back on the create form): fade that view
		// under the latch, then the plaza mounts with its own cascade. Before
		// this nothing flipped the landing at all (it stayed up in a guild).
		if ( InGuildLive() && !ViewLeaving )
		{
			if ( guildView == "landing" && _landingUp )
				BeginViewExit( "gp-leaving", () => { guildView = "myguild"; _landingUp = false; ResetKb(); } );
			else if ( guildView == "myguild" && _createUp )
				BeginViewExit( "gp-leaving", () => { _createUp = false; ResetKb(); } );
		}
	}

	// LANE: motion — the CLAIM commit with its Tier-2 payload: keys the
	// goal row's windowed gold flash (gp-pop, 0.6s window > 0.3s anim)
	// and plays the success cue. Both the click and the kb Space route
	// here so the beat is identical. Sanctioned gold moment (the mock's
	// Tier-2 CLAIM ruling); the ration holds — no other gp control
	// plays a gold/success beat.
	private void ClaimGoalWithPop( GuildWeeklyGoal g )
	{
		if ( g == null || !g.Completed || g.Claimed ) return;
		_claimPopGoalId = g.Id;
		_claimPopUntil = RealTime.Now + 0.6f;
		GuildManager.Instance?.ClaimWeeklyGoal( g.Id );
		SoundManager.PlaySuccess();
		StateHasChanged();
	}

	private void UpdateOverlayScrollbar( Panel track, Panel thumb, Panel scroll, ref int trackHCache, ref int thumbHCache, ref int thumbTopCache )
	{
		if ( track == null || thumb == null || scroll == null ) return;

		float maxOff = scroll.ScrollSize.y;
		if ( maxOff < 2f ) { track.SetClass( "on", false ); return; }

		var sr = scroll.Box.Rect;
		if ( sr.Height < 1f ) return;

		float sc = ScaleFromScreen;
		if ( sc <= 0.01f || float.IsNaN( sc ) || float.IsInfinity( sc ) ) sc = 1f;

		int trackH = (int)(sr.Height * sc) - 4;
		if ( trackH < 30 ) return;
		float viewH = sr.Height;
		float contentH = viewH + maxOff;
		int thumbH = Math.Max( 24, (int)(trackH * (viewH / contentH)) );
		int thumbTop = (int)((trackH - thumbH) * (scroll.ScrollOffset.y / maxOff));

		if ( trackH != trackHCache ) { track.Style.Height = Length.Pixels( trackH ); trackHCache = trackH; }
		if ( thumbH != thumbHCache ) { thumb.Style.Height = Length.Pixels( thumbH ); thumbHCache = thumbH; }
		if ( thumbTop != thumbTopCache ) { thumb.Style.Top = Length.Pixels( thumbTop ); thumbTopCache = thumbTop; }
		track.SetClass( "on", true );
	}
}
