	// S13 — ONE save path for the drawer's Save Changes (mouse + kb). Each
	// PUT fires only if its section actually changed against the saved guild,
	// and the success chime plays ONCE (nothing changed → a quiet close).
	// GuildManager has no combined update (Core is read-only for this lane):
	// when BOTH the emblem and the settings changed we still issue two PUTs
	// (two refreshes) — flagged for a combined UpdateGuild API. Min-rank /
	// auto-kick / inactive-days lost their UI rows (brief §2 cuts) but keep
	// round-tripping their stored values so the manager signature is untouched.
	private void SaveSettingsAndClose()
	{
		var g = GuildManager.Instance?.Guild;
		settingsDescription = settingsDescInput?.Text ?? settingsDescription;

		bool emblemDirty = g == null
			|| emblemColor != g.EmblemColor || emblemIcon != g.EmblemIcon || emblemShape != g.EmblemShape;
		bool settingsDirty = g == null
			|| settingsJoinMode != g.JoinMode || settingsMinLevel != g.MinLevel
			|| ( settingsDescription ?? "" ) != ( g.Description ?? "" );

		if ( emblemDirty ) GuildManager.Instance?.UpdateEmblem( emblemColor, emblemIcon, emblemShape );
		if ( settingsDirty ) GuildManager.Instance?.UpdateGuildSettings( settingsJoinMode, settingsMinLevel, settingsMinRank, settingsAutoKick, settingsInactiveDays,
			settingsDescription );

		if ( emblemDirty || settingsDirty ) SoundManager.PlaySuccess();
		else SoundManager.PlayBack();

		CloseSettingsView(); // LANE: motion — same 0.12s exit latch as BACK / Q
	}

