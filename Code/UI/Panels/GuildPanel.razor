@namespace Beastborne.UI.Panels
@using System
@using System.Linq
@using System.Collections.Generic
@using Sandbox
@using Sandbox.UI
@using Beastborne.Core
@using Beastborne.Data
@using Beastborne.Systems
@using Beastborne.UI.Components
@using Beastborne.UI.Primitives
@inherits Panel

<div class="guild-panel">

@if ( guildView == "landing" )
{
	<!-- ═══ LANDING (no guild) — run 3 LAYOUT, house dialect (the plaza's
	     gp-* chrome). The hub's FIND A GUILD lands a new player here.
	     HEADER 1920×110 + 2 seam = 112 · kicker GUILD · title GUILDS 38/44
	     · polygon seams · blue waves .16/.24 · right slot BACK TO HUB · Q.
	     BODY pad 20/40/20/40 → lane 1840 × 928 (1080 − 112 − 40).
	     ONE slab pair, top-aligned (PADDING-BOX — declared INCLUDES padding):
	       LEFT  JOIN A GUILD   912 × glLeftH   x 40–952
	       RIGHT START YOUR OWN 912 × 216       x 968–1880   (912+16+912 = 1840 ✓)
	     Slab anatomy: band 36 + body pad 24 + copy 26 + 20 + BbButton 56 +
	     16 + status line 14 + pad 24 = 216 ✓.
	     LEFT grows for PENDING INVITES: + 24 + kicker 24 + 8 + n×72 +
	     (n−1)×8 + list pad 24 = 288 + 80n (1 → 368 … 8 → 928 = the cap;
	     9+ scroll). Invite rows = the .gp-prow recipe at 860 (+4 seam =
	     864 = 912 − 48 pad): 16 + emblem 44 + 20 + text 400 + spacer 144
	     + ACCEPT 104 + 16 + DECLINE 100 + 16 = 860 ✓ — DIRECT scroll children.
	     DOC-1 §19 bend: when invites exist the two slab bottoms do NOT
	     align (right stays 216) — the alternative (a right slab stretched
	     to match with 700px of nothing in it) breaks §10 harder.
	     THIRD SLAB (audit closeout, run 3) — RECRUITING NOW, full-width
	     under the pair (the 712px page void at 0 invites was the blocker):
	       .gl-pair  1840 × glLeftH (row: the two slabs above)
	       gap 16
	       .gl-rec   1840 × glRecH = 928 − 16 − glLeftH   (216 → 696)
	     Anatomy: band 36 (chipstamp RECRUITING NOW · darkchip N OPEN ·
	     SEE ALL · BROWSE chip 26) + list (pad 16/12/12/12 → lane 1816) of
	     the .gb-row recipe verbatim (1812 + 4 seam; the browse row math)
	     for the top glRecM guilds from GetVisibleGuilds() (the same source
	     + sort as the browse list and the "N guilds recruiting" line).
	     Rows that FIT: m = floor((glRecH − 36 − 28) / 100) clamped 0..6
	       0 invites → 696 → 6 rows: 36 + 16 + 6×88 + 5×12 + 12 = 652,
	                  44 slack INSIDE the slab (the browse list's 76-slack
	                  precedent; the brief's 660 summed 16+528+60+12 as 660,
	                  it is 616 — flagged) · 1 → 544 → 4 · 2 → 464 → 4 ·
	       3 → 384 → 3 · 4 → 304 → 2 · 5+ → 224 → 1 < 2 → the slab is
	       DROPPED (invites are the priority content; the pair stands alone
	       as before). Rows are DIRECT children of .gl-rec-list (DOC-1 §12);
	       no wrapper. Empty list → ONE honest line (+ the SEE ALL chip in
	       the band — DOC-1 §10 wants a normal-sized action, and browse still
	       has REFRESH). dev_guildview landing0 forces the empty line.
	     LANE: input (run 3 + closeout) — the cursor graph is GEOMETRY (DOC-5 §21):
	     LEFT column = BROWSE (0) · invite rows (1..n; A/D = ACCEPT ⇄ DECLINE
	     sub-cursor _kbLandBtn) — W/S walk it; RIGHT column = CREATE (n+1),
	     reached by D (BROWSE ⇄ CREATE sit at the same height; D off a
	     row's DECLINE hops there too) and left by A → BROWSE.
	     RECRUITING rows = n+2 .. n+1+m (full width, under both slabs):
	     S past the last LEFT stop (BROWSE or the last invite row) → rec row
	     0; W off rec row 0 → that last left stop; W/S walk the rows; S past
	     the last → silent clamp. On a rec row A/D = row ⇄ its JOIN/REQUEST
	     (_kbLandBtn 0/1 — the browse sub-cursor recipe; rows without a
	     button hold 0); D past JOIN clamps (CREATE sits ABOVE — a hop up
	     would lie). Space: row → browse with THAT guild's detail open
	     (OpenRecruitRow) · JOIN → RequestJoinRow (gated → deny). CREATE:
	     W/S silent (nothing above; the rec slab below is reached from the
	     LEFT column only — one entry edge, no ambiguity).
	     Seeded on BROWSE at open (Tick view edge). Q → hub, claimed.
	     Hover moves the same cursor (mouse mode only): LandingHover on the
	     slab bodies (CTAs, target-walked), LandingRowHover on the invite
	     rows, LandingRecHover on the rec rows (JOIN seats the sub-cursor);
	     the SEE ALL chip is mouse-only (BROWSE is its kb twin).
	     LANE: motion (attached, run 3) — ENTER: gp-header gpZoneHeader rung 0,
	     JOIN A GUILD slab rung 1 (gpZoneBand), START YOUR OWN rung 2
	     (gpZoneRoster) — opacity-only like the plaza's (a translate would
	     poison the rows' flex spacers, DOC-7 §15). Invite rows ride the
	     gpRowIn0–7 ladder (RowLadderClass: 0.75s arm from the list's FIRST
	     render; a row the cursor has touched mounts whole — its class string
	     changes per hop, and a remount would replay the rung). ACCEPT /
	     DECLINE = the plaza's gpProwAccept / gpProwDeny via the windowed
	     gp-leaving-* classes (AcceptInviteWithFold / DeclineInviteWithCollapse;
	     OnError gives the row back). RECRUITING slab = gpZoneWeek rung 3;
	     its rows ride the SAME ladder, rungs continue after the invite rows
	     (n + i — one cascade top → bottom; n + m ≤ 6 by the fit math) and
	     take the gpKbLand flash + gp-sent flash BY CLASS (gb-row stamped).
	     ArmLandingLadderOnMount runs at BOTH lists' render heads (idempotent).
	     EXIT: BROWSE / CREATE / the guild landing
	     route through BeginViewExit (root .gp-leaving, 0.12s) — the branch
	     swaps only when the latch expires (the settings sub-view's recipe).
	     LANE: color — the two status lines share TextDim; the gate reads
	     dim, not red (a locked state is quiet). -->
	@{
		var glGm = GuildManager.Instance;
		var glInvites = glGm?.PendingInvites ?? new List<GuildInvite>();
		int glN = glInvites.Count;
		int glLevel = GetTamerLevel();
		int glGold = TamerManager.Instance?.CurrentTamer?.Gold ?? 0;
		bool glLevelGated = glLevel < GuildManager.MIN_LEVEL_TO_JOIN;
		bool glCooldown = glGm?.IsOnHopCooldown() ?? false;
		bool glGoldGated = glGold < GuildManager.GUILD_CREATION_COST;
		bool glCanJoin = !glLevelGated && !glCooldown;
		bool glCanCreate = glCanJoin && !glGoldGated;
		var glRec = LandingRecGuilds();
		int glOpen = glRec.Count;
		// One honest status line per slab — plain words, 12px dim.
		var glJoinLine = glLevelGated ? $"Level {GuildManager.MIN_LEVEL_TO_JOIN} needed to join · you are Lv {glLevel}"
			: glCooldown ? string.Format( L("ui.guild.hop_cooldown"), FormatCooldown() )
			: glOpen > 0 ? $"{glOpen} guilds recruiting right now" : "Browse to see who's recruiting";
		var glCreateLine = glLevelGated ? $"Level {GuildManager.MIN_LEVEL_TO_JOIN} needed · you are Lv {glLevel}"
			: glCooldown ? $"You can found a guild in {FormatCooldown()}"
			: $"Costs {GuildManager.GUILD_CREATION_COST:N0} gold · you have {glGold:N0}";
		int glLeftH = LandingLeftH( glN );
		var glLeftStyle = $"height: {glLeftH}px;";
		var glPairStyle = $"height: {glLeftH}px;"; // column parent → the row's height is the taller slab (left ≥ 216)
		var glInvChip = glN == 1 ? "1 INVITE WAITING" : $"{glN} INVITES WAITING";
		int glCreateIdx = 1 + glN; // rows model: BROWSE 0 · rows 1..n · CREATE n+1 · rec rows n+2.. (TickLandingInput)
		// RECRUITING NOW — the third slab (fit math in LandingRecFit; shared with the kb walk).
		bool glRecUp = LandingRecSlabUp( glN );
		int glRecH = LandingRecH( glN );
		int glRecM = LandingRecCount( glN, glOpen );
		var glRecStyle = $"height: {glRecH}px;";
		var glOpenChip = glOpen == 1 ? "1 OPEN" : $"{glOpen} OPEN";
		var glRecEmpty = isLoadingGuilds ? "Looking for guilds…" : "No guilds are recruiting right now.";
		_landingUp = true; // LANE: motion — the guild-lands edge (TickNoGuildMotion) fades THIS view to the plaza; render-time set, the log-ladder precedent
	}
	<div class="gp-page @(_gpKbdMode ? "kbd-mode" : "mouse-mode") @(ViewLeavingClass)" onmousemove=@OnGpPageMouseMove>
		<div class="gp-header">
			<BbHeaderWaves Accent=@("blue") />
			<div class="gp-h-identity">
				<span class="gp-kicker">GUILD</span>
				<div class="gp-title-row sm">
					<span class="gp-title sm">@L("ui.guild.guilds")</span>
					<div class="gp-seam"></div>
					<div class="gp-seam dim"></div>
				</div>
			</div>
			<div class="gp-toolbar">
				<div class="gp-back" onmouseover=@(() => SoundManager.PlayHover()) onclick=@OnBackClicked>
					<span class="gp-back-label">BACK TO HUB</span>
					<span class="gp-back-cap">Q</span>
				</div>
			</div>
		</div>

		<div class="gp-body gl-body">

			<!-- PAIR 1840 × glLeftH — the two slabs, top-aligned. -->
			<div class="gl-pair" style="@glPairStyle">

			<!-- LEFT — JOIN A GUILD 912 × glLeftH -->
			<div class="gl-slab" style="@glLeftStyle">
				<div class="gp-band">
					<div class="gp-chipstamp"><span>JOIN A GUILD</span></div>
					<div class="gp-band-spacer"></div>
					@if ( glN > 0 )
					{
						<div class="gp-darkchip"><span>@glInvChip</span></div>
					}
				</div>
				<div class="gl-slab-body" onmouseover=@(( e ) => LandingHover( e ))>
					<span class="gl-copy">Browse every guild that's recruiting and ask to join.</span>
					<BbButton Tier="primary" Size=@(56) Label=@L("ui.guild.browse") Class="gl-cta" HoverSound=@false Focused=@(IsLandingKb( 0 )) OnClick=@OnBrowsePressed />
					<span class="gl-sub">@glJoinLine</span>

					@if ( glN > 0 )
					{
						<div class="gl-kick-row">
							<span class="gs-kick">@L("ui.guild.pending_invites")</span>
							<span class="gs-note">accept to join straight away</span>
						</div>
						<!-- Invite rows — flat scroll children. GuildInvite carries
						     no emblem / level / member count (Core is read-only for
						     this lane), so the tile is the shield glyph on the
						     default ground and the sub reads "[TAG] · from Inviter". -->
						<div class="gl-inv-list" @ref="landingInvRef">
							@{ ArmLandingLadderOnMount(); int glIdx = 0; } @* LANE: motion — the row ladder arms on the list's FIRST render (ArmLogLadderOnMount recipe) *@
							@foreach ( var invite in glInvites )
							{
								var inv = invite;
								int rowIdx = 1 + glIdx; // landing stop = the ROW; _kbLandBtn picks ACCEPT (0) / DECLINE (1)
								bool rowKb = IsLandingKb( rowIdx );
								var invSub = $"[{inv.GuildTag}] · from {inv.InviterName}";
								glIdx++;
								// LANE: motion — ladder rung during the arm window (empty once the cursor touched the row / after), fold class while leaving.
								var invRung = RowLadderClass( rowIdx - 1, rowKb );
								var invLeave = IrowLeavingClass( inv );
								<div class="gl-irow @(glIdx % 2 == 0 ? "alt" : "") @(rowKb ? "guild-kb-selected" : "") @invRung @invLeave" onmouseover=@(( e ) => LandingRowHover( rowIdx, e ))>
									<div class="gl-emblem">
										<iconify class="gl-emblem-glyph" icon="lucide:shield" Size=@(24) Color="#ffffff" />
									</div>
									<div class="gp-prow-text">
										<span class="gl-irow-name">@inv.GuildName</span>
										<span class="gp-prow-sub">@invSub</span>
									</div>
									<div class="gl-irow-spacer"></div>
									<BbButton Tier="secondary" Size=@(34) Label=@L("ui.guild.accept") Class="gp-pacc" Disabled=@(!glCanJoin) HoverSound=@false Focused=@(rowKb && _kbLandBtn == 0) OnClick=@(() => AcceptInviteWithFold( inv )) />
									<BbButton Tier="ghost" Size=@(34) Label="DECLINE" Class="gl-pdec" HoverSound=@false Focused=@(rowKb && _kbLandBtn == 1) OnClick=@(() => DeclineInviteWithCollapse( inv )) />
								</div>
							}
						</div>
					}
				</div>
			</div>

			<!-- RIGHT — START YOUR OWN 912 × 216 -->
			<div class="gl-slab gl-slab-create">
				<div class="gp-band">
					<div class="gp-chipstamp"><span>START YOUR OWN</span></div>
					<div class="gp-band-spacer"></div>
				</div>
				<div class="gl-slab-body" onmouseover=@(( e ) => LandingHover( e ))>
					<span class="gl-copy">Found a guild of your own — pick its name, tag and emblem.</span>
					<BbButton Tier="secondary" Size=@(56) Label=@L("ui.guild.create_a_guild") Class="gl-cta" Disabled=@(!glCanCreate) HoverSound=@false Focused=@(IsLandingKb( glCreateIdx )) OnClick=@OnCreatePressed />
					<span class="gl-sub">@glCreateLine</span>
				</div>
			</div>
			</div>

			@if ( glRecUp )
			{
				<!-- RECRUITING NOW 1840 × glRecH — band 36 + the .gb-row list
				     (DIRECT scroll children; rows never exceed the fit, so the
				     scroll child is the recipe, not a need). The band chip is
				     mouse-only: BROWSE (stop 0) is its keyboard twin. -->
				<div class="gl-rec" style="@glRecStyle">
					<div class="gp-band">
						<div class="gp-chipstamp"><span>RECRUITING NOW</span></div>
						<div class="gp-band-spacer"></div>
						@if ( glOpen > 0 )
						{
							<div class="gp-darkchip"><span>@glOpenChip</span></div>
						}
						<div class="gp-chip gl-rec-see" onmouseover=@LandingRecSeeHover onclick=@OnBrowsePressed>
							<span class="gp-chip-label">SEE ALL · BROWSE</span>
						</div>
					</div>
					<div class="gl-rec-list">
						@{ ArmLandingLadderOnMount(); } @* LANE: motion — same arm as the invite list (idempotent; at 0 invites THIS is the list that arms it) *@
						@if ( glOpen == 0 )
						{
							<div class="gl-rec-empty"><span class="gl-rec-empty-t">@glRecEmpty</span></div>
						}
						@for ( int ri = 0; ri < glRecM; ri++ )
						{
							var rg = glRec[ri];
							int rIdx = glCreateIdx + 1 + ri; // landing stop n+2+i; _kbLandBtn = row 0 / JOIN 1
							bool rRowKb = IsLandingKb( rIdx );
							var rBeast = BbEmblem.ResolveBeast( rg.EmblemIcon );
							var rCrop = rBeast != null ? BbEmblem.CropStyleFor( rBeast, 44, 44 ) : "";
							var rFill = BbEmblem.BlendTowardSlab( rg.EmblemColor ?? "#3f8fe0", 0.70f );
							var rTag = $"[{rg.GuildTag}]";
							var rSub = $"LV {rg.Level} · {rg.MemberCount} / {AdCap( rg.Level )} · {JoinModeLabel( rg.JoinMode )}" + ( rg.MinLevel > 1 ? $" · min Lv {rg.MinLevel}" : "" );
							bool rLocked = rg.JoinMode == GuildJoinMode.Closed || rg.JoinMode == GuildJoinMode.InviteOnly;
							var rJoinLabel = rg.JoinMode == GuildJoinMode.Open ? "JOIN" : "REQUEST";
							var rOnline = rg.OnlineCount > 0 ? $"{rg.OnlineCount} ONLINE" : "";
							// LANE: motion — ladder rung continues after the invite rows (n + i); gp-sent = the JOIN/REQUEST commit flash by class.
							var rRung = RowLadderClass( glN + ri, rRowKb );
							var rSent = rg.GuildId == _sentPopGuildId && RealTime.Now < _sentPopUntil ? "gp-sent" : "";
							<div class="gb-row gl-rec-row @(ri % 2 == 1 ? "alt" : "") @(rRowKb ? "guild-kb-selected" : "") @rRung @rSent" onmouseover=@(( e ) => LandingRecHover( rIdx, e )) onclick=@(() => OpenRecruitRow( rg ))>
								<div class="gb-emblem @(rBeast != null ? "beast-tile" : "")" style="background-color: @rFill">
									@if ( rBeast != null )
									{
										<img class="emblem-beast-img" src="@rBeast.IconPath" style="@rCrop" />
									}
									else
									{
										<iconify class="gb-emblem-glyph" icon="@GetEmblemIcon( rg.EmblemIcon )" Size=@(24) Color="#ffffff" />
									}
								</div>
								<div class="gb-name-col">
									<div class="gp-mname-row">
										<span class="gp-mname">@rg.GuildName</span>
										<span class="gb-tag">@rTag</span>
									</div>
									<span class="gb-sub">@rSub</span>
								</div>
								<div class="gb-spacer"></div>
								<div class="gp-presence @(rg.OnlineCount > 0 ? "on" : "")">
									@if ( rg.OnlineCount > 0 )
									{
										<div class="gp-dot"></div>
										<span class="gp-presence-t">@rOnline</span>
									}
								</div>
								<div class="gb-join-host">
									@if ( rLocked )
									{
										<span class="gb-invonly">@JoinModeLabel( rg.JoinMode )</span>
									}
									else
									{
										<BbButton Tier="secondary" Size=@(34) Label=@rJoinLabel Class="gb-join" Disabled=@(!glCanJoin) HoverSound=@false Focused=@(rRowKb && _kbLandBtn == 1) OnClick=@(() => RequestJoinRow( rg )) />
									}
								</div>
							</div>
						}
					</div>
				</div>
			}
		</div>
	</div>
}
else if ( guildView == "browse" )
{
	<!-- ═══ BROWSE GUILDS — run 3 LAYOUT. Same header; title BROWSE GUILDS;
	     right slot = BACK · Q (→ landing, or the plaza when in a guild) +
	     the search chip 180 + the MEMBERS · LEVEL sort pair (.gp-chip family;
	     .on = the FilterBar two-tone in blue). While a guild is open (the
	     detail) the slot holds BACK TO LIST · Q only.
	     BODY pad 20/40/20/40 → ONE slab 1840 × 928: band 36 + list 892
	     (pad 16/12/12/12 → row lane 1816). Row 88 = declared 1812 + 4 seam:
	       16 + emblem 44 + 16 + name col 480 + spacer 940 + online 120 +
	       16 + JOIN 160 + 20 = 1812 ✓   (8 rows: 16 + 8×88 + 7×12 + 12 = 816,
	       76 slack; 9+ scroll).
	     Brief ruling: a flat ROW list, not the DOC-6 §10 card grid — the
	     emblem is a 44 tile like the roster's heads, not the row's art.
	     Join mode from data: Open → JOIN · Request → REQUEST · InviteOnly /
	     Closed → dim INVITE ONLY / CLOSED text in the button's lane.
	     Empty = one honest line + a normal-size REFRESH ghost (NO NOTHING).
	     LANE: input (run 3) — two zones, one cursor: "browse-head" (search
	     chip 0 · MEMBERS 1 · LEVEL 2; A/D across, S → the list) and
	     "browse-grid" (rows; W off row 0 → the head stop last used; A/D =
	     row ⇄ its JOIN/REQUEST sub-cursor _kbBrowseBtn; Space = detail on
	     the row / join on the button; scroll-follow on .gb-row). Empty list
	     = one REFRESH stop (grid 0). R toggles the sort pair (cap by LEVEL).
	     Search: Space on the chip focuses the TextEntry — TypingOwnsKeys
	     grammar, Tab/Enter/Esc hand back, cursor stays on the chip. Detail
	     zone "browse-detail": [JOIN] · BACK TO LIST (A/D and W/S both step
	     the pair — it is a two-stop row), Q → list; list Q → landing/plaza.
	     Seeded on row 0 at open; returning from the detail re-seats the
	     row that opened it.
	     LANE: layout-next — the DETAIL body (.guild-detail, 2026-04 dialect)
	     is hosted inside the slab as-is; only its actions moved to BbButtons
	     and its BACK to the header cap. Full house restyle next run.
	     LANE: motion (attached, run 3) — ENTER: header rung 0, the slab rung 1
	     (gpZoneBand); rows ride the gpRowIn0–7 ladder (RowLadderClass — armed
	     on the list's FIRST render, on a REFRESH, and when the open-time fetch
	     fills an EMPTY list; rows 8+ mount static; cursor-touched rows mount
	     whole); .gb-empty fades on rung 2; the hosted .guild-detail fades on
	     rung 1 (opacity-only override of the 2026-04 viewSlideIn — it sits in
	     a scroll host). SWAPS: list ⇄ detail via BeginViewExit(gp-leaving-sub)
	     (the list/detail host + toolbar fade 0.12s, band stays); BACK via
	     gp-leaving. BEATS: sort apply = windowed gp-pop chip stamp pop;
	     JOIN/REQUEST = windowed gp-sent blue seam flash on the row (the view's
	     one HDR tick, inside the keyframe). LANE: color — INVITE ONLY text is
	     dim, never red (not an error). -->
	@{
		var gbGuilds = GetVisibleGuilds();
		bool gbDetail = viewingGuild != null;
		bool gbInGuild = InGuildLive();
		int gbLevel = GetTamerLevel();
		bool gbGated = gbInGuild || gbLevel < GuildManager.MIN_LEVEL_TO_JOIN || (GuildManager.Instance?.IsOnHopCooldown() ?? false);
		var gbCountChip = isLoadingGuilds ? "LOADING…" : gbGuilds.Count == 1 ? "1 FOUND" : $"{gbGuilds.Count} FOUND";
		var gbBandLabel = gbDetail ? "GUILD" : "GUILDS";
		var gbDetailTag = gbDetail ? $"[{viewingGuild.GuildTag}]" : "";
		var gbSearchCls = ( _kbSearchFocused ? "guild-kb-search-focused " : "" ) + ( IsBrowseHeadKb( 0 ) ? "guild-kb-selected" : "" );
		// LANE: motion — windowed pop: the sort chip that just went active wears gp-pop for 0.4s (SetBrowseSort stamps it).
		bool gbSortPop = RealTime.Now < _sortPopUntil;
		var gbPopMembers = gbSortPop && browseSort == "members" ? "gp-pop" : "";
		var gbPopLevel = gbSortPop && browseSort == "level" ? "gp-pop" : "";
	}
	<div class="gp-page @(_gpKbdMode ? "kbd-mode" : "mouse-mode") @(ViewLeavingClass)" onmousemove=@OnGpPageMouseMove>
		<div class="gp-header">
			<BbHeaderWaves Accent=@("blue") />
			<div class="gp-h-identity">
				<span class="gp-kicker">GUILD</span>
				<div class="gp-title-row sm">
					<span class="gp-title sm">@L("ui.guild.browse_title")</span>
					<div class="gp-seam"></div>
					<div class="gp-seam dim"></div>
				</div>
			</div>
			<div class="gp-toolbar">
				@if ( gbDetail )
				{
					<div class="gp-back" onmouseover=@(() => SoundManager.PlayHover()) onclick=@OnDetailBackPressed>
						<span class="gp-back-label">@L("ui.guild.back_to_list")</span>
						<span class="gp-back-cap">Q</span>
					</div>
				}
				else
				{
					<div class="gp-back" onmouseover=@(() => SoundManager.PlayHover()) onclick=@OnBrowseBackPressed>
						<span class="gp-back-label">@(gbInGuild ? "BACK TO GUILD" : "BACK TO GUILDS")</span>
						<span class="gp-back-cap">Q</span>
					</div>
					<!-- Search chip — a plain 180 TextEntry chip in the .gp-chip
					     family (the FilterBar ShowSearchChip param is another
					     lane's — not depended on). Polled in Tick (no onchange). -->
					<!-- LANE: input — the three header stops (zone "browse-head" 0/1/2);
					     hover moves the one cursor (BrowseHeadHover, mouse mode only).
					     The R cap sits by the pair (the hub's board-filter recipe,
					     cap only — no instruction text). -->
					<div class="gb-search @gbSearchCls" onmouseover=@(() => BrowseHeadHover( 0 ))>
						<iconify class="gb-search-glyph" icon="lucide:search" Size=@(13) Color="#a79dbe" />
						<TextEntry class="gb-search-input" @ref="browseSearchInput" Text="@browseSearchQuery" Placeholder="Search name or tag" />
					</div>
					<div class="gp-chip @(browseSort == "members" ? "on" : "") @(IsBrowseHeadKb( 1 ) ? "guild-kb-selected" : "") @gbPopMembers" onmouseover=@(() => BrowseHeadHover( 1 )) onclick=@(() => SetBrowseSort( "members" ))>
						<span class="gp-chip-label">MEMBERS</span>
					</div>
					<div class="gp-chip @(browseSort == "level" ? "on" : "") @(IsBrowseHeadKb( 2 ) ? "guild-kb-selected" : "") @gbPopLevel" onmouseover=@(() => BrowseHeadHover( 2 )) onclick=@(() => SetBrowseSort( "level" ))>
						<span class="gp-chip-label">LEVEL</span>
					</div>
					<div class="gp-sort-hint"><span class="gp-back-cap">R</span></div>
				}
			</div>
		</div>

		<div class="gp-body gb-body">
			<div class="gb-slab">
				<div class="gp-band">
					<div class="gp-chipstamp"><span>@gbBandLabel</span></div>
					<div class="gp-band-spacer"></div>
					@if ( gbDetail )
					{
						<div class="gp-darkchip"><span>@gbDetailTag</span></div>
					}
					else
					{
						<div class="gp-darkchip"><span>@gbCountChip</span></div>
					}
				</div>

				@if ( gbDetail )
				{
					<!-- GUILD DETAIL — hosted as-is (LANE: layout-next). -->
					<div class="gb-detail-host">
					<div class="guild-detail">
						<div class="detail-header">
							<!-- Ads carry no OwnerSteamId, so the leader-favorite default
							     can't resolve here — beast: picks render, empty falls to
							     the shield glyph. 80×80 window (.guild-detail override). -->
							@{
								var detailEmblemBeast = BbEmblem.ResolveBeast( viewingGuild.EmblemIcon );
								var detailEmblemCrop = detailEmblemBeast != null ? BbEmblem.CropStyleFor( detailEmblemBeast, 80, 80 ) : "";
								var detailFill = BbEmblem.BlendTowardSlab( viewingGuild.EmblemColor ?? "#3f8fe0", 0.70f );
							}
							<div class="detail-emblem @(detailEmblemBeast != null ? "beast-tile" : "")" style="background-color: @detailFill">
								@if ( detailEmblemBeast != null )
								{
									<img class="emblem-beast-img" src="@detailEmblemBeast.IconPath" style="@detailEmblemCrop" />
								}
								else
								{
									<iconify class="detail-emblem-icon" icon="@GetEmblemIcon( viewingGuild.EmblemIcon )" Size=@(32) Color="#ffffff" />
								}
							</div>
							<div class="detail-header-info">
								<div class="detail-name-row">
									<span class="detail-name">@viewingGuild.GuildName</span>
									<span class="detail-level-badge">@($"Lv {viewingGuild.Level}")</span>
									<span class="detail-tag">@($"[{viewingGuild.GuildTag}]")</span>
								</div>
								<span class="detail-owner">@L("ui.guild.founded_by") @viewingGuild.OwnerName</span>
							</div>
						</div>

						@if ( !string.IsNullOrEmpty( viewingGuild.Description ) )
						{
							<div class="detail-description">
								<span class="detail-desc-text">@viewingGuild.Description</span>
							</div>
						}

						<div class="detail-stats-row">
							<div class="detail-stat">
								<span class="detail-stat-value">@viewingGuild.MemberCount</span>
								<span class="detail-stat-label">@L("ui.guild.members")</span>
							</div>
							<div class="detail-stat">
								<span class="detail-stat-value">@viewingGuild.OnlineCount</span>
								<span class="detail-stat-label">@L("ui.guild.online")</span>
							</div>
							<div class="detail-stat">
								<span class="detail-stat-value">@($"{viewingGuild.TotalRP:N0}")</span>
								<span class="detail-stat-label">@L("ui.guild.total_rp")</span>
							</div>
						</div>

						<div class="detail-requirements">
							<span class="detail-req-title">@L("ui.guild.requirements")</span>
							<div class="detail-req-row">
								<span class="detail-req-item">Join: @JoinModeLabel( viewingGuild.JoinMode )</span>
								<span class="detail-req-item">Min Level: @(viewingGuild.MinLevel > 1 ? $"Lv {viewingGuild.MinLevel}" : "None")</span>
								<span class="detail-req-item">Min Rank: @viewingGuild.MinRank</span>
							</div>
						</div>

						<div class="detail-members-section">
							<span class="detail-members-title">@($"Members ({viewingGuildMembers.Count})")</span>
							@if ( isLoadingMembers )
							{
								<span class="detail-members-loading">@L("ui.guild.loading_members")</span>
							}
							else if ( viewingGuildMembers.Count > 0 )
							{
								<div class="detail-members-list">
									@foreach ( var member in viewingGuildMembers )
									{
										<div class="detail-member-chip">
											<iconify class="chip-role" icon="@GuildManager.GetRoleIcon( (GuildRole)member.Role )" Size=@(12) Color="@GuildManager.GetRoleColor( (GuildRole)member.Role )" />
											<span class="chip-name">@member.Name</span>
											<span class="chip-level">@($"{member.Level}")</span>
										</div>
									}
								</div>
							}
							else
							{
								<span class="detail-members-loading">@L("ui.guild.no_members")</span>
							}
						</div>

						@{
							var detailLocked = viewingGuild.JoinMode == GuildJoinMode.Closed || viewingGuild.JoinMode == GuildJoinMode.InviteOnly;
							var detailCanJoin = !gbInGuild && !detailLocked;
							var detailBackIdx = detailCanJoin ? 1 : 0;
							var detailJoinLabel = viewingGuild.JoinMode == GuildJoinMode.Open ? L("ui.guild.join_guild") : L("ui.guild.request_join");
						}
						<!-- Actions — BbButtons (run 3): JOIN secondary 44 (Open /
						     Request) · BACK TO LIST ghost 44. kb: [join], back. -->
						<div class="gb-dactions" onmouseover=@(( e ) => BrowseDetailHover( e, detailBackIdx ))>
							@if ( !gbInGuild )
							{
								@if ( detailLocked )
								{
									<span class="gb-invonly">@JoinModeLabel( viewingGuild.JoinMode )</span>
								}
								else
								{
									<BbButton Tier="secondary" Size=@(44) Label=@detailJoinLabel Class="gb-dbtn gb-djoin" Disabled=@gbGated HoverSound=@false Focused=@(IsBrowseDetailKb( 0 )) OnClick=@OnDetailJoinPressed />
								}
							}
							<BbButton Tier="ghost" Size=@(44) Label=@L("ui.guild.back_to_list") Class="gb-dbtn gb-dback" HoverSound=@false Focused=@(IsBrowseDetailKb( detailBackIdx )) OnClick=@OnDetailBackPressed />
						</div>
					</div>
					</div>
				}
				else
				{
					<!-- GUILD LIST — flat scroll children (rows + the one empty block). -->
					<div class="gb-list" @ref="browseScrollRef">
						@{ ArmBrowseLadderOnMount(); _browseRowsRendered = gbGuilds.Count; } @* LANE: motion — the row ladder arms on the list's FIRST render; the count feeds the data-landed re-arm (an empty list that fills cascades) *@
						@if ( gbGuilds.Count == 0 )
						{
							<!-- LANE: input — the empty list's ONE stop is REFRESH (grid 0). -->
							<div class="gb-empty" onmouseover=@(( e ) => BrowseRowHover( 0, e ))>
								<span class="gb-empty-t">@(isLoadingGuilds ? "Loading guilds…" : string.IsNullOrWhiteSpace( browseSearchQuery ) ? "No guilds are recruiting yet." : "No guild matches that search.")</span>
								<BbButton Tier="ghost" Size=@(44) Label="REFRESH" Class="gb-refresh" Disabled=@isLoadingGuilds HoverSound=@false Focused=@(IsBrowseGridKb( 0 )) OnClick=@OnRefreshGuildsPressed />
							</div>
						}
						@for ( int gi = 0; gi < gbGuilds.Count; gi++ )
						{
							var g = gbGuilds[gi];
							int gIdx = gi;
							var gBeast = BbEmblem.ResolveBeast( g.EmblemIcon );
							var gCrop = gBeast != null ? BbEmblem.CropStyleFor( gBeast, 44, 44 ) : "";
							var gFill = BbEmblem.BlendTowardSlab( g.EmblemColor ?? "#3f8fe0", 0.70f );
							var gTag = $"[{g.GuildTag}]";
							var gSub = $"LV {g.Level} · {g.MemberCount} / {AdCap( g.Level )} · {JoinModeLabel( g.JoinMode )}" + ( g.MinLevel > 1 ? $" · min Lv {g.MinLevel}" : "" );
							bool gLocked = g.JoinMode == GuildJoinMode.Closed || g.JoinMode == GuildJoinMode.InviteOnly;
							var gJoinLabel = g.JoinMode == GuildJoinMode.Open ? "JOIN" : "REQUEST";
							var gOnline = g.OnlineCount > 0 ? $"{g.OnlineCount} ONLINE" : "";
							bool gRowKb = IsBrowseGridKb( gIdx );
							// LANE: motion — ladder rung during the arm window; gp-sent = the JOIN/REQUEST commit flash (windowed, RequestJoinRow stamps it).
							var gRung = RowLadderClass( gIdx, gRowKb );
							var gSent = g.GuildId == _sentPopGuildId && RealTime.Now < _sentPopUntil ? "gp-sent" : "";
							<div class="gb-row @(gi % 2 == 1 ? "alt" : "") @(gRowKb ? "guild-kb-selected" : "") @gRung @gSent" onmouseover=@(( e ) => BrowseRowHover( gIdx, e )) onclick=@(() => OpenGuildRow( g ))>
								<div class="gb-emblem @(gBeast != null ? "beast-tile" : "")" style="background-color: @gFill">
									@if ( gBeast != null )
									{
										<img class="emblem-beast-img" src="@gBeast.IconPath" style="@gCrop" />
									}
									else
									{
										<iconify class="gb-emblem-glyph" icon="@GetEmblemIcon( g.EmblemIcon )" Size=@(24) Color="#ffffff" />
									}
								</div>
								<div class="gb-name-col">
									<div class="gp-mname-row">
										<span class="gp-mname">@g.GuildName</span>
										<span class="gb-tag">@gTag</span>
									</div>
									<span class="gb-sub">@gSub</span>
								</div>
								<div class="gb-spacer"></div>
								<div class="gp-presence @(g.OnlineCount > 0 ? "on" : "")">
									@if ( g.OnlineCount > 0 )
									{
										<div class="gp-dot"></div>
										<span class="gp-presence-t">@gOnline</span>
									}
								</div>
								<div class="gb-join-host">
									@if ( gbInGuild )
									{
									}
									else if ( gLocked )
									{
										<span class="gb-invonly">@JoinModeLabel( g.JoinMode )</span>
									}
									else
									{
										<BbButton Tier="secondary" Size=@(34) Label=@gJoinLabel Class="gb-join" Disabled=@gbGated HoverSound=@false Focused=@(gRowKb && _kbBrowseBtn == 1) OnClick=@(() => RequestJoinRow( g )) />
									}
								</div>
							</div>
						}
					</div>
				}
			</div>
		</div>
	</div>
}
else if ( guildView == "myguild" )
{
	@if ( !InGuildLive() || _createUp )
	{
		<!-- ═══ CREATE A GUILD — run 3 LAYOUT. The SETTINGS sub-view's
		     IDENTITY + RECRUITING slabs reused (same gs-* recipes, gc-*
		     modifiers only where the create form differs), under the same
		     header (title CREATE A GUILD, BACK · Q → landing).
		     BODY pad 16/24/24/24, gap 16 → lanes 1872 × 928 (the settings map):
		       LEFT 1088: IDENTITY 1088×392 + 16 + RECRUITING 1088×520 = 928 ✓
		       RIGHT 768: spacer (flex) + status 14 + 12 + FOUND row 48 at the foot
		     IDENTITY (slab-relative y): NAME · TAG kicker 60–74 · fields 80–126
		     (host 46 = entry 32 + 2 rim + 4 pad ×2 + 2 kb-border ×2; NAME 394 +
		     16 + TAG 114) · COLOR 158–172 · chips 178–214 · BEAST 250–264 ·
		     tiles 266–310 · name 320–334 · fallback 362–376 · pad 16 → 392 ✓
		     RECRUITING: DESCRIPTION 60 · entry 80–328 · JOIN MODE 358–372 ·
		     chips 384–420 · MIN LEVEL 448–462 · chips 474–510 · slack 10 → 520 ✓
		     FOUND GUILD = the view's ONE gold primary, 320×48 r16 (gs-save),
		     right-aligned at x 1576–1896 with the cost line beside it;
		     Disabled while the gate fails (level 10 · 50,000 gold · hop
		     cooldown) — the line beside it says which.
		     Picks made here (colour · beast · description · join mode · min
		     level) are applied the moment the guild lands (OnRefresh →
		     ApplyCreatePicks — CreateGuild takes name + tag only, Core untouched).
		     LANE: input (run 3) — kb rows (TickCreateInput, CreateRow* consts):
		     name 0 · tag 1 · color 2 · beast 3 · description 4 · joinmode 5 ·
		     minlevel 6 · FOUND 7 — one column, W/S walk it (the right slab's
		     FOUND is the column's last stop: nothing else lives on the right).
		     Name/tag/description are TextEntry stops (Space focuses,
		     Tab/Enter/Esc hand back, cursor stays); A/D cycle the four chip
		     rows (verified: the TickCreateInput switch handles COLOR / BEAST /
		     JOIN / LEVEL); Space on FOUND = create (gated → deny blip). Hover
		     moves the same cursor: CreateHover on every row host (mouse mode
		     only). Q → landing (claimed). Seeded on NAME at open (Tick view
		     edge); after a successful create the plaza mounts and the view
		     edge seeds ITS first zone (create → plaza only).
		     LANE: motion (attached, run 3) — ENTER: the slabs carry the settings
		     sub-view's rungs BY CLASS (verified: .gs-ident owns gpZoneBand rung 1,
		     .gs-recruit owns gpZoneRoster rung 2; the gc-* modifiers only size
		     them); the FOUND foot (.gc-foot) takes rung 3 (the gs-save-row
		     recipe) — it was missing. .gc-err-row slides in (gpErrIn) on mount.
		     Colour / beast / join / level chip cycles = the settings swatch tick
		     (the .on two-tone eases 0.14s both ways — inherited, nothing added;
		     a mount pop on .on would replay on every cursor hop, DOC-4 §14).
		     FOUND gated = INPUT's PlayDeny only (the settings SAVE has no visual
		     blip, so none is invented here). EXIT: BACK via BeginViewExit
		     (gp-leaving); FOUND success holds this branch on _createUp until the
		     latch fades it, then the plaza mounts with its own cascade.
		     LANE: color — FOUND is the page's one gold; disabled = the
		     primitive's dim, the status line stays TextDim. -->
		@{
			int gcLevel = GetTamerLevel();
			int gcGold = TamerManager.Instance?.CurrentTamer?.Gold ?? 0;
			bool gcLevelGated = gcLevel < GuildManager.MIN_LEVEL_TO_JOIN;
			bool gcGoldGated = gcGold < GuildManager.GUILD_CREATION_COST;
			bool gcCooldown = GuildManager.Instance?.IsOnHopCooldown() ?? false;
			bool gcCanCreate = !gcLevelGated && !gcGoldGated && !gcCooldown;
			var gcCostLine = gcLevelGated ? $"Level {GuildManager.MIN_LEVEL_TO_JOIN} needed · you are Lv {gcLevel}"
				: gcCooldown ? $"You can found a guild in {FormatCooldown()}"
				: $"Costs {GuildManager.GUILD_CREATION_COST:N0} gold · you have {gcGold:N0}";
			// Preview resolves the PENDING pick as the live emblem will
			// (no owner / members yet — beast key → legacy lucide → shield).
			var gcBeast = BbEmblem.ResolveBeast( emblemIcon );
			var gcFill = BbEmblem.BlendTowardSlab( emblemColor, 0.70f );
			var gcCrop112 = gcBeast != null ? BbEmblem.CropStyleFor( gcBeast, 112, 112 ) : "";
			var gcCrop44 = gcBeast != null ? BbEmblem.CropStyleFor( gcBeast, 44, 44 ) : "";
			var gcChoices = GetEmblemBeastChoices();
			var gcActiveBeastId = ( emblemIcon ?? "" ).StartsWith( "beast:" ) ? emblemIcon.Substring( 6 ) : "";
			int gcActiveTile = gcChoices.FindIndex( s => s.Id == gcActiveBeastId );
			var gcActiveName = gcActiveTile >= 0 ? gcChoices[gcActiveTile].Name.ToUpper() : "";
			var gcNameOffset = $"margin-left: {gcActiveTile * 52}px"; // tile 44 + gap 8
			var gcDescLen = ( createDescription ?? "" ).Length;
			var gcCounter = $"{gcDescLen} / 200";
			var gcJoinNote = JoinModeNote( settingsJoinMode );
			var gcLevelNote = MinLevelNote( settingsMinLevel );
			bool gcHasError = !string.IsNullOrEmpty( errorMessage );
			_createUp = true; // LANE: motion — holds this branch through the exit latch when the guild lands (TickNoGuildMotion edge → plaza); cleared by the commit / on leaving myguild
		}
		<div class="gp-page @(_gpKbdMode ? "kbd-mode" : "mouse-mode") @(ViewLeavingClass)" onmousemove=@OnGpPageMouseMove>
			<div class="gp-header">
				<BbHeaderWaves Accent=@("blue") />
				<div class="gp-h-identity">
					<span class="gp-kicker">GUILD</span>
					<div class="gp-title-row sm">
						<span class="gp-title sm">@L("ui.guild.create_title")</span>
						<div class="gp-seam"></div>
						<div class="gp-seam dim"></div>
					</div>
				</div>
				<div class="gp-toolbar">
					<div class="gp-back" onmouseover=@(() => SoundManager.PlayHover()) onclick=@OnCreateBackPressed>
						<span class="gp-back-label">BACK TO GUILDS</span>
						<span class="gp-back-cap">Q</span>
					</div>
				</div>
			</div>

			<div class="gp-body gs-body">
				<div class="gs-cols">

					<!-- LEFT 1088 -->
					<div class="gs-left">

						<!-- IDENTITY 1088×392 -->
						<div class="gs-ident gc-ident">
							<div class="gp-band">
								<div class="gp-chipstamp"><span>IDENTITY</span></div>
								<div class="gp-band-spacer"></div>
								<div class="gp-darkchip"><span>NAME AND TAG CAN'T BE CHANGED LATER</span></div>
							</div>
							<div class="gs-ident-body">
								<div class="gs-preview-col">
									<div class="gs-preview @(gcBeast != null ? "beast-tile" : "")" style="background-color: @gcFill">
										@if ( gcBeast != null )
										{
											<img class="emblem-beast-img" src="@gcBeast.IconPath" style="@gcCrop112" />
										}
										else
										{
											<iconify class="gs-preview-glyph" icon="@GetEmblemIcon( emblemIcon )" Size=@(64) Color="#ffffff" />
										}
									</div>
									<span class="gs-kick dim gs-preview-kick">PREVIEW</span>
									<div class="gs-twin-row">
										<div class="gs-twin @(gcBeast != null ? "beast-tile" : "")" style="background-color: @gcFill">
											@if ( gcBeast != null )
											{
												<img class="emblem-beast-img" src="@gcBeast.IconPath" style="@gcCrop44" />
											}
											else
											{
												<iconify class="gs-twin-glyph" icon="@GetEmblemIcon( emblemIcon )" Size=@(24) Color="#ffffff" />
											}
										</div>
										<div class="gs-twin-note">
											<span class="gs-note">as the hub</span>
											<span class="gs-note">sees it · 44</span>
										</div>
									</div>
								</div>
								<div class="gs-pick-col">
									<!-- NAME · TAG — the one place these are set. Two TextEntry
									     stops (kb rows 0 / 1), each in a .gc-field kb host
									     (the .gs-entry-wrap recipe at row size). -->
									<div class="gs-kick-row">
										<span class="gs-kick">NAME · TAG</span>
										<span class="gs-note">name 3–24 letters · tag 2–5, shown as [TAG] beside your name</span>
									</div>
									<div class="gc-fields">
										<div class="gc-field @(IsCreateKb( CreateRowName ) ? "guild-kb-selected" : "")" onmouseover=@(() => CreateHover( CreateRowName ))>
											<TextEntry class="gc-name-input" @ref="createNameInput" Text=@createName Placeholder="Guild name" MaxLength=@(24) />
										</div>
										<div class="gc-field @(IsCreateKb( CreateRowTag ) ? "guild-kb-selected" : "")" onmouseover=@(() => CreateHover( CreateRowTag ))>
											<TextEntry class="gc-tag-input" @ref="createTagInput" Text=@createTag Placeholder="TAG" MaxLength=@(5) />
										</div>
									</div>
									<span class="gs-kick gc-kick-color">COLOR</span>
									<div class="gs-chips @(IsCreateKb( CreateRowColor ) ? "guild-kb-selected" : "")" onmouseover=@(() => CreateHover( CreateRowColor ))>
										@foreach ( var color in EmblemColors )
										{
											var c = color;
											<div class="gs-cchip @(emblemColor == c ? "on" : "")" onclick=@(() => { emblemColor = c; SoundManager.PlayClick(); })>
												<div class="gs-swatch" style="background-color: @c"></div>
											</div>
										}
										<span class="gs-note gs-row-note">the tile ground behind the beast</span>
									</div>
									<span class="gs-kick gs-kick-beast">BEAST</span>
									<!-- BEAST — your own roster (GetEmblemBeastChoices without a
									     guild: favorite first, then roster order). -->
									<div class="gs-chips tiles @(IsCreateKb( CreateRowBeast ) ? "guild-kb-selected" : "")" onmouseover=@(() => CreateHover( CreateRowBeast ))>
										@foreach ( var species in gcChoices )
										{
											var s = species;
											<div class="gs-btile @(gcActiveBeastId == s.Id ? "on" : "")" onclick=@(() => { emblemIcon = "beast:" + s.Id; SoundManager.PlayClick(); })>
												<img class="gs-btile-img" src="@s.IconPath" />
											</div>
										}
										@if ( gcChoices.Count == 0 )
										{
											<span class="gs-note gs-row-note">no beasts to pick from yet — contract one first</span>
										}
									</div>
									@if ( gcActiveTile >= 0 )
									{
										<div class="gs-bname-host" style="@gcNameOffset"><span class="gs-bname">@gcActiveName</span></div>
									}
									else
									{
										<div class="gs-bname-host"><span class="gs-bname dim">NO PICK</span></div>
									}
									<span class="gs-note gs-fallback">No pick — your favorite beast shows</span>
								</div>
							</div>
						</div>

						<!-- RECRUITING 1088×520 -->
						<div class="gs-recruit gc-recruit">
							<div class="gp-band">
								<div class="gp-chipstamp"><span>RECRUITING</span></div>
								<div class="gp-band-spacer"></div>
							</div>
							<div class="gs-recruit-body">
								<div class="gs-kick-row">
									<span class="gs-kick">DESCRIPTION</span>
									<span class="gs-note">what tamers read before they ask to join</span>
								</div>
								<div class="gs-entry-wrap @(IsCreateKb( CreateRowDesc ) ? "guild-kb-selected" : "")" onmouseover=@(() => CreateHover( CreateRowDesc ))>
									<TextEntry class="gs-desc-input" @ref="createDescInput" Text=@createDescription Placeholder="Pitch your guild to recruits…" Multiline=@(true) MaxLength=@(200) />
									<div class="gs-counter"><span class="gs-counter-t">@gcCounter</span></div>
								</div>
								<div class="gs-kick-row gs-gap-join">
									<span class="gs-kick">JOIN MODE</span>
								</div>
								<div class="gs-chips @(IsCreateKb( CreateRowJoin ) ? "guild-kb-selected" : "")" onmouseover=@(() => CreateHover( CreateRowJoin ))>
									@foreach ( var joinMode in JoinModeChips )
									{
										var mode = joinMode;
										<div class="gs-tchip @(settingsJoinMode == mode ? "on" : "")" onclick=@(() => { settingsJoinMode = mode; SoundManager.PlayClick(); })>
											<span class="gs-tchip-t">@JoinModeLabel( mode )</span>
										</div>
									}
									<span class="gs-note gs-row-note">@gcJoinNote</span>
								</div>
								<div class="gs-kick-row gs-gap-level">
									<span class="gs-kick">MIN LEVEL</span>
								</div>
								<div class="gs-chips @(IsCreateKb( CreateRowLevel ) ? "guild-kb-selected" : "")" onmouseover=@(() => CreateHover( CreateRowLevel ))>
									@foreach ( var level in MinLevelChips )
									{
										var lvl = level;
										<div class="gs-tchip lvl @(settingsMinLevel == lvl ? "on" : "")" onclick=@(() => { settingsMinLevel = lvl; SoundManager.PlayClick(); })>
											<span class="gs-tchip-t">@lvl</span>
										</div>
									}
									<span class="gs-note gs-row-note">@gcLevelNote</span>
								</div>
							</div>
						</div>
					</div>

					<!-- RIGHT 768 — deliberately EMPTY above the foot (the settings
					     sub-view precedent): the error line, then the FOUND row. -->
					<div class="gs-right">
						<div class="gs-right-spacer"></div>
						@if ( gcHasError )
						{
							<div class="gc-err-row"><span class="gc-err">@errorMessage</span></div>
						}
						<div class="gc-foot" onmouseover=@(( e ) => CreateFootHover( e ))>
							<span class="gc-cost">@gcCostLine</span>
							<BbButton Tier="primary" Size=@(44) Label="FOUND GUILD" Class="gs-save" Disabled=@(!gcCanCreate) HoverSound=@false Focused=@(IsCreateKb( CreateRowFound )) OnClick=@OnCreateGuild />
						</div>
					</div>
				</div>
			</div>
		</div>
	}
	else
	{
		@{
			var gm = GuildManager.Instance;
			var guild = gm?.Guild;
			var members = gm?.Members ?? new List<GuildMemberInfo>();
			var pendingRequests = gm.IsOfficer ? (gm.JoinRequests ?? new List<GuildJoinRequest>()) : new List<GuildJoinRequest>();
			var raid = gm?.CurrentRaidBoss;
			// rankColor CUT — GuildRankTier reads "Bronze" forever while the
			// arena is dormant (guild-systems-review + brief cuts ledger).
		}

		@if ( raidViewOpen && raid != null && !showRaidTeamSelect && !showRaidBattle )
		{
			<!-- RAID ENCOUNTER — full takeover when monument clicked -->
			@{
				var elementColor = GetElementAccentColor();
			}
			<div class="guild-raid-scene">
				<div class="raid-scene-topbar">
					<!-- Title slab — clean Persona-stamp, no corner-cut decoration -->
					<div class="raid-title-slab">
						<iconify class="raid-title-icon" icon="lucide:swords" Size=@(16) Color="#ef4444" />
						<span class="raid-title-text">@L("ui.guild.tab_raids")</span>
						<span class="raid-title-sep">—</span>
						<span class="raid-title-boss">@raid.BossName</span>
					</div>
					<div class="raid-topbar-spacer"></div>
					<button class="plaza-icon-btn" onclick=@(() => { SoundManager.PlayBack(); raidViewOpen = false; })>
						<iconify icon="lucide:arrow-left" Size=@(16) Color="rgba(255,255,255,0.85)" />
					</button>
				</div>

				<!-- BOSS HERO — Persona-stamp slab. Corner-cut / halftone / BOSS stamp
				     decorations removed for clean slab vocabulary. -->
				<div class="raid-boss-hero p5-stamp" style="border-color: @(elementColor)55">
					<div class="raid-hero-top">
						<div class="raid-hero-sprite-col">
							<div class="raid-boss-sprite" style="background-image: url(@GetRaidBossSpritePath())"></div>
						</div>
						<div class="raid-hero-info-col">
							<span class="raid-boss-name" style="color: @elementColor">@raid.BossName</span>
							<div class="raid-boss-tags">
								<!-- Meta-pill stamps (Persona vocabulary, no rotation) -->
								<div class="raid-stamp-pill element-stamp" style="background-color: @elementColor">
									<span>@raid.BossElement</span>
								</div>
								<div class="raid-stamp-pill level-stamp">
									<span>Lv @raid.BossLevel</span>
								</div>
								<div class="raid-stamp-pill rarity-stamp">
									<span>@GetRaidBossRarity()</span>
								</div>
							</div>
							<div class="raid-desc-row"><span class="raid-boss-desc">@GetRaidBossDescription()</span></div>
							<div class="raid-boss-meta">
								<span class="raid-meta-text">Period @raid.PeriodNumber</span>
								<span class="raid-meta-sep">·</span>
								<span class="raid-meta-text">@L("ui.guild.until_ko")</span>
							</div>
						</div>
					</div>
					<div class="raid-hero-timer">
						<iconify icon="lucide:hourglass" Size=@(14) Color="rgba(255, 200, 100, 0.9)" />
						<span class="raid-timer-label">@L("ui.guild.rotates_in")</span>
						<span class="raid-timer-sep">·</span>
						<span class="raid-timer-value">@FormatRaidTimer() remaining</span>
					</div>
				</div>

				<div class="raid-action-bar p5-stamp">
					<div class="raid-attempts-info">
						<div class="raid-attempt-pips">
							@for ( int i = 0; i < gm.GetRaidAttemptsPerDay(); i++ )
							{
								var used = i < gm.GetRaidAttemptsToday();
								<div class="raid-pip @(used ? "used" : "available")" style="@(!used ? $"border-color: {elementColor}" : "")"></div>
							}
						</div>
						<!-- "X / Y USED" stamp badge — clearer than just dots -->
						<div class="raid-attempts-stamp">
							<span class="raid-attempts-num">@gm.GetRaidAttemptsToday()</span>
							<span class="raid-attempts-sep">/</span>
							<span class="raid-attempts-max">@gm.GetRaidAttemptsPerDay()</span>
							<span class="raid-attempts-tag">USED</span>
						</div>
					</div>
					@if ( gm.CanAttemptRaid() )
					{
						<div class="raid-attack-slab @(raidViewOpen ? "guild-kb-selected" : "")" onclick=@OnAttackRaidBoss>
							<iconify icon="lucide:swords" Size=@(15) Color="#ffffff" />
							<span>@L("ui.guild.attack_boss")</span>
						</div>
					}
					else
					{
						<span class="attempts-exhausted">@L("ui.guild.no_attempts")</span>
					}
				</div>

				<div class="raid-info-columns">
					<div class="raid-combos-card p5-stamp">
						<span class="raid-section-title">@L("ui.guild.combo_bonuses")</span>
						<div class="combo-entry">
							<div class="combo-edge" style="background-color: #ef4444"></div>
							<iconify class="combo-icon" icon="lucide:swords" Size=@(13) Color="#ef4444" /><span class="combo-label">@L("ui.guild.type_advantage")</span><span class="combo-mult">1.5x</span>
						</div>
						<div class="combo-entry">
							<div class="combo-edge" style="background-color: #f59e0b"></div>
							<iconify class="combo-icon" icon="lucide:trending-down" Size=@(13) Color="#f59e0b" /><span class="combo-label">@L("ui.guild.underdog")</span><span class="combo-mult">1.5x</span>
						</div>
						<div class="combo-entry">
							<div class="combo-edge" style="background-color: #22d3ee"></div>
							<iconify class="combo-icon" icon="lucide:link" Size=@(13) Color="#22d3ee" /><span class="combo-label">@L("ui.guild.evolution_chain")</span><span class="combo-mult">1.4x</span>
						</div>
						<div class="combo-entry">
							<div class="combo-edge" style="background-color: #a78bfa"></div>
							<iconify class="combo-icon" icon="lucide:sparkles" Size=@(13) Color="#a78bfa" /><span class="combo-label">@L("ui.guild.elemental_unity")</span><span class="combo-mult">1.3x</span>
						</div>
						<div class="combo-entry">
							<div class="combo-edge" style="background-color: #60a5fa"></div>
							<iconify class="combo-icon" icon="lucide:diamond" Size=@(13) Color="#60a5fa" /><span class="combo-label">@L("ui.guild.rarity_rush")</span><span class="combo-mult">1.25x</span>
						</div>
						<div class="combo-entry">
							<div class="combo-edge" style="background-color: #f472b6"></div>
							<iconify class="combo-icon" icon="lucide:palette" Size=@(13) Color="#f472b6" /><span class="combo-label">@L("ui.guild.diversity")</span><span class="combo-mult">1.2x</span>
						</div>
					</div>
					<div class="raid-personal-card p5-stamp">
						<span class="raid-section-title">@L("ui.guild.your_best")</span>
						@{
							var myBest = GetMyBestRaidScore();
						}
						@if ( myBest != null )
						{
							<span class="personal-score" style="color: @elementColor">@($"{myBest.TotalScore:N0}")</span>
							<div class="personal-detail-row">
								<span class="personal-detail-label">@L("ui.guild.raw_damage")</span>
								<span class="personal-detail-value">@($"{myBest.RawDamage:N0}")</span>
							</div>
							<div class="personal-detail-row">
								<span class="personal-detail-label">@L("ui.guild.combo")</span>
								<span class="personal-detail-value">@($"{myBest.ComboMultiplier:F1}")x</span>
							</div>
							<div class="personal-detail-row">
								<span class="personal-detail-label">@L("ui.guild.rounds_survived")</span>
								<span class="personal-detail-value">@myBest.RoundsUsed</span>
							</div>
						}
						else
						{
							<div class="personal-empty">
								<iconify class="personal-empty-icon" icon="lucide:target" Size=@(28) Color="rgba(255,255,255,0.35)" />
								<span class="personal-empty-text">@L("ui.guild.no_attempts_yet")</span>
								<span class="personal-empty-hint">Attack the boss to set your score!</span>
							</div>
						}
					</div>
				</div>

				<div class="raid-leaderboard-card p5-stamp">
					<div class="raid-lb-header">
						<span class="raid-section-title">@L("ui.guild.guild_leaderboard")</span>
						<span class="raid-lb-total">Total: @($"{raid.GuildTotalScore:N0}")</span>
					</div>
					@{
						var scores = raid.BestScores.Values.OrderByDescending( s => s.TotalScore ).ToList();
					}
					@if ( scores.Count > 0 )
					{
						<div class="raid-lb-list">
							@foreach ( var score in scores )
							{
								var rank = scores.IndexOf( score ) + 1;
								var rankClass = rank == 1 ? "gold" : rank == 2 ? "silver" : rank == 3 ? "bronze" : "";
								<div class="raid-lb-row">
									<span class="raid-lb-rank @rankClass">@rank</span>
									<span class="raid-lb-name">@score.PlayerName</span>
									<span class="raid-lb-combo">@($"{score.ComboMultiplier:F1}")x</span>
									<span class="raid-lb-score">@($"{score.TotalScore:N0}")</span>
								</div>
							}
						</div>
					}
					else
					{
						<span class="raid-lb-empty">@L("ui.guild.no_scores")</span>
					}
				</div>
			</div>
		}
		else if ( showRaidTeamSelect && raid != null )
		{
			<!-- RAID TEAM SELECTION (unchanged from old) -->
			<div class="raid-team-selection">
				<div class="raid-select-header">
					<div class="raid-select-boss">
						<span class="raid-select-boss-name">VS @(raid?.BossName)</span>
						<div class="raid-select-boss-detail">
							<span>@(raid?.BossElement)</span>
							<span class="raid-detail-sep">·</span>
							<span>@($"Lv {raid?.BossLevel}")</span>
							<span class="raid-detail-sep">·</span>
							<span>@L("ui.guild.until_ko")</span>
						</div>
					</div>
					<div class="raid-select-counter">
						<span class="raid-select-counter-num">@raidTeamSelection.Count</span>
						<span class="raid-select-counter-sep">/</span>
						<span class="raid-select-counter-max">3</span>
					</div>
				</div>

				<div class="raid-select-body">
					<div class="raid-select-grid">
						@{ var raidSelKbIdx = 0; }
						@foreach ( var monster in GetRaidAvailableMonsters() )
						{
							var m = monster;
							var inTeam = raidTeamSelection.Contains( m );
							var thisRaidSelIdx = raidSelKbIdx; raidSelKbIdx++;
							<div class="raid-select-option @(inTeam ? "in-team" : "") @(IsRaidSelectKb( thisRaidSelIdx ) ? "guild-kb-selected" : "")">
								<MonsterCard Monster=@m IsCompact=@true AnimateOnHover=@true AnimationFrame=@SpriteAnimator.GlobalFrame
											 ClickAction=@(() => ToggleRaidTeamMember( m )) />
							</div>
						}
					</div>

					<div class="raid-select-sidebar">
						<span class="raid-sidebar-label">@L("ui.guild.raid_team")</span>
						<div class="raid-sidebar-slots">
							@for ( int slotIdx = 0; slotIdx < 3; slotIdx++ )
							{
								var idx = slotIdx;
								var slotMonster = raidTeamSelection.Count > idx ? raidTeamSelection[idx] : null;
								<div class="raid-sidebar-slot @(slotMonster != null ? "filled" : "empty")"
									 onclick=@(() => { if ( slotMonster != null ) { raidTeamSelection.Remove( slotMonster ); SoundManager.PlayBack(); } })>
									@if ( slotMonster != null )
									{
										<MonsterCard Monster=@slotMonster IsCompact=@true AnimationFrame=@SpriteAnimator.GlobalFrame />
									}
									else
									{
										<div class="raid-slot-empty">
											<span class="raid-slot-number">@(idx + 1)</span>
											<span class="raid-slot-label">@L("ui.guild.empty")</span>
										</div>
									}
								</div>
							}
						</div>

						@{
							var comboPreview = GetRaidComboPreview();
						}
						<div class="raid-combo-preview @(comboPreview.Multiplier > 1f ? "active" : "")">
							<span class="raid-combo-label">@L("ui.guild.combo")</span>
							@if ( comboPreview.Multiplier > 1f )
							{
								<span class="raid-combo-name">@comboPreview.ComboName</span>
								<span class="raid-combo-mult">@($"{comboPreview.Multiplier:F1}")x</span>
							}
							else if ( raidTeamSelection.Count < 3 )
							{
								<span class="raid-combo-hint">Pick 3 to see combo</span>
							}
							else
							{
								<span class="raid-combo-hint">@L("ui.guild.no_combo")</span>
							}
						</div>

						<div class="guild-btn raid-attack-btn @(raidTeamSelection.Count < 3 ? "disabled" : "")" onclick=@(() => { if ( raidTeamSelection.Count == 3 ) StartRaidBattle(); })>
							<span>@L("ui.guild.attack_boss")</span>
						</div>
						<div class="guild-btn secondary-btn" onclick=@(() => { showRaidTeamSelect = false; raidTeamSelection.Clear(); SoundManager.PlayBack(); })>
							<span>@L("ui.common.cancel")</span>
						</div>
					</div>
				</div>
			</div>
		}
		else
		{
			<!-- ═══════════════════════════════════════════════════════════════
			     THE GUILD PAGE (2026-08-31 rebuild — guild-mock-page.html).
			     Kin to the hub: ONLINE BLUE chrome, filled #15121f slabs,
			     recessed 36px bands, radius 0 zones, NO hairlines. Guild
			     personality (EmblemColor) lives inside the emblem tile +
			     the [TAG] whisper only.

			     ZONE MAP (1920×1080 design, PADDING-BOX — declared sizes
			     INCLUDE padding, borders add on top):
			       HEADER   1920×110 declared + 2px seam border = 112 visual
			       BODY     pad 16/24/24/24, gap 16 → lanes: 1920−48 = 1872
			         TOP BAND  160: IDENTITY 1088 + 16 gap + ANNOUNCEMENT 768 = 1872 ✓
			         COLUMNS   752: ROSTER 1088 + 16 + right col 768 = 1872 ✓
			                   right col: THE WEEK 336 + 16 + THE LOG 400 = 752 ✓
			       column check: 112 + 16 + 160 + 16 + 752 + 24 = 1080 ✓
			     (The hub suppresses its own .oh-header for this section —
			     OnlineHubPanel.razor, currentSection != "guild".) -->
			@{
				// ── Precomputed zone data (nested calls / ternaries are
				//    Razor-attribute hazards — compute everything up front).
				var gpColor = guild.EmblemColor ?? "#3f8fe0";
				var gpFill = BbEmblem.BlendTowardSlab( gpColor, 0.70f );
				var gpEmblemBeast = BbEmblem.ResolveBeast( guild.EmblemIcon, guild.OwnerSteamId, members );
				var gpEmblemCrop = gpEmblemBeast != null ? BbEmblem.CropStyleFor( gpEmblemBeast, 112, 112 ) : "";
				var gpMembers = GetPlazaRosterMembers( members );
				int gpHere = gm.OnlineCount;
				var gpHereClass = gpHere > 0 ? "gp-here on" : "gp-here";
				// Weekly-XP bars scale to the WEEK'S MAX (honest zeroes render
				// an empty track + "0" — never a fake sliver).
				int gpWeekMax = gpMembers.Count > 0 ? Math.Max( 1, gpMembers.Max( mm => mm.WeeklyGuildXP ) ) : 1;
				var gpTop = GetTopContributor( gpMembers );
				long gpLocalId = (long)(Connection.Local?.SteamId ?? 0);
				bool gpDense = gpMembers.Count >= 12;   // roomy 88px rows (7 fill the 752 zone) → 64px scroll stop at 12+
				var gpGoals = gm.WeeklyGoals ?? new List<GuildWeeklyGoal>();
				var gpLog = (gm.ActivityLog ?? new List<GuildLogEntry>()).OrderByDescending( e => e.Timestamp ).ToList();
				// THE LOG renders a VIEW of the feed (run 3): consecutive identical
				// SYSTEM rows fold into one row + ×N chip, actor-restating copy is
				// trimmed (BuildLogRows). The visible count feeds BuildHash + the
				// kb walk (PlazaZoneCount "log") so the cursor never walks a
				// folded row.
				var gpLogRows = BuildLogRows( gpLog );
				_logVisibleRows = gpLogRows.Count;
				var gpNext = GetNextUnlockPerk();
				int gpActivePerks = GetActivePerkCount();
				long gpXpToNext = Math.Max( 0L, GetGuildXPNeededForNext() - GetGuildXPInLevel() );
				var gpXpLine = gpXpToNext > 0 ? $"{gpXpToNext:N0} XP TO LV {guild.Level + 1}" : "MAX LEVEL";
				// Announcement stone: officers always see it (edit / write-row);
				// plain members only when a MOTD exists — else IDENTITY spans
				// the full 1872 top band.
				bool gpAnnVisible = gm.IsOfficer || !string.IsNullOrEmpty( guild.Motd );
				var gpUnlockName = gpNext != null ? $"{gpNext.Name.ToUpper()} — {gpNext.Short.ToUpper()}" : "ALL PERKS ACTIVE";
				var gpUnlockKick = gpNext != null ? $"NEXT · LV {gpNext.Level}" : "GUILD PERKS";
				var gpLadderChip = $"LV {guild.Level} · {gpActivePerks} ACTIVE";
				// LANE: motion — windowed pop classes (level-up stamp snap /
				// claim flash). Present only inside their ~0.6s windows so
				// kb-remounts and page re-opens replay nothing.
				var gpLvPop = RealTime.Now < _lvPopUntil ? "gp-pop" : "";
				var gpLadderOpen = showPerkLadder ? "open" : "";
			}
			<!-- LANE: input — device-mode root (DOC-5 §5): _gpKbdMode drives
			     .kbd-mode/.mouse-mode; every gp :hover is CSS-gated under
			     .mouse-mode so a parked pointer can't keep a second row lit
			     while the player keyboards. onmousemove is the flip-back-to-
			     mouse edge, GUARDED on >= 3px of real travel since the last
			     keypress (B1, run-2 audit): the engine re-dispatches
			     onmousemove on re-render under a PARKED cursor. -->
			<!-- LANE: motion — gs-closing (settings exit latch) and gp-fx-freeze
			     (dev_guildfx) are ROOT classes: root flips persist the subtree, so
			     they drive transitions / play-state without remounting anything. -->
			<div class="gp-page @(_gpKbdMode ? "kbd-mode" : "mouse-mode") @(SettingsClosing ? "gs-closing" : "") @(_gpFxFreeze ? "gp-fx-freeze" : "")" onmousemove=@OnGpPageMouseMove>

				<!-- ── HEADER — the hub's .oh-header anatomy wearing the GUILD'S
				     NAME (kicker GUILD → 64px italic-900 title → [TAG] whisper →
				     blue seam slabs → BbHeaderWaves blue → 2px seam strip).
				     Host recipe: waves first child, host paints NO fill.
				     LANE: motion (attached) — gpZoneHeader mount fade, rung 0
				     of the zone cascade (plaza branch mounts fresh per open). -->
				<div class="gp-header">
					<BbHeaderWaves Accent=@("blue") />
					<div class="gp-h-identity">
						<span class="gp-kicker">GUILD</span>
						<div class="gp-title-row">
							<span class="gp-title">@guild.Name</span>
							<div class="gp-tag"><span>[@guild.Tag]</span></div>
							<div class="gp-seam"></div>
							<div class="gp-seam dim"></div>
						</div>
					</div>
					<!-- Right slot (run 2). BACK cap = the hub's .hb-back recipe
					     (30 r11 · italic-900 12 label · 11/800 Q cap — audit S6),
					     then the house header-chip trio (32 r11 slabs; ACTIONS
					     NEVER SKEW): INVITE (officer) · REQUESTS·N (officer, N>0 —
					     scrolls the roster to PENDING) · SETTINGS (everyone: LEAVE
					     GUILD lives in the settings DANGER slab). Chip ids come
					     from GetPlazaChips() — the SAME live list the kb walk
					     counts (stale-map law). In the SETTINGS sub-view the slot
					     holds ONLY BACK TO GUILD · Q. Row math: back 30 + gap 12 +
					     chips (32 each, gaps 12), right pad 32 (header).
					     LANE: input — header chips are the kb walk's first stops;
					     the back caps are mouse-only (Q is the key, already wired). -->
					<div class="gp-toolbar">
						@if ( showSettingsView )
						{
							<div class="gp-back" onmouseover=@(() => SoundManager.PlayHover()) onclick=@OnSettingsBackClicked>
								<span class="gp-back-label">BACK TO GUILD</span>
								<span class="gp-back-cap">Q</span>
							</div>
						}
						else
						{
							<div class="gp-back" onmouseover=@(() => SoundManager.PlayHover()) onclick=@OnBackClicked>
								<span class="gp-back-label">BACK TO HUB</span>
								<span class="gp-back-cap">Q</span>
							</div>
							@{
								var gpChips = GetPlazaChips( gm );
								int gpInviteIdx = gpChips.IndexOf( "invite" );
								int gpRequestsIdx = gpChips.IndexOf( "requests" );
								int gpSettingsChipIdx = gpChips.IndexOf( "settings" );
							}
							@if ( gpInviteIdx >= 0 )
							{
								<div class="gp-chip @(IsPlazaKb( "chips", gpInviteIdx ) ? "guild-kb-selected" : "")" onmouseover=@(() => PlazaHover( "chips", gpInviteIdx )) onclick=@(() => OnInviteClicked())>
									<iconify class="gp-chip-glyph" icon="lucide:user-plus" Size=@(13) Color="#a79dbe" />
									<span class="gp-chip-label">INVITE</span>
								</div>
							}
							@if ( gpRequestsIdx >= 0 )
							{
								<div class="gp-chip @(IsPlazaKb( "chips", gpRequestsIdx ) ? "guild-kb-selected" : "")" onmouseover=@(() => PlazaHover( "chips", gpRequestsIdx )) onclick=@(() => { GoToPending(); SoundManager.PlayForward(); })>
									<span class="gp-chip-label">REQUESTS</span>
									<div class="gp-chip-n"><span class="gp-chip-nt">@pendingRequests.Count</span></div>
								</div>
							}
							<div class="gp-chip @(IsPlazaKb( "chips", gpSettingsChipIdx ) ? "guild-kb-selected" : "")" onmouseover=@(() => PlazaHover( "chips", gpSettingsChipIdx )) onclick=@(() => { OpenSettingsView(); SoundManager.PlayClick(); })>
								<iconify class="gp-chip-glyph" icon="lucide:settings" Size=@(13) Color="#a79dbe" />
								<span class="gp-chip-label">SETTINGS</span>
							</div>
						}
					</div>
				</div>

				@if ( showSettingsView )
				{
					<!-- ═══ SETTINGS SUB-VIEW (run 2 — guild-mock-page.html addendum A).
					     The slide-in drawer is dead: settings is a sub-view of the
					     page under the SAME header; the toolbar above holds only
					     BACK TO GUILD · Q. PADDING-BOX zone map (declared sizes
					     INCLUDE padding, borders add):
					       BODY pad 16/24/24/24, gap 16 → lanes 1872 × 928
					         (1080 − 112 header − 16 − 24 = 928)
					       LEFT 1088: IDENTITY 1088×368 + 16 + RECRUITING 1088×544
					                  = 928 ✓ (lands on y 1056)
					       RIGHT 768: DANGER 768×472 (y 128–600) + spacer 408 +
					                  SAVE row 48 (y 1008–1056) = 928 ✓
					                  SAVE 320 right-aligned: x 1896 − 320 = 1576 ✓
					     No name / tag fields (no API). No nav pills, no hint rows.
					     Non-officers: the left slabs render READ-ONLY (.gs-ro) and
					     the SAVE row is absent — DANGER still carries LEAVE.
					     LANE: motion (attached, run 2) — ENTER = the slabs' gpZone*
					     rungs on mount (left column then right, 0.40s). EXIT = the
					     0.12s delayed-unmount latch: CloseSettingsView stamps
					     _settingsClosingUntil, the root wears .gs-closing, .gs-body
					     fades, Tick flips showSettingsView off when the latch expires.
					     BACK TO GUILD / BACK TO HUB caps carry a 0.18s mount fade.
					     LANE: input — rows are GetSettingsDrawerRows() ids (color ·
					     beast · description · joinmode · minlevel · danger rows ·
					     save); A/D inside a chip row + HOLD-to-confirm on the
					     danger buttons are input's pass. -->
					@{
						// Preview resolves the PENDING pick exactly as the live
						// emblem will (BbEmblem chain: beast key → the Beastlord's
						// favorite → legacy lucide → shield). Everything the markup
						// needs is computed up front (Razor-attribute hazards).
						var gsBeast = BbEmblem.ResolveBeast( emblemIcon, guild.OwnerSteamId, members );
						var gsFill = BbEmblem.BlendTowardSlab( emblemColor, 0.70f );
						var gsCrop112 = gsBeast != null ? BbEmblem.CropStyleFor( gsBeast, 112, 112 ) : "";
						var gsCrop44 = gsBeast != null ? BbEmblem.CropStyleFor( gsBeast, 44, 44 ) : "";
						var gsChoices = GetEmblemBeastChoices();
						var gsActiveBeastId = ( emblemIcon ?? "" ).StartsWith( "beast:" ) ? emblemIcon.Substring( 6 ) : "";
						int gsActiveTile = gsChoices.FindIndex( s => s.Id == gsActiveBeastId );
						var gsActiveName = gsActiveTile >= 0 ? gsChoices[gsActiveTile].Name.ToUpper() : "";
						var gsNameOffset = $"margin-left: {gsActiveTile * 52}px"; // tile 44 + gap 8
						var gsDescLen = ( settingsDescription ?? "" ).Length;
						var gsCounter = $"{gsDescLen} / 200";
						var gsDirty = SettingsDirty();
						var gsJoinNote = JoinModeNote( settingsJoinMode );
						var gsLevelNote = MinLevelNote( settingsMinLevel );
						bool gsOfficer = gm.IsOfficer;
						var gsRo = gsOfficer ? "" : "gs-ro";
						bool gsCanClaim = gm.CanClaimLeadership();
						bool gsCanTransfer = gm.IsLeader && members.Count > 1;
						var gsDisbandNote = $"deletes {guild.Name} for all {members.Count} members · leader only · no undo";
						var gsSaveTier = gsDirty ? "primary" : "ghost";
						var gsSaveLabel = gsDirty ? "SAVE CHANGES" : "NO CHANGES";
						var gsSaveCap = gsDirty ? "SPACE" : "";
						// DANGER slab height from the LIVE row list (run 3 — audit S-C):
						// band 36 + pad 24 + rows × 88 + (rows − 1) × 12 + pad 24.
						// 4 rows = 472 · 3 = 372 · 2 = 272 · 1 = 172. The 928 column's
						// surplus pours into .gs-right-spacer (flex 1 1 <that>px) so
						// SAVE (48, officers only) holds the foot; a Tamer's column is
						// slab + spacer alone.
						int gsDangerRows = 1 + ( gsCanClaim ? 1 : 0 ) + ( gsCanTransfer ? 1 : 0 ) + ( gm.IsLeader ? 1 : 0 );
						int gsDangerH = 36 + 24 + gsDangerRows * 88 + ( gsDangerRows - 1 ) * 12 + 24;
						int gsSpacerH = Math.Max( 0, 928 - gsDangerH - ( gsOfficer ? 48 : 0 ) );
						var gsDangerStyle = $"height: {gsDangerH}px;";
						var gsSpacerStyle = $"height: {gsSpacerH}px;";
					}
					<div class="gp-body gs-body">
						<div class="gs-cols">

							<!-- LEFT 1088 -->
							<div class="gs-left">

								<!-- IDENTITY 1088×368 — band 36 + body (pad 24 L/R, top 24).
								     Body row: 24 + preview col 112 + gap 24 + pick col 904
								     + 24 = 1088 ✓. Pick col: kicker 60–74 · COLOR chips
								     80–116 (8 × 44×36 r8, gap 8 = 408) · BEAST kicker
								     152–166 · tiles 168–212 (8 × 44×44 r9, gap 8 = 408)
								     · name 222–236 · fallback 264–278 (slab-relative y).
								     Preview col: HERO 112 r12 at y 60 · PREVIEW kicker
								     184 · twin 44 r9 at 204 (the hub guild-zone head). -->
								<div class="gs-ident @gsRo">
									<div class="gp-band">
										<div class="gp-chipstamp"><span>IDENTITY</span></div>
										<div class="gp-band-spacer"></div>
										<div class="gp-darkchip"><span>@(gsOfficer ? "EMBLEM · SAVED WITH THE REST" : "OFFICERS EDIT THESE")</span></div>
									</div>
									<div class="gs-ident-body">
										<div class="gs-preview-col">
											<div class="gs-preview @(gsBeast != null ? "beast-tile" : "")" style="background-color: @gsFill">
												@if ( gsBeast != null )
												{
													<img class="emblem-beast-img" src="@gsBeast.IconPath" style="@gsCrop112" />
												}
												else
												{
													<iconify class="gs-preview-glyph" icon="@GetEmblemIcon( emblemIcon )" Size=@(64) Color="#ffffff" />
												}
											</div>
											<span class="gs-kick dim gs-preview-kick">PREVIEW</span>
											<div class="gs-twin-row">
												<div class="gs-twin @(gsBeast != null ? "beast-tile" : "")" style="background-color: @gsFill">
													@if ( gsBeast != null )
													{
														<img class="emblem-beast-img" src="@gsBeast.IconPath" style="@gsCrop44" />
													}
													else
													{
														<iconify class="gs-twin-glyph" icon="@GetEmblemIcon( emblemIcon )" Size=@(24) Color="#ffffff" />
													}
												</div>
												<div class="gs-twin-note">
													<span class="gs-note">as the hub</span>
													<span class="gs-note">sees it · 44</span>
												</div>
											</div>
										</div>
										<div class="gs-pick-col">
											<span class="gs-kick">COLOR</span>
											<!-- COLOR — the tile GROUND behind the beast. Chips are
											     UPRIGHT 44×36 r8 (DOC-6 actions-never-skew: no NEW
											     pressable skews; the two-tone active is the FilterBar
											     family's). LANE: input — A/D walk the chips in-row. -->
											<div class="gs-chips @(IsSettingsRowKb( "color" ) ? "guild-kb-selected" : "")">
												@foreach ( var color in EmblemColors )
												{
													var c = color;
													<div class="gs-cchip @(emblemColor == c ? "on" : "")" onclick=@(() => { emblemColor = c; SoundManager.PlayClick(); })>
														<div class="gs-swatch" style="background-color: @c"></div>
													</div>
												}
												<span class="gs-note gs-row-note">the tile ground behind the beast</span>
											</div>
											<span class="gs-kick gs-kick-beast">BEAST</span>
											<!-- BEAST — THE emblem (EmblemIcon = "beast:<speciesId>").
											     8 species tiles 44×44 r9 (declared 40 + 2px rim). The
											     tile shows the WHOLE beast centred (object-fit: contain
											     into the 40 box — run 3 fix: the 45/22 face crop showed a
											     40px slice of a 128 sprite and read "cut off"). This is a
											     PICKER — recognising the species beats pixel sharpness;
											     the emblem's real renders (hero 112 / twin 44 / hub) keep
											     the native-px face crop. Sources: the saved emblem, your
											     roster, then the members' favorites (GetEmblemBeastChoices);
											     A/D cycle the SAME list (CycleSettingsRow "beast"). -->
											<div class="gs-chips tiles @(IsSettingsRowKb( "beast" ) ? "guild-kb-selected" : "")">
												@foreach ( var species in gsChoices )
												{
													var s = species;
													<div class="gs-btile @(gsActiveBeastId == s.Id ? "on" : "")" onclick=@(() => { emblemIcon = "beast:" + s.Id; SoundManager.PlayClick(); })>
														<img class="gs-btile-img" src="@s.IconPath" />
													</div>
												}
												@if ( gsChoices.Count == 0 )
												{
													<span class="gs-note gs-row-note">no beasts to pick from yet — contract one first</span>
												}
											</div>
											@if ( gsActiveTile >= 0 )
											{
												<div class="gs-bname-host" style="@gsNameOffset"><span class="gs-bname">@gsActiveName</span></div>
											}
											else
											{
												<div class="gs-bname-host"><span class="gs-bname dim">NO PICK</span></div>
											}
											<span class="gs-note gs-fallback">No pick — the Beastlord's favorite shows</span>
										</div>
									</div>
								</div>

								<!-- RECRUITING 1088×544 — band 36 + body (pad 24). Slab-
								     relative y: DESCRIPTION kicker 60–74 · entry 736×240 r8
								     at 80–320 (counter dim bottom-right) · JOIN MODE kicker
								     360–374 · chips 36 at 380–416 · MIN LEVEL kicker 448–462
								     · chips 468–504 · bottom pad 40 → 544 ✓.
								     LANE: input — the description row is a kb STOP that
								     hands focus to the TextEntry (S3, already wired via
								     settingsDescInput); chips A/D in-row. -->
								<div class="gs-recruit @gsRo">
									<div class="gp-band">
										<div class="gp-chipstamp"><span>RECRUITING</span></div>
										<div class="gp-band-spacer"></div>
									</div>
									<div class="gs-recruit-body">
										<div class="gs-kick-row">
											<span class="gs-kick">DESCRIPTION</span>
											<span class="gs-note">what tamers read before they ask to join</span>
										</div>
										<div class="gs-entry-wrap @(IsSettingsRowKb( "description" ) ? "guild-kb-selected" : "")">
											<TextEntry class="gs-desc-input" @ref="settingsDescInput" Text=@settingsDescription Placeholder="Pitch your guild to recruits…" Multiline=@(true) MaxLength=@(200) />
											<div class="gs-counter"><span class="gs-counter-t">@gsCounter</span></div>
										</div>
										<div class="gs-kick-row gs-gap-join">
											<span class="gs-kick">JOIN MODE</span>
										</div>
										<div class="gs-chips @(IsSettingsRowKb( "joinmode" ) ? "guild-kb-selected" : "")">
											@foreach ( var joinMode in JoinModeChips )
											{
												var mode = joinMode;
												<div class="gs-tchip @(settingsJoinMode == mode ? "on" : "")" onclick=@(() => { settingsJoinMode = mode; SoundManager.PlayClick(); })>
													<span class="gs-tchip-t">@JoinModeLabel( mode )</span>
												</div>
											}
											<span class="gs-note gs-row-note">@gsJoinNote</span>
										</div>
										<div class="gs-kick-row gs-gap-level">
											<span class="gs-kick">MIN LEVEL</span>
										</div>
										<div class="gs-chips @(IsSettingsRowKb( "minlevel" ) ? "guild-kb-selected" : "")">
											@foreach ( var level in MinLevelChips )
											{
												var lvl = level;
												<div class="gs-tchip lvl @(settingsMinLevel == lvl ? "on" : "")" onclick=@(() => { settingsMinLevel = lvl; SoundManager.PlayClick(); })>
													<span class="gs-tchip-t">@lvl</span>
												</div>
											}
											<span class="gs-note gs-row-note">@gsLevelNote</span>
										</div>
									</div>
								</div>
							</div>

							<!-- RIGHT 768 — DANGER at the top, SAVE at the foot; the
							     middle is deliberately EMPTY (danger far from the primary). -->
							<div class="gs-right">

								<!-- DANGER 768×(36 + 24 + rows×88 + (rows−1)×12 + 24) — height
								     DERIVED per role (gsDangerH: 472 leader-with-claim … 172
								     Tamer); no void under the last row. Row: text col (title 17/800 + note
								     12/700 dim) · spacer · BbButton danger 320×44 r11 + HOLD
								     cap. CLAIM is CONDITIONAL (absent, not disabled).
								     LANE: input — HOLD-to-confirm (~0.9s, the skills-reset
								     grammar) replaces the ConfirmDialog calls below; until
								     then the dialogs keep every action working. -->
								<div class="gs-danger" style="@gsDangerStyle">
									<div class="gp-band">
										<div class="gp-chipstamp danger"><span>DANGER</span></div>
										<div class="gp-band-spacer"></div>
									</div>
									<div class="gs-danger-body">
										@if ( gsCanClaim )
										{
											<div class="gs-drow">
												<div class="gs-drow-text">
													<span class="gs-dtitle">CLAIM LEADERSHIP</span>
													<span class="gs-dnote">Beastlord away 30+ days · you're the highest rank online</span>
												</div>
												<div class="gs-drow-spacer"></div>
												<BbButton Tier="danger" Size=@(44) Label="CLAIM LEADERSHIP" HoldToConfirm=@true Class="gs-dbtn" HoverSound=@false Focused=@(IsSettingsRowKb( "claim" )) OnClick=@OnClaimPressed />
											</div>
										}
										@if ( gsCanTransfer )
										{
											<div class="gs-drow">
												<div class="gs-drow-text">
													<span class="gs-dtitle">TRANSFER LEADERSHIP</span>
													<span class="gs-dnote">hand the Beastlord role to another member · leader only</span>
												</div>
												<div class="gs-drow-spacer"></div>
												<BbButton Tier="danger" Size=@(44) Label="TRANSFER" HoldToConfirm=@true Class="gs-dbtn" HoverSound=@false Focused=@(IsSettingsRowKb( "transfer" )) OnClick=@OnTransferPressed />
											</div>
										}
										<div class="gs-drow">
											<div class="gs-drow-text">
												<span class="gs-dtitle">LEAVE GUILD</span>
												<span class="gs-dnote">you keep your Beasts and gold · your weekly XP stays with the guild</span>
											</div>
											<div class="gs-drow-spacer"></div>
											<BbButton Tier="danger" Size=@(44) Label="LEAVE GUILD" HoldToConfirm=@true Class="gs-dbtn" HoverSound=@false Focused=@(IsSettingsRowKb( "leave" )) OnClick=@OnLeavePressed />
										</div>
										@if ( gm.IsLeader )
										{
											<div class="gs-drow">
												<div class="gs-drow-text">
													<span class="gs-dtitle">DISBAND</span>
													<span class="gs-dnote">@gsDisbandNote</span>
												</div>
												<div class="gs-drow-spacer"></div>
												<BbButton Tier="danger" Size=@(44) Label="DISBAND" HoldToConfirm=@true Class="gs-dbtn" HoverSound=@false Focused=@(IsSettingsRowKb( "disband" )) OnClick=@OnDisbandPressed />
											</div>
										}
									</div>
								</div>

								<!-- The column's surplus — derived (928 − danger − save). -->
								<div class="gs-right-spacer" style="@gsSpacerStyle"></div>

								@if ( gsOfficer )
								{
									<!-- SAVE 320×48 r16 — the view's ONE gold primary, right-
									     aligned at the column's foot. ONE BbButton whose tier /
									     label / cap swap by attribute (no if-swap ghosting):
									     dirty → gold SAVE CHANGES + SPACE cap; clean → ghost
									     NO CHANGES, disabled. Fires SaveSettingsAndClose (the
									     one save path). -->
									<div class="gs-save-row">
										<BbButton Tier=@gsSaveTier Size=@(44) Label=@gsSaveLabel KeyCap=@gsSaveCap Disabled=@(!gsDirty) Class="gs-save" HoverSound=@false Focused=@(IsSettingsRowKb( "save" )) OnClick=@OnSavePressed />
									</div>
								}
							</div>
						</div>
					</div>
				}
				else
				{
				@{ ArmLogLadderOnMount(); } @* LANE: motion — the log ladder arms on the plaza body's FIRST render (first open + every return from settings) *@
				<div class="gp-body">

					<!-- ── TOP BAND 1872×160 — IDENTITY left, ANNOUNCEMENT right.
					     IDENTITY row math (1088, pad 16 L/R): 16 + emblem 112 +
					     gap 20 + mid 560 + spacer(≥28) + chip 336 + 16 = 1088 ✓
					     When the stone hides, .full = 1872 and the spacer grows. -->
					<div class="gp-top-band">
						<div class="gp-ident @(gpAnnVisible ? "" : "full")">
							<!-- HERO emblem — the framed-tile recipe (112×112 r12,
							     fill = BlendTowardSlab(EmblemColor, .70), native-px
							     sprite crop; no filter / transform / object-fit). -->
							<div class="gp-emblem @(gpEmblemBeast != null ? "beast-tile" : "")" style="background-color: @gpFill">
								@if ( gpEmblemBeast != null )
								{
									<img class="emblem-beast-img" src="@gpEmblemBeast.IconPath" style="@gpEmblemCrop" />
								}
								else
								{
									<iconify class="gp-emblem-glyph" icon="@GetEmblemIcon( guild.EmblemIcon )" Size=@(64) Color="#ffffff" />
								}
							</div>
							<div class="gp-ident-mid">
								<div class="gp-ident-row">
									<!-- LV stamp — non-interactive identity mark (skew OK).
									     LANE: motion — gp-pop = Tier-3 gold stamp snap on a
									     GuildLevel edge (windowed in Tick). -->
									<div class="gp-lv-stamp @gpLvPop"><span>@($"LV {guild.Level}")</span></div>
									<span class="gp-members-line">@($"{members.Count} MEMBERS ·")</span>
									<span class="@gpHereClass">@($"{gpHere} HERE")</span>
								</div>
								<!-- ONE XP bar (440×10) + ONE rounded number — the
								     shipped "92.64909%" double readout dies here. -->
								<div class="gp-xp-bar"><div class="gp-xp-fill" style="width: @(GuildXpBarPx())px"></div></div>
								<span class="gp-xp-line">@gpXpLine</span>
							</div>
							<div class="gp-ident-spacer"></div>
							<!-- NEXT-UNLOCK chip 336×92 r11 — PRESSABLE, opens the
							     PERK LADDER. Names only perks that WORK (honesty
							     rule — Lv20 unwired / Lv25+45 raid-gated / Lv40+50
							     copy-only are absent from WiredPerks).
							     LANE: input — Space/E opens; a W/S stop (zone "unlock"). -->
							<div class="gp-unlock @(IsPlazaKb( "unlock", 0 ) ? "guild-kb-selected" : "")" onmouseover=@(() => PlazaHover( "unlock", 0 )) onclick=@(() => { showPerkLadder = true; SoundManager.PlayForward(); })>
								<span class="gp-unlock-kick">@gpUnlockKick</span>
								<span class="gp-unlock-name">@gpUnlockName</span>
								<div class="gp-unlock-foot">
									<span class="gp-unlock-count">@($"{gpActivePerks} PERKS ACTIVE ·")</span>
									<span class="gp-unlock-view">VIEW ALL</span>
									<iconify class="gp-unlock-arrow" icon="lucide:chevron-right" Size=@(12) Color="#6fb1f0" />
								</div>
							</div>
						</div>

						@if ( gpAnnVisible )
						{
							<!-- ── ANNOUNCEMENT 768×160 — the officer's voice.
							     Existing MOTD edit plumbing, inline pencil. No
							     byline: the server stores neither author nor
							     write-time for the MOTD (render nothing, honest). -->
							<div class="gp-ann">
								<div class="gp-band">
									<div class="gp-chipstamp"><span>ANNOUNCEMENT</span></div>
									<div class="gp-band-spacer"></div>
									@if ( gm.IsOfficer && !editingMotd && !string.IsNullOrEmpty( guild.Motd ) )
									{
										<!-- LANE: input — the "info" zone's one stop -->
										<div class="gp-ann-edit @(IsPlazaKb( "info", 0 ) ? "guild-kb-selected" : "")" onmouseover=@(() => PlazaHover( "info", 0 )) onclick=@(() => { StartEditMotd(); SoundManager.PlayClick(); })>
											<iconify class="gp-pi" icon="lucide:pencil" Size=@(12) Color="rgba(244, 241, 234, 0.6)" />
										</div>
									}
								</div>
								<div class="gp-ann-body">
									@if ( editingMotd )
									{
										<TextEntry class="gp-ann-input" @ref="motdDraftInput" Text=@motdDraft />
										<!-- LANE: input — the entry takes focus on open (S4 latch).
										     While typing: Enter SAVES (onsubmit), Esc/Tab hand the
										     keyboard back (cursor on Save). Then A/D walk
										     Save↔Cancel, Space/Enter/E fires, Q cancels, W climbs
										     back into the text box (TickEditorInput). -->
										<div class="gp-ann-actions">
											<div class="guild-btn accept-btn @(IsMotdEditorKb( 0 ) ? "guild-kb-selected" : "")" onmouseover=@(() => MotdEditorHover( 0 )) onclick=@(() => { SaveMotd(); SoundManager.PlaySuccess(); })><span>@L("ui.guild.save")</span></div>
											<div class="guild-btn deny-btn @(IsMotdEditorKb( 1 ) ? "guild-kb-selected" : "")" onmouseover=@(() => MotdEditorHover( 1 )) onclick=@CancelMotd><span>@L("ui.common.cancel")</span></div>
										</div>
									}
									else if ( !string.IsNullOrEmpty( guild.Motd ) )
									{
										<span class="gp-ann-text">@guild.Motd</span>
									}
									else
									{
										<!-- officer empty state — the slim write-row
										     (plain members never see the stone) -->
										<div class="gp-ann-empty @(IsPlazaKb( "info", 0 ) ? "guild-kb-selected" : "")" onmouseover=@(() => PlazaHover( "info", 0 )) onclick=@(() => { StartEditMotd(); SoundManager.PlayClick(); })>
											<iconify class="gp-pi" icon="lucide:pencil" Size=@(12) Color="rgba(244, 241, 234, 0.6)" />
											<span class="gp-ann-empty-t">Write an announcement</span>
										</div>
									}
								</div>
							</div>
						}
					</div>

					<!-- ── COLUMNS 1872×752 ── -->
					<div class="gp-cols">

						<!-- ROSTER 1088×752 — the heart, expanded. Band 36 (opaque,
						     gap 0 to the list — scroll-leak law). Rows are DIRECT
						     children of the scroll child. Row math (roomy, run 3): band 36
						     + pad 16 + 7×88 + 6×12 + pad 12 = 752 ✓ at 7 members
						     (the 28px surplus of 716 − 688 is split 16 top / 12 foot —
						     the top pad reads as the band's breathing room).
						     Row lane: list pad 12 L/R → 1064; row 1060 declared +
						     4px left seam border = 1064 ✓.
						     LANE: motion (attached) — zone fade rung 2 (gpZoneRoster);
					     rows get NO per-row cascade: guild-kb-selected is
					     volatile → class change = remount = the entrance would
					     replay on every cursor hop (DOC-4 §14). Scrollbar =
					     .gp-sb opacity arm/fade + hover thumb brighten. -->
						<div class="gp-roster">
							<div class="gp-band">
								<div class="gp-chipstamp"><span>ROSTER</span></div>
								<div class="gp-band-spacer"></div>
								<div class="gp-darkchip"><span>@($"{members.Count} / {gm.GetMaxMembers()}")</span></div>
							</div>
							<div class="gp-roster-list @(gpDense ? "dense" : "")" @ref="rosterScrollRef">
								@{
									int gpRosterIdx = 0;
									// PENDING (run 2 — addendum B): officers only, N>0; at
									// N = 0 the section is ABSENT (not empty), and the roomy
									// 752 math below holds untouched.
									bool gpShowPending = gm.IsOfficer && pendingRequests.Count > 0;
								}
								@if ( gpShowPending )
								{
									<!-- PENDING — the requests modal is dead; requests are rows
									     in the roster's own recipe, pinned at the TOP of the
									     list. FLAT-CHILDREN LAW: the two kicker rows and every
									     pending row are DIRECT children of the scroll child.
									     Kicker row 1064×24 · rows 1060 + 4 seam = 1064, 72 tall,
									     gap 8: 16 pad + head 44 + 20 + text 400 + spacer 356
									     + ACCEPT 104 + 16 + DENY 88 + 16 pad = 1060 ✓.
									     LANE: input — pending rows are cursor stops (W/S rows,
									     A/D ACCEPT↔DENY, Space = ACCEPT); REQUESTS·N seats the
									     cursor on the first pending row.
									     LANE: motion (attached, run 2) — NO entrance ladder
									     (volatile rows). ACCEPT = gp-leaving-acc (0.2s blue fold,
									     height-only) + the new member's row lands gp-joined when
									     it first appears; DENY = gp-leaving-deny (0.16s collapse).
									     Marks live in _prowLeaving until the server unmounts the
									     row (pruned in Tick; cleared on OnError). -->
									@{ int gpPendingLive = pendingRequests.Count( pr => !IsProwLeaving( pr ) ); }
									<div class="gp-rkick">
										<span class="gp-rkick-t">@($"PENDING · {gpPendingLive}")</span>
										<span class="gp-rkick-x">officers only — accept or deny</span>
									</div>
									@{ int gpPendIdx = 0; }
									@foreach ( var request in pendingRequests )
									{
										var r = request;
										var pIdx = gpPendIdx; gpPendIdx++;
										var pSub = $"LV {r.Level} · asked {FormatAskedAgo( r.RequestedAt )}";
										<div class="gp-prow @(pIdx % 2 == 1 ? "alt" : "") @ProwLeavingClass( r ) @(IsPlazaKb( "pending", pIdx ) ? "guild-kb-selected" : "")"
											 onmouseover=@(( e ) => PendingRowHover( pIdx, e ))>
											<div class="gp-head">
												@if ( r.SteamId > 0 )
												{
													<img class="gp-head-img" src="@($"avatar:{r.SteamId}")" />
												}
												else
												{
													<iconify class="gp-head-glyph" icon="lucide:user-round" Size=@(18) Color="rgba(214, 206, 236, 0.6)" />
												}
											</div>
											<div class="gp-prow-text">
												<span class="gp-mname">@r.PlayerName</span>
												<span class="gp-prow-sub">@pSub</span>
											</div>
											<div class="gp-prow-spacer"></div>
											<!-- LANE: input — Focused = the row is the cursor AND this
											     button is the A/D sub-cursor (BbButton's size-34 ring:
											     -7px/3px, inside the 72px row — no scroll-clip overhang). -->
											<BbButton Tier="secondary" Size=@(34) Label="ACCEPT" Class="gp-pacc" HoverSound=@false Focused=@(IsPlazaKb( "pending", pIdx ) && _kbPendBtn == 0) OnClick=@(() => AcceptPendingWithFold( r )) />
											<BbButton Tier="ghost" Size=@(34) Label="DENY" Class="gp-pdeny" HoverSound=@false Focused=@(IsPlazaKb( "pending", pIdx ) && _kbPendBtn == 1) OnClick=@(() => DenyPendingWithCollapse( r )) />
										</div>
									}
									<div class="gp-rkick dim">
										<span class="gp-rkick-t">@($"MEMBERS · {members.Count}")</span>
									</div>
								}
								@foreach ( var member in gpMembers )
								{
									var m = member;
									var mIdx = gpRosterIdx; gpRosterIdx++;
									var mRoleColor = GuildManager.GetRoleColor( m.Role );
									var mIsYou = m.SteamId == gpLocalId && gpLocalId > 0;
									var mNew = (DateTime.UtcNow - m.JoinedAt).TotalDays < 7.0;
									var mGone = !m.IsOnline && (DateTime.UtcNow - m.LastSeen).TotalDays >= 30.0;
									var mTopContrib = gpTop != null && m.SteamId == gpTop.SteamId && m.WeeklyGuildXP > 0;
									var mVoice = IsMemberInVoice( m );
									var mWeekPx = RosterWeekBarPx( m.WeeklyGuildXP, gpWeekMax );
									var mRoleText = m.Role >= GuildRole.Warden ? GuildManager.GetRoleDisplayName( m.Role ).ToUpper() : "";
									<!-- MEMBER ROW 1064×88 (run 3 — was 120: 60% void when the
									     week is young). Declared 1060 + 4 seam. Lane, left to
									     right: 16 pad + head 44 + 16 + name col 300 + spacer 208
									     + week stat 320 + 16 + presence 120 + 20 pad = 1060 ✓.
									     Vertical: head 44 at y22 · name 22 + role 3+14 = 39 at
									     y24 · week stat centred (bar 6 / number 21). The week
									     stat starts at x 588 (row-relative) — the right half.
									     LANE: input — row click/Space = member action modal (kept).
									     Hover moves the ONE cursor (PlazaHover — one-cursor law);
									     the old hoveredMember side-state is retired. -->
									<div class="gp-mrow @(mIdx % 2 == 1 ? "alt" : "") @(mGone ? "faded" : "") @(IsJoinedPop( m.SteamId ) ? "gp-joined" : "") @(IsPlazaKb( "roster", mIdx ) ? "guild-kb-selected" : "")"
										 onmouseover=@(() => PlazaHover( "roster", mIdx ))
										 onclick=@(() => { OpenMemberMenu( m ); SoundManager.PlayClick(); })>
										<div class="gp-head" style="border-color: @mRoleColor">
											@if ( m.SteamId > 0 )
											{
												<img class="gp-head-img" src="@($"avatar:{m.SteamId}")" />
											}
											else
											{
												<iconify class="gp-head-glyph" icon="lucide:user-round" Size=@(18) Color="rgba(214, 206, 236, 0.6)" />
											}
										</div>
										<div class="gp-mname-col">
											<div class="gp-mname-row">
												<span class="gp-mname">@m.Name</span>
												@if ( mIsYou )
												{
													<div class="gp-you"><span class="gp-you-t">YOU</span></div>
												}
												@if ( mNew )
												{
													<div class="gp-newtag"><span class="gp-new-t">NEW</span></div>
												}
												@if ( mVoice )
												{
													<iconify class="gp-voice" icon="lucide:volume-2" Size=@(14) Color="#4ade80" />
												}
											</div>
											@if ( mRoleText != "" )
											{
												<span class="gp-mrole" style="color: @mRoleColor">@mRoleText</span>
											}
										</div>
										<div class="gp-mrow-spacer"></div>
										<!-- WEEKLY GUILD XP — ONE inline stat (run 3): above zero =
										     bar 200 + the number in blue + XP unit (+ crown on the
										     week's top). Zero = the dim 12px nudge on the YOU row
										     ONLY (one telling on screen, not one per row — run 3
										     follow-up); other members at zero show NOTHING here.
										     The 320 column stays RESERVED either way so the bars
										     line up the moment someone earns XP. -->
										<div class="gp-mweek-col">
											@if ( m.WeeklyGuildXP > 0 )
											{
												<div class="gp-mweek-bar"><div class="gp-mweek-fill" style="width: @(mWeekPx)px"></div></div>
												<span class="gp-mweek-val">@($"{m.WeeklyGuildXP:N0}")</span>
												<span class="gp-mweek-unit">XP</span>
												@if ( mTopContrib )
												{
													<iconify class="gp-crown" icon="lucide:crown" Size=@(13) Color="#ffce3a" />
												}
											}
											else if ( mIsYou )
											{
												<span class="gp-mweek-none">no guild XP yet this week</span>
											}
										</div>
										@if ( m.IsOnline )
										{
											<div class="gp-presence on"><div class="gp-dot"></div><span class="gp-presence-t">HERE</span></div>
										}
										else
										{
											<div class="gp-presence"><span class="gp-presence-t">@FormatLastSeenShort( m.LastSeen )</span></div>
										}
									</div>
								}
							</div>
							<!-- slim overlay scrollbar — imperative px thumb (the
							     Beastbook recipe); geometry written per tick. -->
							<div @ref="rosterSbTrackRef" class="gp-sb"><div @ref="rosterSbThumbRef" class="gp-sb-thumb"></div></div>
						</div>

						<!-- RIGHT COLUMN 768×752 -->
						<div class="gp-right">

							@if ( raid != null )
							{
								<!-- RAID MONUMENT — kept coded, renders NOTHING while
								     RaidsEnabled=false (raid is null). When raids flip
								     on, this block re-appears above THE WEEK and the
								     column compresses (a future pass re-derives the
								     752 split). -->
								<div class="raid-monument" onclick=@(() => { SoundManager.PlayForward(); raidViewOpen = true; })>
									<div class="raid-monument-header">
										<iconify icon="lucide:swords" Size=@(13) Color="#ff8a92" />
										<span class="raid-monument-title">RAID</span>
									</div>
									<div class="raid-monument-content">
										<div class="raid-monument-sprite" style="background-image: url(@GetRaidBossSpritePath())"></div>
										<div class="raid-monument-info">
											<span class="raid-monument-name">@raid.BossName</span>
											<span class="raid-monument-element">@raid.BossElement · Lv @raid.BossLevel</span>
										</div>
									</div>
									<div class="raid-monument-cta">
										<span>ENTER</span>
										<iconify icon="lucide:arrow-right" Size=@(13) Color="#ffffff" />
									</div>
								</div>
							}

							<!-- THE WEEK 768×336 — unmissable. Band 36 (big chip) +
							     3 goal rows. Row math: band 36 + pad 12 + 3×82 +
							     2×8 + pad 26 = 336 ✓. Goal lane: 768 − 32 = 736;
							     bar 480×8 px-fill (GoalBarPx pattern — percent
							     widths on absolute children paint full-width). -->
							<div class="gp-week">
								<div class="gp-band">
									<div class="gp-chipstamp big"><span>THE WEEK</span></div>
									<div class="gp-band-spacer"></div>
									<div class="gp-darkchip"><span>@FormatGoalReset()</span></div>
								</div>
								<div class="gp-week-body" @ref="weekBodyRef">
									@if ( gpGoals.Count == 0 )
									{
										<span class="gp-week-empty">No goals this week.</span>
									}
									@{ int gpGoalIdx = 0; }
									@foreach ( var goal in gpGoals )
									{
										var g = goal;
										var gIdx = gpGoalIdx; gpGoalIdx++;
										var gClaimable = g.Completed && !g.Claimed;
										// LANE: motion — windowed claim-flash class (set by
										// ClaimGoalWithPop; absent outside the window).
										var gPop = (_claimPopGoalId != null && g.Id == _claimPopGoalId && RealTime.Now < _claimPopUntil) ? "gp-pop" : "";
										<div class="gp-goal @gPop @(IsPlazaKb( "week", gIdx ) ? "guild-kb-selected" : "")" onmouseover=@(() => PlazaHover( "week", gIdx ))>
											<div class="gp-goal-top">
												<span class="gp-goal-name">@(g.Title?.ToUpper())</span>
												<div class="gp-goal-spacer"></div>
												<span class="gp-goal-count">@($"{g.Progress:N0} / {g.Target:N0}")</span>
											</div>
											<span class="gp-goal-blurb">@GoalBlurb( g )</span>
											<div class="gp-goal-foot">
												<div class="gp-goal-bar"><div class="gp-goal-fill" style="width: @(WeekGoalBarPx( g ))px"></div></div>
												<div class="gp-goal-spacer"></div>
												@if ( gClaimable )
												{
													<span class="gp-goal-xp gold">@($"+{g.XpReward:N0} XP")</span>
													<!-- gold = the page's ONLY gold (primary law).
													     LANE: motion (attached) — ClaimGoalWithPop keys the
													     row's Tier-2 flash (0.3s) + success sound; press =
													     darker gradient (:active). CLAIM is a sanctioned
													     gold moment (claiming the reward IS the commit).
													     LANE: input — Space claims on the focused row. -->
													<div class="gp-claim" onclick=@(() => ClaimGoalWithPop( g ))><span class="gp-claim-t">CLAIM</span></div>
												}
												else if ( g.Claimed )
												{
													<span class="gp-goal-xp done">CLAIMED</span>
												}
												else
												{
													<span class="gp-goal-xp">@($"+{g.XpReward:N0} XP")</span>
												}
											</div>
										</div>
									}
								</div>
							</div>

							<!-- THE LOG 768×400 — GuildManager.ActivityLog rendered
							     at last (parsed on every fetch, cap 50). Newest
							     first; ~8 rows visible (band 36 + pad 10 + 8×38 +
							     7×2 = 364 ≤ 400), the rest scroll. OnLogUpdated →
							     OnRefresh → StateHasChanged (already subscribed).
							     LANE: motion (attached; run 2 = audit S12) — zone fade rung
							     4 + the gpLogRow0–7 ladder as CLASS rungs stamped by index
							     only while armed (0.9s from the body's first render), then
							     "" — so a prepended entry can't replay the ladder; only the
							     NEW entry ripples (gp-lnew, keyed by entry content). Zebra
							     stays BY POSITION (stable under prepends). Scrollbar
							     arm/fade + hover thumb brighten. -->
							<div class="gp-log">
								<div class="gp-band">
									<div class="gp-chipstamp"><span>THE LOG</span></div>
								</div>
								@if ( gpLog.Count == 0 )
								{
									<div class="gp-log-empty"><span>Nothing logged yet — the week is young.</span></div>
								}
								else
								{
									<!-- LANE: input — log rows are the walk's last stops (zone
									     "log": info focus, Space no-op). The cursor class is
									     stamped IMPERATIVELY (SyncLogCursorClasses / SetClass)
									     — a volatile markup class would remount the row and
									     replay its gpLogRowN entrance ladder on every hop. -->
									<!-- Rows are the GROUPED view (gpLogRows — run 3): a folded
									     SYSTEM run renders ONCE with a dim ×N chip and the NEWEST
									     entry's stamp; the motion key is that newest entry, so a
									     fresh reset still ripples gp-lnew. Row lane 737: actor ·
									     text · [×N chip] · spacer · time. -->
									<div class="gp-log-list" @ref="logScrollRef">
										@{ int gpLogRowIdx = 0; }
										@foreach ( var row in gpLogRows )
										{
											var lr = row;
											var e = lr.Entry;
											var lIdx = gpLogRowIdx; gpLogRowIdx++;
											<div class="gp-lrow @(lIdx % 2 == 1 ? "alt" : "") @LogRowMotionClass( e, lIdx )" onmouseover=@(() => PlazaHover( "log", lIdx ))>
												@if ( lr.Actor != "" )
												{
													<span class="gp-log-actor">@lr.Actor</span>
												}
												<span class="gp-log-text">@lr.Text</span>
												@if ( lr.Count > 1 )
												{
													<div class="gp-log-count"><span>@($"×{lr.Count}")</span></div>
												}
												<div class="gp-lrow-spacer"></div>
												<span class="gp-log-time">@FormatLogTimeShort( e.Timestamp )</span>
											</div>
										}
									</div>
									<div @ref="logSbTrackRef" class="gp-sb"><div @ref="logSbThumbRef" class="gp-sb-thumb"></div></div>
								}
							</div>
						</div>
					</div>
				</div>
				}

				<!-- ── PERK LADDER — the next-unlock chip, pressed. Centered
				     via FLEX on the root (never translate(-50%) — transform
				     poisons descendant flex). Lists every WIRED stop only:
				     LV 5/10/15/30/35 — LV 20/25/40/45/50 render NOTHING
				     (honesty rule). Modal math: band 36 + pad 16 + 5×56 +
				     4×8 + pad 16 = 380 tall, 560 wide (rows 528).
				     LANE: input — Q closes (wired below); W/S walk = info
				     rows, no press stamp. LANE: motion (attached) — ALWAYS
				     MOUNTED + .open class toggle (the class-toggle recipe) so
				     the opacity fade replays every open AND close animates
				     (0.2s in / 0.12s out; a fresh if-mount can't animate its
				     exit). Closed = opacity 0 + pointer-events none. -->
				<div class="gp-ladder-root @gpLadderOpen" onclick=@(() => { showPerkLadder = false; SoundManager.PlayBack(); })>
						<div class="gp-ladder" onclick:stopPropagation>
							<div class="gp-band">
								<div class="gp-chipstamp"><span>GUILD PERKS</span></div>
								<div class="gp-band-spacer"></div>
								<div class="gp-darkchip"><span>@gpLadderChip</span></div>
							</div>
							<!-- LANE: input — W/S walk the perk rows (info stops, no press);
							     hover moves the same cursor. Space/Enter/E/Q close. -->
							<div class="gp-ladder-body">
								@{ int gpPkIdx = 0; }
								@foreach ( var wp in WiredPerks )
								{
									var wpUnlocked = guild.Level >= wp.Level;
									var wpNext = gpNext != null && wp.Level == gpNext.Level;
									var wpIdx = gpPkIdx; gpPkIdx++;
									<div class="gp-pk @(wpUnlocked ? "" : "dim") @(IsLadderKb( wpIdx ) ? "guild-kb-selected" : "")" onmouseover=@(() => LadderHover( wpIdx ))>
										<span class="gp-pk-lv">@($"LV {wp.Level}")</span>
										<div class="gp-pk-col">
											<span class="gp-pk-name">@wp.Name.ToUpper()</span>
											<span class="gp-pk-effect">@wp.Effect</span>
										</div>
										<div class="gp-pk-spacer"></div>
										@if ( wpNext )
										{
											<div class="gp-pk-next"><span>NEXT</span></div>
										}
									</div>
								}
							</div>
						</div>
					</div>
			</div>
		}

		<!-- MEMBER ACTION MODAL — promote/demote/kick (officer-only) on member click -->
		@if ( showMemberMenu && selectedMember != null )
		{
			@{
				var sm = selectedMember;
				var canManage = gm.IsOfficer && sm.SteamId != (Connection.Local?.SteamId ?? 0) && sm.Role < gm.Membership.Role;
			}
			<!-- LANE: input (run-2 closeout S-A) — the overlay is a SIBLING of
			     .gp-page, so it wears the device class itself (its hover rules
			     are gated under .confirm-overlay.mouse-mode) and carries the
			     same real-movement flip-back edge. -->
			<div class="confirm-overlay @(_gpKbdMode ? "kbd-mode" : "mouse-mode")" onmousemove=@OnGpPageMouseMove onclick=@(() => { showMemberMenu = false; selectedMember = null; })>
				<div class="member-menu" onclick:stopPropagation>
					<div class="member-menu-header">
						<div class="member-menu-portrait" style="border-color: @GuildManager.GetRoleColor( sm.Role )">
							<iconify icon="@GetAvatarIcon( sm )" Size=@(32) Color="@GuildManager.GetRoleColor( sm.Role )" />
						</div>
						<div class="member-menu-info">
							<span class="member-menu-name">@sm.Name</span>
							<span class="member-menu-role" style="color: @GuildManager.GetRoleColor( sm.Role )">@GuildManager.GetRoleDisplayName( sm.Role )</span>
							<span class="member-menu-stats">Lv @sm.Level · @sm.ArenaRank · @sm.ArenaPoints RP</span>
						</div>
					</div>
					<div class="member-menu-actions">
						@{ var menuKbIdx = 0; }
						@if ( canManage && gm.IsLeader && sm.Role < GuildRole.Warden )
						{
							var promoteIdx = menuKbIdx; menuKbIdx++;
							<button class="member-menu-action @(IsMemberMenuKb( promoteIdx ) ? "guild-kb-selected" : "")" onmouseover=@(() => MemberMenuHover( promoteIdx )) onclick=@(() => { gm.PromoteMember( sm.SteamId ); SoundManager.PlaySelect(); showMemberMenu = false; selectedMember = null; })>
								<iconify icon="lucide:chevron-up" Size=@(14) Color="#4ade80" />
								<span>Promote</span>
							</button>
						}
						@if ( canManage && gm.IsLeader && sm.Role > GuildRole.Wanderer && sm.Role < GuildRole.Beastlord )
						{
							var demoteIdx = menuKbIdx; menuKbIdx++;
							<button class="member-menu-action @(IsMemberMenuKb( demoteIdx ) ? "guild-kb-selected" : "")" onmouseover=@(() => MemberMenuHover( demoteIdx )) onclick=@(() => { gm.DemoteMember( sm.SteamId ); SoundManager.PlayClick(); showMemberMenu = false; selectedMember = null; })>
								<iconify icon="lucide:chevron-down" Size=@(14) Color="#a79dbe" />
								<span>Demote</span>
							</button>
						}
						@if ( canManage )
						{
							var kickIdx = menuKbIdx; menuKbIdx++;
							<button class="member-menu-action danger @(IsMemberMenuKb( kickIdx ) ? "guild-kb-selected" : "")" onmouseover=@(() => MemberMenuHover( kickIdx )) onclick=@(() => { ConfirmKick( sm ); SoundManager.PlayPopup(); showMemberMenu = false; selectedMember = null; })>
								<iconify icon="lucide:user-x" Size=@(14) Color="#ff8a92" />
								<span>Kick</span>
							</button>
						}
						@{ var closeIdx = menuKbIdx; menuKbIdx++; }
						<button class="member-menu-action @(IsMemberMenuKb( closeIdx ) ? "guild-kb-selected" : "")" onmouseover=@(() => MemberMenuHover( closeIdx )) onclick=@(() => { showMemberMenu = false; selectedMember = null; })>
							<iconify icon="lucide:x" Size=@(14) Color="rgba(214, 206, 236, 0.6)" />
							<span>Close</span>
						</button>
					</div>
				</div>
			</div>
		}


		<!-- Raid Battle Overlay -->
		@if ( showRaidBattle )
		{
			<div class="raid-battle-container">
				<BattleView IsRaidBattle=@true OnBattleEnd=@OnRaidBattleComplete />
			</div>
		}

		<!-- Confirm Dialog -->
		@* Confirm dialogs use shared <ConfirmDialog> component (mounted globally in GameHUD) *@

		<!-- Raid Results Overlay -->
		@if ( showRaidResults )
		{
			<div class="confirm-overlay">
				<div class="raid-results-card">
					<span class="raid-results-title">Raid Complete!</span>
					<div class="raid-result-row">
						<span class="raid-result-label">Raw Damage</span>
						<span class="raid-result-value">@($"{raidResultDamage:N0}")</span>
					</div>
					<div class="raid-result-row">
						<span class="raid-result-label">Combo: @raidResultComboName</span>
						<span class="raid-result-value">@($"{raidResultComboMultiplier:F1}")x</span>
					</div>
					<div class="raid-result-total">
						<span class="raid-result-label">Total Score</span>
						<span class="raid-result-score">@($"{raidResultScore:N0}")</span>
					</div>
					<div class="guild-btn raid-attack-btn" onclick=@(() => showRaidResults = false)>
						<span>Continue</span>
					</div>
				</div>
			</div>
		}

		<!-- Picker Overlay -->
		@if ( showPicker )
		{
			<!-- LANE: input (S-A) — device class + flip-back edge on the overlay
			     root (sibling of .gp-page; see the member menu above). -->
			<div class="confirm-overlay @(_gpKbdMode ? "kbd-mode" : "mouse-mode")" onmousemove=@OnGpPageMouseMove onclick=@(() => { ClosePicker(); })>
				<div class="picker-dialog" onclick:stopPropagation>
					<div class="picker-header-row">
						@{ var pickerIcon = pickerMode == "invite" ? "lucide:user-plus" : "lucide:shield-check"; }
						<iconify icon="@pickerIcon" Size=@(15) Color="#6fb1f0" />
						<span class="picker-title">@pickerTitle</span>
						<button class="picker-close-btn" onclick=@(() => ClosePicker())>
							<iconify icon="lucide:x" Size=@(14) Color="rgba(214, 206, 236, 0.7)" />
						</button>
					</div>
					<div class="picker-list">
						@if ( pickerMode == "invite" )
						{
							<!-- INVITE — "the list of ALL players" (2026-09-02). Rows come
							     from GuildManager.GetAllInviteCandidates( pickerSearch ):
							     live lobby → server-wide player directory (leaderboards,
							     async) → collected cards; ordered online-first. Every
							     child here is a DIRECT child of .picker-list (flat scroll
							     law): search row (kb row 0) · kickers · rows · notes.
							     Space on a row INVITES and the picker STAYS OPEN — the row
							     flips to PENDING when the API confirms; Q/X close. -->
							@{
								var candidates = GetPickerCandidates();
								var dirLoading = CompetitiveManager.Instance?.PlayerDirectoryLoading ?? false;
								var hasFilter = !string.IsNullOrWhiteSpace( pickerSearch );
								var pickerKbIdx = 1; // row 0 is the search field
								var kickOnline = false;
								var kickAll = false;
							}
							<div class="picker-search @(IsPickerKb( 0 ) ? "guild-kb-selected" : "")" onmouseover=@(() => PickerHover( 0 ))>
								<iconify class="picker-search-icon" icon="lucide:search" Size=@(13) Color="rgba(214, 206, 236, 0.6)" />
								<TextEntry class="picker-search-input" @ref="pickerSearchInput" Text="@pickerSearch" Placeholder="Search players…" />
							</div>
							@if ( candidates.Count == 0 && !( dirLoading && !hasFilter ) )
							{
								<span class="picker-empty">@(hasFilter ? "No players match" : "No one to invite yet")</span>
							}
							@foreach ( var c in candidates )
							{
								var cRef = c;
								var thisPickerIdx = pickerKbIdx; pickerKbIdx++;
								if ( cRef.IsOnline && !kickOnline )
								{
									kickOnline = true;
									<span class="picker-kick">Online now</span>
								}
								if ( !cRef.IsOnline && !kickAll )
								{
									kickAll = true;
									<span class="picker-kick">Everyone</span>
									if ( dirLoading && !hasFilter )
									{
										<span class="picker-loading">Loading players…</span>
									}
								}
								<div class="picker-item @(cRef.IsPending ? "pending" : "") @(IsPickerKb( thisPickerIdx ) ? "guild-kb-selected" : "")" onmouseover=@(() => PickerHover( thisPickerIdx )) onclick=@(() => PickerInvite( cRef ))>
									<img class="picker-avatar" src="avatar:@cRef.SteamId" />
									<span class="picker-name">@cRef.Name</span>
									@if ( cRef.Level > 0 )
									{
										<span class="picker-level">LV @cRef.Level</span>
									}
									@if ( cRef.IsOnline )
									{
										<span class="picker-online-dot">●</span>
									}
									@if ( cRef.IsPending )
									{
										<span class="picker-pending">Pending</span>
									}
								</div>
							}
							@if ( !kickAll && dirLoading && !hasFilter )
							{
								<span class="picker-kick">Everyone</span>
								<span class="picker-loading">Loading players…</span>
							}
						}
						else if ( pickerMode == "transfer" )
						{
							@{
								var eligibleMembers = GuildManager.Instance?.Members?.Where( m => m.SteamId != (Connection.Local?.SteamId ?? 0) && m.Role >= GuildRole.Tamer ).ToList() ?? new();
							}
							@if ( eligibleMembers.Count == 0 )
							{
								<span class="picker-empty">No eligible members</span>
							}
							@{ var transferKbIdx = 0; }
							@foreach ( var member in eligibleMembers )
							{
								var thisTransferIdx = transferKbIdx; transferKbIdx++;
								<div class="picker-item @(IsPickerKb( thisTransferIdx ) ? "guild-kb-selected" : "")" onmouseover=@(() => PickerHover( thisTransferIdx )) onclick=@(() => { GuildManager.Instance?.TransferOwnership( member.SteamId ); ClosePicker(); SoundManager.PlaySuccess(); })>
									<span class="picker-name">@member.Name</span>
									<span class="picker-role">@member.Role</span>
								</div>
							}
						}
					</div>
				</div>
			</div>
		}
	}
}

@if ( !string.IsNullOrEmpty( errorMessage ) && !( guildView == "myguild" && !InGuildLive() ) )
{
	<div class="guild-error-toast">
		<span>@errorMessage</span>
	</div>
}

</div>

