	// "asked 2h ago" — the pending row's waiting time (FormatLastSeen family).
	private static string FormatAskedAgo( DateTime requestedAt )
	{
		var diff = DateTime.UtcNow - requestedAt;
		if ( diff.TotalMinutes < 2 ) return "just now";
		if ( diff.TotalMinutes < 60 ) return $"{(int)diff.TotalMinutes}m ago";
		if ( diff.TotalHours < 24 ) return $"{(int)diff.TotalHours}h ago";
		if ( diff.TotalDays < 2 ) return "yesterday";
		return $"{(int)diff.TotalDays}d ago";
	}

	// BEAST tile sources — the first 8, deduped, every one with a sprite.
	// The ORDER IS STABLE while the form is open (run 3 fix): it hoists the
	// guild's SAVED emblem (Guild.EmblemIcon), never the PENDING pick — the
	// old version hoisted `emblemIcon`, so every A/D rebuilt the list with
	// the new pick at index 0 and the cycle ping-ponged between two beasts
	// ("I can only switch between two"). Tiles and CycleSettingsRow share
	// this one list; the pending pick is guaranteed present (appended into
	// the last slot if the sources ever push it past the cap).
	//   0. the SAVED emblem (so the live tile is always on the row)
	//   1. your favorite, then your roster (MonsterManager.OwnedMonsters,
	//      in roster order)
	//   2. the members' favorites — online broadcast profiles first
	//      (ChatManager.PlayerProfiles by ConnectionId), then any TamerCard
	//      you hold for an offline member.
	// Saved value = "beast:<speciesId>" — the one canonical emblem key.
	private List<MonsterSpecies> GetEmblemBeastChoices()
	{
		var mm = MonsterManager.Instance;
		var result = new List<MonsterSpecies>();
		if ( mm == null ) return result;
		var seen = new HashSet<string>();
		void Add( string speciesId )
		{
			if ( string.IsNullOrEmpty( speciesId ) || result.Count >= 8 || !seen.Add( speciesId ) ) return;
			var s = mm.GetSpecies( speciesId );
			if ( s != null && !string.IsNullOrEmpty( s.IconPath ) ) result.Add( s );
		}

		var savedIcon = GuildManager.Instance?.Guild?.EmblemIcon ?? "";
		if ( savedIcon.StartsWith( "beast:" ) ) Add( savedIcon.Substring( 6 ) );
		Add( TamerManager.Instance?.CurrentTamer?.FavoriteMonsterSpeciesId );
		foreach ( var m in mm.OwnedMonsters ?? new List<Monster>() )
			Add( m?.SpeciesId );

		var members = GuildManager.Instance?.Members;
		if ( members != null )
		{
			var profiles = ChatManager.Instance?.PlayerProfiles;
			var cards = TamerManager.Instance?.CurrentTamer?.CollectedCards;
			foreach ( var member in members )
			{
				if ( member == null ) continue;
				if ( !string.IsNullOrEmpty( member.ConnectionId ) && profiles != null
					&& profiles.TryGetValue( member.ConnectionId, out var profile ) )
					Add( profile?.FavoriteMonsterSpeciesId );
				Add( cards?.FirstOrDefault( c => c != null && c.SteamId == member.SteamId )?.FavoriteMonsterSpeciesId );
			}
		}

		// The PENDING pick must be a tile (the cycle indexes this list). It
		// came from this list, so this only fires if a source churned it out.
		var pendingId = ( emblemIcon ?? "" ).StartsWith( "beast:" ) ? emblemIcon.Substring( 6 ) : "";
		if ( pendingId != "" && !result.Any( s => s.Id == pendingId ) )
		{
			var ps = mm.GetSpecies( pendingId );
			if ( ps != null && !string.IsNullOrEmpty( ps.IconPath ) )
			{
				if ( result.Count >= 8 ) result.RemoveAt( result.Count - 1 );
				result.Add( ps );
			}
		}
		return result;
	}

	// TEMP dev instrument (run 2 LAYOUT): jump the guild page into a state
	// for screenshots. `dev_guildview settings` → the sub-view ·
	// `dev_guildview pending` → seeds two FAKE join requests into the
	// client-side list (you must be an officer to see PENDING; ACCEPT/DENY
	// on a fake would hit the server — screenshots only) and scrolls the
	// roster to them · `dev_guildview off` → clears the fakes, back to the page.
	private static GuildPanel _devGuild;
	private static readonly List<GuildJoinRequest> _devFakeRequests = new();
	// `dev_guildview invites` → three FAKE GuildInvites in PendingInvites (a
	// mutable List — Add works; ACCEPT/DECLINE on one would hit the server —
	// screenshots only); tracked by reference so `off` removes only ours.
	// `dev_guildview landing0` → the landing with the recruiting list forced
	// empty (the honest line).
	private static readonly List<GuildInvite> _devFakeInvites = new();

	[ConCmd( "dev_guildview" )]
	public static void DevGuildView( string mode = "settings" )
	{
		var p = _devGuild;
		var gm = GuildManager.Instance;
		if ( p == null || gm == null ) { Log.Warning( "[dev_guildview] Guild page not mounted." ); return; }
		switch ( mode )
		{
			case "settings":
				p.guildView = "myguild";
				p.showSettingsView = true;
				p._kbIndex = 0;
				break;
			case "pending":
				p.guildView = "myguild";
				p.showSettingsView = false;
				if ( _devFakeRequests.Count == 0 && gm.JoinRequests != null )
				{
					var now = DateTime.UtcNow;
					_devFakeRequests.Add( new GuildJoinRequest { SteamId = 0, PlayerName = "Thistledown", Level = 12, RequestedAt = now.AddHours( -2 ) } );
					_devFakeRequests.Add( new GuildJoinRequest { SteamId = 0, PlayerName = "Kestrel_9", Level = 31, RequestedAt = now.AddDays( -1 ) } );
					gm.JoinRequests.AddRange( _devFakeRequests );
				}
				if ( !gm.IsOfficer ) Log.Warning( "[dev_guildview] PENDING renders for officers only — you are not one in this guild." );
				p.ScrollRosterToPending();
				break;
			// Run 3 — the NO-GUILD views, renderable while in a guild (_devNoGuild
			// makes every in-guild branch point read false; ACCEPT / JOIN / FOUND
			// would still hit the server — screenshots only).
			case "landing":
				p._devNoGuild = true;
				p._devNoRecruits = false;
				p.guildView = "landing";
				p.showSettingsView = false;
				p.ResetKb();
				p.LoadGuildsFromApi();
				break;
			case "landing0":
				p._devNoGuild = true;
				p._devNoRecruits = true;
				p.guildView = "landing";
				p.showSettingsView = false;
				p.ResetKb();
				break;
			case "invites":
				p._devNoGuild = true;
				p._devNoRecruits = false;
				p.guildView = "landing";
				p.showSettingsView = false;
				if ( _devFakeInvites.Count == 0 && gm.PendingInvites != null )
				{
					var now = DateTime.UtcNow;
					_devFakeInvites.Add( new GuildInvite { ApiId = -1, GuildId = "dev-inv-1", GuildName = "Saltmoor Wardens", GuildTag = "SALT", InviterName = "Thistledown", SentAt = now.AddHours( -1 ) } );
					_devFakeInvites.Add( new GuildInvite { ApiId = -2, GuildId = "dev-inv-2", GuildName = "Loom and Lantern", GuildTag = "LOOM", InviterName = "Kestrel_9", SentAt = now.AddHours( -5 ) } );
					_devFakeInvites.Add( new GuildInvite { ApiId = -3, GuildId = "dev-inv-3", GuildName = "Weavermere Painters", GuildTag = "HUE", InviterName = "Selene", SentAt = now.AddDays( -1 ) } );
					gm.PendingInvites.AddRange( _devFakeInvites );
				}
				p.ResetKb();
				p.LoadGuildsFromApi();
				break;
			case "browse":
				p._devNoGuild = true;
				p.guildView = "browse";
				p.showSettingsView = false;
				p.viewingGuild = null;
				p.ResetKb();
				p.LoadGuildsFromApi();
				break;
			case "create":
				p._devNoGuild = true;
				p.guildView = "myguild"; // no guild → the create form
				p.showSettingsView = false;
				p.ResetKb();
				break;
			case "off":
				p.showSettingsView = false;
				p._devNoGuild = false;
				p._devNoRecruits = false;
				p.guildView = gm.IsInGuild ? "myguild" : "landing";
				p.viewingGuild = null;
				p.ResetKb();
				foreach ( var f in _devFakeRequests ) gm.JoinRequests?.Remove( f );
				_devFakeRequests.Clear();
				foreach ( var f in _devFakeInvites ) gm.PendingInvites?.Remove( f ); // only the ones we added (by reference)
				_devFakeInvites.Clear();
				break;
			default:
				Log.Info( "[dev_guildview] modes: settings | pending | landing | landing0 | invites | browse | create | off" );
				return;
		}
		p.StateHasChanged();
		Log.Info( $"[dev_guildview] -> {mode}" );
	}

	// TEMP dev instrument (run 2 MOTION, DOC-4 §20): fire / FREEZE the two
	// windowed pops + the joined beat so the main session can screenshot
	// them. `dev_guildfx lv` holds the LV stamp at its gold ×1.45 peak
	// (0% frame, paused via the gp-fx-freeze root class); `dev_guildfx
	// claim` holds the first goal row's gold rim; `dev_guildfx joined` holds
	// the first member row's blue seam. Add `play` to run each at real
	// timing (`dev_guildfx lv play`). `dev_guildfx off` clears everything.
	[ConCmd( "dev_guildfx" )]
	public static void DevGuildFx( string beat = "lv", string mode = "freeze" )
	{
		var p = _devGuild;
		var gm = GuildManager.Instance;
		if ( p == null || gm == null ) { Log.Warning( "[dev_guildfx] Guild page not mounted." ); return; }
		bool freeze = mode != "play";
		float win = freeze ? 600f : 0.6f;
		switch ( beat )
		{
			case "lv":
				p._lvPopUntil = RealTime.Now + win;
				break;
			case "claim":
				var g = gm.WeeklyGoals?.FirstOrDefault();
				if ( g == null ) { Log.Warning( "[dev_guildfx] No weekly goals to flash." ); return; }
				p._claimPopGoalId = g.Id;
				p._claimPopUntil = RealTime.Now + win;
				break;
			case "joined":
				var m = gm.Members?.FirstOrDefault( x => x != null && x.SteamId > 0 ) ?? gm.Members?.FirstOrDefault();
				if ( m == null ) { Log.Warning( "[dev_guildfx] No member rows." ); return; }
				p._joinedPopSteamId = m.SteamId;
				p._joinedPopUntil = RealTime.Now + (freeze ? 600f : 0.8f);
				break;
			case "off":
				p._lvPopUntil = -1f;
				p._claimPopUntil = -1f;
				p._claimPopGoalId = null;
				p._joinedPopUntil = -1f;
				p._joinedPopSteamId = 0;
				p._gpFxFreeze = false;
				p.StateHasChanged();
				Log.Info( "[dev_guildfx] cleared" );
				return;
			default:
				Log.Info( "[dev_guildfx] beats: lv | claim | joined | off   (add `play` for real timing)" );
				return;
		}
		p._gpFxFreeze = freeze;
		p.StateHasChanged();
		Log.Info( $"[dev_guildfx] {beat} -> {(freeze ? "FROZEN at the 0% frame" : "playing")}" );
	}

