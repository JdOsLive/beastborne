		if ( raidTeamSelection.Count == 0 ) return;
		showRaidTeamSelect = false;

		var gm = GuildManager.Instance;
		if ( gm == null || gm.CurrentRaidBoss == null ) return;

		var bossSpecies = MonsterManager.Instance?.GetSpecies( gm.CurrentRaidBoss.BossSpeciesId );
		if ( bossSpecies == null ) return;

		var raidBoss = new Monster
		{
			SpeciesId = gm.CurrentRaidBoss.BossSpeciesId,
			Nickname = gm.CurrentRaidBoss.BossName,
			Level = gm.CurrentRaidBoss.BossLevel
		};
		MonsterManager.Instance?.RecalculateStats( raidBoss );
		raidBoss.CurrentHP = 999999;
		raidBoss.MaxHP = 999999;

		// Start interactive raid battle via BattleManager
		BattleManager.Instance?.StartRaidBattle( raidTeamSelection, raidBoss, gm.CurrentRaidBoss.MaxRounds );
		showRaidBattle = true;
	}

	private void OnRaidBattleComplete( bool playerWon )
	{
		showRaidBattle = false;

		var bm = BattleManager.Instance;
		var gm = GuildManager.Instance;
		if ( bm == null || gm == null ) return;

		int rawDamage = bm.RaidDamageDealt;
		int roundsUsed = bm.RaidCurrentRound;

		var combo = gm.CalculateComboBonus( raidTeamSelection );

		gm.CompleteRaidAttempt( rawDamage, combo.Multiplier, combo.ComboName, roundsUsed );

		raidResultDamage = rawDamage;
		raidResultComboName = combo.ComboName;
		raidResultComboMultiplier = combo.Multiplier;
		raidResultScore = (int)(rawDamage * combo.Multiplier);
		showRaidResults = true;

		bm.ExitBattle();
		raidTeamSelection.Clear();
	}

	// Formatting
	private string FormatCooldown()
	{
		var remaining = GuildManager.Instance?.GetHopCooldownRemaining() ?? TimeSpan.Zero;
		if ( remaining.TotalHours >= 1 )
			return $"{(int)remaining.TotalHours}h {remaining.Minutes}m";
		return $"{remaining.Minutes}m";
	}

	private string FormatRaidTimer()
	{
		var end = GuildManager.Instance?.GetPeriodEndDate() ?? DateTime.UtcNow;
		var remaining = end - DateTime.UtcNow;
		if ( remaining <= TimeSpan.Zero )
			return "rotating now";
		if ( remaining.TotalDays >= 1 )
			return $"{(int)remaining.TotalDays}d {remaining.Hours}h";
		if ( remaining.TotalHours >= 1 )
			return $"{remaining.Hours}h {remaining.Minutes}m";
		return $"{remaining.Minutes}m {remaining.Seconds}s";
	}

	// Honest presence copy — the 60s heartbeat keeps last_seen fresh.
	// "HERE" (same lobby) is rendered by the caller; this is the elsewhere
	// half. 30+ days also dims the whole row (.faded in the markup).
	private static string FormatLastSeenShort( DateTime lastSeen )
	{
		var diff = DateTime.UtcNow - lastSeen;
		if ( diff.TotalMinutes < 60 ) return "just now";
		if ( diff.TotalHours < 24 ) return $"{(int)diff.TotalHours}h ago";
		if ( diff.TotalDays < 7 ) return $"{(int)diff.TotalDays}d ago";
		if ( diff.TotalDays < 30 ) return $"{(int)(diff.TotalDays / 7)}w ago";
		return $"last seen in {lastSeen.ToString( "MMMM" )}";
	}

	// Log time — the terse feed form ("2h" · "3d" · "2w"), dim right column.
	private static string FormatLogTimeShort( DateTime timestamp )
	{
		var diff = DateTime.UtcNow - timestamp;
		if ( diff.TotalMinutes < 60 ) return $"{Math.Max( 1, (int)diff.TotalMinutes )}m";
		if ( diff.TotalHours < 24 ) return $"{(int)diff.TotalHours}h";
		if ( diff.TotalDays < 7 ) return $"{(int)diff.TotalDays}d";
		return $"{(int)(diff.TotalDays / 7)}w";
	}

	// Feed v1 row copy — actor bold (caller), verb plain. Details wins when
	// the server wrote one; the Action switch covers today's server verbs.
	// Feed-v2 gameplay rows ("contracted Wishstar") arrive as Details and
	// render with zero client changes.
	private static string LogActionText( GuildLogEntry e )
	{
		if ( e == null ) return "";
		if ( !string.IsNullOrEmpty( e.Details ) ) return e.Details;
		return e.Action switch
		{
			"joined" => "joined",
			"left" => "left",
			"kicked" => "was kicked",
			"promoted" => "was promoted",
			"demoted" => "was demoted",
			"created" => "founded the guild",
			"updated" => "updated the guild",
			"invited" => "sent an invite",
			"approved" => "approved a join request",
			"succession" => "claimed leadership",
			_ => e.Action ?? ""
		};
	}

	private float GetGuildXPPercent()
	{
		var guild = GuildManager.Instance?.Guild;
		if ( guild == null ) return 0;
		var currentLevelXP = GuildManager.GetXPForGuildLevel( guild.Level );
		var nextLevelXP = GuildManager.GetXPForGuildLevel( guild.Level + 1 );
		var xpInLevel = guild.GuildXP - currentLevelXP;
		var xpNeeded = nextLevelXP - currentLevelXP;
		if ( xpNeeded <= 0 ) return 100;
		return Math.Min( 100, (float)xpInLevel / xpNeeded * 100f );
	}

	private long GetGuildXPInLevel()
	{
		var guild = GuildManager.Instance?.Guild;
		if ( guild == null ) return 0;
		long inLevel = guild.GuildXP - GuildManager.GetXPForGuildLevel( guild.Level );
		// Clamp to the level span. If GuildXP has run past the next-level
		// threshold (server-side Level lagging behind its XP, or legacy guild
		// data), the bar FILL already clamps to 100% — keep the displayed
		// numerator in sync instead of reading nonsense like "30,180 / 6,510".
		long needed = GetGuildXPNeededForNext();
		return needed > 0 ? Math.Clamp( inLevel, 0L, needed ) : Math.Max( 0L, inLevel );
	}

	private long GetGuildXPNeededForNext()
	{
		var guild = GuildManager.Instance?.Guild;
		if ( guild == null ) return 0;
		return GuildManager.GetXPForGuildLevel( guild.Level + 1 ) - GuildManager.GetXPForGuildLevel( guild.Level );
	}

