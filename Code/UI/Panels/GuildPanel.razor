	// ── kb-selected predicates — one per focusable region. Each returns true
	//    only when the cursor is active, parked in the matching zone, and on
	//    the given index. The markup applies `guild-kb-selected` accordingly.
	private bool IsLandingKb( int idx ) => _kbActive && _kbZone == "landing" && _kbIndex == idx;
	private bool IsBrowseGridKb( int idx ) => _kbActive && _kbZone == "browse-grid" && _kbIndex == idx;
	private bool IsBrowseDetailKb( int idx ) => _kbActive && _kbZone == "browse-detail" && _kbIndex == idx;
	// One generic predicate for the rebuilt guild page's zones
	// (chips / unlock / info / roster / week).
	private bool IsPlazaKb( string zone, int idx ) => _kbActive && _kbZone == zone && _kbIndex == idx;
	private bool IsCreateKb( int idx ) => _kbActive && _kbZone == "create" && _kbIndex == idx;
	private bool IsRaidSelectKb( int idx ) => _kbActive && _kbZone == "raid-select" && _kbIndex == idx;
	// Modals own the keyboard whenever open, so their cursor shows immediately.
	private bool IsMemberMenuKb( int idx ) => showMemberMenu && _kbIndex == idx;
	private bool IsRequestsKb( int idx ) => showRequestsModal && _kbIndex == idx;
	private bool IsPickerKb( int idx ) => showPicker && _kbIndex == idx;

	// Reset the keyboard cursor — call on every view/sub-state transition so a
	// stale index from the previous view doesn't carry a ghost cursor over.
	private void ResetKb()
	{
		_kbActive = false;
		_kbZone = "";
		_kbIndex = 0;
		_kbSearchFocused = false;
	}

	// Tree-walk helper — find the first descendant carrying `cls`. Used for live
	// column measurement (the roster grid is flex-wrap).
	private Panel FindKbPanel( string cls )
	{
		return FindKbPanel( this, cls );
	}

	private Panel FindKbPanel( Panel root, string cls )
	{
		if ( root == null ) return null;
		foreach ( var c in root.Children )
		{
			if ( c.HasClass( cls ) ) return c;
			var found = FindKbPanel( c, cls );
			if ( found != null ) return found;
		}
		return null;
	}

	public override void OnDeleted()
	{
		if ( GuildManager.Instance != null )
		{
			GuildManager.Instance.OnGuildUpdated -= OnRefresh;
			GuildManager.Instance.OnMembersUpdated -= OnRefresh;
			GuildManager.Instance.OnLogUpdated -= OnRefresh;
			GuildManager.Instance.OnGuildError -= OnError;
		}
	}

	private void OnRefresh()
	{
		var guild = GuildManager.Instance?.Guild;
		if ( guild != null )
		{
			emblemColor = guild.EmblemColor;
			emblemIcon = guild.EmblemIcon;
			emblemShape = guild.EmblemShape;
			settingsJoinMode = guild.JoinMode;
			settingsMinLevel = guild.MinLevel;
			settingsMinRank = guild.MinRank;
			settingsAutoKick = guild.AutoKickInactive;
			settingsInactiveDays = guild.InactiveDays;
			settingsDescription = guild.Description ?? "";
		}
		else
		{
			settingsJoinMode = GuildJoinMode.Request;
			settingsMinLevel = 1;
			settingsMinRank = "Unranked";
			settingsAutoKick = false;
			settingsInactiveDays = 3;
			settingsDescription = "";
			guildView = "landing";
		}
		editingMotd = false;
		errorMessage = "";
	}
