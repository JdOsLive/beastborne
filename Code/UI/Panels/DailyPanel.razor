@namespace Beastborne.UI.Panels
@using Sandbox;
@using Sandbox.UI;
@using Beastborne.Core;
@using Beastborne.Data;
@using Beastborne.Systems;
@using Beastborne.UI;
@inherits Panel

<root class="daily-panel-root @(IsVisible ? "visible" : "")">
	<div class="daily-overlay" onclick=@Close></div>

	<div class="daily-modal pop-@popVersion reveal-@popVersion">
		<div class="daily-header">
			<div class="dh-left">
				<div class="dh-kicker"><span>LOGIN BONUS</span></div>
				<span class="dh-title">@L("ui.daily.title")</span>
			</div>
			<div class="dh-tabs">
				<div class="dh-tab @(activeTab == "streak" ? "active" : "")"
					 onclick=@(() => { SoundManager.PlayClick(); activeTab = "streak"; })
					 onmouseover=@(() => SoundManager.PlayHover())>
					<div class="dh-tab-in">
						<img class="dh-tab-icon" src="ui/icons/sort/streak.svg" />
						<span class="dh-tab-label">@L("ui.daily.login_streak")</span>
					</div>
				</div>
				<div class="dh-tab @(activeTab == "missions" ? "active" : "")"
					 onclick=@(() => { SoundManager.PlayClick(); activeTab = "missions"; })
					 onmouseover=@(() => SoundManager.PlayHover())>
					<div class="dh-tab-in">
						<img class="dh-tab-icon" src="ui/icons/sort/missions-icon.svg" />
						<span class="dh-tab-label">@L("ui.daily.missions")</span>
					</div>
				</div>
			</div>
			<div class="dh-right">
				<span class="dh-timer-lbl">@L("ui.daily.refresh_in")</span>
				<div class="dh-timer"><span>@GetRefreshTime()</span></div>
				<button class="close-btn" onclick=@Close>
					<iconify icon="lucide:x" Size=@(15) Color="rgba(255, 255, 255, 0.85)" />
				</button>
			</div>
		</div>

		@if (activeTab == "streak")
		{
			<!-- LOGIN STREAK VIEW — Today-First layout: hero + week strip + milestone -->
			<div class="streak-content">
				@{
					var todayReward = GetTodayReward();
					var nextMs = GetNextMilestone();
				}

				<!-- ═══ TODAY'S REWARD HERO ═══ -->
				<div class="today-hero @(streakRevealStage >= 1 ? "entered" : "")">

					<!-- Streak block: HUGE number, tiny supporting text. Hierarchy through scale. -->
					<div class="today-streak-block">
						<img class="today-flame-big" src="ui/icons/animated/@GetStreakFireIcon()" />
						<div class="today-streak-numwrap">
							<span class="today-streak-num-huge">@GetStreakDayInCycle()</span>
							<div class="today-streak-meta">
								<span class="today-streak-meta-label">DAY STREAK</span>
								<span class="today-streak-meta-sub">@GetTotalDays() total days</span>
							</div>
						</div>
					</div>

					<div class="today-loot-row">
						<div class="today-loot-item float-0">
							<div class="today-loot-icon-wrap gold-wrap">
								<img class="today-loot-icon-img" src="ui/icons/currency/money.svg" />
							</div>
							<span class="today-loot-amount gold-amount">@($"{todayReward.Gold:N0}")</span>
							<span class="today-loot-type">Gold</span>
						</div>
						@if (todayReward.Ink > 0)
						{
							<div class="today-loot-item float-1">
								<div class="today-loot-icon-wrap ink-wrap">
									<img class="today-loot-icon-img" src="ui/icons/currency/ink.svg" />
								</div>
								<span class="today-loot-amount ink-amount">@todayReward.Ink</span>
								<span class="today-loot-type">Ink</span>
							</div>
						}
						@if (todayReward.Gems > 0)
						{
							<div class="today-loot-item float-2">
								<div class="today-loot-icon-wrap gem-wrap">
									<img class="today-loot-icon-img" src="ui/icons/currency/token.svg" />
								</div>
								<span class="today-loot-amount gem-amount">@todayReward.Gems</span>
								<span class="today-loot-type">Gems</span>
							</div>
						}
						@if (todayReward.IsDay7)
						{
							<div class="today-loot-item legendary-loot float-3">
								<div class="today-loot-icon-wrap legendary-wrap">
									<img class="today-loot-icon-img" src="ui/items/consumables/master_ink.png" />
								</div>
								<span class="today-loot-amount legendary-amount">1</span>
								<span class="today-loot-type">Master Ink</span>
							</div>
						}
					</div>

					@if (!IsTodayClaimed())
					{
						<button class="today-claim-btn dp-claim unclaimed @(claimButtonPulse ? "overshoot" : "")" onclick=@ClaimDailyReward onmouseover=@(() => SoundManager.PlayHover())>
							<span class="today-claim-text">CLAIM REWARD</span>
						</button>
					}
					else
					{
						<button class="today-claim-btn dp-claim claimed-btn">
							<span class="today-claim-text">&#10003; Already Claimed Today</span>
						</button>
					}
				</div>

				<!-- ═══ WEEK PROGRESS STRIP ═══ -->
				<div class="week-strip @(streakRevealStage >= 2 ? "entered" : "")">
					<span class="week-strip-label">WEEK PROGRESS</span>
					<div class="week-strip-row">
						@for (int d = 1; d <= 7; d++)
						{
							var day = d;
							var isClaimed = day < GetStreakDayInCycle();
							var isActive = day == GetStreakDayInCycle();
							var isFuture = day > GetStreakDayInCycle();
							var dayReward = GetDayReward(day);
							<div class="week-day @(isClaimed ? "claimed" : "") @(isActive ? "active" : "") @(isFuture ? "future" : "") @(day == 7 ? "legendary" : "")"
								 onmouseover=@(() => { hoveredDay = day; SoundManager.PlayHover(); })>
								<span class="week-day-lbl">DAY @day</span>

								<!-- Gold (always shown) -->
								<div class="week-day-reward gold-reward">
									<img class="week-day-icon" src="ui/icons/currency/money.svg" />
									<span class="week-day-amount">@($"{dayReward.Gold / 1000f:0.#}K")</span>
								</div>

								<!-- Ink (if any) -->
								@if (dayReward.Ink > 0)
								{
									<div class="week-day-reward ink-reward">
										<img class="week-day-icon-small" src="ui/icons/currency/ink.svg" />
										<span class="week-day-amount-small">@dayReward.Ink</span>
									</div>
								}

								<!-- Gems (if any) -->
								@if (dayReward.Gems > 0)
								{
									<div class="week-day-reward gem-reward">
										<img class="week-day-icon-small" src="ui/icons/currency/token.svg" />
										<span class="week-day-amount-small">@dayReward.Gems</span>
									</div>
								}

								<!-- Day 7 Master Ink tag — single banner, not a line item -->
								@if (day == 7)
								{
									<span class="week-day-tag">+MASTER INK</span>
								}

								@if (isClaimed)
								{
									<span class="week-day-check">&#10003;</span>
								}
								else if (isActive)
								{
									<span class="week-day-pip">●</span>
								}
							</div>
						}
					</div>
				</div>

				<!-- ═══ MILESTONE LINE ═══ -->
				@if (nextMs > 0)
				{
					<div class="milestone-line @(streakRevealStage >= 3 ? "entered" : "")">
						<iconify icon="lucide:trophy" Size=@(20) Color="#fbbf24" />
						<span class="milestone-line-label">Next Milestone: Day @nextMs</span>
						<div class="milestone-line-bar">
							<div class="milestone-line-fill" style="width: @GetMilestonePercent()%">
								<span class="milestone-line-fill-spacer">.</span>
							</div>
						</div>
						<span class="milestone-line-text">@GetTotalDays() / @nextMs</span>
						@if (IsMilestoneClaimable(nextMs))
						{
							<button class="dp-claim small unclaimed" onclick=@(() => ClaimMilestone(nextMs)) onmouseover=@(() => SoundManager.PlayHover())>
								<span>CLAIM</span>
							</button>
						}
					</div>
				}
			</div>
		}
		else
		{
			<!-- MISSIONS VIEW -->
			<div class="missions-content">
				<!-- Daily Missions Section — 2 columns -->
				<div class="mission-section @(missionsRevealStage >= 1 ? "entered" : "")">
					<div class="mission-section-header">
						<div class="dm-chip"><span>DAILY MISSIONS</span></div>
						@if (AreAllDailiesComplete())
						{
							<span class="bonus-label">
								<iconify icon="lucide:sparkles" Size=@(12) Color="#4ade80" />
								<span>All Complete: +10K +5 Gems</span>
							</span>
						}
					</div>
					@{
						var _dailies = GetDailyMissions();
					}
					<div class="mission-grid">
						<div class="mission-grid-col">
							@for (int _idx = 0; _idx < _dailies.Count; _idx += 2)
							{
								var mission = _dailies[_idx];
								var _pct = GetMissionPercent(mission);
								var _nearComplete = !mission.Claimed && !mission.Completed && _pct >= 75f;
								var _def = MissionManager.Instance?.GetDefinition(mission.MissionId);
								<div class="mission-card compact stagger-@(_idx) @(mission.Claimed ? "claimed" : "") @(mission.Completed ? "completed" : "") @(_nearComplete ? "near-complete" : "")"
									 onmouseover=@(() => SoundManager.PlayHover())>
									<div class="mission-left">
										<div class="mission-icon-wrap">
											<iconify icon="@GetMissionIconify(mission)" Size=@(22) Color="#c4b5fd" />
										</div>
										<div class="mission-info">
											<span class="mission-name">@GetMissionName(mission)</span>
											<span class="mission-desc">@GetMissionDescription(mission)</span>
											<div class="mission-progress-bar">
												<div class="mission-progress-fill" style="width: @GetMissionPercent(mission)%"></div>
											</div>
										</div>
									</div>
									<div class="mission-right">
										@if (mission.Claimed)
										{
											<span class="mission-claimed">&#10003;</span>
										}
										else if (mission.Completed)
										{
											<button class="dp-claim small unclaimed" onclick=@(() => ClaimMission(mission.MissionId)) onmouseover=@(() => SoundManager.PlayHover())>
												<span>CLAIM</span>
											</button>
										}
										else
										{
											<span class="mission-target">@mission.Progress / @GetMissionTarget(mission)</span>
										}
										<div class="mission-reward-pips">
											@if (_def?.GoldReward > 0)
											{
												<div class="reward-pip gold-pip">
													<img class="reward-pip-icon" src="ui/icons/currency/money.svg" />
													<span class="reward-pip-amount">@($"{_def.GoldReward / 1000f:0.#}K")</span>
												</div>
											}
											@if (_def?.GemReward > 0)
											{
												<div class="reward-pip gem-pip">
													<img class="reward-pip-icon" src="ui/icons/currency/token.svg" />
													<span class="reward-pip-amount">@_def.GemReward</span>
												</div>
											}
											@if (_def?.InkReward > 0)
											{
												<div class="reward-pip ink-pip">
													<img class="reward-pip-icon" src="ui/icons/currency/ink.svg" />
													<span class="reward-pip-amount">@_def.InkReward</span>
												</div>
											}
											@if (_def?.XPReward > 0)
											{
												<div class="reward-pip xp-pip">
													<iconify icon="lucide:arrow-up" Size=@(12) Color="#4ade80" />
													<span class="reward-pip-amount">@($"{_def.XPReward:N0}")</span>
												</div>
											}
										</div>
									</div>
								</div>
							}
						</div>
						<div class="mission-grid-col">
							@for (int _idx = 1; _idx < _dailies.Count; _idx += 2)
							{
								var mission = _dailies[_idx];
								var _pct = GetMissionPercent(mission);
								var _nearComplete = !mission.Claimed && !mission.Completed && _pct >= 75f;
								var _def = MissionManager.Instance?.GetDefinition(mission.MissionId);
								<div class="mission-card compact stagger-@(_idx) @(mission.Claimed ? "claimed" : "") @(mission.Completed ? "completed" : "") @(_nearComplete ? "near-complete" : "")"
									 onmouseover=@(() => SoundManager.PlayHover())>
									<div class="mission-left">
										<div class="mission-icon-wrap">
											<iconify icon="@GetMissionIconify(mission)" Size=@(22) Color="#c4b5fd" />
										</div>
										<div class="mission-info">
											<span class="mission-name">@GetMissionName(mission)</span>
											<span class="mission-desc">@GetMissionDescription(mission)</span>
											<div class="mission-progress-bar">
												<div class="mission-progress-fill" style="width: @GetMissionPercent(mission)%"></div>
											</div>
										</div>
									</div>
									<div class="mission-right">
										@if (mission.Claimed)
										{
											<span class="mission-claimed">&#10003;</span>
										}
										else if (mission.Completed)
										{
											<button class="dp-claim small unclaimed" onclick=@(() => ClaimMission(mission.MissionId)) onmouseover=@(() => SoundManager.PlayHover())>
												<span>CLAIM</span>
											</button>
										}
										else
										{
											<span class="mission-target">@mission.Progress / @GetMissionTarget(mission)</span>
										}
										<div class="mission-reward-pips">
											@if (_def?.GoldReward > 0)
											{
												<div class="reward-pip gold-pip">
													<img class="reward-pip-icon" src="ui/icons/currency/money.svg" />
													<span class="reward-pip-amount">@($"{_def.GoldReward / 1000f:0.#}K")</span>
												</div>
											}
											@if (_def?.GemReward > 0)
											{
												<div class="reward-pip gem-pip">
													<img class="reward-pip-icon" src="ui/icons/currency/token.svg" />
													<span class="reward-pip-amount">@_def.GemReward</span>
												</div>
											}
											@if (_def?.InkReward > 0)
											{
												<div class="reward-pip ink-pip">
													<img class="reward-pip-icon" src="ui/icons/currency/ink.svg" />
													<span class="reward-pip-amount">@_def.InkReward</span>
												</div>
											}
											@if (_def?.XPReward > 0)
											{
												<div class="reward-pip xp-pip">
													<iconify icon="lucide:arrow-up" Size=@(12) Color="#4ade80" />
													<span class="reward-pip-amount">@($"{_def.XPReward:N0}")</span>
												</div>
											}
										</div>
									</div>
								</div>
							}
						</div>
					</div>
				</div>

				<!-- Weekly Missions Section — 2 columns -->
				<div class="mission-section @(missionsRevealStage >= 2 ? "entered" : "")">
					<div class="mission-section-header">
						<div class="dm-chip"><span>WEEKLY MISSIONS</span></div>
						@if (AreAllWeekliesComplete())
						{
							<span class="bonus-label">
								<iconify icon="lucide:sparkles" Size=@(12) Color="#4ade80" />
								<span>All Complete: +50K +10 Gems</span>
							</span>
						}
					</div>
					@{
						var _weeklies = GetWeeklyMissions();
					}
					<div class="mission-grid">
						<div class="mission-grid-col">
							@for (int _widx = 0; _widx < _weeklies.Count; _widx += 2)
							{
								var mission = _weeklies[_widx];
								var _wpct = GetMissionPercent(mission);
								var _wnearComplete = !mission.Claimed && !mission.Completed && _wpct >= 75f;
								var _wdef = MissionManager.Instance?.GetDefinition(mission.MissionId);
								<div class="mission-card compact stagger-@(_widx) @(mission.Claimed ? "claimed" : "") @(mission.Completed ? "completed" : "") @(_wnearComplete ? "near-complete" : "")"
									 onmouseover=@(() => SoundManager.PlayHover())>
									<div class="mission-left">
										<div class="mission-icon-wrap">
											<iconify icon="@GetMissionIconify(mission)" Size=@(22) Color="#fbbf24" />
										</div>
										<div class="mission-info">
											<span class="mission-name">@GetMissionName(mission)</span>
											<span class="mission-desc">@GetMissionDescription(mission)</span>
											<div class="mission-progress-bar">
												<div class="mission-progress-fill" style="width: @GetMissionPercent(mission)%"></div>
											</div>
										</div>
									</div>
									<div class="mission-right">
										@if (mission.Claimed)
										{
											<span class="mission-claimed">&#10003;</span>
										}
										else if (mission.Completed)
										{
											<button class="dp-claim small unclaimed" onclick=@(() => ClaimMission(mission.MissionId)) onmouseover=@(() => SoundManager.PlayHover())>
												<span>CLAIM</span>
											</button>
										}
										else
										{
											<span class="mission-target">@mission.Progress / @GetMissionTarget(mission)</span>
										}
										<div class="mission-reward-pips">
											@if (_wdef?.GoldReward > 0)
											{
												<div class="reward-pip gold-pip">
													<img class="reward-pip-icon" src="ui/icons/currency/money.svg" />
													<span class="reward-pip-amount">@($"{_wdef.GoldReward / 1000f:0.#}K")</span>
												</div>
											}
											@if (_wdef?.GemReward > 0)
											{
												<div class="reward-pip gem-pip">
													<img class="reward-pip-icon" src="ui/icons/currency/token.svg" />
													<span class="reward-pip-amount">@_wdef.GemReward</span>
												</div>
											}
											@if (_wdef?.InkReward > 0)
											{
												<div class="reward-pip ink-pip">
													<img class="reward-pip-icon" src="ui/icons/currency/ink.svg" />
													<span class="reward-pip-amount">@_wdef.InkReward</span>
												</div>
											}
											@if (_wdef?.XPReward > 0)
											{
												<div class="reward-pip xp-pip">
													<iconify icon="lucide:arrow-up" Size=@(12) Color="#4ade80" />
													<span class="reward-pip-amount">@($"{_wdef.XPReward:N0}")</span>
												</div>
											}
										</div>
									</div>
								</div>
							}
						</div>
						<div class="mission-grid-col">
							@for (int _widx = 1; _widx < _weeklies.Count; _widx += 2)
							{
								var mission = _weeklies[_widx];
								var _wpct = GetMissionPercent(mission);
								var _wnearComplete = !mission.Claimed && !mission.Completed && _wpct >= 75f;
								var _wdef = MissionManager.Instance?.GetDefinition(mission.MissionId);
								<div class="mission-card compact stagger-@(_widx) @(mission.Claimed ? "claimed" : "") @(mission.Completed ? "completed" : "") @(_wnearComplete ? "near-complete" : "")"
									 onmouseover=@(() => SoundManager.PlayHover())>
									<div class="mission-left">
										<div class="mission-icon-wrap">
											<iconify icon="@GetMissionIconify(mission)" Size=@(22) Color="#fbbf24" />
										</div>
										<div class="mission-info">
											<span class="mission-name">@GetMissionName(mission)</span>
											<span class="mission-desc">@GetMissionDescription(mission)</span>
											<div class="mission-progress-bar">
												<div class="mission-progress-fill" style="width: @GetMissionPercent(mission)%"></div>
											</div>
										</div>
									</div>
									<div class="mission-right">
										@if (mission.Claimed)
										{
											<span class="mission-claimed">&#10003;</span>
										}
										else if (mission.Completed)
										{
											<button class="dp-claim small unclaimed" onclick=@(() => ClaimMission(mission.MissionId)) onmouseover=@(() => SoundManager.PlayHover())>
												<span>CLAIM</span>
											</button>
										}
										else
										{
											<span class="mission-target">@mission.Progress / @GetMissionTarget(mission)</span>
										}
										<div class="mission-reward-pips">
											@if (_wdef?.GoldReward > 0)
											{
												<div class="reward-pip gold-pip">
													<img class="reward-pip-icon" src="ui/icons/currency/money.svg" />
													<span class="reward-pip-amount">@($"{_wdef.GoldReward / 1000f:0.#}K")</span>
												</div>
											}
											@if (_wdef?.GemReward > 0)
											{
												<div class="reward-pip gem-pip">
													<img class="reward-pip-icon" src="ui/icons/currency/token.svg" />
													<span class="reward-pip-amount">@_wdef.GemReward</span>
												</div>
											}
											@if (_wdef?.InkReward > 0)
											{
												<div class="reward-pip ink-pip">
													<img class="reward-pip-icon" src="ui/icons/currency/ink.svg" />
													<span class="reward-pip-amount">@_wdef.InkReward</span>
												</div>
											}
											@if (_wdef?.XPReward > 0)
											{
												<div class="reward-pip xp-pip">
													<iconify icon="lucide:arrow-up" Size=@(12) Color="#4ade80" />
													<span class="reward-pip-amount">@($"{_wdef.XPReward:N0}")</span>
												</div>
											}
										</div>
									</div>
								</div>
							}
						</div>
					</div>
				</div>

				<!-- Monthly Challenge -->
				@if (GetMonthlyMission() != null)
				{
					<div class="mission-section monthly @(missionsRevealStage >= 3 ? "entered" : "")">
						<div class="mission-section-header">
							<div class="dm-chip gold"><span>MONTHLY CHALLENGE</span></div>
						</div>
						@{
							var monthly = GetMonthlyMission();
							var _mdef = MissionManager.Instance?.GetDefinition(monthly.MissionId);
							var _mpct = GetMissionPercent(monthly);
							var _mnearComplete = !monthly.Claimed && !monthly.Completed && _mpct >= 75f;
						}
						<div class="mission-card monthly-card @(monthly.Claimed ? "claimed" : "") @(monthly.Completed ? "completed" : "") @(_mnearComplete ? "near-complete" : "")"
							 onmouseover=@(() => SoundManager.PlayHover())>
							<div class="mission-left">
								<div class="mission-icon-wrap">
									<iconify icon="@GetMissionIconify(monthly)" Size=@(28) Color="#fbbf24" />
								</div>
								<div class="mission-info">
									<span class="mission-name">@GetMissionName(monthly)</span>
									<span class="mission-desc">@GetMissionDescription(monthly)</span>
									<div class="mission-progress-bar">
										<div class="mission-progress-fill" style="width: @GetMissionPercent(monthly)%"></div>
									</div>
								</div>
							</div>
							<div class="mission-right">
								@if (monthly.Claimed)
								{
									<span class="mission-claimed">&#10003;</span>
								}
								else if (monthly.Completed)
								{
									<button class="dp-claim small unclaimed" onclick=@(() => ClaimMission(monthly.MissionId)) onmouseover=@(() => SoundManager.PlayHover())>
										<span>CLAIM</span>
									</button>
								}
								else
								{
									<span class="mission-target">@monthly.Progress / @GetMissionTarget(monthly)</span>
								}
								<div class="mission-reward-pips">
									@if (_mdef?.GoldReward > 0)
									{
										<div class="reward-pip gold-pip">
											<img class="reward-pip-icon" src="ui/icons/currency/money.svg" />
											<span class="reward-pip-amount">@($"{_mdef.GoldReward / 1000f:0.#}K")</span>
										</div>
									}
									@if (_mdef?.GemReward > 0)
									{
										<div class="reward-pip gem-pip">
											<img class="reward-pip-icon" src="ui/icons/currency/token.svg" />
											<span class="reward-pip-amount">@_mdef.GemReward</span>
										</div>
									}
								</div>
							</div>
						</div>
					</div>
				}
			</div>
		}
	</div>

	@if (claimBurstActive)
	{
		<div class="claim-particle-layer burst-@claimBurstVersion @(claimBurstIsMilestone ? "milestone" : "")">
			@for (int i = 0; i < 12; i++)
			{
				<div class="claim-burst-particle p@(i)"></div>
			}
			<div class="claim-reward-flyer fly-gold"></div>
			@if (claimBurstHasInk)
			{
				<div class="claim-reward-flyer fly-ink"></div>
			}
			@if (claimBurstHasToken)
			{
				<div class="claim-reward-flyer fly-token"></div>
			}
		</div>
	}

	<!-- ═══════════════════════════════════════════════════════════════
	     DAY-7 SETPIECE (Tier 4) — fullscreen cinematic for the week's
	     final claim. Driven by day7Stage: 0 idle, 1 anticipation (dim +
	     iris), 2 reveal (light pillar + Master Ink slam), 3 celebration
	     (name slam + radial gold rays + confetti), 4 settle. The whole
	     layer is gated on day7SetpieceActive (mounts only during the
	     sequence) and all motion is CSS @keyframes — fine here because the
	     layer remounts fresh every Day-7 claim, so first-mount play is the
	     only play we need.
	     ═══════════════════════════════════════════════════════════════ -->
	@if (day7SetpieceActive)
	{
		<div class="day7-setpiece stage-@day7Stage">
			<!-- Persistent layers (scrim / spotlight / pillar / prize) DON'T
			     carry a per-phase class — their enter/hold/exit ride the
			     parent .stage-N class via CSS TRANSITIONS (which re-fire on
			     class toggle; a @keyframe on a still-mounted element does
			     NOT replay). Only mount-and-unmount layers keep @keyframes. -->
			<div class="day7-scrim"></div>

			<!-- Spotlight / pillar / prize mount with the layer (stage 0) in
			     their hidden base state so the stage-2 ENTER transition fires
			     on a real class change (mount-into-state won't transition). -->
			<div class="day7-spotlight"></div>
			<div class="day7-pillar"></div>

			<!-- Anticipation iris ring — mounts ONLY for stage 1 so its
			     contract @keyframe fires fresh on mount. -->
			@if (day7Stage == 1)
			{
				<div class="day7-iris"></div>
			}

			<!-- Radial god-rays — mount ONLY at celebration (stage 3) so the
			     fade-in @keyframe fires fresh; unmount at settle. -->
			@if (day7Stage == 3)
			{
				<div class="day7-rays">
					@for (int r = 0; r < 12; r++)
					{
						<div class="day7-ray ray-@r"></div>
					}
				</div>
			}

			<!-- The hero prize: Master Ink slams in at reveal (stage-2 enter
			     transition), idle-bobs through celebration, lifts out on
			     settle (stage-4 exit transition). Mounts with the layer in
			     hidden base state so its stage-2 enter transition fires. -->
			<div class="day7-prize-wrap">
				<div class="day7-prize-glow"></div>
				<img class="day7-prize-img" src="ui/items/consumables/master_ink.png" />
			</div>

			<!-- Name slam + streak banner — mounts ONLY at celebration. -->
			@if (day7Stage == 3)
			{
				<div class="day7-banner">
					<span class="day7-eyebrow">7-DAY STREAK COMPLETE</span>
					<span class="day7-prize-name">MASTER INK</span>
					<span class="day7-subline">+ @($"{GetTodayReward().Gold:N0}") Gold@(GetTodayReward().Gems > 0 ? $"  ·  {GetTodayReward().Gems} Gems" : "")</span>
				</div>

				<!-- Confetti / ember burst -->
				<div class="day7-confetti">
					@for (int c = 0; c < 18; c++)
					{
						<div class="day7-conf c@(c)"></div>
					}
				</div>
			}
		</div>
	}
</root>

@code {
	// Localization helper
	private string L( string key ) => LocalizationManager.Get( key );
	private string L( string key, params object[] args ) => LocalizationManager.Get( key, args );

	public static bool IsVisible { get; set; } = false;
	private string activeTab = "streak";
	private int hoveredDay = 0;

	private static int popVersion = 0;
	private string lastTab = "streak";

	// Staircase reveal state — modeled on MainMenu's entranceStage pattern.
	// Each stage corresponds to a group of elements that become visible.
	// Stage 0 = nothing yet, Stage N = elements with `entered-N` (or `entered`
	// when `>= N`) class are now visible. Driven by PlayRevealSequence().
	//   Streak tab: 0 hidden, 1 streak-counter, 2-8 day-1..7, 9 reward+milestone
	//   Missions tab: 0 hidden, 1 daily section, 2 weekly section, 3 monthly
	private int streakRevealStage = 0;
	private int missionsRevealStage = 0;

	// Claim sequence state
	private bool claimButtonPulse = false;
	private bool claimBurstActive = false;
	private int claimBurstVersion = 0;
	private bool claimBurstIsMilestone = false;
	private bool claimBurstHasInk = false;
	private bool claimBurstHasToken = false;

	// Day-7 Tier-4 setpiece state. day7Stage drives the CSS phase classes:
	//   0 idle · 1 anticipation (dim + iris contract) · 2 reveal (pillar +
	//   prize slam) · 3 celebration (name slam + rays + confetti) · 4 settle.
	private bool day7SetpieceActive = false;
	private int day7Stage = 0;

	private static DailyPanel _instance;

	public DailyPanel()
	{
		_instance = this;
	}

	public static void Show()
	{
		IsVisible = true;
		popVersion++;
		SoundManager.PlayPopup();
		_instance?.StartRevealForActiveTab();
	}
	public static void Close() { IsVisible = false; SoundManager.PlayPopdown(); }
	public static void Toggle()
	{
		IsVisible = !IsVisible;
		if ( IsVisible )
		{
			popVersion++;
			SoundManager.PlayPopup();
			_instance?.StartRevealForActiveTab();
		}
		else SoundManager.PlayPopdown();
	}

	private void StartRevealForActiveTab()
	{
		if ( activeTab == "streak" ) _ = PlayStreakRevealSequence();
		else _ = PlayMissionsRevealSequence();
	}

	// Top-down sequential reveal — hero card slides in first, then week strip,
	// then milestone line. Each section comes from above with a clean ease-out
	// AND a sound cue, so the staircase has audio weight (Persona-style "tick").
	//   0 = nothing visible
	//   1 = hero card slides in from above
	//   2 = week strip slides in from above
	//   3 = milestone line slides in from above
	private async Task PlayStreakRevealSequence()
	{
		// 26.06.03: the visual stagger now lives in CSS via real
		// `transition-delay` on .today-hero / .week-strip / .milestone-line
		// (see the .streak-content.entered rules). One render flip arms all
		// three; CSS cascades them top → bottom. We keep the per-section
		// swoosh cues here, timed to land on each section's CSS delay, so
		// the staircase still has audio weight (sound is UI).
		streakRevealStage = 0;
		await GameTask.DelaySeconds( 0.04f );
		streakRevealStage = 3; // arm all three sections at once; CSS delays them
		SoundManager.PlaySwoosh();
		await GameTask.DelaySeconds( 0.13f );
		SoundManager.PlaySwoosh();
		await GameTask.DelaySeconds( 0.13f );
		SoundManager.PlaySwoosh();
	}

	private async Task PlayMissionsRevealSequence()
	{
		missionsRevealStage = 0;
		await GameTask.DelaySeconds( 0.12f );
		missionsRevealStage = 1;
		SoundManager.PlaySwoosh();
		await GameTask.DelaySeconds( 0.12f );
		missionsRevealStage = 2;
		SoundManager.PlaySwoosh();
		await GameTask.DelaySeconds( 0.12f );
		missionsRevealStage = 3;
		SoundManager.PlaySwoosh();
	}

	private string GetStreakFireIcon()
	{
		var total = GetTotalDays();
		if ( total >= 100 ) return "streak-fire-5.webp";
		if ( total >= 30 ) return "streak-fire-4.webp";
		if ( total >= 14 ) return "streak-fire-3.webp";
		if ( total >= 7 ) return "streak-fire-2.webp";
		return "streak-fire-1.webp";
	}

	private string GetDayIconPath( int day )
	{
		if ( day == 7 ) return "sort/trophy.svg";
		if ( day >= 5 ) return "currency/token.svg";
		return "currency/money.svg";
	}

	private float GetStreakPercent()
	{
		var dayInCycle = GetStreakDayInCycle();
		return Math.Min( 100f, (float)(dayInCycle - 1) / 6f * 100f );
	}

	// ═══════════════════════════════════════════════════════════════
	// STREAK HELPERS (delegate to DailyRewardManager)
	// ═══════════════════════════════════════════════════════════════

	private int GetStreakDay() => DailyRewardManager.Instance?.DailyStreak ?? 0;
	private int GetStreakDayInCycle() => DailyRewardManager.Instance?.GetStreakDay() ?? 1;
	private int GetTotalDays() => DailyRewardManager.Instance?.TotalLoginDays ?? 0;
	private bool IsShieldReady() => DailyRewardManager.Instance?.IsShieldActive() ?? false;
	private bool IsTodayClaimed() => DailyRewardManager.Instance?.TodayRewardClaimed ?? false;
	private float GetWeekMultiplier() => DailyRewardManager.Instance?.GetWeekMultiplier() ?? 1.0f;

	private (int Gold, int Gems, int Ink, bool IsDay7) GetTodayReward()
	{
		if ( DailyRewardManager.Instance == null ) return (2000, 0, 5, false);

		var (gold, gems, ink) = DailyRewardManager.Instance.GetTodayReward();
		var day = GetStreakDayInCycle();
		return (gold, gems, ink, day == 7);
	}

	private (int Gold, int Gems, int Ink) GetDayReward( int day )
	{
		return DailyRewardManager.Instance?.GetDayReward( day ) ?? (2000, 0, 5);
	}

	private async void ClaimDailyReward()
	{
		// Guard against double-clicks mid-sequence
		if ( claimBurstActive || day7SetpieceActive ) return;
		if ( IsTodayClaimed() ) return;

		// Day 7 is the week's payoff — escalate to the Tier-4 cinematic
		// instead of the routine Tier-2 burst. Keeps routine claims tight
		// (per feel-principles "restraint makes impact possible") so this
		// moment reads as clearly bigger.
		if ( GetTodayReward().IsDay7 )
		{
			_ = PlayDay7Setpiece();
			return;
		}

		// t=0: layered sound + click + button overshoot + particle burst
		SoundManager.PlayClick();
		SoundManager.PlaySuccess();
		SoundManager.PlayGoldReward();

		claimButtonPulse = true;

		// Spawn burst layer. Determine which flyer icons to show from today's reward.
		var todayReward = GetTodayReward();
		claimBurstHasInk = todayReward.Ink > 0;
		claimBurstHasToken = todayReward.Gems > 0; // Gems slot maps to token icon in reward box
		claimBurstIsMilestone = todayReward.IsDay7;
		claimBurstVersion++;
		claimBurstActive = true;

		// Clear button overshoot class after ~80ms so it can retrigger next claim
		_ = ClearButtonPulseAsync();

		// Defer the actual manager call so GameHUD roll-up fires WHEN the flyer "lands"
		// on the currency pill (~450ms flight time in CSS).
		await GameTask.DelaySeconds( 0.45f );
		DailyRewardManager.Instance?.ClaimDailyReward();

		// Let the particle layer linger briefly after the flyer lands, then dismount
		await GameTask.DelaySeconds( 0.5f );
		claimBurstActive = false;
	}

	private async Task ClearButtonPulseAsync()
	{
		await GameTask.DelaySeconds( 0.1f );
		claimButtonPulse = false;
	}

	// ═══════════════════════════════════════════════════════════════
	// DAY-7 SETPIECE (Tier 4) — anticipation → reveal → celebration
	// ═══════════════════════════════════════════════════════════════
	//
	// Hades-shaped boon reveal (NOT a gacha pull — the prize is known, so
	// the beats celebrate an EARNED outcome rather than concealing an RNG
	// roll). ~3.4s total: a held-beat dim + iris contract builds tension,
	// then a light pillar carries Master Ink up with a name slam, then a
	// god-ray + confetti celebration, then a settle that hands control back.
	//
	// Persistent layers (scrim/spotlight/pillar/prize) animate via CSS
	// TRANSITIONS keyed on the .stage-N parent class — those only fire on a
	// class CHANGE after mount, so we mount the layer at stage 0 (all base/
	// hidden) for one frame, THEN advance to stage 1+. That stage-0 priming
	// frame is what makes the scrim dim-in and every later enter/exit actually
	// transition instead of popping. Mount-and-unmount layers (iris @1, rays/
	// banner/confetti @3) use @keyframes — those fire fresh on their mount.
	private async Task PlayDay7Setpiece()
	{
		day7SetpieceActive = true;
		day7Stage = 0;

		// Stage-0 priming frame — layer mounts hidden so the stage-1 flip
		// drives the scrim's dim-in transition (mount-into-state won't fade).
		await GameTask.DelaySeconds( 0.05f );

		// Stage 1 — ANTICIPATION. Dim the room, a tense low cue, the click.
		SoundManager.PlayClick();
		day7Stage = 1;
		await GameTask.DelaySeconds( 0.7f );

		// Stage 2 — REVEAL. The prize slams up the light pillar. Big hit.
		SoundManager.PlaySuccess();
		SoundManager.PlayGoldReward();
		day7Stage = 2;
		await GameTask.DelaySeconds( 0.55f );

		// Stage 3 — CELEBRATION. Name slam, god-rays, confetti. Second
		// layered success so the audio swells rather than repeating flat.
		SoundManager.PlaySuccess();
		day7Stage = 3;

		// Commit the actual reward mid-celebration so the GameHUD currency
		// roll-up fires while the rays are still blazing (cause↔effect).
		await GameTask.DelaySeconds( 0.45f );
		DailyRewardManager.Instance?.ClaimDailyReward();

		// Hold the celebration so the player can feel it (Tier-4 rule:
		// "stop, watch, feel it, remember it").
		await GameTask.DelaySeconds( 1.0f );

		// Stage 4 — SETTLE. Everything eases out, scrim lifts.
		SoundManager.PlaySwoosh();
		day7Stage = 4;
		await GameTask.DelaySeconds( 0.55f );

		day7SetpieceActive = false;
		day7Stage = 0;
	}

	private int GetNextMilestone()
	{
		return DailyRewardManager.Instance?.GetNextMilestone() ?? 7;
	}

	private bool IsMilestoneClaimable( int milestone )
	{
		return DailyRewardManager.Instance?.IsMilestoneClaimable( milestone ) ?? false;
	}

	private void ClaimMilestone( int milestone )
	{
		SoundManager.PlaySuccess();
		DailyRewardManager.Instance?.ClaimMilestone( milestone );
	}

	private float GetMilestonePercent()
	{
		var total = GetTotalDays();
		var next = GetNextMilestone();
		if ( next <= 0 ) return 100;
		return Math.Min( 100, (float)total / next * 100f );
	}

	private string GetRefreshTime()
	{
		var now = DateTime.UtcNow;
		var midnight = now.Date.AddDays( 1 );
		var diff = midnight - now;
		return $"{diff.Hours}h {diff.Minutes}m";
	}

	// ═══════════════════════════════════════════════════════════════
	// MISSION HELPERS (delegate to MissionManager)
	// ═══════════════════════════════════════════════════════════════

	private List<MissionState> GetDailyMissions() => MissionManager.Instance?.ActiveDailyMissions ?? new();
	private List<MissionState> GetWeeklyMissions() => MissionManager.Instance?.ActiveWeeklyMissions ?? new();
	private MissionState GetMonthlyMission() => MissionManager.Instance?.ActiveMonthlyChallenge;
	private bool AreAllDailiesComplete() => MissionManager.Instance?.AreAllDailiesComplete() ?? false;
	private bool AreAllWeekliesComplete() => MissionManager.Instance?.AreAllWeekliesComplete() ?? false;

	private string GetMissionName( MissionState state )
	{
		var def = MissionManager.Instance?.GetDefinition( state.MissionId );
		return def?.Name ?? state.MissionId;
	}

	private string GetMissionDescription( MissionState state )
	{
		var def = MissionManager.Instance?.GetDefinition( state.MissionId );
		return def?.Description ?? "";
	}

	private string GetMissionIcon( MissionState state )
	{
		var def = MissionManager.Instance?.GetDefinition( state.MissionId );
		return def?.Icon ?? "ui/icons/sort/star.svg";
	}

	// Map mission category to a lucide iconify icon. Used in the mission card
	// header instead of the legacy SVG icons. Categories: Battle, Expedition,
	// Collection, Economy, Social.
	private string GetMissionIconify( MissionState state )
	{
		var def = MissionManager.Instance?.GetDefinition( state.MissionId );
		if ( def == null ) return "lucide:star";
		return def.Category switch
		{
			MissionCategory.Battle     => "lucide:swords",
			MissionCategory.Expedition => "lucide:compass",
			MissionCategory.Collection => "lucide:package",
			MissionCategory.Economy    => "lucide:coins",
			MissionCategory.Social     => "lucide:users",
			_ => "lucide:star"
		};
	}

	private int GetMissionTarget( MissionState state )
	{
		var def = MissionManager.Instance?.GetDefinition( state.MissionId );
		return def?.Target ?? 1;
	}

	private float GetMissionPercent( MissionState state )
	{
		var target = GetMissionTarget( state );
		if ( target <= 0 ) return 100;
		return Math.Min( 100, (float)state.Progress / target * 100f );
	}

	private string GetMissionRewardText( MissionState state )
	{
		var def = MissionManager.Instance?.GetDefinition( state.MissionId );
		if ( def == null ) return "";
		var parts = new List<string>();
		if ( def.GoldReward > 0 ) parts.Add( $"{def.GoldReward / 1000f:0.#}K" );
		if ( def.GemReward > 0 ) parts.Add( $"{def.GemReward} Gems" );
		if ( def.XPReward > 0 ) parts.Add( $"{def.XPReward} XP" );
		return string.Join( " + ", parts );
	}

	private void ClaimMission( string missionId )
	{
		SoundManager.PlaySuccess();
		MissionManager.Instance?.ClaimReward( missionId );
	}

	/// <summary>
	/// Returns total unclaimed rewards across daily + missions for badge display.
	/// </summary>
	public static int GetTotalUnclaimedCount()
	{
		int count = 0;
		count += DailyRewardManager.Instance?.GetUnclaimedCount() ?? 0;
		count += MissionManager.Instance?.GetUnclaimedCount() ?? 0;
		return count;
	}

	public override void Tick()
	{
		base.Tick();

		// Escape (s&box-reserved) AND the canonical Menu/run "back" keys close.
		if ( IsVisible && UIModalState.IsTopModal( "DailyPanel" )
			&& ( Input.Pressed( "Escape" ) || Input.Pressed( "Menu" ) || Input.Pressed( "run" ) ) )
		{
			Close();
		}

		// Retrigger stagger reveal whenever the active tab changes
		if ( activeTab != lastTab )
		{
			lastTab = activeTab;
			StartRevealForActiveTab();
		}
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add( IsVisible );
		hash.Add( activeTab );
		hash.Add( GetStreakDay() );
		hash.Add( GetTotalDays() );
		hash.Add( IsTodayClaimed() );
		hash.Add( MissionManager.Instance?.GetUnclaimedCount() ?? 0 );
		hash.Add( popVersion );
		hash.Add( streakRevealStage );
		hash.Add( missionsRevealStage );
		hash.Add( claimButtonPulse );
		hash.Add( claimBurstActive );
		hash.Add( claimBurstVersion );
		hash.Add( day7SetpieceActive );
		hash.Add( day7Stage );
		hash.Add( hoveredDay );
		return hash.ToHashCode();
	}
}
