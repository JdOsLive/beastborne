@namespace Beastborne.UI.Panels
@using Sandbox;
@using Sandbox.UI;
@using Beastborne.Core;
@using Beastborne.Data;
@using Beastborne.Systems;
@inherits Panel

<root class="daily-panel-root @(IsVisible ? "visible" : "")">
	<div class="daily-overlay" onclick=@Close></div>

	<div class="daily-modal pop-@popVersion reveal-@popVersion">
		<div class="bg-scroll"><img src="ui/bg-patterns/bg-missions.svg" /></div>
		<div class="daily-header">
			<div class="header-left">
				<img class="panel-title-icon" src="ui/icons/sort/star.svg" />
				<span class="daily-title">@L("ui.daily.title")</span>
			</div>
			<div class="header-filters">
				<div class="sort-btn @(activeTab == "streak" ? "active" : "")"
					 onclick=@(() => { SoundManager.PlayClick(); activeTab = "streak"; })
					 onmouseover=@(() => SoundManager.PlayHover())>
					<img class="pill-icon" src="ui/icons/sort/streak.svg" />
					<span class="pill-label">@L("ui.daily.login_streak")</span>
				</div>
				<div class="sort-btn @(activeTab == "missions" ? "active" : "")"
					 onclick=@(() => { SoundManager.PlayClick(); activeTab = "missions"; })
					 onmouseover=@(() => SoundManager.PlayHover())>
					<img class="pill-icon" src="ui/icons/sort/missions-icon.svg" />
					<span class="pill-label">@L("ui.daily.missions")</span>
				</div>
			</div>
			<div class="header-right">
				<div class="refresh-timer">
					<span class="timer-label">@L("ui.daily.refresh_in")</span>
					<span class="timer-value">@GetRefreshTime()</span>
				</div>
				<button class="close-btn" onclick=@Close>
					<img class="close-icon" src="ui/icons/buttons/close.svg" />
				</button>
			</div>
		</div>

		@if (activeTab == "streak")
		{
			<!-- LOGIN STREAK VIEW — Today-First layout: hero + week strip + milestone -->
			<div class="streak-content">
				@{
					var todayReward = GetTodayReward();
					var nextMs = GetNextMilestone();
				}

				<!-- ═══ TODAY'S REWARD HERO ═══ -->
				<div class="today-hero @(streakRevealStage >= 1 ? "entered" : "")">
					<!-- Decorative corner ornaments — pure flourish, no info -->
					<div class="hero-corner-ornament tl"><iconify icon="lucide:sparkles" Size=@(14) Color="#c4b5fd" /></div>
					<div class="hero-corner-ornament tr"><iconify icon="lucide:sparkles" Size=@(14) Color="#c4b5fd" /></div>
					<div class="hero-corner-ornament bl"><iconify icon="lucide:sparkles" Size=@(14) Color="#c4b5fd" /></div>
					<div class="hero-corner-ornament br"><iconify icon="lucide:sparkles" Size=@(14) Color="#c4b5fd" /></div>

					<!-- 12 drifting ambient sparkles — float upward inside the hero card -->
					<div class="hero-sparkle s1"></div>
					<div class="hero-sparkle s2"></div>
					<div class="hero-sparkle s3"></div>
					<div class="hero-sparkle s4"></div>
					<div class="hero-sparkle s5"></div>
					<div class="hero-sparkle s6"></div>
					<div class="hero-sparkle s7"></div>
					<div class="hero-sparkle s8"></div>
					<div class="hero-sparkle s9"></div>
					<div class="hero-sparkle s10"></div>
					<div class="hero-sparkle s11"></div>
					<div class="hero-sparkle s12"></div>

					<div class="today-streak-line">
						<img class="today-flame" src="ui/icons/animated/@GetStreakFireIcon()" />
						<span class="today-streak-num">@GetStreakDayInCycle()</span>
						<span class="today-streak-text">DAY STREAK</span>
						<span class="today-streak-divider">·</span>
						<span class="today-streak-total">@GetTotalDays() total days</span>
					</div>

					<div class="today-reward-title">
						<iconify icon="lucide:star" Size=@(12) Color="#fbbf24" />
						<span>TODAY'S REWARD · DAY @GetStreakDayInCycle() OF 7</span>
						<iconify icon="lucide:star" Size=@(12) Color="#fbbf24" />
					</div>

					<div class="today-loot-row">
						<div class="today-loot-item float-0">
							<div class="today-loot-icon-wrap gold-wrap">
								<img class="today-loot-icon-img" src="ui/icons/currency/money.svg" />
							</div>
							<span class="today-loot-amount gold-amount">@($"{todayReward.Gold:N0}")</span>
							<span class="today-loot-type">Gold</span>
						</div>
						@if (todayReward.Ink > 0)
						{
							<div class="today-loot-item float-1">
								<div class="today-loot-icon-wrap ink-wrap">
									<img class="today-loot-icon-img" src="ui/icons/currency/ink.svg" />
								</div>
								<span class="today-loot-amount ink-amount">@todayReward.Ink</span>
								<span class="today-loot-type">Ink</span>
							</div>
						}
						@if (todayReward.Gems > 0)
						{
							<div class="today-loot-item float-2">
								<div class="today-loot-icon-wrap gem-wrap">
									<img class="today-loot-icon-img" src="ui/icons/currency/token.svg" />
								</div>
								<span class="today-loot-amount gem-amount">@todayReward.Gems</span>
								<span class="today-loot-type">Gems</span>
							</div>
						}
						@if (todayReward.IsDay7)
						{
							<div class="today-loot-item legendary-loot float-3">
								<div class="today-loot-icon-wrap legendary-wrap">
									<img class="today-loot-icon-img" src="ui/icons/sort/trophy.svg" />
								</div>
								<span class="today-loot-amount legendary-amount">1</span>
								<span class="today-loot-type">Legendary</span>
							</div>
						}
					</div>

					@if (!IsTodayClaimed())
					{
						<button class="today-claim-btn claim-btn unclaimed @(claimButtonPulse ? "overshoot" : "")" onclick=@ClaimDailyReward onmouseover=@(() => SoundManager.PlayHover())>
							<span class="today-claim-text">CLAIM REWARD</span>
						</button>
					}
					else
					{
						<button class="today-claim-btn claim-btn claimed-btn">
							<span class="today-claim-text">&#10003; Already Claimed Today</span>
						</button>
					}
				</div>

				<!-- ═══ WEEK PROGRESS STRIP ═══ -->
				<div class="week-strip @(streakRevealStage >= 2 ? "entered" : "")">
					<span class="week-strip-label">WEEK PROGRESS</span>
					<div class="week-strip-row">
						@for (int d = 1; d <= 7; d++)
						{
							var day = d;
							var isClaimed = day < GetStreakDayInCycle();
							var isActive = day == GetStreakDayInCycle();
							var isFuture = day > GetStreakDayInCycle();
							var dayReward = GetDayReward(day);
							<div class="week-day @(isClaimed ? "claimed" : "") @(isActive ? "active" : "") @(isFuture ? "future" : "") @(day == 7 ? "legendary" : "")"
								 onmouseover=@(() => { hoveredDay = day; SoundManager.PlayHover(); })>
								<span class="week-day-lbl">DAY @day</span>
								@if (day == 7)
								{
									<img class="week-day-icon legendary-icon" src="ui/icons/sort/trophy.svg" />
									<span class="week-day-tag">LEGEND</span>
								}
								else
								{
									<img class="week-day-icon" src="ui/icons/currency/money.svg" />
									<span class="week-day-amount">@($"{dayReward.Gold / 1000f:0.#}K")</span>
								}
								@if (isClaimed)
								{
									<span class="week-day-check">&#10003;</span>
								}
								else if (isActive)
								{
									<span class="week-day-pip">●</span>
								}
							</div>
						}
					</div>
				</div>

				<!-- ═══ MILESTONE LINE ═══ -->
				@if (nextMs > 0)
				{
					<div class="milestone-line @(streakRevealStage >= 3 ? "entered" : "")">
						<iconify icon="lucide:trophy" Size=@(20) Color="#fbbf24" />
						<span class="milestone-line-label">Next Milestone: Day @nextMs</span>
						<div class="milestone-line-bar">
							<div class="milestone-line-fill" style="width: @GetMilestonePercent()%">
								<span class="milestone-line-fill-spacer">.</span>
							</div>
						</div>
						<span class="milestone-line-text">@GetTotalDays() / @nextMs</span>
						@if (IsMilestoneClaimable(nextMs))
						{
							<button class="claim-btn small unclaimed" onclick=@(() => ClaimMilestone(nextMs)) onmouseover=@(() => SoundManager.PlayHover())>
								<span>CLAIM</span>
							</button>
						}
					</div>
				}
			</div>
		}
		else
		{
			<!-- MISSIONS VIEW -->
			<div class="missions-content">
				<!-- Daily Missions Section -->
				<div class="mission-section @(missionsRevealStage >= 1 ? "entered" : "")">
					<div class="mission-section-header">
						<span class="section-title">Daily Missions</span>
						@if (AreAllDailiesComplete())
						{
							<span class="bonus-label">All Complete: +10K +5 Gems</span>
						}
					</div>
					@{
						var _dailies = GetDailyMissions();
					}
					@for (int _idx = 0; _idx < _dailies.Count; _idx++)
					{
						var mission = _dailies[_idx];
						var _pct = GetMissionPercent(mission);
						var _nearComplete = !mission.Claimed && !mission.Completed && _pct >= 75f;
						<div class="mission-card stagger-@(_idx) @(mission.Claimed ? "claimed" : "") @(mission.Completed ? "completed" : "") @(_nearComplete ? "near-complete" : "")">
							<div class="mission-left">
								<img class="mission-icon" src="@GetMissionIcon(mission)" />
								<div class="mission-info">
									<span class="mission-name">@GetMissionName(mission)</span>
									<span class="mission-desc">@GetMissionDescription(mission)</span>
									<div class="mission-progress-bar">
										<div class="mission-progress-fill" style="width: @GetMissionPercent(mission)%"></div>
									</div>
								</div>
							</div>
							<div class="mission-right">
								@if (mission.Claimed)
								{
									<span class="mission-claimed">&#10003;</span>
								}
								else if (mission.Completed)
								{
									<button class="claim-btn small unclaimed" onclick=@(() => ClaimMission(mission.MissionId)) onmouseover=@(() => SoundManager.PlayHover())>
										<span>CLAIM</span>
									</button>
								}
								else
								{
									<span class="mission-target">@mission.Progress / @GetMissionTarget(mission)</span>
								}
								<span class="mission-reward">@GetMissionRewardText(mission)</span>
							</div>
						</div>
					}
				</div>

				<!-- Weekly Missions Section -->
				<div class="mission-section @(missionsRevealStage >= 2 ? "entered" : "")">
					<div class="mission-section-header">
						<span class="section-title">Weekly Missions</span>
						@if (AreAllWeekliesComplete())
						{
							<span class="bonus-label">All Complete: +50K +10 Gems</span>
						}
					</div>
					@{
						var _weeklies = GetWeeklyMissions();
					}
					@for (int _widx = 0; _widx < _weeklies.Count; _widx++)
					{
						var mission = _weeklies[_widx];
						var _wpct = GetMissionPercent(mission);
						var _wnearComplete = !mission.Claimed && !mission.Completed && _wpct >= 75f;
						<div class="mission-card stagger-@(_widx) @(mission.Claimed ? "claimed" : "") @(mission.Completed ? "completed" : "") @(_wnearComplete ? "near-complete" : "")">
							<div class="mission-left">
								<img class="mission-icon" src="@GetMissionIcon(mission)" />
								<div class="mission-info">
									<span class="mission-name">@GetMissionName(mission)</span>
									<span class="mission-desc">@GetMissionDescription(mission)</span>
									<div class="mission-progress-bar">
										<div class="mission-progress-fill" style="width: @GetMissionPercent(mission)%"></div>
									</div>
								</div>
							</div>
							<div class="mission-right">
								@if (mission.Claimed)
								{
									<span class="mission-claimed">&#10003;</span>
								}
								else if (mission.Completed)
								{
									<button class="claim-btn small unclaimed" onclick=@(() => ClaimMission(mission.MissionId)) onmouseover=@(() => SoundManager.PlayHover())>
										<span>CLAIM</span>
									</button>
								}
								else
								{
									<span class="mission-target">@mission.Progress / @GetMissionTarget(mission)</span>
								}
								<span class="mission-reward">@GetMissionRewardText(mission)</span>
							</div>
						</div>
					}
				</div>

				<!-- Monthly Challenge -->
				@if (GetMonthlyMission() != null)
				{
					<div class="mission-section monthly @(missionsRevealStage >= 3 ? "entered" : "")">
						<div class="mission-section-header">
							<span class="section-title">Monthly Challenge</span>
						</div>
						@{
							var monthly = GetMonthlyMission();
						}
						@{
							var _mpct = GetMissionPercent(monthly);
							var _mnearComplete = !monthly.Claimed && !monthly.Completed && _mpct >= 75f;
						}
						<div class="mission-card monthly-card @(monthly.Claimed ? "claimed" : "") @(monthly.Completed ? "completed" : "") @(_mnearComplete ? "near-complete" : "")">
							<div class="mission-left">
								<img class="mission-icon" src="@GetMissionIcon(monthly)" />
								<div class="mission-info">
									<span class="mission-name">@GetMissionName(monthly)</span>
									<div class="mission-progress-bar">
										<div class="mission-progress-fill" style="width: @GetMissionPercent(monthly)%"></div>
									</div>
								</div>
							</div>
							<div class="mission-right">
								@if (monthly.Claimed)
								{
									<span class="mission-claimed">&#10003;</span>
								}
								else if (monthly.Completed)
								{
									<button class="claim-btn small" onclick=@(() => ClaimMission(monthly.MissionId)) onmouseover=@(() => SoundManager.PlayHover())>
										<span>CLAIM</span>
									</button>
								}
								else
								{
									<span class="mission-target">@monthly.Progress / @GetMissionTarget(monthly)</span>
								}
								<span class="mission-reward">@GetMissionRewardText(monthly)</span>
							</div>
						</div>
					</div>
				}
			</div>
		}
	</div>

	@if (claimBurstActive)
	{
		<div class="claim-particle-layer burst-@claimBurstVersion @(claimBurstIsMilestone ? "milestone" : "")">
			@for (int i = 0; i < 12; i++)
			{
				<div class="claim-burst-particle p@(i)"></div>
			}
			<div class="claim-reward-flyer fly-gold"></div>
			@if (claimBurstHasInk)
			{
				<div class="claim-reward-flyer fly-ink"></div>
			}
			@if (claimBurstHasToken)
			{
				<div class="claim-reward-flyer fly-token"></div>
			}
		</div>
	}
</root>

@code {
	// Localization helper
	private string L( string key ) => LocalizationManager.Get( key );
	private string L( string key, params object[] args ) => LocalizationManager.Get( key, args );

	public static bool IsVisible { get; set; } = false;
	private string activeTab = "streak";
	private int hoveredDay = 0;

	private static int popVersion = 0;
	private string lastTab = "streak";

	// Staircase reveal state — modeled on MainMenu's entranceStage pattern.
	// Each stage corresponds to a group of elements that become visible.
	// Stage 0 = nothing yet, Stage N = elements with `entered-N` (or `entered`
	// when `>= N`) class are now visible. Driven by PlayRevealSequence().
	//   Streak tab: 0 hidden, 1 streak-counter, 2-8 day-1..7, 9 reward+milestone
	//   Missions tab: 0 hidden, 1 daily section, 2 weekly section, 3 monthly
	private int streakRevealStage = 0;
	private int missionsRevealStage = 0;

	// Claim sequence state
	private bool claimButtonPulse = false;
	private bool claimBurstActive = false;
	private int claimBurstVersion = 0;
	private bool claimBurstIsMilestone = false;
	private bool claimBurstHasInk = false;
	private bool claimBurstHasToken = false;

	private static DailyPanel _instance;

	public DailyPanel()
	{
		_instance = this;
	}

	public static void Show()
	{
		IsVisible = true;
		popVersion++;
		SoundManager.PlayPopup();
		_instance?.StartRevealForActiveTab();
	}
	public static void Close() { IsVisible = false; SoundManager.PlayPopdown(); }
	public static void Toggle()
	{
		IsVisible = !IsVisible;
		if ( IsVisible )
		{
			popVersion++;
			SoundManager.PlayPopup();
			_instance?.StartRevealForActiveTab();
		}
		else SoundManager.PlayPopdown();
	}

	private void StartRevealForActiveTab()
	{
		if ( activeTab == "streak" ) _ = PlayStreakRevealSequence();
		else _ = PlayMissionsRevealSequence();
	}

	// Per-stage state increments. Intervals must be >= 100ms (s&box render
	// cadence misses faster cycles). Stage map for the new Today-First layout:
	//   0 = nothing visible
	//   1 = today hero card
	//   2 = week progress strip
	//   3 = milestone line
	private async Task PlayStreakRevealSequence()
	{
		streakRevealStage = 0;
		await GameTask.DelaySeconds( 0.12f );
		streakRevealStage = 1;
		await GameTask.DelaySeconds( 0.18f );
		streakRevealStage = 2;
		await GameTask.DelaySeconds( 0.14f );
		streakRevealStage = 3;
	}

	private async Task PlayMissionsRevealSequence()
	{
		missionsRevealStage = 0;
		await GameTask.DelaySeconds( 0.12f );
		missionsRevealStage = 1;
		await GameTask.DelaySeconds( 0.12f );
		missionsRevealStage = 2;
		await GameTask.DelaySeconds( 0.12f );
		missionsRevealStage = 3;
	}

	// ═══════════════════════════════════════════════════════════════
	// LEGENDARY SILHOUETTE ROTATION (cycles 0-3 every 3 seconds)
	// ═══════════════════════════════════════════════════════════════

	private string GetStreakFireIcon()
	{
		var total = GetTotalDays();
		if ( total >= 100 ) return "streak-fire-5.webp";
		if ( total >= 30 ) return "streak-fire-4.webp";
		if ( total >= 14 ) return "streak-fire-3.webp";
		if ( total >= 7 ) return "streak-fire-2.webp";
		return "streak-fire-1.webp";
	}

	private static readonly string[] LegendarySpecies = { "mythweaver", "worldserpent", "voiddragon", "primordius" };

	private string GetLegendarySpecies()
	{
		return LegendarySpecies[GetLegendarySilhouetteIndex()];
	}

	private int GetLegendarySilhouetteIndex()
	{
		return ((int)(RealTime.Now / 3f)) % 4;
	}

	private string GetDayIconPath( int day )
	{
		if ( day == 7 ) return "sort/trophy.svg";
		if ( day >= 5 ) return "currency/token.svg";
		return "currency/money.svg";
	}

	private float GetStreakPercent()
	{
		var dayInCycle = GetStreakDayInCycle();
		return Math.Min( 100f, (float)(dayInCycle - 1) / 6f * 100f );
	}

	// ═══════════════════════════════════════════════════════════════
	// STREAK HELPERS (delegate to DailyRewardManager)
	// ═══════════════════════════════════════════════════════════════

	private int GetStreakDay() => DailyRewardManager.Instance?.DailyStreak ?? 0;
	private int GetStreakDayInCycle() => DailyRewardManager.Instance?.GetStreakDay() ?? 1;
	private int GetTotalDays() => DailyRewardManager.Instance?.TotalLoginDays ?? 0;
	private bool IsShieldReady() => DailyRewardManager.Instance?.IsShieldActive() ?? false;
	private bool IsTodayClaimed() => DailyRewardManager.Instance?.TodayRewardClaimed ?? false;
	private float GetWeekMultiplier() => DailyRewardManager.Instance?.GetWeekMultiplier() ?? 1.0f;

	private (int Gold, int Gems, int Ink, bool IsDay7) GetTodayReward()
	{
		if ( DailyRewardManager.Instance == null ) return (2000, 0, 5, false);

		var (gold, gems, ink) = DailyRewardManager.Instance.GetTodayReward();
		var day = GetStreakDayInCycle();
		return (gold, gems, ink, day == 7);
	}

	private (int Gold, int Gems, int Ink) GetDayReward( int day )
	{
		return DailyRewardManager.Instance?.GetDayReward( day ) ?? (2000, 0, 5);
	}

	private async void ClaimDailyReward()
	{
		// Guard against double-clicks mid-sequence
		if ( claimBurstActive ) return;
		if ( IsTodayClaimed() ) return;

		// t=0: layered sound + click + button overshoot + particle burst
		SoundManager.PlayClick();
		SoundManager.PlaySuccess();
		SoundManager.PlayGoldReward();

		claimButtonPulse = true;

		// Spawn burst layer. Determine which flyer icons to show from today's reward.
		var todayReward = GetTodayReward();
		claimBurstHasInk = todayReward.Ink > 0;
		claimBurstHasToken = todayReward.Gems > 0; // Gems slot maps to token icon in reward box
		claimBurstIsMilestone = todayReward.IsDay7;
		claimBurstVersion++;
		claimBurstActive = true;

		// Clear button overshoot class after ~80ms so it can retrigger next claim
		_ = ClearButtonPulseAsync();

		// Defer the actual manager call so GameHUD roll-up fires WHEN the flyer "lands"
		// on the currency pill (~450ms flight time in CSS).
		await GameTask.DelaySeconds( 0.45f );
		DailyRewardManager.Instance?.ClaimDailyReward();

		// Let the particle layer linger briefly after the flyer lands, then dismount
		await GameTask.DelaySeconds( 0.5f );
		claimBurstActive = false;
	}

	private async Task ClearButtonPulseAsync()
	{
		await GameTask.DelaySeconds( 0.1f );
		claimButtonPulse = false;
	}

	private int GetNextMilestone()
	{
		return DailyRewardManager.Instance?.GetNextMilestone() ?? 7;
	}

	private bool IsMilestoneClaimable( int milestone )
	{
		return DailyRewardManager.Instance?.IsMilestoneClaimable( milestone ) ?? false;
	}

	private void ClaimMilestone( int milestone )
	{
		SoundManager.PlaySuccess();
		DailyRewardManager.Instance?.ClaimMilestone( milestone );
	}

	private float GetMilestonePercent()
	{
		var total = GetTotalDays();
		var next = GetNextMilestone();
		if ( next <= 0 ) return 100;
		return Math.Min( 100, (float)total / next * 100f );
	}

	private string GetRefreshTime()
	{
		var now = DateTime.UtcNow;
		var midnight = now.Date.AddDays( 1 );
		var diff = midnight - now;
		return $"{diff.Hours}h {diff.Minutes}m";
	}

	// ═══════════════════════════════════════════════════════════════
	// MISSION HELPERS (delegate to MissionManager)
	// ═══════════════════════════════════════════════════════════════

	private List<MissionState> GetDailyMissions() => MissionManager.Instance?.ActiveDailyMissions ?? new();
	private List<MissionState> GetWeeklyMissions() => MissionManager.Instance?.ActiveWeeklyMissions ?? new();
	private MissionState GetMonthlyMission() => MissionManager.Instance?.ActiveMonthlyChallenge;
	private bool AreAllDailiesComplete() => MissionManager.Instance?.AreAllDailiesComplete() ?? false;
	private bool AreAllWeekliesComplete() => MissionManager.Instance?.AreAllWeekliesComplete() ?? false;

	private string GetMissionName( MissionState state )
	{
		var def = MissionManager.Instance?.GetDefinition( state.MissionId );
		return def?.Name ?? state.MissionId;
	}

	private string GetMissionDescription( MissionState state )
	{
		var def = MissionManager.Instance?.GetDefinition( state.MissionId );
		return def?.Description ?? "";
	}

	private string GetMissionIcon( MissionState state )
	{
		var def = MissionManager.Instance?.GetDefinition( state.MissionId );
		return def?.Icon ?? "ui/icons/sort/star.svg";
	}

	private int GetMissionTarget( MissionState state )
	{
		var def = MissionManager.Instance?.GetDefinition( state.MissionId );
		return def?.Target ?? 1;
	}

	private float GetMissionPercent( MissionState state )
	{
		var target = GetMissionTarget( state );
		if ( target <= 0 ) return 100;
		return Math.Min( 100, (float)state.Progress / target * 100f );
	}

	private string GetMissionRewardText( MissionState state )
	{
		var def = MissionManager.Instance?.GetDefinition( state.MissionId );
		if ( def == null ) return "";
		var parts = new List<string>();
		if ( def.GoldReward > 0 ) parts.Add( $"{def.GoldReward / 1000f:0.#}K" );
		if ( def.GemReward > 0 ) parts.Add( $"{def.GemReward} Gems" );
		if ( def.XPReward > 0 ) parts.Add( $"{def.XPReward} XP" );
		return string.Join( " + ", parts );
	}

	private void ClaimMission( string missionId )
	{
		SoundManager.PlaySuccess();
		MissionManager.Instance?.ClaimReward( missionId );
	}

	/// <summary>
	/// Returns total unclaimed rewards across daily + missions for badge display.
	/// </summary>
	public static int GetTotalUnclaimedCount()
	{
		int count = 0;
		count += DailyRewardManager.Instance?.GetUnclaimedCount() ?? 0;
		count += MissionManager.Instance?.GetUnclaimedCount() ?? 0;
		return count;
	}

	public override void Tick()
	{
		base.Tick();

		if ( IsVisible && Input.Pressed( "Escape" ) )
		{
			Close();
		}

		// Retrigger stagger reveal whenever the active tab changes
		if ( activeTab != lastTab )
		{
			lastTab = activeTab;
			StartRevealForActiveTab();
		}
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add( IsVisible );
		hash.Add( activeTab );
		hash.Add( GetStreakDay() );
		hash.Add( GetTotalDays() );
		hash.Add( IsTodayClaimed() );
		hash.Add( MissionManager.Instance?.GetUnclaimedCount() ?? 0 );
		hash.Add( GetLegendarySilhouetteIndex() );
		hash.Add( popVersion );
		hash.Add( streakRevealStage );
		hash.Add( missionsRevealStage );
		hash.Add( claimButtonPulse );
		hash.Add( claimBurstActive );
		hash.Add( claimBurstVersion );
		hash.Add( hoveredDay );
		return hash.ToHashCode();
	}
}
