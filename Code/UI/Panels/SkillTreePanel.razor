	// =========================================================================
	// Inline style helpers — state colors are COMPUTED (per-branch × state
	// cross-product stays out of the scss; both properties always emitted so
	// no ghost styles survive state flips).
	// =========================================================================
	private string SkRgba(string hex, float a)
	{
		int r = Convert.ToInt32(hex.Substring(1, 2), 16);
		int g = Convert.ToInt32(hex.Substring(3, 2), 16);
		int b = Convert.ToInt32(hex.Substring(5, 2), 16);
		string alpha = a.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
		return $"rgba({r}, {g}, {b}, {alpha})";
	}

	private string GetBranchChipStyle(SkillBranch branch, bool mastered)
	{
		var fill = mastered ? "#fbbf24" : GetBranchAccent(branch);
		return $"background-color: {fill};";
	}

	private string GetNodeBodyStyle(SkillBranch branch, string stateClass)
	{
		var a = GetBranchAccent(branch);
		return stateClass switch
		{
			"maxed"     => $"border-color: {a}; background-color: {a};",
			"available" => $"border-color: {a}; background-color: {SkRgba(a, 0.16f)};",
			"partial"   => $"border-color: {SkRgba(a, 0.55f)}; background-color: {SkRgba(a, 0.10f)};",
			"gated"     => "border-color: #1D1830; background-color: #110E1A;",
			_           => "border-color: #2A2340; background-color: #191430;" // locked
		};
	}

	private string GetThreadStyle(SkillBranch branch, bool unlocked, int lowerRank)
	{
		var a = GetBranchAccent(branch);
		if (lowerRank > 0) return $"background-color: {a};";
