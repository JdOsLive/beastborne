@namespace Beastborne.UI.Panels
@using Sandbox;
@using Sandbox.UI;
@using Beastborne.Core;
@using Beastborne.Data;
@using Beastborne.Systems;
@using Beastborne.UI;
@using Beastborne.UI.Primitives;
@using System.Linq;
@inherits Panel

@*
	SKILLS — talent workbench, efficiency-first sweep (2026-07).

	Composition: identity header (section header + TREE/STATS slab tabs +
	SP hero + inline two-stage reset) over an angled pink seam, then five
	branch pillars beside a FIXED INSPECTOR rail. The inspector replaces
	the old cursor-chasing tooltip — hover or WASD onto any node and its
	full reading (rank, effects, cost, status, big gold INVEST) sits
	still on the right. With nothing focused it auto-suggests the
	cheapest affordable node ("NEXT UP") so "what do I invest in next"
	is answered the moment the panel opens.

	Behavior preserved from v1: WASD/arrow nearest-node nav, Space/Enter
	invest, Tab view swap, F two-stage reset, per-invest ripple + burst,
	stats tab (eye toggle, 1Hz boost-timer heartbeat, W/S scroll).
	Refinement: Space now invests the INSPECTED node (what the player is
	reading) instead of a possibly-stale keyboard index.

	Generator dialect notes: class strings and colors are precomputed in
	code blocks (no quoted literals inside attribute value expressions
	where avoidable); dollar-interpolation only happens in code-behind.
*@

<div class="skill-tree-panel" onclick=@OnPanelClicked onmousemove=@OnPanelMouseMove>

	@* =========================== Header =========================== *@
	<div class="sk-header">
		<div class="sk-head-left">
			<BbSectionHeader Kicker="TAMER TALENTS" Title="@TitleText" Size=@(52) AccentColor="#ff6bd6" />
		</div>

		@{
			var treeTabClass = currentTab == "tree" ? "sk-tab active" : "sk-tab";
			var statsTabClass = currentTab == "stats" ? "sk-tab active" : "sk-tab";
			var treeIconColor = TabIconColor( "tree" );
			var statsIconColor = TabIconColor( "stats" );
			var activeStats = GetActiveStatCount();
		}
		<div class="sk-tabs">
			<div class="@treeTabClass" onclick=@OnTreeTabClick onmouseover=@OnTreeTabHover>
				<div class="sk-tab-inner">
					<iconify icon="lucide:network" Size=@(16) Color="@treeIconColor" />
					<span class="sk-tab-label">TREE</span>
				</div>
			</div>
			<div class="@statsTabClass" onclick=@OnStatsTabClick onmouseover=@OnStatsTabHover>
				<div class="sk-tab-inner">
					<iconify icon="lucide:bar-chart-3" Size=@(16) Color="@statsIconColor" />
					<span class="sk-tab-label">STATS</span>
					@if (activeStats > 0)
					{
						<span class="sk-tab-badge">@activeStats</span>
					}
				</div>
			</div>
			<div class="sk-tab-hint">
				<div class="cb-key sk-cap"><span>Tab</span></div>
				<span class="sk-hint-label">View</span>
			</div>
		</div>

		<div class="sk-head-right">
			@* SP hero — the tamer-wide balance as a one-glance number. *@
			<div class="sp-hero">
				<span class="sp-hero-label">SKILL POINTS</span>
				<div class="sp-hero-row">
					<iconify icon="lucide:star" Size=@(22) Color="#ffce3a" />
					<span class="sp-hero-value">@GetSkillPoints()</span>
					<span class="sp-hero-unit">SP</span>
				</div>
			</div>

			@if (GetTotalRanksUnlocked() > 0)
			{
				@* Inline two-stage confirm. Render-key remounts the element on
				   each state flip so the armed pulse keyframe replays cleanly.
				   Tuple pattern mirrors ShopPanelContent.GetBuyButtonContent to
				   sidestep the ghost-child diff bug on rapid state changes. *@
				@{ var reset = GetResetButtonContent(); }
				<button class="reset-btn @reset.cssClass reset-btn-@resetBtnVersion"
						onclick=@OnResetClicked
						onmouseover=@OnResetHover>
					@if (resetConfirming)
					{
						<div class="reset-armed-glow"></div>
					}
					<div class="cb-key sk-cap"><span>F</span></div>
					<iconify icon="@reset.icon" Size=@(14) Color="@reset.color" />
					<span>@reset.label</span>
				</button>
			}
		</div>
	</div>

	@* Angled seam — the panel's pink signature line. *@
	<div class="sk-seam">
		<div class="sk-seam-a"></div>
		<div class="sk-seam-b"></div>
	</div>

	@* =========================== TREE TAB =========================== *@
	@if (currentTab == "tree")
	{
	<div class="sk-body">
		<div class="sk-tree-zone">
			@foreach (var branch in AllBranches)
			{
				var branchPts = GetBranchPointsSpent(branch);
				var branchMax = GetBranchMaxPoints(branch);
				var mastered = branchPts >= branchMax && branchMax > 0;
				var branchNodes = GetBranchNodes(branch);
				var clusterClass = mastered ? "sk-cluster mastered" : "sk-cluster";
				var chipClass = mastered ? "sk-branch-chip mastered" : "sk-branch-chip";
				var fillClass = mastered ? "sk-foot-fill mastered" : "sk-foot-fill";

				<div class="@clusterClass">

					@* ---- Branch identity chip ---- *@
					<div class="sk-branch-row">
						<div class="@chipClass">
							<div class="sk-branch-chip-inner">
								@if (mastered)
								{
									<iconify icon="lucide:crown" Size=@(16) Color="#2a1605" />
								}
								else
								{
									<iconify icon="@GetBranchIcon(branch)" Size=@(16) Color="@GetBranchAccent(branch)" />
								}
								<span class="sk-branch-name">@branch.ToString().ToUpper()</span>
							</div>
						</div>
					</div>

					@* ---- Flower canvas ---- *@
					<div class="sk-canvas">

						@* Connector lines — brighten to pink when the downstream
						   petal's prereq is met ("energy flows here now"). *@
						@{
							var leftUnlocked  = branchNodes.Count > 1
								&& (string.IsNullOrEmpty(branchNodes[1].RequiredSkillId)
									|| GetSkillRank(branchNodes[1].RequiredSkillId) >= branchNodes[1].RequiredSkillRank);
							var rightUnlocked = branchNodes.Count > 2
								&& (string.IsNullOrEmpty(branchNodes[2].RequiredSkillId)
									|| GetSkillRank(branchNodes[2].RequiredSkillId) >= branchNodes[2].RequiredSkillRank);
							var connLeftClass  = leftUnlocked  ? "hex-connector left active"  : "hex-connector left";
							var connRightClass = rightUnlocked ? "hex-connector right active" : "hex-connector right";
						}
						<div class="@connLeftClass"></div>
						<div class="@connRightClass"></div>

						@for (int nodeIdx = 0; nodeIdx < branchNodes.Count; nodeIdx++)
						{
							var node = branchNodes[nodeIdx];
							var rank = GetSkillRank(node.Id);
							var isMaxed = rank >= node.MaxRank;
							var canUpgrade = CanUpgradeSkill(node.Id);
							var tierUnlocked = branchPts >= node.RequiredBranchPoints
								&& (string.IsNullOrEmpty(node.RequiredSkillId)
									|| GetSkillRank(node.RequiredSkillId) >= node.RequiredSkillRank);
							var stateClass = GetNodeStateClass(node, rank, canUpgrade, tierUnlocked);
							var unlockKey = GetUnlockKey(node.Id);
							var isKeystone = nodeIdx == 0;
							var slotClass = "hex-slot " + stateClass
								+ (tierUnlocked ? " revealed" : " dimmed")
								+ (isKeystone ? " is-keystone" : "")
								+ (IsKbFocused(node) ? " kb-focused" : "");
							var bodyClass = "hex-body " + stateClass + (isKeystone ? " is-keystone" : "");
							var badgeClass = isMaxed ? "rank-badge maxed" : "rank-badge";
							var iconSize = isKeystone ? 36 : 34;

							<div class="@slotClass"
								 style="left: @(NodeLeft(node))px; top: @(NodeTop(node))px;"
								 onclick=@(() => OnNodeClicked(node))
								 onmouseover=@(() => OnNodeHover(node))
								 onmouseout=@OnNodeHoverOut>

								<div class="@bodyClass">
									<iconify class="hex-icon" icon="@GetNodeIcon(node)" Size=@(iconSize) Color="@GetNodeIconColor(node, rank, isMaxed)" />

									@if (!tierUnlocked && !isKeystone)
									{
										<div class="hex-lock-corner">
											<iconify icon="lucide:lock" Size=@(11) Color="rgba(255, 255, 255, 0.55)" />
										</div>
									}
								</div>

								@* One-shot invest ripple — mounted fresh per invest via pulse-N key *@
								@if (unlockKey > 0 && node.Id == lastInvestedId && sinceBurst < 0.6f)
								{
									<div class="hex-unlock-pulse pulse-@unlockKey"></div>
								}

								@if (rank > 0 || isMaxed)
								{
									<div class="@badgeClass">
										@if (isMaxed)
										{
											<iconify icon="lucide:check" Size=@(11) Color="#ffce3a" />
										}
										else
										{
											<span>@rank</span>
										}
									</div>
								}
							</div>
						}
					</div>

					@* ---- Mastery footer ---- *@
					<div class="sk-branch-foot">
						<div class="sk-foot-track">
							<div class="@fillClass" style="width: @(GetBranchFillPx(branchPts, branchMax))px;"></div>
						</div>
						<span class="sk-foot-num">@branchPts</span>
						<span class="sk-foot-sep">/</span>
						<span class="sk-foot-max">@branchMax</span>
					</div>

				</div>
			}
		</div>

		@* =========================== THE INSPECTOR =========================== *@
		@{
			bool inspSuggested;
			var insp = GetInspectedNode(out inspSuggested);
		}
		<div class="sk-inspector">
			@if (insp != null)
			{
				var iRank = GetSkillRank(insp.Id);
				var iMaxed = iRank >= insp.MaxRank;
				var iCan = CanUpgradeSkill(insp.Id);
				var iBranchGateOk = GetBranchPointsSpent(insp.Branch) >= insp.RequiredBranchPoints;
				var iPrereqOk = string.IsNullOrEmpty(insp.RequiredSkillId)
					|| GetSkillRank(insp.RequiredSkillId) >= insp.RequiredSkillRank;
				var iNextRank = iRank + 1;
				var invest = GetInvestButtonContent(insp);

				<div class="insp-chip-row">
					<div class="insp-chip">
						<div class="insp-chip-inner">
							<iconify icon="@GetBranchIcon(insp.Branch)" Size=@(13) Color="@GetBranchAccent(insp.Branch)" />
							<span class="insp-chip-label">@insp.Branch.ToString().ToUpper()</span>
						</div>
					</div>
					@if (inspSuggested)
					{
						<div class="insp-next-tag"><span>NEXT UP</span></div>
					}
				</div>

				<div class="insp-name">@insp.Name</div>

				<div class="insp-rank-row">
					<span class="insp-rank-label">RANK</span>
					<span class="insp-rank-value">@iRank</span>
					<span class="insp-rank-sep">/</span>
					<span class="insp-rank-max">@insp.MaxRank</span>
					@if (iMaxed)
					{
						<BbStamp Text="MAX" Tone="gold" Tilt=@(3) Class="insp-max-stamp" />
					}
				</div>

				<div class="insp-desc">@insp.Description</div>

				<div class="insp-effects">
					@foreach (var effect in insp.Effects)
					{
						var cur = GetEffectDisplay(insp, effect, iRank);
						var nxt = GetEffectDisplay(insp, effect, iNextRank);
						<div class="insp-eff-row">
							@if (iRank > 0)
							{
								<span class="insp-eff-current">@cur</span>
							}
							@if (!iMaxed)
							{
								@if (iRank > 0)
								{
									<span class="insp-eff-arrow">→</span>
								}
								<span class="insp-eff-next">@nxt</span>
							}
						</div>
					}
				</div>

				@if (!iMaxed)
				{
					@if (!iBranchGateOk)
					{
						<div class="insp-status warn">
							<iconify icon="lucide:lock" Size=@(13) Color="#f87171" />
							<span>@GetBranchGateText(insp)</span>
						</div>
					}
					else if (!iPrereqOk)
					{
						<div class="insp-status warn">
							<iconify icon="lucide:lock" Size=@(13) Color="#f87171" />
							<span>@GetPrereqText(insp)</span>
						</div>
					}
					else if (iCan)
					{
						<div class="insp-status ok">
							<iconify icon="lucide:zap" Size=@(13) Color="#4ade80" />
							<span>Ready to invest</span>
						</div>
					}
					else
					{
						<div class="insp-status warn">
							<iconify icon="lucide:star" Size=@(13) Color="#f87171" />
							<span>Not enough SP</span>
						</div>
					}
				}

				<button class="insp-invest @invest.cssClass"
						onclick=@OnInvestClicked
						onmouseover=@OnInvestHover
						onmouseout=@OnInvestHoverOut>
					<div class="cb-key sk-cap invest-cap"><span>Space</span></div>
					<iconify icon="@invest.icon" Size=@(18) Color="@invest.color" />
					<span class="insp-invest-label">@invest.label</span>
				</button>
			}
			else
			{
				<div class="insp-done">
					<iconify icon="lucide:crown" Size=@(40) Color="#ffce3a" />
					<span>ALL TALENTS MASTERED</span>
				</div>
			}
		</div>
	</div>
	}
	else
	{
		@* =========================== STATS TAB =========================== *@
		var statRows = PlayerStatsSummary.GetAll();
		var activeCount = statRows.Count(r => r.HasContributions);
		var sampleGold = PlayerStatsSummary.GetSampleGoldExample(1000);
		var groupOrder = new[] { StatGroup.Economy, StatGroup.Progression, StatGroup.Expedition, StatGroup.Combat, StatGroup.Boss, StatGroup.Fusion };

		<div class="stats-body">

			<div class="stats-top-row">
				<div class="stats-summary-bar">
					<div class="ssb-left">
						<iconify icon="lucide:calculator" Size=@(22) Color="#ffce3a" />
						<div class="ssb-text">
							<span class="ssb-label">SAMPLE EXPEDITION</span>
							<span class="ssb-sub">1,000g base → @($"{sampleGold:N0}")g with current bonuses</span>
						</div>
					</div>
					<div class="ssb-right">
						<span class="ssb-pill-label">ACTIVE</span>
						<span class="ssb-pill-num">@activeCount</span>
						<span class="ssb-pill-sep">/</span>
						<span class="ssb-pill-max">@statRows.Count</span>
					</div>
					@* Eye toggle — hides/reveals the empty "available bonus" rows. *@
					<div class="ssb-eye @(showInactiveStats ? "active" : "")"
						 onclick=@ToggleShowInactiveStats
						 onmouseover=@(() => SoundManager.PlayHover())>
						<iconify icon="@(showInactiveStats ? "lucide:eye" : "lucide:eye-off")" Size=@(14) Color="@(showInactiveStats ? "#ffce3a" : "rgba(255, 255, 255, 0.6)")" />
					</div>
				</div>

				<div class="stats-footer-hint">
					<iconify icon="lucide:info" Size=@(11) Color="rgba(196, 181, 253, 0.55)" />
					<span>@(showInactiveStats ? "Cards without sources show bonuses you haven't unlocked yet. Tap the eye to hide them." : "Tap the eye to reveal every bonus you can still unlock.")</span>
				</div>
			</div>

			@* Card grid — 3-up rows chunked server-side (flex-wrap misreads
			   height in scroll containers, so rows are explicit). *@
			@{
				var visibleRows = showInactiveStats
					? statRows.OrderBy(r => groupOrder.ToList().IndexOf(r.Group)).ThenBy(r => r.Name).ToList()
					: statRows.Where(r => r.HasContributions)
						.OrderBy(r => groupOrder.ToList().IndexOf(r.Group)).ThenBy(r => r.Name).ToList();
				const int CardsPerRow = 3;
				var cardRows = new List<List<StatRow>>();
				for (int i = 0; i < visibleRows.Count; i += CardsPerRow)
				{
					cardRows.Add(visibleRows.Skip(i).Take(CardsPerRow).ToList());
				}
			}

			<div class="stats-scroll">

				@if (visibleRows.Count == 0)
				{
					<div class="stats-empty-card">
						<iconify icon="lucide:sparkles" Size=@(28) Color="rgba(196, 181, 253, 0.5)" />
						<span class="se-title">No active bonuses yet</span>
						<span class="se-sub">Invest in the skill tree, equip relics, or activate boosts. Tap the eye above to see what's available.</span>
					</div>
				}

				@foreach (var chunk in cardRows)
				{
					<div class="stats-card-row">
						@foreach (var row in chunk)
						{
							var hasAny = row.HasContributions;
							var net = row.NetPercentBonus;
							var sign = net >= 0 ? "+" : "";
							var totalText = hasAny
								? (row.IsFlat ? $"{sign}{net:0.#}" : $"{sign}{net:0.#}%")
								: "—";
							var groupClass = row.Group.ToString().ToLower();

							<div class="stat-card @groupClass @(hasAny ? "active" : "inactive")">
								<div class="sc-group" style="background-color: @PlayerStatsSummary.GetGroupColor(row.Group);">
									<span>@PlayerStatsSummary.GetGroupName(row.Group)</span>
								</div>

								<div class="sc-head">
									<div class="sc-icon-wrap @(hasAny ? "" : "inactive")">
										<iconify icon="@row.Icon" Size=@(14) Color="@(hasAny ? "#ffffff" : "rgba(255,255,255,0.35)")" />
									</div>
									<span class="sc-name @(hasAny ? "" : "inactive")">@row.Name</span>
									<div class="sc-total @(hasAny ? "active" : "inactive") @(net < 0 ? "negative" : "")">
										<span class="sc-total-value">@totalText</span>
									</div>
								</div>

								@if (hasAny)
								{
									<div class="sc-sources">
										@foreach (var src in row.Sources)
										{
											var valTxt = src.Op == StatOp.Multiply
												? $"×{src.Value:0.0#}"
												: (row.IsFlat ? $"+{src.Value:0.#}" : $"+{src.Value:0.#}%");
											<div class="sc-src">
												<div class="sc-src-tag" style="background-color: @src.TagColor;">
													<span>@src.Tag</span>
												</div>
												<span class="sc-src-label">@src.Label</span>
												@if (src.TimeRemaining.HasValue)
												{
													<span class="sc-src-timer @(src.TimeRemaining.Value.TotalMinutes < 5 ? "expiring" : "")">@FormatBoostTime(src.TimeRemaining.Value)</span>
												}
												<span class="sc-src-value @(src.Op == StatOp.Multiply ? "multiply" : "add")">@valTxt</span>
											</div>
										}
									</div>
								}
								else
								{
									<div class="sc-empty">
										<span>@row.Description</span>
									</div>
								}
							</div>
						}
						@for (int pad = chunk.Count; pad < CardsPerRow; pad++)
						{
							<div class="stat-card-spacer"></div>
						}
					</div>
				}

			</div>
		</div>
	}

	@* =========================== Invest particle burst (keystroke-mounted) =========================== *@
	@if (showBurst)
	{
		<div class="unlock-burst-layer burst-@burstVersion" style="left: @(burstX)px; top: @(burstY)px;">
			@for (int i = 0; i < 8; i++)
			{
				<div class="burst-particle p-@i" style="background-color: @burstColor;"></div>
			}
		</div>
	}

	@* =========================== THE LIVING VIOLET RING =========================== *@
	@* Keyboard cursor over the hex graph — root-level absolute (roster
	   flat-panel recipe). Position bound each tick from UpdateRing; the
	   liquid wave runs imperatively in ApplyRingWave (no re-render). *@
	<div @ref="ringRef" class="sk-ring @(ringVisible ? "on" : "") @(ringWarm < 2 ? "snap" : "")"
		 style="left: @(ringL)px; top: @(ringT)px; width: @(ringW)px; height: @(ringH)px;"></div>

</div>


@code {
	// =========================================================================
	// State
	// =========================================================================

	// Tab state — "tree" (default landing) or "stats".
	private string currentTab = "tree";
	private string lastTabHover = null; // sound guard (s&box onmouseover fires repeatedly)

	// When false (default), the stats list hides every row that has zero
	// contributions. Toggle in the summary bar flips it on.
	private bool showInactiveStats = false;
	// Stats subtab refresh tick — boost timers count down live.
	private int statsTickVersion = 0;
	private TimeSince sinceStatsTick = 0f;

	// Live hover target (mouse OR keyboard cursor — SyncKbCursor writes it).
	private SkillNode hoveredNode;
	private string lastHoveredId = null; // hover-sound guard

	// The inspector's sticky target — survives hover-out so the reading
	// rail never blanks mid-browse. Falls back to the suggested pick.
	private string inspectedNodeId = null;

	// Cursor tracking — used to aim the invest particle burst.
	private float lastMouseX;
	private float lastMouseY;

	// Unlock keys drive the one-shot invest ripple via key-changing remounts.
	private Dictionary<string, int> unlockVersions = new();

	// Particle burst state
	private bool showBurst;
	private int burstVersion;
	private float burstX;
	private float burstY;
	private string burstColor = "#ff6bd6";
	private TimeSince sinceBurst;

	// Tracks which node was most-recently invested so the ripple overlay
	// only mounts on that hex.
	private string lastInvestedId = null;

	// Reset confirmation — inline two-stage flow on the header button.
	private bool resetConfirming;
	private float resetConfirmExpires = 0f;
	private float resetFlashUntil = 0f;
	private int resetBtnVersion = 0;
	private float resetClickGuardUntil = 0f;
	private string lastResetHoverState = null;

	private bool IsResetFlashing => RealTime.Now < resetFlashUntil;
	private const float ResetConfirmWindow = 3.0f;
	private const float ResetFlashDuration = 0.9f;

	// Invest CTA hover sound guard.
	private bool investHovered;

	private SkillBranch[] AllBranches = new[]
	{
		SkillBranch.Power,
		SkillBranch.Fortune,
		SkillBranch.Fusion,
		SkillBranch.Expedition,
		SkillBranch.Mastery
	};

	// =========================================================================
	// Localization
	// =========================================================================
	private string L(string key) => LocalizationManager.Get(key);
	private string L(string key, params object[] args) => LocalizationManager.Get(key, args);
	private string TitleText => L("ui.skill.title");

	// =========================================================================
	// Node layout — data GridX/GridY (tuned for the old 58px slots in a
	// 260px canvas) remapped into the new 248px canvas with 84px slots.
	// Center-preserving: oldCenter = Grid + 29; KX squeezes into 248-space,
	// KY 1.55 opens vertical room for the bigger nodes. Keystone center
	// lands (123, 74); petals (46, 192) / (199, 192) — the SCSS connector
	// constants derive from these.
	// =========================================================================
	private const float NodeKX = 0.9538f;
	private const float NodeKY = 1.55f;
	private const int NodeSlot = 84;

	private int NodeLeft(SkillNode n) => (int)((n.GridX + 29) * NodeKX) - NodeSlot / 2;
	private int NodeTop(SkillNode n) => (int)((n.GridY + 29) * NodeKY) - 62;

	// Mastery bar fill — computed px (180px track).
	private int GetBranchFillPx(int pts, int max)
	{
		if (max <= 0) return 0;
		return Math.Clamp((int)(180f * pts / max), 0, 180);
	}

	// =========================================================================
	// Lifecycle
	// =========================================================================
	protected override void OnAfterTreeRender(bool firstTime)
	{
		if (firstTime)
		{
			AcceptsFocus = true;
		}
	}

	public override void Tick()
	{
		base.Tick();

		// Auto-hide burst after ~0.9s so the layer can remount next invest.
		if (showBurst && sinceBurst > 0.9f)
		{
			showBurst = false;
		}

		// Auto-revert the armed reset if the confirm window lapses. Silent.
		if (resetConfirming && RealTime.Now > resetConfirmExpires)
		{
			resetConfirming = false;
			resetBtnVersion++;
		}

		// Stats tab 1Hz heartbeat for live boost timers.
		if (currentTab == "stats" && sinceStatsTick > 1.0f)
		{
			statsTickVersion++;
			sinceStatsTick = 0f;
		}

		// Living ring — position recomputed per tick (layout can reflow),
		// wave applied imperatively (flat panel: per-frame writes are cheap;
		// the 7fps law only bites inside perspective leans).
		UpdateRing();
		ApplyRingWave();
	}

	// =========================================================================
	// Keyboard navigation
	// =========================================================================
	// TREE tab: spatial cursor over the hex graph — reads rendered .hex-slot
	// rects and picks the best node in the pressed direction. The focused
	// node drives the inspector (same channel the mouse hover uses).
	// STATS tab: W/S scroll the card list, Space toggles the eye.
	// Tab toggles the sub-tabs; F fires the header reset button.
	private int _kbNodeIndex = 0;
	private bool _kbActive = false;

	public void TickInput()
	{
		// Tab — swap TREE / STATS sub-tab.
		if (Input.Pressed("Score"))
		{
			SetTab(currentTab == "tree" ? "stats" : "tree");
			return;
		}

		// F — header reset button (its own two-stage confirm guards it).
		if (Input.Pressed("Flashlight"))
		{
			OnResetClicked();
			return;
		}

		if (currentTab == "tree")
			TickTreeInput();
		else
			TickStatsInput();
	}

	private void TickTreeInput()
	{
		var nodes = GetAllNodesFlat();
		if (nodes.Count == 0) return;
		ClampKbIndex(nodes.Count);

		// Space / Enter — invest in the INSPECTED node (what the player is
		// reading in the rail; matches the CTA's Space keycap).
		if (Input.Pressed("Jump") || Input.Pressed("Enter"))
		{
			bool _s;
			var target = GetInspectedNode(out _s);
			if (target == null) return;
			_kbActive = true;
			int ti = nodes.FindIndex(n => n.Id == target.Id);
			if (ti >= 0) _kbNodeIndex = ti;
			AimBurstAtNode(target);
			OnNodeClicked(target);
			return;
		}

		int dir = -1; // 0 up · 1 down · 2 left · 3 right
		if (Input.Pressed("Up")) dir = 0;
		else if (Input.Pressed("Down")) dir = 1;
		else if (Input.Pressed("Left")) dir = 2;
		else if (Input.Pressed("Right")) dir = 3;
		if (dir < 0) return;

		var rects = CollectHexRects();

		// First nav keypress just lights the cursor — engage on the node the
		// mouse last hovered if there is one, otherwise the saved index.
		if (!_kbActive)
		{
			_kbActive = true;
			if (hoveredNode != null)
			{
				int hi = nodes.FindIndex(n => n.Id == hoveredNode.Id);
				if (hi >= 0) _kbNodeIndex = hi;
			}
			if (rects.Count == nodes.Count) SyncKbCursor(nodes, rects);
			SoundManager.PlayHover();
			return;
		}

		if (rects.Count != nodes.Count) return; // layout not ready this frame

		int next = FindNeighbor(_kbNodeIndex, dir, rects);
		if (next >= 0 && next != _kbNodeIndex)
		{
			_kbNodeIndex = next;
			SyncKbCursor(nodes, rects);
			SoundManager.PlayHover();
		}
	}

	private void TickStatsInput()
	{
		// Space / Enter toggles the "show every available bonus" eye.
		if (Input.Pressed("Jump") || Input.Pressed("Enter"))
		{
			ToggleShowInactiveStats();
			return;
		}
		// W / S scroll the card list (held = continuous).
		var scroll = FindByClass(this, "stats-scroll");
		if (scroll == null) return;
		float step = 0f;
		if (Input.Down("Down")) step = 14f;
		else if (Input.Down("Up")) step = -14f;
		if (step != 0f)
		{
			float y = Math.Max(0f, scroll.ScrollOffset.y + step);
			scroll.ScrollOffset = new Vector2(scroll.ScrollOffset.x, y);
		}
	}

	// Focused node → drive the inspector + park burst coords on the node so
	// an invest lands its particles there, not at a stale mouse spot.
	private void SyncKbCursor(List<SkillNode> nodes, List<Rect> rects)
	{
		if (_kbNodeIndex < 0 || _kbNodeIndex >= nodes.Count) return;
		hoveredNode = nodes[_kbNodeIndex];
		lastHoveredId = hoveredNode.Id;
		inspectedNodeId = hoveredNode.Id;
		if (_kbNodeIndex < rects.Count)
		{
			float sc = ScaleFromScreen;
			if (sc <= 0.01f || float.IsNaN(sc) || float.IsInfinity(sc)) sc = 1f;
			var c = rects[_kbNodeIndex].Center;
			lastMouseX = (c.x - Box.Rect.Left) * sc;
			lastMouseY = (c.y - Box.Rect.Top) * sc;
		}
	}

	private void ClampKbIndex(int count)
	{
		if (count <= 0) { _kbNodeIndex = 0; return; }
		_kbNodeIndex = Math.Clamp(_kbNodeIndex, 0, count - 1);
	}

	// Flat node list in render order: AllBranches × GetBranchNodes. MUST stay
	// in sync with the .hex-slot DOM order so CollectHexRects indexes line up.
	private List<SkillNode> GetAllNodesFlat()
	{
		var list = new List<SkillNode>();
		foreach (var b in AllBranches)
			list.AddRange(GetBranchNodes(b));
		return list;
	}

	private bool IsKbFocused(SkillNode node)
	{
		if (!_kbActive || currentTab != "tree" || node == null) return false;
		var nodes = GetAllNodesFlat();
		return _kbNodeIndex >= 0 && _kbNodeIndex < nodes.Count
			&& nodes[_kbNodeIndex].Id == node.Id;
	}

	// Depth-first collect of every rendered .hex-slot's screen rect, in DOM
	// order (index-parallel to GetAllNodesFlat).
	private List<Rect> CollectHexRects()
	{
		var panels = new List<Panel>();
		CollectByClass(this, "hex-slot", panels);
		return panels.Select(p => p.Box.Rect).ToList();
	}

	private void CollectByClass(Panel root, string cls, List<Panel> outList)
	{
		foreach (var c in root.Children)
		{
			if (c.HasClass(cls)) outList.Add(c);
			else CollectByClass(c, cls, outList);
		}
	}

	private Panel FindByClass(Panel root, string cls)
	{
		foreach (var c in root.Children)
		{
			if (c.HasClass(cls)) return c;
			var found = FindByClass(c, cls);
			if (found != null) return found;
		}
		return null;
	}

	// Pick the nearest node in direction `dir`. Score = primary-axis distance
	// + 2.5× perpendicular offset. Returns -1 when nothing lies that way.
	private int FindNeighbor(int from, int dir, List<Rect> rects)
	{
		if (from < 0 || from >= rects.Count) return -1;
		float cx = rects[from].Center.x;
		float cy = rects[from].Center.y;
		int best = -1;
		float bestScore = float.MaxValue;
		for (int i = 0; i < rects.Count; i++)
		{
			if (i == from) continue;
			float dx = rects[i].Center.x - cx;
			float dy = rects[i].Center.y - cy;
			float primary, perp;
			switch (dir)
			{
				case 0:  if (dy > -4f) continue; primary = -dy; perp = Math.Abs(dx); break;
				case 1:  if (dy <  4f) continue; primary =  dy; perp = Math.Abs(dx); break;
				case 2:  if (dx > -4f) continue; primary = -dx; perp = Math.Abs(dy); break;
				default: if (dx <  4f) continue; primary =  dx; perp = Math.Abs(dy); break;
			}
			float score = primary + perp * 2.5f;
			if (score < bestScore) { bestScore = score; best = i; }
		}
		return best;
	}

	// =========================================================================
	// THE LIVING VIOLET RING — roster flat-panel recipe
	// =========================================================================
	// Position recomputed every Tick from live Box.Rects (tab swaps and
	// hotloads invalidate rects). Content-box math: declared size = target
	// + 2×inset − 2×border (s&box has no border-box).
	private Panel ringRef;
	private int ringL, ringT, ringW = 96, ringH = 96;
	private bool ringVisible;
	private int ringWarm; // <2 = snap to position (no glide) while rects land
	private const int RingInset = 10;

	private void UpdateRing()
	{
		bool wasVisible = ringVisible;
		ringVisible = false;

		if (currentTab != "tree" || !_kbActive) return;

		var nodes = GetAllNodesFlat();
		if (nodes.Count == 0) return;
		ClampKbIndex(nodes.Count);

		var rects = CollectHexRects();
		if (_kbNodeIndex >= rects.Count) return;

		var rr = Box.Rect;
		var cr = rects[_kbNodeIndex];
		if (rr.Width < 1f || cr.Width < 1f) return;

		float sc = ScaleFromScreen;
		if (sc <= 0.01f || float.IsNaN(sc) || float.IsInfinity(sc)) sc = 1f;

		ringL = (int)((cr.Left - rr.Left) * sc) - RingInset;
		ringT = (int)((cr.Top - rr.Top) * sc) - RingInset;
		ringW = (int)(cr.Width * sc) + RingInset * 2 - 8;
		ringH = (int)(cr.Height * sc) + RingInset * 2 - 8;

		ringVisible = true;
		if (!wasVisible) ringWarm = 0;       // re-appearing → snap first, glide after
		else if (ringWarm < 2) ringWarm++;
	}

	// The liquid ink-lean — menu-cursor multi-sine at the PawPad's ×0.6
	// amplitude + out-of-phase breathing. Imperative transform: no re-render;
	// flat panel so per-frame writes are cheap.
	private void ApplyRingWave()
	{
		if (ringRef == null || !ringVisible) return;
		float wt = Time.Now;
		float skX = (2.0f * MathF.Sin(wt * 2.2f) + 0.7f * MathF.Sin(wt * 3.5f + 1.1f)) * 0.6f;
		float skY = (2.3f * MathF.Sin(wt * 1.8f + 1.9f) + 0.9f * MathF.Sin(wt * 2.9f)) * 0.6f;
		float rotZ = (1.1f * MathF.Sin(wt * 1.0f) + 0.5f * MathF.Sin(wt * 2.4f + 0.5f)) * 0.6f;
		float brX = 1f + 0.013f * MathF.Sin(wt * 1.35f + 0.7f) + 0.006f * MathF.Sin(wt * 2.7f);
		float brY = 1f + 0.013f * MathF.Sin(wt * 1.15f + 2.6f) + 0.006f * MathF.Sin(wt * 2.3f + 1.4f);

		var t = new PanelTransform();
		t.AddRotation(0f, 0f, rotZ);
		t.AddSkew(skX, skY, 0f);
		t.AddScale(new Vector2(brX, brY));
		ringRef.Style.Transform = t;
	}

	// =========================================================================
	// Inspector resolution
	// =========================================================================
	// Priority: live hover/kb cursor → sticky last-inspected → the suggested
	// pick (cheapest affordable node — "what to invest in next").
	private SkillNode GetInspectedNode(out bool suggested)
	{
		suggested = false;

		if (hoveredNode != null) return hoveredNode;

		if (!string.IsNullOrEmpty(inspectedNodeId))
		{
			var sticky = TamerManager.Instance?.SkillTree?.GetNode(inspectedNodeId);
			if (sticky != null) return sticky;
		}

		var pick = DefaultInspectNode();
		if (pick != null && CanUpgradeSkill(pick.Id)) suggested = true;
		return pick;
	}

	private SkillNode DefaultInspectNode()
	{
		var all = GetAllNodesFlat();
		if (all.Count == 0) return null;

		// Cheapest affordable first.
		var afford = all.Where(n => CanUpgradeSkill(n.Id))
			.OrderBy(n => n.CostPerRank).FirstOrDefault();
		if (afford != null) return afford;

		// Otherwise the first not-yet-maxed talent; null when ALL are maxed
		// (the inspector then shows the mastered celebration block).
		return all.FirstOrDefault(n => GetSkillRank(n.Id) < n.MaxRank);
	}

	// Aim the burst at a node's hex center (keyboard / CTA invests happen
	// while the mouse cursor isn't on the node).
	private void AimBurstAtNode(SkillNode node)
	{
		if (node == null) return;
		var nodes = GetAllNodesFlat();
		int idx = nodes.FindIndex(n => n.Id == node.Id);
		if (idx < 0) return;
		var rects = CollectHexRects();
		if (idx >= rects.Count) return;
		float sc = ScaleFromScreen;
		if (sc <= 0.01f || float.IsNaN(sc) || float.IsInfinity(sc)) sc = 1f;
		var c = rects[idx].Center;
		lastMouseX = (c.x - Box.Rect.Left) * sc;
		lastMouseY = (c.y - Box.Rect.Top) * sc;
	}

	// =========================================================================
	// Event handlers
	// =========================================================================
	private void OnPanelClicked()
	{
		GameHUD.EnterPanel();

		// Click-elsewhere cancels the armed reset (the button's own onclick
		// runs first and sets the guard, so this only fires for genuine
		// outside clicks).
		if (resetConfirming && RealTime.Now > resetClickGuardUntil)
		{
			resetConfirming = false;
			resetBtnVersion++;
		}
	}

	private void OnPanelMouseMove()
	{
		// Track cursor for burst positioning (MousePosition is panel-local).
		lastMouseX = MousePosition.x;
		lastMouseY = MousePosition.y;
	}

	private void OnNodeHover(SkillNode node)
	{
		if (node == null) return;
		if (lastHoveredId == node.Id) return; // guard repeat-fire
		lastHoveredId = node.Id;
		hoveredNode = node;
		inspectedNodeId = node.Id;
		// Mouse took over — drop the keyboard cursor so the violet ring and
		// CSS :hover never mark two different nodes at once.
		_kbActive = false;

		// Locked petals get a soft deny cue — "this is gated" without
		// forcing a read of the inspector.
		bool tierUnlocked = GetBranchPointsSpent(node.Branch) >= node.RequiredBranchPoints
			&& (string.IsNullOrEmpty(node.RequiredSkillId)
				|| GetSkillRank(node.RequiredSkillId) >= node.RequiredSkillRank);
		if (!tierUnlocked)
		{
			SoundManager.PlayDeny();
		}
		else
		{
			SoundManager.PlayHover();
		}
	}

	private void OnNodeHoverOut()
	{
		// The inspector keeps reading the last node (inspectedNodeId is
		// already sticky) — only the live-hover channel clears.
		lastHoveredId = null;
		hoveredNode = null;
	}

	private void OnNodeClicked(SkillNode node)
	{
		if (node == null) return;

		var tamer = TamerManager.Instance;
		if (tamer == null) return;

		inspectedNodeId = node.Id;

		bool ok = tamer.CanUnlockSkill(node.Id);
		if (!ok)
		{
			SoundManager.PlayDeny();
			return;
		}

		int prevRank = tamer.GetSkillRank(node.Id);
		bool success = tamer.UnlockSkill(node.Id);
		if (!success) { SoundManager.PlayDeny(); return; }

		int newRank = tamer.GetSkillRank(node.Id);
		var newNode = tamer.SkillTree?.GetNode(node.Id);
		bool justMaxed = newNode != null && newRank >= newNode.MaxRank;
		bool isCapstoneSetpiece = justMaxed && node.Tier == 3;

		// Bump the unlock version → ripple overlay remounts + replays.
		if (!unlockVersions.ContainsKey(node.Id)) unlockVersions[node.Id] = 0;
		unlockVersions[node.Id]++;
		lastInvestedId = node.Id;

		// Particle burst at the cursor (or node center for kb/CTA invests —
		// AimBurstAtNode parks the coords there first). Skills pink.
		burstVersion++;
		burstX = lastMouseX;
		burstY = lastMouseY;
		burstColor = "#ff6bd6";
		showBurst = true;
		sinceBurst = 0f;

		// Sound — tiered.
		if (isCapstoneSetpiece)
		{
			SoundManager.PlaySuccess();
			SoundManager.PlayGoldReward();
		}
		else if (justMaxed)
		{
			SoundManager.PlaySuccess();
		}
		else
		{
			SoundManager.PlayForward();
		}
	}

	// INVEST CTA — invests whatever the inspector is reading.
	private void OnInvestClicked()
	{
		bool _s;
		var node = GetInspectedNode(out _s);
		if (node == null) return;
		AimBurstAtNode(node);
		OnNodeClicked(node);
	}

	private void OnInvestHover()
	{
		if (investHovered) return;
		investHovered = true;
		SoundManager.PlayHover();
	}

	private void OnInvestHoverOut()
	{
		investHovered = false;
	}

	// Inline two-stage reset. First click arms; second click (within the
	// window) fires; click-elsewhere or timeout reverts silently.
	private void OnResetClicked()
	{
		if (GetTotalRanksUnlocked() <= 0) return;

		resetClickGuardUntil = RealTime.Now + 0.1f;

		if (IsResetFlashing) return;

		if (!resetConfirming)
		{
			resetConfirming = true;
			resetConfirmExpires = RealTime.Now + ResetConfirmWindow;
			resetBtnVersion++; // remount so the armed pulse keyframe plays
			SoundManager.PlayClick();
		}
		else
		{
			var tm = TamerManager.Instance;
			if (tm == null)
			{
				resetConfirming = false;
				resetBtnVersion++;
				return;
			}

			int refunded = tm.ResetSkillTree();
			unlockVersions.Clear();
			lastInvestedId = null;
			hoveredNode = null;
			inspectedNodeId = null;

			resetConfirming = false;
			resetFlashUntil = RealTime.Now + ResetFlashDuration;
			resetBtnVersion++;

			// Destructive action — PlayBack colors "undoing progress"
			// distinctly from a gain cue.
			SoundManager.PlayBack();
			Log.Info($"[SkillTree] Inline reset confirmed — refunded {refunded} SP");
		}
	}

	private void OnResetHover()
	{
		if (lastResetHoverState == "reset") return;
		lastResetHoverState = "reset";
		SoundManager.PlayHover();
	}

	// =========================================================================
	// Tabs
	// =========================================================================
	private void SetTab(string tab)
	{
		if (currentTab == tab) return;
		currentTab = tab;
		// Clear tree-transient state so it doesn't bleed across views.
		hoveredNode = null;
		lastHoveredId = null;
		showBurst = false;
		sinceStatsTick = 0f;
		SoundManager.PlayTabSwitch();
	}

	private void OnTabHover(string tab)
	{
		if (lastTabHover == tab) return;
		lastTabHover = tab;
		SoundManager.PlayHover();
	}

	// Parameterless wrappers — keeps quoted literals out of markup attribute
	// expressions (generator dialect).
	private void OnTreeTabClick() => SetTab("tree");
	private void OnStatsTabClick() => SetTab("stats");
	private void OnTreeTabHover() => OnTabHover("tree");
	private void OnStatsTabHover() => OnTabHover("stats");

	private string TabIconColor(string tab)
	{
		return currentTab == tab ? "#2e0a22" : "rgba(214, 206, 236, 0.75)";
	}

	private void ToggleShowInactiveStats()
	{
		showInactiveStats = !showInactiveStats;
		SoundManager.PlayClick();
	}

	private int GetActiveStatCount()
	{
		return PlayerStatsSummary.CountActiveRows();
	}

	private string FormatBoostTime(TimeSpan ts)
	{
		if (ts.TotalSeconds <= 0) return "0:00";
		if (ts.TotalHours >= 1) return $"{(int)ts.TotalHours}:{ts.Minutes:D2}:{ts.Seconds:D2}";
		return $"{ts.Minutes:D1}:{ts.Seconds:D2}";
	}

	// Tuple-render helper for the reset button (single iconify + span so
	// s&box only swaps attribute values — no ghost children).
	private (string icon, string label, string color, string cssClass) GetResetButtonContent()
	{
		if (IsResetFlashing)
			return ("lucide:check", "Reset!", "#ffffff", "flashing");

		if (resetConfirming)
			return ("lucide:alert-triangle", "Click again to confirm", "#fbbf24", "armed");

		return ("lucide:rotate-ccw", "Reset", "#f87171", "");
	}

	// Tuple-render helper for the INVEST CTA — same ghost-child dodge.
	private (string icon, string label, string color, string cssClass) GetInvestButtonContent(SkillNode node)
	{
		if (node == null)
			return ("lucide:crown", "All mastered", "#ffce3a", "maxed-cta");

		int rank = GetSkillRank(node.Id);
		if (rank >= node.MaxRank)
			return ("lucide:crown", "Mastered", "#ffce3a", "maxed-cta");

		bool branchGateOk = GetBranchPointsSpent(node.Branch) >= node.RequiredBranchPoints;
		bool prereqOk = string.IsNullOrEmpty(node.RequiredSkillId)
			|| GetSkillRank(node.RequiredSkillId) >= node.RequiredSkillRank;
		if (!branchGateOk || !prereqOk)
			return ("lucide:lock", "Locked", "rgba(214, 206, 236, 0.45)", "off");

		if (CanUpgradeSkill(node.Id))
			return ("lucide:zap", $"Invest · {node.CostPerRank} SP", "#2a1605", "");

		return ("lucide:star", $"Need {node.CostPerRank} SP", "rgba(214, 206, 236, 0.45)", "off");
	}

	// Status strings for the inspector's lock lines — built in C# so no
	// dollar-interpolation touches markup.
	private string GetBranchGateText(SkillNode node)
	{
		return $"Needs {node.RequiredBranchPoints} pts in {node.Branch}";
	}

	private string GetPrereqText(SkillNode node)
	{
		var reqNode = TamerManager.Instance?.SkillTree?.GetNode(node.RequiredSkillId);
		var reqName = reqNode?.Name ?? "prerequisite";
		return $"Needs {reqName} rank {node.RequiredSkillRank}";
	}

	// =========================================================================
	// Data helpers
	// =========================================================================
	private int GetSkillPoints() => TamerManager.Instance?.CurrentTamer?.SkillPoints ?? 0;
	private int GetTotalSkillPointsSpent() => TamerManager.Instance?.GetTotalSkillPointsSpent() ?? 0;
	private int GetTotalRanksUnlocked() => TamerManager.Instance?.GetTotalRanksUnlocked() ?? 0;

	private int GetBranchPointsSpent(SkillBranch branch)
	{
		var tamer = TamerManager.Instance;
		if (tamer?.SkillTree == null || tamer?.CurrentTamer == null) return 0;
		return tamer.SkillTree.GetPointsSpentInBranch(branch, tamer.CurrentTamer.SkillRanks);
	}

	private int GetBranchMaxPoints(SkillBranch branch)
	{
		return GetBranchNodes(branch).Sum(n => n.MaxRank * n.CostPerRank);
	}

	private List<SkillNode> GetBranchNodes(SkillBranch branch)
	{
		return TamerManager.Instance?.SkillTree?.GetNodesByBranch(branch) ?? new();
	}

	private int GetSkillRank(string skillId) => TamerManager.Instance?.GetSkillRank(skillId) ?? 0;
	private bool CanUpgradeSkill(string skillId) => TamerManager.Instance?.CanUnlockSkill(skillId) ?? false;

	private int GetUnlockKey(string id)
	{
		return unlockVersions.TryGetValue(id, out var v) ? v : 0;
	}

	// =========================================================================
	// Node state → CSS class (investability language: pink/gold/quiet)
	// =========================================================================
	private string GetNodeStateClass(SkillNode node, int rank, bool canUpgrade, bool tierUnlocked)
	{
		if (rank >= node.MaxRank) return "maxed";
		if (!tierUnlocked) return "gated";
		if (canUpgrade) return "available";
		if (rank > 0) return "partial";
		return "locked";
	}

	private string GetNodeIconColor(SkillNode node, int rank, bool isMaxed)
	{
		if (isMaxed) return "#2a1605"; // dark ink on the gold-filled hex
		if (rank > 0) return "#ffffff";
		return "rgba(255, 255, 255, 0.7)";
	}

	// =========================================================================
	// Branch presentation helpers
	// =========================================================================
	private string GetBranchAccent(SkillBranch branch)
