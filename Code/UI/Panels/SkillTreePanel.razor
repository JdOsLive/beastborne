@namespace Beastborne.UI.Panels
@using Sandbox;
@using Sandbox.UI;
@using Beastborne.Core;
@using Beastborne.Data;
@using Beastborne.Systems;
@using System.Linq;
@inherits Panel

<div class="skill-tree-panel" onclick=@OnPanelClicked onmousemove=@OnPanelMouseMove>

	@* =========================== Header =========================== *@
	<div class="skill-header">
		<div class="skill-header-left">
			<iconify class="skill-title-icon" icon="lucide:sparkles" Size=@(24) Color="#c4b5fd" />
			<div class="skill-title">@L("ui.skill.title")</div>

			@* Tab pills sit immediately right of the title, grouped on the left
			   side of the header (not centered). *@
			<div class="stree-tabs">
				<div class="stree-tab @(currentTab == "tree" ? "active" : "")"
					 onclick=@(() => SetTab("tree"))
					 onmouseover=@(() => OnTabHover("tree"))>
					<iconify icon="lucide:sparkles" Size=@(16) Color="@(currentTab == "tree" ? "#ffffff" : "rgba(255, 255, 255, 0.7)")" />
					<span class="stree-tab-label">TREE</span>
				</div>
				<div class="stree-tab @(currentTab == "stats" ? "active" : "")"
					 onclick=@(() => SetTab("stats"))
					 onmouseover=@(() => OnTabHover("stats"))>
					<iconify icon="lucide:bar-chart-3" Size=@(16) Color="@(currentTab == "stats" ? "#ffffff" : "rgba(255, 255, 255, 0.7)")" />
					<span class="stree-tab-label">STATS</span>
					@{ var activeStats = GetActiveStatCount(); }
					@if (activeStats > 0)
					{
						<span class="stree-tab-count">@activeStats</span>
					}
				</div>
			</div>
			<div class="kb-hint stree-kb-hint">
				<div class="cb-key stree-cap"><span>Tab</span></div>
				<span class="kb-hint-label">Switch view</span>
			</div>
		</div>

		<div class="skill-header-right">
			@* SP pill — shows the player's currently-available skill points as
			   a single gold number. Previously rendered "avail / total" with a
			   progress fill, but that read as "X of Y for THIS tree" rather than
			   "your tamer-wide SP balance" and confused players. Single number
			   now: "⭐ 5 SP" means you have 5 SP to spend. *@
			<div class="skill-pill sp-pill-combined">
				<iconify icon="lucide:star" Size=@(14) Color="#fbbf24" />
				<span class="skill-pill-value-gold">@GetSkillPoints()</span>
				<span class="skill-pill-label-inline">SP</span>
			</div>
			@if (GetTotalRanksUnlocked() > 0)
			{
				@* Inline two-stage confirm. No popup modal — the button itself is
				   the flow. Render-key (`reset-btn-@resetBtnVersion`) remounts the
				   element on each state flip so the armed pulse keyframe replays
				   cleanly. Tuple pattern mirrors ShopPanelContent.GetBuyButtonContent
				   to sidestep the Razor @if/else ghost-child bug (doubled icons on
				   rapid state changes). *@
				@{ var reset = GetResetButtonContent(); }
				<button class="reset-btn @reset.cssClass reset-btn-@resetBtnVersion"
						onclick=@OnResetClicked
						onmouseover=@OnResetHover>
					@* Armed pulse overlay — conditionally mounted so the @keyframes
					   replays fresh on each arm (s&box keyframes only fire on DOM
					   mount, not class toggle). Pointer-events off so clicks still
					   reach the parent button. *@
					@if (resetConfirming)
					{
						<div class="reset-armed-glow"></div>
					}
					<div class="cb-key stree-cap"><span>F</span></div>
					<iconify icon="@reset.icon" Size=@(14) Color="@reset.color" />
					<span>@reset.label</span>
				</button>
			}
		</div>
	</div>

	@* =========================== Branch Clusters Row =========================== *@
	@if (currentTab == "tree")
	{
	<div class="skill-body">
		<div class="clusters-row">
			@foreach (var branch in AllBranches)
			{
				var branchClass = branch.ToString().ToLower();
				var branchPts = GetBranchPointsSpent(branch);
				var branchMax = GetBranchMaxPoints(branch);
				var mastered = branchPts >= branchMax && branchMax > 0;
				var branchNodes = GetBranchNodes(branch);

				<div class="branch-cluster @branchClass @(mastered ? "mastered" : "")">

					@* ---- Branch header ---- *@
					<div class="branch-header @branchClass">
						@* P5 stamp wash — subtle halftone behind the title. Pointer-
						   events off (set in SCSS) so the parent stays clickable.
						   (Corner-cut element was dropped — it rendered as a visible
						   dark square punching through each header's rounded card
						   corner instead of blending.) *@
						<div class="branch-header-halftone"></div>
						<div class="branch-header-title">
							@if (mastered)
							{
								@* On max, the branch icon becomes the crown — clearer than
								   cramming both icons side-by-side, and the gold reads
								   strongly against the warm-dark mastered bg. *@
								<iconify class="branch-header-icon mastered" icon="lucide:crown" Size=@(20) Color="#fbbf24" />
							}
							else
							{
								<iconify class="branch-header-icon" icon="@GetBranchIcon(branch)" Size=@(18) Color="@GetBranchAccent(branch)" />
							}
							<span class="branch-name @(mastered ? "mastered" : "")">@branch.ToString().ToUpper()</span>
						</div>
						@* Partial state (spent > 0 && < max) tints the counter amber —
						   reads as "in progress" between cool-default and mastered-gold. *@
						@{
							var partialBranch = !mastered && branchPts > 0 && branchPts < branchMax;
						}
						<div class="branch-header-pts @(mastered ? "mastered" : "") @(partialBranch ? "partial" : "")">
							<span class="branch-pts-value">@branchPts</span>
							<span class="branch-pts-sep">/</span>
							<span class="branch-pts-max">@branchMax</span>
						</div>
					</div>

					@* ---- Flower canvas ---- *@
					<div class="cluster-canvas">

						@* Connector lines — keystone-bottom-center to each petal-top.
						   Two divs per cluster, anchored at keystone center via the
						   `.left` / `.right` modifier in SCSS. They sit BEHIND the
						   hex bodies via z-index so they read as "the petals plug
						   into the keystone." Brighten to branch color when the
						   downstream petal is unlocked — the bright line signals
						   "energy flows here now." *@
						@{
							// The two petals both list the keystone as their prereq.
							// Resolve "unlocked" once for each so the connector class
							// stays in sync with the visual hex state.
							var leftUnlocked  = branchNodes.Count > 1
								&& (string.IsNullOrEmpty(branchNodes[1].RequiredSkillId)
									|| GetSkillRank(branchNodes[1].RequiredSkillId) >= branchNodes[1].RequiredSkillRank);
							var rightUnlocked = branchNodes.Count > 2
								&& (string.IsNullOrEmpty(branchNodes[2].RequiredSkillId)
									|| GetSkillRank(branchNodes[2].RequiredSkillId) >= branchNodes[2].RequiredSkillRank);
						}
						<div class="hex-connector left @branchClass @(leftUnlocked ? "active" : "")"></div>
						<div class="hex-connector right @branchClass @(rightUnlocked ? "active" : "")"></div>

						@for (int nodeIdx = 0; nodeIdx < branchNodes.Count; nodeIdx++)
						{
							var node = branchNodes[nodeIdx];
							var rank = GetSkillRank(node.Id);
							var isMaxed = rank >= node.MaxRank;
							var canUpgrade = CanUpgradeSkill(node.Id);
							// Node is visually "available" only when its branch-point gate
							// AND its prereq-skill dependency are both satisfied. Launch
							// tree uses prereqs (keystone unlocks petals), no branch gates.
							var tierUnlocked = branchPts >= node.RequiredBranchPoints
								&& (string.IsNullOrEmpty(node.RequiredSkillId)
									|| GetSkillRank(node.RequiredSkillId) >= node.RequiredSkillRank);
							var stateClass = GetNodeStateClass(node, rank, canUpgrade, tierUnlocked);
							var unlockKey = GetUnlockKey(node.Id);
							// First node in the branch list is always the keystone. Marks
							// the start of the chain visually (slightly larger hex + an
							// inner accent ring on the body).
							var isKeystone = nodeIdx == 0;

							<div class="hex-slot @branchClass @stateClass @(tierUnlocked ? "revealed" : "dimmed") @(isKeystone ? "is-keystone" : "") @(IsKbFocused(node) ? "kb-focused" : "")"
								 style="left: @(node.GridX)px; top: @(node.GridY)px;"
								 onclick=@(() => OnNodeClicked(node))
								 onmouseover=@(() => OnNodeHover(node))
								 onmouseout=@OnNodeHoverOut>

								@* Hex body — state class drives visual; unlock pulse is a
								   separate conditionally-mounted overlay so the keyframe
								   fires fresh per invest. *@
								<div class="hex-body @branchClass @stateClass @(isKeystone ? "is-keystone" : "")">
									<iconify class="hex-icon" icon="@GetNodeIcon(node)" Size=@(26) Color="@GetNodeIconColor(node, rank, isMaxed)" />

									@* Locked petal lock-icon overlay — small lucide:lock in
									   the top-right corner. Only on petals (keystones are
									   never gated). Strengthens the "this is gated" read
									   beyond opacity alone. *@
									@if (!tierUnlocked && !isKeystone)
									{
										<div class="hex-lock-corner">
											<iconify icon="lucide:lock" Size=@(10) Color="rgba(255, 255, 255, 0.55)" />
										</div>
									}
								</div>

								@* One-shot unlock pulse overlay — mounted fresh per invest via pulse-N key *@
								@if (unlockKey > 0 && node.Id == lastInvestedId && sinceBurst < 0.6f)
								{
									<div class="hex-unlock-pulse @branchClass pulse-@unlockKey"></div>
								}

								@* Rank badge *@
								@if (rank > 0 || isMaxed)
								{
									<div class="rank-badge @branchClass @(isMaxed ? "maxed" : "")">
										@if (isMaxed)
										{
											<iconify icon="lucide:check" Size=@(10) Color="#ffffff" />
										}
										else
										{
											<span>@rank</span>
										}
									</div>
								}
							</div>
						}
					</div>

				</div>
			}
		</div>
	</div>
	}
	else
	{
		@* =========================== STATS TAB =========================== *@
		var statRows = PlayerStatsSummary.GetAll();
		var activeCount = statRows.Count(r => r.HasContributions);
		var sampleGold = PlayerStatsSummary.GetSampleGoldExample(1000);
		var groupOrder = new[] { StatGroup.Economy, StatGroup.Progression, StatGroup.Expedition, StatGroup.Combat, StatGroup.Boss, StatGroup.Fusion };

		<div class="stats-body">

			@* Top row: worked example slab on the left, eye-toggle hint on
			   the right. Slab sizes to content; hint fills the remaining
			   horizontal space. *@
			<div class="stats-top-row">
				<div class="stats-summary-bar">
					<div class="ssb-halftone"></div>
					<div class="ssb-left">
						<iconify icon="lucide:calculator" Size=@(22) Color="#fbbf24" />
						<div class="ssb-text">
							<span class="ssb-label">SAMPLE EXPEDITION</span>
							<span class="ssb-sub">1,000g base → @($"{sampleGold:N0}")g with current bonuses</span>
						</div>
					</div>
					<div class="ssb-right">
						<span class="ssb-pill-label">ACTIVE</span>
						<span class="ssb-pill-num">@activeCount</span>
						<span class="ssb-pill-sep">/</span>
						<span class="ssb-pill-max">@statRows.Count</span>
					</div>
					@* Eye toggle — hides/reveals the empty "available bonus" rows.
					   Default = hidden (compact). Tap to reveal what you haven't
					   unlocked yet. *@
					<div class="ssb-eye @(showInactiveStats ? "active" : "")"
						 onclick=@ToggleShowInactiveStats
						 onmouseover=@(() => SoundManager.PlayHover())>
						<iconify icon="@(showInactiveStats ? "lucide:eye" : "lucide:eye-off")" Size=@(14) Color="@(showInactiveStats ? "#fbbf24" : "rgba(255, 255, 255, 0.6)")" />
					</div>
				</div>

				@* Hint sits adjacent to the summary slab so the eye reference
				   is right next to the toggle button. *@
				<div class="stats-footer-hint">
					<iconify icon="lucide:info" Size=@(11) Color="rgba(196, 181, 253, 0.55)" />
					<span>@(showInactiveStats ? "Cards without sources show bonuses you haven't unlocked yet. Tap the eye to hide them." : "Tap the eye to reveal every bonus you can still unlock.")</span>
				</div>
			</div>

			@* Card grid — 3-up rows. Direct children of the scroll container
			   are .stats-card-row banners, each holding up to 3 cards. Per
			   CLAUDE.md, s&box can't compute scroll height under flex-wrap,
			   so we chunk into explicit rows server-side. *@
			@{
				var visibleRows = showInactiveStats
					? statRows.OrderBy(r => groupOrder.ToList().IndexOf(r.Group)).ThenBy(r => r.Name).ToList()
					: statRows.Where(r => r.HasContributions)
						.OrderBy(r => groupOrder.ToList().IndexOf(r.Group)).ThenBy(r => r.Name).ToList();
				const int CardsPerRow = 3;
				var cardRows = new List<List<StatRow>>();
				for (int i = 0; i < visibleRows.Count; i += CardsPerRow)
				{
					cardRows.Add(visibleRows.Skip(i).Take(CardsPerRow).ToList());
				}
			}

			<div class="stats-scroll">

				@if (visibleRows.Count == 0)
				{
					<div class="stats-empty-card">
						<iconify icon="lucide:sparkles" Size=@(28) Color="rgba(196, 181, 253, 0.5)" />
						<span class="se-title">No active bonuses yet</span>
						<span class="se-sub">Invest in the skill tree, equip relics, or activate boosts. Tap the eye above to see what's available.</span>
					</div>
				}

				@foreach (var chunk in cardRows)
				{
					<div class="stats-card-row">
						@foreach (var row in chunk)
						{
							var hasAny = row.HasContributions;
							var net = row.NetPercentBonus;
							var sign = net >= 0 ? "+" : "";
							var totalText = hasAny
								? (row.IsFlat ? $"{sign}{net:0.#}" : $"{sign}{net:0.#}%")
								: "—";
							var groupClass = row.Group.ToString().ToLower();

							<div class="stat-card @groupClass @(hasAny ? "active" : "inactive")">
								@* Group tag — small italic-skewed pill at top. *@
								<div class="sc-group" style="background-color: @PlayerStatsSummary.GetGroupColor(row.Group);">
									<span>@PlayerStatsSummary.GetGroupName(row.Group)</span>
								</div>

								<div class="sc-head">
									<div class="sc-icon-wrap @(hasAny ? "" : "inactive")">
										<iconify icon="@row.Icon" Size=@(14) Color="@(hasAny ? "#ffffff" : "rgba(255,255,255,0.35)")" />
									</div>
									<span class="sc-name @(hasAny ? "" : "inactive")">@row.Name</span>
									<div class="sc-total @(hasAny ? "active" : "inactive") @(net < 0 ? "negative" : "")">
										<span class="sc-total-value">@totalText</span>
									</div>
								</div>

								@if (hasAny)
								{
									<div class="sc-sources">
										@foreach (var src in row.Sources)
										{
											var valTxt = src.Op == StatOp.Multiply
												? $"×{src.Value:0.0#}"
												: (row.IsFlat ? $"+{src.Value:0.#}" : $"+{src.Value:0.#}%");
											<div class="sc-src">
												<div class="sc-src-tag" style="background-color: @src.TagColor;">
													<span>@src.Tag</span>
												</div>
												<span class="sc-src-label">@src.Label</span>
												@if (src.TimeRemaining.HasValue)
												{
													<span class="sc-src-timer @(src.TimeRemaining.Value.TotalMinutes < 5 ? "expiring" : "")">@FormatBoostTime(src.TimeRemaining.Value)</span>
												}
												<span class="sc-src-value @(src.Op == StatOp.Multiply ? "multiply" : "add")">@valTxt</span>
											</div>
										}
									</div>
								}
								else
								{
									<div class="sc-empty">
										<span>@row.Description</span>
									</div>
								}
							</div>
						}
						@* Pad short rows so the last row's cards don't blow up
						   to fill the band. *@
						@for (int pad = chunk.Count; pad < CardsPerRow; pad++)
						{
							<div class="stat-card-spacer"></div>
						}
					</div>
				}

			</div>
		</div>
	}

	@* =========================== Tooltip (follows cursor) =========================== *@
	@if (hoveredNode != null)
	{
		var rank = GetSkillRank(hoveredNode.Id);
		var isMaxed = rank >= hoveredNode.MaxRank;
		var canUpgrade = CanUpgradeSkill(hoveredNode.Id);
		// Match the grid's availability check — branch-point gate AND prereq-skill rank.
		var tierUnlocked = GetBranchPointsSpent(hoveredNode.Branch) >= hoveredNode.RequiredBranchPoints
			&& (string.IsNullOrEmpty(hoveredNode.RequiredSkillId)
				|| GetSkillRank(hoveredNode.RequiredSkillId) >= hoveredNode.RequiredSkillRank);
		var nextRank = rank + 1;
		var branchClass = hoveredNode.Branch.ToString().ToLower();
		// Offset slightly from cursor; clamp to keep the tooltip fully on-screen
		// using the panel's own Box bounds.
		float panelW = Box.Rect.Width;
		float panelH = Box.Rect.Height;
		var cursorLeft = Math.Max(16f, Math.Min(panelW - 340f, lastMouseX + 20f));
		var cursorTop = Math.Max(16f, Math.Min(panelH - 280f, lastMouseY + 20f));

		<div class="skill-tooltip @branchClass"
			 style="left: @(cursorLeft)px; top: @(cursorTop)px;">

			<div class="tt-branch-tag @branchClass">@hoveredNode.Branch.ToString().ToUpper()</div>
			<div class="tt-name">@hoveredNode.Name</div>
			<div class="tt-rank-row">
				<span class="tt-rank-label">Rank</span>
				<span class="tt-rank-value">@rank</span>
				<span class="tt-rank-sep">/</span>
				<span class="tt-rank-max">@hoveredNode.MaxRank</span>
				@if (isMaxed)
				{
					<span class="tt-maxed">MAX</span>
				}
			</div>

			<div class="tt-desc">@hoveredNode.Description</div>

			<div class="tt-effect-block">
				@foreach (var effect in hoveredNode.Effects)
				{
					var cur = GetEffectDisplay(hoveredNode, effect, rank);
					var nxt = GetEffectDisplay(hoveredNode, effect, nextRank);
					<div class="tt-effect-row">
						@if (rank > 0)
						{
							<span class="tt-eff-current">@cur</span>
						}
						@if (!isMaxed)
						{
							@if (rank > 0)
							{
								<span class="tt-eff-arrow">→</span>
							}
							<span class="tt-eff-next">@nxt</span>
						}
					</div>
				}
			</div>

			@if (!isMaxed)
			{
				<div class="tt-divider"></div>
				<div class="tt-cost-row">
					<div class="tt-cost">
						<iconify icon="lucide:star" Size=@(12) Color="#fbbf24" />
						<span class="tt-cost-value">@hoveredNode.CostPerRank</span>
						<span class="tt-cost-label">SP</span>
					</div>
					@if (!tierUnlocked)
					{
						<div class="tt-warn">
							<iconify icon="lucide:lock" Size=@(12) Color="#f87171" />
							<span>@hoveredNode.RequiredBranchPoints pts in branch</span>
						</div>
					}
					else if (!string.IsNullOrEmpty(hoveredNode.RequiredSkillId) && GetSkillRank(hoveredNode.RequiredSkillId) < hoveredNode.RequiredSkillRank)
					{
						var reqNode = TamerManager.Instance?.SkillTree?.GetNode(hoveredNode.RequiredSkillId);
						<div class="tt-warn">
							<iconify icon="lucide:lock" Size=@(12) Color="#f87171" />
							<span>Needs @reqNode?.Name rk @hoveredNode.RequiredSkillRank</span>
						</div>
					}
					else if (canUpgrade)
					{
						<div class="tt-hint">
							<iconify icon="lucide:mouse-pointer-click" Size=@(11) Color="#4ade80" />
							<span>Click to invest</span>
						</div>
					}
					else if (GetSkillPoints() < hoveredNode.CostPerRank)
					{
						<div class="tt-warn">
							<iconify icon="lucide:coins" Size=@(12) Color="#f87171" />
							<span>Not enough SP</span>
						</div>
					}
				</div>
			}
		</div>
	}

	@* =========================== Floating particle layer (keystroke-mounted) =========================== *@
	@if (showBurst)
	{
		<div class="unlock-burst-layer burst-@burstVersion" style="left: @(burstX)px; top: @(burstY)px;">
			@for (int i = 0; i < 8; i++)
			{
				<div class="burst-particle p-@i" style="background-color: @burstColor;"></div>
			}
		</div>
	}

	@* Reset confirmation is now inline on the button itself (see the header's
	   `reset-btn`). No modal / backdrop / card markup — the two-stage flow
	   happens in-place so a misclick doesn't trap the player. *@

</div>


@code {
	// =========================================================================
	// State
	// =========================================================================

	// Tab state — "tree" shows the existing flower clusters; "stats" shows
	// the player-wide modifier breakdown. Defaults to tree to preserve the
	// pre-existing landing experience.
	private string currentTab = "tree";
	private string lastTabHover = null; // sound guard (s&box onmouseover fires repeatedly)

	// When false (default), the stats list hides every row that has zero
	// contributions, plus any group with no active rows. Cuts ~80% of
	// vertical space at typical investment levels. Toggle in the summary
	// bar flips it on so the player can see every available bonus channel.
	private bool showInactiveStats = false;
	// Stats subtab refresh tick — boost timers count down live, so we bump a
	// version int every second and feed it into BuildHash.
	private int statsTickVersion = 0;
	private TimeSince sinceStatsTick = 0f;

	private SkillNode hoveredNode;
	private string lastHoveredId = null; // hover-sound guard (s&box onmouseover fires repeatedly)

	// Tooltip position tracking
	private float lastMouseX;
	private float lastMouseY;

	// Unlock keys drive a one-shot flash via CSS animation mounted on a key-changing div.
	// When a rank is invested we bump the key for that node so CSS remounts and plays.
	private Dictionary<string, int> unlockVersions = new();

	// Particle burst state
	private bool showBurst;
	private int burstVersion;
	private float burstX;
	private float burstY;
	private string burstColor = "#ffffff";
	private TimeSince sinceBurst;

	// Tracks which node was most-recently invested so the unlock pulse overlay
	// only mounts on that specific hex (not every hex with unlockKey > 0).
	private string lastInvestedId = null;

	// Reset confirmation — inline two-stage flow on the header button itself.
	// No modal. `resetConfirming` arms the button; `resetConfirmExpires` is a
	// RealTime.Now timestamp at which the armed state auto-reverts if the user
	// doesn't click again. `resetFlashUntil` drives the brief "Reset!" success
	// flash after a confirmed click. `resetBtnVersion` is a render-key that
	// remounts the button element each state flip so the armed pulse @keyframes
	// replays cleanly (s&box only plays keyframes on first mount).
	private bool resetConfirming;
	private float resetConfirmExpires = 0f;
	private float resetFlashUntil = 0f;
	private int resetBtnVersion = 0;
	// Set in OnResetClicked so the bubbling panel-level click handler (which
	// runs AFTER the button's own handler) doesn't immediately disarm the
	// state we just entered. RealTime.Now timestamp — grace window ~0.1s.
	private float resetClickGuardUntil = 0f;
	private string lastResetHoverState = null;

	private bool IsResetFlashing => RealTime.Now < resetFlashUntil;
	private const float ResetConfirmWindow = 3.0f;
	private const float ResetFlashDuration = 0.9f;

	private SkillBranch[] AllBranches = new[]
	{
		SkillBranch.Power,
		SkillBranch.Fortune,
		SkillBranch.Fusion,
		SkillBranch.Expedition,
		SkillBranch.Mastery
	};

	// =========================================================================
	// Localization
	// =========================================================================
	private string L(string key) => LocalizationManager.Get(key);
	private string L(string key, params object[] args) => LocalizationManager.Get(key, args);

	// =========================================================================
	// Lifecycle
	// =========================================================================
	protected override void OnAfterTreeRender(bool firstTime)
	{
		if (firstTime)
		{
			AcceptsFocus = true;
		}
	}

	public override void Tick()
	{
		base.Tick();

		// Auto-hide burst after ~0.9s so the layer can remount on next click.
		if (showBurst && sinceBurst > 0.9f)
		{
			showBurst = false;
		}

		// Auto-revert the armed reset button if the user doesn't confirm
		// within the confirm window. Silent — no sound on timeout (user didn't
		// act, so playing a "back" cue would be noise).
		if (resetConfirming && RealTime.Now > resetConfirmExpires)
		{
			resetConfirming = false;
			resetBtnVersion++;
		}

		// Stats tab needs a 1Hz heartbeat so boost-timer text updates in
		// real time. Only relevant on the stats tab — skip otherwise.
		if (currentTab == "stats" && sinceStatsTick > 1.0f)
		{
			statsTickVersion++;
			sinceStatsTick = 0f;
		}
	}

	// =========================================================================
	// Keyboard navigation
	// =========================================================================
	// TREE tab: a spatial cursor over the hex graph. The 5 branch clusters lay
	// their nodes out as absolutely-positioned flowers, so there's no grid math
	// to lean on — we read the rendered .hex-slot screen rects and pick the
	// best node in the pressed direction (primary-axis distance + a perpendicular
	// penalty). The focused node drives the same tooltip the mouse hover uses.
	// STATS tab: W/S scroll the card list, Space toggles the inactive-rows eye.
	// Tab toggles the two sub-tabs; F fires the header reset button.
	private int _kbNodeIndex = 0;
	private bool _kbActive = false;

	public void TickInput()
	{
		// Tab — swap TREE / STATS sub-tab.
		if (Input.Pressed("Score"))
		{
			SetTab(currentTab == "tree" ? "stats" : "tree");
			return;
		}

		// F — header reset button (its own two-stage confirm guards it). No-op
		// when the button isn't shown (0 ranks): OnResetClicked early-returns.
		if (Input.Pressed("Flashlight"))
		{
			OnResetClicked();
			return;
		}

		if (currentTab == "tree")
			TickTreeInput();
		else
			TickStatsInput();
	}

	private void TickTreeInput()
	{
		var nodes = GetAllNodesFlat();
		if (nodes.Count == 0) return;
		ClampKbIndex(nodes.Count);

		// Space / Enter — invest in the focused node.
		if (Input.Pressed("Jump") || Input.Pressed("Enter"))
		{
			_kbActive = true;
			var investRects = CollectHexRects();
			if (investRects.Count == nodes.Count)
				SyncKbCursor(nodes, investRects);
			OnNodeClicked(nodes[_kbNodeIndex]);
			return;
		}

		int dir = -1; // 0 up · 1 down · 2 left · 3 right
		if (Input.Pressed("Up")) dir = 0;
		else if (Input.Pressed("Down")) dir = 1;
		else if (Input.Pressed("Left")) dir = 2;
		else if (Input.Pressed("Right")) dir = 3;
		if (dir < 0) return;

		var rects = CollectHexRects();

		// First nav keypress just lights the cursor — engage on the node the
		// mouse last hovered if there is one, otherwise the saved index.
		if (!_kbActive)
		{
			_kbActive = true;
			if (hoveredNode != null)
			{
				int hi = nodes.FindIndex(n => n.Id == hoveredNode.Id);
				if (hi >= 0) _kbNodeIndex = hi;
			}
			if (rects.Count == nodes.Count) SyncKbCursor(nodes, rects);
			SoundManager.PlayHover();
			return;
		}

		if (rects.Count != nodes.Count) return; // layout not ready this frame

		int next = FindNeighbor(_kbNodeIndex, dir, rects);
		if (next >= 0 && next != _kbNodeIndex)
		{
			_kbNodeIndex = next;
			SyncKbCursor(nodes, rects);
			SoundManager.PlayHover();
		}
	}

	private void TickStatsInput()
	{
		// Space / Enter toggles the "show every available bonus" eye.
		if (Input.Pressed("Jump") || Input.Pressed("Enter"))
		{
			ToggleShowInactiveStats();
			return;
		}
		// W / S scroll the card list (held = continuous).
		var scroll = FindByClass(this, "stats-scroll");
		if (scroll == null) return;
		float step = 0f;
		if (Input.Down("Down")) step = 14f;
		else if (Input.Down("Up")) step = -14f;
		if (step != 0f)
		{
			float y = Math.Max(0f, scroll.ScrollOffset.y + step);
			scroll.ScrollOffset = new Vector2(scroll.ScrollOffset.x, y);
		}
	}

	// Focused node → drive the shared tooltip + park the cursor coords on the
	// node so the tooltip (and any invest burst) lands on it, not a stale mouse
	// spot. Box.Rect is screen-space; subtract the panel origin for panel-local.
	private void SyncKbCursor(List<SkillNode> nodes, List<Rect> rects)
	{
		if (_kbNodeIndex < 0 || _kbNodeIndex >= nodes.Count) return;
		hoveredNode = nodes[_kbNodeIndex];
		lastHoveredId = hoveredNode.Id;
		if (_kbNodeIndex < rects.Count)
		{
			var c = rects[_kbNodeIndex].Center;
			lastMouseX = c.x - Box.Rect.Left;
			lastMouseY = c.y - Box.Rect.Top;
		}
	}

	private void ClampKbIndex(int count)
	{
		if (count <= 0) { _kbNodeIndex = 0; return; }
		_kbNodeIndex = Math.Clamp(_kbNodeIndex, 0, count - 1);
	}

	// Flat node list in render order: AllBranches × GetBranchNodes. MUST stay in
	// sync with the .hex-slot DOM order so CollectHexRects indexes line up.
	private List<SkillNode> GetAllNodesFlat()
	{
		var list = new List<SkillNode>();
		foreach (var b in AllBranches)
			list.AddRange(GetBranchNodes(b));
		return list;
	}

	private bool IsKbFocused(SkillNode node)
	{
		if (!_kbActive || currentTab != "tree" || node == null) return false;
		var nodes = GetAllNodesFlat();
		return _kbNodeIndex >= 0 && _kbNodeIndex < nodes.Count
			&& nodes[_kbNodeIndex].Id == node.Id;
	}

	// Depth-first collect of every rendered .hex-slot's screen rect. DOM order
	// matches GetAllNodesFlat() (clusters in AllBranches order, nodes in list
	// order), so the result is index-parallel to it.
	private List<Rect> CollectHexRects()
	{
		var panels = new List<Panel>();
		CollectByClass(this, "hex-slot", panels);
		return panels.Select(p => p.Box.Rect).ToList();
	}

	private void CollectByClass(Panel root, string cls, List<Panel> outList)
	{
		foreach (var c in root.Children)
		{
			if (c.HasClass(cls)) outList.Add(c);
			else CollectByClass(c, cls, outList);
		}
	}

	private Panel FindByClass(Panel root, string cls)
	{
		foreach (var c in root.Children)
		{
			if (c.HasClass(cls)) return c;
			var found = FindByClass(c, cls);
			if (found != null) return found;
		}
		return null;
	}

	// Pick the nearest node in direction `dir` from `from`. Score = distance
	// along the press axis + 2.5× the perpendicular offset, so a roughly-aligned
	// node always beats a closer-but-sideways one. Returns -1 when nothing lies
	// in that direction (e.g. Up from a top-row keystone).
	private int FindNeighbor(int from, int dir, List<Rect> rects)
	{
		if (from < 0 || from >= rects.Count) return -1;
		float cx = rects[from].Center.x;
		float cy = rects[from].Center.y;
		int best = -1;
		float bestScore = float.MaxValue;
		for (int i = 0; i < rects.Count; i++)
		{
			if (i == from) continue;
			float dx = rects[i].Center.x - cx;
			float dy = rects[i].Center.y - cy;
			float primary, perp;
			switch (dir)
			{
				case 0:  if (dy > -4f) continue; primary = -dy; perp = Math.Abs(dx); break;
				case 1:  if (dy <  4f) continue; primary =  dy; perp = Math.Abs(dx); break;
				case 2:  if (dx > -4f) continue; primary = -dx; perp = Math.Abs(dy); break;
				default: if (dx <  4f) continue; primary =  dx; perp = Math.Abs(dy); break;
			}
			float score = primary + perp * 2.5f;
			if (score < bestScore) { bestScore = score; best = i; }
		}
		return best;
	}

	// =========================================================================
	// Event handlers
	// =========================================================================
	private void OnPanelClicked()
	{
		GameHUD.EnterPanel();

		// Click-elsewhere cancels the armed reset. The reset button's onclick
		// runs first and sets `resetClickGuardUntil` to block this immediate
		// bubble — so this path only fires for genuine "click outside the
		// button" inputs, the intended escape hatch.
		if (resetConfirming && RealTime.Now > resetClickGuardUntil)
		{
			resetConfirming = false;
			resetBtnVersion++;
		}
	}

	private void OnPanelMouseMove()
	{
		// Track cursor for tooltip positioning. MousePosition is already in
		// panel-local coordinates on s&box Panels.
		lastMouseX = MousePosition.x;
		lastMouseY = MousePosition.y;
	}

	private void OnNodeHover(SkillNode node)
	{
		if (node == null) return;
		if (lastHoveredId == node.Id) return; // guard repeat-fire
		lastHoveredId = node.Id;
		hoveredNode = node;
		// Mouse took over — drop the keyboard cursor so the gold focus ring and
		// the CSS :hover ring never show on two different nodes at once. The
		// next WASD press re-engages it.
		_kbActive = false;

		// Locked petals (prereq unmet) get a soft deny cue instead of the
		// standard hover ping — communicates "this is gated" without
		// forcing the player to read the tooltip. Same prereq-resolution
		// logic the visual `tierUnlocked` flag uses.
		bool tierUnlocked = GetBranchPointsSpent(node.Branch) >= node.RequiredBranchPoints
			&& (string.IsNullOrEmpty(node.RequiredSkillId)
				|| GetSkillRank(node.RequiredSkillId) >= node.RequiredSkillRank);
		if (!tierUnlocked)
		{
			SoundManager.PlayDeny();
		}
		else
		{
			SoundManager.PlayHover();
		}
	}

	private void OnNodeHoverOut()
	{
		lastHoveredId = null;
		hoveredNode = null;
	}

	private void OnNodeClicked(SkillNode node)
	{
		if (node == null) return;

		var tamer = TamerManager.Instance;
		if (tamer == null) return;

		// Attempt the unlock. The manager owns the eligibility logic.
		bool ok = tamer.CanUnlockSkill(node.Id);

		if (!ok)
		{
			// Denied — soft feedback (no shake for now; would need per-node version for CSS trigger).
			SoundManager.PlayDeny();
			return;
		}

		int prevRank = tamer.GetSkillRank(node.Id);
		bool success = tamer.UnlockSkill(node.Id);
		if (!success) { SoundManager.PlayDeny(); return; }

		int newRank = tamer.GetSkillRank(node.Id);
		var newNode = tamer.SkillTree?.GetNode(node.Id);
		bool justMaxed = newNode != null && newRank >= newNode.MaxRank;
		bool isCapstoneSetpiece = justMaxed && node.Tier == 3;

		// Bump the unlock version → CSS keyframe remounts + replays.
		if (!unlockVersions.ContainsKey(node.Id)) unlockVersions[node.Id] = 0;
		unlockVersions[node.Id]++;
		lastInvestedId = node.Id;

		// Trigger particle burst at cursor (local coords) with branch color.
		burstVersion++;
		burstX = lastMouseX;
		burstY = lastMouseY;
		burstColor = GetBranchAccent(node.Branch);
		showBurst = true;
		sinceBurst = 0f;

		// Sound — tiered based on what just happened.
		if (isCapstoneSetpiece)
		{
			SoundManager.PlaySuccess();
			SoundManager.PlayGoldReward();
		}
		else if (justMaxed)
		{
			SoundManager.PlaySuccess();
		}
		else
		{
			SoundManager.PlayForward();
		}
	}

	// Inline two-stage reset. First click arms; second click (within the
	// confirm window) fires; click-elsewhere or timeout reverts silently.
	private void OnResetClicked()
	{
		if (GetTotalRanksUnlocked() <= 0) return;

		// Block the bubbling panel-level click from immediately disarming.
		// Keep the window short — just enough for the same frame's bubble.
		resetClickGuardUntil = RealTime.Now + 0.1f;

		// Already flashing "Reset!" — ignore extra clicks during the payoff
		// so the player can't accidentally re-arm before the flash finishes.
		if (IsResetFlashing) return;

		if (!resetConfirming)
		{
			// Stage 1: arm. Small click cue — feels deliberate.
			resetConfirming = true;
			resetConfirmExpires = RealTime.Now + ResetConfirmWindow;
			resetBtnVersion++; // remount so the armed pulse keyframe plays
			SoundManager.PlayClick();
		}
		else
		{
			// Stage 2: confirm + fire. Destructive action — use PlayBack so
			// the audio colors "undoing progress" distinctly from the normal
			// success cue (that'd read as if something was gained).
			var tm = TamerManager.Instance;
			if (tm == null)
			{
				resetConfirming = false;
				resetBtnVersion++;
				return;
			}

			int refunded = tm.ResetSkillTree();
			unlockVersions.Clear();
			lastInvestedId = null;
			hoveredNode = null;

			resetConfirming = false;
			resetFlashUntil = RealTime.Now + ResetFlashDuration;
			resetBtnVersion++;

			SoundManager.PlayBack();
			Log.Info($"[SkillTree] Inline reset confirmed — refunded {refunded} SP");
		}
	}

	private void OnResetHover()
	{
		if (lastResetHoverState == "reset") return;
		lastResetHoverState = "reset";
		SoundManager.PlayHover();
	}

	// =========================================================================
	// Stats subtab — tab switching + helpers
	// =========================================================================
	private void SetTab(string tab)
	{
		if (currentTab == tab) return;
		currentTab = tab;
		// Clear any tree-specific transient state so it doesn't bleed into
		// the stats view (or vice-versa when switching back).
		hoveredNode = null;
		lastHoveredId = null;
		showBurst = false;
		// Nudge timer baseline so the first second on stats tab is fresh.
		sinceStatsTick = 0f;
		SoundManager.PlayTabSwitch();
	}

	private void OnTabHover(string tab)
	{
		if (lastTabHover == tab) return;
		lastTabHover = tab;
		SoundManager.PlayHover();
	}

	private void ToggleShowInactiveStats()
	{
		showInactiveStats = !showInactiveStats;
		SoundManager.PlayClick();
	}

	private int GetActiveStatCount()
	{
		// Cheap call — read once per frame is fine. The list build itself is
		// O(skills + relics + boosts) which is small.
		return PlayerStatsSummary.CountActiveRows();
	}

	private string FormatBoostTime(TimeSpan ts)
	{
		if (ts.TotalSeconds <= 0) return "0:00";
		if (ts.TotalHours >= 1) return $"{(int)ts.TotalHours}:{ts.Minutes:D2}:{ts.Seconds:D2}";
		return $"{ts.Minutes:D1}:{ts.Seconds:D2}";
	}

	// Tuple-render helper. Mirrors ShopPanelContent.GetBuyButtonContent — keeps
	// the Razor button body a single <iconify> + single <span> so s&box only
	// swaps attribute values (no ghost-child bug on rapid state changes).
	private (string icon, string label, string color, string cssClass) GetResetButtonContent()
	{
		if (IsResetFlashing)
			return ("lucide:check", "Reset!", "#ffffff", "flashing");

		if (resetConfirming)
			return ("lucide:alert-triangle", "Click again to confirm", "#fbbf24", "armed");

		return ("lucide:rotate-ccw", "Reset", "#f87171", "");
	}

	// =========================================================================
	// Data helpers
	// =========================================================================
	private int GetSkillPoints() => TamerManager.Instance?.CurrentTamer?.SkillPoints ?? 0;
	private int GetTotalSkillPointsSpent() => TamerManager.Instance?.GetTotalSkillPointsSpent() ?? 0;
	private int GetTotalRanksUnlocked() => TamerManager.Instance?.GetTotalRanksUnlocked() ?? 0;

	private int GetBranchPointsSpent(SkillBranch branch)
	{
		var tamer = TamerManager.Instance;
		if (tamer?.SkillTree == null || tamer?.CurrentTamer == null) return 0;
		return tamer.SkillTree.GetPointsSpentInBranch(branch, tamer.CurrentTamer.SkillRanks);
	}

	private int GetBranchMaxPoints(SkillBranch branch)
	{
		return GetBranchNodes(branch).Sum(n => n.MaxRank * n.CostPerRank);
	}

	private List<SkillNode> GetBranchNodes(SkillBranch branch)
	{
		return TamerManager.Instance?.SkillTree?.GetNodesByBranch(branch) ?? new();
	}

	private int GetSkillRank(string skillId) => TamerManager.Instance?.GetSkillRank(skillId) ?? 0;
	private bool CanUpgradeSkill(string skillId) => TamerManager.Instance?.CanUnlockSkill(skillId) ?? false;

	private int GetUnlockKey(string id)
	{
		return unlockVersions.TryGetValue(id, out var v) ? v : 0;
	}

	// =========================================================================
	// Node state → CSS class
	// =========================================================================
	private string GetNodeStateClass(SkillNode node, int rank, bool canUpgrade, bool tierUnlocked)
	{
		if (rank >= node.MaxRank) return "maxed";
		if (!tierUnlocked) return "gated";
		if (canUpgrade) return "available";
		if (rank > 0) return "partial";
		return "locked";
	}

	private string GetNodeIconColor(SkillNode node, int rank, bool isMaxed)
	{
		if (isMaxed) return "#0c0a18"; // dark icon on warm filled hex
		if (rank > 0) return "#ffffff";
		return "rgba(255, 255, 255, 0.75)";
	}

