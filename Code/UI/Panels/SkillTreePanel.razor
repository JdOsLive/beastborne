	// =========================================================================
	// Effect display (tooltip text)
	// =========================================================================
	private string GetEffectDisplay(SkillNode node, SkillEffect effect, int rank)
	{
		// Pathfinder is special: rank 1 = speed, rank 2 = slot — non-scaling.
		if (node.Id == "exp_pathfinder")
		{
			if (rank <= 0) return "Locked";
			if (rank == 1) return "−10% expedition time";
			if (rank >= 2) return "+1 expedition slot";
		}

		if (rank <= 0) return "Locked";

		// For normal scaling effects: show cumulative at this rank.
		float total = effect.Value * rank;
		string sign = total >= 0 ? "+" : "";
		string suffix = GetEffectSuffix(effect);
		string label = GetEffectLabel(effect);

		return $"{sign}{total:0.#}{suffix} {label}";
	}

	private string GetEffectSuffix(SkillEffect effect)
	{
		return effect.Type switch
		{
			SkillEffectType.GeneBonusFlat => "",
			SkillEffectType.TeamSizeBonus => "",
			SkillEffectType.GeneLock => "",
			_ => "%"
		};
	}

