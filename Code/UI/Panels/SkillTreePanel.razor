	// =========================================================================
	// Effect display (the delta band)
	// =========================================================================
	// Benefits that REDUCE a number (shop prices, boss damage taken) carry a
	// leading hyphen-minus so a discount never reads as a penalty
	// ("-3% shop prices", not "+3% shop prices"). ASCII hyphen on purpose —
	// U+2212 is absent from the Exo2 cmap.
	private static bool IsReductionEffect(SkillEffectType type)
	{
		return type == SkillEffectType.ShopDiscount
			|| type == SkillEffectType.BossDamageReduction;
	}

	// Signed value only ("+5%", "-3%", "+1") — the unit lives on its own line.
	private string GetEffectValue(SkillEffect effect, int rank)
	{
		float total = effect.Value * Math.Max(rank, 0);
		string sign = IsReductionEffect(effect.Type) ? "-" : (total >= 0 ? "+" : "");
		return $"{sign}{total:0.#}{GetEffectSuffix(effect)}";
	}

	// Unit line under the values: the effect label, plus the per-rank cost
	// when it isn't the default 1 (the CTA already says "INVEST · 1 SP").
	private string GetUnitLine(SkillNode node, SkillEffect effect)
	{
		var label = GetEffectLabel(effect).ToUpperInvariant();
		if (node.CostPerRank > 1)
			label += $" · {node.CostPerRank} SP PER RANK";
		return label;
	}

	private string GetEffectSuffix(SkillEffect effect)
	{
		return effect.Type switch
		{
			SkillEffectType.GeneBonusFlat => "",
			_ => "%"
		};
	}

	// Launch-tree effect types only (the 17 arms for unshipped effects were
	// dead code — add an arm when a node ships with a new type).
	private string GetEffectLabel(SkillEffect effect)
	{
		return effect.Type switch
		{
			SkillEffectType.AllMonsterATKPercent => "ATK · all beasts",
			SkillEffectType.AllMonsterHPPercent => "HP · all beasts",
			SkillEffectType.CritChanceBonus => "crit chance",
			SkillEffectType.GoldDropBonus => "gold drops",
			SkillEffectType.ShopDiscount => "shop prices",
			SkillEffectType.DoubleDropChance => "double-drop chance",
			SkillEffectType.GeneBonusFlat => "bonus gene point",
			SkillEffectType.GeneticInheritanceBonus => "gene inheritance",
			SkillEffectType.MutationChance => "mutation chance",
			SkillEffectType.ExpeditionGoldBonus => "expedition gold",
			SkillEffectType.EncounterRateBonus => "encounter rate",
			SkillEffectType.RareItemChance => "rare item chance",
			SkillEffectType.BossDamageBonus => "damage vs bosses",
			SkillEffectType.BossDamageReduction => "boss damage taken",
			SkillEffectType.BossTokenBonus => "boss tokens",
			_ => ""
		};
	}

	// =========================================================================
	// BuildHash — every piece of state that affects rendering
	// =========================================================================
	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add(lastInputDevice);
		hash.Add(cursorZone);
		hash.Add(cursorNodeIndex);
		hash.Add(GetSkillPoints());
		hash.Add(GetTamerLevel());
		hash.Add(GetTotalRanksUnlocked());
		hash.Add(hoveredNode?.Id);
		hash.Add(IsResetFlashing);
		// Hold-to-reset costume hooks (.holding/.h25/.h50/.h75/.committed/
		// .cancelled) are markup classes — the hash must tick with them.
		hash.Add(ResetStateClasses);
		// MOTION render-key classes — they must EXPIRE in the hash too, or
		// the beat class never drops and the next beat has no fresh mount.
		hash.Add(SpBeatClass);
		hash.Add(InvestDenyClass);
		hash.Add(showBurst);
		hash.Add(burstVersion);
		hash.Add(lastInvestedId);
		// Tick the hash while the ripple overlay is visible so it unmounts.
		hash.Add(showBurst && sinceBurst < 0.6f);
		// Per-node ranks — pips, spine, mastered pillars and the rail all
		// key off these.
		foreach (var n in GetAllNodesFlat())
		{
			hash.Add(GetSkillRank(n.Id));
		}
		// Per-node unlock versions — the ripple triggers on new invests.
		foreach (var kv in unlockVersions)
		{
			hash.Add(kv.Key);
			hash.Add(kv.Value);
		}
		return hash.ToHashCode();
	}
}
