@namespace Beastborne.UI.Panels
@using Sandbox;
@using Sandbox.UI;
@using Beastborne.Core;
@using Beastborne.Data;
@using Beastborne.Systems;
@using Beastborne.UI;
@using Beastborne.UI.Primitives;
@using System.Linq;
@inherits Panel

@*
	SKILLS — the Tamer's page (2026-09-01 pipeline rebuild, LAYOUT lane).

	Brief: .claude/design-system/components/skills-redesign-brief.html +
	skills-mock-page.html (user-ruled 2026-09-01). ONE view: five branch
	pillars beside a single reading rail. The STATS view, the TREE/STATS
	sub-band, the key legend, pillar footers, BRANCH TOTALS, the inspector
	branch chip + RANK numerals, the "Ready"/"Not enough" lines, the
	click-twice reset, the burst glow and every corner cut are CUT.

	Accent: APP PINK #ff6bd6 (DOC-2 #1 — a page wears its PawPad tile).
	Gold = INVEST primary + SP hero numeral + the mastered pillar only.
	Violet = the living ring only. No per-branch rainbow.

	ZONE MAP (1920×1080, PADDING-BOX math — declared size includes padding,
	borders add on top):
	  header  1920×108 + 2px strip = 110   (pad 24/40/24/40; kicker 14+2 +
	                                        title 44 = 60 tall)
	  body    pad 20/40/20/40 → 874 tall (GameHUD keeps a 56px ::after
	          reserve for the PawPad launcher chip bottom-right)
	  pillars 268×834 ×5, gap 20 → x 40 · 328 · 616 · 904 · 1192
	  gap     48
	  rail    372×834 at x 1508
	  check   40 + 1420 + 48 + 372 + 40 = 1920
	Pillar interior: pad 24/22 · chip row 26 · path 224×784: gap 40 ·
	node 128 (y 90) · pips 6 (+12) · name 20 (+8) · gap 99 · node (y 363)
	· gap 99 · node (y 636) · 24 breathing → 24 + 26 + 784 = 834. ONE 6px
	spine from keystone centre (y 154) to petal-2 centre (y 700), lit at
	keystone rank ≥ 1 (both petals need exactly that — SkillTree.cs).
	Rail interior 324: tile 96 + head col · name 30/34 · lore 15/22 · delta
	band 324×112 r11 · one locked line · INVEST 324×64 r16 · then, ABSOLUTE
	at the foot: ghost glyph 160 (bottom 84) · RESET 324×44 r11 (bottom 24).

	ONE-CURSOR MODEL (roster contract): mouse hover and WASD drive the
	SAME living ring; nodes carry no separate :hover styling.

	ENGINE LAWS honored: no AcceptsFocus (kills Input.Pressed game-wide);
	pointer-events only all/none, set via a CLASS on every child of a
	pressable; percent-hold keyframes only (no animation-delay); hold fill
	is measured px per tick; bare text always in spans; explicit widths on
	every flex card; no width:100% inside padded parents.
*@

<div class="@RootClass" onclick=@OnPanelClicked onmousemove=@OnPanelMouseMove>

	@* Living background: the skills glyph drifting at the house angle
	   (BbIconScroll supplies the opaque dark base — root paints none). *@
	<BbIconScroll Icon="skills" />

	@* ====================== HEADER — house wave anatomy ====================== *@
	<div class="sk-header">
		<BbHeaderWaves Accent=@("appink") />
		<div class="sk-identity">
			<span class="sk-kicker">@KickerText</span>
			<div class="sk-title-row">
				<span class="sk-title">@TitleText</span>
				<div class="sk-seam"></div>
				<div class="sk-seam dim"></div>
			</div>
		</div>
		<div class="sk-head-spacer"></div>
		@* SP hero — label + gold numeral (the "SP" unit is CUT; it survives
		   only inside the CTA copy). *@
		<div class="sp-hero">
			<span class="sp-hero-label">SKILL POINTS</span>
			<div class="sp-hero-row">
				<iconify class="sp-hero-star" icon="lucide:star" Size=@(24) Color="#fbbf24" />
				@* MOTION: sp-dip / sp-pop + a version key — each beat is a fresh mount. *@
				<span class="@("sp-hero-value" + SpBeatClass)">@GetSkillPoints()</span>
			</div>
		</div>
	</div>

	@* ====================== BODY — five pillars + the rail ====================== *@
	<div class="sk-body">
		<div class="sk-tree-zone">
			@for (int ci = 0; ci < AllBranches.Length; ci++)
			{
				var branch = AllBranches[ci];
				var branchNodes = GetBranchNodes(branch);
				var mastered = branchNodes.Count > 0 && branchNodes.All(n => GetSkillRank(n.Id) >= n.MaxRank);
				var keystone = branchNodes.FirstOrDefault(n => string.IsNullOrEmpty(n.RequiredSkillId)) ?? branchNodes.FirstOrDefault();
				var spineLit = keystone != null && GetSkillRank(keystone.Id) >= 1;
				var clusterClass = "sk-cluster sk-col-" + (ci + 1) + (mastered ? " mastered" : "");
				var chipClass = "sk-branch-chip" + (mastered ? " gold" : "");
				var chipIcon = mastered ? "lucide:crown" : GetBranchIcon(branch);
				var chipInk = mastered ? "#241A00" : "#3a0a22";
				// MOTION: .wipe for 0.6s when THIS keystone just reached rank 1 (the
				// ripple's own gate) — the spine grows downward from it (skSpineWipe).
				var spineWipe = spineLit && !mastered && keystone.Id == lastInvestedId
					&& GetSkillRank(keystone.Id) == 1 && sinceBurst < 0.6f;
				var spineClass = "sk-spine" + (mastered ? " gold" : (spineLit ? " lit" : "")) + (spineWipe ? " wipe" : "");

				<div class="@clusterClass">

					@* ---- Branch identity: skewed chip (identity mark) + hairline ---- *@
					<div class="sk-branch-row">
						<div class="@chipClass">
							<div class="sk-branch-chip-inner">
								<iconify class="sk-chip-glyph" icon="@chipIcon" Size=@(14) Color="@chipInk" />
								<span class="sk-branch-name">@branch.ToString().ToUpper()</span>
							</div>
						</div>
						<div class="sk-branch-line"></div>
					</div>

					@* ---- The path: ONE spine behind keystone + two petals ---- *@
					<div class="sk-path">
						<div class="@spineClass"></div>
						<div class="sk-gap top"></div>
						@for (int nodeIdx = 0; nodeIdx < branchNodes.Count; nodeIdx++)
						{
							var node = branchNodes[nodeIdx];
							var rank = GetSkillRank(node.Id);
							var unlocked = IsPrereqOk(node);
							var stateClass = GetNodeStateClass(rank, unlocked);
							var focused = IsKbFocused(node);
							var unlockKey = GetUnlockKey(node.Id);
							var slotClass = "hex-slot " + stateClass + (focused ? " kb-focused" : "");
							var nameClass = "sk-node-name" + (rank > 0 ? " on" : "") + (stateClass == "gated" ? " ghost" : "");

							if (nodeIdx > 0)
							{
								<div class="sk-gap"></div>
							}

							<div class="sk-node-group">
								<div class="@slotClass"
									 onclick=@(() => OnNodeClicked(node))
									 onmouseover=@(() => OnNodeHover(node))
									 onmouseout=@OnNodeHoverOut>

									<iconify class="hex-icon" icon="@GetNodeIcon(node)" Size=@(48) Color="@GetNodeIconColor(rank, stateClass, focused || IsMouseLit(node))" />

									@if (stateClass == "gated")
									{
										<div class="hex-lock-corner">
											<iconify class="hex-lock-glyph" icon="lucide:lock" Size=@(13) Color="rgba(244, 241, 234, 0.55)" />
										</div>
									}

									@* One-shot invest ripple — mounted fresh per invest. LANE: motion *@
									@if (unlockKey > 0 && node.Id == lastInvestedId && sinceBurst < 0.6f)
									{
										<div class="@("hex-unlock-pulse pulse-" + unlockKey)"></div>
									}
								</div>

								<div class="sk-node-pips">
									@for (int r = 0; r < node.MaxRank; r++)
									{
										@* MOTION: .pip-new on the pip that just lit (same 0.6s gate as the ripple). *@
										var pipNew = r == rank - 1 && node.Id == lastInvestedId && sinceBurst < 0.6f;
										<div class="@("sk-node-pip" + (r < rank ? " on" : "") + (pipNew ? " pip-new" : ""))"></div>
									}
								</div>
								<span class="@nameClass">@node.Name.ToUpper()</span>
							</div>
						}
					</div>
				</div>
			}
		</div>

		@* ====================== THE READING RAIL ====================== *@
		@{
			bool inspSuggested;
			var insp = GetInspectedNode(out inspSuggested);
		}
		<div class="sk-rail">
			@if (insp != null)
			{
				var iRank = GetSkillRank(insp.Id);
				var iMaxed = iRank >= insp.MaxRank;
				var iPrereqOk = IsPrereqOk(insp);
				var iNextRank = iRank + 1;
				var invest = GetInvestButtonContent(insp);
				var showCurrent = iRank > 0;
				var showNext = !iMaxed;
				var deltaWord = iMaxed ? "EFFECT" : (iRank > 0 ? "CURRENT" : "NEXT RANK");
				var pipsClass = "insp-pips" + (iMaxed ? " maxed" : "");

				@* ---- Head: 96 tile · NEXT UP tag · pips + MAX ---- *@
				<div class="insp-head">
					<div class="insp-tile">
						<iconify class="insp-tile-glyph" icon="@GetNodeIcon(insp)" Size=@(48) Color="#f4f1ea" />
					</div>
					<div class="insp-head-col">
						@if (inspSuggested)
						{
							<div class="insp-next-tag"><span>NEXT UP</span></div>
						}
						<div class="insp-pips-row">
							<div class="@pipsClass">
								@for (int r = 0; r < insp.MaxRank; r++)
								{
									var railPipNew = r == iRank - 1 && insp.Id == lastInvestedId && sinceBurst < 0.6f;
									<div class="@("insp-pip" + (r < iRank ? " on" : "") + (railPipNew ? " pip-new" : ""))"></div>
								}
							</div>
							@if (iMaxed)
							{
								<BbStamp Text="MAX" Tone="gold" Tilt=@(3) Class="insp-max-stamp" />
							}
						</div>
					</div>
				</div>

				<span class="insp-name">@insp.Name</span>
				<span class="insp-lore">@insp.Description</span>

				@* ---- Delta band: the fact (CURRENT → NEXT, lucide arrow) ---- *@
				<div class="insp-delta">
					<div class="insp-delta-label">
						<span class="insp-delta-word">@deltaWord</span>
						@if (showCurrent && showNext)
						{
							<iconify class="insp-delta-arrow-sm" icon="lucide:arrow-right" Size=@(12) Color="rgba(214, 206, 236, 0.5)" />
							<span class="insp-delta-word">NEXT</span>
						}
					</div>
					@foreach (var effect in insp.Effects)
					{
						<div class="insp-delta-values">
							@if (showCurrent)
							{
								<span class="insp-val-cur">@GetEffectValue(effect, iRank)</span>
							}
							@if (showCurrent && showNext)
							{
								<iconify class="insp-delta-arrow" icon="lucide:arrow-right" Size=@(18) Color="rgba(244, 241, 234, 0.5)" />
							}
							@if (showNext)
							{
								@* MOTION: vk-N render key (N = the read rank) — the 120ms swap fade remounts when it changes. *@
								<span class="@("insp-val-next vk-" + iRank)">@GetEffectValue(effect, iNextRank)</span>
							}
						</div>
						<span class="insp-delta-unit">@GetUnitLine(insp, effect)</span>
					}
				</div>

				@* ---- The ONE status line: only when locked ---- *@
				@if (!iMaxed && !iPrereqOk)
				{
					<div class="insp-lock">
						<iconify class="insp-lock-glyph" icon="lucide:lock" Size=@(14) Color="rgba(214, 206, 236, 0.6)" />
						<span class="insp-lock-text">@GetPrereqText(insp)</span>
					</div>
				}

				@* ---- INVEST — the page's one gold primary, directly under
				   the fact it changes. Zero-SP honesty lives in
				   GetInvestButtonContent. ---- *@
				@* MOTION: + `deny deny-vN` for 0.3s after a refused press (the 2px shake). *@
				<button class="@("insp-invest " + invest.cssClass + InvestDenyClass)"
						onclick=@OnInvestClicked
						onmouseover=@OnInvestHover
						onmouseout=@OnInvestHoverOut>
					<span class="sk-cap invest-cap">Space</span>
					<iconify class="invest-glyph" icon="@invest.icon" Size=@(20) Color="@invest.color" />
					<span class="insp-invest-label">@invest.label</span>
				</button>

				@* ---- Lower rail: the focused glyph as a ghost watermark
				   (texture, not content) — absolute, anchored above RESET. ---- *@
				<iconify class="insp-ghost" icon="@GetNodeIcon(insp)" Size=@(160) Color="rgba(244, 241, 234, 0.05)" />
			}
			else
			{
				@* CTA end state — every talent maxed and nothing hovered. *@
				<div class="insp-done">
					<iconify class="insp-done-glyph" icon="lucide:crown" Size=@(40) Color="#fbbf24" />
					<span class="insp-done-text">ALL TALENTS MASTERED</span>
				</div>
			}

			@* ---- RESET — one hold grammar, pinned at the foot. HOLD F ~0.9s,
			   hold-CLICK 0.9s, or hold Space/Enter/E with the kb cursor parked
			   here — all three feed ONE timer (TickResetHold); the fill width
			   is written per tick in measured px (UpdateResetHoldFill). No
			   onclick on purpose — the click-twice arm path is dead. Mounted
			   while there is something to reset OR the commit beat is still
			   playing (the green "Reset!" must not unmount mid-flash); hidden
			   with nothing invested — a destructive control you cannot use
			   only tempts a hold for nothing, and the rail foot reads as
			   breathing room under the ghost glyph, not as a void.
			   LANE: motion — costume hooks on this button: `.holding` while a
			   hold runs · `.h25/.h50/.h75` quarter milestones (h50 = the fill
			   has passed under the label → flip the label ink) · `.committed`
			   for 0.4s after the fire · `.cancelled` for 0.2s after an early
			   release. Expected dress: the fill heating from danger red toward
			   the page pink, an HDR rim (`* N`, rationed) from .h75, a 1-frame
			   white flash on .committed (the ring wears `.snap` that frame —
			   ringWarm is zeroed on commit), the slab dropping to rest on
			   .cancelled. Only the plain fill lives here. ---- *@
			@if (GetTotalRanksUnlocked() > 0 || IsResetFlashing)
			{
				var reset = GetResetButtonContent();
				<button class="@("insp-reset " + reset.cssClass + ResetStateClasses)"
						onmousedown=@OnResetMouseDown
						onmouseup=@OnResetMouseUp
						onmouseover=@OnResetHover
						onmouseout=@OnResetHoverOut>
					<div @ref="resetFillRef" class="reset-hold-fill"></div>
					<span class="sk-cap rst-cap">Hold F</span>
					<iconify class="reset-glyph" icon="@reset.icon" Size=@(14) Color="@reset.color" />
					<span class="insp-reset-label">@reset.label</span>
				</button>
			}
		</div>
	</div>

	@* ====================== Invest particle burst (keystroke-mounted) — LANE: motion ====================== *@
	@if (showBurst)
	{
		<div class="@("unlock-burst-layer burst-" + burstVersion)" style="left: @(burstX)px; top: @(burstY)px;">
			@for (int i = 0; i < 8; i++)
			{
				<div class="@("burst-particle p-" + i)"></div>
			}
		</div>
	}

	@* ====================== THE LIVING VIOLET RING ====================== *@
	@* The ONE cursor — lands on the kb-focused node OR the mouse-hovered
	   node (one-cursor model). Root-level absolute; geometry and the
	   on/snap classes are written IMPERATIVELY each tick from UpdateRing
	   (the hub's proven Style.Left/Top/Width/Height path — no markup
	   binding, no re-render); the liquid wave runs in ApplyRingWave. *@
	<div @ref="ringRef" class="sk-ring"></div>

</div>


@code {
	// =========================================================================
	// State
	// =========================================================================

	// ── ONE-CURSOR MODEL (roster contract; INPUT lane 2026-09-01) ──
	// The cursor is the PAIR (zone, node index). Mouse hover and WASD write
	// the SAME pair; the living ring reads it; the rail reads the node half.
	// The node index is STICKY — hover-out never blanks the rail or hides
	// the ring, it only stops following the mouse.
	private enum CursorZone { Nodes, Invest, Reset }
	private CursorZone cursorZone = CursorZone.Nodes;
	private int cursorNodeIndex = 0;
	private bool cursorSeeded = false; // seeded on the NEXT UP node at open (EnsureCursor)

	// One-device flag (DOC-5 #5): root .kbd-mode / .mouse-mode. Any nav or
	// confirm key takes the keyboard; the mouse reclaims only after REAL
	// travel (≥3px from where the keyboard took over — the engine re-sends
	// onmousemove on re-render under a parked cursor).
	private enum InputDevice { Mouse, Keyboard }
	private InputDevice lastInputDevice = InputDevice.Mouse;
	private bool IsKbMode => lastInputDevice == InputDevice.Keyboard;
	private Vector2 _kbTakeoverMousePos = new Vector2(-9999f, -9999f);
	private string RootClass => "skill-tree-panel " + (IsKbMode ? "kbd-mode" : "mouse-mode");

	// Live mouse hover over a node (mouse mode only — the hover/deny blip
	// guard and the dev dump; the CURSOR is the pair above).
	private SkillNode hoveredNode;
	// Raw hover targets remembered while the keyboard owns the cursor, so
	// the device flip lands the cursor on what the mouse is already over.
	private SkillNode _mouseOverNode;
	private CursorZone? _mouseOverZone;

	// Cursor tracking — used to aim the invest particle burst.
	private float lastMouseX;
	private float lastMouseY;

	// Unlock keys drive the one-shot invest ripple via key-changing remounts.
	private Dictionary<string, int> unlockVersions = new();

	// Particle burst state (LANE: motion owns the choreography).
	private bool showBurst;
	private int burstVersion;
	private float burstX;
	private float burstY;
	private TimeSince sinceBurst;

	// Tracks which node was most-recently invested so the ripple overlay
	// only mounts on that node.
	private string lastInvestedId = null;

	// Reset payoff flash (green "Reset!" beat after a completed hold).
	private float resetFlashUntil = 0f;
	private bool IsResetFlashing => RealTime.Now < resetFlashUntil;
	private const float ResetFlashDuration = 0.9f;

	// ── MOTION beats (render-key classes; each fires a fresh mount) ──
	// SP hero: `sp-dip sp-vN` on an invest (0.26s) · `sp-pop sp-vN` on a
	// reset commit (0.32s). The version key changes the class string on
	// every beat, so back-to-back invests each replay (DOC-4 #5).
	private float spBeatUntil = 0f;
	private int spBeatVersion = 0;
	private bool spBeatIsPop = false;
	private string SpBeatClass => RealTime.Now < spBeatUntil
		? (spBeatIsPop ? " sp-pop sp-v" : " sp-dip sp-v") + spBeatVersion
		: "";
	private void FireSpBeat(bool pop)
	{
		spBeatVersion++;
		spBeatIsPop = pop;
		spBeatUntil = RealTime.Now + (pop ? 0.32f : 0.26f);
	}

	// INVEST CTA deny shake: `deny deny-vN` for 0.3s after a refused press.
	private float investDenyUntil = 0f;
	private int investDenyVersion = 0;
	private string InvestDenyClass => RealTime.Now < investDenyUntil ? " deny deny-v" + investDenyVersion : "";
	private void FireInvestDeny()
	{
		investDenyVersion++;
		investDenyUntil = RealTime.Now + 0.3f;
	}

	// The mouse's live hover lights the glyph (mouse mode only — the kb
	// cursor lights it through `focused`). hoveredNode is in BuildHash.
	private bool IsMouseLit(SkillNode node)
		=> !IsKbMode && node != null && hoveredNode != null && hoveredNode.Id == node.Id;

	// HOLD-TO-RESET — the hold IS the confirmation (user 2026-07-12, re-ruled
	// 2026-09-01: ONE grammar for keyboard and mouse). ONE timer, three feeds
	// (F held · mouse button held on the slab · Space/Enter/E held while the
	// kb cursor is parked on RESET). Fill feedback is IMPERATIVE (per-tick
	// measured-px width writes) so it tracks the real hold and drains on
	// release; the progress CLASSES below are the costume hooks MOTION dresses.
	private float resetHoldTime = 0f;
	private const float ResetHoldDuration = 0.9f;
	private Panel resetFillRef;
	private float lastResetFillPct = -1f;
	private bool _resetMouseHeld;   // onmousedown → true · onmouseup / onmouseout → false
	private bool _holdActive;       // a hold is running (→ .holding from its first frame)
	private int _holdQuarter;       // quarter milestones already ticked this hold (0..3)
	private string _holdVia = "hold-F";
	private float resetCommittedUntil = 0f; // → .committed
	private float resetCancelledUntil = 0f; // → .cancelled
	private const float ResetCommittedDuration = 0.4f;
	private const float ResetCancelledDuration = 0.2f;
	private bool IsResetCommitted => RealTime.Now < resetCommittedUntil;
	private bool IsResetCancelled => RealTime.Now < resetCancelledUntil;

	// Fill fraction 0..1 — MOTION reads this (and the px width the tick
	// writes on .reset-hold-fill).
	private float ResetHoldFraction => Math.Clamp(resetHoldTime / ResetHoldDuration, 0f, 1f);
	private int ResetHoldQuarter => Math.Min(3, (int)(ResetHoldFraction * 4f));

	// Costume classes on .insp-reset: .holding while a hold runs · .h25/
	// .h50/.h75 as the fill passes each quarter (they drop off again as an
	// early release drains) · .committed 0.4s after a fire · .cancelled
	// 0.2s after an early release.
	private string ResetStateClasses
	{
		get
		{
			var s = "";
			if (_holdActive) s += " holding";
			// MOTION: .draining while an early release rewinds the fill — the
			// fill is INVISIBLE at rest (its r11 corners painted a sliver at
			// width 0) and shows only under .holding / .draining / .committed,
			// so the drain must keep it visible until the width lands at 0.
			if (!_holdActive && resetHoldTime > 0f) s += " draining";
			if (_holdActive || resetHoldTime > 0f)
			{
				int q = ResetHoldQuarter;
				if (q >= 1) s += " h25";
				if (q >= 2) s += " h50";
				if (q >= 3) s += " h75";
			}
			if (IsResetCommitted) s += " committed";
			if (IsResetCancelled) s += " cancelled";
			return s;
		}
	}

	// Hover-sound guards for the two rail buttons.
	private bool investHovered;
	private bool resetHovered;

	private SkillBranch[] AllBranches = new[]
	{
		SkillBranch.Power,
		SkillBranch.Fortune,
		SkillBranch.Fusion,
		SkillBranch.Expedition,
		SkillBranch.Mastery
	};

	// =========================================================================
	// Pipeline screenshot hook (re-blessed 2026-09-01) — jumps the running
	// session to the Skills page so the UI pipeline lanes can capture it over
	// MCP (camera_screenshot 1920×1080, includeUi). Call twice from the console
	// when starting at the main menu (first call enters the hub, second routes
	// once GameHUD has registered as nav host).
	//   dev_skillspage
	// =========================================================================
	[ConCmd( "dev_skillspage" )]
	public static void DevOpenSkillsPage()
	{
		var gm = Beastborne.Core.GameManager.Instance;
		if ( gm != null && !gm.IsInGame )
		{
			gm.StartGame();
		}
		NavManager.GoTo( "skills" );
		Log.Info( "[SkillTree] dev_skillspage → skills page" );
	}

	// =========================================================================
	// Localization
	// =========================================================================
	private string L(string key) => LocalizationManager.Get(key);
	// LocalizationManager loads its tables ONCE (lazy static on the first
	// Get) and returns the KEY on a miss — fall back to the shipped English
	// so a stale table never prints "UI.SKILL.KICKER" on the page.
	private string TitleText => LocOr("ui.skill.title", "Skills");
	private string KickerText => LocOr("ui.skill.kicker", "Tamer");
	private string LocOr(string key, string fallback)
	{
		var v = L(key);
		return string.IsNullOrEmpty(v) || v == key ? fallback : v;
	}

	// =========================================================================
	// Lifecycle
	// =========================================================================
	// Do NOT set AcceptsFocus on this panel. A focused panel CAPTURES the
	// keyboard and suppresses Input.Pressed GLOBALLY — with AcceptsFocus=true
	// one click on the page killed every keybind in the game (WASD, Space, M,
	// 1-6) until focus was lost. All keyboard nav here runs on the Input
	// action system via TickInput (GameHUD routes it). (2026-07-12)

	public override void Tick()
	{
		base.Tick();

		// Auto-hide burst after ~0.9s so the layer can remount next invest.
		if (showBurst && sinceBurst > 0.9f)
		{
			showBurst = false;
		}

		// Hold-to-reset fill — imperative width write tracking the live hold
		// (only-on-change guarded; the drain runs here too so an early
		// release visibly rewinds).
		UpdateResetHoldFill();

		// Living ring — position recomputed per tick (layout can reflow),
		// wave applied imperatively (flat panel: per-frame writes are cheap).
		EnsureCursor(GetAllNodesFlat());
		UpdateRing();
		ApplyRingWave();
	}

	// Per-tick visual for the hold-to-reset. Width in MEASURED PIXELS —
	// Length.Percent on the absolute child painted FULL width in-engine
	// (screenshot-verified), so the button's live rect × ScaleFromScreen
	// is the reliable base (the ring-math pattern).
	private void UpdateResetHoldFill()
	{
		if (resetFillRef == null) return;
		float frac = Math.Clamp(resetHoldTime / ResetHoldDuration, 0f, 1f);
		var host = resetFillRef.Parent;
		float w = host?.Box.Rect.Width ?? 0f;
		if (w < 1f) return;
		float sc = ScaleFromScreen;
		if (sc <= 0.01f || float.IsNaN(sc) || float.IsInfinity(sc)) sc = 1f;
		float px = MathF.Round(w * sc * frac);
		if (px <= 0f && lastResetFillPct <= 0f) return;
		resetFillRef.Style.Width = Length.Pixels(px);
		lastResetFillPct = px;
	}

	// =========================================================================
	// Keyboard navigation — TRUE-2D grid over the pillars, then the rail
	// =========================================================================
	// CURSOR GRAPH (spatially honest — every route follows the screen):
	//   NODES   5 columns (pillars, left→right) × up to 3 rows (keystone,
	//           petal 1, petal 2), indexed in DOM order (GetAllNodesFlat).
	//           W/S walk a pillar; A/D cross to the SAME row of the next
	//           pillar (clamped to its last row when it is shorter). Clamps
	//           at every edge — no wraps. W off the keystone row calls
	//           GameHUD.ExitPanel() (the tab-bar hook; a no-op today — tabs
	//           switch on the number keys) and the cursor stays put.
	//   INVEST  S off the bottom petal, or D off the 5th pillar (the rail
	//           sits to its right). W / A / D → back to the node we left.
	//   RESET   S from INVEST, only while the slab is mounted. W → INVEST;
	//           A / D → back to the node. S clamps.
	//   Space / Enter / E: invest the node the rail reads (from NODES or
	//           INVEST). HELD on RESET = the hold-to-reset feed. Q from the
	//           rail = back to the nodes (claims PanelHandledBackKey); Q on
	//           the nodes falls through to GameHUD (tab nav → main menu).
	//   F held: reset (any zone). R / Z / X: nothing to cycle here — unbound.
	public void TickInput()
	{
		// HOLD-to-reset runs every input tick, before any early-return.
		// "Flashlight" is F in Input.config; this page owns input while it
		// is the active tab (GameHUD's per-tab TickInput switch).
		TickResetHold();

		var nodes = GetAllNodesFlat();
		if (nodes.Count == 0) return;
		EnsureCursor(nodes);

		// Q — an INTERNAL back only from the rail (cursor → nodes). On the
		// nodes it is GameHUD's: tab nav, then the main menu.
		if (Input.Pressed("Menu"))
		{
			if (cursorZone != CursorZone.Nodes)
			{
				SetInputDevice(InputDevice.Keyboard);
				cursorZone = CursorZone.Nodes;
				SoundManager.PlayBack();
				GameHUD.PanelHandledBackKey = true;
			}
			return;
		}

		// Space / Enter (+ E, the silent alternate) — invest in the node the
		// rail is reading (matches the CTA's Space cap). Parked on RESET the
		// confirm key is a HOLD feed (TickResetHold) — the press edge is
		// deliberately silent here.
		if (UiInput.ConfirmPressed())
		{
			SetInputDevice(InputDevice.Keyboard);
			if (cursorZone == CursorZone.Reset) return;
			var target = CursorNode(nodes);
			if (target == null) return;
			AimBurstAtNode(target);
			InvestNode(target);
			return;
		}

		int dir = -1; // 0 up · 1 down · 2 left · 3 right
		if (Input.Pressed("Up")) dir = 0;
		else if (Input.Pressed("Down")) dir = 1;
		else if (Input.Pressed("Left")) dir = 2;
		else if (Input.Pressed("Right")) dir = 3;
		if (dir < 0) return;

		SetInputDevice(InputDevice.Keyboard);
		MoveCursor(dir, nodes);
	}

	// One step of the graph above. Clamped moves are silent.
	private void MoveCursor(int dir, List<SkillNode> nodes)
	{
		bool moved = false;
		switch (cursorZone)
		{
			case CursorZone.Nodes:
			{
				Locate(cursorNodeIndex, out int col, out int row);
				switch (dir)
				{
					case 0: // W — up the pillar; the keystone row clamps
						if (row > 0) { cursorNodeIndex = IndexOf(col, row - 1); moved = true; }
						else GameHUD.ExitPanel();
						break;
					case 1: // S — down the pillar, then INVEST
						if (row < RowCount(col) - 1) { cursorNodeIndex = IndexOf(col, row + 1); moved = true; }
						else if (InvestMounted()) { cursorZone = CursorZone.Invest; moved = true; }
						break;
					case 2: // A — same row, previous pillar
					{
						int c = NextColumn(col, -1);
						if (c >= 0) { cursorNodeIndex = IndexOf(c, Math.Min(row, RowCount(c) - 1)); moved = true; }
						break;
					}
					default: // D — same row, next pillar; off the 5th → INVEST
					{
						int c = NextColumn(col, +1);
						if (c >= 0) { cursorNodeIndex = IndexOf(c, Math.Min(row, RowCount(c) - 1)); moved = true; }
						else if (InvestMounted()) { cursorZone = CursorZone.Invest; moved = true; }
						break;
					}
				}
				break;
			}
			case CursorZone.Invest:
				if (dir == 1) { if (ResetMounted()) { cursorZone = CursorZone.Reset; moved = true; } }
				else { cursorZone = CursorZone.Nodes; moved = true; }
				break;
			case CursorZone.Reset:
				if (dir == 0) { cursorZone = CursorZone.Invest; moved = true; }
				else if (dir != 1) { cursorZone = CursorZone.Nodes; moved = true; }
				break;
		}
		if (moved) SoundManager.PlayHover();
	}

	// ── Grid helpers: column = branch (pillar), row = node within it ──
	private int RowCount(int col)
		=> col >= 0 && col < AllBranches.Length ? GetBranchNodes(AllBranches[col]).Count : 0;

	private int IndexOf(int col, int row)
	{
		int idx = 0;
		for (int c = 0; c < col; c++) idx += RowCount(c);
		return idx + Math.Max(0, row);
	}

	private void Locate(int index, out int col, out int row)
	{
		col = 0;
		row = Math.Max(0, index);
		while (col < AllBranches.Length - 1 && row >= RowCount(col))
		{
			row -= RowCount(col);
			col++;
		}
	}

	// Nearest non-empty pillar in `step` direction, or -1 at the edge.
	private int NextColumn(int col, int step)
	{
		int c = col + step;
		while (c >= 0 && c < AllBranches.Length && RowCount(c) == 0) c += step;
		return (c >= 0 && c < AllBranches.Length) ? c : -1;
	}

	// The rail's INVEST mounts whenever the rail has a node to read; RESET
	// mounts while there is something to reset or the commit beat plays
	// (mirrors the markup conditions — keep them in step).
	private bool InvestMounted() { bool _s; return GetInspectedNode(out _s) != null; }
	private bool ResetMounted() => GetTotalRanksUnlocked() > 0 || IsResetFlashing;

	private SkillNode CursorNode(List<SkillNode> nodes)
		=> cursorNodeIndex >= 0 && cursorNodeIndex < nodes.Count ? nodes[cursorNodeIndex] : null;

	// Seed the cursor on the NEXT UP node at open (cheapest affordable,
	// else the first keystone) — once, as soon as the tree has nodes — then
	// keep the pair valid as the rail's buttons mount/unmount under it.
	// Called from Tick (so the ring shows before any input) and TickInput.
	private void EnsureCursor(List<SkillNode> nodes)
	{
		if (nodes.Count == 0) return;
		if (!cursorSeeded)
		{
			cursorSeeded = true;
			var pick = SuggestedNode(nodes);
			int idx = pick != null ? nodes.FindIndex(n => n.Id == pick.Id) : -1;
			cursorNodeIndex = idx >= 0 ? idx : 0;
			cursorZone = CursorZone.Nodes;
		}
		cursorNodeIndex = Math.Clamp(cursorNodeIndex, 0, nodes.Count - 1);
		if (cursorZone == CursorZone.Reset && !ResetMounted()) cursorZone = CursorZone.Invest;
		if (cursorZone == CursorZone.Invest && !InvestMounted()) cursorZone = CursorZone.Nodes;
	}

	// The one-device flag. Keyboard takeover records the mouse position for
	// the travel guard and drops every live hover; the flip back to mouse
	// lands the cursor on whatever the mouse is already over.
	private void SetInputDevice(InputDevice dev)
	{
		if (lastInputDevice == dev) return;
		lastInputDevice = dev;
		if (dev == InputDevice.Keyboard)
		{
			_kbTakeoverMousePos = Mouse.Position;
			hoveredNode = null;
			investHovered = false;
			resetHovered = false;
		}
		else
		{
			if (_mouseOverNode != null) ApplyNodeHover(_mouseOverNode);
			else if (_mouseOverZone == CursorZone.Invest && InvestMounted()) cursorZone = CursorZone.Invest;
			else if (_mouseOverZone == CursorZone.Reset && ResetMounted()) cursorZone = CursorZone.Reset;
		}
	}

	// The cursor class on a node — kb mode only (the ring is the cursor in
	// both modes; the slab lift is the keyboard's extra read, CSS-gated
	// under .kbd-mode as well).
	private bool IsKbFocused(SkillNode node)
	{
		if (!IsKbMode || cursorZone != CursorZone.Nodes || node == null) return false;
		var nodes = GetAllNodesFlat();
		return cursorNodeIndex >= 0 && cursorNodeIndex < nodes.Count
			&& nodes[cursorNodeIndex].Id == node.Id;
	}

	// Flat node list in render order: AllBranches × GetBranchNodes. MUST stay
	// in sync with the .hex-slot DOM order so CollectHexRects indexes line up.
	private List<SkillNode> GetAllNodesFlat()
	{
		var list = new List<SkillNode>();
		foreach (var b in AllBranches)
			list.AddRange(GetBranchNodes(b));
		return list;
	}

	// Depth-first collect of every rendered .hex-slot's screen rect, in DOM
	// order (index-parallel to GetAllNodesFlat).
	private List<Rect> CollectHexRects()
	{
		var panels = new List<Panel>();
		CollectByClass(this, "hex-slot", panels);
		return panels.Select(p => p.Box.Rect).ToList();
	}

	private void CollectByClass(Panel root, string cls, List<Panel> outList)
	{
		foreach (var c in root.Children)
		{
			if (c.HasClass(cls)) outList.Add(c);
			else CollectByClass(c, cls, outList);
		}
	}

	// =========================================================================
	// THE LIVING VIOLET RING — one-cursor model (roster flat-panel recipe)
	// =========================================================================
	// Position recomputed every Tick from live Box.Rects (hotloads invalidate
	// rects). The ring reads the CURSOR PAIR — the same pair hover writes in
	// mouse mode and WASD writes in kb mode — so it is VISIBLE the whole time
	// the page is open: on the cursor node, or parked on INVEST (r16 → the
	// node costume) / RESET (r11 → the .reset costume, r21). A zone whose
	// element is not mounted falls through: RESET → INVEST → nodes.
	private Panel ringRef;
	private int ringL = -500, ringT = -500, ringW, ringH;
	private bool ringVisible;
	private int ringWarm; // <2 = snap to position (no glide) while rects land
	private const int RingInset = 10;

	// THE HUB FORMULA (OnlineHubPanel.UpdateHubRing — proven live 2026-08-29
	// via dev_hubring, ring centre measured on-host). Both rects are SCREEN
	// px: subtract the ROOT origin, multiply by ScaleFromScreen, THEN inset.
	//   l = (host.Left − root.Left) · sc − inset + 4
	//   t = (host.Top  − root.Top ) · sc − inset + 4
	//   w =  host.Width  · sc + 2·inset − 8
	//   h =  host.Height · sc + 2·inset − 8
	// +4 / −8 = the ring's own 4px border: Style.Left places the PADDING
	// box, so without them the stroke sat 4px up-left of the inset. With
	// inset 10 the border-box OUTER edge lands at exactly rect − 10 on
	// every side → 148 outer for a 128 node, radius 26 concentric.
	// Written IMPERATIVELY (Length.Pixels, only-on-change) like the hub —
	// no markup binding, so ring motion never re-renders the tree.
	private void UpdateRing()
	{
		if (ringRef == null) return;

		bool wasVisible = ringVisible;
		ringVisible = false;
		bool resetCostume = false;

		Rect? host = null;
		var zone = cursorZone;
		if (zone == CursorZone.Reset)
		{
			host = FindRectByClass("insp-reset");
			if (host.HasValue) resetCostume = true;
			else zone = CursorZone.Invest;
		}
		if (zone == CursorZone.Invest && !host.HasValue)
		{
			host = FindRectByClass("insp-invest");
			if (!host.HasValue) zone = CursorZone.Nodes;
		}
		if (zone == CursorZone.Nodes && !host.HasValue)
		{
			var rects = CollectHexRects();
			if (cursorNodeIndex >= 0 && cursorNodeIndex < rects.Count) host = rects[cursorNodeIndex];
		}

		if (host.HasValue)
		{
			var rr = Box.Rect;
			var cr = host.Value;
			if (rr.Width > 1f && cr.Width > 1f)
			{
				float sc = ScaleFromScreen;
				if (sc <= 0.01f || float.IsNaN(sc) || float.IsInfinity(sc)) sc = 1f;

				int l = (int)((cr.Left - rr.Left) * sc) - RingInset + 4;
				int t = (int)((cr.Top - rr.Top) * sc) - RingInset + 4;
				int w = (int)(cr.Width * sc) + RingInset * 2 - 8;
				int h = (int)(cr.Height * sc) + RingInset * 2 - 8;

				if (l != ringL) { ringL = l; ringRef.Style.Left = Length.Pixels(l); }
				if (t != ringT) { ringT = t; ringRef.Style.Top = Length.Pixels(t); }
				if (w != ringW) { ringW = w; ringRef.Style.Width = Length.Pixels(w); }
				if (h != ringH) { ringH = h; ringRef.Style.Height = Length.Pixels(h); }

				ringVisible = true;
				if (!wasVisible) ringWarm = 0;       // re-appearing → snap first, glide after
				else if (ringWarm < 2) ringWarm++;
			}
		}

		ringRef.SetClass("on", ringVisible);
		ringRef.SetClass("snap", ringWarm < 2);
		ringRef.SetClass("reset", resetCostume);
	}

	// First rendered panel carrying `cls` → its screen rect (null when the
	// element is not mounted or has no rect yet).
	private Rect? FindRectByClass(string cls)
	{
		var found = new List<Panel>();
		CollectByClass(this, cls, found);
		if (found.Count == 0) return null;
		var r = found[0].Box.Rect;
		return r.Width > 1f ? r : (Rect?)null;
	}

	// ── dev_skillring — the ring instrument (dev_hubring pattern) ──
	// One line per hex-slot: screen rect, offset from the root, size; then
	// the ring's own rect vs the L/T/W/H it was told. Run it with the
	// cursor parked on a node and the numbers say which term is off.
	private static SkillTreePanel _devSkills;

	protected override void OnAfterTreeRender(bool firstTime)
	{
		base.OnAfterTreeRender(firstTime);
		_devSkills = this;
	}

	[ConCmd( "dev_skillring" )]
	public static void DevSkillRing()
	{
		var p = _devSkills;
		if (p == null) { Log.Warning("[dev_skillring] Skills page not mounted."); return; }
		var rr = p.Box.Rect;
		var hover = p.hoveredNode?.Id ?? "-";
		Log.Info($"[dev_skillring] root={rr} scale={p.ScaleFromScreen} device={p.lastInputDevice} zone={p.cursorZone} idx={p.cursorNodeIndex} seeded={p.cursorSeeded} hover={hover} ringVisible={p.ringVisible} ring L/T/W/H={p.ringL}/{p.ringT}/{p.ringW}/{p.ringH}");
		var nodes = p.GetAllNodesFlat();
		var rects = p.CollectHexRects();
		Log.Info($"[dev_skillring] nodes={nodes.Count} hex-slots={rects.Count}");
		for (int i = 0; i < rects.Count; i++)
		{
			var r = rects[i];
			var id = i < nodes.Count ? nodes[i].Id : "?";
			Log.Info($"[dev_skillring] [{i}] {id}: rect={r} local=({r.Left - rr.Left:0.#},{r.Top - rr.Top:0.#}) size=({r.Width:0.#}x{r.Height:0.#})");
		}
		if (p.ringRef != null)
		{
			var r = p.ringRef.Box.Rect;
			Log.Info($"[dev_skillring] ring: rect={r} local=({r.Left - rr.Left:0.#},{r.Top - rr.Top:0.#}) size=({r.Width:0.#}x{r.Height:0.#}) classes={p.ringRef.Classes}");
		}
	}

	// The liquid ink-lean — menu-cursor multi-sine at the PawPad's ×0.6
	// amplitude + out-of-phase breathing. Imperative transform: no re-render.
	// LANE: motion (tunables are yours).
	private void ApplyRingWave()
	{
		if (ringRef == null || !ringVisible) return;
		float wt = Time.Now;
		float skX = (2.0f * MathF.Sin(wt * 2.2f) + 0.7f * MathF.Sin(wt * 3.5f + 1.1f)) * 0.6f;
		float skY = (2.3f * MathF.Sin(wt * 1.8f + 1.9f) + 0.9f * MathF.Sin(wt * 2.9f)) * 0.6f;
		float rotZ = (1.1f * MathF.Sin(wt * 1.0f) + 0.5f * MathF.Sin(wt * 2.4f + 0.5f)) * 0.6f;
		float brX = 1f + 0.013f * MathF.Sin(wt * 1.35f + 0.7f) + 0.006f * MathF.Sin(wt * 2.7f);
		float brY = 1f + 0.013f * MathF.Sin(wt * 1.15f + 2.6f) + 0.006f * MathF.Sin(wt * 2.3f + 1.4f);

		var t = new PanelTransform();
		t.AddRotation(0f, 0f, rotZ);
		t.AddSkew(skX, skY, 0f);
		t.AddScale(new Vector2(brX, brY));
		ringRef.Style.Transform = t;
	}

	// =========================================================================
	// Rail resolution
	// =========================================================================
	// The rail reads the CURSOR's node — hover-written in mouse mode, WASD-
	// written in kb mode, sticky either way (hover-out never blanks it) —
	// falling back to the suggested pick only before the cursor is seeded.
	// NEXT UP shows whenever the node being read IS the cheapest affordable
	// talent, however the cursor got there (the seed lands on it at open).
	private SkillNode GetInspectedNode(out bool suggested)
	{
		suggested = false;
		var nodes = GetAllNodesFlat();
		if (!cursorSeeded) EnsureCursor(nodes); // the first render can precede the first Tick — seed here too (no recursion: the seed lands on Nodes)
		var next = SuggestedNode(nodes);
		var pick = CursorNode(nodes) ?? next;
		if (pick == null) return null;
		suggested = next != null && next.Id == pick.Id;
		return pick;
	}

	// The cheapest affordable talent — "what to invest in next". Null when
	// nothing can be bought right now.
	private SkillNode SuggestedNode(List<SkillNode> all)
	{
		return all.Where(n => CanUpgradeSkill(n.Id))
			.OrderBy(n => n.CostPerRank).FirstOrDefault();
	}

	// Aim the burst at a node's center (keyboard / CTA invests happen
	// while the mouse cursor isn't on the node).
	private void AimBurstAtNode(SkillNode node)
	{
		if (node == null) return;
		var nodes = GetAllNodesFlat();
		int idx = nodes.FindIndex(n => n.Id == node.Id);
		if (idx < 0) return;
		var rects = CollectHexRects();
		if (idx >= rects.Count) return;
		float sc = ScaleFromScreen;
		if (sc <= 0.01f || float.IsNaN(sc) || float.IsInfinity(sc)) sc = 1f;
		var c = rects[idx].Center;
		lastMouseX = (c.x - Box.Rect.Left) * sc;
		lastMouseY = (c.y - Box.Rect.Top) * sc;
	}

	// =========================================================================
	// Event handlers
	// =========================================================================
	private void OnPanelClicked()
	{
		GameHUD.EnterPanel();
	}

	// Root onmousemove — the mouse-mode RECLAIM (DOC-5 #5). The engine
	// re-sends onmousemove on every re-render under a PARKED cursor, so a
	// bare flip would hand the cursor back to the mouse on each keypress
	// (the roster's "double flicker"). Mouse mode is reclaimed only by REAL
	// travel: ≥3px from where the keyboard took over.
	private void OnPanelMouseMove()
	{
		if (IsKbMode && (Mouse.Position - _kbTakeoverMousePos).Length >= 3f)
		{
			SetInputDevice(InputDevice.Mouse);
		}

		// Track cursor for burst positioning (MousePosition is panel-local).
		lastMouseX = MousePosition.x;
		lastMouseY = MousePosition.y;
	}

	// ── Node hover: hover IS selection (one-cursor). Ignored while the
	// keyboard drives (synthetic hovers under a parked cursor) — but
	// remembered, so the device flip lands the cursor on the node the
	// mouse is already over.
	private void OnNodeHover(SkillNode node)
	{
		if (node == null) return;
		_mouseOverNode = node;
		_mouseOverZone = null;
		if (IsKbMode) return;
		ApplyNodeHover(node);
	}

	private void ApplyNodeHover(SkillNode node)
	{
		if (hoveredNode != null && hoveredNode.Id == node.Id && cursorZone == CursorZone.Nodes) return; // repeat-fire guard
		hoveredNode = node;
		cursorZone = CursorZone.Nodes;
		int idx = GetAllNodesFlat().FindIndex(n => n.Id == node.Id);
		if (idx >= 0) cursorNodeIndex = idx;

		// Locked petals get a soft deny cue — "this is gated" without
		// forcing a read of the rail.
		if (!IsPrereqOk(node)) SoundManager.PlayDeny();
		else SoundManager.PlayHover();
	}

	private void OnNodeHoverOut()
	{
		// The cursor pair is sticky — only the live-hover channel clears,
		// so the ring stays parked on the node and the rail keeps reading it.
		_mouseOverNode = null;
		hoveredNode = null;
	}

	// Mouse click on a node — a click is mouse input (flip + land the
	// cursor on the node), then one-press invest.
	private void OnNodeClicked(SkillNode node)
	{
		if (node == null) return;
		SetInputDevice(InputDevice.Mouse);
		int idx = GetAllNodesFlat().FindIndex(n => n.Id == node.Id);
		if (idx >= 0) { cursorNodeIndex = idx; cursorZone = CursorZone.Nodes; }
		InvestNode(node);
	}

	// THE invest — one press, no confirm step (SP is cheap, reset is free).
	// Maxed = nothing (not a dead press, not a blip — there is nothing to
	// do). Locked / unaffordable = deny blip, never an armed state.
	private void InvestNode(SkillNode node)
	{
		if (node == null) return;

		var tamer = TamerManager.Instance;
		if (tamer == null) return;

		if (tamer.GetSkillRank(node.Id) >= node.MaxRank) return;

		if (!tamer.CanUnlockSkill(node.Id))
		{
			SoundManager.PlayDeny();
			FireInvestDeny(); // MOTION: 2px CTA shake, nothing else
			return;
		}

		bool success = tamer.UnlockSkill(node.Id);
		if (!success) { SoundManager.PlayDeny(); FireInvestDeny(); return; }

		// MOTION: the SP hero dips as the point leaves.
		FireSpBeat(pop: false);

		int newRank = tamer.GetSkillRank(node.Id);
		var newNode = tamer.SkillTree?.GetNode(node.Id);
		bool justMaxed = newNode != null && newRank >= newNode.MaxRank;

		// Bump the unlock version → ripple overlay remounts + replays.
		if (!unlockVersions.ContainsKey(node.Id)) unlockVersions[node.Id] = 0;
		unlockVersions[node.Id]++;
		lastInvestedId = node.Id;

		// Particle burst at the cursor (or node center for kb/CTA invests —
		// AimBurstAtNode parks the coords there first). LANE: motion
		burstVersion++;
		burstX = lastMouseX;
		burstY = lastMouseY;
		showBurst = true;
		sinceBurst = 0f;

		// Sound — maxing a talent gets the success chime, a rank the forward tick.
		if (justMaxed)
		{
			SoundManager.PlaySuccess();
		}
		else
		{
			SoundManager.PlayForward();
		}
	}

	// INVEST CTA — invests whatever the rail is reading.
	private void OnInvestClicked()
	{
		SetInputDevice(InputDevice.Mouse);
		bool _s;
		var node = GetInspectedNode(out _s);
		if (node == null) return;
		if (InvestMounted()) cursorZone = CursorZone.Invest;
		AimBurstAtNode(node);
		InvestNode(node);
	}

	// Hovering INVEST / RESET parks the ONE ring there (mouse mode); leaving
	// returns it to the sticky node. Both are ignored (but remembered) while
	// the keyboard drives.
	private void OnInvestHover()
	{
		_mouseOverZone = CursorZone.Invest;
		_mouseOverNode = null;
		if (IsKbMode) return;
		if (investHovered) return;
		investHovered = true;
		cursorZone = CursorZone.Invest;
		SoundManager.PlayHover();
	}

	// SYNTHETIC HOVER-OUT GUARD (2026-09-01): the engine re-fires
	// onmouseout/onmouseover pairs under a PARKED cursor on every re-render,
	// so an unguarded hover-out re-targeted the ring to the nodes and the
	// next synthetic hover-in sent it back — the ring hung mid-glide between
	// the node and the slab. A hover-out only counts if the mouse has really
	// left the host's rect.
	private bool MouseStillInside( string cls )
	{
		var r = FindRectByClass( cls );
		return r.HasValue && r.Value.IsInside( Mouse.Position );
	}

	private void OnInvestHoverOut()
	{
		if ( MouseStillInside( "insp-invest" ) ) return;
		investHovered = false;
		if (_mouseOverZone == CursorZone.Invest) _mouseOverZone = null;
		if (!IsKbMode && cursorZone == CursorZone.Invest) cursorZone = CursorZone.Nodes;
	}

	private void OnResetHover()
	{
		_mouseOverZone = CursorZone.Reset;
		_mouseOverNode = null;
		if (IsKbMode) return;
		if (resetHovered) return;
		resetHovered = true;
		cursorZone = CursorZone.Reset;
		SoundManager.PlayHover();
	}

	private void OnResetHoverOut()
	{
		if ( MouseStillInside( "insp-reset" ) ) return;
		resetHovered = false;
		_resetMouseHeld = false; // dragging off the slab releases the hold
		if (_mouseOverZone == CursorZone.Reset) _mouseOverZone = null;
		if (!IsKbMode && cursorZone == CursorZone.Reset) cursorZone = CursorZone.Nodes;
	}

	// Hold-CLICK — the mouse feed into the ONE reset timer. Down arms the
	// flag (TickResetHold reads it every input tick); up or hover-out
	// releases. No onclick anywhere on the slab.
	private void OnResetMouseDown()
	{
		SetInputDevice(InputDevice.Mouse);
		if (ResetMounted()) cursorZone = CursorZone.Reset;
		_resetMouseHeld = true;
	}

	private void OnResetMouseUp()
	{
		_resetMouseHeld = false;
	}

	// The actual reset — fired only by a COMPLETED hold (any feed).
	private void PerformReset(string via)
	{
		var tm = TamerManager.Instance;
		if (tm == null) return;

		int refunded = tm.ResetSkillTree();
		unlockVersions.Clear();
		lastInvestedId = null;
		hoveredNode = null;
		lastResetFillPct = -1f;
		_resetMouseHeld = false;

		resetFlashUntil = RealTime.Now + ResetFlashDuration;
		resetCommittedUntil = RealTime.Now + ResetCommittedDuration;
		ringWarm = 0; // the ring wears .snap this frame — MOTION's commit hook
		FireSpBeat(pop: true); // MOTION: the SP hero's gold pop (rationed to the commit)

		// The cursor STAYS where it is: the node index is still valid (every
		// node is rank 0 now) and teleporting the ring mid-commit would fight
		// the flash. When the RESET slab unmounts after the flash, EnsureCursor
		// slides a RESET-parked cursor up to INVEST. The SP hero + pips re-read
		// this same frame (SkillPoints / ranks are in BuildHash).

		// Commit cue — the house's strongest existing chime (the roster's
		// fusion confirm: success + maximize layered).
		SoundManager.PlayEvolution();
		Log.Info($"[SkillTree] Reset via {via} — refunded {refunded} SP");
	}

	// HOLD-TO-RESET (called every input tick). ONE timer, three feeds:
	//   · F held (any mode — F is a key, so it takes the keyboard and parks
	//     the ring on RESET so the fill and the cursor agree)
	//   · the mouse button held on the slab (_resetMouseHeld)
	//   · Space / Enter / E held while the kb cursor is parked on RESET
	// The fill starts on the FIRST down frame (no dead zone), runs the full
	// 0.9s linearly, ticks softly at each quarter, fires at 100%. An early
	// release drains at 3× with a deny blip + .cancelled; resuming mid-drain
	// continues from the drained value and only re-arms the quarters ahead.
	private void TickResetHold()
	{
		bool canReset = GetTotalRanksUnlocked() > 0 && !IsResetFlashing;
		if (!canReset) _resetMouseHeld = false;

		bool fHeld = Input.Down("Flashlight");
		bool confirmHeld = IsKbMode && cursorZone == CursorZone.Reset && ConfirmDown();
		bool holding = canReset && (fHeld || confirmHeld || _resetMouseHeld);

		if (holding)
		{
			if (!_holdActive)
			{
				_holdActive = true;
				_holdQuarter = ResetHoldQuarter;
				_holdVia = _resetMouseHeld ? "hold-click" : (fHeld ? "hold-F" : "hold-Space");
				if (fHeld && !_resetMouseHeld)
				{
					SetInputDevice(InputDevice.Keyboard);
					if (ResetMounted()) cursorZone = CursorZone.Reset;
				}
			}

			resetHoldTime += Time.Delta;

			int q = ResetHoldQuarter;
			if (q > _holdQuarter)
			{
				_holdQuarter = q;
				SoundManager.PlayHover(); // soft quarter tick (UI_HOVER, rate-limited)
			}

			if (resetHoldTime >= ResetHoldDuration)
			{
				resetHoldTime = 0f;
				_holdActive = false;
				_holdQuarter = 0;
				PerformReset(_holdVia);
			}
		}
		else
		{
			if (_holdActive)
			{
				_holdActive = false;
				if (resetHoldTime > 0.04f)
				{
					resetCancelledUntil = RealTime.Now + ResetCancelledDuration;
					SoundManager.PlayDeny(); // short cancel blip
				}
			}
			if (resetHoldTime > 0f)
			{
				resetHoldTime = Math.Max(0f, resetHoldTime - Time.Delta * 3f);
			}
		}
	}

	// The confirm pair, HELD (UiInput only exposes the press edge).
	private static bool ConfirmDown()
		=> Input.Down("Jump") || Input.Down("Enter") || Input.Down("Use");

	// =========================================================================
	// Button content — tuple-render helpers (single iconify + span so s&box
	// only swaps attribute values — no ghost children)
	// =========================================================================
	private (string icon, string label, string color, string cssClass) GetResetButtonContent()
	{
		if (IsResetFlashing)
			return ("lucide:check", "Reset!", "#ffffff", "flashing");

		// MOTION: the glyph's ink flips with the label as the fill passes
		// the midline (.h50) — the label/cap flip in scss, this is the
		// attribute half.
		var glyphInk = ResetHoldQuarter >= 2 ? "#ffffff" : "#ff8a92";
		return ("lucide:rotate-ccw", "Reset all talents", glyphInk, "");
	}

	// INVEST — the page's one primary. BIG THINGS BIG: a locked primary
	// stays the same 324×64 slab and dims. Zero-SP honesty: with 0 SP the
	// label tells the player WHEN the next point arrives (SP is flat 1 per
	// level — Tamer.GetSkillPointsForLevel), instead of a dead "Need 1 SP".
	private (string icon, string label, string color, string cssClass) GetInvestButtonContent(SkillNode node)
	{
		if (node == null)
			return ("lucide:crown", "All mastered", "#fbbf24", "maxed-cta");

		int rank = GetSkillRank(node.Id);
		if (rank >= node.MaxRank)
			return ("lucide:crown", "Mastered", "#fbbf24", "maxed-cta");

		if (!IsPrereqOk(node))
			return ("lucide:lock", "Locked", "rgba(214, 206, 236, 0.45)", "off");

		if (CanUpgradeSkill(node.Id))
			return ("lucide:zap", $"Invest · {node.CostPerRank} SP", "#2a1605", "");

		int level = GetTamerLevel();
		if (GetSkillPoints() <= 0 && level < Tamer.MaxLevel)
			return ("lucide:star", $"Next SP at level {level + 1}", "rgba(251, 191, 36, 0.55)", "off next-sp");

		// Some SP, but not enough for a 2-cost rank (or the level cap with
		// nothing left to earn).
		return ("lucide:star", $"Need {node.CostPerRank} SP", "rgba(214, 206, 236, 0.45)", "off");
	}

	// The ONE status line — built in C# so no dollar-interpolation touches
	// markup. Only ever shown when the prerequisite is unmet.
	private string GetPrereqText(SkillNode node)
	{
		var reqNode = TamerManager.Instance?.SkillTree?.GetNode(node.RequiredSkillId);
		var reqName = reqNode?.Name ?? "prerequisite";
		return $"Needs {reqName} rank {node.RequiredSkillRank}";
	}

	// =========================================================================
	// Data helpers
	// =========================================================================
	private int GetSkillPoints() => TamerManager.Instance?.CurrentTamer?.SkillPoints ?? 0;
	private int GetTamerLevel() => TamerManager.Instance?.CurrentTamer?.Level ?? 1;
	private int GetTotalRanksUnlocked() => TamerManager.Instance?.GetTotalRanksUnlocked() ?? 0;

	private List<SkillNode> GetBranchNodes(SkillBranch branch)
	{
		return TamerManager.Instance?.SkillTree?.GetNodesByBranch(branch) ?? new();
	}

	private int GetSkillRank(string skillId) => TamerManager.Instance?.GetSkillRank(skillId) ?? 0;
	private bool CanUpgradeSkill(string skillId) => TamerManager.Instance?.CanUnlockSkill(skillId) ?? false;

	// The only lock on the page: "keystone rank 1" (every RequiredBranchPoints
	// gate is 0 in the launch tree — the branch-gate UI path is retired).
	private bool IsPrereqOk(SkillNode node)
	{
		return string.IsNullOrEmpty(node.RequiredSkillId)
			|| GetSkillRank(node.RequiredSkillId) >= node.RequiredSkillRank;
	}

	private int GetUnlockKey(string id)
	{
		return unlockVersions.TryGetValue(id, out var v) ? v : 0;
	}

	// =========================================================================
	// Node state → CSS class (fills live in the scss — one accent per page)
	// =========================================================================
	private string GetNodeStateClass(int rank, bool unlocked)
	{
		if (rank > 0) return "invested";
		if (!unlocked) return "gated";
		return "open";
	}

	// Glyph colour per state: cream when invested or focused, near-void
	// silhouette on gated (the padlock carries the read), 0.6 cream at rest.
	private string GetNodeIconColor(int rank, string stateClass, bool focused)
	{
		if (rank > 0 || focused) return "#f4f1ea";
		if (stateClass == "gated") return "rgba(244, 241, 234, 0.18)";
		return "rgba(244, 241, 234, 0.6)";
	}

	private string GetBranchIcon(SkillBranch branch)
	{
		return branch switch
		{
			SkillBranch.Power => "lucide:swords",
			SkillBranch.Fortune => "lucide:coins",
			SkillBranch.Fusion => "lucide:flask-conical",
			SkillBranch.Expedition => "lucide:compass",
			SkillBranch.Mastery => "lucide:skull",
			_ => "lucide:sparkles"
		};
	}

