	{
		return effect.Type switch
		{
			SkillEffectType.AllMonsterATKPercent => "ATK",
			SkillEffectType.AllMonsterDEFPercent => "DEF",
			SkillEffectType.AllMonsterHPPercent => "HP",
			SkillEffectType.AllMonsterSpAPercent => "SpA",
			SkillEffectType.AllMonsterSpDPercent => "SpD",
			SkillEffectType.AllMonsterSPDPercent => "SPD",
			SkillEffectType.CritChanceBonus => "crit chance",
			SkillEffectType.CritDamageBonus => "crit damage",
			SkillEffectType.GeneBonusFlat => "bonus gene point",
			SkillEffectType.GeneticInheritanceBonus => "gene inheritance",
			SkillEffectType.MutationChance => "mutation chance",
			SkillEffectType.BreedingCostReduction => "fusion cost",
			SkillEffectType.NatureInheritance => "nature inheritance",
			SkillEffectType.ExpeditionGoldBonus => "expedition gold",
			SkillEffectType.EncounterRateBonus => "encounter rate",
			SkillEffectType.ExpeditionXPBonus => "expedition XP",
			SkillEffectType.RareItemChance => "rare item chance",
			SkillEffectType.ExpeditionSpeedBonus => "expedition speed",
			SkillEffectType.TeamSizeBonus => "expedition slot",
			SkillEffectType.BossDamageBonus => "damage vs bosses",
			SkillEffectType.BossDamageReduction => "boss damage taken",
			SkillEffectType.BossTokenBonus => "boss tokens",
			SkillEffectType.HigherTierDamageBonus => "vs higher-tier bosses",
			SkillEffectType.PhaseDamageBonus => "phase-transition damage",
			SkillEffectType.MythicDamageBonus => "vs Mythic bosses",
			SkillEffectType.ShopDiscount => "shop prices",
			SkillEffectType.GoldDropBonus => "gold drops",
			SkillEffectType.DoubleDropChance => "double-drop chance",
			SkillEffectType.BoostPotencyBonus => "shop boost potency",
			SkillEffectType.GoldFromAllSources => "gold from all sources",
			_ => ""
		};
	}

	// =========================================================================
	// BuildHash — include every piece of state that affects rendering
	// =========================================================================
	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add(currentTab);
		hash.Add(_kbActive);
		hash.Add(_kbNodeIndex);
		hash.Add(showInactiveStats);
		hash.Add(statsTickVersion);
		hash.Add(GetSkillPoints());
		hash.Add(GetTotalSkillPointsSpent());
		hash.Add(GetTotalRanksUnlocked());
		hash.Add(hoveredNode?.Id);
		hash.Add(resetConfirming);
		hash.Add(IsResetFlashing);
		hash.Add(resetBtnVersion);
		hash.Add(showBurst);
		hash.Add(burstVersion);
		hash.Add(lastInvestedId);
		// Ticking the hash while the pulse overlay is visible so it unmounts at ~0.6s.
		hash.Add(showBurst && sinceBurst < 0.6f);
		// Include branch totals so the tier-gates update when they cross a threshold.
		foreach (var b in AllBranches)
		{
			hash.Add(GetBranchPointsSpent(b));
		}
		// Include per-node unlock versions so the flash triggers on new click.
		foreach (var kv in unlockVersions)
		{
			hash.Add(kv.Key);
			hash.Add(kv.Value);
		}
		// Cursor-driven tooltip position
		hash.Add((int)(lastMouseX / 8));
		hash.Add((int)(lastMouseY / 8));
		return hash.ToHashCode();
	}
}
