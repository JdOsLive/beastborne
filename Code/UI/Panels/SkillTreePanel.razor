	// =========================================================================
	// BuildHash — include every piece of state that affects rendering
	// =========================================================================
	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add(GetSkillPoints());
		hash.Add(GetTotalSkillPointsSpent());
		hash.Add(GetTotalRanksUnlocked());
		hash.Add(hoveredNode?.Id);
		hash.Add(resetConfirming);
		hash.Add(IsResetFlashing);
		hash.Add(resetBtnVersion);
		hash.Add(showBurst);
		hash.Add(burstVersion);
		hash.Add(lastInvestedId);
		// Ticking the hash while the pulse overlay is visible so it unmounts at ~0.6s.
		hash.Add(showBurst && sinceBurst < 0.6f);
		// Include branch totals so the tier-gates update when they cross a threshold.
		foreach (var b in AllBranches)
		{
			hash.Add(GetBranchPointsSpent(b));
		}
		// Include per-node unlock versions so the flash triggers on new click.
		foreach (var kv in unlockVersions)
		{
			hash.Add(kv.Key);
			hash.Add(kv.Value);
		}
		// Cursor-driven tooltip position
		hash.Add((int)(lastMouseX / 8));
		hash.Add((int)(lastMouseY / 8));
		return hash.ToHashCode();
	}
}
