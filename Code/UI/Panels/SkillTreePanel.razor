@namespace Beastborne.UI.Panels
@using Sandbox;
@using Sandbox.UI;
@using Beastborne.Core;
@using Beastborne.Data;
@using Beastborne.Systems;
@using Beastborne.UI;
@using Beastborne.UI.Primitives;
@using System.Linq;
@inherits Panel

@*
	SKILLS — the Tamer's page (2026-07 design-language redesign).

	Identity: APP PINK #ff6bd6 (2026-07-12 — pages match their PawPad
	app tile; SKILLS is the pink app). GOLD survives only where gold is
	the GLOBAL convention: the SP hero counter (currency), the INVEST
	CTA (the one hero "go"), and mastery/reward moments. Wave header via
	BbHeaderWaves (appink), roster rh- identity dialect (kicker /
	BoldItalic display title / skewed seam dashes), sub-view band in the
	.fsub-head dialect hosting the TREE/STATS toggle + the key legend.

	TREE: five corner-cut branch pillars, each rendering the branch's
	FULL skill path VERTICALLY — keystone at top, petals descending,
	joined by thread segments that fill in the branch accent as you
	invest. Per-branch accents: Power red / Fortune gold / Fusion
	violet (#7b4ddb — fusion wears the My Beasts family now) /
	Expedition teal / Mastery violet-light. Footer = segmented rank pips
	(ranks invested / total ranks). The fixed INSPECTOR rail reads the
	focused node: hero plate (icon on accent wash + branch chip + italic
	name), rank pips, current→next effect delta, branch totals, the gold
	INVEST CTA (Space) and the two-stage reset (click-only) pinned at
	the bottom.

	ONE-CURSOR MODEL (roster contract): mouse hover and WASD drive the
	SAME channel — the living violet ring lands on whichever node is
	focused, both modes get identical treatment; nodes carry no separate
	:hover styling (the ring moving IS the hover feedback).

	Behavior preserved from the previous build: WASD/arrow nearest-node
	nav, Space/Enter invest, Tab view swap, F two-stage reset (tree view
	only now — the button lives in the tree sidebar), per-invest ripple
	+ burst (burst tinted per-branch), stats tab (eye toggle, 1Hz boost
	heartbeat, W/S scroll), sticky inspector with NEXT UP suggestion.

	ENGINE LAWS honored here: keyframe-percentage staggers ONLY (an
	animation still waiting out animation-delay is cancelled by panel
	re-renders — the 2026-07-12 law); no transforms / colored shadows
	inside the stats scroll (skew chips only — zero vertical overhang);
	corner cuts only on NON-scroll cards; bare text always in spans;
	explicit widths on flex cards; border colors STEP (never transition
	across hues); inline state styles always emit both properties.
*@

<div class="skill-tree-panel" onclick=@OnPanelClicked onmousemove=@OnPanelMouseMove>

	@* Living background: the skills glyph drifting at the house angle
	   (BbIconScroll supplies the opaque dark base — root paints none). *@
	<BbIconScroll Icon="skills" />

	@* =========================== HEADER — gold identity over waves ===== *@
	<div class="sk-header">
		<BbHeaderWaves Accent=@("appink") />
		<div class="sk-identity">
			<span class="sk-kicker">TAMER TALENTS</span>
			<div class="sk-title-row">
				<span class="sk-title">@TitleText</span>
				<div class="sk-hseam"></div>
				<div class="sk-hseam dim"></div>
			</div>
		</div>
		<div class="sk-head-spacer"></div>
		<div class="sp-hero">
			<span class="sp-hero-label">SKILL POINTS</span>
			<div class="sp-hero-row">
				<iconify icon="lucide:star" Size=@(22) Color="#fbbf24" />
				<span class="sp-hero-value">@GetSkillPoints()</span>
				<span class="sp-hero-unit">SP</span>
			</div>
		</div>
	</div>

	@* ============= SUB-VIEW BAND (.fsub-head dialect) — toggle + legend ===== *@
	@{
		var treeTabClass = currentTab == "tree" ? "sk-tab active" : "sk-tab";
		var statsTabClass = currentTab == "stats" ? "sk-tab active" : "sk-tab";
		var treeIconColor = TabIconColor( "tree" );
		var statsIconColor = TabIconColor( "stats" );
		var activeStats = GetActiveStatCount();
	}
	<div class="sk-subband">
		<div class="@treeTabClass" onclick=@OnTreeTabClick onmouseover=@OnTreeTabHover>
			<div class="sk-tab-inner">
				<iconify icon="lucide:network" Size=@(15) Color="@treeIconColor" />
				<span class="sk-tab-label">TREE</span>
			</div>
		</div>
		<div class="@statsTabClass" onclick=@OnStatsTabClick onmouseover=@OnStatsTabHover>
			<div class="sk-tab-inner">
				<iconify icon="lucide:bar-chart-3" Size=@(15) Color="@statsIconColor" />
				<span class="sk-tab-label">STATS</span>
				@if (activeStats > 0)
				{
					<span class="sk-tab-badge">@activeStats</span>
				}
			</div>
		</div>
		<div class="sk-sub-spacer"></div>
		@* Contextual key legend — roster .kb-legend dialect, content per view. *@
		<div class="sk-legend">
			@* Tab/F caps removed 2026-07-12 (user); R cycles the view
			   ("rotato"). < > also cycle silently (house convention) —
			   the legend only advertises the primary. *@
			@if (currentTab == "tree")
			{
				<span class="sk-key">WASD</span><span class="sk-key-label">Navigate</span>
				<span class="sk-key">Space</span><span class="sk-key-label">Invest</span>
				<span class="sk-key">R</span><span class="sk-key-label">View</span>
			}
			else
			{
				<span class="sk-key">W/S</span><span class="sk-key-label">Scroll</span>
				<span class="sk-key">Space</span><span class="sk-key-label">Reveal</span>
				<span class="sk-key">R</span><span class="sk-key-label">View</span>
			}
		</div>
	</div>

	@* =========================== TREE TAB =========================== *@
	@if (currentTab == "tree")
	{
	<div class="sk-body">
		<div class="sk-tree-zone">
			@for (int ci = 0; ci < AllBranches.Length; ci++)
			{
				var branch = AllBranches[ci];
				var accent = GetBranchAccent(branch);
				var branchNodes = GetBranchNodes(branch);
				var branchPts = GetBranchPointsSpent(branch);
				var branchMax = GetBranchMaxPoints(branch);
				var mastered = branchPts >= branchMax && branchMax > 0;
				var ranksIn = branchNodes.Sum(n => Math.Min(GetSkillRank(n.Id), n.MaxRank));
				var ranksTotal = branchNodes.Sum(n => n.MaxRank);
				var clusterClass = "sk-cluster sk-col-" + (ci + 1) + (mastered ? " mastered" : "");
				var chipIcon = mastered ? "lucide:crown" : GetBranchIcon(branch);

				<div class="@clusterClass">
					@* Signature top-right corner cut (roster .fd-cut mechanism). *@
					<div class="sk-cut"></div>

					@* ---- Branch identity: solid accent chip + hairline ---- *@
					@{ var chipInk = GetBranchInk(branch, mastered); }
					<div class="sk-branch-row">
						<div class="sk-branch-chip" style="@GetBranchChipStyle(branch, mastered)">
							<div class="sk-branch-chip-inner">
								<iconify icon="@chipIcon" Size=@(14) Color="@chipInk" />
								<span class="sk-branch-name" style="color: @chipInk;">@branch.ToString().ToUpper()</span>
							</div>
						</div>
						<div class="sk-branch-line"></div>
					</div>

					@* ---- The climbable path: full skill chain, vertical ---- *@
					<div class="sk-path">
						@for (int nodeIdx = 0; nodeIdx < branchNodes.Count; nodeIdx++)
						{
							var node = branchNodes[nodeIdx];
							var rank = GetSkillRank(node.Id);
							var isMaxed = rank >= node.MaxRank;
							var canUpgrade = CanUpgradeSkill(node.Id);
							var tierUnlocked = branchPts >= node.RequiredBranchPoints
								&& (string.IsNullOrEmpty(node.RequiredSkillId)
									|| GetSkillRank(node.RequiredSkillId) >= node.RequiredSkillRank);
							var stateClass = GetNodeStateClass(node, rank, canUpgrade, tierUnlocked);
							var unlockKey = GetUnlockKey(node.Id);
							var slotClass = "hex-slot " + stateClass + (IsKbFocused(node) ? " kb-focused" : "");
							var nameClass = "sk-node-name" + (rank > 0 ? " on" : "") + (stateClass == "gated" ? " ghost" : "");

							// Thread segment above every non-first node — fills in
							// the branch accent as investment flows downward.
							if (nodeIdx > 0)
							{
								<div class="sk-thread" style="@GetThreadStyle(branch, tierUnlocked, rank)"></div>
							}

							<div class="@slotClass"
								 style="@GetNodeBodyStyle(branch, stateClass)"
								 onclick=@(() => OnNodeClicked(node))
								 onmouseover=@(() => OnNodeHover(node))
								 onmouseout=@OnNodeHoverOut>

								<iconify class="hex-icon" icon="@GetNodeIcon(node)" Size=@(30) Color="@GetNodeIconColor(node, rank, isMaxed, stateClass)" />

								@if (stateClass == "gated")
								{
									<div class="hex-lock-corner">
										<iconify icon="lucide:lock" Size=@(11) Color="rgba(255, 255, 255, 0.5)" />
									</div>
								}

								@* One-shot invest ripple — mounted fresh per invest. *@
								@if (unlockKey > 0 && node.Id == lastInvestedId && sinceBurst < 0.6f)
								{
									<div class="hex-unlock-pulse pulse-@unlockKey" style="border-color: @accent;"></div>
								}
							</div>

							<div class="sk-node-pips">
								@for (int r = 0; r < node.MaxRank; r++)
								{
									<div class="sk-node-pip" style="@GetPipStyle(branch, r < rank)"></div>
								}
							</div>
							<span class="@nameClass">@node.Name.ToUpper()</span>
						}
					</div>

					@* ---- Footer: segmented rank pips (ranks in / total) ---- *@
					<div class="sk-branch-foot">
						<div class="sk-fpips">
							@for (int r = 0; r < ranksTotal; r++)
							{
								<div class="sk-fpip" style="@GetPipStyle(branch, r < ranksIn)"></div>
							}
						</div>
						<span class="sk-foot-num @(mastered ? "mastered" : "")">@ranksIn</span>
						<span class="sk-foot-sep">/</span>
						<span class="sk-foot-max">@ranksTotal</span>
					</div>
				</div>
			}
		</div>

		@* =========================== THE INSPECTOR =========================== *@
		@{
			bool inspSuggested;
			var insp = GetInspectedNode(out inspSuggested);
		}
		<div class="sk-inspector">
			<div class="sk-cut"></div>
			@if (insp != null)
			{
				var iAccent = GetBranchAccent(insp.Branch);
				var iRank = GetSkillRank(insp.Id);
				var iMaxed = iRank >= insp.MaxRank;
				var iCan = CanUpgradeSkill(insp.Id);
				var iBranchGateOk = GetBranchPointsSpent(insp.Branch) >= insp.RequiredBranchPoints;
				var iPrereqOk = string.IsNullOrEmpty(insp.RequiredSkillId)
					|| GetSkillRank(insp.RequiredSkillId) >= insp.RequiredSkillRank;
				var iNextRank = iRank + 1;
				var invest = GetInvestButtonContent(insp);
				var investedInBranch = GetBranchNodes(insp.Branch).Where(n => GetSkillRank(n.Id) > 0).ToList();

				// Hero plate: big icon on accent wash + chip + name.
				<div class="insp-hero" style="@GetHeroWashStyle(insp.Branch)">
					<div class="insp-hero-icon" style="@GetHeroIconStyle(insp.Branch)">
						<iconify icon="@GetNodeIcon(insp)" Size=@(34) Color="@iAccent" />
					</div>
					<div class="insp-hero-id">
						<div class="insp-chip-row">
							<div class="insp-chip" style="background-color: @iAccent;">
								<span class="insp-chip-label" style="color: @GetBranchInk(insp.Branch, false);">@insp.Branch.ToString().ToUpper()</span>
							</div>
							@if (inspSuggested)
							{
								<div class="insp-next-tag"><span>NEXT UP</span></div>
							}
						</div>
						<div class="insp-name">@insp.Name</div>
					</div>
				</div>

				<div class="insp-rank-row">
					<span class="insp-rank-label">RANK</span>
					<div class="insp-pips">
						@for (int r = 0; r < insp.MaxRank; r++)
						{
							<div class="insp-pip" style="@GetPipStyle(insp.Branch, r < iRank)"></div>
						}
					</div>
					<span class="insp-rank-value">@iRank</span>
					<span class="insp-rank-sep">/</span>
					<span class="insp-rank-max">@insp.MaxRank</span>
					@if (iMaxed)
					{
						<BbStamp Text="MAX" Tone="gold" Tilt=@(3) Class="insp-max-stamp" />
					}
				</div>

				<div class="insp-desc">@insp.Description</div>

				@* ---- Effect readout: current → next-rank delta ---- *@
				<div class="insp-sec-head">
					<span class="insp-sec-label">@(iMaxed ? "EFFECT" : (iRank > 0 ? "CURRENT → NEXT RANK" : "NEXT RANK"))</span>
					<div class="insp-sec-line"></div>
				</div>
				<div class="insp-effects">
					@foreach (var effect in insp.Effects)
					{
						var cur = GetEffectDisplay(insp, effect, iRank);
						var nxt = GetEffectDisplay(insp, effect, iNextRank);
						<div class="insp-eff-row">
							@if (iRank > 0)
							{
								<span class="insp-eff-current">@cur</span>
							}
							@if (!iMaxed)
							{
								@if (iRank > 0)
								{
									<span class="insp-eff-arrow">→</span>
								}
								<span class="insp-eff-next">@nxt</span>
							}
						</div>
					}
				</div>

				@if (!iMaxed)
				{
					@if (!iBranchGateOk)
					{
						<div class="insp-status warn">
							<iconify icon="lucide:lock" Size=@(13) Color="#f87171" />
							<span>@GetBranchGateText(insp)</span>
						</div>
					}
					else if (!iPrereqOk)
					{
						<div class="insp-status warn">
							<iconify icon="lucide:lock" Size=@(13) Color="#f87171" />
							<span>@GetPrereqText(insp)</span>
						</div>
					}
					else if (iCan)
					{
						<div class="insp-status ok">
							<iconify icon="lucide:zap" Size=@(13) Color="#4ade80" />
							<span>Ready to invest</span>
						</div>
					}
					else
					{
						<div class="insp-status warn">
							<iconify icon="lucide:star" Size=@(13) Color="#f87171" />
							<span>Not enough SP</span>
						</div>
					}
				}

				@* ---- Branch totals: cumulative invested bonuses ---- *@
				<div class="insp-sec-head">
					<span class="insp-sec-label">BRANCH TOTALS</span>
					<div class="insp-sec-line"></div>
				</div>
				<div class="insp-totals">
					@if (investedInBranch.Count == 0)
					{
						<span class="insp-totals-empty">Nothing invested in this branch yet.</span>
					}
					@foreach (var bn in investedInBranch)
					{
						var bnRank = GetSkillRank(bn.Id);
						foreach (var eff in bn.Effects)
						{
							<div class="insp-total-row">
								<span class="insp-total-name">@bn.Name</span>
								<span class="insp-total-val">@GetEffectDisplay(bn, eff, bnRank)</span>
							</div>
						}
					}
				</div>

				@* ---- INVEST — the page's one gold hero CTA ---- *@
				<button class="insp-invest @invest.cssClass"
						onclick=@OnInvestClicked
						onmouseover=@OnInvestHover
						onmouseout=@OnInvestHoverOut>
					<span class="sk-key invest-cap">Space</span>
					<iconify icon="@invest.icon" Size=@(18) Color="@invest.color" />
					<span class="insp-invest-label">@invest.label</span>
				</button>
			}
			else
			{
				<div class="insp-done">
					<iconify icon="lucide:crown" Size=@(40) Color="#fbbf24" />
					<span>ALL TALENTS MASTERED</span>
				</div>
			}

			@* ---- Reset: click = two-stage confirm; HOLD F ~0.9s = reset
			   (the hold IS the confirmation — user 2026-07-12). The fill
			   div's width is written imperatively per tick from the live
			   hold time (CSS animations can't reverse/cancel on release). *@
			@if (GetTotalRanksUnlocked() > 0)
			{
				var reset = GetResetButtonContent();
				<button class="insp-reset @reset.cssClass rstv-@resetBtnVersion"
						onclick=@OnResetClicked
						onmouseover=@OnResetHover>
					<div @ref="resetFillRef" class="reset-hold-fill"></div>
					@if (resetConfirming)
					{
						<div class="reset-armed-glow"></div>
					}
					<span class="sk-key rst-cap">Hold F</span>
					<iconify icon="@reset.icon" Size=@(13) Color="@reset.color" />
					<span class="insp-reset-label">@reset.label</span>
				</button>
			}
		</div>
	</div>
	}
	else
	{
		@* =========================== STATS TAB =========================== *@
		var statRows = PlayerStatsSummary.GetAll();
		var activeCount = statRows.Count(r => r.HasContributions);
		var sampleGold = PlayerStatsSummary.GetSampleGoldExample(1000);
		var groupOrder = new[] { StatGroup.Economy, StatGroup.Progression, StatGroup.Expedition, StatGroup.Combat, StatGroup.Boss, StatGroup.Fusion };
		var visibleTotal = showInactiveStats ? statRows.Count : activeCount;

		<div class="stats-body">

			<div class="stats-top-row">
				@* Sample-expedition calculator — corner-cut card (non-scroll). *@
				<div class="stats-summary-bar">
					<div class="sk-cut"></div>
					<div class="ssb-left">
						<iconify icon="lucide:calculator" Size=@(22) Color="#ff6bd6" />
						<div class="ssb-text">
							<span class="ssb-label">SAMPLE EXPEDITION</span>
							<span class="ssb-sub">1,000g base → @($"{sampleGold:N0}")g with current bonuses</span>
						</div>
					</div>
					<div class="ssb-right">
						<span class="ssb-pill-label">ACTIVE</span>
						<span class="ssb-pill-num">@activeCount</span>
						<span class="ssb-pill-sep">/</span>
						<span class="ssb-pill-max">@statRows.Count</span>
					</div>
					@* Eye toggle — hides/reveals the not-yet-unlocked bonus rows. *@
					<div class="ssb-eye @(showInactiveStats ? "active" : "")"
						 onclick=@ToggleShowInactiveStats
						 onmouseover=@(() => SoundManager.PlayHover())>
						<iconify icon="@(showInactiveStats ? "lucide:eye" : "lucide:eye-off")" Size=@(14) Color="@(showInactiveStats ? "#ff6bd6" : "rgba(255, 255, 255, 0.6)")" />
					</div>
				</div>

				<div class="stats-footer-hint">
					<iconify icon="lucide:info" Size=@(11) Color="rgba(255, 107, 214, 0.55)" />
					<span>@(showInactiveStats ? "Dim rows are bonuses you haven't unlocked yet. Tap the eye to hide them." : "Tap the eye to reveal every bonus you can still unlock.")</span>
				</div>
			</div>

			@* Category sections — band header + 3-up rows per group. Bands and
			   rows are DIRECT children of the scroll (flat-children law). *@
			<div class="stats-scroll">

				@if (visibleTotal == 0)
				{
					<div class="stats-empty-card">
						<iconify icon="lucide:sparkles" Size=@(28) Color="rgba(255, 107, 214, 0.5)" />
						<span class="se-title">No active bonuses yet</span>
						<span class="se-sub">Invest in the skill tree, equip relics, or activate boosts. Tap the eye above to see what's available.</span>
					</div>
				}

				@foreach (var grp in groupOrder)
				{
					var inGroup = statRows
						.Where(r => r.Group == grp && (showInactiveStats || r.HasContributions))
						.OrderByDescending(r => r.HasContributions).ThenBy(r => r.Name).ToList();
					if (inGroup.Count == 0) { continue; }
					var gActive = inGroup.Count(r => r.HasContributions);
					var gColor = PlayerStatsSummary.GetGroupColor(grp);
					var chunks = new List<List<StatRow>>();
					for (int i = 0; i < inGroup.Count; i += 3)
					{
						chunks.Add(inGroup.Skip(i).Take(3).ToList());
					}

					<div class="stats-band">
						<div class="stats-band-chip" style="background-color: @gColor;">
							<span>@PlayerStatsSummary.GetGroupName(grp)</span>
						</div>
						<div class="stats-band-line"></div>
						<div class="stats-band-badge"><span>@gActive OF @inGroup.Count ACTIVE</span></div>
					</div>

					@foreach (var chunk in chunks)
					{
						<div class="stats-card-row">
							@foreach (var row in chunk)
							{
								var hasAny = row.HasContributions;
								var net = row.NetPercentBonus;
								var sign = net >= 0 ? "+" : "";
								var totalText = hasAny
									? (row.IsFlat ? $"{sign}{net:0.#}" : $"{sign}{net:0.#}%")
									: "—";

								<div class="stat-card @row.Group.ToString().ToLower() @(hasAny ? "active" : "inactive")">
									<div class="sc-head">
										<div class="sc-icon-wrap @(hasAny ? "" : "inactive")">
											<iconify icon="@row.Icon" Size=@(14) Color="@(hasAny ? "#ffffff" : "rgba(255,255,255,0.3)")" />
										</div>
										<span class="sc-name @(hasAny ? "" : "inactive")">@row.Name</span>
										<div class="sc-total @(hasAny ? "active" : "inactive") @(net < 0 ? "negative" : "")">
											<span class="sc-total-value">@totalText</span>
										</div>
									</div>

									@if (hasAny)
									{
										<div class="sc-sources">
											@foreach (var src in row.Sources)
											{
												var valTxt = src.Op == StatOp.Multiply
													? $"×{src.Value:0.0#}"
													: (row.IsFlat ? $"+{src.Value:0.#}" : $"+{src.Value:0.#}%");
												<div class="sc-src">
													<div class="sc-src-tag" style="background-color: @src.TagColor;">
														<span>@src.Tag</span>
													</div>
													<span class="sc-src-label">@src.Label</span>
													@if (src.TimeRemaining.HasValue)
													{
														<span class="sc-src-timer @(src.TimeRemaining.Value.TotalMinutes < 5 ? "expiring" : "")">@FormatBoostTime(src.TimeRemaining.Value)</span>
													}
													<span class="sc-src-value @(src.Op == StatOp.Multiply ? "multiply" : "add")">@valTxt</span>
												</div>
											}
										</div>
									}
									else
									{
										<div class="sc-empty">
											<span>@row.Description</span>
										</div>
									}
								</div>
							}
							@for (int pad = chunk.Count; pad < 3; pad++)
							{
								<div class="stat-card-spacer"></div>
							}
						</div>
					}
				}

			</div>
		</div>
	}

	@* =========================== Invest particle burst (keystroke-mounted) =========================== *@
	@if (showBurst)
	{
		<div class="unlock-burst-layer burst-@burstVersion" style="left: @(burstX)px; top: @(burstY)px;">
			@for (int i = 0; i < 8; i++)
			{
				<div class="burst-particle p-@i" style="background-color: @burstColor;"></div>
			}
		</div>
	}

	@* =========================== THE LIVING VIOLET RING =========================== *@
	@* The ONE cursor — lands on the kb-focused node OR the mouse-hovered
	   node (one-cursor model). Root-level absolute (roster flat-panel
	   recipe); position bound each tick from UpdateRing; the liquid wave
	   runs imperatively in ApplyRingWave (no re-render). *@
	<div @ref="ringRef" class="sk-ring @(ringVisible ? "on" : "") @(ringWarm < 2 ? "snap" : "") @(RingOnTabs ? "tab" : "")"
		 style="left: @(ringL)px; top: @(ringT)px; width: @(ringW)px; height: @(ringH)px;"></div>

</div>


@code {
	// =========================================================================
	// State
	// =========================================================================

	// Tab state — "tree" (default landing) or "stats".
	private string currentTab = "tree";
	private string lastTabHover = null; // sound guard (s&box onmouseover fires repeatedly)

	// When false (default), the stats list hides every row that has zero
	// contributions. Toggle in the summary bar flips it on.
	private bool showInactiveStats = false;
	// Stats subtab refresh tick — boost timers count down live.
	private int statsTickVersion = 0;
	private TimeSince sinceStatsTick = 0f;

	// Live hover target (mouse OR keyboard cursor — SyncKbCursor writes it).
	private SkillNode hoveredNode;
	private string lastHoveredId = null; // hover-sound guard

	// The inspector's sticky target — survives hover-out so the reading
	// rail never blanks mid-browse. Falls back to the suggested pick.
	private string inspectedNodeId = null;

	// Cursor tracking — used to aim the invest particle burst.
	private float lastMouseX;
	private float lastMouseY;

	// Unlock keys drive the one-shot invest ripple via key-changing remounts.
	private Dictionary<string, int> unlockVersions = new();

	// Particle burst state
	private bool showBurst;
	private int burstVersion;
	private float burstX;
	private float burstY;
	private string burstColor = "#fbbf24";
	private TimeSince sinceBurst;

	// Tracks which node was most-recently invested so the ripple overlay
	// only mounts on that hex.
	private string lastInvestedId = null;

	// Reset confirmation — inline two-stage flow on the sidebar button.
	private bool resetConfirming;
	private float resetConfirmExpires = 0f;
	private float resetFlashUntil = 0f;
	private int resetBtnVersion = 0;
	private float resetClickGuardUntil = 0f;
	private string lastResetHoverState = null;

	private bool IsResetFlashing => RealTime.Now < resetFlashUntil;
	private const float ResetConfirmWindow = 3.0f;
	private const float ResetFlashDuration = 0.9f;

	// HOLD-F reset (2026-07-12, user: "probably should be hold f") — on
	// the keyboard path the HOLD is the confirmation (no two-stage arm;
	// holding 0.9s is deliberate). Click path keeps its two-stage flow.
	// Fill feedback is IMPERATIVE (per-tick width writes) so it tracks
	// the real hold time and drains instantly on release.
	private float resetHoldTime = 0f;
	private const float ResetHoldDuration = 0.9f;
	private Panel resetFillRef;
	private float lastResetFillPct = -1f;

	// Invest CTA hover sound guard.
	private bool investHovered;

	private SkillBranch[] AllBranches = new[]
	{
		SkillBranch.Power,
		SkillBranch.Fortune,
		SkillBranch.Fusion,
		SkillBranch.Expedition,
		SkillBranch.Mastery
	};

	// =========================================================================
	// TEMP dev hook (sbox-ui verification, 2026-07-12) — jumps the running
	// session to the Skills tab and optionally flips the sub-view, so the
	// redesigned page can be screenshot-verified over MCP. Call twice from
	// the console when starting at the main menu (first call enters the hub,
	// second routes once GameHUD has registered as nav host).
	//   dev_skillspage        → tree view
	//   dev_skillspage stats  → stats view
	// REMOVE after the redesign is user-approved.
	// =========================================================================
	private static string devPendingView;

	[ConCmd( "dev_skillspage" )]
	public static void DevOpenSkillsPage( string view = "tree" )
	{
		var gm = Beastborne.Core.GameManager.Instance;
		if ( gm != null && !gm.IsInGame )
		{
			gm.StartGame();
		}
		NavManager.GoTo( "skills" );
		devPendingView = view.StartsWith( "stats" ) ? view : "tree";
		Log.Info( $"[SkillTree] dev_skillspage → view {devPendingView}" );
	}

	// =========================================================================
	// Localization
	// =========================================================================
	private string L(string key) => LocalizationManager.Get(key);
	private string L(string key, params object[] args) => LocalizationManager.Get(key, args);
	private string TitleText => L("ui.skill.title");

	// =========================================================================
	// Lifecycle
	// =========================================================================
	// ⚠️ Do NOT set AcceptsFocus on this panel. A focused panel CAPTURES the
	// keyboard and suppresses Input.Pressed GLOBALLY — with AcceptsFocus=true
	// one click on the page killed every keybind in the game (WASD, Space, M,
	// 1-6) until focus was lost. Same failure MainMenu documents at its
	// OnStart. All keyboard nav here runs on the Input action system via
	// TickInput (GameHUD routes it) — no panel focus needed. (2026-07-12)

	public override void Tick()
	{
		base.Tick();

		// TEMP dev hook consumption (see DevOpenSkillsPage).
		if (devPendingView != null)
		{
			var v = devPendingView;
			devPendingView = null;
			if (v == "stats-all") { SetTab("stats"); showInactiveStats = true; }
			else if (v == "stats") { SetTab("stats"); showInactiveStats = false; }
			else SetTab("tree");
		}

		// Auto-hide burst after ~0.9s so the layer can remount next invest.
		if (showBurst && sinceBurst > 0.9f)
		{
			showBurst = false;
		}

		// Auto-revert the armed reset if the confirm window lapses. Silent.
		if (resetConfirming && RealTime.Now > resetConfirmExpires)
		{
			resetConfirming = false;
			resetBtnVersion++;
		}

		// Stats tab 1Hz heartbeat for live boost timers.
		if (currentTab == "stats" && sinceStatsTick > 1.0f)
		{
			statsTickVersion++;
			sinceStatsTick = 0f;
		}

		// HOLD-F fill — imperative width write tracking the live hold
		// (only-on-change guarded; the drain runs here too so an early
		// release visibly rewinds).
		UpdateResetHoldFill();

		// Living ring — position recomputed per tick (layout can reflow),
		// wave applied imperatively (flat panel: per-frame writes are cheap;
		// the 7fps law only bites inside perspective leans).
		UpdateRing();
		ApplyRingWave();
	}

	// Per-tick visual for the hold-F reset. Width in MEASURED PIXELS —
	// Length.Percent on the absolute child painted FULL width in-engine
	// (screenshot-verified), so the button's live rect × ScaleFromScreen
	// is the reliable base (the ring-math pattern). Only-on-change
	// guarded; the rstv- remount re-seeds cleanly because the write
	// repeats whenever pct is non-zero.
	private void UpdateResetHoldFill()
	{
		if (resetFillRef == null) return;
		float frac = Math.Clamp(resetHoldTime / ResetHoldDuration, 0f, 1f);
		var host = resetFillRef.Parent;
		float w = host?.Box.Rect.Width ?? 0f;
		if (w < 1f) return;
		float sc = ScaleFromScreen;
		if (sc <= 0.01f || float.IsNaN(sc) || float.IsInfinity(sc)) sc = 1f;
		float px = MathF.Round(w * sc * frac);
		if (px <= 0f && lastResetFillPct <= 0f) return;
		resetFillRef.Style.Width = Length.Pixels(px);
		lastResetFillPct = px;
	}

	// =========================================================================
	// Keyboard navigation
	// =========================================================================
	// TREE tab: spatial cursor over the node graph — reads rendered
	// .hex-slot rects and picks the best node in the pressed direction. The
	// focused node drives the inspector (same channel the mouse hover uses).
	// STATS tab: W/S scroll the card list, Space toggles the eye.
	// Tab (view swap) keybind REMOVED 2026-07-12 (user); F returned the
	// same day as HOLD-F (~0.9s) — see TickResetHold. View switching by
	// keyboard: R cycles TREE/STATS (+ Z/X, the house CyclePrev/CycleNext
	// convention — shop stores, hub sections, beastbook filter), AND the
	// one-cursor ring can ride up into the view band: W off a top-row
	// node focuses the tabs, A/D moves between them, Space activates,
	// S drops back into the content (the roster seam grammar).
	private int _kbNodeIndex = 0;
	private bool _kbActive = false;
	// View-band zone: the ring sits on the TREE/STATS slabs.
	private bool _kbTabZone = false;
	private int _kbTabIndex = 0; // 0 = TREE, 1 = STATS

	public void TickInput()
	{
		// HOLD F ≈0.9s = talent reset (restored 2026-07-12 as a HOLD —
		// the button cap reads "Hold F"). Runs every input tick, before
		// any zone early-return, but only bites on the TREE view where
		// the button is visible. "Flashlight" is F in Input.config; this
		// page owns input while it's the active tab (GameHUD's per-tab
		// TickInput switch), so no other F consumer runs here.
		TickResetHold();

		// R cycles TREE/STATS (user 2026-07-12: "r could be cycle cause
		// rotato" — R is free on this page; fusion/team-picker R meanings
		// untouched). Z/X (the CyclePrev/CycleNext ACTIONS) keep working
		// too as the silent game-wide cycle pair (R is the advertised cap).
		if (Input.Pressed("Reload") || Input.Pressed("CyclePrev") || Input.Pressed("CycleNext"))
		{
			SetTab(currentTab == "tree" ? "stats" : "tree");
			return;
		}

		if (_kbTabZone)
		{
			TickTabZoneInput();
			return;
		}

		if (currentTab == "tree")
			TickTreeInput();
		else
			TickStatsInput();
	}

	// The ring parked on the view band — A/D between TREE/STATS, Space
	// activates, S returns to the content, W escalates to the HUD tabs
	// (the roster top-row convention).
	private void TickTabZoneInput()
	{
		if (Input.Pressed("Left") || Input.Pressed("Right"))
		{
			_kbActive = true;
			_kbTabIndex = _kbTabIndex == 0 ? 1 : 0;
			SoundManager.PlayHover();
		}
		else if (UiInput.ConfirmPressed())
		{
			_kbActive = true;
			SetTab(_kbTabIndex == 0 ? "tree" : "stats");
		}
		else if (Input.Pressed("Down"))
		{
			_kbActive = true;
			_kbTabZone = false;
			SoundManager.PlayHover();
		}
		else if (Input.Pressed("Up"))
		{
			_kbTabZone = false;
			_kbActive = false;
			GameHUD.ExitPanel();
		}
	}

	private void TickTreeInput()
	{
		var nodes = GetAllNodesFlat();
		if (nodes.Count == 0) return;
		ClampKbIndex(nodes.Count);

		// Space / Enter (+ E, the silent alternate) — invest in the
		// INSPECTED node (what the player is reading in the rail; matches
		// the CTA's Space keycap).
		if (UiInput.ConfirmPressed())
		{
			bool _s;
			var target = GetInspectedNode(out _s);
			if (target == null) return;
			_kbActive = true;
			int ti = nodes.FindIndex(n => n.Id == target.Id);
			if (ti >= 0) _kbNodeIndex = ti;
			AimBurstAtNode(target);
			OnNodeClicked(target);
			return;
		}

		int dir = -1; // 0 up · 1 down · 2 left · 3 right
		if (Input.Pressed("Up")) dir = 0;
		else if (Input.Pressed("Down")) dir = 1;
		else if (Input.Pressed("Left")) dir = 2;
		else if (Input.Pressed("Right")) dir = 3;
		if (dir < 0) return;

		var rects = CollectHexRects();

		// First nav keypress just lights the cursor — engage on the node the
		// mouse last hovered if there is one, otherwise the saved index.
		if (!_kbActive)
		{
			_kbActive = true;
			if (hoveredNode != null)
			{
				int hi = nodes.FindIndex(n => n.Id == hoveredNode.Id);
				if (hi >= 0) _kbNodeIndex = hi;
			}
			if (rects.Count == nodes.Count) SyncKbCursor(nodes, rects);
			SoundManager.PlayHover();
			return;
		}

		if (rects.Count != nodes.Count) return; // layout not ready this frame

		int next = FindNeighbor(_kbNodeIndex, dir, rects);
		if (next >= 0 && next != _kbNodeIndex)
		{
			_kbNodeIndex = next;
			SyncKbCursor(nodes, rects);
			SoundManager.PlayHover();
		}
		else if (dir == 0 && next < 0)
		{
			// W off a top-row node — the ring rides up into the view band
			// (roster seam grammar: keep walking up, reach the tabs).
			_kbTabZone = true;
			_kbTabIndex = currentTab == "tree" ? 0 : 1;
			SoundManager.PlayHover();
		}
	}

	private void TickStatsInput()
	{
		// Space / Enter / E toggles the "show every available bonus" eye.
		if (UiInput.ConfirmPressed())
		{
			ToggleShowInactiveStats();
			return;
		}
		// W / S scroll the card list (held = continuous).
		var scroll = FindByClass(this, "stats-scroll");
		if (scroll == null) return;
		// W at the very top — ride up into the view band (seam grammar).
		if (Input.Pressed("Up") && scroll.ScrollOffset.y <= 0.5f)
		{
			_kbActive = true;
			_kbTabZone = true;
			_kbTabIndex = 1;
			SoundManager.PlayHover();
			return;
		}
		float step = 0f;
		if (Input.Down("Down")) step = 14f;
		else if (Input.Down("Up")) step = -14f;
		if (step != 0f)
		{
			float y = Math.Max(0f, scroll.ScrollOffset.y + step);
			scroll.ScrollOffset = new Vector2(scroll.ScrollOffset.x, y);
		}
	}

	// Focused node → drive the inspector + park burst coords on the node so
	// an invest lands its particles there, not at a stale mouse spot.
	private void SyncKbCursor(List<SkillNode> nodes, List<Rect> rects)
	{
		if (_kbNodeIndex < 0 || _kbNodeIndex >= nodes.Count) return;
		hoveredNode = nodes[_kbNodeIndex];
		lastHoveredId = hoveredNode.Id;
		inspectedNodeId = hoveredNode.Id;
		if (_kbNodeIndex < rects.Count)
		{
			float sc = ScaleFromScreen;
			if (sc <= 0.01f || float.IsNaN(sc) || float.IsInfinity(sc)) sc = 1f;
			var c = rects[_kbNodeIndex].Center;
			lastMouseX = (c.x - Box.Rect.Left) * sc;
			lastMouseY = (c.y - Box.Rect.Top) * sc;
		}
	}

	private void ClampKbIndex(int count)
	{
		if (count <= 0) { _kbNodeIndex = 0; return; }
		_kbNodeIndex = Math.Clamp(_kbNodeIndex, 0, count - 1);
	}

	// Flat node list in render order: AllBranches × GetBranchNodes. MUST stay
	// in sync with the .hex-slot DOM order so CollectHexRects indexes line up.
	private List<SkillNode> GetAllNodesFlat()
	{
		var list = new List<SkillNode>();
		foreach (var b in AllBranches)
			list.AddRange(GetBranchNodes(b));
		return list;
	}

	private bool IsKbFocused(SkillNode node)
	{
		if (!_kbActive || currentTab != "tree" || node == null) return false;
		var nodes = GetAllNodesFlat();
		return _kbNodeIndex >= 0 && _kbNodeIndex < nodes.Count
			&& nodes[_kbNodeIndex].Id == node.Id;
	}

	// Depth-first collect of every rendered .hex-slot's screen rect, in DOM
	// order (index-parallel to GetAllNodesFlat).
	private List<Rect> CollectHexRects()
	{
		var panels = new List<Panel>();
		CollectByClass(this, "hex-slot", panels);
		return panels.Select(p => p.Box.Rect).ToList();
	}

	private void CollectByClass(Panel root, string cls, List<Panel> outList)
	{
		foreach (var c in root.Children)
		{
			if (c.HasClass(cls)) outList.Add(c);
			else CollectByClass(c, cls, outList);
		}
	}

	private Panel FindByClass(Panel root, string cls)
	{
		foreach (var c in root.Children)
		{
			if (c.HasClass(cls)) return c;
			var found = FindByClass(c, cls);
			if (found != null) return found;
		}
		return null;
	}

	// Pick the nearest node in direction `dir`. Score = primary-axis distance
	// + 2.5× perpendicular offset. Returns -1 when nothing lies that way.
	private int FindNeighbor(int from, int dir, List<Rect> rects)
	{
		if (from < 0 || from >= rects.Count) return -1;
		float cx = rects[from].Center.x;
		float cy = rects[from].Center.y;
		int best = -1;
		float bestScore = float.MaxValue;
		for (int i = 0; i < rects.Count; i++)
		{
			if (i == from) continue;
			float dx = rects[i].Center.x - cx;
			float dy = rects[i].Center.y - cy;
			float primary, perp;
			switch (dir)
			{
				case 0:  if (dy > -4f) continue; primary = -dy; perp = Math.Abs(dx); break;
				case 1:  if (dy <  4f) continue; primary =  dy; perp = Math.Abs(dx); break;
				case 2:  if (dx > -4f) continue; primary = -dx; perp = Math.Abs(dy); break;
				default: if (dx <  4f) continue; primary =  dx; perp = Math.Abs(dy); break;
			}
			float score = primary + perp * 2.5f;
			if (score < bestScore) { bestScore = score; best = i; }
		}
		return best;
	}

	// =========================================================================
	// THE LIVING VIOLET RING — one-cursor model (roster flat-panel recipe)
	// =========================================================================
	// Position recomputed every Tick from live Box.Rects (tab swaps and
	// hotloads invalidate rects). Targets the kb cursor when keyboard is
	// driving, otherwise the mouse-hovered node — hover IS selection, both
	// devices get the same ring.
	private Panel ringRef;
	private int ringL, ringT, ringW = 84, ringH = 84;
	private bool ringVisible;
	private int ringWarm; // <2 = snap to position (no glide) while rects land
	private const int RingInset = 10;

	// True while the ring is parked on a view-band tab (tighter radius).
	private bool RingOnTabs => _kbActive && _kbTabZone;

	private void UpdateRing()
	{
		bool wasVisible = ringVisible;
		ringVisible = false;

		// View-band zone — the ring rides the TREE/STATS slabs (works from
		// BOTH sub-views; runs before the tree-only gate below).
		if (RingOnTabs)
		{
			var tabPanels = new List<Panel>();
			CollectByClass(this, "sk-tab", tabPanels);
			if (_kbTabIndex < 0 || _kbTabIndex >= tabPanels.Count) return;
			var rrT = Box.Rect;
			var trT = tabPanels[_kbTabIndex].Box.Rect;
			if (rrT.Width < 1f || trT.Width < 1f) return;
			float scT = ScaleFromScreen;
			if (scT <= 0.01f || float.IsNaN(scT) || float.IsInfinity(scT)) scT = 1f;
			ringL = (int)((trT.Left - rrT.Left) * scT) - RingInset;
			ringT = (int)((trT.Top - rrT.Top) * scT) - RingInset;
			ringW = (int)(trT.Width * scT) + RingInset * 2;
			ringH = (int)(trT.Height * scT) + RingInset * 2;
			ringVisible = true;
			if (!wasVisible) ringWarm = 0;
			else if (ringWarm < 2) ringWarm++;
			return;
		}

		if (currentTab != "tree") return;

		var nodes = GetAllNodesFlat();
		if (nodes.Count == 0) return;

		int targetIdx = -1;
		if (_kbActive)
		{
			ClampKbIndex(nodes.Count);
			targetIdx = _kbNodeIndex;
		}
		else if (hoveredNode != null)
		{
			targetIdx = nodes.FindIndex(n => n.Id == hoveredNode.Id);
		}
		if (targetIdx < 0) return;

		var rects = CollectHexRects();
		if (targetIdx >= rects.Count) return;

		var rr = Box.Rect;
		var cr = rects[targetIdx];
		if (rr.Width < 1f || cr.Width < 1f) return;

		float sc = ScaleFromScreen;
		if (sc <= 0.01f || float.IsNaN(sc) || float.IsInfinity(sc)) sc = 1f;

		// SYMMETRIC ring math (centering fix 2026-07-12): the box is offset
		// -inset on BOTH axes and widened by exactly inset*2, so the ring is
		// concentric with the node. (The old `- 8` shrank the box without
		// re-centering it — the ring visibly hugged the node's top-left.)
		ringL = (int)((cr.Left - rr.Left) * sc) - RingInset;
		ringT = (int)((cr.Top - rr.Top) * sc) - RingInset;
		ringW = (int)(cr.Width * sc) + RingInset * 2;
		ringH = (int)(cr.Height * sc) + RingInset * 2;

		ringVisible = true;
		if (!wasVisible) ringWarm = 0;       // re-appearing → snap first, glide after
		else if (ringWarm < 2) ringWarm++;
	}

	// The liquid ink-lean — menu-cursor multi-sine at the PawPad's ×0.6
	// amplitude + out-of-phase breathing. Imperative transform: no re-render;
	// flat panel so per-frame writes are cheap.
	private void ApplyRingWave()
	{
		if (ringRef == null || !ringVisible) return;
		float wt = Time.Now;
		float skX = (2.0f * MathF.Sin(wt * 2.2f) + 0.7f * MathF.Sin(wt * 3.5f + 1.1f)) * 0.6f;
		float skY = (2.3f * MathF.Sin(wt * 1.8f + 1.9f) + 0.9f * MathF.Sin(wt * 2.9f)) * 0.6f;
		float rotZ = (1.1f * MathF.Sin(wt * 1.0f) + 0.5f * MathF.Sin(wt * 2.4f + 0.5f)) * 0.6f;
		float brX = 1f + 0.013f * MathF.Sin(wt * 1.35f + 0.7f) + 0.006f * MathF.Sin(wt * 2.7f);
		float brY = 1f + 0.013f * MathF.Sin(wt * 1.15f + 2.6f) + 0.006f * MathF.Sin(wt * 2.3f + 1.4f);

		var t = new PanelTransform();
		t.AddRotation(0f, 0f, rotZ);
		t.AddSkew(skX, skY, 0f);
		t.AddScale(new Vector2(brX, brY));
		ringRef.Style.Transform = t;
	}

	// =========================================================================
	// Inspector resolution
	// =========================================================================
	// Priority: live hover/kb cursor → sticky last-inspected → the suggested
	// pick (cheapest affordable node — "what to invest in next").
	private SkillNode GetInspectedNode(out bool suggested)
	{
		suggested = false;

		if (hoveredNode != null) return hoveredNode;

		if (!string.IsNullOrEmpty(inspectedNodeId))
		{
			var sticky = TamerManager.Instance?.SkillTree?.GetNode(inspectedNodeId);
			if (sticky != null) return sticky;
		}

		var pick = DefaultInspectNode();
		if (pick != null && CanUpgradeSkill(pick.Id)) suggested = true;
		return pick;
	}

	private SkillNode DefaultInspectNode()
	{
		var all = GetAllNodesFlat();
		if (all.Count == 0) return null;

		// Cheapest affordable first.
		var afford = all.Where(n => CanUpgradeSkill(n.Id))
			.OrderBy(n => n.CostPerRank).FirstOrDefault();
		if (afford != null) return afford;

		// Otherwise the first not-yet-maxed talent; null when ALL are maxed
		// (the inspector then shows the mastered celebration block).
		return all.FirstOrDefault(n => GetSkillRank(n.Id) < n.MaxRank);
	}

	// Aim the burst at a node's center (keyboard / CTA invests happen
	// while the mouse cursor isn't on the node).
	private void AimBurstAtNode(SkillNode node)
	{
		if (node == null) return;
		var nodes = GetAllNodesFlat();
		int idx = nodes.FindIndex(n => n.Id == node.Id);
		if (idx < 0) return;
		var rects = CollectHexRects();
		if (idx >= rects.Count) return;
		float sc = ScaleFromScreen;
		if (sc <= 0.01f || float.IsNaN(sc) || float.IsInfinity(sc)) sc = 1f;
		var c = rects[idx].Center;
		lastMouseX = (c.x - Box.Rect.Left) * sc;
		lastMouseY = (c.y - Box.Rect.Top) * sc;
	}

	// =========================================================================
	// Event handlers
	// =========================================================================
	private void OnPanelClicked()
	{
		GameHUD.EnterPanel();

		// Click-elsewhere cancels the armed reset (the button's own onclick
		// runs first and sets the guard, so this only fires for genuine
		// outside clicks).
		if (resetConfirming && RealTime.Now > resetClickGuardUntil)
		{
			resetConfirming = false;
			resetBtnVersion++;
		}
	}

	private void OnPanelMouseMove()
	{
		// Device flip — the menu/roster contract: any REAL mouse movement
		// returns the one cursor to the mouse channel (last-input-wins).
		// Guarded on an actual position delta so layout jitter can't flip
		// modes; WASD flips it back in TickTreeInput.
		float dx = MousePosition.x - lastMouseX;
		float dy = MousePosition.y - lastMouseY;
		if (_kbActive && (dx * dx + dy * dy) > 4f)
		{
			_kbActive = false;
			_kbTabZone = false; // mouse reclaimed the cursor — leave the band zone
		}

		// Track cursor for burst positioning (MousePosition is panel-local).
		lastMouseX = MousePosition.x;
		lastMouseY = MousePosition.y;
	}

	private void OnNodeHover(SkillNode node)
	{
		if (node == null) return;
		if (lastHoveredId == node.Id) return; // guard repeat-fire
		lastHoveredId = node.Id;
		hoveredNode = node;
		inspectedNodeId = node.Id;
		// Mouse took over — drop the keyboard cursor; the ONE ring now
		// follows the hover channel (one-cursor model).
		_kbActive = false;

		// Locked petals get a soft deny cue — "this is gated" without
		// forcing a read of the inspector.
		bool tierUnlocked = GetBranchPointsSpent(node.Branch) >= node.RequiredBranchPoints
			&& (string.IsNullOrEmpty(node.RequiredSkillId)
				|| GetSkillRank(node.RequiredSkillId) >= node.RequiredSkillRank);
		if (!tierUnlocked)
		{
			SoundManager.PlayDeny();
		}
		else
		{
			SoundManager.PlayHover();
		}
	}

	private void OnNodeHoverOut()
	{
		// The inspector keeps reading the last node (inspectedNodeId is
		// already sticky) — only the live-hover channel clears.
		lastHoveredId = null;
		hoveredNode = null;
	}

	private void OnNodeClicked(SkillNode node)
	{
		if (node == null) return;

		var tamer = TamerManager.Instance;
		if (tamer == null) return;

		inspectedNodeId = node.Id;

		bool ok = tamer.CanUnlockSkill(node.Id);
		if (!ok)
		{
			SoundManager.PlayDeny();
			return;
		}

		int prevRank = tamer.GetSkillRank(node.Id);
		bool success = tamer.UnlockSkill(node.Id);
		if (!success) { SoundManager.PlayDeny(); return; }

		int newRank = tamer.GetSkillRank(node.Id);
		var newNode = tamer.SkillTree?.GetNode(node.Id);
		bool justMaxed = newNode != null && newRank >= newNode.MaxRank;
		bool isCapstoneSetpiece = justMaxed && node.Tier == 3;

		// Bump the unlock version → ripple overlay remounts + replays.
		if (!unlockVersions.ContainsKey(node.Id)) unlockVersions[node.Id] = 0;
		unlockVersions[node.Id]++;
		lastInvestedId = node.Id;

		// Particle burst at the cursor (or node center for kb/CTA invests —
		// AimBurstAtNode parks the coords there first). Branch-accent tinted.
		burstVersion++;
		burstX = lastMouseX;
		burstY = lastMouseY;
		burstColor = GetBranchAccent(node.Branch);
		showBurst = true;
		sinceBurst = 0f;

		// Sound — tiered.
		if (isCapstoneSetpiece)
		{
			SoundManager.PlaySuccess();
			SoundManager.PlayGoldReward();
		}
		else if (justMaxed)
		{
			SoundManager.PlaySuccess();
		}
		else
		{
			SoundManager.PlayForward();
		}
	}

	// INVEST CTA — invests whatever the inspector is reading.
	private void OnInvestClicked()
	{
		bool _s;
		var node = GetInspectedNode(out _s);
		if (node == null) return;
		AimBurstAtNode(node);
		OnNodeClicked(node);
	}

	private void OnInvestHover()
	{
		if (investHovered) return;
		investHovered = true;
		SoundManager.PlayHover();
	}

	private void OnInvestHoverOut()
	{
		investHovered = false;
	}

	// Inline two-stage reset. First click arms; second click (within the
	// window) fires; click-elsewhere or timeout reverts silently.
	private void OnResetClicked()
	{
		if (GetTotalRanksUnlocked() <= 0) return;

		resetClickGuardUntil = RealTime.Now + 0.1f;

		if (IsResetFlashing) return;

		if (!resetConfirming)
		{
			resetConfirming = true;
			resetConfirmExpires = RealTime.Now + ResetConfirmWindow;
			resetBtnVersion++; // remount so the armed pulse keyframe plays
			SoundManager.PlayClick();
		}
		else
		{
			PerformReset("click confirm");
		}
	}

	// The actual reset — shared by the click path's second stage and the
	// hold-F completion.
	private void PerformReset(string via)
	{
		var tm = TamerManager.Instance;
		if (tm == null)
		{
			resetConfirming = false;
			resetBtnVersion++;
			return;
		}

		int refunded = tm.ResetSkillTree();
		unlockVersions.Clear();
		lastInvestedId = null;
		hoveredNode = null;
		inspectedNodeId = null;

		resetConfirming = false;
		resetFlashUntil = RealTime.Now + ResetFlashDuration;
		resetBtnVersion++;

		// Destructive action — PlayBack colors "undoing progress"
		// distinctly from a gain cue.
		SoundManager.PlayBack();
		Log.Info($"[SkillTree] Reset via {via} — refunded {refunded} SP");
	}

	// HOLD-F reset (called every input tick, before zone early-returns).
	// Holding F for ResetHoldDuration on the TREE view fires the reset —
	// the hold IS the confirmation (no arm stage on this path). Early
	// release drains the fill fast (3× speed) instead of snapping, so
	// the player sees the cancel.
	private void TickResetHold()
	{
		bool holding = currentTab == "tree"
			&& GetTotalRanksUnlocked() > 0
			&& !IsResetFlashing
			&& Input.Down("Flashlight");

		if (holding)
		{
			resetHoldTime += Time.Delta;
			if (resetHoldTime >= ResetHoldDuration)
			{
				resetHoldTime = 0f;
				PerformReset("hold-F");
			}
		}
		else if (resetHoldTime > 0f)
		{
			resetHoldTime = Math.Max(0f, resetHoldTime - Time.Delta * 3f);
		}
	}

	private void OnResetHover()
	{
		if (lastResetHoverState == "reset") return;
		lastResetHoverState = "reset";
		SoundManager.PlayHover();
	}

