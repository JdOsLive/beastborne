	// =========================================================================
	// BuildHash — every piece of state that affects rendering
	// =========================================================================
	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add(currentTab);
		hash.Add(_kbActive);
		hash.Add(_kbNodeIndex);
		hash.Add(showInactiveStats);
		hash.Add(statsTickVersion);
		hash.Add(GetSkillPoints());
		hash.Add(GetTotalSkillPointsSpent());
		hash.Add(GetTotalRanksUnlocked());
		hash.Add(hoveredNode?.Id);
		hash.Add(inspectedNodeId);
		hash.Add(resetConfirming);
		hash.Add(IsResetFlashing);
		hash.Add(resetBtnVersion);
		hash.Add(showBurst);
		hash.Add(burstVersion);
		hash.Add(lastInvestedId);
		// Tick the hash while the ripple overlay is visible so it unmounts.
		hash.Add(showBurst && sinceBurst < 0.6f);
		// Living ring geometry (markup-bound style values).
		hash.Add(ringL);
		hash.Add(ringT);
		hash.Add(ringW);
		hash.Add(ringH);
		hash.Add(ringVisible);
		hash.Add(ringWarm < 2);
		// Branch totals — tier gates + mastery bars update on thresholds.
		foreach (var b in AllBranches)
		{
			hash.Add(GetBranchPointsSpent(b));
		}
		// Per-node unlock versions — the ripple triggers on new invests.
		foreach (var kv in unlockVersions)
		{
			hash.Add(kv.Key);
			hash.Add(kv.Value);
		}
		return hash.ToHashCode();
	}
