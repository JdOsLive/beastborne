	// BuildHash drives re-render reactivity. Every state field that affects
	// rendering lives here — the five-zone landing adds the zone cursor
	// (_kbZone), the rail (railOpen), the compact leaderboards (category,
	// loading, per-category counts), the battle identity (record/streak/
	// points), and the guild corner (membership, online count, goal).
	protected override int BuildHash()
	{
		var vcm = VoiceChatManager.Instance;
		var tamer = TamerManager.Instance?.CurrentTamer;
		var gm = GuildManager.Instance;
		var goal = gm?.WeeklyGoals?.FirstOrDefault( g => !g.Claimed );
		return System.HashCode.Combine(
			HashCode.Combine(
				currentSection,
				selectedKind,
				selectedOnlinePlayer?.ConnectionId,
				showFavSelector,
				railOpen,
				IsConnected() ? Connection.All.Count : 0,
				ChatManager.Instance?.PlayerProfiles?.Count ?? 0,
				HashCode.Combine( _kbZone, _kbIndex, _kbActive )
			),
			HashCode.Combine(
				vcm?.IsInLobby ?? false,
				vcm?.IsMicActive ?? false,
				vcm?.CurrentRoom?.Members?.Count ?? 0,
				tamer?.FavoriteMonsterSpeciesId,
				hubLbCatIndex,
				hubLbLoading,
				CurrentHubLbEntries().Count
			),
			HashCode.Combine(
				tamer?.ArenaWins ?? 0,
				tamer?.ArenaLosses ?? 0,
				tamer?.ArenaWinStreak ?? 0,
				tamer?.ArenaPoints ?? 0,
				IsInGuild(),
				gm?.OnlineCount ?? 0,
				gm?.Members?.Count ?? 0,
				HashCode.Combine( goal?.Id, goal?.Progress ?? 0,
					gm?.Members?.Count( m => m.IsOnline ) ?? 0,   // member head dots
					_postNoteLive )                                // POST OFFER note swap
			),
			// v3 beast art: hero idle frames (multi-frame species only), the
			// trade slips' favorite ids, the banner emblem, the lead-beast fallback.
			HashCode.Combine(
				_heroAnimated ? SpriteAnimator.GlobalFrame : 0,
				GetOnlineFavHash(),
				gm?.Guild?.EmblemIcon,
				gm?.Guild?.EmblemColor,
				MonsterManager.Instance?.OwnedMonsters?.Count ?? 0,
				MonsterManager.Instance?.OwnedMonsters?.FirstOrDefault( m => m.IsFavorite )?.SpeciesId,
				tamer?.CollectedCards?.Count ?? 0   // by-name avatar map input (the online set is hashed above)
			)
		);
	}

