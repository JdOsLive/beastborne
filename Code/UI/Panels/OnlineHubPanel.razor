	// Honors GuildManager.UiEnabled so the beta build never shows guild UI even
	// if the local player is still a member of a guild from prior testing.
	private bool IsInGuild() => GuildManager.UiEnabled && (GuildManager.Instance?.IsInGuild ?? false);

	// BuildHash drives re-render reactivity. Every state field that affects
	// rendering lives here — the five-zone landing adds the zone cursor
	// (_kbZone), the rail (railOpen), the compact leaderboards (category,
	// loading, per-category counts), the battle identity (record/streak/
	// points), and the guild corner (membership, online count, goal).
	protected override int BuildHash()
	{
		var vcm = VoiceChatManager.Instance;
		var tamer = TamerManager.Instance?.CurrentTamer;
		var gm = GuildManager.Instance;
		var goal = gm?.WeeklyGoals?.FirstOrDefault( g => !g.Claimed );
		int devSalt = _devFakeTrades ? 1 : 0;   // dev sample-slips toggle must re-render
		return devSalt + System.HashCode.Combine(
			HashCode.Combine(
				currentSection,
				selectedKind,
				selectedOnlinePlayer?.ConnectionId,
				showFavSelector,
				railOpen,
				IsConnected() ? Connection.All.Count : 0,
				ChatManager.Instance?.PlayerProfiles?.Count ?? 0,
				HashCode.Combine( _kbZone, _kbIndex, _kbActive,
					// The landing is gated on IsArenaActive — hash the state it reads
					// (F5, 2026-08-29 audit), plus the identity bits the rail/heads show.
					CompetitiveManager.Instance?.CurrentState ?? CompetitiveManager.ArenaState.Idle,
					tamer?.Level ?? 0,
					gm?.Guild?.Name, gm?.Guild?.Tag, gm?.Guild?.Level ?? 0 )
			),
			HashCode.Combine(
				vcm?.IsInLobby ?? false,
				vcm?.IsMicActive ?? false,
				vcm?.CurrentRoom?.Members?.Count ?? 0,
				tamer?.FavoriteMonsterSpeciesId,
				hubLbCatIndex,
				hubLbLoading,
				CurrentHubLbEntries().Count
			),
			HashCode.Combine(
				tamer?.ArenaWins ?? 0,
				tamer?.ArenaLosses ?? 0,
				tamer?.ArenaWinStreak ?? 0,
				tamer?.ArenaPoints ?? 0,
				IsInGuild(),
				gm?.OnlineCount ?? 0,
				gm?.Members?.Count ?? 0,
				HashCode.Combine( goal?.Id, goal?.Progress ?? 0,
					gm?.Members?.Count( m => m.IsOnline ) ?? 0,   // member head dots
					_postNoteLive )                                // POST OFFER note swap
			),
			// Trade offers: the source (count + version bump on server fills, the
			// dev sample toggle's own list), the render-cached zone/board counts,
			// and a once-a-minute salt so "2m ago" keeps honest time.
			HashCode.Combine(
				_offersVersion,
				HubOffers.Count,
				_devFakeTrades ? ( _fakeOffers?.Count ?? -1 ) : -2,
				_shownOffers.Count,
				_boardOffers.Count,
				_boardFilter,                     // board filter segment (2026-08-29)
				(int)( Time.Now / 60f )
			),
			// v3 beast art: hero idle frames (multi-frame species only), the
			// trade slips' favorite ids, the banner emblem, the lead-beast fallback.
			HashCode.Combine(
				_heroAnimated ? SpriteAnimator.GlobalFrame : 0,
				GetOnlineFavHash(),
				gm?.Guild?.EmblemIcon,
				gm?.Guild?.EmblemColor,
				MonsterManager.Instance?.OwnedMonsters?.Count ?? 0,
				MonsterManager.Instance?.OwnedMonsters?.FirstOrDefault( m => m.IsFavorite )?.SpeciesId,
				tamer?.CollectedCards?.Count ?? 0   // by-name avatar map input (the online set is hashed above)
			)
		);
	}

	// ── THE BEASTS ARE THE HEROES — sprite sources (v3, 2026-08-28) ─────────

	// QUICKPLAY's hero image is YOUR beast: profile favorite (the same id
	// TamerCards broadcast) → the first starred (IsFavorite) owned beast →
	// the first owned beast → Embrik as the fixed showcase.
	private MonsterSpecies GetHeroQuickSpecies()
	{
		var mm = MonsterManager.Instance;
		if ( mm == null ) return null;
		var favId = TamerManager.Instance?.CurrentTamer?.FavoriteMonsterSpeciesId;
		var s = !string.IsNullOrEmpty( favId ) ? mm.GetSpecies( favId ) : null;
		if ( s == null )
		{
			var owned = mm.OwnedMonsters;
			var lead = owned?.FirstOrDefault( m => m.IsFavorite ) ?? owned?.FirstOrDefault();
			if ( lead != null && !string.IsNullOrEmpty( lead.SpeciesId ) ) s = mm.GetSpecies( lead.SpeciesId );
		}
		return s ?? mm.GetSpecies( "embrik" );
	}

	// Fixed showcase species for RANKED / PRACTICE, with an alternate so the
	// same beast never appears twice across the hero.
	private MonsterSpecies GetHeroFixedSpecies( string primaryId, string altId, MonsterSpecies avoid )
	{
		var mm = MonsterManager.Instance;
		if ( mm == null ) return null;
		var s = mm.GetSpecies( primaryId );
		if ( s == null || ( avoid != null && s.Id == avoid.Id ) ) s = mm.GetSpecies( altId ) ?? s;
		return s;
	}

	// Integer-scaled sprite box — pixel art only scales cleanly by whole
	// numbers, so the hero sprites size to the largest k with k × source ≤
	// box (a 96px sprite in a 320 box = 3× = 288). Source dimensions come
	// from Texture.Load once per path (static cache; the MonsterBillboard
	// precedent).
	private static readonly Dictionary<string, (int w, int h)> _spriteDims = new();

	private static (int w, int h) SpriteDims( MonsterSpecies s )
	{
		if ( s == null || string.IsNullOrEmpty( s.IconPath ) ) return (96, 96);
		if ( !_spriteDims.TryGetValue( s.IconPath, out var d ) )
		{
			d = (96, 96);
			try
			{
				var tex = Texture.Load( FileSystem.Mounted, s.IconPath );
				if ( tex != null && tex.Width > 0 && tex.Height > 0 ) d = (tex.Width, tex.Height);
			}
			catch { }
			_spriteDims[s.IconPath] = d;
		}
		return d;
	}

	private static (int w, int h) SpriteBox( MonsterSpecies s, int box )
	{
		if ( s == null || string.IsNullOrEmpty( s.IconPath ) ) return (box, box);
		var d = SpriteDims( s );
		int k = Math.Max( 1, box / Math.Max( d.w, d.h ) );
		return (d.w * k, d.h * k);
	}

	// VIEWPORT CROP for the trade-slip beast tiles (2026-08-29 user ask:
	// "make the beasts bigger on the trade offers — like cut off part of its
	// body"). The tile is a T×T window onto the NATIVE sprite: the <img>
	// renders at its source size (80 / 96 / 128 across the roster — read
	// once via SpriteDims), IN-FLOW, pulled up/left by negative margins so
	// the head + upper body fill the square. No scaling ever, no filter, no
	// transform — the compositor never touches the pixels. Bias: 45% of the
	// horizontal overflow (a hair left of centre — sprites face LEFT, the
	// head sits upper-left/centre) and 22% of the vertical (the head band,
	// not the belly). 96 in 40 → −25 / −12 · 96 in 48 → −22 / −11 · 80 in 40
	// → −18 / −9 · 128 in 48 → −36 / −18.
	private static (int w, int h, int ml, int mt) SpriteCrop( MonsterSpecies s, int tile )
	{
		var d = SpriteDims( s );
		int ml = -(int)Math.Round( Math.Max( 0, d.w - tile ) * 0.45f );
		int mt = -(int)Math.Round( Math.Max( 0, d.h - tile ) * 0.22f );
		return (d.w, d.h, ml, mt);
	}

	// Inline style for the crop — whole pixels, so no culture formatting risk.
	private static string CropStyle( (int w, int h, int ml, int mt) c )
		=> $"width: {c.w}px; height: {c.h}px; min-width: {c.w}px; margin-left: {c.ml}px; margin-top: {c.mt}px";

	// Idle-animated frame for the three hero sprites (BeastiaryPanel's
	// GetAnimatedIcon precedent). Flags _heroAnimated so BuildHash only
	// tracks SpriteAnimator.GlobalFrame when a hero species actually has
	// more than one frame — the handmade launch roster ships single-frame
	// idles, so the landing does NOT re-render at 8fps for nothing.
	private bool _heroAnimated;

	private string GetAnimatedIcon( MonsterSpecies species )
	{
		if ( species == null ) return "ui/monsters/default.png";
		if ( species.AnimationFrames != null && species.AnimationFrames.Count > 1 )
		{
			_heroAnimated = true;
			int frameIndex = SpriteAnimator.GlobalFrame % species.AnimationFrames.Count;
			return species.AnimationFrames[frameIndex];
		}
		return species.IconPath ?? "ui/monsters/default.png";
	}

	// RANKED block — the nine-tier ladder (CompetitiveManager.GetRankFromPoints
	// thresholds). Returns the current tier's floor and the next tier's
	// threshold; at Mythic floor == next (bar full).
	private static readonly int[] RankSteps = { 0, 200, 400, 700, 1000, 1500, 2000, 3000, 5000 };
	private const int RankBarWidth = 180; // row 2 of the rank block: bar 180 · spacer · N / M (300 lane)

	private static (int floor, int next) RankBand( int points )
	{
		int floor = 0, next = RankSteps[1];
		for ( int i = 0; i < RankSteps.Length; i++ )
		{
			if ( points < RankSteps[i] ) break;
			floor = RankSteps[i];
			next = i + 1 < RankSteps.Length ? RankSteps[i + 1] : RankSteps[i];
		}
		return (floor, next);
	}

	// Leaderboard row avatars — Board2.Entry.SteamId arrives as 0 from the
	// service in practice, so rows resolve a Steam id BY DISPLAY NAME from
	// the people we do know: (b) collected TamerCards (offline-friendly,
	// lowest authority — written first so live data overwrites), (a) the
	// online presence set, (c) you (Steam display name AND tamer name).
	// Case-insensitive. Rows with no hit keep the neutral diamond — honest.
	private Dictionary<string, long> BuildAvatarByName( List<OnlinePlayerInfo> others )
	{
		var map = new Dictionary<string, long>( StringComparer.OrdinalIgnoreCase );

		var cards = TamerManager.Instance?.CurrentTamer?.CollectedCards;
		if ( cards != null )
		{
			foreach ( var c in cards )
			{
				if ( c == null || c.SteamId <= 0 || string.IsNullOrEmpty( c.Name ) ) continue;
				map[c.Name] = c.SteamId;
			}
		}

		foreach ( var p in others )
		{
			if ( p.SteamId <= 0 || string.IsNullOrEmpty( p.Name ) ) continue;
			map[p.Name] = p.SteamId;
		}

		long mine = GetLocalSteamId();
		if ( mine > 0 )
		{
			var steamName = Connection.Local?.DisplayName;
			if ( !string.IsNullOrEmpty( steamName ) ) map[steamName] = mine;
			var tamerName = TamerManager.Instance?.CurrentTamer?.Name;
			if ( !string.IsNullOrEmpty( tamerName ) ) map[tamerName] = mine;
		}
		return map;
	}

	// Pull a "#rrggbb" color t of the way toward the zone slab tone
	// (#15121f). Anything that isn't a 6-digit hex passes through untouched.
	private static string BlendTowardSlab( string hex, float t )
	{
		const int sr = 0x15, sg = 0x12, sb = 0x1f;
		if ( string.IsNullOrEmpty( hex ) || hex.Length != 7 || hex[0] != '#' ) return hex;
		try
		{
			int r = Convert.ToInt32( hex.Substring( 1, 2 ), 16 );
			int g = Convert.ToInt32( hex.Substring( 3, 2 ), 16 );
			int b = Convert.ToInt32( hex.Substring( 5, 2 ), 16 );
			r = Math.Clamp( (int)Math.Round( r + (sr - r) * t ), 0, 255 );
			g = Math.Clamp( (int)Math.Round( g + (sg - g) * t ), 0, 255 );
			b = Math.Clamp( (int)Math.Round( b + (sb - b) * t ), 0, 255 );
			return $"#{r:x2}{g:x2}{b:x2}";
		}
		catch
		{
			return hex;
		}
	}

	// BuildHash ingredient — the online tamers' favorite ids, levels and
	// title colors (a profile broadcast can change any of these without
	// changing the profile count).
	private int GetOnlineFavHash()
	{
		var profiles = ChatManager.Instance?.PlayerProfiles;
		if ( profiles == null ) return 0;
		int h = 17;
		foreach ( var kv in profiles )
			h = HashCode.Combine( h, kv.Value?.FavoriteMonsterSpeciesId, kv.Value?.Level ?? 0, kv.Value?.TitleColor );
		return h;
	}

	// Guild banner emblem — the beast-emblem ruling, renderer side only:
	// an EmblemIcon of "beast:<speciesId>" renders that species' sprite on
	// the pennant; anything else falls back to the lucide map. The picker
	// lands later (GuildManager untouched).
	private MonsterSpecies GetGuildEmblemBeast()
	{
		var icon = GuildManager.Instance?.Guild?.EmblemIcon;
		if ( string.IsNullOrEmpty( icon ) || !icon.StartsWith( "beast:" ) ) return null;
		return MonsterManager.Instance?.GetSpecies( icon.Substring( 6 ) );
	}

