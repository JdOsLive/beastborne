			new( "dev-3", "Kestrel",     0, "#3f8fe0", male,   Pick( 4, "sheepot" ),  Pick( 0, "loomweaver" ), now.AddHours( -1 ),    true ),
			new( "dev-4", "Bramblewick", 0, "#e8a33c", male,   "dawnmote",            Pick( 2, "wishlift" ),   now.AddHours( -3 ),    false ),
