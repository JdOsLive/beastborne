	// .claude/design-system/components/online-fightnight-v2.html §9):
	// - QuickplayEnabled — the unranked ghost-battle path (Scope A, shipped
	//   dark in CompetitiveManager). Flips true when quickplay ships.
	// - RankedEnabled — real synchronous PvP (Scope B, v1.3). Ranked points
	//   NEVER attach to ghost battles (mirror-substrate ruling).
	// Either flag on = the battle section is reachable.
	private const bool QuickplayEnabled = false;
	private const bool RankedEnabled = false;
