	private void OnRankedChip()
	{
		// Interactive-looking always; while RankedEnabled is false the press is
		// a quiet deny — no countdown, no drama (v3 ruling). Live → the arena.
		if ( !RankedLive ) { SoundManager.PlayDeny(); return; }
		SwitchTab( "ranked" );
	}

	// POST OFFER — inert until the server standing-offer board ships. A
	// press is never dead: the tile's sub-line swaps to "Coming with the
	// trade board" for 3s (quiet click, not a deny — nothing is wrong).
	private void OnPostOffer()
	{
		SoundManager.PlayClick();
		_postNoteUntil = Time.Now + 3f;
		_postNoteLive = true;
		StateHasChanged();
	}

	// Battle access is TWO flags (build sequencing 2026-08-28, see
	// .claude/design-system/components/online-fightnight-v2.html §9):
	// - QuickplayEnabled — the unranked ghost-battle path (Scope A, shipped
	//   dark in CompetitiveManager). Flips true when quickplay ships.
	// - RankedEnabled — real synchronous PvP (Scope B, v1.3). Ranked points
	//   NEVER attach to ghost battles (mirror-substrate ruling).
	// Either flag on = the battle section is reachable.
	private const bool QuickplayEnabled = false;
	private const bool RankedEnabled = false;
	private static bool BattleEnabled => QuickplayEnabled || RankedEnabled;
	// Property (not the const) at the use sites so the day-one `false` doesn't
	// trip CS0162 unreachable-code warnings in the generated render tree.
	private static bool RankedLive => RankedEnabled;

	private void SwitchTab( string section )
	{
		// Card and Voice tabs were merged into the Tamers tab. Anything still calling
		// SwitchTab("card") or SwitchTab("voice") gets redirected so we don't leak the
		// dead branches into UI state.
		if ( section == "card" || section == "voice" ) section = "players";
		if ( !BattleEnabled && section == "ranked" ) section = "players";
		if ( !GuildManager.UiEnabled && section == "guild" ) section = "players";
		if ( currentSection == section ) return;
		SoundManager.PlayClick();
		currentSection = section;
		ResetSelection();
		// The board's cursor lands on the first CARD (else POST OFFER) — the
		// slab cursor is the board's one costume until W reaches the button.
		if ( section == "board" )
		{
			_boardFilter = 0; // the board opens on ALL
			_kbZone = "board";
			_kbIndex = CurrentOffers().Count > 0 ? BoardCardKbBase : 0;
			_boardFollowPending = true;
		}
	}

	private void BackToHub()
	{
		SoundManager.PlayBack();
		currentSection = "players";
		ResetSelection();
	}

	private void ResetSelection()
	{
		showFavSelector = false;
		selectedKind = "self";
		selectedOnlinePlayer = null;
		railOpen = false;
		// The cursor rests on FIND A BATTLE whenever the landing (re)opens.
		_kbZone = "battle";
		_kbIndex = 0;
		_kbActive = true;
	}

