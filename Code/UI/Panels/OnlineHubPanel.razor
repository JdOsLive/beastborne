	// Fixed showcase species for RANKED / PRACTICE, with an alternate so the
	// same beast never appears twice across the hero.
	private MonsterSpecies GetHeroFixedSpecies( string primaryId, string altId, MonsterSpecies avoid )
	{
		var mm = MonsterManager.Instance;
		if ( mm == null ) return null;
