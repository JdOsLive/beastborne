@namespace Beastborne.UI.Panels
@using System;
@using System.Linq;
@using Sandbox;
@using Sandbox.UI;
@using Sandbox.Network;
@using Beastborne.Core;
@using Beastborne.Data;
@using Beastborne.Systems;
@using Beastborne.UI.Components;
@inherits Panel

<div class="online-hub @($"bg-{currentSection}")" onclick=@OnPanelClicked>
	<div class="online-hub-overlay"></div>

	<!-- Compact Header + Tabs in one row -->
	<div class="hub-header-row">
		<div class="hub-title-group">
			<img class="hub-title-icon" src="ui/icons/online.svg" />
			<span class="hub-title">@L("ui.online.title")</span>
		</div>

		<div class="hub-pills">
				<div class="hub-pill pill-players @(currentSection == "players" ? "active" : "")"
					 onmouseover=@(() => { if (hoveredTab != "players") { hoveredTab = "players"; SoundManager.PlayHover(); } })
					 onmouseout=@(() => hoveredTab = null)
					 onclick=@(() => { SoundManager.PlayClick(); SwitchTab("players"); })>
					<img class="pill-icon" src="ui/icons/tabs/players.svg" />
					<span class="pill-label">@L("ui.online.players")</span>
				</div>
				<div class="hub-pill pill-leaderboards @(currentSection == "leaderboards" ? "active" : "")"
					 onmouseover=@(() => { if (hoveredTab != "leaderboards") { hoveredTab = "leaderboards"; SoundManager.PlayHover(); } })
					 onmouseout=@(() => hoveredTab = null)
					 onclick=@(() => { SoundManager.PlayClick(); SwitchTab("leaderboards"); })>
					<img class="pill-icon" src="ui/icons/tabs/leaderboards.svg" />
					<span class="pill-label">@L("ui.online.leaderboards")</span>
				</div>
				@* Card and Voice tabs merged into Tamers — kept commented for diff context.
				<div class="hub-pill pill-card ..."> ... Card pill removed
				<div class="hub-pill pill-voice ..."> ... Voice pill removed
				*@
				@* Guild tab hidden for beta launch via GuildManager.UiEnabled.
				   Flip the const back to true to restore. SwitchTab("guild") and
				   the content branch below are also gated so deep-links bounce. *@
				@if ( GuildManager.UiEnabled )
				{
					<div class="hub-pill pill-guild @(currentSection == "guild" ? "active" : "")"
						 onmouseover=@(() => { if (hoveredTab != "guild") { hoveredTab = "guild"; SoundManager.PlayHover(); } })
						 onmouseout=@(() => hoveredTab = null)
						 onclick=@(() => { SoundManager.PlayClick(); SwitchTab("guild"); })>
						<img class="pill-icon" src="ui/icons/tabs/guild.svg" />
						<span class="pill-label">@L("ui.online.guild")</span>
					</div>
				}
				@* Battle tab — hidden for v1.2.0, reshipping in v1.3+. Flip RankedEnabled to true to restore.
				<div class="hub-pill pill-arena @(currentSection == "ranked" ? "active" : "")"
					 onmouseover=@(() => { if (hoveredTab != "ranked") { hoveredTab = "ranked"; SoundManager.PlayHover(); } })
					 onmouseout=@(() => hoveredTab = null)
					 onclick=@(() => { SoundManager.PlayClick(); SwitchTab("ranked"); })>
					<img class="pill-icon" src="ui/icons/tabs/arena.svg" />
					<span class="pill-label">Battle</span>
				</div>
				*@
				<div class="kb-hint hub-kb-hint">
					<div class="cb-key kb-cap"><span>&lt;</span></div>
					<div class="cb-key kb-cap"><span>&gt;</span></div>
					<span class="kb-hint-label">Cycle</span>
				</div>
			</div>

		<div class="hub-status">
			<span class="status-dot @(IsConnected() ? "connected" : "")"></span>
			<span class="status-text">@GetConnectionStatus()</span>
		</div>
	</div>

	<!-- Tab Content -->
	@if ( currentSection == "players" && !IsArenaActive() )
	{
		@{
			var otherPlayers = IsConnected() ? GetOnlinePlayers().Where( p => !p.IsLocal ).ToList() : new();
			var vcm = VoiceChatManager.Instance;
			var inLobbyVoice = vcm?.IsInLobby ?? false;
			var lobbyMembers = vcm?.Rooms?.FirstOrDefault( r => r.IsLobby )?.Members?.Count ?? 0;
			var favBeastSpecies = GetFavoriteSpeciesForDisplay();
			var beastElementClass = favBeastSpecies?.Element.ToString().ToLower() ?? "";
			// If our selection went stale (online player disconnected), fall back to self.
			if ( selectedKind == "online" && (selectedOnlinePlayer == null || !otherPlayers.Any( p => p.ConnectionId == selectedOnlinePlayer.ConnectionId )) )
			{
				selectedKind = "self";
				selectedOnlinePlayer = null;
			}
		}

		<div class="tamers-content">

			<!-- Voice strip (lobby-only for launch) — only shown when online -->
			@if ( IsConnected() && vcm != null )
			{
				<div class="voice-strip">
					<div class="voice-strip-pill lobby @(inLobbyVoice ? "active" : "")"
						 onmouseover=@(() => SoundManager.PlayHover())
						 onclick=@ToggleLobbyVoice>
						<iconify icon="lucide:volume-2" Size=@(15) Color="@(inLobbyVoice ? "#4ade80" : "#a78bfa")" />
						<span class="voice-strip-label">@(inLobbyVoice ? "In Lobby Voice" : "Join Lobby Voice")</span>
						<span class="voice-strip-count">@lobbyMembers</span>
					</div>
					@if ( inLobbyVoice )
					{
						<div class="voice-strip-pill mic"
							 onmouseover=@(() => SoundManager.PlayHover())
							 onclick=@ToggleMic>
							<iconify icon="@(vcm.IsMicActive ? "lucide:mic" : "lucide:mic-off")" Size=@(15) Color="@(vcm.IsMicActive ? "#4ade80" : "rgba(255,255,255,0.5)")" />
							<span class="voice-strip-label">@(vcm.IsMicActive ? "Mic On" : "Mic Off")</span>
						</div>
					}
					<div class="voice-strip-spacer"></div>
					<div class="voice-strip-hint">
						<span>Lobby voice connects everyone in the hub</span>
					</div>
				</div>
			}

			<!-- Split layout: grid + detail sidebar -->
			<div class="collection-layout with-detail">

				<div class="collection-main" @ref="tamersScroll">

					<!-- ONLINE NOW section -->
					<div class="tamers-section">
						<div class="tamers-section-header">
							<span class="tamers-section-label">ONLINE NOW</span>
							<span class="tamers-section-count">@(otherPlayers.Count + 1)</span>
						</div>
						<div class="tamers-grid">
							<!-- YOU tile (always first, default selection) -->
							@{
								var youSelected = selectedKind == "self";
							}
							<div class="tamer-tile you-tile @(youSelected ? "selected" : "") @(_kbActive && _kbIndex == 0 ? "online-kb-selected" : "")"
								 onmouseover=@(() => SoundManager.PlayHover())
								 onclick=@SelectSelf>
								<!-- P5 stamp layers: color block, halftone, diagonal rail, corner cut -->
								<div class="tile-bg-block"></div>
								<div class="tile-halftone"></div>
								<div class="tile-corner-cut"></div>
								<div class="tile-rail-bar"></div>
								<div class="tile-index-stamp"><span>01</span></div>
								@if ( youSelected )
								{
									<div class="tile-selected-stamp"><span>YOU</span></div>
								}
								@{
									var localSteam = GetLocalSteamId();
									var localTitleColorYou = GetLocalTitleColor();
								}
								<div class="tile-avatar @(localSteam > 0 ? "steam" : "cartoon") @GetTamerGender()" style="border-color: @localTitleColorYou">
									@if ( localSteam > 0 )
									{
										<img src="avatar:@localSteam" />
									}
									else
									{
										<img src="@GetGenderAvatar()" />
									}
								</div>
								<div class="tile-info">
									@if ( IsDev() )
									{
										<div class="dev-badge"><span>DEV</span></div>
									}
									<div class="tile-name-row">
										@if ( IsInGuild() )
										{
											<span class="tile-guild-tag" style="color: @(GuildManager.Instance?.Guild?.EmblemColor ?? "#7c3aed")">@($"[{GuildManager.Instance?.Guild?.Tag}]")</span>
										}
										<span class="tile-name @(IsDev() ? "dev" : "")">@GetPlayerName()</span>
									</div>
									<span class="tile-role" style="color: @localTitleColorYou">@GetLocalTitle()</span>
								</div>
								<div class="tile-level-pill"><span class="tile-level-pill-num">@($"LV {GetPlayerLevel()}")</span></div>
							</div>

							<!-- Other online players -->
							@for ( int oi = 0; oi < otherPlayers.Count; oi++ )
							{
								var player = otherPlayers[oi];
								var kbIdx = oi + 1;
								var pSelected = selectedKind == "online" && selectedOnlinePlayer?.ConnectionId == player.ConnectionId;
								<div class="tamer-tile @(player.HasProfile ? "" : "no-profile") @(pSelected ? "selected" : "") @(_kbActive && _kbIndex == kbIdx ? "online-kb-selected" : "")"
									 onmouseover=@(() => SoundManager.PlayHover())
									 onclick=@(() => SelectOnline( player ))>
									<!-- P5 stamp layers -->
									<div class="tile-bg-block"></div>
									<div class="tile-halftone"></div>
									<div class="tile-corner-cut"></div>
									<div class="tile-rail-bar"></div>
									@if ( pSelected )
									{
										<div class="tile-selected-stamp"><span>SEL</span></div>
									}
									@if ( player.SteamId > 0 )
									{
										<div class="tile-avatar steam @player.GenderClass" style="border-color: @player.TitleColor">
											<img src="avatar:@player.SteamId" />
											<div class="tile-online-dot"></div>
										</div>
									}
									else if ( player.HasProfile )
									{
										<div class="tile-avatar cartoon @player.GenderClass" style="border-color: @player.TitleColor">
											<img src="@player.AvatarPath" />
											<div class="tile-online-dot"></div>
										</div>
									}
									else
									{
										<div class="tile-avatar no-profile-avatar">
											<div class="tile-indicator"></div>
										</div>
									}
									<div class="tile-info">
										@if ( player.IsDev )
										{
											<div class="dev-badge"><span>DEV</span></div>
										}
										<div class="tile-name-row">
											@if ( GuildManager.UiEnabled && !string.IsNullOrEmpty( player.GuildTag ) )
											{
												<span class="tile-guild-tag">@($"[{player.GuildTag}]")</span>
											}
											<span class="tile-name @(player.IsDev ? "dev" : "")">@player.Name</span>
										</div>
										<span class="tile-role" style="color: @player.TitleColor">@player.Title</span>
									</div>
									@if ( player.Level > 0 )
									{
										<div class="tile-level-pill"><span class="tile-level-pill-num">@($"LV {player.Level}")</span></div>
									}
								</div>
							}
						</div>

						@if ( IsConnected() && otherPlayers.Count == 0 )
						{
							<div class="alone-notice">
								<span class="alone-text">You're the only one here</span>
								<span class="alone-hint">Other tamers will appear when they connect</span>
							</div>
						}
					</div>

				</div>

				<!-- Detail sidebar -->
				<div class="detail-sidebar">
					<div class="td-card">
						@if ( selectedKind == "self" )
						{
							@{
								var heroSteam = GetLocalSteamId();
								var localTitleColor = GetLocalTitleColor();
								var xpPct = GetXpPercent();
								var xpPctStr = (xpPct * 100f).ToString( "F1", System.Globalization.CultureInfo.InvariantCulture );
							}

							<!-- Hero / Portrait section -->
							<div class="tamer-portrait-section">
								<div class="tamer-portrait-wrapper">
									<div class="tamer-portrait-frame @(heroSteam > 0 ? "steam" : "cartoon") @GetTamerGender()" style="border-color: @localTitleColor">
										@if ( heroSteam > 0 )
										{
											<img class="tamer-portrait-img" src="avatar:@heroSteam" />
										}
										else
										{
											<img class="tamer-portrait-img cartoon-img" src="@GetGenderAvatar()" />
										}
									</div>
									<div class="tamer-portrait-level"><span class="tamer-portrait-level-num">@($"LV {GetPlayerLevel()}")</span></div>
									@if ( IsDev() )
									{
										<div class="tamer-portrait-dev"><span>DEV</span></div>
									}
								</div>
								<div class="tamer-portrait-info">
									<div class="tamer-name-row">
										<span class="tamer-name @(IsDev() ? "dev" : "")">@GetPlayerName()</span>
									</div>
									<div class="tamer-title-row">
										<span class="tamer-title-text" style="color: @localTitleColor">@GetLocalTitle()</span>
									</div>
									@if ( IsInGuild() )
									{
										<div class="tamer-guild-row">
											<iconify icon="lucide:shield" Size=@(11) Color="@(GuildManager.Instance?.Guild?.EmblemColor ?? "#7c3aed")" />
											<span class="tamer-guild-text" style="color: @(GuildManager.Instance?.Guild?.EmblemColor ?? "#7c3aed")">@($"[{GuildManager.Instance?.Guild?.Tag}] {GuildManager.Instance?.Guild?.Name}")</span>
										</div>
									}
									<div class="tamer-xp-bar">
										<div class="tamer-xp-fill" style="width: @(xpPctStr)%"></div>
									</div>
								</div>
							</div>

							<!-- ACTIONS -->
							<div class="tamer-detail-section-header">
								<span class="tamer-detail-section-text">ACTIONS</span>
							</div>
							<div class="tamer-actions">
								<div class="tamer-action primary"
									 onmouseover=@(() => SoundManager.PlayHover())
									 onclick=@ShowcaseCard>
									<iconify icon="lucide:share-2" Size=@(14) Color="#d4bfff" />
									<span class="tamer-action-label">Share to Chat</span>
								</div>
							</div>

							<!-- STATS -->
							<div class="tamer-detail-section-header">
								<span class="tamer-detail-section-text">STATS</span>
							</div>
							<div class="tamer-stats">
								<div class="tamer-stat">
									<span class="tamer-stat-val">@($"{GetMonstersCaught()}")</span>
									<span class="tamer-stat-label">CAUGHT</span>
								</div>
								<div class="tamer-stat">
									<span class="tamer-stat-val">@($"{GetAchievementCount()}")</span>
									<span class="tamer-stat-label">ACHV</span>
								</div>
								<div class="tamer-stat">
									<span class="tamer-stat-val">@GetPlayTimeForCard()</span>
									<span class="tamer-stat-label">TIME</span>
								</div>
								<div class="tamer-stat">
									<span class="tamer-stat-val">@($"{GetBattlesWon()}")</span>
									<span class="tamer-stat-label">WINS</span>
								</div>
							</div>

							<!-- FAVORITE BEAST -->
							<div class="tamer-detail-section-header">
								<span class="tamer-detail-section-text">FAVORITE BEAST</span>
							</div>
							<div class="tamer-fav-box @beastElementClass">
								@if ( showFavSelector )
								{
									<div class="tamer-fav-dropdown">
										<div class="tamer-fav-opt" onclick=@(() => SetFavorite( null ))>
											<span class="tamer-fav-opt-name">None</span>
										</div>
										@foreach ( var species in GetDiscoveredSpeciesList() )
										{
											<div class="tamer-fav-opt" onclick=@(() => SetFavorite( species.Id ))>
												@if ( !string.IsNullOrEmpty( species.IconPath ) )
												{
													<img class="tamer-fav-opt-icon" src="@species.IconPath" />
												}
												<span class="tamer-fav-opt-name">@species.Name</span>
											</div>
										}
									</div>
								}
								else
								{
									<div class="tamer-fav-display" onclick=@OpenFavSelector>
										<div class="tamer-fav-portrait">
											@if ( favBeastSpecies != null && !string.IsNullOrEmpty( favBeastSpecies.IconPath ) )
											{
												<img class="tamer-fav-portrait-img" src="@favBeastSpecies.IconPath" style="margin-left: @(favBeastSpecies.IconOffsetX - 18)px; margin-top: @(favBeastSpecies.IconOffsetY)px" />
											}
											else
											{
												<iconify icon="lucide:circle-help" Size=@(28) Color="rgba(255,255,255,0.3)" />
											}
										</div>
										<span class="tamer-fav-name">@GetFavoriteName()</span>
										<span class="tamer-fav-change">Change</span>
									</div>
								}
							</div>
						}
						else if ( selectedKind == "online" && selectedOnlinePlayer != null )
						{
							@{
								var p = selectedOnlinePlayer;
								var isMutedFlag = vcm?.IsPlayerMuted( p.ConnectionId ) ?? false;
								var pTitleColor = !string.IsNullOrEmpty( p.TitleColor ) ? p.TitleColor : "#a78bfa";
								var pFavSpecies = !string.IsNullOrEmpty( p.FavoriteMonsterSpeciesId )
									? MonsterManager.Instance?.GetSpecies( p.FavoriteMonsterSpeciesId )
									: null;
								var pElementClass = pFavSpecies?.Element.ToString().ToLower() ?? "";
								var pPlayTime = p.TotalPlayTimeMinutes <= 0
									? "-"
									: ( p.TotalPlayTimeMinutes < 60
										? $"{p.TotalPlayTimeMinutes}m"
										: ( p.TotalPlayTimeMinutes < 60 * 24
											? $"{p.TotalPlayTimeMinutes / 60}h"
											: $"{p.TotalPlayTimeMinutes / (60 * 24)}d" ) );
							}

							<!-- Hero / Portrait section -->
							<div class="tamer-portrait-section">
								<div class="tamer-portrait-wrapper">
									<div class="tamer-portrait-frame @(p.SteamId > 0 ? "steam" : "cartoon") @p.GenderClass" style="border-color: @pTitleColor">
										@if ( p.SteamId > 0 )
										{
											<img class="tamer-portrait-img" src="avatar:@p.SteamId" />
										}
										else
										{
											<img class="tamer-portrait-img cartoon-img" src="@p.AvatarPath" />
										}
									</div>
									@if ( p.Level > 0 )
									{
										<div class="tamer-portrait-level"><span class="tamer-portrait-level-num">@($"LV {p.Level}")</span></div>
									}
									@if ( p.IsDev )
									{
										<div class="tamer-portrait-dev"><span>DEV</span></div>
									}
								</div>
								<div class="tamer-portrait-info">
									<div class="tamer-name-row">
										<span class="tamer-name @(p.IsDev ? "dev" : "")">@p.Name</span>
									</div>
									<div class="tamer-title-row">
										<span class="tamer-title-text" style="color: @pTitleColor">@p.Title</span>
									</div>
									@if ( GuildManager.UiEnabled && !string.IsNullOrEmpty( p.GuildTag ) )
									{
										<div class="tamer-guild-row">
											<iconify icon="lucide:shield" Size=@(11) Color="#c084fc" />
											<span class="tamer-guild-text">@($"[{p.GuildTag}] {p.GuildName ?? ""}")</span>
										</div>
									}
									<div class="tamer-online-pill">
										<span class="tamer-online-dot"></span>
										<span class="tamer-online-text">ONLINE NOW</span>
									</div>
								</div>
							</div>

							<!-- ACTIONS -->
							<div class="tamer-detail-section-header">
								<span class="tamer-detail-section-text">ACTIONS</span>
							</div>
							<div class="tamer-actions tamer-actions-grid">
								<div class="tamer-action primary"
									 onmouseover=@(() => SoundManager.PlayHover())
									 onclick=@(() => RequestTrade( p ))>
									<iconify icon="lucide:handshake" Size=@(14) Color="#4ade80" />
									<span class="tamer-action-label">Trade</span>
								</div>
								<div class="tamer-action @(inLobbyVoice ? "active" : "")"
									 onmouseover=@(() => SoundManager.PlayHover())
									 onclick=@JoinLobbyVoice>
									<iconify icon="lucide:volume-2" Size=@(14) Color="#a78bfa" />
									<span class="tamer-action-label">Voice</span>
								</div>
								<div class="tamer-action @(isMutedFlag ? "muted" : "")"
									 onmouseover=@(() => SoundManager.PlayHover())
									 onclick=@(() => ToggleMutePlayer( p.ConnectionId ))>
									<iconify icon="@(isMutedFlag ? "lucide:mic-off" : "lucide:mic")" Size=@(14) Color="@(isMutedFlag ? "#f87171" : "rgba(255,255,255,0.7)")" />
									<span class="tamer-action-label">@(isMutedFlag ? "Unmute" : "Mute")</span>
								</div>
							</div>

							@if ( p.HasProfile )
							{
								<!-- STATS -->
								<div class="tamer-detail-section-header">
									<span class="tamer-detail-section-text">STATS</span>
								</div>
								<div class="tamer-stats">
									<div class="tamer-stat">
										<span class="tamer-stat-val">@p.MonstersCaught.ToString("N0")</span>
										<span class="tamer-stat-label">CAUGHT</span>
									</div>
									<div class="tamer-stat">
										<span class="tamer-stat-val">@p.AchievementCount.ToString("N0")</span>
										<span class="tamer-stat-label">ACHV</span>
									</div>
									<div class="tamer-stat">
										<span class="tamer-stat-val">@pPlayTime</span>
										<span class="tamer-stat-label">TIME</span>
									</div>
									<div class="tamer-stat">
										<span class="tamer-stat-val">@p.BattlesWon.ToString("N0")</span>
										<span class="tamer-stat-label">WINS</span>
									</div>
								</div>

								@if ( pFavSpecies != null )
								{
									<!-- FAVORITE BEAST (read-only) -->
									<div class="tamer-detail-section-header">
										<span class="tamer-detail-section-text">FAVORITE BEAST</span>
									</div>
									<div class="tamer-fav-box @pElementClass">
										<div class="tamer-fav-display readonly">
											<div class="tamer-fav-portrait">
												<img class="tamer-fav-portrait-img" src="@pFavSpecies.IconPath" style="margin-left: @(pFavSpecies.IconOffsetX - 18)px; margin-top: @(pFavSpecies.IconOffsetY)px" />
											</div>
											<span class="tamer-fav-name">@pFavSpecies.Name</span>
										</div>
									</div>
								}
							}

							<!-- INFO -->
							<div class="tamer-detail-section-header">
								<span class="tamer-detail-section-text">INFO</span>
							</div>
							<div class="tamer-info-block">
								<div class="tamer-info-row">
									<span class="tamer-info-label">Status</span>
									<span class="tamer-info-value" style="color: #4ade80">@($"Connected")</span>
								</div>
								@if ( GuildManager.UiEnabled && !string.IsNullOrEmpty( p.GuildName ) )
								{
									<div class="tamer-info-row">
										<span class="tamer-info-label">Guild</span>
										<span class="tamer-info-value">@p.GuildName</span>
									</div>
								}
								@if ( p.HasProfile && p.HighestExpedition > 0 )
								{
									<div class="tamer-info-row">
										<span class="tamer-info-label">Stage</span>
										<span class="tamer-info-value">@p.HighestExpedition.ToString("N0")</span>
									</div>
								}
								@if ( p.HasProfile && !string.IsNullOrEmpty( p.ArenaRank ) && p.ArenaRank != "Unranked" )
								{
									<div class="tamer-info-row">
										<span class="tamer-info-label">Rank</span>
										<span class="tamer-info-value">@p.ArenaRank</span>
									</div>
								}
								<div class="tamer-info-row">
									<span class="tamer-info-label">Voice</span>
									<span class="tamer-info-value">@(isMutedFlag ? "Muted by you" : (inLobbyVoice ? "In lobby voice" : "Available"))</span>
								</div>
							</div>
						}
					</div>
				</div>
			</div>
		</div>
	}
	else if ( RankedEnabled && (currentSection == "ranked" || IsArenaActive()) )
	{
		<!-- Ranked Battle - Embeds the full ArenaPanel -->
		<ArenaPanel @ref="arenaPanel" OnBack=@BackToHub />
	}
	else if ( currentSection == "leaderboards" )
	{
		<!-- Leaderboards Section -->
		<LeaderboardPanel @ref="leaderboardRef" OnBack=@BackToHub />
	}
	else if ( GuildManager.UiEnabled && currentSection == "guild" )
	{
		<!-- Guild Section — wrapped in a flex:1 div so the inner GuildPanel
		     reliably claims the column's remaining height. Razor-element
		     style declarations (`GuildPanel { flex: 1 }`) don't always
		     propagate height in s&box; an explicit class wrapper does. -->
		<div class="hub-guild-wrap">
			<GuildPanel @ref="guildRef" OnBack=@BackToHub />
		</div>
	}
</div>

@code {
	// Localization helper
	private string L( string key ) => LocalizationManager.Get( key );
	private string L( string key, params object[] args ) => LocalizationManager.Get( key, args );

	private string currentSection = "players";
	private string hoveredTab = null;
	private LeaderboardPanel leaderboardRef;
	private GuildPanel guildRef;
	private ArenaPanel arenaPanel;
	private bool showFavSelector = false;

	// Tamers tab selection-driven detail. selectedKind ∈ { "self", "online" }.
	// Default is "self" so opening the tab lands on your own card.
	private string selectedKind = "self";
	private OnlinePlayerInfo selectedOnlinePlayer = null;

	// ── Keyboard navigation ─────────────────────────────────────────────────
	// _kbIndex walks the Tamers tile grid: index 0 is the YOU tile, 1..N are the
	// online players in render order. _kbActive gates the cursor visual so the
	// purple kb-selected ring only shows once the player actually uses the
	// keyboard (a fresh mouse-only session stays clean). The tile grid is a
	// flex-wrap layout, so column count is measured live from rendered widths.
	private int _kbIndex = 0;
	private bool _kbActive = false;
	private Panel tamersScroll;
	// Section cycle order for the [ / ] hotkeys. Guild is conditionally present
	// (GuildManager.UiEnabled); CycleSection rebuilds the live list each press.
	private static readonly string[] _sectionCycleBase = { "players", "leaderboards", "guild" };

	private void OnPanelClicked()
	{
		GameHUD.EnterPanel();
	}

	public void TickInput()
	{
		// Ranked battle owns the keyboard entirely while active — keep the
		// existing delegation untouched and bail before any hub nav runs.
		if ( RankedEnabled && (currentSection == "ranked" || IsArenaActive()) )
		{
			arenaPanel?.TickInput();
			return;
		}

		// , / . cycle the section pills (Tamers · Leaderboards · Guild). Works
		// from any section so the player can always jump between them. ( [ / ]
		// stay reserved for the global radio track skip.)
		if ( Input.Pressed( "CyclePrev" ) ) { CycleSection( -1 ); return; }
		if ( Input.Pressed( "CycleNext" ) ) { CycleSection( 1 ); return; }

		// Per-section nav. The hub owns the Tamers tile grid directly; the
		// Leaderboards and Guild sections are self-contained child panels, so
		// the hub delegates their keyboard handling to their own TickInput().
		if ( currentSection == "players" )
		{
			// The favorite-beast selector is a small inline dropdown in the
			// detail sidebar. While it's open, Q closes it (an internal back)
			// instead of falling through to GameHUD's exit-to-tabs — claim the
			// back key that frame so the HUD yields.
			if ( showFavSelector && Input.Pressed( "Menu" ) )
			{
				showFavSelector = false;
				SoundManager.PlayBack();
				GameHUD.PanelHandledBackKey = true;
				StateHasChanged();
				return;
			}
			TickTamersNav();
		}
		else if ( currentSection == "leaderboards" )
		{
			leaderboardRef?.TickInput();
		}
		else if ( currentSection == "guild" )
		{
			guildRef?.TickInput();
		}
	}

	// Cycle to the previous/next section pill, skipping Guild when its UI is
	// gated off for the beta build.
	private void CycleSection( int dir )
	{
		var live = _sectionCycleBase
			.Where( s => s != "guild" || GuildManager.UiEnabled )
			.ToList();
		int i = live.IndexOf( currentSection );
		if ( i < 0 ) i = 0;
		i = ( i + dir + live.Count ) % live.Count;
		SwitchTab( live[i] );
		_kbActive = false;
		StateHasChanged();
	}

	// Arrow/WASD navigation of the Tamers tile grid. Index 0 = the YOU tile,
	// 1..N = online players in render order. Space/Enter commits the selection
	// to the detail sidebar; the grid is flex-wrap so columns are measured live.
	private void TickTamersNav()
	{
		// Tile count = YOU tile + every non-local online player. Mirrors the
		// `otherPlayers` slice the markup builds so indices line up exactly.
		int otherCount = IsConnected()
			? GetOnlinePlayers().Count( p => !p.IsLocal )
			: 0;
		int tileCount = otherCount + 1;
		_kbIndex = Math.Clamp( _kbIndex, 0, tileCount - 1 );

		// Space / Enter — commit the highlighted tile to the detail sidebar.
		if ( Input.Pressed( "Jump" ) || Input.Pressed( "Enter" ) )
		{
			ActivateTamerTile( _kbIndex, otherCount );
			return;
		}

		int columns = GetTamerGridColumns();
		int prev = _kbIndex;

		if ( Input.Pressed( "Left" ) ) _kbIndex = Math.Max( 0, _kbIndex - 1 );
		else if ( Input.Pressed( "Right" ) ) _kbIndex = Math.Min( tileCount - 1, _kbIndex + 1 );
		else if ( Input.Pressed( "Up" ) ) { if ( _kbIndex >= columns ) _kbIndex -= columns; }
		else if ( Input.Pressed( "Down" ) ) _kbIndex = Math.Min( tileCount - 1, _kbIndex + columns );

		if ( _kbIndex != prev )
		{
			_kbActive = true;
			SoundManager.PlayHover();
			// Keep the cursor tile on screen. tamersScroll is the scrolling
			// .collection-main; the tiles are descendants (nested under
			// .tamers-grid), so resolve the index-th .tamer-tile descendant
			// and hand it to UiGridScroll.IntoView directly.
			ScrollTamerTileIntoView( _kbIndex );
			StateHasChanged();
		}
		else if ( !_kbActive && (Input.Pressed( "Up" ) || Input.Pressed( "Down" )
			|| Input.Pressed( "Left" ) || Input.Pressed( "Right" )) )
		{
			// First directional press with the cursor already at a valid tile
			// (e.g. only the YOU tile exists) — still light up the kb cursor.
			_kbActive = true;
			StateHasChanged();
		}
	}

	// Live column count for the flex-wrap tile grid. Measured from the rendered
	// grid width vs. a single tile's width (tiles are a fixed 320px + 10px gap,
	// but reading Box.Rect keeps it correct if the layout ever changes). Falls
	// back to 2 before the first layout pass populates Box.Rect.
	private int GetTamerGridColumns()
	{
		var grid = tamersScroll?.Children?
			.SelectMany( c => c.Children )
			.FirstOrDefault( c => c.HasClass( "tamers-grid" ) );
		float gridW = grid?.Box.Rect.Width ?? 0f;
		var firstTile = grid?.Children?.FirstOrDefault( c => c.HasClass( "tamer-tile" ) );
		float tileW = firstTile?.Box.Rect.Width ?? 0f;
		if ( gridW <= 0f || tileW <= 0f ) return 2;
		return Math.Max( 1, (int)(gridW / tileW) );
	}

	// Scroll .collection-main so the index-th .tamer-tile descendant is fully
	// visible. UiGridScroll.ScrollIndexIntoView only walks direct children, so
	// resolve the descendant ourselves and use the screen-space IntoView path.
	private void ScrollTamerTileIntoView( int index )
	{
		if ( tamersScroll == null || index < 0 ) return;
		var grid = tamersScroll.Children?
			.SelectMany( c => c.Children )
			.FirstOrDefault( c => c.HasClass( "tamers-grid" ) );
		if ( grid == null ) return;
		int n = 0;
		foreach ( var tile in grid.Children )
		{
			if ( !tile.HasClass( "tamer-tile" ) ) continue;
			if ( n == index ) { UiGridScroll.IntoView( tamersScroll, tile ); return; }
			n++;
		}
	}

	// Commit the index-th tile to the detail sidebar. Index 0 is always the
	// local player (SelectSelf); 1..N map into the online-player list.
	private void ActivateTamerTile( int index, int otherCount )
	{
		if ( index <= 0 )
		{
			SelectSelf();
			return;
		}
		var others = GetOnlinePlayers().Where( p => !p.IsLocal ).ToList();
		int pi = index - 1;
		if ( pi >= 0 && pi < others.Count )
			SelectOnline( others[pi] );
	}

	// Battle tab hidden for v1.2.0 — reshipping with polish in v1.3+. Flip to true to restore.
	private const bool RankedEnabled = false;

	private void SwitchTab( string section )
	{
		// Card and Voice tabs were merged into the Tamers tab. Anything still calling
		// SwitchTab("card") or SwitchTab("voice") gets redirected so we don't leak the
		// dead branches into UI state.
		if ( section == "card" || section == "voice" ) section = "players";
		if ( !RankedEnabled && section == "ranked" ) section = "players";
		if ( !GuildManager.UiEnabled && section == "guild" ) section = "players";
		if ( currentSection == section ) return;
		SoundManager.PlayClick();
		currentSection = section;
		ResetSelection();
	}

	private void BackToHub()
	{
		SoundManager.PlayBack();
		currentSection = "players";
		ResetSelection();
	}

	private void ResetSelection()
	{
		showFavSelector = false;
		selectedKind = "self";
		selectedOnlinePlayer = null;
		_kbIndex = 0;
		_kbActive = false;
	}

	private bool IsConnected() => GameNetworkSystem.IsActive;
	private int GetOnlineCount() => IsConnected() ? Connection.All.Count : 0;
	private long GetLocalSteamId() => Connection.Local?.SteamId ?? 0L;

	private string GetConnectionStatus()
	{
		if ( !IsConnected() ) return "Offline";
		return $"{Connection.All.Count} player{(Connection.All.Count != 1 ? "s" : "")} online";
	}

	private bool IsArenaActive()
	{
		var state = CompetitiveManager.Instance?.CurrentState ?? CompetitiveManager.ArenaState.Idle;
		return state != CompetitiveManager.ArenaState.Idle;
	}

	// Local player helpers
	private bool IsDev()
	{
		var devIds = new HashSet<long> { 76561198088759073 };
		var steamId = Connection.Local?.SteamId ?? 0;
		return devIds.Contains( steamId );
	}

	private string GetPlayerName() => TamerManager.Instance?.CurrentTamer?.Name ?? "Tamer";
	private int GetPlayerLevel() => TamerManager.Instance?.CurrentTamer?.Level ?? 1;

	// 0..1 progress through the current tamer level. Used for the sidebar XP bar.
	private float GetXpPercent()
	{
		var tamer = TamerManager.Instance?.CurrentTamer;
		if ( tamer == null ) return 0f;
		var p = tamer.XPProgress;
		if ( p < 0f ) p = 0f;
		if ( p > 1f ) p = 1f;
		return p;
	}

	private string GetLocalTitle()
	{
		var connId = ChatManager.Instance?.LocalConnectionId.ToString();
		if ( connId != null && ChatManager.Instance?.PlayerProfiles?.TryGetValue( connId, out var profile ) == true )
			return profile.Title;
		return "Tamer";
	}

	private string GetLocalTitleColor()
	{
		var connId = ChatManager.Instance?.LocalConnectionId.ToString();
		if ( connId != null && ChatManager.Instance?.PlayerProfiles?.TryGetValue( connId, out var profile ) == true )
			return profile.TitleColor;
		return "#a78bfa";
	}

	private string GetTamerGender() => (TamerManager.Instance?.CurrentTamer?.Gender ?? TamerGender.Male) == TamerGender.Female ? "female" : "male";

	private string GetGenderAvatar()
	{
		var gender = TamerManager.Instance?.CurrentTamer?.Gender ?? TamerGender.Male;
		return gender == TamerGender.Female
			? "ui/characters/female/female_tamer.png"
			: "ui/characters/male/male_tamer.png";
	}

	// Online players
	private List<OnlinePlayerInfo> GetOnlinePlayers()
	{
		if ( !IsConnected() ) return new();

		try
		{
			var devIds = new HashSet<long> { 76561198088759073 };
			var localId = Connection.Local?.Id ?? Guid.Empty;
			var profiles = ChatManager.Instance?.PlayerProfiles;

			return Connection.All
				.Where( c => c != null )
				.Select( c =>
				{
					var connId = c.Id.ToString();
					PlayerProfileData profile = null;
					profiles?.TryGetValue( connId, out profile );

					return new OnlinePlayerInfo
					{
						ConnectionId = connId,
						SteamId = c.SteamId,
						Name = c.DisplayName ?? "Player",
						IsLocal = c.Id == localId,
						IsDev = devIds.Contains( c.SteamId ),
						HasProfile = profile != null,
						GenderClass = profile != null
							? (profile.Gender == "Female" ? "female" : "male")
							: "male",
						AvatarPath = profile != null
							? (profile.Gender == "Female"
								? "ui/characters/female/female_tamer.png"
								: "ui/characters/male/male_tamer.png")
							: "ui/characters/male/male_tamer.png",
						FavoriteExpeditionId = profile?.FavoriteExpeditionId,
						FavoriteMonsterSpeciesId = profile?.FavoriteMonsterSpeciesId,
						Title = profile?.Title ?? "Tamer",
						TitleColor = profile?.TitleColor ?? "#a78bfa",
						GuildTag = profile?.GuildTag,
						GuildName = profile?.GuildName,
						Level = profile?.Level ?? 0,
						MonstersCaught = profile?.MonstersCaught ?? 0,
						BattlesWon = profile?.BattlesWon ?? 0,
						AchievementCount = profile?.AchievementCount ?? 0,
						HighestExpedition = profile?.HighestExpedition ?? 0,
						TotalPlayTimeMinutes = profile?.TotalPlayTimeMinutes ?? 0,
						ArenaRank = profile?.ArenaRank ?? "Unranked",
						ArenaPoints = profile?.ArenaPoints ?? 0
					};
				} )
				.OrderBy( p => p.IsLocal ? 1 : 0 )
				.ThenBy( p => p.Name )
				.ToList();
		}
		catch ( Exception e )
		{
			Log.Warning( $"GetOnlinePlayers error: {e.Message}" );
			return new();
		}
	}

	// Trading
	private void RequestTrade( OnlinePlayerInfo player )
	{
		SoundManager.PlayClick();
		if ( player == null ) return;

		if ( TradingManager.Instance == null )
		{
			NotificationManager.Instance?.AddNotification(
				NotificationType.Info,
				"Trading Unavailable",
				"Trading system is not ready yet. Try again in a moment.",
				3f
			);
			return;
		}

		var success = TradingManager.Instance.SendTradeRequest( player.ConnectionId, player.Name );
		if ( success )
		{
			NotificationManager.Instance?.AddNotification(
				NotificationType.Info,
				"Trade Request Sent",
				$"Waiting for {player.Name} to respond...",
				5f
			);
		}
		else if ( TradingManager.Instance.IsOnCooldown )
		{
			NotificationManager.Instance?.AddNotification(
				NotificationType.Info,
				"Trade Cooldown",
				$"Please wait {TradingManager.Instance.CooldownRemaining:F0}s before trading again.",
				3f
			);
		}
		else if ( TradingManager.Instance.IsInTrade )
		{
			NotificationManager.Instance?.AddNotification(
				NotificationType.Info,
				"Already Trading",
				"You're already in an active trade.",
				3f
			);
		}
	}

	// Battles — navigates to Battle tab (team-select); online challenge flow lives in ArenaPanel
	private void RequestBattle( OnlinePlayerInfo player )
	{
		SoundManager.PlayClick();
		SwitchTab( "ranked" );
	}

	// Card section
	private string GetFavoriteName()
	{
		var speciesId = TamerManager.Instance?.CurrentTamer?.FavoriteMonsterSpeciesId;
		if ( string.IsNullOrEmpty( speciesId ) ) return "Select...";
		var species = MonsterManager.Instance?.GetSpecies( speciesId );
		return species?.Name ?? speciesId;
	}

	private List<MonsterSpecies> GetDiscoveredSpeciesList()
	{
		var discovered = BeastiaryManager.Instance?.DiscoveredSpecies;
		if ( discovered == null || discovered.Count == 0 ) return new();
		return discovered
			.Select( id => MonsterManager.Instance?.GetSpecies( id ) )
			.Where( s => s != null )
			.OrderBy( s => s.Name )
			.ToList();
	}

	private MonsterSpecies GetFavoriteSpeciesForDisplay()
	{
		var speciesId = TamerManager.Instance?.CurrentTamer?.FavoriteMonsterSpeciesId;
		if ( string.IsNullOrEmpty( speciesId ) ) return null;
		return MonsterManager.Instance?.GetSpecies( speciesId );
	}

	private void SetFavorite( string speciesId )
	{
		SoundManager.PlaySelect();
		var tamer = TamerManager.Instance?.CurrentTamer;
		if ( tamer != null )
		{
			tamer.FavoriteMonsterSpeciesId = speciesId;
			TamerManager.Instance?.SaveToCloud();
		}
		showFavSelector = false;
	}

	private void ShowcaseCard()
	{
		SoundManager.PlayClick();
		ChatManager.Instance?.SendTamerCardShowcase();
	}

	private void OpenFavSelector()
	{
		SoundManager.PlayClick();
		showFavSelector = true;
	}

	// ── Tamers tab selection helpers ────────────────────────────────────────

	private void SelectSelf()
	{
		if ( selectedKind == "self" ) return;
		SoundManager.PlaySelect();
		selectedKind = "self";
		selectedOnlinePlayer = null;
		showFavSelector = false;
	}

	private void SelectOnline( OnlinePlayerInfo player )
	{
		if ( player == null ) return;
		if ( selectedKind == "online" && selectedOnlinePlayer?.ConnectionId == player.ConnectionId ) return;
		SoundManager.PlaySelect();
		selectedKind = "online";
		selectedOnlinePlayer = player;
		showFavSelector = false;
	}

	// ── Voice helpers (lobby-only for launch) ───────────────────────────────

	private void ToggleLobbyVoice()
	{
		SoundManager.PlayClick();
		var vcm = VoiceChatManager.Instance;
		if ( vcm == null ) return;
		if ( vcm.IsInLobby ) vcm.LeaveRoom();
		else vcm.JoinLobby();
	}

	private void JoinLobbyVoice()
	{
		SoundManager.PlayClick();
		var vcm = VoiceChatManager.Instance;
		if ( vcm == null ) return;
		if ( !vcm.IsInLobby ) vcm.JoinLobby();
	}

	private void ToggleMic()
	{
		SoundManager.PlayClick();
		VoiceChatManager.Instance?.ToggleMic();
	}

	private void ToggleMutePlayer( string connectionId )
	{
		if ( string.IsNullOrEmpty( connectionId ) ) return;
		SoundManager.PlayClick();
		VoiceChatManager.Instance?.ToggleMutePlayer( connectionId );
	}

	private int GetBattlesWon() => TamerManager.Instance?.CurrentTamer?.TotalBattlesWon ?? 0;

	private int GetAchievementCount()
	{
		var tamer = TamerManager.Instance?.CurrentTamer;
		return tamer?.Achievements?.Values.Count( p => p.IsUnlocked ) ?? 0;
	}

	private string GetPlayTimeForCard()
	{
		var time = TamerManager.Instance?.CurrentTamer?.TotalPlayTime ?? TimeSpan.Zero;
		var minutes = (int)time.TotalMinutes;
		if ( minutes <= 0 ) return "-";
		if ( minutes < 60 ) return $"{minutes}m";
		int hours = minutes / 60;
		if ( hours < 24 ) return $"{hours}h";
		return $"{hours / 24}d";
	}

	private int GetMonstersCaught()
	{
		return TamerManager.Instance?.CurrentTamer?.TotalMonstersCaught ?? 0;
	}

	// Honors GuildManager.UiEnabled so the beta build never shows guild UI even
	// if the local player is still a member of a guild from prior testing.
	private bool IsInGuild() => GuildManager.UiEnabled && (GuildManager.Instance?.IsInGuild ?? false);

	// BuildHash drives re-render reactivity. Without this, panel state changes (selection,
	// voice room membership, online roster, etc) won't propagate per s&box's Panel framework.
	// PlayerProfiles count is included so remote players' tamer-card data (Level, stats,
	// favorite beast) surfaces as soon as their profile broadcast lands, not just when the
	// connection roster changes.
	protected override int BuildHash()
	{
		var vcm = VoiceChatManager.Instance;
		return System.HashCode.Combine(
			HashCode.Combine(
				currentSection,
				selectedKind,
				selectedOnlinePlayer?.ConnectionId,
				showFavSelector,
				IsConnected() ? Connection.All.Count : 0,
				ChatManager.Instance?.PlayerProfiles?.Count ?? 0,
				_kbIndex,
				_kbActive
			),
			HashCode.Combine(
				vcm?.IsInLobby ?? false,
				vcm?.IsMicActive ?? false,
				vcm?.CurrentRoom?.Members?.Count ?? 0,
				TamerManager.Instance?.CurrentTamer?.FavoriteMonsterSpeciesId
			)
		);
	}

	private class OnlinePlayerInfo
	{
		public string ConnectionId { get; set; }
		public long SteamId { get; set; }
		public string Name { get; set; }
		public bool IsLocal { get; set; }
		public bool IsDev { get; set; }
		public bool HasProfile { get; set; }
		public string GenderClass { get; set; } = "male";
		public string AvatarPath { get; set; } = "ui/characters/male/male_tamer.png";
		public string FavoriteExpeditionId { get; set; }
		public string FavoriteMonsterSpeciesId { get; set; }
		public string Title { get; set; } = "Tamer";
		public string TitleColor { get; set; } = "#a78bfa";
		public string GuildTag { get; set; }
		public string GuildName { get; set; }
		// Surfaced from BroadcastPlayerProfile so the tile + detail sidebar
		// can show the same tamer-card info we already sync over the wire.
		public int Level { get; set; }
		public int MonstersCaught { get; set; }
		public int BattlesWon { get; set; }
		public int AchievementCount { get; set; }
		public int HighestExpedition { get; set; }
		public int TotalPlayTimeMinutes { get; set; }
		public string ArenaRank { get; set; } = "Unranked";
		public int ArenaPoints { get; set; }
	}
}
