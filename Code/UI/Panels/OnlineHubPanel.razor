	// Integer-scaled sprite box — pixel art only scales cleanly by whole
	// numbers, so the hero sprites size to the largest k with k × source ≤
	// box (a 96px sprite in a 320 box = 3× = 288). Source dimensions come
	// from Texture.Load once per path (static cache; the MonsterBillboard
	// precedent).
	private static readonly Dictionary<string, (int w, int h)> _spriteDims = new();

	private static (int w, int h) SpriteBox( MonsterSpecies s, int box )
	{
		if ( s == null || string.IsNullOrEmpty( s.IconPath ) ) return (box, box);
		if ( !_spriteDims.TryGetValue( s.IconPath, out var d ) )
		{
			d = (96, 96);
			try
			{
				var tex = Texture.Load( FileSystem.Mounted, s.IconPath );
				if ( tex != null && tex.Width > 0 && tex.Height > 0 ) d = (tex.Width, tex.Height);
			}
			catch { }
			_spriteDims[s.IconPath] = d;
		}
		int k = Math.Max( 1, box / Math.Max( d.w, d.h ) );
		return (d.w * k, d.h * k);
	}

	// Idle-animated frame for the three hero sprites (BeastiaryPanel's
	// GetAnimatedIcon precedent). Flags _heroAnimated so BuildHash only
	// tracks SpriteAnimator.GlobalFrame when a hero species actually has
	// more than one frame — the handmade launch roster ships single-frame
	// idles, so the landing does NOT re-render at 8fps for nothing.
	private bool _heroAnimated;

	private string GetAnimatedIcon( MonsterSpecies species )
	{
		if ( species == null ) return "ui/monsters/default.png";
		if ( species.AnimationFrames != null && species.AnimationFrames.Count > 1 )
		{
			_heroAnimated = true;
			int frameIndex = SpriteAnimator.GlobalFrame % species.AnimationFrames.Count;
			return species.AnimationFrames[frameIndex];
		}
		return species.IconPath ?? "ui/monsters/default.png";
	}

	// RANKED block — the nine-tier ladder (CompetitiveManager.GetRankFromPoints
	// thresholds). Returns the current tier's floor and the next tier's
	// threshold; at Mythic floor == next (bar full).
	private static readonly int[] RankSteps = { 0, 200, 400, 700, 1000, 1500, 2000, 3000, 5000 };
	private const int RankBarWidth = 180; // row 2 of the rank block: bar 180 · spacer · N / M (300 lane)

	private static (int floor, int next) RankBand( int points )
	{
		int floor = 0, next = RankSteps[1];
		for ( int i = 0; i < RankSteps.Length; i++ )
		{
			if ( points < RankSteps[i] ) break;
			floor = RankSteps[i];
			next = i + 1 < RankSteps.Length ? RankSteps[i + 1] : RankSteps[i];
		}
		return (floor, next);
	}

	// Leaderboard row avatars — Board2.Entry.SteamId arrives as 0 from the
	// service in practice, so rows resolve a Steam id BY DISPLAY NAME from
	// the people we do know: (b) collected TamerCards (offline-friendly,
	// lowest authority — written first so live data overwrites), (a) the
	// online presence set, (c) you (Steam display name AND tamer name).
	// Case-insensitive. Rows with no hit keep the neutral diamond — honest.
	private Dictionary<string, long> BuildAvatarByName( List<OnlinePlayerInfo> others )
	{
		var map = new Dictionary<string, long>( StringComparer.OrdinalIgnoreCase );

		var cards = TamerManager.Instance?.CurrentTamer?.CollectedCards;
		if ( cards != null )
		{
			foreach ( var c in cards )
			{
				if ( c == null || c.SteamId <= 0 || string.IsNullOrEmpty( c.Name ) ) continue;
				map[c.Name] = c.SteamId;
			}
		}

		foreach ( var p in others )
		{
			if ( p.SteamId <= 0 || string.IsNullOrEmpty( p.Name ) ) continue;
			map[p.Name] = p.SteamId;
		}

		long mine = GetLocalSteamId();
		if ( mine > 0 )
		{
			var steamName = Connection.Local?.DisplayName;
			if ( !string.IsNullOrEmpty( steamName ) ) map[steamName] = mine;
			var tamerName = TamerManager.Instance?.CurrentTamer?.Name;
			if ( !string.IsNullOrEmpty( tamerName ) ) map[tamerName] = mine;
		}
		return map;
	}

	// Pull a "#rrggbb" color t of the way toward the zone slab tone
	// (#15121f). Anything that isn't a 6-digit hex passes through untouched.
	private static string BlendTowardSlab( string hex, float t )
	{
		const int sr = 0x15, sg = 0x12, sb = 0x1f;
		if ( string.IsNullOrEmpty( hex ) || hex.Length != 7 || hex[0] != '#' ) return hex;
		try
		{
			int r = Convert.ToInt32( hex.Substring( 1, 2 ), 16 );
			int g = Convert.ToInt32( hex.Substring( 3, 2 ), 16 );
			int b = Convert.ToInt32( hex.Substring( 5, 2 ), 16 );
			r = Math.Clamp( (int)Math.Round( r + (sr - r) * t ), 0, 255 );
			g = Math.Clamp( (int)Math.Round( g + (sg - g) * t ), 0, 255 );
			b = Math.Clamp( (int)Math.Round( b + (sb - b) * t ), 0, 255 );
			return $"#{r:x2}{g:x2}{b:x2}";
		}
		catch
		{
			return hex;
		}
	}

	// BuildHash ingredient — the online tamers' favorite ids (a profile
	// broadcast can change a favorite without changing the profile count).
	private int GetOnlineFavHash()
	{
		var profiles = ChatManager.Instance?.PlayerProfiles;
		if ( profiles == null ) return 0;
		int h = 17;
		foreach ( var kv in profiles )
			h = HashCode.Combine( h, kv.Value?.FavoriteMonsterSpeciesId );
		return h;
	}

	// Guild banner emblem — the beast-emblem ruling, renderer side only:
	// an EmblemIcon of "beast:<speciesId>" renders that species' sprite on
	// the pennant; anything else falls back to the lucide map. The picker
	// lands later (GuildManager untouched).
	private MonsterSpecies GetGuildEmblemBeast()
	{
		var icon = GuildManager.Instance?.Guild?.EmblemIcon;
		if ( string.IsNullOrEmpty( icon ) || !icon.StartsWith( "beast:" ) ) return null;
		return MonsterManager.Instance?.GetSpecies( icon.Substring( 6 ) );
	}

