@namespace Beastborne.UI.Panels
@using System;
@using System.Linq;
@using System.Collections.Generic;
@using System.Threading.Tasks;
@using Sandbox;
@using Sandbox.Services;
@using Sandbox.UI;
@using Sandbox.Network;
@using Beastborne.Core;
@using Beastborne.Data;
@using Beastborne.Systems;
@using Beastborne.UI.Components;
@using Beastborne.UI.Primitives;
@inherits Panel

@*
	ONLINE HUB — five-zone landing (2026-08-28 rebuild, milestone 2).
	Spec: .claude/design-system/components/online-mock-hub.html (layout)
	+ online-simple-v3.html (copy law: plain words, no theater nouns)
	+ online-motion-spec.html (cursor model, payloads, ambient budget).

	Zones: BATTLE hero (rank/record/CTAs — gated dark behind
	QuickplayEnabled) · LEADERBOARDS column (Steam-fed compact list, R
	cycles category) · TRADE OFFERS (session-live lane only — the server
	standing-offer board is a later milestone) · GUILD corner · ONLINE
	NOW head row. The activity crawl band is NOT pre-reserved (user
	ruling 2026-08-28) — the ticker milestone carves its own 60px
	bottom strip when it ships.

	Ambient budget (exactly two living things this milestone): the
	BbHeaderWaves blue drift in the chrome band + the living violet
	ring. The crawl joins as the third when it ships.
*@

<div class="online-hub" onclick=@OnPanelClicked>

	<!-- Living glyph-drift background — house-standard on every tab
	     (Beastbook/Bag/Shop/Quests mount it the same way). First child;
	     the root paints NO fill of its own. -->
	<BbIconScroll Icon="online" />

	<!-- CHROME BAND — the BEASTBOOK header recipe (2026-08-28 header
	     pass): BbHeaderWaves paints the opaque base + blue wave drift
	     (host paints no fill — paint-behind law); kicker + big italic
	     title + two skewed accent SEAM bars (.bh-seam anatomy). NOTHING
	     on the right (user ruling 2026-08-28): the presence pill
	     duplicated ONLINE NOW's own count, and the keycap legend went —
	     controls are self-evident, the boards zone carries its R chip.
	     No sub-band either: an empty slab row was "a lot of nothing".
	     The old Tamers/Leaderboards/Guild pill row stays RETIRED — the
	     zones ARE the navigation; currentSection is the router only. -->
	<div class="oh-header">
		<BbHeaderWaves Accent=@("blue") />
		<div class="oh-identity">
			<span class="oh-kicker">TAMERLINK</span>
			<div class="oh-title-row">
				<span class="oh-title">ONLINE</span>
				<div class="oh-seam"></div>
				<div class="oh-seam dim"></div>
			</div>
		</div>
	</div>

	@if ( currentSection == "players" && !IsArenaActive() )
	{
		@{
			var otherPlayers = IsConnected() ? GetOnlinePlayers().Where( p => !p.IsLocal ).ToList() : new();
			var vcm = VoiceChatManager.Instance;
			var inLobbyVoice = vcm?.IsInLobby ?? false;
			var lobbyMembers = vcm?.Rooms?.FirstOrDefault( r => r.IsLobby )?.Members?.Count ?? 0;
			var favBeastSpecies = GetFavoriteSpeciesForDisplay();
			var beastElementClass = favBeastSpecies?.Element.ToString().ToLower() ?? "";
			// If the rail's selection went stale (player disconnected), close it.
			if ( railOpen && selectedKind == "online" && (selectedOnlinePlayer == null || !otherPlayers.Any( p => p.ConnectionId == selectedOnlinePlayer.ConnectionId )) )
			{
				railOpen = false;
				selectedKind = "self";
				selectedOnlinePlayer = null;
			}

			// BATTLE identity — CompetitiveManager rank ladder + casual record.
			var hubTamer = TamerManager.Instance?.CurrentTamer;
			int bWins = hubTamer?.ArenaWins ?? 0;
			int bLosses = hubTamer?.ArenaLosses ?? 0;
			var rankName = CompetitiveManager.GetRankFromPoints( hubTamer?.ArenaPoints ?? 0 );
			var rankColor = CompetitiveManager.GetRankColor( rankName );
			var rankGlyph = CompetitiveManager.GetRankLucideIcon( rankName );
			int bTotal = bWins + bLosses;

			// LEADERBOARDS — compact Steam-fed list, R cycles category.
			var lbCat = HubLbCats[hubLbCatIndex];
			var lbEntries = CurrentHubLbEntries();
			int lbRows = Math.Min( lbEntries.Count, HubLbMaxRows );
			hubLbSelf.TryGetValue( lbCat.Key, out var lbSelf );
			int lbYouIdx = lbRows;                       // kb index of the pinned YOU row
			int lbFootIdx = lbRows > 0 ? lbRows + 1 : 0; // kb index of FULL STANDINGS

			// GUILD corner.
			var gm = GuildManager.Instance;
			bool inGuild = IsInGuild();
			var goal = inGuild ? (gm?.WeeklyGoals?.FirstOrDefault( g => !g.Claimed ) ?? gm?.WeeklyGoals?.FirstOrDefault()) : null;

			// TRADE OFFERS — session-live lane: online tamers you can trade
			// with right now. The server standing-offer board is a later
			// milestone; nothing fake renders in its place.
			var tradables = otherPlayers.Take( MaxTradeSlips ).ToList();
			var shownHeads = otherPlayers.Take( MaxHeads ).ToList();

			// THE BEASTS ARE THE HEROES (v3) — every zone carries beast art.
			// Hero sprites: QUICKPLAY = your beast; RANKED = Loomweaver (the
			// Epic mini-boss that never forgets a word); PRACTICE = Cherune
			// (the starter cherub). Alternates dodge a duplicate of yours.
			// Boxes = the largest integer scale that stays clear of the text
			// (2026-08-29 ruling: never over the label): 200 → 2× on QUICKPLAY,
			// 112 → 1× on the side tiles. Geometry lives in the scss banner.
			var heroQuick = GetHeroQuickSpecies();
			var heroRanked = GetHeroFixedSpecies( "loomweaver", "skunkape", heroQuick );
			var heroPractice = GetHeroFixedSpecies( "cherune", "sheepot", heroQuick );
			var quickBox = SpriteBox( heroQuick, 200 );
			var rankedBox = SpriteBox( heroRanked, 112 );
			var practiceBox = SpriteBox( heroPractice, 112 );
			int bPoints = hubTamer?.ArenaPoints ?? 0;
			var (rankFloor, rankNext) = RankBand( bPoints );
			int rankBarPx = rankNext > rankFloor
				? (int)Math.Round( RankBarWidth * Math.Clamp( (bPoints - rankFloor) / (float)(rankNext - rankFloor), 0f, 1f ) )
				: RankBarWidth;
			var guildBeast = GetGuildEmblemBeast();
			var lbSteam = GetLocalSteamId();   // boards YOU row — Steam avatar
			var lbNextCat = HubLbCats[( hubLbCatIndex + 1 ) % HubLbCats.Length];
			// Board2 entries carry SteamId = 0 in practice — resolve row
			// avatars by display name from the people we DO know the id of
			// (presence set · collected TamerCards · you). Built once per render.
			var avatarByName = BuildAvatarByName( otherPlayers );
		}

		<div class="hub-body">
			<div class="hub-landing">

				<div class="hub-main">

					<!-- ═══ BATTLE HERO — THE BEASTS ARE THE HEROES (2026-08-28 v3 ·
					     polish pass 2026-08-29). Three mode TILES share the full hero
					     width: QUICKPLAY (gold, flex 1) · RANKED 340 · PRACTICE 340.
					     Tile anatomy, bottom→top: slab layer · location art (clipped
					     right column, dissolving into the slab through the fade
					     layer) · beast sprite (right column, below the label row —
					     never over text) · text column · the in-tile BUTTON (ring
					     host + kb target 0/1/2) · chips · cut. Tiles keep only the
					     hover fill step; the Smash pop stays on the corner glyphs; the
					     button owns the press-down. The tile's onclick is the ONE
					     click handler — a button click bubbles up to it (BbButton
					     OnClick stays unset so nothing fires twice). ═══ -->
					<div class="hz hz-battle">
						<div class="oh-head">
							<div class="oh-chip"><span>BATTLE</span></div>
						</div>
						<div class="bz-body">
							<!-- QUICKPLAY — the dominant tile. Hero image = YOUR beast
							     (profile favorite → lead → first owned → Embrik) at 2×,
							     below the label row. Art: the Elemental Nexus sunburst as a
							     gold-tinted texture under the primary ramp (not a photo). -->
							<div class="mode-tile mode-quick @(BattleEnabled ? "" : "locked") @(IsHubKb("battle", 0) ? "kb-lit" : "")"
								 onmouseover=@(() => HoverHubCursor( "battle", 0 ))
								 onclick=@OnFindBattle>
								<div class="mode-slab"></div>
								<div class="mode-art-clip mode-art-clip-quick">
									<img class="mode-art mode-art-quick" src="ui/locations/elemental_nexus_background.png" />
								</div>
								<div class="mode-fade"></div>
								@if ( heroQuick != null )
								{
									<img class="mode-beast" src="@GetAnimatedIcon( heroQuick )" style="width: @(quickBox.w)px; height: @(quickBox.h)px" />
								}
								@if ( !BattleEnabled )
								{
									<div class="mode-soon"><span class="mode-soon-text">OPENS SOON</span></div>
								}
								<div class="mode-text mode-text-quick">
									<iconify class="mode-glyph" icon="lucide:swords" Size=@(48) Color="#2a1605" />
									<span class="mode-label mode-label-quick">QUICKPLAY</span>
									<span class="mode-sub mode-sub-quick">Best-of-3 · levels matched fair</span>
								</div>
								<BbButton @ref="ctaFindRef" Tier="primary" Size=@(56) Label="FIND A MATCH" HoverSound=@false Class="mode-cta mode-cta-quick" />
								<iconify class="mode-cta-arrow" icon="lucide:arrow-right" Size=@(22) Color="#2a1605" />
								<div class="mode-cut"></div>
							</div>

							<!-- RANKED — interactive-looking always; the button denies
							     (PlayDeny) while RankedEnabled is false (COMING SOON chip).
							     Loomweaver at 1× in the right column above the rank block.
							     Art: Ember Cavern lava. Bottom: the RANK BLOCK footer band
							     (two rows: [tier diamond] TIER · RECORD W – L / points bar ·
							     N / M) with PLAY RANKED seated INSIDE its lower half — 12px
							     under row 2, 20px off the floor, nothing overlapping
							     (2026-08-29 fix: the button used to sit over the block). -->
							<div class="mode-tile mode-ranked @(IsHubKb("battle", 1) ? "kb-lit" : "")"
								 onmouseover=@(() => HoverHubCursor( "battle", 1 ))
								 onclick=@OnRankedChip>
								<div class="mode-slab"></div>
								<div class="mode-art-clip">
									<img class="mode-art" src="ui/locations/ember_cavern_background.png" />
								</div>
								<div class="mode-fade"></div>
								@if ( heroRanked != null )
								{
									<img class="mode-beast" src="@GetAnimatedIcon( heroRanked )" style="width: @(rankedBox.w)px; height: @(rankedBox.h)px" />
								}
								@if ( !RankedLive )
								{
									<div class="mode-soon dark"><span class="mode-soon-text">COMING SOON</span></div>
								}
								<div class="mode-text">
									<iconify class="mode-glyph" icon="lucide:shield" Size=@(48) Color="rgba(244, 241, 234, 0.85)" />
									<span class="mode-label mode-label-cream">RANKED</span>
									<span class="mode-sub mode-sub-cream">Play ranked matches.</span>
								</div>
								<div class="mode-spacer"></div>
								<div class="rank-block">
									<div class="rank-block-top">
										<div class="rank-badge-holder">
											<div class="rank-badge" style="border-color: @rankColor">
												<div class="rank-badge-inner">
													<iconify icon="@rankGlyph" Size=@(12) Color="@rankColor" />
												</div>
											</div>
										</div>
										<span class="rank-tier" style="color: @rankColor">@rankName.ToUpper()</span>
										<div class="rank-block-spacer"></div>
										<span class="rank-record-label">RECORD</span>
										<span class="rank-record">@($"{bWins} – {bLosses}")</span>
									</div>
									<div class="rank-block-row2">
										<div class="rank-bar">
											<div class="rank-bar-fill" style="width: @(rankBarPx)px; background-color: @rankColor"></div>
										</div>
										<div class="rank-block-spacer"></div>
										<span class="rank-pts">@(rankNext > rankFloor ? $"{bPoints:N0} / {rankNext:N0}" : $"{bPoints:N0} · TOP TIER")</span>
									</div>
								</div>
								<!-- The button comes AFTER the block in DOM (+ z 5) so it paints
								     over the band it sits in, never under it. -->
								<BbButton @ref="ctaRankedRef" Tier="secondary" Size=@(44) Label="PLAY RANKED" HoverSound=@false Class="mode-cta mode-cta-side" />
							</div>

							<!-- PRACTICE VS AI — secondary tile; same ArenaPanel route.
							     Cherune at 1× bottom-right. Art: Garden of Origins. -->
							<div class="mode-tile mode-practice @(BattleEnabled ? "" : "locked") @(IsHubKb("battle", 2) ? "kb-lit" : "")"
								 onmouseover=@(() => HoverHubCursor( "battle", 2 ))
								 onclick=@OnPracticeAI>
								<div class="mode-slab"></div>
								<div class="mode-art-clip">
									<img class="mode-art" src="ui/locations/garden_of_origins_background.png" />
								</div>
								<div class="mode-fade"></div>
								@if ( heroPractice != null )
								{
									<img class="mode-beast" src="@GetAnimatedIcon( heroPractice )" style="width: @(practiceBox.w)px; height: @(practiceBox.h)px" />
								}
								<div class="mode-text">
									<iconify class="mode-glyph" icon="lucide:target" Size=@(48) Color="rgba(244, 241, 234, 0.85)" />
									<span class="mode-label mode-label-cream">PRACTICE VS AI</span>
									<span class="mode-sub mode-sub-cream">Practice against the AI.</span>
								</div>
								<BbButton @ref="ctaPracticeRef" Tier="secondary" Size=@(44) Label="BATTLE THE AI" HoverSound=@false Class="mode-cta mode-cta-side" />
							</div>
						</div>
						<div class="oh-cut"></div>
					</div>

					<!-- ═══ TRADE OFFERS + GUILD ═══ -->
					<div class="hub-mid-row">

						<div class="hz hz-trades">
							<div class="tz-band">
								<div class="oh-chip"><span>TRADE OFFERS</span></div>
								@if ( tradables.Count > 0 )
								{
									<div class="chip"><span class="chip-text">@($"{otherPlayers.Count} LIVE")</span></div>
								}
							</div>
							<div class="tz-body">
								<!-- Slips — session-live lane. A live tamer has no posted
								     WANT/FOR yet, so the slip reads "Open to trade" on the
								     WANT side and their favorite beast on the FOR side. -->
								<div class="tz-slips">
									@if ( tradables.Count == 0 )
									{
										<span class="tz-empty-main">No open offers right now</span>
										<span class="tz-empty-sub">Tamers who are online can trade live — they'll appear here</span>
									}
									else
									{
										@for ( int ti = 0; ti < tradables.Count; ti++ )
										{
											var t = tradables[ti];
											int slipIdx = ti + 1; // kb 0 is POST OFFER
											var forSpecies = !string.IsNullOrEmpty( t.FavoriteMonsterSpeciesId ) ? MonsterManager.Instance?.GetSpecies( t.FavoriteMonsterSpeciesId ) : null;
											<div class="trade-slip @(IsHubKb("trades", slipIdx) ? "kb-focused" : "")"
												 onmouseover=@(() => HoverHubCursor( "trades", slipIdx ))
												 onclick=@(() => RequestTrade( t ))>
												<div class="ts-avatar" style="border-color: @t.TitleColor">
													@if ( t.SteamId > 0 )
													{
														<img class="ts-avatar-img" src="avatar:@t.SteamId" />
													}
													else
													{
														<img class="ts-avatar-img" src="@t.AvatarPath" />
													}
												</div>
												<span class="ts-side-label">WANT</span>
												<span class="ts-open">Open to trade</span>
												<iconify class="ts-arrow" icon="lucide:arrow-right" Size=@(16) Color="#6fb1f0" />
												<span class="ts-side-label">FOR</span>
												@if ( forSpecies != null )
												{
													<img class="ts-beast" src="@forSpecies.IconPath" />
													<span class="ts-beast-name">@forSpecies.Name</span>
												}
												else
												{
													<span class="ts-open">Any beast</span>
												}
												<div class="ts-spacer"></div>
												<span class="ts-name">@t.Name</span>
												@if ( t.Level > 0 )
												{
													<span class="ts-lv">@($"LV {t.Level}")</span>
												}
												<div class="pill-live"><span class="pill-live-text">LIVE</span></div>
											</div>
										}
									}
								</div>
								<!-- POST OFFER — full-width blue bar, the zone's always-visible
								     action (ring host, trades kb 0). Inert until the standing-
								     offer board ships: pressing swaps the sub-line for 3s. -->
								<div @ref="postOfferRef" class="tz-post @(IsHubKb("trades", 0) ? "kb-lit" : "")"
									 onmouseover=@(() => HoverHubCursor( "trades", 0 ))
									 onclick=@OnPostOffer>
									<div class="tz-post-diamond">
										<div class="tz-post-glyph-holder">
											<iconify class="tz-post-glyph" icon="lucide:plus" Size=@(14) Color="#3f8fe0" />
										</div>
									</div>
									<span class="tz-post-label">POST OFFER</span>
									<div class="tz-post-spacer"></div>
									<span class="tz-post-sub @(_postNoteLive ? "note" : "")">@(_postNoteLive ? "Coming with the trade board" : "48h standing offer")</span>
								</div>
							</div>
						</div>

						<div class="hz hz-guild">
							@if ( !GuildManager.UiEnabled )
							{
								<div class="oh-head"><div class="oh-chip"><span>GUILD</span></div></div>
								<span class="gz-empty">Guilds arrive in a later update.</span>
							}
							else if ( inGuild )
							{
								@{
									var gzColor = gm?.Guild?.EmblemColor ?? "#3f8fe0";
									// Pennant FILL = the emblem color pulled 70% toward the slab
									// tone — a hand-sized flood of the default #7c3aed read as the
									// violet cursor (violet is the cursor's alone). The name keeps
									// the full color; text can carry it, a slab can't.
									var gzFill = BlendTowardSlab( gzColor, 0.70f );
									var gzMembers = (gm?.Members ?? new List<GuildMemberInfo>())
										.OrderByDescending( m => m.IsOnline ).ThenByDescending( m => (int)m.Role ).ToList();
									var gzShown = gzMembers.Take( MaxGuildHeads ).ToList();
								}
								<div class="oh-head"><div class="oh-chip"><span>GUILD</span></div></div>
								<div class="gz-body">
									<!-- THE BANNER — hanging pennant in the guild color; the
									     emblem is a beast sprite when EmblemIcon = "beast:<id>". -->
									<div class="gz-banner-col">
										<div class="gz-banner" style="background-color: @gzFill">
											@if ( guildBeast != null )
											{
												<img class="gz-banner-beast" src="@guildBeast.IconPath" />
											}
											else
											{
												<iconify class="gz-banner-glyph" icon="@GetGuildEmblemIcon()" Size=@(64) Color="#ffffff" />
											}
											<div class="gz-banner-cut left"></div>
											<div class="gz-banner-cut right"></div>
											<!-- N MEMBERS lives INSIDE the banner as a z3 sibling of the
											     z2 cut squares (the cuts extend 60px below the banner and
											     were painting over a label that hung as a col sibling —
											     "MEMBEH"). Sibling z-order is deterministic; the holder
											     is an explicit 140×14 box parked 8px under the tip. -->
											<div class="gz-members-holder"><span class="gz-members-label">@($"{gzMembers.Count} MEMBERS")</span></div>
										</div>
									</div>
									<div class="gz-info">
										<span class="gz-name" style="color: @gzColor">@($"[{gm?.Guild?.Tag}] {gm?.Guild?.Name}")</span>
										<div class="gz-sub-row">
											<span class="gz-sub">@($"GUILD LV {gm?.Guild?.Level ?? 1} · ")</span>
											<span class="gz-online">@($"{gm?.OnlineCount ?? 0} online")</span>
											<span class="gz-sub">@($" / {gm?.Members?.Count ?? 0}")</span>
										</div>
										@if ( goal != null )
										{
											<span class="gz-kick">@($"WEEKLY GOAL — {goal.Title?.ToUpper()}")</span>
											<div class="gz-bar">
												<div class="gz-fill" style="width: @(GoalPctStr( goal ))%"></div>
											</div>
											<span class="gz-progress">@($"{goal.Progress:N0} / {goal.Target:N0}")</span>
										}
										<!-- Members strip — up to MaxGuildHeads heads (online first),
										     role-color rim from GuildManager.GetRoleColor, green dot =
										     online, "+N" for the rest. -->
										<div class="gz-members">
											@foreach ( var m in gzShown )
											{
												<div class="gz-seat">
													<div class="gz-head" style="border-color: @GuildManager.GetRoleColor( m.Role )">
														@if ( m.SteamId > 0 )
														{
															<img class="gz-head-img" src="avatar:@m.SteamId" />
														}
														else
														{
															<iconify class="gz-head-glyph" icon="lucide:user-round" Size=@(18) Color="rgba(214, 206, 236, 0.55)" />
														}
													</div>
													@if ( m.IsOnline )
													{
														<div class="gz-head-dot"></div>
													}
												</div>
											}
											@if ( gzMembers.Count > MaxGuildHeads )
											{
												<div class="gz-head-more"><span class="gz-head-more-text">@($"+{gzMembers.Count - MaxGuildHeads}")</span></div>
											}
										</div>
										<div class="gz-spacer"></div>
										<div class="gz-cta-row">
											<div @ref="guildCtaRef" class="gz-cta @(IsHubKb("guild", 0) ? "kb-lit" : "")"
												 onmouseover=@(() => HoverHubCursor( "guild", 0 ))
												 onclick=@(() => SwitchTab( "guild" ))>
												<span class="gz-cta-label">OPEN GUILD</span><span class="gz-cta-arrow">→</span>
											</div>
										</div>
									</div>
								</div>
							}
							else
							{
								<div class="oh-head"><div class="oh-chip"><span>GUILD</span></div></div>
								<span class="gz-empty">Team up with other tamers — weekly goals, shared progress, one banner.</span>
								<div class="gz-pitch-row">
									<div class="chip"><span class="chip-text">WEEKLY GOALS</span></div>
									<div class="chip"><span class="chip-text">SHARED PROGRESS</span></div>
									<div class="chip"><span class="chip-text">ONE BANNER</span></div>
								</div>
								<div class="gz-spacer"></div>
								<div class="gz-cta-row">
									<div @ref="guildCtaRef" class="gz-cta @(IsHubKb("guild", 0) ? "kb-lit" : "")"
										 onmouseover=@(() => HoverHubCursor( "guild", 0 ))
										 onclick=@(() => SwitchTab( "guild" ))>
										<span class="gz-cta-label">FIND A GUILD</span><span class="gz-cta-arrow">→</span>
									</div>
								</div>
							}
						</div>
					</div>

					<!-- ═══ ONLINE NOW ═══ -->
					<div class="hz hz-online">
						<div class="oz-band">
							<div class="oh-chip"><span>@($"ONLINE NOW · {(IsConnected() ? otherPlayers.Count + 1 : 1)}")</span></div>
							<div class="oz-band-spacer"></div>
							@if ( otherPlayers.Count > 0 )
							{
								<span class="oz-hint">Click a head — their profile</span>
							}
							@if ( IsConnected() && vcm != null )
							{
								<div class="oz-voice @(inLobbyVoice ? "active" : "")"
									 onmouseover=@(() => SoundManager.PlayHover())
									 onclick=@ToggleLobbyVoice>
									<iconify class="oz-voice-glyph" icon="lucide:volume-2" Size=@(13) Color="@(inLobbyVoice ? "#4ade80" : "#9ecdf5")" />
									<span class="oz-voice-label">@(inLobbyVoice ? $"VOICE · {lobbyMembers}" : "JOIN VOICE")</span>
								</div>
								@if ( inLobbyVoice )
								{
									<div class="oz-voice mic"
										 onmouseover=@(() => SoundManager.PlayHover())
										 onclick=@ToggleMic>
										<iconify class="oz-voice-glyph" icon="@(vcm.IsMicActive ? "lucide:mic" : "lucide:mic-off")" Size=@(13) Color="@(vcm.IsMicActive ? "#4ade80" : "rgba(255,255,255,0.5)")" />
									</div>
								}
							}
						</div>
						<div @ref="onlineRowRef" class="oz-row">
							@{
								var localSteam = GetLocalSteamId();
							}
							<!-- YOU head — your STEAM avatar under the gold YOU chip (user
							     ruling 2026-08-29: people are Steam avatars; beast portraits
							     only where the beast is the subject). Cartoon tamer only when
							     there is no Steam id. Violet is the cursor's alone on this
							     page (blue rim). -->
							<div class="oz-seat @(IsHubKb("online", 0) ? "kb-lit" : "")"
								 onmouseover=@(() => HoverHubCursor( "online", 0 ))
								 onclick=@OpenRailSelf>
								<div class="oz-avatar you @(localSteam > 0 ? "steam" : "cartoon") @GetTamerGender()">
									@if ( localSteam > 0 )
									{
										<img class="oz-avatar-img" src="avatar:@localSteam" />
									}
									else
									{
										<img class="oz-avatar-img cartoon-img" src="@GetGenderAvatar()" />
									}
								</div>
								<div class="oz-you-chip"><span class="oz-you-chip-text">YOU</span></div>
								<span class="oz-name">@GetPlayerName().ToUpper() <span class="oz-name-lv">@($"LV {GetPlayerLevel()}")</span></span>
							</div>

							@for ( int hi = 0; hi < shownHeads.Count; hi++ )
							{
								var head = shownHeads[hi];
								int headIdx = hi + 1;
								<div class="oz-seat @(IsHubKb("online", headIdx) ? "kb-lit" : "")"
									 onmouseover=@(() => HoverHubCursor( "online", headIdx ))
									 onclick=@(() => OpenRailOnline( head ))>
									@if ( head.SteamId > 0 )
									{
										<div class="oz-avatar steam" style="border-color: @head.TitleColor">
											<img class="oz-avatar-img" src="avatar:@head.SteamId" />
										</div>
									}
									else
									{
										<div class="oz-avatar cartoon @head.GenderClass" style="border-color: @head.TitleColor">
											<img class="oz-avatar-img cartoon-img" src="@head.AvatarPath" />
										</div>
									}
									<div class="oz-dot"></div>
									<span class="oz-name">@head.Name.ToUpper()</span>
								</div>
							}

							@if ( otherPlayers.Count > MaxHeads )
							{
								<div class="oz-more"><span class="oz-more-text">@($"+{otherPlayers.Count - MaxHeads}")</span></div>
							}

							@if ( shownHeads.Count < MaxHeads )
							{
								<div class="oz-empty-seat"></div>
								<div class="oz-empty-seat dim2"></div>
							}

							@if ( otherPlayers.Count == 0 )
							{
								<span class="oz-alone">Just you right now</span>
							}
						</div>
					</div>
				</div>

				<!-- ═══ LEADERBOARDS COLUMN — rank · Steam avatar · NAME · score.
				     Category = two SEGMENTS (current blue / next dim); R or a click
				     on the dim segment cycles. Avatars: the entry's SteamId (Board2
				     entries carry it), else a neutral diamond — people are Steam
				     avatars, beasts stay where the beast is the subject. ═══ -->
				<div class="hz hz-boards">
					<div class="lb-head">
						<div class="oh-chip"><span>LEADERBOARDS</span></div>
						<div class="lb-head-spacer"></div>
						<div class="oh-cap"><span>R</span></div>
					</div>
					<div class="lb-body">
						<div class="lb-segs">
							<div class="lb-seg on"><span class="lb-seg-text">@lbCat.Label</span></div>
							<div class="lb-seg"
								 onmouseover=@(() => SoundManager.PlayHover())
								 onclick=@CycleHubLbCategory>
								<span class="lb-seg-text">@lbNextCat.Label</span>
							</div>
						</div>
						@if ( hubLbLoading )
						{
							<div class="lb-note"><span class="lb-note-text">Fetching standings…</span></div>
						}
						else if ( lbRows == 0 )
						{
							<div class="lb-note"><span class="lb-note-text">Standings unavailable right now</span></div>
						}
						else
						{
							@for ( int li = 0; li < lbRows; li++ )
							{
								var entry = lbEntries[li];
								int rowIdx = li;
								// Entry id first (exact), by-name lookup second, diamond otherwise (honest).
								long rowSteam = entry.SteamId > 0 ? entry.SteamId : ( avatarByName.TryGetValue( entry.Name ?? "", out var byNameId ) ? byNameId : 0L );
								<div class="lb-row @(li % 2 == 1 ? "alt" : "") @(IsHubKb("boards", rowIdx) ? "kb-focused" : "")"
									 onmouseover=@(() => HoverHubCursor( "boards", rowIdx ))
									 onclick=@(() => SwitchTab( "leaderboards" ))>
									<span class="lb-row-rank @(entry.Rank == 1 ? "gold" : "")">@entry.Rank</span>
									<div class="lb-row-portrait">
										@if ( rowSteam > 0 )
										{
											<img class="lb-row-avatar" src="avatar:@rowSteam" />
										}
										else
										{
											<div class="lb-row-diamond"></div>
										}
									</div>
									<span class="lb-row-name">@entry.Name.ToUpper()</span>
									<span class="lb-row-score">@entry.Score.ToString("N0")</span>
								</div>
							}
							<div class="lb-you @(IsHubKb("boards", lbYouIdx) ? "kb-focused" : "")"
								 onmouseover=@(() => HoverHubCursor( "boards", lbYouIdx ))
								 onclick=@(() => SwitchTab( "leaderboards" ))>
								<span class="lb-row-rank">@(lbSelf != null && lbSelf.Rank > 0 ? lbSelf.Rank.ToString() : "—")</span>
								<div class="lb-row-portrait">
									@if ( lbSteam > 0 )
									{
										<img class="lb-row-avatar" src="avatar:@lbSteam" />
									}
									else
									{
										<div class="lb-row-diamond"></div>
									}
								</div>
								<span class="lb-you-name">@GetPlayerName().ToUpper()</span>
								<div class="lb-you-chip"><span class="lb-you-chip-text">YOU</span></div>
								<span class="lb-you-score">@((lbSelf?.Score ?? 0L).ToString("N0"))</span>
							</div>
						}
					</div>
					<div class="lb-foot @(IsHubKb("boards", lbFootIdx) ? "kb-focused" : "")"
						 onmouseover=@(() => HoverHubCursor( "boards", lbFootIdx ))
						 onclick=@(() => SwitchTab( "leaderboards" ))>
						<span class="lb-foot-label">VIEW FULL STANDINGS →</span>
					</div>
					<div class="oh-cut"></div>
				</div>
			</div>

			@* The activity crawl band is NOT reserved here (user ruling
			   2026-08-28 — the empty strip read as a stray edge). The
			   ticker milestone re-carves its 60px bottom band together
			   with the feature that fills it. *@

			<!-- ═══ PROFILE RAIL — slides over the right edge on head
			     click/E; Q or ✕ dismisses. The td-card internals are the
			     shipped detail rail, unchanged. ═══ -->
			@if ( railOpen )
			{
				<div class="hub-rail">
					<div class="hub-rail-head">
						<span class="hub-rail-title">TAMER PROFILE</span>
						<div class="hub-rail-head-spacer"></div>
						<div class="hub-rail-close"
							 onmouseover=@(() => SoundManager.PlayHover())
							 onclick=@CloseRail>
							<iconify class="hub-rail-close-glyph" icon="lucide:x" Size=@(13) Color="rgba(244,241,234,0.7)" />
							<span class="hub-rail-close-cap">Q</span>
						</div>
					</div>
					<div class="td-card">
						@if ( selectedKind == "self" )
						{
							@{
								var heroSteam = GetLocalSteamId();
								var localTitleColor = GetLocalTitleColor();
								var xpPct = GetXpPercent();
								var xpPctStr = (xpPct * 100f).ToString( "F1", System.Globalization.CultureInfo.InvariantCulture );
							}

							<!-- Hero / Portrait section -->
							<div class="tamer-portrait-section">
								<div class="tamer-portrait-wrapper">
									<div class="tamer-portrait-frame @(heroSteam > 0 ? "steam" : "cartoon") @GetTamerGender()" style="border-color: @localTitleColor">
										@if ( heroSteam > 0 )
										{
											<img class="tamer-portrait-img" src="avatar:@heroSteam" />
										}
										else
										{
											<img class="tamer-portrait-img cartoon-img" src="@GetGenderAvatar()" />
										}
									</div>
									<div class="tamer-portrait-level"><span class="tamer-portrait-level-num">@($"LV {GetPlayerLevel()}")</span></div>
									@if ( IsDev() )
									{
										<div class="tamer-portrait-dev"><span>DEV</span></div>
									}
								</div>
								<div class="tamer-portrait-info">
									<div class="tamer-name-row">
										<span class="tamer-name @(IsDev() ? "dev" : "")">@GetPlayerName()</span>
									</div>
									<div class="tamer-title-row">
										<span class="tamer-title-text" style="color: @localTitleColor">@GetLocalTitle()</span>
									</div>
									@if ( IsInGuild() )
									{
										<div class="tamer-guild-row">
											<iconify icon="lucide:shield" Size=@(11) Color="@(GuildManager.Instance?.Guild?.EmblemColor ?? "#7c3aed")" />
											<span class="tamer-guild-text" style="color: @(GuildManager.Instance?.Guild?.EmblemColor ?? "#7c3aed")">@($"[{GuildManager.Instance?.Guild?.Tag}] {GuildManager.Instance?.Guild?.Name}")</span>
										</div>
									}
									<div class="tamer-xp-bar">
										<div class="tamer-xp-fill" style="width: @(xpPctStr)%"></div>
									</div>
								</div>
							</div>

							<!-- ACTIONS -->
							<div class="tamer-detail-section-header">
								<span class="tamer-detail-section-text">ACTIONS</span>
							</div>
							<div class="tamer-actions">
								<div class="tamer-action primary"
									 onmouseover=@(() => SoundManager.PlayHover())
									 onclick=@ShowcaseCard>
									<iconify icon="lucide:share-2" Size=@(14) Color="#d4bfff" />
									<span class="tamer-action-label">Share to Chat</span>
								</div>
							</div>

							<!-- STATS -->
							<div class="tamer-detail-section-header">
								<span class="tamer-detail-section-text">STATS</span>
							</div>
							<div class="tamer-stats">
								<div class="tamer-stat">
									<span class="tamer-stat-val">@($"{GetMonstersCaught()}")</span>
									<span class="tamer-stat-label">CAUGHT</span>
								</div>
								<div class="tamer-stat">
									<span class="tamer-stat-val">@($"{GetAchievementCount()}")</span>
									<span class="tamer-stat-label">ACHV</span>
								</div>
								<div class="tamer-stat">
									<span class="tamer-stat-val">@GetPlayTimeForCard()</span>
									<span class="tamer-stat-label">TIME</span>
								</div>
								<div class="tamer-stat">
									<span class="tamer-stat-val">@($"{GetBattlesWon()}")</span>
									<span class="tamer-stat-label">WINS</span>
								</div>
							</div>

							<!-- FAVORITE BEAST -->
							<div class="tamer-detail-section-header">
								<span class="tamer-detail-section-text">FAVORITE BEAST</span>
							</div>
							<div class="tamer-fav-box @beastElementClass">
								@if ( showFavSelector )
								{
									<div class="tamer-fav-dropdown">
										<div class="tamer-fav-opt" onclick=@(() => SetFavorite( null ))>
											<span class="tamer-fav-opt-name">None</span>
										</div>
										@foreach ( var species in GetDiscoveredSpeciesList() )
										{
											<div class="tamer-fav-opt" onclick=@(() => SetFavorite( species.Id ))>
												@if ( !string.IsNullOrEmpty( species.IconPath ) )
												{
													<img class="tamer-fav-opt-icon" src="@species.IconPath" />
												}
												<span class="tamer-fav-opt-name">@species.Name</span>
											</div>
										}
									</div>
								}
								else
								{
									<div class="tamer-fav-display" onclick=@OpenFavSelector>
										<div class="tamer-fav-portrait">
											@if ( favBeastSpecies != null && !string.IsNullOrEmpty( favBeastSpecies.IconPath ) )
											{
												<img class="tamer-fav-portrait-img" src="@favBeastSpecies.IconPath" style="margin-left: @(favBeastSpecies.IconOffsetX - 18)px; margin-top: @(favBeastSpecies.IconOffsetY)px" />
											}
											else
											{
												<iconify icon="lucide:circle-help" Size=@(28) Color="rgba(255,255,255,0.3)" />
											}
										</div>
										<span class="tamer-fav-name">@GetFavoriteName()</span>
										<span class="tamer-fav-change">Change</span>
									</div>
								}
							</div>
						}
						else if ( selectedKind == "online" && selectedOnlinePlayer != null )
						{
							@{
								var p = selectedOnlinePlayer;
								var isMutedFlag = vcm?.IsPlayerMuted( p.ConnectionId ) ?? false;
								var pTitleColor = !string.IsNullOrEmpty( p.TitleColor ) ? p.TitleColor : "#a78bfa";
								var pFavSpecies = !string.IsNullOrEmpty( p.FavoriteMonsterSpeciesId )
									? MonsterManager.Instance?.GetSpecies( p.FavoriteMonsterSpeciesId )
									: null;
								var pElementClass = pFavSpecies?.Element.ToString().ToLower() ?? "";
								var pPlayTime = p.TotalPlayTimeMinutes <= 0
									? "-"
									: ( p.TotalPlayTimeMinutes < 60
										? $"{p.TotalPlayTimeMinutes}m"
										: ( p.TotalPlayTimeMinutes < 60 * 24
											? $"{p.TotalPlayTimeMinutes / 60}h"
											: $"{p.TotalPlayTimeMinutes / (60 * 24)}d" ) );
							}

							<!-- Hero / Portrait section -->
							<div class="tamer-portrait-section">
								<div class="tamer-portrait-wrapper">
									<div class="tamer-portrait-frame @(p.SteamId > 0 ? "steam" : "cartoon") @p.GenderClass" style="border-color: @pTitleColor">
										@if ( p.SteamId > 0 )
										{
											<img class="tamer-portrait-img" src="avatar:@p.SteamId" />
										}
										else
										{
											<img class="tamer-portrait-img cartoon-img" src="@p.AvatarPath" />
										}
									</div>
									@if ( p.Level > 0 )
									{
										<div class="tamer-portrait-level"><span class="tamer-portrait-level-num">@($"LV {p.Level}")</span></div>
									}
									@if ( p.IsDev )
									{
										<div class="tamer-portrait-dev"><span>DEV</span></div>
									}
								</div>
								<div class="tamer-portrait-info">
									<div class="tamer-name-row">
										<span class="tamer-name @(p.IsDev ? "dev" : "")">@p.Name</span>
									</div>
									<div class="tamer-title-row">
										<span class="tamer-title-text" style="color: @pTitleColor">@p.Title</span>
									</div>
									@if ( GuildManager.UiEnabled && !string.IsNullOrEmpty( p.GuildTag ) )
									{
										<div class="tamer-guild-row">
											<iconify icon="lucide:shield" Size=@(11) Color="#c084fc" />
											<span class="tamer-guild-text">@($"[{p.GuildTag}] {p.GuildName ?? ""}")</span>
										</div>
									}
									<div class="tamer-online-pill">
										<span class="tamer-online-dot"></span>
										<span class="tamer-online-text">ONLINE NOW</span>
									</div>
								</div>
							</div>

							<!-- ACTIONS -->
							<div class="tamer-detail-section-header">
								<span class="tamer-detail-section-text">ACTIONS</span>
							</div>
							<div class="tamer-actions tamer-actions-grid">
								<div class="tamer-action primary"
									 onmouseover=@(() => SoundManager.PlayHover())
									 onclick=@(() => RequestTrade( p ))>
									<iconify icon="lucide:handshake" Size=@(14) Color="#4ade80" />
									<span class="tamer-action-label">Trade</span>
								</div>
								<div class="tamer-action @(inLobbyVoice ? "active" : "")"
									 onmouseover=@(() => SoundManager.PlayHover())
									 onclick=@JoinLobbyVoice>
									<iconify icon="lucide:volume-2" Size=@(14) Color="#a78bfa" />
									<span class="tamer-action-label">Voice</span>
								</div>
								<div class="tamer-action @(isMutedFlag ? "muted" : "")"
									 onmouseover=@(() => SoundManager.PlayHover())
									 onclick=@(() => ToggleMutePlayer( p.ConnectionId ))>
									<iconify icon="@(isMutedFlag ? "lucide:mic-off" : "lucide:mic")" Size=@(14) Color="@(isMutedFlag ? "#f87171" : "rgba(255,255,255,0.7)")" />
									<span class="tamer-action-label">@(isMutedFlag ? "Unmute" : "Mute")</span>
								</div>
							</div>

							@if ( p.HasProfile )
							{
								<!-- STATS -->
								<div class="tamer-detail-section-header">
									<span class="tamer-detail-section-text">STATS</span>
								</div>
								<div class="tamer-stats">
									<div class="tamer-stat">
										<span class="tamer-stat-val">@p.MonstersCaught.ToString("N0")</span>
										<span class="tamer-stat-label">CAUGHT</span>
									</div>
									<div class="tamer-stat">
										<span class="tamer-stat-val">@p.AchievementCount.ToString("N0")</span>
										<span class="tamer-stat-label">ACHV</span>
									</div>
									<div class="tamer-stat">
										<span class="tamer-stat-val">@pPlayTime</span>
										<span class="tamer-stat-label">TIME</span>
									</div>
									<div class="tamer-stat">
										<span class="tamer-stat-val">@p.BattlesWon.ToString("N0")</span>
										<span class="tamer-stat-label">WINS</span>
									</div>
								</div>

								@if ( pFavSpecies != null )
								{
									<!-- FAVORITE BEAST (read-only) -->
									<div class="tamer-detail-section-header">
										<span class="tamer-detail-section-text">FAVORITE BEAST</span>
									</div>
									<div class="tamer-fav-box @pElementClass">
										<div class="tamer-fav-display readonly">
											<div class="tamer-fav-portrait">
												<img class="tamer-fav-portrait-img" src="@pFavSpecies.IconPath" style="margin-left: @(pFavSpecies.IconOffsetX - 18)px; margin-top: @(pFavSpecies.IconOffsetY)px" />
											</div>
											<span class="tamer-fav-name">@pFavSpecies.Name</span>
										</div>
									</div>
								}
							}

							<!-- INFO -->
							<div class="tamer-detail-section-header">
								<span class="tamer-detail-section-text">INFO</span>
							</div>
							<div class="tamer-info-block">
								<div class="tamer-info-row">
									<span class="tamer-info-label">Status</span>
									<span class="tamer-info-value" style="color: #4ade80">@($"Connected")</span>
								</div>
								@if ( GuildManager.UiEnabled && !string.IsNullOrEmpty( p.GuildName ) )
								{
									<div class="tamer-info-row">
										<span class="tamer-info-label">Guild</span>
										<span class="tamer-info-value">@p.GuildName</span>
									</div>
								}
								@if ( p.HasProfile && p.HighestExpedition > 0 )
								{
									<div class="tamer-info-row">
										<span class="tamer-info-label">Stage</span>
										<span class="tamer-info-value">@p.HighestExpedition.ToString("N0")</span>
									</div>
								}
								@if ( p.HasProfile && !string.IsNullOrEmpty( p.ArenaRank ) && p.ArenaRank != "Unranked" )
								{
									<div class="tamer-info-row">
										<span class="tamer-info-label">Rank</span>
										<span class="tamer-info-value">@p.ArenaRank</span>
									</div>
								}
								<div class="tamer-info-row">
									<span class="tamer-info-label">Voice</span>
									<span class="tamer-info-value">@(isMutedFlag ? "Muted by you" : (inLobbyVoice ? "In lobby voice" : "Available"))</span>
								</div>
							</div>
						}
					</div>
				</div>
			}
		</div>
	}
	else if ( BattleEnabled && (currentSection == "ranked" || IsArenaActive()) )
	{
		<!-- Battle - Embeds the full ArenaPanel (quickplay and/or ranked per flags) -->
		<ArenaPanel @ref="arenaPanel" OnBack=@BackToHub />
	}
	else if ( currentSection == "leaderboards" )
	{
		<!-- Leaderboards Section -->
		<LeaderboardPanel @ref="leaderboardRef" OnBack=@BackToHub />
	}
	else if ( GuildManager.UiEnabled && currentSection == "guild" )
	{
		<!-- Guild Section — wrapped in a flex:1 div so the inner GuildPanel
		     reliably claims the column's remaining height. Razor-element
		     style declarations (`GuildPanel { flex: 1 }`) don't always
		     propagate height in s&box; an explicit class wrapper does. -->
		<div class="hub-guild-wrap">
			<GuildPanel @ref="guildRef" OnBack=@BackToHub />
		</div>
	}

	<!-- THE LIVING VIOLET RING — the one waving cursor. Root-level
	     absolute; position written imperatively per tick from live rects,
	     ink-lean wave via imperative Style.Transform. Ring hosts only
	     (battle CTAs, guild CTA, presence heads); dense rows (trade
	     slips, leaderboard rows) wear the slab-cursor .kb-focused class
	     instead — the clearance rule, online-motion-spec §1. -->
	<div @ref="tamerRingRef" class="tamer-ring"></div>
</div>

@code {
	// Localization helper
	private string L( string key ) => LocalizationManager.Get( key );
	private string L( string key, params object[] args ) => LocalizationManager.Get( key, args );

	private string currentSection = "players";
	private LeaderboardPanel leaderboardRef;
	private GuildPanel guildRef;
	private ArenaPanel arenaPanel;
	private bool showFavSelector = false;

	// Profile rail — opens on a presence-head click/E, closes on Q/✕.
	// selectedKind ∈ { "self", "online" } drives which card renders.
	private string selectedKind = "self";
	private OnlinePlayerInfo selectedOnlinePlayer = null;
	private bool railOpen = false;

	// ── Keyboard navigation — one cursor, five zones ───────────────────────
	// _kbZone names the zone ("battle" | "trades" | "guild" | "online" |
	// "boards"); _kbIndex walks its focusables. Ring zones (battle/guild/
	// online) show the living ring; slab zones (trades/boards) mark the
	// focused row with .kb-focused (border+bg only — scroll-grid law kept
	// even though the landing doesn't scroll, for sibling consistency).
	// The cursor rests on FIND A BATTLE on open (motion spec: the ring
	// materializes with the hero, no fly-in) — hence _kbActive = true.
	private string _kbZone = "battle";
	private int _kbIndex = 0;
	private bool _kbActive = true;

	private const int MaxTradeSlips = 3;
	private const int MaxHeads = 7;
	private const int MaxGuildHeads = 4;
	// 12 rows × 52px (+ the segment row, YOU and the foot) fills the 882px
	// column beside the 420/280/150 zones — see .hz-boards for the math.
	private const int HubLbMaxRows = 12;
	private static readonly string[] HubZoneOrder = { "battle", "trades", "guild", "online", "boards" };

	// Ring hosts (fixed) — resolved per tick; presence heads resolve by
	// walking the online row's children.
	// The three battle refs land on the IN-TILE BbButtons (2026-08-29 —
	// the ring wraps a button inside each tile, never the whole tile).
	private Panel ctaFindRef, ctaPracticeRef, ctaRankedRef, guildCtaRef, onlineRowRef, postOfferRef;

	// POST OFFER note — the tile is inert until the standing-offer board
	// ships; a press swaps its sub-line to a quiet note for 3s (no dead
	// click). Tick() flips _postNoteLive back and re-renders.
	private float _postNoteUntil = -1f;
	private bool _postNoteLive = false;

	private void OnPanelClicked()
	{
		GameHUD.EnterPanel();
	}

	// ── Compact leaderboards (the hub column) ──────────────────────────────
	// Same Steam data path as LeaderboardPanel (GetFromStat +
	// SetAggregationMax — the v1.0.1 inflation fix), loaded once per mount.
	// R cycles the category.
	private record HubLbCatDef( string Key, string BoardName, string Label, string Blurb );
	private static readonly HubLbCatDef[] HubLbCats = new[]
	{
		new HubLbCatDef( "contracted", "monsters-caught-launch", "CONTRACTED", "most beasts contracted" ),
		new HubLbCatDef( "battles", "battles-won-launch", "BATTLES WON", "most battles won" ),
		new HubLbCatDef( "fused", "monsters-bred-launch", "FUSED", "most beasts fused" ),
		new HubLbCatDef( "gold", "total-gold-launch", "GOLD EARNED", "most gold earned" )
	};

	private class HubLbEntry
	{
		public int Rank { get; set; }
		public string Name { get; set; }
		public long Score { get; set; }
		public long SteamId { get; set; }   // Board2.Entry.SteamId — drives the row's Steam avatar
	}

	private int hubLbCatIndex = 0;
	private bool hubLbLoading = true;
	private Dictionary<string, List<HubLbEntry>> hubLbEntries = new();
	private Dictionary<string, HubLbEntry> hubLbSelf = new();

	protected override async void OnAfterTreeRender( bool firstTime )
	{
		_devHub = this;
		if ( firstTime )
		{
			await LoadHubLeaderboards();
		}
	}

	// ── DEV: ring-host rect probe ────────────────────────────────────────
	// dev_hubring — one line per ring host: its Box.Rect, its offset from
	// the hub root, element + classes; plus the root rect, ScaleFromScreen,
	// the current cursor and the ring's own rect. Compare "local" against
	// where the button PAINTS to settle a measured-vs-visual drift in one
	// call (multi-line Log.Info truncates — hence one Log.Info per line).
	private static OnlineHubPanel _devHub;

	[ConCmd( "dev_hubring" )]
	public static void DevHubRing()
	{
		var p = _devHub;
		if ( p == null ) { Log.Warning( "[dev_hubring] Online hub not mounted." ); return; }
		var rr = p.Box.Rect;
		Log.Info( $"[dev_hubring] root={rr} scale={p.ScaleFromScreen} cursor={p._kbZone}/{p._kbIndex} active={p._kbActive} ringVisible={p._ringVisible}" );
		p.DevDumpHost( "FIND A MATCH", p.ctaFindRef, rr );
		p.DevDumpHost( "PLAY RANKED", p.ctaRankedRef, rr );
		p.DevDumpHost( "BATTLE THE AI", p.ctaPracticeRef, rr );
		p.DevDumpHost( "POST OFFER", p.postOfferRef, rr );
		p.DevDumpHost( "OPEN GUILD", p.guildCtaRef, rr );
		if ( p.onlineRowRef != null )
		{
			int n = 0;
			foreach ( var seat in p.onlineRowRef.Children )
			{
				if ( !seat.HasClass( "oz-seat" ) ) continue;
				p.DevDumpHost( $"head {n}", FindDescendantByClass( seat, "oz-avatar" ) ?? seat, rr );
				n++;
			}
		}
		p.DevDumpHost( "ring", p.tamerRingRef, rr );
		Log.Info( $"[dev_hubring] ring style L/T/W/H = {p._ringL}/{p._ringT}/{p._ringW}/{p._ringH}" );
	}

	private void DevDumpHost( string name, Panel h, Rect rr )
	{
		if ( h == null ) { Log.Info( $"[dev_hubring] {name}: null ref" ); return; }
		var r = h.Box.Rect;
		Log.Info( $"[dev_hubring] {name}: rect={r} local=({r.Left - rr.Left:0.#},{r.Top - rr.Top:0.#}) size=({r.Width:0.#}x{r.Height:0.#}) el={h.ElementName} classes={h.Classes}" );
	}

	private async Task LoadHubLeaderboards()
	{
		hubLbLoading = true;

		var tasks = HubLbCats.Select( async cat =>
		{
			try
			{
				var board = Leaderboards.GetFromStat( "publicsquare.beastborne", cat.BoardName );
				// Cumulative counters — take the highest submitted value, not a
				// sum/average (mirrors LeaderboardPanel's inflation fix).
				board.SetAggregationMax();
				board.MaxEntries = 100;
				await board.Refresh();

				var localSteam = GetLocalSteamId();
				var entries = board.Entries.Select( e => new HubLbEntry
				{
					Rank = (int)e.Rank,
					Name = e.DisplayName,
					Score = (long)e.Value,
					SteamId = (long)e.SteamId
				} ).ToList();

				// Self match by SteamId first (exact), display name as the fallback.
				var myName = Connection.Local?.DisplayName;
				var mine = ( localSteam > 0 ? entries.FirstOrDefault( x => x.SteamId == localSteam ) : null )
					?? entries.FirstOrDefault( x => x.Name == myName );

				lock ( hubLbEntries )
				{
					hubLbEntries[cat.Key] = entries;
					hubLbSelf[cat.Key] = mine ?? new HubLbEntry { Rank = 0, Name = myName, Score = 0, SteamId = localSteam };
				}
			}
			catch ( Exception e )
			{
				Log.Warning( $"Hub leaderboard fetch failed '{cat.BoardName}': {e.Message}" );
				lock ( hubLbEntries )
				{
					hubLbEntries[cat.Key] = new();
				}
			}
		} );

		await Task.WhenAll( tasks );
		hubLbLoading = false;
		StateHasChanged();
	}

	private List<HubLbEntry> CurrentHubLbEntries()
	{
		lock ( hubLbEntries )
		{
			return hubLbEntries.TryGetValue( HubLbCats[hubLbCatIndex].Key, out var list ) ? list : new();
		}
	}

	private void CycleHubLbCategory()
	{
		SoundManager.PlayClick();
		hubLbCatIndex = ( hubLbCatIndex + 1 ) % HubLbCats.Length;
		// Keep the boards cursor in range for the new category's row count.
		if ( _kbZone == "boards" )
			_kbIndex = Math.Clamp( _kbIndex, 0, Math.Max( 0, HubBoardsCount() - 1 ) );
		StateHasChanged();
	}

	// ── THE LIVING VIOLET RING ─────────────────────────────────────────────
	// Position recomputed every Tick from live Box.Rects and written
	// IMPERATIVELY via Style (this panel does not re-render per frame;
	// imperative writes on a flat panel are cheap). CSS transitions carry
	// the glide; the ink-lean wave is a per-frame Style.Transform.
	private Panel tamerRingRef;
	private int _ringL = -500, _ringT = -500, _ringW, _ringH;
	private bool _ringVisible;
	private int _ringWarm; // <2 = snap to position (no glide) while first rects land

	// 8px box inset each side; the 4px border lives in SCSS. Declared sizes
	// are CONTENT-box (s&box has no border-box), so the update subtracts the
	// 8px of ring border to keep the gap concentric.
	private const int RingInset = 8;

	public override void Tick()
	{
		base.Tick();
		UpdateHubRing();
		ApplyRingWave();

		bool noteLive = Time.Now < _postNoteUntil;
		if ( noteLive != _postNoteLive )
		{
			_postNoteLive = noteLive;
			StateHasChanged();
		}
	}

	// Ring costume hosts: the three in-tile battle BUTTONS, the guild CTA,
	// the presence heads, and the POST OFFER tile (trades kb 0). Trade
	// slips (kb 1+) and leaderboard rows wear the slab cursor instead.
	private bool IsRingCursor()
		=> _kbZone == "battle" || _kbZone == "guild" || _kbZone == "online"
		|| ( _kbZone == "trades" && _kbIndex == 0 );

	private Panel ResolveRingTarget()
	{
		switch ( _kbZone )
		{
			case "battle":
				// 0 = FIND A MATCH (rest) · 1 = PLAY RANKED · 2 = BATTLE THE AI —
				// the in-tile buttons, one row, left to right
				return _kbIndex switch { 0 => ctaFindRef, 1 => ctaRankedRef, _ => ctaPracticeRef };
			case "trades":
				return _kbIndex == 0 ? postOfferRef : null;
			case "guild":
				return guildCtaRef;
			case "online":
				if ( onlineRowRef == null ) return null;
				int n = 0;
				foreach ( var seat in onlineRowRef.Children )
				{
					if ( !seat.HasClass( "oz-seat" ) ) continue;
					if ( n == _kbIndex ) return FindDescendantByClass( seat, "oz-avatar" ) ?? seat;
					n++;
				}
				return null;
		}
		return null;
	}

	private static Panel FindDescendantByClass( Panel root, string cls )
	{
		foreach ( var c in root.Children )
		{
			if ( c.HasClass( cls ) ) return c;
			var d = FindDescendantByClass( c, cls );
			if ( d != null ) return d;
		}
		return null;
	}

	private void UpdateHubRing()
	{
		if ( tamerRingRef == null ) return;

		bool wasVisible = _ringVisible;
		_ringVisible = false;

		if ( currentSection == "players" && !IsArenaActive() && _kbActive && !railOpen && IsRingCursor() )
		{
			var target = ResolveRingTarget();
			if ( target != null )
			{
				var rr = Box.Rect;
				var cr = target.Box.Rect;

				// Presence heads pop scale(1.14) while kb-lit and CSS transforms
				// don't move Box.Rect — mirror the pop into the target rect so the
				// ring keeps its 8px gap around the popped head instead of
				// grazing it (the PawPad focus-pop lockstep rule).
				if ( _kbZone == "online" && cr.Width > 1f )
				{
					const float grow = 0.14f;
					cr = new Rect( cr.Left - cr.Width * grow * 0.5f, cr.Top - cr.Height * grow * 0.5f,
						cr.Width * ( 1f + grow ), cr.Height * ( 1f + grow ) );
				}

				if ( rr.Width > 1f && cr.Width > 1f )
				{
					float sc = ScaleFromScreen;
					if ( sc <= 0.01f || float.IsNaN( sc ) || float.IsInfinity( sc ) ) sc = 1f;

					int l = (int)((cr.Left - rr.Left) * sc) - RingInset;
					int t = (int)((cr.Top - rr.Top) * sc) - RingInset;
					int w = (int)(cr.Width * sc) + RingInset * 2 - 8;
					int h = (int)(cr.Height * sc) + RingInset * 2 - 8;

					if ( l != _ringL ) { _ringL = l; tamerRingRef.Style.Left = Length.Pixels( l ); }
					if ( t != _ringT ) { _ringT = t; tamerRingRef.Style.Top = Length.Pixels( t ); }
					if ( w != _ringW ) { _ringW = w; tamerRingRef.Style.Width = Length.Pixels( w ); }
					if ( h != _ringH ) { _ringH = h; tamerRingRef.Style.Height = Length.Pixels( h ); }

					_ringVisible = true;
					if ( !wasVisible ) _ringWarm = 0;       // re-appearing → snap first, glide after
					else if ( _ringWarm < 2 ) _ringWarm++;
				}
			}
		}

		tamerRingRef.SetClass( "on", _ringVisible );
		tamerRingRef.SetClass( "snap", _ringWarm < 2 );
		// Costumes — the ring's radius follows its host: circle on presence
		// heads, near-square on the radius-0 slabs (the POST OFFER bar, the
		// skewed OPEN GUILD chip). The battle buttons are 16px-radius
		// BbButtons — they take the default r24 costume.
		tamerRingRef.SetClass( "round", _ringVisible && _kbZone == "online" );
		tamerRingRef.SetClass( "square", _ringVisible && ( _kbZone == "trades" || _kbZone == "guild" ) );
	}

	// The liquid ink-lean — the menu cursor's multi-sine at the PawPad's
	// ×0.6 amplitude + out-of-phase breathing. Imperative transform: no
	// re-render, flat panel, cheap.
	private void ApplyRingWave()
	{
		if ( tamerRingRef == null || !_ringVisible ) return;
		float wt = Time.Now;
		float skX = ( 2.0f * MathF.Sin( wt * 2.2f ) + 0.7f * MathF.Sin( wt * 3.5f + 1.1f ) ) * 0.6f;
		float skY = ( 2.3f * MathF.Sin( wt * 1.8f + 1.9f ) + 0.9f * MathF.Sin( wt * 2.9f ) ) * 0.6f;
		float rotZ = ( 1.1f * MathF.Sin( wt * 1.0f ) + 0.5f * MathF.Sin( wt * 2.4f + 0.5f ) ) * 0.6f;
		float brX = 1f + 0.013f * MathF.Sin( wt * 1.35f + 0.7f ) + 0.006f * MathF.Sin( wt * 2.7f );
		float brY = 1f + 0.013f * MathF.Sin( wt * 1.15f + 2.6f ) + 0.006f * MathF.Sin( wt * 2.3f + 1.4f );

		// OPEN GUILD is a skewX(-12°) chip: its layout box (what the ring
		// measures) and its visual parallelogram don't coincide, so the ring
		// wears the same base skew there — both skew about their shared
		// centre, so the ring hugs the parallelogram at the usual 8px gap.
		// The wave rides on top of it.
		if ( _kbZone == "guild" ) skX -= 12f;

		var t = new PanelTransform();
		t.AddRotation( 0f, 0f, rotZ );
		t.AddSkew( skX, skY, 0f );
		t.AddScale( new Vector2( brX, brY ) );
		tamerRingRef.Style.Transform = t;
	}

	// ── Keyboard input ─────────────────────────────────────────────────────

	public void TickInput()
	{
		// Battle owns the keyboard entirely while active — keep the
		// existing delegation untouched and bail before any hub nav runs.
		if ( BattleEnabled && (currentSection == "ranked" || IsArenaActive()) )
		{
			arenaPanel?.TickInput();
			return;
		}

		// Takeover sections — the child panel owns the keyboard; with the
		// pill row retired, Q is the way back to the hub landing. Children
		// claim Menu (PanelHandledBackKey) for their internal back stack
		// first; an unclaimed Q here returns to the hub instead of letting
		// GameHUD exit the whole tab.
		if ( currentSection != "players" )
		{
			if ( currentSection == "leaderboards" ) leaderboardRef?.TickInput();
			else if ( currentSection == "guild" ) guildRef?.TickInput();

			if ( Input.Pressed( "Menu" ) && !GameHUD.PanelHandledBackKey )
			{
				BackToHub();
				GameHUD.PanelHandledBackKey = true;
				StateHasChanged();
			}
			return;
		}

		// ── The landing ──
		// Inline favorite-beast dropdown (inside the rail): Q closes it as
		// an internal back before anything else runs.
		if ( showFavSelector && Input.Pressed( "Menu" ) )
		{
			showFavSelector = false;
			SoundManager.PlayBack();
			GameHUD.PanelHandledBackKey = true;
			StateHasChanged();
			return;
		}

		// Profile rail: Q closes; while open, the rail is mouse-driven and
		// the zone cursor stays frozen underneath.
		if ( railOpen )
		{
			if ( Input.Pressed( "Menu" ) )
			{
				CloseRail();
				GameHUD.PanelHandledBackKey = true;
				StateHasChanged();
			}
			return;
		}

		int others = OnlineOthersCount();

		if ( Input.Pressed( "Reload" ) ) { CycleHubLbCategory(); return; }
		if ( Input.Pressed( "CyclePrev" ) ) { HopZone( -1, others ); return; }
		if ( Input.Pressed( "CycleNext" ) ) { HopZone( 1, others ); return; }

		ClampHubCursor( others );

		// Space (advertised) / Enter / E (silent alternate) — confirm.
		if ( Input.Pressed( "Jump" ) || Input.Pressed( "Enter" ) || Input.Pressed( "Use" ) )
		{
			ActivateHubCursor( others );
			return;
		}

		int dx = 0, dy = 0;
		if ( Input.Pressed( "Left" ) ) dx = -1;
		else if ( Input.Pressed( "Right" ) ) dx = 1;
		else if ( Input.Pressed( "Up" ) ) dy = -1;
		else if ( Input.Pressed( "Down" ) ) dy = 1;
		if ( dx != 0 || dy != 0 ) MoveHubCursor( dx, dy, others );
	}

	private int OnlineOthersCount()
		=> IsConnected() ? GetOnlinePlayers().Count( p => !p.IsLocal ) : 0;

	private int HubBoardsCount()
	{
		int rows = Math.Min( CurrentHubLbEntries().Count, HubLbMaxRows );
		return rows > 0 ? rows + 2 : 1;   // rows + YOU + foot, or just the foot
	}

	private int HubBoardsYouIndex()
		=> Math.Min( CurrentHubLbEntries().Count, HubLbMaxRows );

	private int HubZoneCount( string zone, int others )
	{
		switch ( zone )
		{
			case "battle": return 3;
			case "trades": return 1 + Math.Min( others, MaxTradeSlips ); // POST OFFER + live slips
			case "guild": return GuildManager.UiEnabled ? 1 : 0;
			case "online": return 1 + Math.Min( others, MaxHeads );
			case "boards": return HubBoardsCount();
		}
		return 0;
	}

	private void ClampHubCursor( int others )
	{
		int count = HubZoneCount( _kbZone, others );
		if ( count <= 0 )
		{
			_kbZone = "battle";
			_kbIndex = 0;
			return;
		}
		_kbIndex = Math.Clamp( _kbIndex, 0, count - 1 );
	}

	// Z/X — silent zone hop: BATTLE → TRADES → GUILD → ONLINE NOW →
	// LEADERBOARDS, wrapping, skipping zones with nothing focusable.
	// Boards lands on the pinned YOU row (never lose yourself).
	private void HopZone( int dir, int others )
	{
		int idx = Array.IndexOf( HubZoneOrder, _kbZone );
		if ( idx < 0 ) idx = 0;
		for ( int step = 1; step <= HubZoneOrder.Length; step++ )
		{
			int n = ( ( idx + dir * step ) % HubZoneOrder.Length + HubZoneOrder.Length ) % HubZoneOrder.Length;
			var zone = HubZoneOrder[n];
			int count = HubZoneCount( zone, others );
			if ( count <= 0 ) continue;
			_kbZone = zone;
			_kbIndex = zone == "boards" ? Math.Min( HubBoardsYouIndex(), count - 1 ) : 0;
			_kbActive = true;
			StateHasChanged();
			return;
		}
	}

	// WASD / arrows — flow within a zone; crossing a zone boundary follows
	// the page's spatial seams:
	//   battle: QUICKPLAY(0) → RANKED(1) → PRACTICE(2) → boards (one row);
	//           QUICKPLAY / RANKED ↓ trades · PRACTICE ↓ guild
	//   trades: slips(1..n) stacked above POST OFFER(0); → guild; ↑ battle; ↓ heads
	//   guild ← trades · guild ↑ PRACTICE · guild ↓ heads · guild → boards (YOU)
	//   heads ↑ trades · heads → boards (YOU)
	private void MoveHubCursor( int dx, int dy, int others )
	{
		string z = _kbZone; int i = _kbIndex;
		string nz = z; int ni = i;
		int tradeCount = Math.Min( others, MaxTradeSlips );
		int headCount = 1 + Math.Min( others, MaxHeads );
		int guildCount = GuildManager.UiEnabled ? 1 : 0;
		int boardsCount = HubBoardsCount();

		switch ( z )
		{
			case "battle":
				// One row: QUICKPLAY(0) → RANKED(1) → PRACTICE(2) → boards.
				// Down: QUICKPLAY / RANKED sit over TRADE OFFERS (first slip, else
				// POST OFFER); PRACTICE sits over the GUILD card.
				if ( dx > 0 )
				{
					if ( i < 2 ) ni = i + 1;
					else { nz = "boards"; ni = 0; }
				}
				else if ( dx < 0 ) { if ( i > 0 ) ni = i - 1; }
				else if ( dy > 0 )
				{
					if ( i == 2 && guildCount > 0 ) { nz = "guild"; ni = 0; }
					else { nz = "trades"; ni = tradeCount > 0 ? 1 : 0; }
				}
				break;

			case "trades":
				// Slips (1..n) stack ABOVE the POST OFFER bar (0).
				if ( i == 0 )
				{
					if ( dy < 0 ) { if ( tradeCount > 0 ) ni = tradeCount; else { nz = "battle"; ni = 0; } }
					else if ( dy > 0 ) { nz = "online"; ni = 0; }
					else if ( dx > 0 )
					{
						if ( guildCount > 0 ) { nz = "guild"; ni = 0; }
						else { nz = "boards"; ni = 0; }
					}
				}
				else
				{
					if ( dy < 0 ) { if ( i > 1 ) ni = i - 1; else { nz = "battle"; ni = 0; } }
					else if ( dy > 0 ) { if ( i < tradeCount ) ni = i + 1; else ni = 0; }
					else if ( dx > 0 )
					{
						if ( guildCount > 0 ) { nz = "guild"; ni = 0; }
						else { nz = "boards"; ni = 0; }
					}
				}
				break;

			case "guild":
				if ( dy < 0 ) { nz = "battle"; ni = 2; }
				else if ( dy > 0 ) { nz = "online"; ni = 0; }
				else if ( dx < 0 ) { nz = "trades"; ni = tradeCount > 0 ? 1 : 0; }
				else if ( dx > 0 ) { nz = "boards"; ni = Math.Min( HubBoardsYouIndex(), boardsCount - 1 ); }
				break;

			case "online":
				if ( dx < 0 ) { if ( i > 0 ) ni = i - 1; }
				else if ( dx > 0 )
				{
					if ( i < headCount - 1 ) ni = i + 1;
					else { nz = "boards"; ni = Math.Min( HubBoardsYouIndex(), boardsCount - 1 ); }
				}
				else if ( dy < 0 ) { nz = "trades"; ni = 0; }
				break;

			case "boards":
				if ( dy != 0 )
				{
					int t = i + dy;
					if ( t >= 0 && t < boardsCount ) ni = t;
				}
				else if ( dx < 0 ) { nz = "battle"; ni = 0; }
				break;
		}

		if ( nz != z || ni != i )
		{
			_kbZone = nz;
			_kbIndex = ni;
			_kbActive = true;
			SoundManager.PlayHover();
			StateHasChanged();
		}
		else if ( !_kbActive )
		{
			_kbActive = true;
			StateHasChanged();
		}
	}

	private void ActivateHubCursor( int others )
	{
		switch ( _kbZone )
		{
			case "battle":
				if ( _kbIndex == 1 ) { OnRankedChip(); return; }             // RANKED — routes when live, denies while COMING SOON
				if ( !BattleEnabled ) { SoundManager.PlayDeny(); return; }  // day-one honest dim
				SwitchTab( "ranked" );
				return;
			case "trades":
				if ( _kbIndex == 0 ) { OnPostOffer(); return; }
				var tradables = GetOnlinePlayers().Where( p => !p.IsLocal ).Take( MaxTradeSlips ).ToList();
				int slip = _kbIndex - 1;
				if ( slip >= 0 && slip < tradables.Count ) RequestTrade( tradables[slip] );
				return;
			case "guild":
				SwitchTab( "guild" );
				return;
			case "online":
				if ( _kbIndex == 0 ) { OpenRailSelf(); StateHasChanged(); return; }
				var heads = GetOnlinePlayers().Where( p => !p.IsLocal ).Take( MaxHeads ).ToList();
				int hi = _kbIndex - 1;
				if ( hi >= 0 && hi < heads.Count ) { OpenRailOnline( heads[hi] ); StateHasChanged(); }
				return;
			case "boards":
				SwitchTab( "leaderboards" );
				return;
		}
	}

