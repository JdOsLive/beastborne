	private string GetMiniDropSource( ItemDefinition drop )
	{
		if ( drop == null ) return "";
		if ( drop.Id.StartsWith( "mat_" ) )
		{
			var speciesId = drop.Id.Substring( 4 );
			var sp = MonsterManager.Instance?.GetSpecies( speciesId );
			return $"Drops from {sp?.Name ?? "this beast"}.";
		}
		var effect = drop.GetEffectDescription();
		return !string.IsNullOrEmpty( effect ) ? effect : drop.Description;
	}

	private bool IsZoneUnlocked( MapZone zone )
	{
		// Zone N is unlocked once the previous expedition has been cleared at
		// least once. HighestExpeditionCleared is a count (0 = none, 1 = cleared
		// expedition[0], 2 = cleared through expedition[1], etc.) — so a zone
		// at index N is unlocked when HighestExpeditionCleared >= N.
		var em = ExpeditionManager.Instance;
		var tamer = TamerManager.Instance?.CurrentTamer;
		if ( em == null || tamer == null ) return zone.Id == "saltmoor_cove"; // fail-safe: only the starter

		var exp = em.Expeditions.FirstOrDefault( e => e.Id == zone.ExpeditionId );
		if ( exp == null ) return false;

		// Tutorial-only zones are always unlocked while the tutorial is active.
		if ( exp.TutorialOnly )
		{
			return Beastborne.Core.TutorialManager.Instance?.IsTutorialActive == true;
		}

		// Compute the index against the non-tutorial chain so a player who skipped
		// the tutorial isn't gated by an expedition they can't see anymore.
		var realChain = em.Expeditions.Where( e => !e.TutorialOnly ).ToList();
		int idx = realChain.IndexOf( exp );
		return idx <= tamer.HighestExpeditionCleared;
	}

	/// <summary>
	/// Tutorial-only zones only show on the map while the tutorial is active.
	/// All other zones are always visible (their unlocked-state controls clickability).
	/// </summary>
	private bool IsZoneVisible( MapZone zone )
	{
		var em = ExpeditionManager.Instance;
		var exp = em?.Expeditions.FirstOrDefault( e => e.Id == zone.ExpeditionId );
		if ( exp == null ) return true;
		if ( exp.TutorialOnly )
		{
			return Beastborne.Core.TutorialManager.Instance?.IsTutorialActive == true;
		}
		return true;
	}

	protected override int BuildHash()
	{
		var h = new HashCode();
		h.Add( IsVisible );
		h.Add( _selectedZoneId );
		h.Add( _tradePopupNodeId );
		h.Add( _hoveredZoneId );
		h.Add( _hoveredLandmarkId );
		h.Add( _hoveredTradeNodeId );
		h.Add( _hoveredMiniId );
		h.Add( _selectedMiniId );
		h.Add( _kbMarkerIndex );
		h.Add( _editMode );
		h.Add( _draggingId );
		// Override dictionaries change on every drag tick — hash their counts +
		// a couple of values so re-render fires when positions shift.
		h.Add( _landmarkOverrides.Count );
		h.Add( _zoneOverrides.Count );
		h.Add( _tradeOverrides.Count );
		h.Add( _miniOverrides.Count );
		foreach ( var kv in _landmarkOverrides ) { h.Add( kv.Value.X ); h.Add( kv.Value.Y ); }
		foreach ( var kv in _zoneOverrides ) { h.Add( kv.Value.X ); h.Add( kv.Value.Y ); }
		foreach ( var kv in _tradeOverrides ) { h.Add( kv.Value.X ); h.Add( kv.Value.Y ); }
		foreach ( var kv in _miniOverrides ) { h.Add( kv.Value.X ); h.Add( kv.Value.Y ); }
		h.Add( TamerManager.Instance?.CurrentTamer?.Level ?? 0 );
		h.Add( TamerManager.Instance?.CurrentTamer?.HighestExpeditionCleared ?? 0 );
		h.Add( TamerManager.Instance?.CurrentTamer?.Gold ?? 0 );
		h.Add( ExpeditionManager.Instance?.CanStartExpedition( "mini_loomweaver_burrow" ) ?? false );
		// Rebuild the "ready" badge when the player's material counts change.
		var inv = TamerManager.Instance?.CurrentTamer?.Inventory;
		if ( inv != null )
		{
			foreach ( var node in TradeNodeManager.Instance?.AllNodes ?? new List<TradeNode>() )
			{
				foreach ( var (itemId, _) in node.Requirements )
				{
					inv.TryGetValue( itemId, out var cnt );
					h.Add( itemId );
					h.Add( cnt );
				}
				var state = TradeNodeManager.Instance?.GetState( node.Id );
				h.Add( state?.TimesCompleted ?? 0 );
			}
		}
		return h.ToHashCode();
	}
}
