	private static readonly Dictionary<string, (float X, float Y)> MiniPositions = new()
	{
		// Forest road between Weaverton Pasture (27.8%, 49.2%) and Weaverwood (68.6%, 53.3%).
		// Nudged north of the road midpoint so it reads as a cave detour, not dead-center on the path.
		{ "mini_loomweaver_burrow", (52f, 43f) },
