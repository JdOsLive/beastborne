	private IEnumerable<Expedition> GetMiniExpeditions()
	{
		return ExpeditionManager.Instance?.Expeditions
			.Where( e => e.IsMiniExpedition ) ?? Enumerable.Empty<Expedition>();
	}

	private (float X, float Y) GetMiniPos( string id )
	{
		if ( _miniOverrides.TryGetValue( id, out var ov ) ) return ov;
		if ( MiniPositions.TryGetValue( id, out var pos ) ) return pos;
		return (75f, 20f);
	}

	// Build the inline style for `.zd-portrait-icon-bg` — applies the
	// species' DetailIconScale/X/Y exactly the way the My Beasts detail
	// portrait does, so this thumbnail's framing matches the big version.
	// Math mirrors `MonsterCard.razor`'s mini-icon: explicit width/height
	// + left/top instead of CSS transform, so `image-rendering: pixelated`
	// stays crisp (transform-scale smooths bitmaps in s&box).
	//
	// The DetailIcon* values were tuned against a 120-px visible window
	// containing a 180-px sprite element. The thumbnail is a 72-px window,
	// so the sprite scales to 72 × 1.5 = 108 px base (preserving the same
	// "sprite area is 1.5× window" ratio), and pixel offsets scale by
	// 72/120 = 0.6.
	private string BuildZdIconStyle( Beastborne.Data.MonsterSpecies sp )
	{
		if ( sp == null ) return "";
		var ci = System.Globalization.CultureInfo.InvariantCulture;
		const float container = 72f;
		const float baseFit = 108f;       // container * 1.5 — matches portrait sprite-area ratio
		const float offsetMul = 0.6f;     // container / 120 — scale offsets to the smaller window
		float scale = sp.DetailIconScale;
		float spritePx = baseFit * scale;
		float left = ( container - spritePx ) * 0.5f + sp.DetailIconOffsetX * offsetMul;
		float top = ( container - spritePx ) * 0.5f + sp.DetailIconOffsetY * offsetMul;
		return $"background-image: url({sp.IconPath}); width: {spritePx.ToString( "F1", ci )}px; height: {spritePx.ToString( "F1", ci )}px; left: {left.ToString( "F1", ci )}px; top: {top.ToString( "F1", ci )}px;";
	}

