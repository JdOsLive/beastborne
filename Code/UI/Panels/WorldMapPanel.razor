@namespace Beastborne.UI.Panels
@using Sandbox;
@using Sandbox.UI;
@using Beastborne.Core;
@using Beastborne.Data;
@using Beastborne.Systems;
@using Beastborne.UI;
@using Beastborne.UI.Components;
@using Beastborne.UI.Primitives;
@using System;
@using System.Collections.Generic;
@using System.Linq;
@inherits Panel

@*
	WORLD MAP — the Expedition page (LAYOUT lane, pipeline run: expedition rebuild, part 1).
	Brief: .claude/design-system/components/expedition-redesign-brief.html + expedition-mock-page.html,
	revision 2 (expedition-revision-2.html) overrides run 1 where they differ. 1920×1080, padding-box.

	ZONE MAP (px):
	  .map-stage            abs 0/0 1920×1080 — the illustration IS the room (DOC-1 #7: no slab under the title)
	    .map-zoom           abs 0/0 1920×1080 — the UNLOCK REVEAL group: art frame + markers only; inline
	                        transform-origin = the reveal pin's % · `.reveal` class hook (LANE: motion owns the
	                        transition + beat ladder). Every child is absolute-% → nothing inside flex-grows.
	      .map-art-frame    base art · landmarks (+ hover title slab 32 r11) · clouds
	      .map-markers      .wm-dim (z40, mounts with a card/popup) · zone pins 44 · mini pins 32 · request pins 32
	    .map-vignette       abs full, OUTSIDE the group
	  .wm-header            abs 0/0 1920×88 + 2px strip · pad 16/32/12/28 · kicker 12/14 + 2 + title row 44 = 60
	                        (16 + 60 + 12 = 88 ✓) · right slot = ONE chip 32 r11 (BACK · Q slot left EMPTY — run-1 ledger; LANE: input)
	  .zd-card              abs x1420 y110 460 r22 pad 24 → 412 inner, content-sized (DropsLayout: fixed 728 with a
	                        kicker / 710 without — the WILD / DROPS heads are 36 .wm-band chipstamp rows, FEEL F1)
	  .rq-host → .rq-popup  abs full-cover FLEX-CENTRE host z65 → 560 r22 pad 24 → 512 lane, content-sized
	                        (Gnollcap 2 req · 1 reward = 604 → y 238; anatomy in the REQUEST POPUP block)
	  <TeamPickerPopup />   untouched (another lane)
*@

<root class="wm-root @(IsKbMode ? "kbd-mode" : "mouse-mode")" onmousemove=@OnRootMouseMove>
	<div class="map-stage">

		@* ═══ UNLOCK REVEAL GROUP — art frame + markers. Header / vignette / ring stay outside. ═══ *@
		@* LANE: motion — phase class ON the animated element (class string = remount hedge, learnings
		   2026-07-05/06): "" → "reveal" (zoom in 0.6s) → "reveal release" (zoom out 0.5s) → "". *@
		<div class="map-zoom @RevealGroupClass()" style="@RevealOriginStyle()">

			<div class="map-art-frame">
				<div class="map-base"></div>

				@* Village landmarks — decorative PNGs at the artist's % positions. Hover = a 32 r11 title slab. *@
				<div class="map-landmarks">
					@foreach ( var lm in Landmarks )
					{
						var landmark = lm;
						if ( landmark.IsDecoration )
						{
							<div class="landmark decoration" style="left: @(landmark.X)%; top: @(landmark.Y)%; width: @(landmark.Width)%;">
								<img class="landmark-art" src="@landmark.ImagePath" />
							</div>
						}
						else
						{
							var lmKey = "lm-" + landmark.Id;
							<div class="landmark @(_hoveredLandmarkId == landmark.Id ? "hovered" : "")"
								 style="left: @(landmark.X)%; top: @(landmark.Y)%; width: @(landmark.Width)%;"
								 onmouseover=@(() => OnLandmarkHover(landmark.Id, lmKey))
								 onmouseout=@(() => OnLandmarkLeave(landmark.Id))>
								<img class="landmark-art" src="@landmark.ImagePath" />
							</div>
						}
					}

					@* Hover title — 240×32 transparent host centred on the landmark (absolutes never
					   shrink-wrap → the slab is an in-flow child that hugs its label). *@
					@if ( _hoveredLandmarkId != null )
					{
						var hl = GetLandmark( _hoveredLandmarkId );
						if ( hl != null && !hl.IsDecoration )
						{
							<div class="lm-title-host" style="left: @(hl.X + hl.Width / 2)%; top: @(hl.Y)%;">
								<div class="lm-title"><span class="lm-title-text">@hl.Name</span></div>
							</div>
						}
					}
				</div>

				<div class="map-clouds"></div>
			</div>

			@* ═══ MARKERS — one pin family (orange diamonds), % positions against the art frame ═══ *@
			<div class="map-markers">

				@* Dim — mounts with the card or the request popup, INSIDE .map-markers so the selected
				   pin (same parent, higher z) stays lit above it. Click = close the top surface. *@
				@if ( _selectedExpId != null || _tradePopupNodeId != null )
				{
					@* LANE: motion (F3) — the dim leaves with the top surface's latch when nothing stays open
					   under it (popup over a card → the card keeps the dim). Class change = remount → wmDimOut. *@
					var dimLeaving = _tradePopupNodeId != null
						? ( _popupLeaving && ( _selectedExpId == null || _cardLeaving ) )
						: _cardLeaving;
					<div class="wm-dim @(dimLeaving ? "leaving" : "")" onclick=@CloseTopSurface></div>
				}

				@* LANE: motion — the REVEAL veil: same .55 veil, mounts with the beat (0.3s mount fade),
				   `.release` lifts it 0.5s. The revealing pin (.unlocking, z60) stays lit above it. *@
				@if ( _revealZoneId != null )
				{
					<div class="wm-dim rv @(_revealPhase >= RevealRelease ? "release" : "")"></div>
				}

				@{ int chainRung = 0; } @* LANE: motion (F5) — entrance rung = visible chain order *@
				@foreach ( var z in Zones )
				{
					var zone = z;
					if ( !IsZoneVisible( zone ) ) { continue; }
					var pinRung = chainRung++;
					var zExp = GetExpedition( zone.ExpeditionId );
					// LANE: motion — the reveal costume: the revealing pin renders LOCKED through the zoom
					// (t < 0.6) and OPEN + .unlocking from the pop beat on (dev_reveal rides the same override).
					var rc = RevealCostume( zone.Id );
					var isUnlocked = rc.ForceOpen || ( !rc.ForceLocked && IsZoneUnlocked( zone ) );
					var isCleared = !rc.ForceLocked && !rc.ForceOpen && ( ExpeditionManager.Instance?.HasClearedExpedition( zone.ExpeditionId ) ?? false );
					var hardUnlocked = isCleared && ( ExpeditionManager.Instance?.IsHardModeUnlocked( zone.ExpeditionId ) ?? false );
					var stateClass = !isUnlocked ? "locked" : ( isCleared ? "cleared" : "current" );
					var isHovered = _hoveredZoneId == zone.Id;
					var isKb = KbActiveMarkerId == zone.Id;
					var isSelected = _selectedExpId == zone.ExpeditionId;
					var zoneKey = "zone-" + zone.Id;
					var (glyph, glyphColor) = PinGlyph( isUnlocked, isCleared );
					var pinName = zExp?.Name ?? zone.Name;
					var pinLevel = zExp?.BaseEnemyLevel ?? 1;
					var lockedMeta = "CLEAR " + ( PreviousZoneName( zone ) ?? "THE PREVIOUS ZONE" ).ToUpperInvariant();

					// Pin host 160×106, margin −80/−22 so the 44 diamond's centre sits on the anchor.
					// Column: diamond 44 · 14 · name 16 · 2 · meta 14 (· 2 · meta 14) = 106 max.
					var chipText = "NEW AREA · " + pinName.ToUpperInvariant();
					<div class="zone-pin @stateClass @(isHovered ? "hovered" : "") @(isKb ? "kb-active" : "") @(isSelected ? "selected" : "") @(rc.Unlocking ? "unlocking" : "") @PinEntranceClass(pinRung)"
						 style="left: @(zone.X)%; top: @(zone.Y)%;"
						 onclick=@(() => SelectZone(zone.Id))
						 onmouseover=@(() => OnZoneMarkerHover(zone.Id, zoneKey))
						 onmouseout=@(() => OnZoneMarkerLeave(zone.Id))>
						<div class="pin-diamond">
							@* Counter-rotate HOLDER — a sized div (a transform on the iconify panel itself never landed live). *@
							<div class="pin-glyph">
								<iconify class="pin-glyph-ico" icon="@glyph" Size=@(22) Color="@glyphColor" />
							</div>
							@* The one violet ring — child of the rotated diamond so it inherits the 45°.
							   LANE: input — hover == focus; the kb cursor graph flips .kb-active. *@
							<div class="pin-ring"></div>
						</div>
						<div class="pin-label">
							<span class="pin-name">@pinName</span>
							@if ( isUnlocked )
							{
								<span class="pin-meta lv">LV @pinLevel</span>
							}
							else
							{
								<span class="pin-meta dim">@lockedMeta</span>
							}
							@if ( hardUnlocked )
							{
								<span class="pin-meta hard">HARD UNLOCKED</span>
							}
						</div>
						@* LANE: motion — "NEW AREA · <ZONE>" chipstamp rises under the pin for the pop beat only
						   (mounts at 0.6s, unmounts at the release beat; the 1.6s keyframe fades it out itself). *@
						@if ( rc.Unlocking && _revealPhase == RevealPop )
						{
							<div class="wm-newchip-host">
								<div class="wm-newchip"><span class="wm-newchip-text">@chipText</span></div>
							</div>
						}
					</div>
				}

				@* Mini-expeditions — 32 diamonds in the same family. *@
				@foreach ( var mini in GetMiniExpeditions() )
				{
					var mx = mini;
					var mrc = RevealCostume( mx.Id ); // LANE: motion — same costume override (dev_reveal on a mini id)
					var mUnlocked = mrc.ForceOpen || ( !mrc.ForceLocked && ( ExpeditionManager.Instance?.CanStartExpedition( mx.Id ) ?? false ) );
					var mCleared = !mrc.ForceLocked && !mrc.ForceOpen && ( ExpeditionManager.Instance?.HasClearedExpedition( mx.Id ) ?? false );
					var mState = !mUnlocked ? "locked" : ( mCleared ? "cleared" : "current" );
					var mKey = "mini-" + mx.Id;
					var mHovered = _hoveredMiniId == mx.Id;
					var mKb = KbActiveMarkerId == mx.Id;
					var mSelected = _selectedExpId == mx.Id;
					var mPos = GetMiniPos( mx.Id );
					var (mGlyph, mGlyphColor) = PinGlyph( mUnlocked, mCleared );
					var mLockedMeta = "CLEAR " + ( MiniGateName( mx ) ?? "THE MAIN ZONES" ).ToUpperInvariant();

					// Host 160×88, margin −80/−16: diamond 32 · 12 · name 14 · 2 · meta 14 = 74 (+14 slack).
					<div class="mini-pin @mState @(mHovered ? "hovered" : "") @(mKb ? "kb-active" : "") @(mSelected ? "selected" : "") @(mrc.Unlocking ? "unlocking" : "") @PinEntranceClass(3)"
						 style="left: @(mPos.X)%; top: @(mPos.Y)%;"
						 onclick=@(() => SelectMini(mx.Id))
						 onmouseover=@(() => OnMiniHover(mx.Id, mKey))
						 onmouseout=@(() => OnMiniLeave(mx.Id))>
						<div class="pin-diamond mini">
							<div class="pin-glyph mini">
								<iconify class="pin-glyph-ico" icon="@mGlyph" Size=@(16) Color="@mGlyphColor" />
							</div>
							<div class="pin-ring mini"></div>
						</div>
						<div class="pin-label mini">
							<span class="pin-name mini">@mx.Name</span>
							@if ( mUnlocked )
							{
								<span class="pin-meta lv">LV @mx.BaseEnemyLevel</span>
							}
							else
							{
								<span class="pin-meta dim">@mLockedMeta</span>
							}
						</div>
					</div>
				}

				@* Request pins — "?" on a neutral 32 r8 slab; check when done; pulse when affordable.
				   Visible only once the host zone is cleared (GetVisibleTradeNodes). *@
				@foreach ( var node in GetVisibleTradeNodes() )
				{
					var n = node;
					// LANE: motion — the pins this clear surfaced stay hidden until the release beat, then
					// mount with a RARE ladder class (.wm-newreq-N, dropped when the reveal ends — DOC-4 #14).
					if ( RevealHidesReqPin( n.Id ) ) { continue; }
					var isDone = TradeNodeManager.Instance?.IsLocked( n.Id ) ?? true;
					var canAfford = !isDone && ( TradeNodeManager.Instance?.CanAfford( n.Id ) ?? false );
					var tnKey = "tn-" + n.Id;
					// LANE: motion (F4b) — the just-traded pin flashes green → slab for the CTA's 0.5s window.
					var justDone = IsTradeBeat && _tradeBeatNodeId == n.Id;
					<div class="req-pin @(isDone ? "done" : "") @(canAfford ? "ready" : "") @(_hoveredTradeNodeId == n.Id ? "hovered" : "") @(KbActiveMarkerId == n.Id ? "kb-active" : "") @RevealReqClass(n.Id) @PinEntranceClass(3) @(justDone ? "just-done jd-" + _tradeBeatVersion : "")"
						 style="left: @(n.MapPosX)%; top: @(n.MapPosY)%;"
						 onclick=@(() => OpenTradeNode(n.Id))
						 onmouseover=@(() => OnReqPinHover(n.Id, tnKey))
						 onmouseout=@(() => OnReqPinLeave(n.Id))>
						@* LANE: input — the same ring recipe on the 32 r8 square (no rotation): 52 outer, r18. *@
						<div class="pin-ring req"></div>
						@if ( canAfford )
						{
							@* LANE: motion — the 1.6s ready pulse (the one surviving loop on the map). *@
							<div class="req-pulse"></div>
						}
						@if ( isDone )
						{
							<iconify class="req-glyph" icon="lucide:check" Size=@(16) Color="#3fb45e" />
						}
						else
						{
							<iconify class="req-glyph" icon="lucide:badge-help" Size=@(18) Color="#f4f1ea" />
						}
					</div>
				}
			</div>
		</div>

		@* Vignette — outside the zoom group so the frame edge never scales. *@
		<div class="map-vignette"></div>

		@* ═══ HOUSE HEADER ON THE ART — the hub .oh-header recipe with its slab removed ═══
		   Host paints NO fill (BbHeaderWaves paint-behind law); .bhw-base is made transparent from this
		   sheet because the illustration is the room. LANE: motion — header entrance. *@
		<div class="wm-header">
			<BbHeaderWaves Accent=@("orange") />
			<div class="wm-h-identity">
				<span class="wm-kicker">EXPEDITION</span>
				<div class="wm-title-row">
					<span class="wm-title">WEAVERTON</span>
					<div class="wm-seam"></div>
					<div class="wm-seam dim"></div>
				</div>
			</div>
			<div class="wm-toolbar">
				<div class="wm-chip">
					<span class="wm-chip-label">@GetClearedZoneCount() / @GetTotalZoneCount() CLEARED</span>
				</div>
				@* LANE: input — BACK · Q slot stays EMPTY: the run-1 ledger has no BACK chip on the page root, and
				   an unclaimed Q at the root is GameHUD's silent no-op (2026-09-04) — there is nothing to back out of. *@
			</div>
		</div>
	</div>

	@* LANE: motion — click shield for the reveal window (pins sit above the veil, so the veil alone
	   cannot swallow clicks). Transparent, root-level, above the card/popup; any click = skip. *@
	@if ( _revealZoneId != null )
	{
		<div class="wm-reveal-shield" onclick=@SkipReveal></div>
	}

	@* ═══ DETAIL CARD — one card for zones AND minis (the Expedition record carries both) ═══ *@
	@if ( _selectedExpId != null )
	{
		var exp = GetExpedition( _selectedExpId );
		if ( exp != null )
		{
			var em = ExpeditionManager.Instance;
			var cardUnlocked = em?.CanStartExpedition( exp.Id ) ?? false;
			var cardCleared = em?.HasClearedExpedition( exp.Id ) ?? false;
			var cardHard = cardCleared && ( em?.IsHardModeUnlocked( exp.Id ) ?? false );
			var kicker = cardHard ? "CLEARED · HARD UNLOCKED" : ( cardCleared ? "CLEARED" : ( exp.IsMiniExpedition ? "SIDE EXPEDITION" : "" ) );
			var heroImg = !string.IsNullOrEmpty( exp.BackgroundImage ) ? exp.BackgroundImage : "ui/locations/placeholder_zone.png";
			var wild = GetWildSpecies( exp );
			var (bossSpecies, bossCount) = GetCardBoss( exp );
			var drops = ItemManager.Instance?.GetZoneDropOdds( exp.Id, false ) ?? new List<ItemManager.DropOdds>();
			// Drop tiles 200×44 two-up (200 + 12 + 200 = 412), rows 6 apart → grid = 44r + 6(r−1).
			// Card budget (see the scss header): fixed 728 with a kicker (710 without — the WILD / DROPS heads
			// are 36 bands, FEEL F1) + the drops grid, clamped so the card never passes 928 (y 110 → 1038).
			// 4 rows (8 drops) fit; only the DROPS grid scrolls.
			// ONE formula shared with the kb card stops (DropsLayout — LANE: input).
			var (dropRows, dropsH, dropsScrolls) = DropsLayout( drops.Count, !string.IsNullOrEmpty( kicker ) );

			@* LANE: motion — mount fade in (branch-swap = fresh element); `.leaving` = the 0.12s exit latch
			   (CloseCard stamps it, Tick unmounts). *@
			<div class="zd-card @(_cardLeaving ? "leaving" : "")">
				@* HERO 412×200 r16 — zone art under a dark veil, BACK · Q top-right (in-flow row above the absolutes). *@
				<div class="zd-hero">
					<img class="zd-hero-img" src="@heroImg" />
					<div class="zd-hero-veil"></div>
					<div class="zd-hero-top">
						<div class="zd-back" onclick=@CloseCard onmouseover=@(() => OnHover("zd-back"))>@* :hover + blip gated to mouse-mode (scss + OnHover) *@
							<span class="zd-back-label">BACK</span>
							<span class="zd-back-cap">Q</span>
						</div>
					</div>
				</div>

				@* KICKER = state · TITLE 30/34 · ONE meta line "LV 10 · 7 WAVES · BOSS" (LV gold) *@
				@if ( !string.IsNullOrEmpty( kicker ) )
				{
					<span class="zd-kicker">@kicker</span>
				}
				<span class="zd-title">@exp.Name</span>
				<div class="zd-meta">
					<span class="zd-meta-lv">LV @exp.BaseEnemyLevel</span>
					<span class="zd-meta-dot">·</span>
					<span class="zd-meta-txt">@exp.Waves WAVES</span>
					@if ( exp.HasBoss )
					{
						<span class="zd-meta-dot">·</span>
						<span class="zd-meta-txt">BOSS</span>
					}
				</div>

				@* LORE 15/22 pinned at 3 lines (66) — the card stays deterministic. *@
				<div class="zd-lore"><span class="zd-lore-text">@exp.Description</span></div>

				@* WILD BEASTS — only species the wild waves can roll (boss-pool species excluded) + the boss tile.
				   Head = the guild .gp-band grammar: orange chipstamp on a 36 band (FEEL F1). *@
				<div class="wm-band zd-band wild">
					<div class="wm-chipstamp"><span>WILD BEASTS</span></div>
				</div>
				<div class="zd-beast-row">
					@foreach ( var sp in wild )
					{
						var species = sp;
						var unseen = !( BeastiaryManager.Instance?.IsSeen( species.Id ) ?? false );
						<div class="zd-beast @(unseen ? "unseen" : "")">
							<div class="zd-beast-tile">
								@if ( unseen )
								{
									<span class="zd-beast-q">?</span>
								}
								else
								{
									<img class="zd-beast-img" src="@species.IconPath" style="@BbEmblem.CropStyleFor(species, 60, 60)" />
								}
							</div>
							<span class="zd-beast-name">@(unseen ? "???" : species.Name)</span>
						</div>
					}
					@if ( bossSpecies != null )
					{
						var bossUnseen = !( BeastiaryManager.Instance?.IsSeen( bossSpecies.Id ) ?? false );
						var bossCaption = !bossSpecies.IsCatchable ? "BOSS · CANNOT CONTRACT" : ( bossCount > 1 ? $"BOSS · 1 OF {bossCount}" : "BOSS" );
						<div class="zd-beast @(bossUnseen ? "unseen" : "")">
							<div class="zd-beast-tile boss">
								@if ( bossUnseen )
								{
									<span class="zd-beast-q">?</span>
								}
								else
								{
									<img class="zd-beast-img" src="@bossSpecies.IconPath" style="@BbEmblem.CropStyleFor(bossSpecies, 60, 60)" />
								}
							</div>
							<span class="zd-beast-name">@(bossUnseen ? "???" : bossSpecies.Name)</span>
							<span class="zd-beast-cap">@bossCaption</span>
						</div>
					}
				</div>

				@* EMBARK — the one gold primary, 412×56 r16. Row host so Stretch fills the WIDTH (flex-basis is main-axis).
				   Locked keeps the slab and dims (BIG THINGS BIG). LANE: input — Focused when the card cursor sits here. *@
				<div class="zd-cta-row" onmouseover=@OnEmbarkHover>
					<BbButton Tier="primary" Size=@(56) Label="EMBARK" KeyCap=@(cardUnlocked ? "SPACE" : "") Stretch=@true Disabled=@(!cardUnlocked) Focused=@(IsKbMode && _cardCursor == 0) OnClick=@EmbarkSelected />
				</div>

				@* DROPS — one slab: materials first (beast glyph · EVERY KO), then items with per-run odds.
				   Head = chipstamp DROPS + darkchip ODDS PER RUN (· HARD ×1.5 folded in once unlocked). *@
				<div class="wm-band zd-band drops">
					<div class="wm-chipstamp"><span>DROPS</span></div>
					<div class="wm-band-spacer"></div>
					<div class="wm-darkchip"><span>@(cardHard ? "ODDS PER RUN · HARD ×1.5" : "ODDS PER RUN")</span></div>
				</div>
				@if ( drops.Count > 0 )
				{
					<div class="zd-drops @(dropsScrolls ? "scrolls" : "")" style="height: @(dropsH)px;" @ref="_dropsScroll">
						@foreach ( var (d, di) in drops.Select( ( x, i ) => (x, i) ) )
						{
							var drop = d;
							var dropRow = di / 2;
							var matSpecies = drop.EveryKo ? SpeciesForMaterial( drop.Item ) : null;
							// LANE: input — the ROW is the stop (slab cursor, kb mode only via the scss gate), only while the grid scrolls.
							var dropKb = dropsScrolls && _cardCursor == 1 + dropRow;
							<div class="zd-drop @(drop.EveryKo ? "material" : "") @(dropKb ? "kb-focused" : "")"
								 onmouseover=@(() => OnDropRowHover(dropRow, dropsScrolls))>
								<div class="zd-drop-glyph">
									@if ( matSpecies != null )
									{
										<img class="zd-drop-beast" src="@matSpecies.IconPath" style="@BbEmblem.CropStyleFor(matSpecies, 28, 28)" />
									}
									else
									{
										<img class="zd-drop-icon" src="@drop.Item.IconPath" />
									}
								</div>
								<div class="zd-drop-text">
									<span class="zd-drop-name">@drop.Item.Name</span>
									@if ( drop.EveryKo )
									{
										<span class="zd-drop-odds every">EVERY KO</span>
									}
									else if ( drop.PerRunPct <= 0 )
									{
										<span class="zd-drop-odds low">@("<5%")</span>
									}
									else
									{
										<span class="zd-drop-odds">@(drop.PerRunPct)%</span>
									}
								</div>
								@* LANE: color — rarity is DATA: the strip's colour is the token, inline (DOC-2 #8/#16). *@
								<div class="zd-drop-rs" style="background-color: @BbTokens.Rarity(drop.Item.Rarity.ToString());"></div>
							</div>
						}
					</div>
				}
				else
				{
					<div class="zd-drops-empty"><span class="zd-drops-empty-text">Nothing rolls here yet.</span></div>
				}
			</div>
		}
	}

	@* ═══ REQUEST POPUP — LAYOUT + COLOR (2026-09-04, expedition rebuild). 560 r22 FLEX-CENTRED in a
	   root-level full-cover host (z65: above the card z60 and the .wm-dim z40, under the reveal shield
	   z200) — never `transform: translate` (DOC-7 #15). The host is pointer-inert so the .wm-dim shield
	   behind it still takes the close click (CloseTopSurface); the popup opts back in.
	   Content-sized column, pad 24 → 512 lane (PADDING-BOX: the declared 560 INCLUDES the pad):
	     24 · head 52 (kicker 14 + 4 + title 34 | BACK · Q 30) · 4 · giver 14 · 16 · desc ≤66 (15/22, ≤3 lines:
	     every TradeNode.Description is ≤174 chars ≈ 3 lines at 512) · 20 · REQUIRES slab 54 + 44n + 4(n−1)
	     · 16 · REWARDS slab (same) · 24 · CTA 512×56 · 24.  Gnollcap (2 req · 1 reward) = 604 → y 238
	     (slab = 16 + band 36 + 8 + rows + 16 — the slab heads are .wm-band chipstamps, FEEL F1).
	   Keys live in HandleMapKeyboardInput: Space = ACCEPT TRADE · Q = close (claims PanelHandledBackKey).
	   LANE: motion (F3/F4b) — rqRise on mount, `.leaving` = the 0.12s exit latch (_popupLeaving; input
	   swallowed, Tick unmounts), ACCEPT TRADE → the Shop BUY `.beat` costume + TRADED for 0.5s.
	   No giver portrait: TradeNode carries no portrait field (the 96 r12 tile recipe waits on data). *@
	@if ( _tradePopupNodeId != null )
	{
		var tnode = TradeNodeManager.Instance?.GetNode( _tradePopupNodeId );
		if ( tnode != null )
		{
			var canAfford = TradeNodeManager.Instance?.CanAfford( tnode.Id ) ?? false;
			var isDone = TradeNodeManager.Instance?.IsLocked( tnode.Id ) ?? true;
			var giverZone = GetExpedition( tnode.ZoneId )?.Name;
			var inv = TamerManager.Instance?.CurrentTamer?.Inventory;
			var tamerGold = TamerManager.Instance?.CurrentTamer?.Gold ?? 0;
			var hasRewards = tnode.ItemRewards.Count > 0 || tnode.GoldReward > 0 || tnode.XPReward > 0 || tnode.SkillPointReward > 0;

			<div class="rq-host">
				<div class="rq-popup @(_popupLeaving ? "leaving" : "")">
					@* HEAD 512×52 — identity column 400 (kicker → title) | BACK · Q (the .zd-back / .gp-back recipe). *@
					<div class="rq-head">
						<div class="rq-head-id">
							<span class="rq-kicker">REQUEST</span>
							<span class="rq-title">@tnode.Name</span>
						</div>
						<div class="rq-back" onclick=@CloseTradePopup onmouseover=@(() => OnHover("rq-back"))>
							<span class="rq-back-label">BACK</span>
							<span class="rq-back-cap">Q</span>
						</div>
					</div>

					@* GIVER — "from Elder Mira · Weaverwood" as sibling spans (a multi-@ text node squashes). *@
					<div class="rq-giver">
						<span class="rq-giver-txt">@("from " + tnode.NpcName)</span>
						@if ( !string.IsNullOrEmpty( giverZone ) )
						{
							<span class="rq-giver-dot">·</span>
							<span class="rq-giver-txt">@giverZone</span>
						}
					</div>

					<div class="rq-desc"><span class="rq-desc-text">@tnode.Description</span></div>

					@* REQUIRES — one raised slab, rows 44: glyph 28 · name · have / need. LANE: color — the ONE
					   honest red/green on the page: red only while SHORT, green only once MET (DOC-2 #4). *@
					<div class="rq-slab">
						<div class="wm-band rq-band">
							<div class="wm-chipstamp"><span>REQUIRES</span></div>
						</div>
						@foreach ( var (itemId, qty) in tnode.Requirements )
						{
							var item = ItemManager.Instance?.GetItem( itemId );
							int have = 0;
							if ( inv != null && inv.TryGetValue( itemId, out var h ) ) have = h;
							<div class="rq-row @(have >= qty ? "met" : "short")">
								<img class="rq-glyph" src="@(item?.IconPath)" />
								<span class="rq-name">@(item?.Name ?? itemId)</span>
								<span class="rq-amt">@(have + " / " + qty)</span>
							</div>
						}
						@if ( tnode.GoldCost > 0 )
						{
							<div class="rq-row @(tamerGold >= tnode.GoldCost ? "met" : "short")">
								<img class="rq-glyph" src="ui/icons/currency/money.png" />
								<span class="rq-name">Gold</span>
								<span class="rq-amt">@(tamerGold.ToString( "N0" ) + " / " + tnode.GoldCost.ToString( "N0" ))</span>
							</div>
						}
					</div>

					@* REWARDS — the same row. Amounts CREAM (FEEL ruling 2026-09-04: one gold surface per view — the
					   primary below; the card already ruled no gold numbers). Item rewards carry the rarity
					   strip at the row foot, colour inline from BbTokens.Rarity (DOC-2 #8/#16). *@
					@if ( hasRewards )
					{
						<div class="rq-slab">
							<div class="wm-band rq-band">
								<div class="wm-chipstamp"><span>REWARDS</span></div>
							</div>
							@foreach ( var (itemId, qty) in tnode.ItemRewards )
							{
								var item = ItemManager.Instance?.GetItem( itemId );
								<div class="rq-row reward">
									<img class="rq-glyph" src="@(item?.IconPath)" />
									<span class="rq-name">@(item?.Name ?? itemId)</span>
									<span class="rq-amt">@("×" + qty)</span>
									@if ( item != null )
									{
										<div class="rq-rs" style="background-color: @BbTokens.Rarity(item.Rarity.ToString());"></div>
									}
								</div>
							}
							@if ( tnode.GoldReward > 0 )
							{
								<div class="rq-row reward">
									<img class="rq-glyph" src="ui/icons/currency/money.png" />
									<span class="rq-name">Gold</span>
									<span class="rq-amt">@("+" + tnode.GoldReward.ToString( "N0" ))</span>
								</div>
							}
							@if ( tnode.SkillPointReward > 0 )
							{
								<div class="rq-row reward">
									<div class="rq-glyph-slot"><iconify class="rq-glyph-ic" icon="lucide:sparkles" Size=@(22) Color="rgba(244, 241, 234, 0.85)" /></div>
									<span class="rq-name">@(tnode.SkillPointReward == 1 ? "Skill Point" : "Skill Points")</span>
									<span class="rq-amt">@("+" + tnode.SkillPointReward)</span>
								</div>
							}
							@if ( tnode.XPReward > 0 )
							{
								<div class="rq-row reward">
									<div class="rq-glyph-slot"><iconify class="rq-glyph-ic" icon="lucide:arrow-up" Size=@(22) Color="rgba(244, 241, 234, 0.85)" /></div>
									<span class="rq-name">Tamer XP</span>
									<span class="rq-amt">@("+" + tnode.XPReward.ToString( "N0" ))</span>
								</div>
							}
						</div>
					}

					@* FOOT — ONE primary in three states (BIG THINGS BIG, DOC-1 #9): gold ACCEPT TRADE · the same
					   slab Disabled + "NOT ENOUGH" while short · ghost "COMPLETED" once turned in. BbButton is the
					   button (DOC-6 #1). LANE: input — Focused mirrors the card's EMBARK: kb mode = the ring on the
					   one action (Space already fires it in HandleMapKeyboardInput). *@
					@* LANE: motion (F4b) — ONE BbButton, its costume computed as a tuple (the ghost-children law:
					   never swap whole icon+label blocks in an @if cascade). Tier / class changes remount it, so the
					   `.beat beat-N` costume fires as a mount keyframe for the 0.5s TRADED window. *@
					<div class="rq-cta-row">
						@{ var cta = TradeCtaContent( isDone, canAfford ); }
						<BbButton Tier=@cta.Tier Size=@(56) Label=@cta.Label Icon=@cta.Icon KeyCap=@cta.KeyCap Stretch=@true
								  Disabled=@cta.Disabled Focused=@(IsKbMode && !cta.Disabled && !IsTradeBeat) OnClick=@ExecuteSelectedTrade Class=@cta.Class />
					</div>
				</div>
			</div>
		}
	}

	<!-- ═══ TEAM PICKER POPUP (overlays the whole map when EMBARK is pressed) ═══ -->
	<TeamPickerPopup />
</root>

@code {
	public static WorldMapPanel Instance { get; private set; }

	// ───────────────────── STATE ─────────────────────
	// One selection for zones AND minis: the Expedition id (the card reads the
	// Expedition record for both — MapZone.Lore duplicated Expedition.Description
	// and is gone).
	private string _selectedExpId;
	private string _tradePopupNodeId;
	private string _hoveredTradeNodeId;
	private string _hoveredZoneId;
	private string _hoveredLandmarkId;
	private string _hoveredMiniId;

	// ═══════════════════════════════════════════════════════════════
	// UNLOCK REVEAL — LANE: motion (2026-09-04). ExpeditionManager.UpdateExpeditionStats
	// latches PendingRevealZoneId when HighestExpeditionCleared rises; Tick consumes it
	// once the map has settled (mount + 0.35s, nothing open), then runs a RealTime beat
	// ladder (never animation-delay — re-render law, DOC-4 #6 / DOC-7 #17):
	//   0.0s  ZOOM     .map-zoom.reveal (scale 1.35 toward the pin, 0.6s ease-out) · veil .55
	//                  mounts · pin forced LOCKED · click shield up · StoryDirector.HoldPending()
	//   0.6s  POP      pin → open costume + .unlocking (fill pop w/ the ONE HDR tick, glyph in,
	//                  LV meta slide) · "NEW AREA · <ZONE>" chip rises (1.6s) · payoff sound
	//   2.4s  RELEASE  .reveal.release (zoom back 0.5s) · veil lifts · chip unmounts · the
	//                  cleared zone's request pins pop in (3-rung ladder) · PlayPending() · latch cleared
	//   2.9s  END      classes drop, shield down, ring lands on the new pin
	// Any key/click during the window skips straight to END (ReleaseReveal + EndReveal).
	// ═══════════════════════════════════════════════════════════════
	public static string PendingRevealZoneId;
	private string _revealZoneId;
	private int _revealPhase;           // 0 idle · RevealZoom · RevealPop · RevealRelease
	private float _revealAt;
	private float _mountedAt;
	private readonly List<string> _revealNewReqIds = new();

	private const int RevealZoom = 1;
	private const int RevealPop = 2;
	private const int RevealRelease = 3;
	private const float RevealPopAt = 0.6f;
	private const float RevealReleaseAt = 2.4f;
	private const float RevealEndAt = 2.9f;
	private const float RevealSettle = 0.9f;  // the page entrance (header 0.22s + pin ladder to 0.8s) lands first

	private bool RevealLive => _revealZoneId != null;

	private string RevealGroupClass() =>
		_revealZoneId == null ? "" : ( _revealPhase >= RevealRelease ? "reveal release" : "reveal" );

	/// <summary>Costume override for the revealing marker: LOCKED through the zoom, OPEN + .unlocking from the pop.</summary>
	private (bool ForceLocked, bool ForceOpen, bool Unlocking) RevealCostume( string markerId )
	{
		if ( _revealZoneId == null || markerId != _revealZoneId ) return (false, false, false);
		if ( _revealPhase <= RevealZoom ) return (true, false, false);
		return (false, true, true);
	}

	/// <summary>Request pins surfaced by this clear stay hidden until the release beat.</summary>
	private bool RevealHidesReqPin( string nodeId ) =>
		_revealZoneId != null && _revealPhase < RevealRelease && _revealNewReqIds.Contains( nodeId );

	/// <summary>Ladder rung class for a surfaced request pin (only while the reveal is live).</summary>
	private string RevealReqClass( string nodeId )
	{
		if ( _revealZoneId == null ) return "";
		int i = _revealNewReqIds.IndexOf( nodeId );
		return i < 0 ? "" : "wm-newreq-" + Math.Min( i, 2 );
	}

	private bool CanStartReveal()
	{
		if ( _selectedExpId != null || _tradePopupNodeId != null ) return false;
		if ( UIModalState.AnyModalOpen ) return false;
		if ( BattleTransition.IsActive ) return false;
		if ( _mountedAt <= 0f ) return false; // Tick before the first OnAfterTreeRender — wait for the stamp
		return RealTime.Now - _mountedAt >= RevealSettle;
	}

	private void StartReveal( string id )
	{
		var zone = Zones.FirstOrDefault( z => z.Id == id || z.ExpeditionId == id );
		string markerId = zone != null && IsZoneVisible( zone ) ? zone.Id : ( MiniPositions.ContainsKey( id ) ? id : null );
		if ( markerId == null )
		{
			Log.Warning( $"[WorldMap] Unlock reveal: no visible marker for '{id}' — latch dropped." );
			PendingRevealZoneId = null;
			return;
		}

		// The pins this clear surfaced = the request nodes of the zone BEFORE the new one in
		// the chain (GetVisibleTradeNodes shows a zone's pins once IT is cleared).
		_revealNewReqIds.Clear();
		var em = ExpeditionManager.Instance;
		var chain = em?.Expeditions.Where( e => !e.TutorialOnly && !e.IsMiniExpedition ).ToList();
		string expId = zone?.ExpeditionId ?? id;
		int idx = chain?.FindIndex( e => e.Id == expId ) ?? -1;
		if ( idx > 0 && TradeNodeManager.Instance != null )
		{
			string prevId = chain[idx - 1].Id;
			foreach ( var node in TradeNodeManager.Instance.AllNodes )
				if ( node.ZoneId == prevId ) _revealNewReqIds.Add( node.Id );
		}

		_revealZoneId = markerId;
		_revealAt = RealTime.Now;
		_revealPhase = RevealZoom;
		_kbMarkerId = markerId;   // the ring lands on the new area when the beat ends
		_hoveredZoneId = null;
		_hoveredMiniId = null;
		_hoveredTradeNodeId = null;
		_hoveredLandmarkId = null;
		_hoveredKey = null;
		StoryDirector.HoldPending();
		StateHasChanged();
	}

	/// <summary>The release beat: story queue released, latch cleared (idempotent).</summary>
	private void ReleaseReveal()
	{
		if ( _revealPhase >= RevealRelease ) return;
		_revealPhase = RevealRelease;
		StoryDirector.PlayPending();
		PendingRevealZoneId = null;
	}

	private void EndReveal()
	{
		_revealZoneId = null;
		_revealPhase = 0;
		_revealNewReqIds.Clear();
		StateHasChanged();
	}

	/// <summary>Any key / click during the window: straight to the end state.</summary>
	private void SkipReveal()
	{
		if ( !RevealLive ) return;
		ReleaseReveal();
		EndReveal();
	}

	private void TickReveal()
	{
		if ( _revealZoneId == null )
		{
			if ( PendingRevealZoneId != null && CanStartReveal() ) StartReveal( PendingRevealZoneId );
			return;
		}

		float t = RealTime.Now - _revealAt;
		if ( t >= RevealEndAt ) { ReleaseReveal(); EndReveal(); return; }

		int want = t < RevealPopAt ? RevealZoom : ( t < RevealReleaseAt ? RevealPop : RevealRelease );
		if ( want == _revealPhase ) return;

		if ( want == RevealPop )
		{
			_revealPhase = RevealPop;
			SoundManager.PlaySuccess(); // payoff on the REVEAL, silence through the zoom (DOC-4 #17)
		}
		else if ( want == RevealRelease )
		{
			ReleaseReveal();
		}
		StateHasChanged();
	}

	/// <summary>Leaving the page mid-beat: never leave the story queue held.</summary>
	public override void OnDeleted()
	{
		if ( RevealLive ) { ReleaseReveal(); EndReveal(); }
		base.OnDeleted();
	}

	// dev_reveal [zoneId] — replay the unlock reveal on demand (default: saltmoor_forest).
	// Sets the latch; the mounted map consumes it next tick (dev_page expedition first if
	// the map is not up). The costume override forces the pin LOCKED through the zoom and
	// OPEN from the pop beat regardless of save state, so a locked zone previews honestly
	// and snaps back to its real state when the beat ends.
	[ConCmd( "dev_reveal" )]
	public static void DevReveal( string zoneId = "saltmoor_forest" )
	{
		PendingRevealZoneId = zoneId;
		var p = Instance;
		if ( p == null || p.Parent == null )
		{
			Log.Info( $"[dev_reveal] latched '{zoneId}' — open the map (dev_page expedition) to play it." );
			return;
		}
		if ( p.RevealLive ) p.SkipReveal();
		p.StateHasChanged();
		Log.Info( $"[dev_reveal] replaying the unlock reveal for '{zoneId}'." );
	}

	// dev_request <nodeId|list> — LAYOUT/COLOR live-test hook: opens the request popup for ANY
	// trade node regardless of the host zone's cleared state (the map must be up: dev_page
	// expedition). `list` prints the ids one per line (Log.Info truncates at a newline).
	[ConCmd( "dev_request" )]
	public static void DevRequest( string nodeId = "list" )
	{
		var mgr = TradeNodeManager.Instance;
		if ( mgr == null ) { Log.Info( "[dev_request] no TradeNodeManager in the scene." ); return; }
		if ( nodeId == "list" || mgr.GetNode( nodeId ) == null )
		{
			Log.Info( $"[dev_request] {mgr.AllNodes.Count} nodes — dev_request <id>:" );
			foreach ( var n in mgr.AllNodes ) Log.Info( $"  {n.Id}  ({n.Name} · {n.ZoneId})" );
			return;
		}
		var p = Instance;
		if ( p == null || p.Parent == null ) { Log.Info( "[dev_request] open the map first (dev_page expedition)." ); return; }
		if ( p.RevealLive ) p.SkipReveal();
		p._selectedExpId = null;
		p._cardLeaving = false;
		p._popupLeaving = false;
		p.OpenTradeNode( nodeId );
		p.StateHasChanged();
		Log.Info( $"[dev_request] opened '{nodeId}'." );
	}

	// ── CARD EXIT LATCH — LANE: motion. CloseCard keeps the card mounted with `.leaving` for
	// 0.12s (wmCardOut), Tick unmounts. Keys/clicks on a leaving card are swallowed.
	private bool _cardLeaving;
	private float _cardLeaveAt;

	// ── POPUP EXIT LATCH — LANE: motion (FEEL F3). CloseTradePopup keeps the popup mounted with
	// `.leaving` for 0.12s (rqSink), Tick unmounts. Keys/clicks on a leaving popup are swallowed
	// (pointer-events: none on the popup still descends into its children — DOC-7 #21 — so
	// every handler checks the latch).
	private bool _popupLeaving;
	private float _popupLeaveAt;

	// ── TRADE BEAT — LANE: motion (FEEL F4b). ExecuteTrade success opens a 0.5s window: the CTA
	// wears the Shop BUY `.beat beat-N` costume and reads TRADED, the request pin flashes
	// `.just-done`. The version key remounts both per trade; BuildHash carries the window.
	private int _tradeBeatVersion;
	private float _tradeBeatUntil;
	private string _tradeBeatNodeId;
	private bool IsTradeBeat => RealTime.Now < _tradeBeatUntil;

	/// <summary>The popup's ONE button as a costume tuple (tier · label · icon · keycap · disabled · class).</summary>
	private (string Tier, string Label, string Icon, string KeyCap, bool Disabled, string Class) TradeCtaContent( bool isDone, bool canAfford )
	{
		if ( IsTradeBeat ) return ("primary", "TRADED", "lucide:check", "", false, "rq-cta beat beat-" + _tradeBeatVersion);
		if ( isDone ) return ("ghost", "COMPLETED", "lucide:check", "", true, "rq-cta");
		return ("primary", canAfford ? "ACCEPT TRADE" : "NOT ENOUGH", "", canAfford ? "SPACE" : "", !canAfford, "rq-cta");
	}

	// ── PAGE ENTRANCE — LANE: motion (FEEL F5). Pins ladder in by chain order for the first 0.8s
	// after mount wearing a RARE rung class (.wm-pinin-N), dropped when the window closes so a
	// hover remount later replays nothing (DOC-4 #14 — the pin class string is volatile). The
	// first render lands BEFORE OnAfterTreeRender stamps _mountedAt, so an unstamped mount is
	// live. BuildHash carries PinEntranceLive → the drop re-renders onto the identical end state.
	private const float PinEntranceEnd = 0.8f;
	private bool PinEntranceLive => !RevealLive && ( _mountedAt <= 0f || RealTime.Now - _mountedAt < PinEntranceEnd );
	private string PinEntranceClass( int rung ) => PinEntranceLive ? "wm-pinin-" + Math.Clamp( rung, 0, 3 ) : "";

	private string RevealOriginStyle()
	{
		var ci = System.Globalization.CultureInfo.InvariantCulture;
		float ox = 50f, oy = 50f;
		if ( _revealZoneId != null )
		{
			var z = Zones.FirstOrDefault( zz => zz.Id == _revealZoneId || zz.ExpeditionId == _revealZoneId );
			if ( z != null ) { ox = z.X; oy = z.Y; }
			else if ( MiniPositions.TryGetValue( _revealZoneId, out var mp ) ) { ox = mp.X; oy = mp.Y; }
		}
		return $"transform-origin: {ox.ToString( "F1", ci )}% {oy.ToString( "F1", ci )}%;";
	}

	// Hover-sound guard — onmouseover bubbles from children, gate on a key change.
	// LANE: input — every hover handler is a no-op in keyboard mode (DOC-5 #15: kb
	// re-renders fire synthetic onmouseover under a parked pointer).
	private string _hoveredKey;
	private void OnHover( string key )
	{
		if ( IsKbMode ) return;
		if ( _hoveredKey == key ) return;
		_hoveredKey = key;
		SoundManager.PlayHover();
	}

	// Pin hover == the cursor (one cursor, last input wins): the hovered pin becomes
	// the kb marker so WASD continues from where the mouse left off.
	private void OnZoneMarkerHover( string zoneId, string hoverKey )
	{
		if ( IsKbMode ) return;
		OnHover( hoverKey );
		_hoveredZoneId = zoneId;
		_kbMarkerId = zoneId;
	}

	private void OnZoneMarkerLeave( string zoneId )
	{
		if ( _hoveredZoneId == zoneId ) _hoveredZoneId = null;
	}

	private void OnLandmarkHover( string landmarkId, string hoverKey )
	{
		if ( IsKbMode ) return; // landmark titles are mouse-only (no kb stops)
		OnHover( hoverKey );
		_hoveredLandmarkId = landmarkId;
	}

	private void OnLandmarkLeave( string landmarkId )
	{
		if ( _hoveredLandmarkId == landmarkId ) _hoveredLandmarkId = null;
	}

	private void OnMiniHover( string miniId, string hoverKey )
	{
		if ( IsKbMode ) return;
		OnHover( hoverKey );
		_hoveredMiniId = miniId;
		_kbMarkerId = miniId;
	}

	private void OnMiniLeave( string miniId )
	{
		if ( _hoveredMiniId == miniId ) _hoveredMiniId = null;
	}

	private void OnReqPinHover( string nodeId, string hoverKey )
	{
		if ( IsKbMode ) return;
		OnHover( hoverKey );
		_hoveredTradeNodeId = nodeId;
		_kbMarkerId = nodeId;
	}

	private void OnReqPinLeave( string nodeId )
	{
		if ( _hoveredTradeNodeId == nodeId ) _hoveredTradeNodeId = null;
	}

	// Card stops follow the mouse too: EMBARK row → stop 0, a drop row → 1 + row.
	private void OnEmbarkHover()
	{
		if ( IsKbMode ) return;
		_cardCursor = 0;
	}

	private void OnDropRowHover( int row, bool scrolls )
	{
		if ( IsKbMode || !scrolls ) return;
		_cardCursor = 1 + row;
		_dropsGlideTarget = -1f; // the mouse (wheel) owns the slab now
	}

	private Landmark GetLandmark( string id ) => Landmarks.FirstOrDefault( l => l.Id == id );

	// ═══════════════════════════════════════════════════════════════
	// Village landmarks — lore-only PNG overlays on the map
	// ═══════════════════════════════════════════════════════════════
	// X/Y/Width are percent values relative to .map-art-frame (top-left anchor).
	// Positions were baked from the (now retired) drag editor's last save.
	private record Landmark( string Id, string Name, string ImagePath, float X, float Y, float Width, bool IsDecoration = false );

	private static readonly Landmark[] Landmarks = new[]
	{
		new Landmark( "embrik_statue",   "Embrik's Watch",   "ui/worldmap/serpinglin/embrik_statue.png", 46.2f, 49.6f, 3f ),
