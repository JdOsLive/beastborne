@namespace Beastborne.UI.Panels
@using Sandbox;
@using Sandbox.UI;
@using Beastborne.Core;
@using Beastborne.Data;
@using Beastborne.Systems;
@using Beastborne.UI;
@using Beastborne.UI.Components;
@using System;
@using System.Collections.Generic;
@using System.Linq;
@inherits Panel

<root class="world-map-root">
	<div class="map-modal">
		<!-- ═══ ILLUSTRATED MAP BACKDROP — Serpinglin (temporary art) ═══
			 Layered:
				1. base — the empty land/water/forest illustration
				2. landmarks — village PNGs (houses, statue, mine, bridge, fences)
				   each with hover-lore tooltip; not zone markers
				3. clouds — subtle perimeter cloud overlay -->
		<div class="map-backdrop">
			<div class="map-bg-vignette"></div>
			<div class="map-art-frame">
				@* Map base + clouds rendered as background-image (stretch to fill)
				   so the landmark % positions stay locked to the artwork
				   regardless of viewport aspect ratio. <img object-fit: contain>
				   would letterbox in widescreen and detach the landmarks. *@
				<div class="map-base"></div>

				@* Hoverable lore landmarks. Decorative, not playable.
				   Each landmark is positioned in % over the .map-art-frame so
				   it lines up with the same illustration from the artist. *@
				<div class="map-landmarks">
					@foreach ( var lm in Landmarks )
					{
						var landmark = lm;
						var lmKey = "lm-" + landmark.Id;
						var isHovered = _hoveredLandmarkId == landmark.Id;
						var lmPos = GetLandmarkPos( landmark );
						if ( landmark.IsDecoration )
						{
							// Decoration — no hover/tooltip. Drag still works in edit mode.
							<div class="landmark decoration @(_editMode ? "editable" : "")"
								 style="left: @(lmPos.X)%; top: @(lmPos.Y)%; width: @(lmPos.Width)%;"
								 onmousedown=@(() => StartDragLandmark(landmark.Id))>
								<img class="landmark-art" src="@landmark.ImagePath" />
							</div>
						}
						else
						{
							<div class="landmark @(isHovered ? "hovered" : "") @(_editMode ? "editable" : "")"
								 style="left: @(lmPos.X)%; top: @(lmPos.Y)%; width: @(lmPos.Width)%;"
								 onmouseover=@(() => OnLandmarkHover(landmark.Id, lmKey))
								 onmouseout=@(() => OnLandmarkLeave(landmark.Id))
								 onmousedown=@(() => StartDragLandmark(landmark.Id))>
								<img class="landmark-art" src="@landmark.ImagePath" />
							</div>
						}
					}
				</div>

				<!-- Subtle cloud overlay around the map perimeter — soft drift -->
				<div class="map-clouds"></div>
			</div>

			@* Top-left intentionally left empty — reserved for the zoom UI
			   that the next pass will mount here. *@

@* Bottom-right hint — let players know landmarks are interactive *@
			<div class="map-hint-stamp">
				<iconify icon="lucide:mouse-pointer-2" Size=@(13) Color="#fbbf24" />
				<span>Hover the village landmarks for lore</span>
			</div>

			@* Landmark hover tooltip — floats above the hovered landmark *@
			@if ( _hoveredLandmarkId != null )
			{
				var hl = GetLandmark( _hoveredLandmarkId );
				if ( hl != null && !hl.IsDecoration )
				{
					var hlPos = GetLandmarkPos( hl );
					<div class="landmark-tooltip @(hl.TagLabel == "Home" ? "tag-home" : "")"
						 style="left: @(hlPos.X + hlPos.Width / 2)%; top: @(hlPos.Y)%;">
						<div class="landmark-tooltip-tag"><span>@hl.TagLabel</span></div>
						<div class="landmark-tooltip-title">@hl.Name</div>
						<div class="landmark-tooltip-body">@hl.Lore</div>
					</div>
				}
			}
		</div>

		<!-- ═══ ZONE MARKERS (absolute positioned on backdrop) ═══ -->
		<div class="map-markers">
			@foreach ( var z in Zones )
			{
				var zone = z;
				if ( !IsZoneVisible( zone ) ) { continue; }
				var isUnlocked = IsZoneUnlocked( zone );
				var isCleared = ExpeditionManager.Instance?.HasClearedExpedition( zone.ExpeditionId ) ?? false;
				var unlockedClass = isUnlocked ? "unlocked" : "locked";
				var clearedClass = isCleared ? "cleared" : "";
				var zoneKey = "zone-" + zone.Id;
				var isHovered = _hoveredZoneId == zone.Id;
				var zonePos = GetZonePos( zone );
				<div class="zone-marker @unlockedClass @clearedClass @(isHovered ? "hovered" : "") @(_editMode ? "editable" : "") @(KbActiveMarkerId == zone.Id ? "kb-active" : "")"
					 style="left: @(zonePos.X)%; top: @(zonePos.Y)%;"
					 onclick=@(() => SelectZone(zone.Id))
					 onmouseover=@(() => OnZoneMarkerHover(zone.Id, zoneKey))
					 onmouseout=@(() => OnZoneMarkerLeave(zone.Id))
					 onmousedown=@(() => StartDragZone(zone.Id))>

					<div class="marker-pin">
						@if ( !isUnlocked )
						{
							<iconify icon="lucide:lock" Size=@(22) Color="#94a3b8" />
						}
						else if ( isCleared )
						{
							<iconify icon="lucide:check" Size=@(24) Color="#86efac" />
						}
						else
						{
							<iconify icon="lucide:swords" Size=@(26) Color="#fef3c7" />
						}
					</div>
					<div class="marker-pulse"></div>

					<div class="zone-label">
						<span class="zone-name">@zone.Name</span>
						<span class="zone-meta">Lv @zone.Level</span>
					</div>
				</div>
			}

			<!-- ═══ ZONE HOVER PREVIEW (Age of Calamity style) ═══ -->
			@if ( _hoveredZoneId != null )
			{
				var hz = GetZone( _hoveredZoneId );
				if ( hz != null )
				{
					var hexp = GetExpedition( hz.ExpeditionId );
					var hUnlocked = IsZoneUnlocked( hz );
					var hCleared = ExpeditionManager.Instance?.HasClearedExpedition( hz.ExpeditionId ) ?? false;
					// Preview always sits to the right of the marker — the
					// player's reading flow left→right means the card reads as
					// supplementary detail rather than a sidetrack. Right-edge
					// overflow is accepted in exchange for consistency.
					var cardImg = !string.IsNullOrEmpty( hexp?.BackgroundImage ) ? hexp.BackgroundImage : "ui/locations/placeholder_zone.png";
					var hzPos = GetZonePos( hz );
					<div class="zone-preview flip-right"
						 style="left: @(hzPos.X)%; top: @(hzPos.Y)%;">
						<div class="zp-header">
							<span class="zp-title">@hz.Name</span>
							@if ( hCleared )
							{
								<span class="zp-badge cleared">CLEARED</span>
							}
							else if ( !hUnlocked )
							{
								<span class="zp-badge locked">LOCKED</span>
							}
						</div>
						<div class="zp-image-wrap">
							<img class="zp-image" src="@cardImg" />
							@if ( !hUnlocked )
							{
								<div class="zp-image-veil">
									<iconify icon="lucide:lock" Size=@(34) Color="#f1f5f9" />
								</div>
							}
						</div>
						<div class="zp-rec">
							<span class="zp-rec-label">RECOMMENDED LEVEL</span>
							<span class="zp-rec-value">Lv. @hz.Level</span>
						</div>
						<div class="zp-stats">
							<div class="zp-stat">
								<iconify icon="lucide:layers" Size=@(14) Color="#c4b5fd" />
								<span>@(hexp?.Waves ?? 0) WAVES</span>
							</div>
							@if ( hexp != null )
							{
								<div class="zp-stat element-@(hexp.Element.ToString().ToLower())">
									<img class="zp-stat-el" src="ui/icons/elements/background/@(hexp.Element.ToString().ToLower()).svg" />
									<span>@hexp.Element.ToString().ToUpper()</span>
								</div>
								@if ( hexp.HasBoss )
								{
									<div class="zp-stat boss">
										<iconify icon="lucide:skull" Size=@(13) Color="#fca5a5" />
										<span>BOSS</span>
									</div>
								}
							}
						</div>
						<div class="zp-lore">@hz.Lore</div>
						@if ( hUnlocked )
						{
							<div class="zp-hint">
								<iconify icon="lucide:mouse-pointer-click" Size=@(12) Color="#fde68a" />
								<span>Click to open</span>
							</div>
						}
						else
						{
							<div class="zp-hint locked">
								<iconify icon="lucide:info" Size=@(12) Color="#94a3b8" />
								<span>Clear the previous zone to unlock</span>
							</div>
						}
					</div>
				}
			}

			<!-- ═══ MINI-EXPEDITION MARKERS (secondary side content) ═══ -->
			@foreach ( var mini in GetMiniExpeditions() )
			{
				var mx = mini;
				var mUnlocked = ExpeditionManager.Instance?.CanStartExpedition( mx.Id ) ?? false;
				var mClass = mUnlocked ? "unlocked" : "locked";
				var mKey = "mini-" + mx.Id;
				var mHovered = _hoveredMiniId == mx.Id;
				var mPos = GetMiniPos( mx.Id );
				var mEdge = mPos.X > 70f ? "right-edge" : "";
				<div class="mini-marker @mClass @(mHovered ? "hovered" : "") @mEdge @(_editMode ? "editable" : "") @(KbActiveMarkerId == mx.Id ? "kb-active" : "")"
					 style="left: @(mPos.X)%; top: @(mPos.Y)%;"
					 onclick=@(() => SelectMini(mx.Id))
					 onmouseover=@(() => OnMiniHover(mx.Id, mKey))
					 onmouseout=@(() => { if (_hoveredMiniId == mx.Id) _hoveredMiniId = null; })
					 onmousedown=@(() => StartDragMini(mx.Id))>

					<div class="mini-pin">
						@if ( !mUnlocked )
						{
							<iconify icon="lucide:lock" Size=@(13) Color="#94a3b8" />
						}
						else
						{
							<iconify icon="lucide:trees" Size=@(14) Color="#fef3c7" />
						}
					</div>

					<div class="mini-label">
						<span class="mini-marker-name">@mx.Name</span>
						<span class="mini-meta">LV @mx.BaseEnemyLevel</span>
					</div>

					@if ( mHovered )
					{
						<div class="mini-tooltip">
							<span class="mini-tip-title">@mx.Name</span>
							<span class="mini-tip-desc">@mx.Description</span>
							@if ( !mUnlocked )
							{
								<span class="mini-tip-locked">Clear Weavermere to unlock</span>
							}
						</div>
					}
				</div>
			}

			<!-- ═══ TRADE NODES (request-tile style) ═══ -->
			@foreach ( var node in GetVisibleTradeNodes() )
			{
				var n = node;
				var isLocked = TradeNodeManager.Instance?.IsLocked( n.Id ) ?? true;
				var canAfford = TradeNodeManager.Instance?.CanAfford( n.Id ) ?? false;
				// Color-tint requests by host zone so the player can read at a
				// glance which expedition area each marker belongs to.
				var hostZone = GetZone( n.ZoneId );
				var hostUnlocked = hostZone != null && IsZoneUnlocked( hostZone );
				var zoneClass = "zone-" + ( n.ZoneId ?? "" ).Replace( "_", "-" );
				var tnClass = (isLocked ? "done" : "") + " " + (canAfford ? "ready" : "") + " " + zoneClass + (hostUnlocked ? "" : " host-locked");
				var tnKey = "tn-" + n.Id;
				@{ var tnPos = GetTradeNodePos( n ); var tnHovered = _hoveredTradeNodeId == n.Id; }
				<div class="trade-node @tnClass @(_editMode ? "editable" : "") @(tnHovered ? "hovered" : "")"
					 style="left: @(tnPos.X)%; top: @(tnPos.Y)%;"
					 onclick=@(() => OpenTradeNode(n.Id))
					 onmouseover=@(() => { OnHover(tnKey); _hoveredTradeNodeId = n.Id; })
					 onmouseout=@(() => { if (_hoveredTradeNodeId == n.Id) _hoveredTradeNodeId = null; })
					 onmousedown=@(() => StartDragTradeNode(n.Id))>
					<div class="tn-pin">
						@if ( isLocked )
						{
							<iconify icon="lucide:check" Size=@(14) Color="#4ade80" />
						}
						else
						{
							@* "?" badge = JRPG quest marker — reads as "an NPC
							   wants something" instantly. Replaced lucide:handshake
							   which read as a generic trade. *@
							<iconify icon="lucide:badge-help" Size=@(18) Color="#fef3c7" />
						}
					</div>
					@if ( canAfford && !isLocked )
					{
						<div class="tn-ready-pulse"></div>
					}

					@* Hover tooltip — Persona stamp pill above the pin showing
					   request title + NPC + zone hint when host is locked. *@
					@if ( tnHovered )
					{
						<div class="tn-tooltip">
							<span class="tn-tip-title">@n.Name</span>
							<span class="tn-tip-npc">@n.NpcName</span>
							@if ( !hostUnlocked && hostZone != null )
							{
								<span class="tn-tip-locked">Unlocks with @hostZone.Name</span>
							}
						</div>
					}
				</div>
			}
		</div>

		<!-- ═══ TRADE NODE POPUP (exchange dialog) ═══ -->
		@if ( _tradePopupNodeId != null )
		{
			var tnode = TradeNodeManager.Instance?.GetNode( _tradePopupNodeId );
			if ( tnode != null )
			{
				var canAfford = TradeNodeManager.Instance?.CanAfford( tnode.Id ) ?? false;
				var isDone = TradeNodeManager.Instance?.IsLocked( tnode.Id ) ?? true;
				var state = TradeNodeManager.Instance?.GetState( tnode.Id );

				<div class="zone-detail-overlay" onclick=@CloseTradePopup></div>
				<div class="request-popup">
					<button class="close-btn rp-close" onclick=@CloseTradePopup onmouseover=@(() => OnHover("tn-close"))>
						<iconify icon="lucide:x" Size=@(15) Color="rgba(255, 255, 255, 0.85)" />
					</button>

					@* NPC band — portrait diamond + kicker + name. Identifies the
					   requestor at a glance before the request title. *@
					<div class="rp-npc-band">
						<div class="rp-npc-portrait">
							<iconify icon="lucide:user" Size=@(28) Color="#fbbf24" />
						</div>
						<div class="rp-npc-meta">
							<span class="rp-npc-kicker">REQUEST · @tnode.NpcName</span>
							<span class="rp-title">@tnode.Name</span>
						</div>
					</div>

					<div class="rp-desc">@tnode.Description</div>

					@* GIVE — what the player needs to hand over *@
					<div class="rp-section-label">YOU GIVE</div>
					<div class="rp-line-list">
						@foreach ( var (itemId, qty) in tnode.Requirements )
						{
							var item = ItemManager.Instance?.GetItem( itemId );
							var have = TamerManager.Instance?.CurrentTamer?.Inventory != null
								&& TamerManager.Instance.CurrentTamer.Inventory.TryGetValue( itemId, out var h ) ? h : 0;
							var lineClass = have >= qty ? "satisfied" : "short";
							<div class="rp-line @lineClass">
								<img class="rp-line-icon" src="@(item?.IconPath)" />
								<span class="rp-line-name">@(item?.Name ?? itemId)</span>
								<span class="rp-line-amt">@have / @qty</span>
							</div>
						}
						@if ( tnode.GoldCost > 0 )
						{
							var gold = TamerManager.Instance?.CurrentTamer?.Gold ?? 0;
							var lineClass = gold >= tnode.GoldCost ? "satisfied" : "short";
							<div class="rp-line @lineClass">
								<iconify icon="lucide:coins" Size=@(20) Color="#fbbf24" />
								<span class="rp-line-name">Gold</span>
								<span class="rp-line-amt">@gold / @tnode.GoldCost</span>
							</div>
						}
					</div>

					@* RECEIVE — rewards laid out the same so the trade reads symmetrically *@
					<div class="rp-section-label">YOU RECEIVE</div>
					<div class="rp-line-list">
						@foreach ( var (itemId, qty) in tnode.ItemRewards )
						{
							var item = ItemManager.Instance?.GetItem( itemId );
							<div class="rp-line reward">
								<img class="rp-line-icon" src="@(item?.IconPath)" />
								<span class="rp-line-name">@(item?.Name ?? itemId)</span>
								<span class="rp-line-amt">×@qty</span>
							</div>
						}
						@if ( tnode.GoldReward > 0 )
						{
							<div class="rp-line reward">
								<iconify icon="lucide:coins" Size=@(20) Color="#fbbf24" />
								<span class="rp-line-name">Gold</span>
								<span class="rp-line-amt">+@tnode.GoldReward</span>
							</div>
						}
						@if ( tnode.XPReward > 0 )
						{
							<div class="rp-line reward">
								<iconify icon="lucide:arrow-up" Size=@(20) Color="#4ade80" />
								<span class="rp-line-name">Tamer XP</span>
								<span class="rp-line-amt">+@tnode.XPReward</span>
							</div>
						}
						@if ( tnode.SkillPointReward > 0 )
						{
							<div class="rp-line reward">
								<iconify icon="lucide:sparkles" Size=@(20) Color="#a78bfa" />
								<span class="rp-line-name">Skill Points</span>
								<span class="rp-line-amt">+@tnode.SkillPointReward</span>
							</div>
						}
					</div>

					@if ( isDone )
					{
						<div class="rp-done-banner">
							<iconify icon="lucide:check-circle-2" Size=@(18) Color="#4ade80" />
							<span>Already Completed</span>
						</div>
					}
					else
					{
						<button class="embark-btn rp-accept @(canAfford ? "" : "disabled")"
								onclick=@(() => ExecuteTrade(tnode.Id))
								onmouseover=@(() => OnHover("tn-exec-" + tnode.Id))>
							<iconify icon="lucide:handshake" Size=@(20) Color="#ffffff" />
							<span>@(canAfford ? "ACCEPT TRADE" : "NOT ENOUGH")</span>
						</button>
					}

					@if ( state != null && state.TimesCompleted > 0 )
					{
						<div class="tn-times-row">
							<span>Completed @state.TimesCompleted @(state.TimesCompleted == 1 ? "time" : "times")</span>
						</div>
					}
				</div>
			}
		}

		<!-- ═══ ZONE DETAIL PANE (appears when a zone is selected) ═══ -->
		@if ( _selectedZoneId != null )
		{
			var sz = GetZone( _selectedZoneId );
			if ( sz != null )
			{
				var exp = GetExpedition( sz.ExpeditionId );

				<div class="zone-detail-overlay" onclick=@CloseZoneDetail></div>
				@{
					var drops = ItemManager.Instance?.GetDropsForExpedition( sz.ExpeditionId ) ?? new System.Collections.Generic.List<ItemDefinition>();
					var heroImg = !string.IsNullOrEmpty( exp?.BackgroundImage ) ? exp.BackgroundImage : "ui/locations/placeholder_zone.png";
					var elClassZone = exp?.Element.ToString().ToLower() ?? "neutral";
				}
				@* Hyrule-Warriors style hero card — image up top, title overlay,
				   stat strip, lore, beast portraits, drop strip, single CTA. *@
				<div class="zone-detail hw-card">
					<button class="close-btn zd-close" onclick=@CloseZoneDetail onmouseover=@(() => OnHover("zd-close"))>
						<iconify icon="lucide:x" Size=@(15) Color="rgba(255, 255, 255, 0.85)" />
					</button>

					@* Hero image — zone art with element-tinted gradient + title overlay *@
					<div class="zd-hero element-@elClassZone">
						<img class="zd-hero-img" src="@heroImg" />
						<div class="zd-hero-veil"></div>
						<div class="zd-hero-info">
							<span class="zd-hero-kicker">EXPEDITION</span>
							<span class="zd-hero-title">@sz.Name</span>
							<div class="zd-hero-stats">
								<span class="zd-hero-stat">Lv @sz.Level</span>
								<span class="zd-hero-dot">·</span>
								<span class="zd-hero-stat">@(exp?.Waves ?? 0) Waves</span>
								@if ( exp != null && exp.HasBoss )
								{
									<span class="zd-hero-dot">·</span>
									<span class="zd-hero-stat boss">
										<iconify icon="lucide:skull" Size=@(12) Color="#fca5a5" />
										BOSS
									</span>
								}
							</div>
						</div>
					</div>

					@* Lore — short, breathable *@
					<div class="zd-lore-line">@sz.Lore</div>

					@* Wild beasts — square thumbnails in a row, names below.
					   Each thumbnail uses the species' DetailIconScale/Offset
					   so framing matches the My Beasts detail panel. Sprite
					   inner is sized in absolute pixels (no transform) so
					   `image-rendering: pixelated` stays crisp. *@
					@if ( exp != null && exp.PossibleSpecies.Count > 0 )
					{
						<div class="zd-row-label">WILD BEASTS</div>
						<div class="zd-beast-row">
							@foreach ( var speciesId in exp.PossibleSpecies )
							{
								var sp = MonsterManager.Instance?.GetSpecies( speciesId );
								if ( sp == null ) { continue; }
								var rClass = sp.BaseRarity.ToString().ToLower();
								var unseen = !( BeastiaryManager.Instance?.IsSeen( speciesId ) ?? false );
								<div class="zd-beast-portrait rarity-@rClass @(unseen ? "unseen" : "")">
									<div class="zd-portrait-icon">
										<div class="zd-portrait-icon-bg" style="@BuildZdIconStyle(sp)"></div>
										@if ( unseen )
										{
											<span class="zd-portrait-mystery">?</span>
										}
									</div>
									<div class="zd-portrait-label">
										<span class="zd-portrait-name">@(unseen ? "???" : sp.Name)</span>
										@if ( !unseen )
										{
											<img class="zd-portrait-element" src="ui/icons/elements/background/@(sp.Element.ToString().ToLower()).svg" />
											@if ( sp.SecondaryElement.HasValue )
											{
												<img class="zd-portrait-element secondary" src="ui/icons/elements/background/@(sp.SecondaryElement.Value.ToString().ToLower()).svg" />
											}
										}
									</div>
								</div>
							}
							@if ( exp.HasBoss && !string.IsNullOrEmpty( exp.BossSpeciesId ) )
							{
								var boss = MonsterManager.Instance?.GetSpecies( exp.BossSpeciesId );
								if ( boss != null )
								{
									var bossUnseen = !( BeastiaryManager.Instance?.IsSeen( exp.BossSpeciesId ) ?? false );
									<div class="zd-beast-portrait boss @(bossUnseen ? "unseen" : "")">
										<div class="zd-portrait-icon">
											<div class="zd-portrait-icon-bg" style="@BuildZdIconStyle(boss)"></div>
											@if ( bossUnseen )
											{
												<span class="zd-portrait-mystery">?</span>
											}
										</div>
										<div class="zd-portrait-label">
											<span class="zd-portrait-name">@(bossUnseen ? "???" : boss.Name)</span>
											@if ( !bossUnseen )
											{
												<img class="zd-portrait-element" src="ui/icons/elements/background/@(boss.Element.ToString().ToLower()).svg" />
												@if ( boss.SecondaryElement.HasValue )
												{
													<img class="zd-portrait-element secondary" src="ui/icons/elements/background/@(boss.SecondaryElement.Value.ToString().ToLower()).svg" />
												}
											}
										</div>
										<iconify class="zd-portrait-skull" icon="lucide:skull" Size=@(11) Color="#fca5a5" />
									</div>
								}
							}
						</div>
					}

					@* Primary CTA — sits above drops so the action is the anchor
					   point and drops are secondary info beneath it. *@
					<button class="embark-btn hw-embark" onclick=@(() => Embark(sz.ExpeditionId)) onmouseover=@(() => OnHover("embark-" + sz.Id))>
						<iconify icon="lucide:compass" Size=@(20) Color="#ffffff" />
						<span>EMBARK</span>
					</button>

					@* Drops — 2 cards per row. Built with explicit row pairs so
					   each card has a stable parent width (s&box flex-wrap +
					   calc(50%) collapses to character-width columns). *@
					@if ( drops.Count > 0 )
					{
						<div class="zd-row-label">
							<span>POSSIBLE DROPS</span>
							<span class="zd-row-sub">@drops.Count items</span>
						</div>
						<div class="zd-drop-scroll">
							@for ( int i = 0; i < drops.Count; i += 2 )
							{
								var leftDrop = drops[i];
								var rightDrop = i + 1 < drops.Count ? drops[i + 1] : null;
								<div class="zd-drop-pair">
									<div class="zd-drop-card rarity-@(leftDrop.Rarity.ToString().ToLower())">
										<img class="zd-drop-icon" src="@leftDrop.IconPath" />
										<div class="zd-drop-meta">
											<span class="zd-drop-name">@leftDrop.Name</span>
											<span class="zd-drop-source">@GetDropSource(leftDrop, sz, exp)</span>
										</div>
									</div>
									@if ( rightDrop != null )
									{
										<div class="zd-drop-card rarity-@(rightDrop.Rarity.ToString().ToLower())">
											<img class="zd-drop-icon" src="@rightDrop.IconPath" />
											<div class="zd-drop-meta">
												<span class="zd-drop-name">@rightDrop.Name</span>
												<span class="zd-drop-source">@GetDropSource(rightDrop, sz, exp)</span>
											</div>
										</div>
									}
									else
									{
										<div class="zd-drop-card-empty"></div>
									}
								</div>
							}
						</div>
					}
				</div>
			}
		}

		<!-- ═══ MINI-EXPEDITION DETAIL PANE ═══ -->
		@if ( _selectedMiniId != null )
		{
			var mexp = GetExpedition( _selectedMiniId );
			if ( mexp != null )
			{
				var mDrops = ItemManager.Instance?.GetDropsForExpedition( _selectedMiniId ) ?? new System.Collections.Generic.List<ItemDefinition>();
				var mHeroImg = !string.IsNullOrEmpty( mexp.BackgroundImage ) ? mexp.BackgroundImage : "ui/locations/placeholder_zone.png";
				var mElClass = mexp.Element.ToString().ToLower();
				// Pull boss species from the pool rather than a BossSpeciesId field —
				// mini-expedition boss is defined in BossPoolDatabase, not inline on Expedition.
				var mBossPool = BossPoolDatabase.GetPool( _selectedMiniId );
				var mBossSpeciesId = mBossPool?.Bosses?.Count > 0 ? mBossPool.Bosses[0].SpeciesId : null;
				var mBoss = mBossSpeciesId != null ? MonsterManager.Instance?.GetSpecies( mBossSpeciesId ) : null;
				<div class="zone-detail-overlay" onclick=@CloseMiniDetail></div>
				<div class="zone-detail mini-card hw-card">
					<button class="close-btn zd-close" onclick=@CloseMiniDetail onmouseover=@(() => OnHover("mini-close"))>
						<iconify icon="lucide:x" Size=@(15) Color="rgba(255, 255, 255, 0.85)" />
					</button>

					<div class="zd-hero element-@mElClass">
						<img class="zd-hero-img" src="@mHeroImg" />
						<div class="zd-hero-veil"></div>
						<div class="zd-hero-info">
							<span class="zd-hero-kicker">SIDE EXPEDITION</span>
							<span class="zd-hero-title">@mexp.Name</span>
							<div class="zd-hero-stats">
								<span class="zd-hero-stat">Lv @mexp.BaseEnemyLevel</span>
								<span class="zd-hero-dot">·</span>
								<span class="zd-hero-stat">@mexp.Waves Waves</span>
								@if ( mexp.HasBoss )
								{
									<span class="zd-hero-dot">·</span>
									<span class="zd-hero-stat boss">
										<iconify icon="lucide:skull" Size=@(12) Color="#fca5a5" />
										BOSS
									</span>
								}
							</div>
						</div>
					</div>

					<div class="zd-lore-line">@mexp.Description</div>

					@if ( mexp.PossibleSpecies.Count > 0 || mBoss != null )
					{
						<div class="zd-row-label">WILD BEASTS</div>
						<div class="zd-beast-row">
							@foreach ( var speciesId in mexp.PossibleSpecies )
							{
								var sp = MonsterManager.Instance?.GetSpecies( speciesId );
								if ( sp == null ) { continue; }
								var rClass = sp.BaseRarity.ToString().ToLower();
								var unseen = !( BeastiaryManager.Instance?.IsSeen( speciesId ) ?? false );
								<div class="zd-beast-portrait rarity-@rClass @(unseen ? "unseen" : "")">
									<div class="zd-portrait-icon">
										<div class="zd-portrait-icon-bg" style="@BuildZdIconStyle(sp)"></div>
										@if ( unseen )
										{
											<span class="zd-portrait-mystery">?</span>
										}
									</div>
									<div class="zd-portrait-label">
										<span class="zd-portrait-name">@(unseen ? "???" : sp.Name)</span>
										@if ( !unseen )
										{
											<img class="zd-portrait-element" src="ui/icons/elements/background/@(sp.Element.ToString().ToLower()).svg" />
											@if ( sp.SecondaryElement.HasValue )
											{
												<img class="zd-portrait-element secondary" src="ui/icons/elements/background/@(sp.SecondaryElement.Value.ToString().ToLower()).svg" />
											}
										}
									</div>
								</div>
							}
							@if ( mBoss != null )
							{
								var mBossUnseen = !( BeastiaryManager.Instance?.IsSeen( mBoss.Id ) ?? false );
								<div class="zd-beast-portrait boss-tag @(mBossUnseen ? "unseen" : "")">
									<div class="zd-portrait-icon">
										<div class="zd-portrait-icon-bg" style="@BuildZdIconStyle(mBoss)"></div>
										@if ( mBossUnseen )
										{
											<span class="zd-portrait-mystery">?</span>
										}
									</div>
									<div class="zd-portrait-label">
										<span class="zd-portrait-name">@(mBossUnseen ? "???" : mBoss.Name)</span>
										@if ( !mBossUnseen )
										{
											<img class="zd-portrait-element" src="ui/icons/elements/background/@(mBoss.Element.ToString().ToLower()).svg" />
											@if ( mBoss.SecondaryElement.HasValue )
											{
												<img class="zd-portrait-element secondary" src="ui/icons/elements/background/@(mBoss.SecondaryElement.Value.ToString().ToLower()).svg" />
											}
										}
									</div>
									<iconify class="zd-portrait-skull" icon="lucide:skull" Size=@(11) Color="#fca5a5" />
									<span class="zd-no-contract">CANNOT CONTRACT</span>
								</div>
							}
						</div>
					}

					<button class="embark-btn hw-embark" onclick=@(() => EmbarkMini(_selectedMiniId)) onmouseover=@(() => OnHover("embark-mini-" + _selectedMiniId))>
						<iconify icon="lucide:compass" Size=@(20) Color="#ffffff" />
						<span>START EXPEDITION</span>
					</button>

					@if ( mDrops.Count > 0 )
					{
						<div class="zd-row-label">
							<span>POSSIBLE DROPS</span>
							<span class="zd-row-sub">@mDrops.Count items</span>
						</div>
						<div class="zd-drop-scroll">
							@for ( int i = 0; i < mDrops.Count; i += 2 )
							{
								var leftDrop = mDrops[i];
								var rightDrop = i + 1 < mDrops.Count ? mDrops[i + 1] : null;
								<div class="zd-drop-pair">
									<div class="zd-drop-card rarity-@(leftDrop.Rarity.ToString().ToLower())">
										<img class="zd-drop-icon" src="@leftDrop.IconPath" />
										<div class="zd-drop-meta">
											<span class="zd-drop-name">@leftDrop.Name</span>
											<span class="zd-drop-source">@GetMiniDropSource(leftDrop)</span>
										</div>
									</div>
									@if ( rightDrop != null )
									{
										<div class="zd-drop-card rarity-@(rightDrop.Rarity.ToString().ToLower())">
											<img class="zd-drop-icon" src="@rightDrop.IconPath" />
											<div class="zd-drop-meta">
												<span class="zd-drop-name">@rightDrop.Name</span>
												<span class="zd-drop-source">@GetMiniDropSource(rightDrop)</span>
											</div>
										</div>
									}
									else
									{
										<div class="zd-drop-card-empty"></div>
									}
								</div>
							}
						</div>
					}
				</div>
			}
		}

		<!-- ═══ TEAM PICKER POPUP (overlays the whole map when Embark is clicked) ═══ -->
		<TeamPickerPopup />

		@* ═══ DEV: DRAG-TO-PLACE EDITOR ═══
		   Hidden behind ShowDevTools. Flip the const back to `true` in the
		   @code block to reveal the EDIT / SAVE → CONSOLE buttons for further
		   placement work. *@
		@if ( ShowDevTools )
		{
			<div class="map-dev-toolbar">
				<button class="map-dev-btn @(_editMode ? "active" : "")" onclick=@ToggleEditMode>
					<iconify icon="lucide:move" Size=@(13) Color="#fbbf24" />
					<span>EDIT @(_editMode ? "ON" : "OFF")</span>
				</button>
				@if ( _editMode )
				{
					<button class="map-dev-btn map-dev-save" onclick=@PrintPositions>
						<iconify icon="lucide:save" Size=@(13) Color="#4ade80" />
						<span>SAVE → CONSOLE</span>
					</button>
				}
			</div>
		}

		@if ( !string.IsNullOrEmpty( _draggingId ) )
		{
			<div class="map-drag-shield"
				 onmousemove=@OnEditDragMove
				 onmouseup=@OnEditDragEnd></div>
		}
	</div>
</root>

@code {
	public static WorldMapPanel Instance { get; private set; }

	private string _selectedZoneId;
	private string _tradePopupNodeId;
	// Hovered request marker — shows a small tooltip with name + NPC above the pin.
	private string _hoveredTradeNodeId;
	// Tracked separately from _hoveredKey so mousing over child elements of
	// the marker (label, pin) doesn't flicker the preview card off and back.
	private string _hoveredZoneId;
	// Lore-only village landmarks (houses, statue, mine, bridge, fences).
	// Shows a stamp tooltip on hover; not connected to any expedition.
	private string _hoveredLandmarkId;
	// Mini-expedition (side content) hover — shows a tooltip above the smaller pin.
	private string _hoveredMiniId;
	// Mini-expedition detail pane — mirrors _selectedZoneId for main zones.
	private string _selectedMiniId;

	// ───────────────────── DEV: DRAG-TO-PLACE EDITOR ─────────────────────
	// Toggle EDIT MODE to grab any landmark or zone marker and reposition it
	// on the map. Hit SAVE → CONSOLE to dump the current X/Y values to the
	// log so you can paste them back into the static Landmarks/Zones arrays.
	// Drag-shield pattern matches ChatPanel — onmousemove/onmouseup live on a
	// fullscreen shield that mounts only while dragging.
	//
	// Set ShowDevTools = true to surface the toolbar in-game. Hidden during
	// release / screenshot passes so the buttons don't appear in marketing.
	private const bool ShowDevTools = false;
	private bool _editMode = false;
	private string _draggingId;       // null when not dragging
	private string _draggingType;     // "landmark" or "zone"
	private float _dragStartMouseX, _dragStartMouseY;
	private float _dragStartItemX, _dragStartItemY;
	private bool _needsDragAnchor;
	private Dictionary<string, (float X, float Y, float Width)> _landmarkOverrides = new();
	private Dictionary<string, (float X, float Y)> _zoneOverrides = new();
	private Dictionary<string, (float X, float Y)> _tradeOverrides = new();
	private Dictionary<string, (float X, float Y)> _miniOverrides = new();

	// Hover-sound guard — onmouseover bubbles from children in s&box, so gate
	// sound playback behind a key change.
	private string _hoveredKey;
	private void OnHover( string key )
	{
		if ( _hoveredKey == key ) return;
		_hoveredKey = key;
		SoundManager.PlayHover();
	}

	// Zone marker hover — plays the hover sound once AND sets the preview
	// target. Split from OnHover so the preview card only anchors on the
	// outermost marker element, not its label/pin children (which would
	// otherwise fire mouseout and close the card mid-read).
	private void OnZoneMarkerHover( string zoneId, string hoverKey )
	{
		OnHover( hoverKey );
		_hoveredZoneId = zoneId;
	}

	private void OnZoneMarkerLeave( string zoneId )
	{
		if ( _hoveredZoneId == zoneId ) _hoveredZoneId = null;
	}

	// Landmark hover — village lore tooltip. Same flicker-guard pattern as
	// zone markers; OnLandmarkHover sets _hoveredLandmarkId so the tooltip
	// follows the cursor across the .landmark element's children.
	private void OnLandmarkHover( string landmarkId, string hoverKey )
	{
		OnHover( hoverKey );
		_hoveredLandmarkId = landmarkId;
	}

	private void OnLandmarkLeave( string landmarkId )
	{
		if ( _hoveredLandmarkId == landmarkId ) _hoveredLandmarkId = null;
	}

	private Landmark GetLandmark( string id ) => Landmarks.FirstOrDefault( l => l.Id == id );

	/// <summary>
	/// Player-facing subtitle on each drop card. For beast-signature materials
	/// (`mat_{speciesId}`), shows "Drops from {Beast}". For held items / relics
	/// / consumables, shows the gameplay effect (`+5% ATK`, `+25% gold`, etc.)
	/// so the player can see at a glance what the item actually does.
	/// </summary>
	private string GetDropSource( ItemDefinition drop, MapZone zone, Expedition exp )
	{
		if ( drop == null ) return "";

		if ( drop.Id.StartsWith( "mat_" ) )
		{
			var speciesId = drop.Id.Substring( 4 );
			var sp = MonsterManager.Instance?.GetSpecies( speciesId );
			var beastName = sp?.Name ?? "this beast";
			return $"Drops from {beastName}.";
		}

		// Held items + relics + consumables show their stat effect.
		var effect = drop.GetEffectDescription();
		return !string.IsNullOrEmpty( effect ) ? effect : drop.Description;
	}

	// ═══════════════════════════════════════════════════════════════
	// Village landmarks — lore-only PNG overlays on the map
	// ═══════════════════════════════════════════════════════════════
	// Each Landmark is a hover-lore element placed on the illustrated
	// map. They're decorative — clicking does nothing; hovering shows a
	// stamp-styled tooltip with one paragraph of village flavor.
	//
	// X/Y/Width are percent values relative to .map-art-frame so the
	// landmarks stay in alignment with the artist's illustration regardless
	// of viewport size. The Width is the landmark sprite's % width — Y/X
	// are the top-left anchor, NOT the center.
	//
	// Positions are eyeballed from map_whole.png. Tweak in art-direction
	// passes by swapping these numbers — no code logic depends on them.
	private record Landmark( string Id, string Name, string Lore, string ImagePath, float X, float Y, float Width, bool IsDecoration = false, string TagLabel = "Landmark" );

	private static readonly Landmark[] Landmarks = new[]
	{
		// Positions baked from the live SAVE → CONSOLE dev tool — these are
		// the canonical map placements. Adjust further by re-entering EDIT
		// mode in-game and re-saving; the JSON in FileSystem.Data overrides
		// these defaults at runtime when present.
		new Landmark(
			Id: "embrik_statue",
			Name: "Embrik's Watch",
			Lore: "A weathered statue of the village's first companion, carved by the founder's own hands. Tradition says new tamers leave a single ember at its base before their first run.",
			ImagePath: "ui/worldmap/serpinglin/embrik_statue.png",
			X: 46.2f, Y: 49.6f, Width: 3f ),

		new Landmark(
			Id: "house_001_home",
			Name: "Your Cottage",
			Lore: "Yours. Inherited from a grandparent you barely remember, kept livable by the kindness of neighbors. The hearth is older than the house, and the garden out back has a fence that was never quite finished.",
			ImagePath: "ui/worldmap/serpinglin/house_001.png",
			X: 37.8f, Y: 46.2f, Width: 3.8f,
			TagLabel: "Home" ),

		new Landmark(
			Id: "house_001b",
			Name: "",
			Lore: "",
			ImagePath: "ui/worldmap/serpinglin/house_001.png",
			X: 35.1f, Y: 49.0f, Width: 3.8f,
			IsDecoration: true ),

		new Landmark(
			Id: "house_001c",
			Name: "",
			Lore: "",
			ImagePath: "ui/worldmap/serpinglin/house_001.png",
			X: 37.4f, Y: 51.5f, Width: 3.8f,
			IsDecoration: true ),

		new Landmark(
			Id: "house_001d",
			Name: "",
			Lore: "",
			ImagePath: "ui/worldmap/serpinglin/house_001.png",
			X: 44.3f, Y: 61.9f, Width: 3.8f,
			IsDecoration: true ),

		new Landmark(
			Id: "house_002_almonry",
			Name: "The Almonry",
			Lore: "Was the village grain store; now a guesthouse. Every traveler gets one bowl on the house. Every contract with a starving beast gets two.",
			ImagePath: "ui/worldmap/serpinglin/house_002.png",
			X: 42.7f, Y: 37.7f, Width: 4.2f ),

		new Landmark(
			Id: "house_002b",
			Name: "",
			Lore: "",
			ImagePath: "ui/worldmap/serpinglin/house_002.png",
			X: 47.9f, Y: 59.3f, Width: 4.2f,
			IsDecoration: true ),

		new Landmark(
			Id: "house_003",
			Name: "Sundial House",
			Lore: "Built around the village's only working clock. The chime at sundown calls trainers home; the bell at noon means a new contract has been signed somewhere.",
			ImagePath: "ui/worldmap/serpinglin/house_003.png",
			X: 47.0f, Y: 37.0f, Width: 6.5f ),

		new Landmark(
			Id: "fences",
			Name: "The Holding Pens",
			Lore: "Where contracted beasts rest between expeditions. The fence posts are warded against startled stampedes. Step lightly when you visit — they remember you.",
			ImagePath: "ui/worldmap/serpinglin/fences.png",
			X: 30.8f, Y: 34.7f, Width: 11f ),

		new Landmark(
			Id: "mine",
			Name: "The Quiet Pit",
			Lore: "A spent vein that still hums, faintly, when the wind is right. Nobody mines here anymore, but the hum has its admirers — and a few small beasts that won't leave.",
			ImagePath: "ui/worldmap/serpinglin/mine.png",
			X: 31.4f, Y: 66.5f, Width: 5.5f ),

		new Landmark(
			Id: "bridge",
			Name: "The Long Bridge",
			Lore: "A long bridge to somewhere. Nobody in the village seems to remember exactly what's on the far side anymore — only that the boards keep getting replaced and the iron pins are still the originals.",
			ImagePath: "ui/worldmap/serpinglin/bridge.png",
			X: 15.3f, Y: 39.5f, Width: 11f ),
	};

	// Zone definitions — visual/narrative layer on top of the ExpeditionManager
	// data. Each zone maps to one of the first three Expedition entries until we
	// cut the rest on the Apr 25 retheme pass.
	private record MapZone(
		string Id,
		string ExpeditionId,
		string Name,
		string Lore,
		int Level,
		float X,
		float Y,
		string[] NpcPlaceholders );

	private static readonly MapZone[] Zones = new[]
	{
		// Tutorial-only zone — filtered out of the map by IsZoneVisible
		// once the tutorial completes/skips. Sits visually near the bridge.
		// Positions baked from the live SAVE → CONSOLE dev tool.
		new MapZone(
			Id: "saltmoor_approach",
			ExpeditionId: "saltmoor_approach",
			Name: "Serpinglin Approach",
			Lore: "A friendly stretch of path just past the Long Bridge. Perfect for a first run.",
			Level: 1,
			X: 14f,
			Y: 78f,
			NpcPlaceholders: new[] { "Trail Marker" } ),

		new MapZone(
			Id: "saltmoor_cove",
			ExpeditionId: "saltmoor_cove",
			Name: "Weaverton Pasture",
			Lore: "The fenced loop the wool-village of Weaverton set aside for young tamers to practice on. Sheepots graze just over the hedge, and the beasts that wander in past the pasture gate are gentle and curious — perfect for trying out your first contracts without anyone getting sheared.",
			Level: 1,
			X: 27.8f,
			Y: 49.2f,
			NpcPlaceholders: new[] { "Elder Mira", "Loomkeeper Bram", "Lost-Cat Kera" } ),

		new MapZone(
			Id: "saltmoor_forest",
			ExpeditionId: "saltmoor_forest",
			Name: "Weaverwood",
			Lore: "The pinewood east of Weaverton. The herders take Sheepots up these paths each summer for the long pasture, and the village's dye-leaves come from the old groves further in. The beasts here are wilder than the pasture pens — and lately the herders are coming back short a sheep more often than they'd like.",
			Level: 10,
			X: 68.6f,
			Y: 53.3f,
			NpcPlaceholders: new[] { "Ranger Tasha", "The Herbalist", "A Nervous Trader" } ),

		new MapZone(
			Id: "old_saltmoor",
			ExpeditionId: "old_saltmoor",
			Name: "Weavermere",
			Lore: "The mirror-still pond above Weaverton, ringed in lily pads and dragonfly-flicker. The village's painters, dyers, and pattern-weavers walk up here at dawn to find the colors no loom can match — and a few have come back with stranger stories than they went up with.",
			Level: 20,
			X: 69.1f,
			Y: 27.4f,
			NpcPlaceholders: new[] { "Painter Selene", "Dye-Master Wren", "The Wandering Poet" } ),
	};

	protected override void OnAfterTreeRender( bool firstTime )
	{
		if ( firstTime )
		{
			Instance = this;
			_hoveredKey = null;
			_selectedZoneId = null;
			LoadSavedPositions();
		}
	}

	public override void Tick()
	{
		base.Tick();
		// Esc dismisses the zone-detail overlay if it's open. Leaving the map
		// itself is done via the HUD tab bar (map is inline, not a modal).
		if ( Input.Pressed( "Escape" ) )
		{
			if ( _tradePopupNodeId != null ) CloseTradePopup();
			else if ( _selectedZoneId != null ) CloseZoneDetail();
			else if ( _selectedMiniId != null ) CloseMiniDetail();
		}
	}

	// ────────────────────── KEYBOARD NAVIGATION ──────────────────────
	// Cursor over the visible map markers — zones first, then mini-
	// expeditions, in render order. Drives the `.kb-active` highlight on
	// the matching marker. arrows = move, Space/Enter = open/embark,
	// Menu/run = close pane or exit to the tab bar.
	private int _kbMarkerIndex = 0;

	/// <summary>
	/// Flat ordered list of navigable markers: (id, isMini). Mirrors the
	/// render order so arrow keys feel spatially sensible.
	/// </summary>
	private List<(string Id, bool IsMini)> GetKbMarkers()
	{
		var list = new List<(string, bool)>();
		foreach ( var z in Zones )
		{
			if ( !IsZoneVisible( z ) ) continue;
			list.Add( (z.Id, false) );
		}
		foreach ( var mx in GetMiniExpeditions() )
		{
			list.Add( (mx.Id, true) );
		}
		return list;
	}

	/// <summary>Id of the marker currently under the keyboard cursor, or null.</summary>
	public string KbActiveMarkerId
	{
		get
		{
			var markers = GetKbMarkers();
			if ( markers.Count == 0 ) return null;
			int i = Math.Clamp( _kbMarkerIndex, 0, markers.Count - 1 );
			return markers[i].Id;
		}
	}

	/// <summary>
	/// Called by GameHUD.TickCurrentPanel() — child panels don't auto-tick.
	/// </summary>
	public void TickInput()
	{
		try
		{
			HandleMapKeyboardInput();
		}
		catch ( Exception ex )
		{
			Log.Warning( $"WorldMapPanel.TickInput error: {ex.Message}" );
		}
	}

	private void HandleMapKeyboardInput()
	{
		if ( ChatPanel.IsChatFocused ) return;
		// A blocking popup (incl. the team picker) owns the keyboard.
		if ( UIModalState.AnyModalOpen ) return;
		// Dev edit mode swallows clicks for drag-place — skip keyboard nav too.
		if ( _editMode ) return;

		// ── A detail pane is open: confirm embarks, Menu/run closes it. ──
		// Closing a detail pane is INTERNAL — claim the back key so GameHUD
		// (which ticks after this panel) doesn't also exit to the tab bar.
		if ( _selectedZoneId != null )
		{
			var sz = GetZone( _selectedZoneId );
			if ( ( Input.Pressed( "Jump" ) || Input.Pressed( "Enter" ) ) && sz != null )
				Embark( sz.ExpeditionId );
			else if ( Input.Pressed( "Menu" ) || Input.Pressed( "run" ) )
			{
				CloseZoneDetail();
				GameHUD.PanelHandledBackKey = true;
			}
			return;
		}
		if ( _selectedMiniId != null )
		{
			if ( Input.Pressed( "Jump" ) || Input.Pressed( "Enter" ) )
				EmbarkMini( _selectedMiniId );
			else if ( Input.Pressed( "Menu" ) || Input.Pressed( "run" ) )
			{
				CloseMiniDetail();
				GameHUD.PanelHandledBackKey = true;
			}
			return;
		}

		// ── No pane open: arrow through markers, confirm opens the pane. ──
		var markers = GetKbMarkers();
		if ( markers.Count == 0 ) return;
		_kbMarkerIndex = Math.Clamp( _kbMarkerIndex, 0, markers.Count - 1 );

		if ( Input.Pressed( "Left" ) || Input.Pressed( "Up" ) )
		{
			_kbMarkerIndex = Math.Max( 0, _kbMarkerIndex - 1 );
			SoundManager.PlayHover();
		}
		else if ( Input.Pressed( "Right" ) || Input.Pressed( "Down" ) )
		{
			_kbMarkerIndex = Math.Min( markers.Count - 1, _kbMarkerIndex + 1 );
			SoundManager.PlayHover();
		}
		else if ( Input.Pressed( "Jump" ) || Input.Pressed( "Enter" ) )
		{
			var m = markers[_kbMarkerIndex];
			if ( m.IsMini ) SelectMini( m.Id );
			else SelectZone( m.Id );
		}
		else if ( Input.Pressed( "Menu" ) || Input.Pressed( "run" ) )
		{
			// No pane open — back exits to the HUD tab bar.
			GameHUD.ExitPanel();
		}
	}

	private void SelectZone( string zoneId )
	{
		// Don't open the zone-detail pane while the player is repositioning
		// markers in dev edit mode — the click is part of a drag.
		if ( _editMode ) return;

		var zone = GetZone( zoneId );
		if ( zone == null ) return;
		if ( !IsZoneUnlocked( zone ) )
		{
			SoundManager.PlayDeny();
			return;
		}
		_selectedZoneId = zoneId;
		_hoveredKey = null;
		SoundManager.PlayClick();

		// Tutorial: notify that a zone was picked.
		Beastborne.Core.TutorialManager.Instance?.NotifyEvent( "worldmap.zone-selected" );
	}

	private void CloseZoneDetail()
	{
		_selectedZoneId = null;
		_hoveredKey = null;
		SoundManager.PlayPopdown();
	}

	private void Embark( string expeditionId )
	{
		var em = ExpeditionManager.Instance;
		if ( em == null )
		{
			SoundManager.PlayDeny();
			return;
		}

		// Progression gate — requires the previous expedition to be cleared.
		// Tamer level is NOT a hard cap (only a recommendation), so the copy
		// here reflects the real reason the CTA was disallowed.
		if ( !em.CanStartExpedition( expeditionId ) )
		{
			NotificationManager.Instance?.AddNotification(
				NotificationType.Warning,
				"Zone locked",
				"Clear the previous expedition to unlock this zone." );
			SoundManager.PlayDeny();
			return;
		}

		// Open the team picker popup — it owns the actual StartExpedition call.
		// Close the zone-detail pane so the popup isn't stacked under the
		// zd-overlay's click-dismiss layer.
		_selectedZoneId = null;
		TeamPickerPopup.Show( expeditionId );
	}

	private MapZone GetZone( string id ) => Zones.FirstOrDefault( z => z.Id == id );

	private Expedition GetExpedition( string id ) =>
		ExpeditionManager.Instance?.Expeditions.FirstOrDefault( e => e.Id == id );

