	/// <summary>Name of the zone the player must clear to open this one (the non-tutorial chain).</summary>
	private string PreviousZoneName( MapZone zone )
	{
		var em = ExpeditionManager.Instance;
		if ( em == null ) return null;
		var chain = em.Expeditions.Where( e => !e.TutorialOnly && !e.IsMiniExpedition ).ToList();
		int idx = chain.FindIndex( e => e.Id == zone.ExpeditionId );
		if ( idx <= 0 ) return null;
		return chain[idx - 1].Name;
	}

	/// <summary>Minis gate on the LAST main zone being cleared (ExpeditionManager.CanStartExpedition).</summary>
	private string MiniGateName( Expedition mini )
	{
		var em = ExpeditionManager.Instance;
		var last = em?.Expeditions.LastOrDefault( e => !e.TutorialOnly && !e.IsMiniExpedition );
		return last?.Name;
	}

	protected override void OnAfterTreeRender( bool firstTime )
	{
		if ( firstTime )
		{
			Instance = this;
			_hoveredKey = null;
			_selectedExpId = null;
			_cardLeaving = false;
			_mountedAt = RealTime.Now; // LANE: motion — the reveal waits for the page entrance
			_kbMarkerId = SeedMarkerId(); // open edge: the cursor lands on the CURRENT zone
		}
	}

	public override void Tick()
	{
		base.Tick();

		// LANE: motion — the unlock reveal beat ladder + the card's exit latch.
		TickReveal();
		if ( _cardLeaving && RealTime.Now >= _cardLeaveAt )
		{
			_cardLeaving = false;
			_selectedExpId = null;
		}
		if ( _popupLeaving && RealTime.Now >= _popupLeaveAt )
		{
			_popupLeaving = false;
			_tradePopupNodeId = null;
		}

		// LANE: input — kb scroll-follow on the DROPS slab: 0.30 glide per tick toward the
		// target row (DOC-5 #13); cleared once landed, or by the wheel / a row hover.
		if ( _dropsGlideTarget >= 0f && _selectedExpId != null && _dropsScroll != null )
		{
			float cur = _dropsScroll.ScrollOffset.y;
			float delta = _dropsGlideTarget - cur;
			if ( Math.Abs( delta ) < 0.5f )
			{
				_dropsScroll.ScrollOffset = new Vector2( _dropsScroll.ScrollOffset.x, _dropsGlideTarget );
				_dropsGlideTarget = -1f;
			}
			else
			{
				_dropsScroll.ScrollOffset = new Vector2( _dropsScroll.ScrollOffset.x, cur + delta * 0.30f );
			}
		}

		// Esc dismisses the top surface. Leaving the map is the HUD tab bar's job.
		if ( Input.Pressed( "Escape" ) )
		{
			if ( RevealLive ) SkipReveal();
			else if ( _tradePopupNodeId != null ) { if ( !_popupLeaving ) CloseTradePopup(); }
			else if ( _selectedExpId != null && !_cardLeaving ) CloseCard();
		}
	}

	// ────────────────────── INPUT DEVICE — one flag, three legs (DOC-5 #5) ──────────────────────
	// LANE: input. `_lastInputDevice` → root .kbd-mode/.mouse-mode; every owned :hover is
	// CSS-gated under .mouse-mode and every kb cursor class under .kbd-mode (the scss gate
	// block); hover handlers no-op in kb mode. Root onmousemove reclaims mouse mode only
	// after REAL travel (> 3px since the keyboard took over) — the engine re-sends
	// onmousemove when the panel re-renders under a parked cursor (learnings 2026-09-01).
	private enum InputDevice { Mouse, Keyboard }
	private InputDevice _lastInputDevice = InputDevice.Mouse;
	private bool IsKbMode => _lastInputDevice == InputDevice.Keyboard;
	private Vector2 _kbTakeoverMousePos = new Vector2( -9999f, -9999f );

	private void SetInputDevice( InputDevice dev )
	{
		if ( _lastInputDevice == dev ) return;
		_lastInputDevice = dev;
		if ( dev == InputDevice.Keyboard )
		{
			_kbTakeoverMousePos = Mouse.Position;
			// Keyboard takes over — drop every hover so a parked pointer can't hold a second cursor.
			_hoveredZoneId = null;
			_hoveredMiniId = null;
			_hoveredTradeNodeId = null;
			_hoveredLandmarkId = null;
			_hoveredKey = null;
		}
	}

	private void OnRootMouseMove()
	{
		if ( _lastInputDevice == InputDevice.Mouse ) return;
		if ( ( Mouse.Position - _kbTakeoverMousePos ).Length < 3f ) return;
		SetInputDevice( InputDevice.Mouse );
		StateHasChanged();
	}

	// ────────────────────── KEYBOARD NAVIGATION ──────────────────────
	// LANE: input — THE PIN GRAPH IS SPATIAL: W/A/S/D move to the nearest pin in that
	// direction by anchor centre (the inline % anchors scaled to the 1920×1080 frame —
	// the same numbers that place the pins, so the graph IS the screen; DOC-5 #21).
	// Stops: zone pins (locked ones too — they read "CLEAR …"), mini pins, visible
	// request pins. The cursor is an ID, not an index (DOC-5 #20: tutorial pins hide,
	// requests appear). Hover in mouse mode moves the same id.
	private string _kbMarkerId;
	private record KbPin( string Id, string Kind, float X, float Y ); // Kind: zone | mini | req

	/// <summary>Id of the marker under the cursor (zone id · mini expedition id · request node id), or null.</summary>
	public string KbActiveMarkerId => _kbMarkerId;

	private List<KbPin> GetKbPins()
	{
		var list = new List<KbPin>();
		foreach ( var z in Zones )
		{
			if ( !IsZoneVisible( z ) ) continue;
			list.Add( new KbPin( z.Id, "zone", z.X * 19.2f, z.Y * 10.8f ) );
		}
		foreach ( var mx in GetMiniExpeditions() )
		{
			var p = GetMiniPos( mx.Id );
			list.Add( new KbPin( mx.Id, "mini", p.X * 19.2f, p.Y * 10.8f ) );
		}
		foreach ( var n in GetVisibleTradeNodes() )
		{
			list.Add( new KbPin( n.Id, "req", n.MapPosX * 19.2f, n.MapPosY * 10.8f ) );
		}
		return list;
	}

	/// <summary>Seed = the CURRENT zone: the furthest unlocked zone in chain order (everything
	/// cleared → the last cleared); a visible tutorial zone wins while the tutorial runs.</summary>
	private string SeedMarkerId()
	{
		string first = null, lastUnlocked = null;
		foreach ( var z in Zones )
		{
			if ( !IsZoneVisible( z ) ) continue;
			first ??= z.Id;
			var exp = GetExpedition( z.ExpeditionId );
			if ( exp != null && exp.TutorialOnly && IsZoneUnlocked( z ) ) return z.Id;
			if ( IsZoneUnlocked( z ) ) lastUnlocked = z.Id;
		}
		return lastUnlocked ?? first;
	}

	/// <summary>Nearest pin strictly in the pressed direction: distance along the axis + 2× the
	/// perpendicular drift, so straight-ahead beats diagonal. No candidate = the map's edge — rest.</summary>
	private void MovePinCursor( int dx, int dy )
	{
		var pins = GetKbPins();
		var cur = pins.FirstOrDefault( p => p.Id == _kbMarkerId );
		if ( cur == null ) { _kbMarkerId = SeedMarkerId(); return; }
		KbPin best = null;
		float bestScore = float.MaxValue;
		foreach ( var p in pins )
		{
			if ( p.Id == cur.Id ) continue;
			float ddx = p.X - cur.X, ddy = p.Y - cur.Y;
			float ahead = dx * ddx + dy * ddy;
			if ( ahead < 8f ) continue;
			float perp = Math.Abs( dx != 0 ? ddy : ddx );
			float score = ahead + perp * 2f;
			if ( score < bestScore ) { bestScore = score; best = p; }
		}
		if ( best == null ) return;
		_kbMarkerId = best.Id;
		SoundManager.PlayHover();
	}

	// ── CARD STOPS: 0 = EMBARK (seeded on the open edge — "land on the current zone → Space →
	// EMBARK is the first stop → Space → picker"), 1..N = DROPS rows, only while the grid
	// scrolls (.zd-drops.scrolls). WILD / BOSS tiles are read-only — no stops.
	private int _cardCursor = 0;
	private Panel _dropsScroll;
	private float _dropsGlideTarget = -1f;

	/// <summary>The drops grid budget — ONE formula for the markup and the kb stops: rows two-up,
	/// 44 tall, 6 apart; fixed card 728 with a kicker (710 without — the WILD / DROPS heads are 36
	/// .wm-band rows, FEEL F1); the card never passes 928.</summary>
	private static (int Rows, int ViewH, bool Scrolls) DropsLayout( int dropCount, bool hasKicker )
	{
		int rows = ( dropCount + 1 ) / 2;
		int gridH = rows > 0 ? rows * 44 + ( rows - 1 ) * 6 : 0;
		int fixedH = hasKicker ? 728 : 710;
		int viewH = Math.Min( gridH, 928 - fixedH );
		return (rows, viewH, gridH > viewH);
	}

	private (int Rows, int ViewH, bool Scrolls) CurrentCardDrops()
	{
		var exp = GetExpedition( _selectedExpId );
		if ( exp == null ) return (0, 0, false);
		var em = ExpeditionManager.Instance;
		bool cleared = em?.HasClearedExpedition( exp.Id ) ?? false;
		bool hard = cleared && ( em?.IsHardModeUnlocked( exp.Id ) ?? false );
		bool hasKicker = hard || cleared || exp.IsMiniExpedition; // mirrors the markup's kicker
		int count = ItemManager.Instance?.GetZoneDropOdds( exp.Id, false )?.Count ?? 0;
		return DropsLayout( count, hasKicker );
	}

	/// <summary>Glide target that brings drop row `row` fully into the slab (row 0 → top; the
	/// measured-rect helper handles the rest in screen space, so scale is honest).</summary>
	private void FollowDropRow( int row )
	{
		if ( _dropsScroll == null ) return;
		if ( row <= 0 ) { _dropsGlideTarget = 0f; return; }
		var tile = _dropsScroll.Children.ElementAtOrDefault( row * 2 );
		var off = UiGridScroll.ComputeOffset( _dropsScroll, tile, 0f );
		if ( off.HasValue ) _dropsGlideTarget = off.Value;
	}

	/// <summary>Called by GameHUD.TickCurrentPanel() — child panels don't auto-tick.</summary>
	public void TickInput()
	{
		try
		{
			HandleMapKeyboardInput();
		}
		catch ( Exception ex )
		{
			Log.Warning( $"WorldMapPanel.TickInput error: {ex.Message}" );
		}
	}

	private void HandleMapKeyboardInput()
	{
		if ( ChatPanel.IsChatFocused ) return;
		if ( UIModalState.AnyModalOpen ) return; // the picker / a dialogue / a confirm owns the keys

		// Leg 1 of the device contract: any nav key → keyboard mode.
		bool navKey = Input.Pressed( "Up" ) || Input.Pressed( "Down" ) || Input.Pressed( "Left" ) || Input.Pressed( "Right" )
			|| UiInput.ConfirmPressed() || Input.Pressed( "Menu" );
		if ( navKey ) SetInputDevice( InputDevice.Keyboard );

		// LANE: motion — the reveal window: any key skips to the end state, nothing else fires.
		if ( RevealLive )
		{
			if ( navKey || Input.Pressed( "Escape" ) )
			{
				SkipReveal();
				if ( Input.Pressed( "Menu" ) ) GameHUD.PanelHandledBackKey = true;
			}
			return;
		}

		// ── Q CHAIN, top surface first: request popup → card → page. ──
		if ( _tradePopupNodeId != null )
		{
			// LANE: motion — a leaving popup swallows its last 0.12s of keys (Q still claimed: nothing
			// beneath may back out on the same press).
			if ( _popupLeaving )
			{
				if ( Input.Pressed( "Menu" ) ) GameHUD.PanelHandledBackKey = true;
				return;
			}
			if ( Input.Pressed( "Menu" ) )
			{
				CloseTradePopup();
				GameHUD.PanelHandledBackKey = true;
				return;
			}
			// Space = ACCEPT TRADE (the popup's one action); not affordable / done = deny.
			// The TRADED beat window is silent (the commit already answered).
			if ( UiInput.ConfirmPressed() )
			{
				if ( IsTradeBeat ) return;
				var mgr = TradeNodeManager.Instance;
				bool done = mgr?.IsLocked( _tradePopupNodeId ) ?? true;
				bool afford = !done && ( mgr?.CanAfford( _tradePopupNodeId ) ?? false );
				if ( afford ) ExecuteTrade( _tradePopupNodeId );
				else SoundManager.PlayDeny();
			}
			return;
		}

		if ( _selectedExpId != null )
		{
			if ( !_cardLeaving ) HandleCardKeys(); // a leaving card swallows its last 0.12s of keys
			return;
		}

		// ── PAGE: the pin graph. ──
		var pins = GetKbPins();
		if ( pins.Count == 0 ) return;
		if ( _kbMarkerId == null || pins.All( p => p.Id != _kbMarkerId ) ) _kbMarkerId = SeedMarkerId();

		if ( UiInput.ConfirmPressed() )   // Space (advertised) · Enter · E
		{
			var cur = pins.First( p => p.Id == _kbMarkerId );
			switch ( cur.Kind )
			{
				case "zone": SelectZone( cur.Id ); break;
				case "mini": SelectMini( cur.Id ); break;
				default: OpenTradeNode( cur.Id ); break;
			}
			return;
		}

		if ( Input.Pressed( "Up" ) ) MovePinCursor( 0, -1 );
		else if ( Input.Pressed( "Down" ) ) MovePinCursor( 0, 1 );
		else if ( Input.Pressed( "Left" ) ) MovePinCursor( -1, 0 );
		else if ( Input.Pressed( "Right" ) ) MovePinCursor( 1, 0 );
		// Q at the page root is NOT claimed: there is nothing to back out of, and GameHUD
		// treats an unclaimed Q as a silent no-op (2026-09-04). Leaving the map = the tab keys.
	}

	private void HandleCardKeys()
	{
		if ( Input.Pressed( "Menu" ) )
		{
			CloseCard();
			GameHUD.PanelHandledBackKey = true;
			return;
		}

		var (rows, _, scrolls) = CurrentCardDrops();
		int maxStop = scrolls ? rows : 0;
		_cardCursor = Math.Clamp( _cardCursor, 0, maxStop );

		if ( UiInput.ConfirmPressed() )
		{
			if ( _cardCursor == 0 )
			{
				// EMBARK → the picker (Embark → TeamPickerPopup.Show). Locked card: the button is
				// Disabled — deny blip, nothing opens.
				bool unlocked = ExpeditionManager.Instance?.CanStartExpedition( _selectedExpId ) ?? false;
				if ( unlocked ) EmbarkSelected();
				else SoundManager.PlayDeny();
			}
			// drop rows are read-only — silent
			return;
		}

		int dy = Input.Pressed( "Up" ) ? -1 : ( Input.Pressed( "Down" ) ? 1 : 0 );
		if ( dy == 0 ) return; // A/D: no horizontal stops on the card
		int next = Math.Clamp( _cardCursor + dy, 0, maxStop );
		if ( next == _cardCursor ) return; // W off EMBARK / S off the last row — rest
		_cardCursor = next;
		SoundManager.PlayHover();
		if ( _cardCursor == 0 ) _dropsGlideTarget = 0f;
		else FollowDropRow( _cardCursor - 1 );
	}

	// Wheel over the DROPS slab scrolls it (the engine's own scroll via base); the map has
	// nothing else to scroll, so every other wheel is consumed here. `public` — same base
	// visibility as LeaderboardPanel / BeastiaryPanel (both `@inherits Panel`).
	public override void OnMouseWheel( Vector2 delta )
	{
		if ( _selectedExpId != null && _dropsScroll != null && _dropsScroll.Box.Rect.IsInside( Mouse.Position ) )
		{
			_dropsGlideTarget = -1f; // the wheel wins over a pending kb glide
			base.OnMouseWheel( delta );
			return;
		}
		// consumed
	}

	// ────────────────────── SELECTION / CARD ──────────────────────
	// A LOCKED pin opens its card too (the card carries the disabled EMBARK; "CLEAR …" is on
	// the pin) — Space/click on the disabled EMBARK is the deny, not the pin.
	private void SelectZone( string zoneId )
	{
		var zone = GetZone( zoneId );
		if ( zone == null ) return;
		OpenCard( zone.ExpeditionId, zone.Id );
		if ( IsZoneUnlocked( zone ) )
			Beastborne.Core.TutorialManager.Instance?.NotifyEvent( "worldmap.zone-selected" );
	}

	private void SelectMini( string expeditionId )
	{
		if ( ExpeditionManager.Instance == null ) return;
		OpenCard( expeditionId, expeditionId );
	}

	/// <summary>Open edge of the card (mouse AND keyboard land here): the cursor sits on EMBARK.</summary>
	private void OpenCard( string expeditionId, string markerId )
	{
		_selectedExpId = expeditionId;
		_cardLeaving = false; // re-opening during the exit latch = a fresh card (class string changes → wmCardIn)
		_kbMarkerId = markerId;
		_cardCursor = 0;
		_dropsGlideTarget = -1f;
		_hoveredKey = null;
		SoundManager.PlayClick();
	}

	private void CloseCard()
	{
		if ( _selectedExpId == null || _cardLeaving ) return;
		// LANE: motion — exit latch: the card stays mounted as .leaving for 0.12s, Tick unmounts.
		_cardLeaving = true;
		_cardLeaveAt = RealTime.Now + 0.12f;
		_cardCursor = 0;
		_dropsGlideTarget = -1f;
		_hoveredKey = null;
		SoundManager.PlayPopdown();
	}

	/// <summary>Dim click — closes whichever surface is on top (popup over card).</summary>
	private void CloseTopSurface()
	{
		if ( _tradePopupNodeId != null ) { if ( !_popupLeaving ) CloseTradePopup(); }
		else if ( _selectedExpId != null && !_cardLeaving ) CloseCard();
	}

	private void EmbarkSelected()
	{
		if ( _selectedExpId == null ) return;
		Embark( _selectedExpId );
	}

	private void Embark( string expeditionId )
	{
		var em = ExpeditionManager.Instance;
		if ( em == null )
		{
			SoundManager.PlayDeny();
			return;
		}
		// Progression gate — the previous zone must be cleared (tamer level is advisory).
		if ( !em.CanStartExpedition( expeditionId ) )
		{
			NotificationManager.Instance?.AddNotification(
				NotificationType.Warning,
				"Zone locked",
				"Clear the previous expedition to unlock this zone." );
			SoundManager.PlayDeny();
			return;
		}
		// The picker owns StartExpedition. Close the card so the popup isn't under the dim.
		_selectedExpId = null;
		_cardLeaving = false; // instant — the picker's own entrance is the motion here
		TeamPickerPopup.Show( expeditionId );
	}

	private MapZone GetZone( string id ) => Zones.FirstOrDefault( z => z.Id == id );

	private Expedition GetExpedition( string id ) =>
		ExpeditionManager.Instance?.Expeditions.FirstOrDefault( e => e.Id == id );

	// ────────────────────── CARD DATA ──────────────────────

	/// <summary>Species the WILD waves can roll — PossibleSpecies minus every boss-pool species
	/// (ExpeditionManager.GenerateWaveEnemies ~L1340-1364).</summary>
	private List<MonsterSpecies> GetWildSpecies( Expedition exp )
	{
		var list = new List<MonsterSpecies>();
		if ( exp?.PossibleSpecies == null ) return list;
		var bossIds = new HashSet<string>();
		var pool = BossPoolDatabase.GetPool( exp.Id );
		if ( pool != null )
		{
			foreach ( var b in pool.Bosses ) bossIds.Add( b.SpeciesId );
			if ( pool.RareBosses != null ) foreach ( var rb in pool.RareBosses ) bossIds.Add( rb.SpeciesId );
		}
		foreach ( var id in exp.PossibleSpecies )
		{
			if ( bossIds.Contains( id ) ) continue;
			var sp = MonsterManager.Instance?.GetSpecies( id );
			if ( sp != null ) list.Add( sp );
		}
		return list;
	}

	/// <summary>The boss tile: highest tier in the zone's pool (Elite first), and the pool size for "1 OF N".</summary>
	private (MonsterSpecies Species, int Count) GetCardBoss( Expedition exp )
	{
		if ( exp == null || !exp.HasBoss ) return (null, 0);
		var pool = BossPoolDatabase.GetPool( exp.Id );
		if ( pool == null || pool.Bosses == null || pool.Bosses.Count == 0 )
		{
			// Legacy inline field — null on every launch zone, kept as the fallback.
			var inline = !string.IsNullOrEmpty( exp.BossSpeciesId ) ? MonsterManager.Instance?.GetSpecies( exp.BossSpeciesId ) : null;
			return (inline, inline != null ? 1 : 0);
		}
		var pick = pool.Bosses.OrderByDescending( b => (int)b.Tier ).First();
		return (MonsterManager.Instance?.GetSpecies( pick.SpeciesId ), pool.Bosses.Count);
	}

	/// <summary>`mat_{speciesId}` → the species, so a material tile wears its beast's glyph.</summary>
	private MonsterSpecies SpeciesForMaterial( ItemDefinition item )
	{
		if ( item == null || string.IsNullOrEmpty( item.Id ) || !item.Id.StartsWith( "mat_" ) ) return null;
		return MonsterManager.Instance?.GetSpecies( item.Id.Substring( 4 ) );
	}

	// ────────────────────── TRADE NODE HELPERS ──────────────────────

	/// <summary>Requests show only after their host expedition is cleared once.</summary>
	private IEnumerable<TradeNode> GetVisibleTradeNodes()
	{
		var mgr = TradeNodeManager.Instance;
		if ( mgr == null ) yield break;
		var em = ExpeditionManager.Instance;
		if ( em == null ) yield break;
		foreach ( var node in mgr.AllNodes )
		{
			if ( !em.HasClearedExpedition( node.ZoneId ) ) continue;
			yield return node;
		}
	}

	private void OpenTradeNode( string nodeId )
	{
		_tradePopupNodeId = nodeId;
		_popupLeaving = false; // re-opening during the exit latch = a fresh popup (class string changes → rqRise)
		_kbMarkerId = nodeId; // the cursor follows the click
		_hoveredKey = null;
		SoundManager.PlayClick();
	}

	private void CloseTradePopup()
	{
		if ( _tradePopupNodeId == null || _popupLeaving ) return;
		// LANE: motion — exit latch: the popup stays mounted as .leaving for 0.12s, Tick unmounts.
		_popupLeaving = true;
		_popupLeaveAt = RealTime.Now + 0.12f;
		_hoveredKey = null;
		SoundManager.PlayPopdown();
	}

	/// <summary>BbButton OnClick for the request popup (method group — hotload law): the open node.
	/// Inert on a leaving popup (pointer-events: none descends into children — DOC-7 #21) and during the beat.</summary>
	private void ExecuteSelectedTrade()
	{
		if ( _tradePopupNodeId == null || _popupLeaving || IsTradeBeat ) return;
		ExecuteTrade( _tradePopupNodeId );
	}

	private void ExecuteTrade( string nodeId )
	{
		var result = TradeNodeManager.Instance?.Execute( nodeId ) ?? TradeNodeManager.TradeResult.UnknownNode;
		if ( result == TradeNodeManager.TradeResult.Success )
		{
			// LANE: motion (F4b) — the commit beat: 0.5s TRADED window on the CTA + the pin's green flash.
			_tradeBeatVersion++;
			_tradeBeatUntil = RealTime.Now + 0.5f;
			_tradeBeatNodeId = nodeId;
			SoundManager.PlaySuccess();
		}
		else
		{
			SoundManager.PlayDeny();
		}
	}

	// ────────────────────── MINI-EXPEDITIONS ──────────────────────
	private IEnumerable<Expedition> GetMiniExpeditions()
	{
		return ExpeditionManager.Instance?.Expeditions
			.Where( e => e.IsMiniExpedition ) ?? Enumerable.Empty<Expedition>();
	}

	// ────────────────────── HEADER HELPERS ──────────────────────

	/// <summary>Zones the player has fully cleared (visible, non-tutorial).</summary>
	private int GetClearedZoneCount()
	{
		var em = ExpeditionManager.Instance;
		if ( em == null ) return 0;
		int count = 0;
		foreach ( var z in Zones )
		{
			var exp = em.Expeditions.FirstOrDefault( e => e.Id == z.ExpeditionId );
			if ( exp == null || exp.TutorialOnly ) continue;
			if ( em.HasClearedExpedition( z.ExpeditionId ) ) count++;
		}
		return count;
	}

	/// <summary>Total playable (non-tutorial) zones on this map.</summary>
	private int GetTotalZoneCount()
	{
		var em = ExpeditionManager.Instance;
		if ( em == null ) return Zones.Length;
		int count = 0;
		foreach ( var z in Zones )
		{
			var exp = em.Expeditions.FirstOrDefault( e => e.Id == z.ExpeditionId );
			if ( exp == null || exp.TutorialOnly ) continue;
			count++;
		}
		return count;
	}

	private bool IsZoneUnlocked( MapZone zone )
	{
		var em = ExpeditionManager.Instance;
		var tamer = TamerManager.Instance?.CurrentTamer;
		if ( em == null || tamer == null ) return zone.Id == "saltmoor_cove";

		var exp = em.Expeditions.FirstOrDefault( e => e.Id == zone.ExpeditionId );
		if ( exp == null ) return false;

		if ( exp.TutorialOnly )
			return Beastborne.Core.TutorialManager.Instance?.IsTutorialActive == true;

		var realChain = em.Expeditions.Where( e => !e.TutorialOnly ).ToList();
		int idx = realChain.IndexOf( exp );
		return idx <= tamer.HighestExpeditionCleared;
	}

	private bool IsZoneVisible( MapZone zone )
	{
		var em = ExpeditionManager.Instance;
		var exp = em?.Expeditions.FirstOrDefault( e => e.Id == zone.ExpeditionId );
		if ( exp == null ) return true;
		if ( exp.TutorialOnly )
			return Beastborne.Core.TutorialManager.Instance?.IsTutorialActive == true;
		return true;
	}

	protected override int BuildHash()
	{
		var h = new HashCode();
		h.Add( IsVisible );
		h.Add( _selectedExpId );
		h.Add( _tradePopupNodeId );
		h.Add( _hoveredZoneId );
		h.Add( _hoveredLandmarkId );
		h.Add( _hoveredTradeNodeId );
		h.Add( _hoveredMiniId );
		// LANE: input — every cursor field (DOC-7 #22).
		h.Add( _lastInputDevice );
		h.Add( _kbMarkerId );
		h.Add( _cardCursor );
		h.Add( _revealZoneId );
		h.Add( PendingRevealZoneId );
		// LANE: motion — the beat ladder's phase, both exit latches, the trade beat window and the
		// page-entrance window (DOC-7 #22 — every field that changes a class string).
		h.Add( _revealPhase );
		h.Add( _cardLeaving );
		h.Add( _popupLeaving );
		h.Add( _tradeBeatVersion );
		h.Add( IsTradeBeat );
		h.Add( PinEntranceLive );
		h.Add( TamerManager.Instance?.CurrentTamer?.Level ?? 0 );
		h.Add( TamerManager.Instance?.CurrentTamer?.HighestExpeditionCleared ?? 0 );
		h.Add( TamerManager.Instance?.CurrentTamer?.Gold ?? 0 );
		h.Add( TamerManager.Instance?.CurrentTamer?.HardModeUnlocked?.Count ?? 0 );
		h.Add( ExpeditionManager.Instance?.CanStartExpedition( "mini_loomweaver_burrow" ) ?? false );
		h.Add( Beastborne.Core.TutorialManager.Instance?.IsTutorialActive == true );
		// Request pins flip READY/DONE with the bag and completion state.
		var inv = TamerManager.Instance?.CurrentTamer?.Inventory;
		if ( inv != null )
		{
			foreach ( var node in TradeNodeManager.Instance?.AllNodes ?? new List<TradeNode>() )
			{
				foreach ( var (itemId, _) in node.Requirements )
				{
					inv.TryGetValue( itemId, out var cnt );
					h.Add( itemId );
					h.Add( cnt );
				}
				var state = TradeNodeManager.Instance?.GetState( node.Id );
				h.Add( state?.TimesCompleted ?? 0 );
			}
		}
		return h.ToHashCode();
	}
}
