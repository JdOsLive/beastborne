	private void OnEditDragMove( PanelEvent e )
	{
		if ( string.IsNullOrEmpty( _draggingId ) ) return;

		// First move after drag start — anchor mouse coords on the shield
		// (which is fullscreen + static, so its coords are immune to the
		// landmark/marker moving as we drag it).
		if ( _needsDragAnchor )
		{
			_dragStartMouseX = MousePosition.x;
			_dragStartMouseY = MousePosition.y;
			_needsDragAnchor = false;
			return;
		}

		var rect = Box.Rect;
		if ( rect.Width <= 0 || rect.Height <= 0 ) return;

		float dxPct = ( MousePosition.x - _dragStartMouseX ) / rect.Width * 100f;
		float dyPct = ( MousePosition.y - _dragStartMouseY ) / rect.Height * 100f;
		float newX = _dragStartItemX + dxPct;
		float newY = _dragStartItemY + dyPct;

		if ( _draggingType == "landmark" )
		{
			var lm = GetLandmark( _draggingId );
			if ( lm != null )
			{
				var existing = GetLandmarkPos( lm );
				_landmarkOverrides[_draggingId] = (newX, newY, existing.Width);
			}
		}
		else if ( _draggingType == "zone" )
		{
			_zoneOverrides[_draggingId] = (newX, newY);
		}
		else if ( _draggingType == "trade" )
		{
			_tradeOverrides[_draggingId] = (newX, newY);
		}
		else if ( _draggingType == "mini" )
		{
			_miniOverrides[_draggingId] = (newX, newY);
		}
		StateHasChanged();
	}

	private void OnEditDragEnd( PanelEvent e )
	{
		_draggingId = null;
		_draggingType = null;
		StateHasChanged();
	}

	// ───── Saved-positions persistence ─────────────────────────────
	// JSON file in FileSystem.Data so dragged positions actually persist
	// across sessions (was previously log-only — print and manually paste).
	private const string SavedPositionsFile = "serpinglin_map_positions.json";

	private class SavedLandmark { public string Id { get; set; } public float X { get; set; } public float Y { get; set; } public float Width { get; set; } }
	private class SavedZone { public string Id { get; set; } public float X { get; set; } public float Y { get; set; } }
	private class SavedTrade { public string Id { get; set; } public float X { get; set; } public float Y { get; set; } }
	private class SavedMini { public string Id { get; set; } public float X { get; set; } public float Y { get; set; } }
	private class MapPositionsData { public List<SavedLandmark> Landmarks { get; set; } = new(); public List<SavedZone> Zones { get; set; } = new(); public List<SavedTrade> TradeNodes { get; set; } = new(); public List<SavedMini> MiniExpeditions { get; set; } = new(); }

	/// <summary>
	/// Persist current landmark + zone positions to FileSystem.Data, AND dump
	/// them to the engine log so they can be pasted into the static arrays.
	/// </summary>
	private void PrintPositions()
	{
		// 1) Persist to disk so the next session loads them automatically
		var data = new MapPositionsData();
		foreach ( var lm in Landmarks )
		{
			var pos = GetLandmarkPos( lm );
			data.Landmarks.Add( new SavedLandmark { Id = lm.Id, X = pos.X, Y = pos.Y, Width = pos.Width } );
		}
		foreach ( var z in Zones )
		{
			var pos = GetZonePos( z );
			data.Zones.Add( new SavedZone { Id = z.Id, X = pos.X, Y = pos.Y } );
		}
		foreach ( var n in TradeNodeManager.Instance?.AllNodes ?? new System.Collections.Generic.List<TradeNode>() )
		{
			var pos = GetTradeNodePos( n );
			data.TradeNodes.Add( new SavedTrade { Id = n.Id, X = pos.X, Y = pos.Y } );
		}
		foreach ( var mx in GetMiniExpeditions() )
		{
			var pos = GetMiniPos( mx.Id );
			data.MiniExpeditions.Add( new SavedMini { Id = mx.Id, X = pos.X, Y = pos.Y } );
		}

		try
		{
			var json = System.Text.Json.JsonSerializer.Serialize( data, new System.Text.Json.JsonSerializerOptions { WriteIndented = true } );
			FileSystem.Data.WriteAllText( SavedPositionsFile, json );
			Log.Info( $"[MapEdit] Saved {data.Landmarks.Count} landmark(s) + {data.Zones.Count} zone(s) → FileSystem.Data/{SavedPositionsFile}" );
		}
		catch ( System.Exception ex )
		{
			Log.Warning( $"[MapEdit] Failed to write positions: {ex.Message}" );
		}

		// 2) Print to log for paste-back into the static arrays
		var sb = new System.Text.StringBuilder();
		sb.AppendLine();
		sb.AppendLine( "=== MAP POSITIONS — paste back into WorldMapPanel.razor ===" );
		sb.AppendLine( "Landmarks:" );
		foreach ( var lm in Landmarks )
		{
			var pos = GetLandmarkPos( lm );
			sb.AppendLine( $"  {lm.Id,-22}  X: {pos.X,5:0.0}f, Y: {pos.Y,5:0.0}f, Width: {pos.Width,4:0.0}f" );
		}
		sb.AppendLine();
		sb.AppendLine( "Zones:" );
		foreach ( var z in Zones )
		{
			var pos = GetZonePos( z );
			sb.AppendLine( $"  {z.Id,-22}  X: {pos.X,5:0.0}f, Y: {pos.Y,5:0.0}f" );
		}
		sb.AppendLine();
		sb.AppendLine( "Trade Nodes / Requests:" );
		foreach ( var n in TradeNodeManager.Instance?.AllNodes ?? new System.Collections.Generic.List<TradeNode>() )
		{
			var pos = GetTradeNodePos( n );
			sb.AppendLine( $"  {n.Id,-30}  MapPosX: {pos.X,5:0.0}f, MapPosY: {pos.Y,5:0.0}f" );
		}
		sb.AppendLine();
		sb.AppendLine( "Mini-Expeditions (paste into MiniPositions dict):" );
		foreach ( var mx in GetMiniExpeditions() )
		{
			var pos = GetMiniPos( mx.Id );
			sb.AppendLine( $"  {{ \"{mx.Id}\", ({pos.X:0.0}f, {pos.Y:0.0}f) }}," );
		}
		sb.AppendLine( "===========================================================" );
		Log.Info( sb.ToString() );
		SoundManager.PlaySuccess();
	}

	/// <summary>
	/// Load saved positions on panel init. If the file exists, populates
	/// the override dictionaries so the stored positions render immediately.
	/// </summary>
	private void LoadSavedPositions()
	{
		try
		{
			if ( !FileSystem.Data.FileExists( SavedPositionsFile ) ) return;
			var json = FileSystem.Data.ReadAllText( SavedPositionsFile );
			var data = System.Text.Json.JsonSerializer.Deserialize<MapPositionsData>( json );
			if ( data == null ) return;

			foreach ( var lm in data.Landmarks )
			{
				if ( string.IsNullOrEmpty( lm.Id ) ) continue;
				_landmarkOverrides[lm.Id] = (lm.X, lm.Y, lm.Width);
			}
			foreach ( var z in data.Zones )
			{
				if ( string.IsNullOrEmpty( z.Id ) ) continue;
				_zoneOverrides[z.Id] = (z.X, z.Y);
			}
			if ( data.TradeNodes != null )
			{
				foreach ( var t in data.TradeNodes )
				{
					if ( string.IsNullOrEmpty( t.Id ) ) continue;
					_tradeOverrides[t.Id] = (t.X, t.Y);
				}
			}
			if ( data.MiniExpeditions != null )
			{
				foreach ( var m in data.MiniExpeditions )
				{
					if ( string.IsNullOrEmpty( m.Id ) ) continue;
					_miniOverrides[m.Id] = (m.X, m.Y);
				}
			}
			Log.Info( $"[MapEdit] Loaded {data.Landmarks.Count} landmark(s) + {data.Zones.Count} zone(s) + {data.TradeNodes?.Count ?? 0} request(s) + {data.MiniExpeditions?.Count ?? 0} mini(s) from {SavedPositionsFile}" );
		}
		catch ( System.Exception ex )
		{
			Log.Warning( $"[MapEdit] Failed to load saved positions: {ex.Message}" );
		}
	}

	// ───────────────────── TRADE NODE HELPERS ─────────────────────

	/// <summary>
	/// Trade nodes / requests only show on the map after the player has
	/// cleared their host expedition at least once. Until then the zone's
	/// requests stay hidden — players discover them as a reward for
	/// progressing through expeditions.
	/// </summary>
	private IEnumerable<TradeNode> GetVisibleTradeNodes()
	{
		var mgr = TradeNodeManager.Instance;
		if ( mgr == null ) yield break;
		var em = ExpeditionManager.Instance;
		if ( em == null ) yield break;
		foreach ( var node in mgr.AllNodes )
		{
			if ( !em.HasClearedExpedition( node.ZoneId ) ) continue;
			yield return node;
		}
	}

