	// ── Art at INTEGER scale (DOC-6 #13) — the shop's recipe verbatim ──
	// Sources are 64×64 / 51×51 PNGs (the material placeholder is an svg →
	// fallback 64). Card max 100 → 1×; case slab max 256 → 4× 256 / 5× 255;
	// ghost max 160 → 2× 128 / 3× 153.
	private static readonly Dictionary<string, (int w, int h)> _artDims = new();

	private static (int w, int h) ArtDims( string path )
	{
		if ( string.IsNullOrEmpty( path ) ) return (64, 64);
		string key = path.TrimStart( '/' );
		if ( !_artDims.TryGetValue( key, out var d ) )
		{
			d = (64, 64);
			try
			{
				var tex = Texture.Load( FileSystem.Mounted, key );
				if ( tex != null && tex.Width > 0 && tex.Height > 0 ) d = (tex.Width, tex.Height);
			}
			catch { }
			_artDims[key] = d;
		}
		return d;
	}

	private static (int w, int h) ArtPx( string path, int max )
	{
		var d = ArtDims( path );
		int longest = Math.Max( d.w, d.h );
		int scale = Math.Max( 1, max / Math.Max( 1, longest ) );
		return (d.w * scale, d.h * scale);
	}

	// ============================================================
	// THE LIST — filter · sort · group. Render order is the ONE source the
	// grid, the keyboard cursor and the ring all walk.
	// ============================================================
	private int GetOwnedStackCount()
	{
		var inv = TamerManager.Instance?.CurrentTamer?.Inventory;
		if ( inv == null ) return 0;
		return inv.Count( kvp => kvp.Value > 0 && ItemManager.Instance?.GetItem( kvp.Key ) != null );
	}

	private static bool MatchesCategory( ItemDefinition item, string key ) => key switch
	{
		"consumable" => item.Category == ItemCategory.Consumable,
		"boost" => item.Category == ItemCategory.Boost,
		"held" => item.Category == ItemCategory.HeldItem,
		"relic" => item.Category == ItemCategory.Relic,
		"material" => item.Category == ItemCategory.Material,
		_ => true
	};

	private List<(string ItemId, int Quantity, ItemDefinition Def)> GetFilteredItems()
	{
		var inventory = TamerManager.Instance?.CurrentTamer?.Inventory;
		if ( inventory == null ) return new();

		var rows = new List<(string ItemId, int Quantity, ItemDefinition Def)>();
		foreach ( var kvp in inventory )
		{
			if ( kvp.Value <= 0 ) continue;
			var def = ItemManager.Instance?.GetItem( kvp.Key );
			if ( def == null ) continue;
			if ( !MatchesCategory( def, currentCategory ) ) continue;
			if ( !string.IsNullOrEmpty( searchQuery ) && !(def.Name ?? "").ToLower().Contains( searchQuery.ToLower() ) ) continue;
			rows.Add( (kvp.Key, kvp.Value, def) );
		}

		// Natural orders: recent = newest first (reverse insertion) · name =
		// A→Z · quantity / value / rarity = most first. SortAscending flips.
		IEnumerable<(string ItemId, int Quantity, ItemDefinition Def)> ordered = currentSort switch
		{
			"name" => rows.OrderBy( r => r.Def.Name ?? "" ),
			"quantity" => rows.OrderByDescending( r => r.Quantity ),
			"value" => rows.OrderByDescending( r => r.Def.SellPrice * r.Quantity ),
			"rarity" => rows.OrderByDescending( r => (int)r.Def.Rarity ),
			_ => Enumerable.Reverse( rows )
		};
		var list = ordered.ToList();
		if ( sortAscending ) list.Reverse();
		return list;
	}

	// Section order = the ruling: USE things · EQUIP things · SELL-only last.
	private static readonly (string Key, ItemCategory Cat)[] SectionOrder =
	{
		("consumable", ItemCategory.Consumable),
		("boost", ItemCategory.Boost),
		("held", ItemCategory.HeldItem),
		("relic", ItemCategory.Relic),
		("material", ItemCategory.Material),
	};

	private string SectionLabel( string key ) => key switch
	{
		"consumable" => L( "ui.inventory.consumables" ).ToUpperInvariant(),
		"boost" => L( "ui.inventory.boosts" ).ToUpperInvariant(),
		"held" => L( "ui.inventory.held_items" ).ToUpperInvariant(),
		"relic" => L( "ui.inventory.relics" ).ToUpperInvariant(),
		"material" => L( "ui.inventory.drops" ).ToUpperInvariant(),
		_ => key.ToUpperInvariant()
	};

	public class RenderGroup
	{
		public string Key { get; set; }
		public string Label { get; set; } // null = no kicker (a picked category)
		public List<(string ItemId, int Quantity)> Items { get; set; } = new();
	}

	private List<RenderGroup> GetRenderGroups()
	{
		var filtered = GetFilteredItems();
		var result = new List<RenderGroup>();
		if ( currentCategory != "all" )
		{
			result.Add( new RenderGroup { Key = currentCategory, Label = null, Items = filtered.Select( r => (r.ItemId, r.Quantity) ).ToList() } );
			return result;
		}
		foreach ( var (key, cat) in SectionOrder )
		{
			var items = filtered.Where( r => r.Def.Category == cat ).Select( r => (r.ItemId, r.Quantity) ).ToList();
			if ( items.Count == 0 ) continue;
			result.Add( new RenderGroup { Key = key, Label = SectionLabel( key ), Items = items } );
		}
		return result;
	}

	private List<(string ItemId, int Quantity)> GetNavItems()
	{
		var list = new List<(string ItemId, int Quantity)>();
		foreach ( var g in GetRenderGroups() ) list.AddRange( g.Items );
		return list;
	}

	private int GetRenderIndexOf( string itemId ) => GetNavItems().FindIndex( t => t.ItemId == itemId );

	// The case NEVER empties: the selection if it is still in the list, else
	// the first item in render order (no MarkItemSeen — a default is not a look).
	private ItemDefinition GetCaseItem()
	{
		var nav = GetNavItems();
		if ( nav.Count == 0 ) return null;
		if ( selectedItem != null && nav.Any( t => t.ItemId == selectedItem.Id ) ) return selectedItem;
		return ItemManager.Instance?.GetItem( nav[0].ItemId );
	}

	private int GetItemQuantity( string itemId ) => TamerManager.Instance?.CurrentTamer?.Inventory?.GetValueOrDefault( itemId, 0 ) ?? 0;
	private bool IsRelicEquipped( string itemId ) => TamerManager.Instance?.CurrentTamer?.EquippedRelics?.Contains( itemId ) ?? false;
	private string GetEffectDescription( ItemDefinition item ) => item?.GetEffectDescription() ?? "";
	private static bool IsInBattleMode() => BattleManager.Instance?.IsInBattle == true;

	// ============================================================
	// THE PRIMARY — one tuple per category (ghost-child law): USE · EQUIP TO...
	// · EQUIP / UNEQUIP · FULL; materials show none. `off` = same slab, dim.
	// ============================================================
	private (bool show, string label, string icon, bool off) GetPrimaryContent( ItemDefinition item )
	{
		if ( item == null ) return (false, "", "", true);
		switch ( item.Category )
		{
			case ItemCategory.Consumable:
			case ItemCategory.Boost:
				return (true, L( "ui.inventory.action_use" ).ToUpperInvariant(), "lucide:sparkles", !CanUse( item ));
			case ItemCategory.HeldItem:
				return (true, "EQUIP TO...", "lucide:link", IsInBattleMode());
			case ItemCategory.Relic:
				if ( IsRelicEquipped( item.Id ) ) return (true, L( "ui.inventory.action_unequip" ).ToUpperInvariant(), "lucide:unlink", IsInBattleMode());
				if ( IsInBattleMode() ) return (true, L( "ui.inventory.action_equip" ).ToUpperInvariant(), "lucide:lock", true);
				if ( !CanEquipRelic() ) return (true, L( "ui.inventory.action_full" ).ToUpperInvariant(), "lucide:x", true);
				return (true, L( "ui.inventory.action_equip" ).ToUpperInvariant(), "lucide:star", false);
			default:
				return (false, "", "", true);
		}
	}

	private bool CanUse( ItemDefinition item )
	{
		if ( item == null ) return false;
		if ( item.Category != ItemCategory.Consumable && item.Category != ItemCategory.Boost ) return false;
		if ( item.EffectType == ItemEffectType.MasterInk ) return false;
		return GetItemQuantity( item.Id ) > 0;
	}

	private bool NeedsTarget( ItemDefinition item ) =>
		item.EffectType == ItemEffectType.XPGrant
		|| item.EffectType == ItemEffectType.NatureChange
		|| item.EffectType == ItemEffectType.TraitReroll
		|| item.EffectType == ItemEffectType.GeneBoost;

	private bool CanEquipRelic()
	{
		if ( IsInBattleMode() ) return false;
		var relics = TamerManager.Instance?.CurrentTamer?.EquippedRelics;
		return relics == null || relics.Count < ItemManager.MaxRelics;
	}

	private bool CanSellItem( ItemDefinition item )
	{
		if ( item == null || item.SellPrice <= 0 ) return false;
		if ( IsInBattleMode() ) return false;
		if ( item.Category == ItemCategory.Relic && IsRelicEquipped( item.Id ) ) return false;
		return GetItemQuantity( item.Id ) > 0;
	}

	// Fires the case item's primary (BbButton OnClick + Space).
	private void ActivateSelectedItem()
	{
		var item = GetCaseItem();
		if ( item == null ) { SoundManager.PlayDeny(); return; }
		switch ( item.Category )
		{
			case ItemCategory.Consumable:
			case ItemCategory.Boost:
				UseItem( item );
				break;
			case ItemCategory.HeldItem:
				if ( IsInBattleMode() ) { SoundManager.PlayDeny(); return; }
				OpenPicker( item, PickerMode.Held );
				break;
			case ItemCategory.Relic:
				if ( IsInBattleMode() ) SoundManager.PlayDeny();
				else if ( IsRelicEquipped( item.Id ) ) UnequipRelic( item );
				else EquipRelic( item );
				break;
			default:
				SoundManager.PlayDeny();
				break;
		}
	}

	// USE — boosts fold into the consumable branch (UseItem / UseBoost
	// dispatch on the definition); targeted consumables open the picker.
	private void UseItem( ItemDefinition item )
	{
		if ( !CanUse( item ) ) { SoundManager.PlayDeny(); return; }

		if ( item.Category == ItemCategory.Boost )
		{
			var mgr = ItemManager.Instance;
			if ( mgr == null ) { SoundManager.PlayDeny(); return; }
			var result = mgr.UseBoost( item.Id );
			if ( result.Success ) SoundManager.PlaySuccess();
			else { ShowToast( result.Message, false ); SoundManager.PlayDeny(); }
			return;
		}

		if ( NeedsTarget( item ) ) { OpenPicker( item, PickerMode.Consumable ); return; }

		// In battle, route through BattleManager so the turn is consumed.
		if ( IsInBattleMode() && BattleManager.Instance != null )
		{
			if ( BattleManager.Instance.ExecutePlayerItem( item.Id, null ) ) { SoundManager.PlaySuccess(); Close(); }
			else SoundManager.PlayDeny();
			return;
		}

		if ( ItemManager.Instance?.UseItem( item.Id, null ) == true ) SoundManager.PlaySuccess();
		else { ShowToast( L( "ui.inventory.toast_failed" ), false ); SoundManager.PlayDeny(); }
	}

	private void EquipRelic( ItemDefinition item )
	{
		if ( item.Category != ItemCategory.Relic || !CanEquipRelic() ) { SoundManager.PlayDeny(); return; }
		if ( ItemManager.Instance?.EquipRelic( item.Id ) == true ) SoundManager.PlayForward();
		else { ShowToast( L( "ui.inventory.toast_failed" ), false ); SoundManager.PlayDeny(); }
	}

	private void UnequipRelic( ItemDefinition item )
	{
		if ( item == null || item.Category != ItemCategory.Relic ) return;
		if ( ItemManager.Instance?.UnequipRelic( item.Id ) == true ) SoundManager.PlayBack();
		else SoundManager.PlayDeny();
	}

	// ── Beast picker ─────────────────────────────────────────────
	private void OpenPicker( ItemDefinition item, PickerMode mode )
	{
		pendingItem = item;
		pickerMode = mode;
		showPicker = true;
		hoveredPickerRow = false;
		SoundManager.PlayClick();
	}

	private void ClosePicker()
	{
		showPicker = false;
		pendingItem = null;
		SoundManager.PlayBack();
	}

	private string PickerTitle()
	{
		if ( pendingItem == null ) return "";
		string name = (pendingItem.Name ?? "").ToUpperInvariant();
		return pickerMode == PickerMode.Held ? "EQUIP " + name + " TO..." : "USE " + name + " ON...";
	}

	private void OnPickerRowHover() { if ( IsKbMode || hoveredPickerRow ) return; hoveredPickerRow = true; SoundManager.PlayHover(); }
	private void OnPickerRowOut() => hoveredPickerRow = false;

	private void OnPickerRowClick( Monster monster )
	{
		hoveredPickerRow = false;
		if ( pickerMode == PickerMode.Held ) EquipHeldTo( monster );
		else UseConsumableOnMonster( monster );
	}

	private List<Monster> GetOwnedMonsters()
	{
		if ( IsInBattleMode() )
		{
			var party = BattleManager.Instance?.PlayerTeam;
			if ( party == null ) return new();
			return party.Where( m => m != null && m.CurrentHP > 0 ).ToList();
		}
		var monsters = MonsterManager.Instance?.OwnedMonsters;
		if ( monsters == null ) return new();
		return monsters.OrderByDescending( m => m.Level ).ToList();
	}

	private string GetMonsterSprite( Monster monster )
	{
		var species = MonsterManager.Instance?.GetSpecies( monster.SpeciesId );
		if ( species == null ) return "";
		if ( species.AnimationFrames != null && species.AnimationFrames.Count > 0 ) return species.AnimationFrames[0];
		return species.IconPath ?? "";
	}

	private string PickerSubText( Monster monster, MonsterSpecies species )
	{
		string lv = string.Format( L( "ui.inventory.level_fmt" ), monster.Level ).ToUpperInvariant();
		return species != null ? species.Name + " · " + lv : lv;
	}

	// ADD 3 — the ONE number the item is about to change: LEVEL for XP orbs ·
	// NATURE for runes · HOLDING for EQUIP TO... · nothing for rerolls / genes.
	private (string label, string value, bool dim) GetPickerDatum( Monster monster )
	{
		if ( pendingItem == null || monster == null ) return (null, "", false);
		if ( pickerMode == PickerMode.Held )
		{
			var held = string.IsNullOrEmpty( monster.HeldItemId ) ? null : ItemManager.Instance?.GetItem( monster.HeldItemId );
			return ("HOLDING", held != null ? held.Name.ToUpperInvariant() : "NOTHING HELD", held == null);
		}
		switch ( pendingItem.EffectType )
		{
			case ItemEffectType.XPGrant:
				return ("LEVEL", "LV " + monster.Level, false);
			case ItemEffectType.NatureChange:
				return ("NATURE", (monster.Genetics?.Nature.ToString() ?? "").ToUpperInvariant(), false);
			default:
				return (null, "", false);
		}
	}

	// EQUIP TO... — one call: EquipHeldItem swaps and returns the old item to the bag.
	private void EquipHeldTo( Monster monster )
	{
		if ( pendingItem == null || monster == null ) return;
		bool ok = ItemManager.Instance?.EquipHeldItem( monster, pendingItem.Id ) == true;
		if ( ok ) SoundManager.PlayForward();
		else { ShowToast( L( "ui.inventory.toast_failed" ), false ); SoundManager.PlayDeny(); }
		showPicker = false;
		pendingItem = null;
	}

	private void UseConsumableOnMonster( Monster monster )
	{
		if ( pendingItem == null || monster == null ) return;
		bool success = IsInBattleMode() && BattleManager.Instance != null
			? BattleManager.Instance.ExecutePlayerItem( pendingItem.Id, monster )
			: ItemManager.Instance?.UseItem( pendingItem.Id, monster ) == true;

		if ( success )
		{
			ShowToast( string.Format( L( "ui.inventory.toast_used" ), pendingItem.Name, monster.Nickname ), true );
			SoundManager.PlaySuccess();
			if ( IsInBattleMode() ) Close(); // the turn plays out
		}
		else
		{
			ShowToast( L( "ui.inventory.toast_failed" ), false );
			SoundManager.PlayDeny();
		}
		showPicker = false;
		pendingItem = null;
	}

	private void ShowToast( string message, bool success )
	{
		toastMessage = message ?? "";
		toastSuccess = success;
		toastExiting = false;
		toastTimer = ToastDuration;
	}

	// ── Sell — stepper + hold ────────────────────────────────────
	private void ChangeSellQty( int delta )
	{
		SetInputDevice( InputDevice.Mouse );
		var item = GetCaseItem();
		int max = item == null ? 1 : Math.Max( 1, GetItemQuantity( item.Id ) );
		int next = Math.Clamp( sellQty + delta, 1, max );
		if ( next == sellQty ) { SoundManager.PlayDeny(); return; }
		sellQty = next;
		SoundManager.PlayClick();
	}

	private void OnQtyHover() { if ( IsKbMode || hoveredQty ) return; hoveredQty = true; SoundManager.PlayHover(); }
	private void OnQtyOut() => hoveredQty = false;
	private void OnSellHover() { if ( IsKbMode || hoveredSell ) return; hoveredSell = true; SoundManager.PlayHover(); }

	private void StartHoldSell()
	{
		SetInputDevice( InputDevice.Mouse );
		var item = GetCaseItem();
		if ( item == null || !CanSellItem( item ) ) { SoundManager.PlayDeny(); return; }
		isHoldingSell = true;
		holdProgress = 0f;
		SoundManager.PlayClick();
	}

	private void StopHold()
	{
		isHoldingSell = false;
		holdProgress = 0f;
		hoveredSell = false;
		hoveredQty = false;
	}

	// ONE beat: SellItem(id, n) once → the balance ticks, the card's ×N steps
	// (or the card leaves and the case falls to its neighbour).
	private void SellSelectedItem()
	{
		var item = GetCaseItem();
		if ( item == null || !CanSellItem( item ) ) return;
		int n = Math.Clamp( sellQty, 1, Math.Max( 1, GetItemQuantity( item.Id ) ) );
		if ( ItemManager.Instance?.SellItem( item.Id, n ) == true )
		{
			SoundManager.PlayGoldReward();
			sellBeatVersion++;
			sellQty = 1;
		}
		else
		{
			ShowToast( L( "ui.inventory.toast_failed" ), false );
			SoundManager.PlayDeny();
		}
	}

	private void CheckGoldFlash()
	{
		int gold = GetGold();
		if ( lastGoldValue >= 0 && gold != lastGoldValue ) goldFlashUntil = RealTime.Now + 0.6f;
		lastGoldValue = gold;
	}

	// ============================================================
	// THE LIVING VIOLET RING — imperative position (the shop recipe), waving
	// via Style.Transform. Wraps the case item's card; self-hides when the
	// card scrolls out of the grid viewport (a root ring is never clipped).
	// ============================================================
	private int ringL, ringT, ringW = 152, ringH = 170;
	private bool ringVisible;
	private int ringWarm;
	private const int RingInset = 10; // card r16 + 10 → ring r26

	private List<Panel> CardPanels() => gridRef == null
		? new List<Panel>()
		: gridRef.Children.Where( c => c.HasClass( "sat-card" ) ).ToList();

	private Rect? ResolveRingHost()
	{
		if ( showPicker || gridRef == null ) return null;
		var gr = gridRef.Box.Rect;
		if ( gr.Width < 2f ) return null;
		foreach ( var c in gridRef.Children )
		{
			if ( !c.HasClass( "sat-card" ) || !c.HasClass( "selected" ) ) continue;
			var r = c.Box.Rect;
			if ( r.Top < gr.Top - 14f || r.Bottom > gr.Bottom + 14f ) return null;
			return r.Width < 2f ? (Rect?)null : r;
		}
		return null;
	}

	private void UpdateRing()
	{
		bool wasVisible = ringVisible;
		ringVisible = false;
		if ( !IsVisible ) return;

		var rr = Box.Rect;
		if ( rr.Width < 2f ) return;
		var host = ResolveRingHost();
		if ( host == null ) return;
		var cr = host.Value;

		float sc = ScaleFromScreen;
		if ( sc <= 0.01f || float.IsNaN( sc ) || float.IsInfinity( sc ) ) sc = 1f;

		// RING CENTERING LAW: Style.Left/Top place the PADDING box and the 4px
		// border draws outside it → L/T = host − inset + 4, W/H = host + 2·inset − 8.
		ringL = (int)((cr.Left - rr.Left) * sc) - RingInset + 4;
		ringT = (int)((cr.Top - rr.Top) * sc) - RingInset + 4;
		ringW = (int)(cr.Width * sc) + RingInset * 2 - 8;
		ringH = (int)(cr.Height * sc) + RingInset * 2 - 8;

		ringVisible = true;
		if ( !wasVisible ) ringWarm = 0;
		else if ( ringWarm < 2 ) ringWarm++;
	}

	private void ApplyRingWave()
	{
		if ( ringRef == null || !ringVisible ) return;
		float wt = Time.Now;
		float skX = (2.0f * MathF.Sin( wt * 2.2f ) + 0.7f * MathF.Sin( wt * 3.5f + 1.1f )) * 0.6f;
		float skY = (2.3f * MathF.Sin( wt * 1.8f + 1.9f ) + 0.9f * MathF.Sin( wt * 2.9f )) * 0.6f;
		float rotZ = (1.1f * MathF.Sin( wt * 1.0f ) + 0.5f * MathF.Sin( wt * 2.4f + 0.5f )) * 0.6f;
		float brX = 1f + 0.013f * MathF.Sin( wt * 1.35f + 0.7f ) + 0.006f * MathF.Sin( wt * 2.7f );
		float brY = 1f + 0.013f * MathF.Sin( wt * 1.15f + 2.6f ) + 0.006f * MathF.Sin( wt * 2.3f + 1.4f );

		var t = new PanelTransform();
		t.AddRotation( 0f, 0f, rotZ );
		t.AddSkew( skX, skY, 0f );
		t.AddScale( new Vector2( brX, brY ) );
		ringRef.Style.Transform = t;
	}

	// ============================================================
	// KB SCROLL-FOLLOW — the shop's glide recipe (DOC-5 #13).
	// ============================================================
	private bool _scrollFollowPending;
	private int _scrollFollowFrames;
	private float gridScrollGlideTarget = -1f;

	private void RequestScrollFollow() { _scrollFollowPending = true; _scrollFollowFrames = 0; }

	private void UpdateScrollFollow()
	{
		if ( gridRef == null ) return;
		if ( _scrollFollowPending )
		{
			if ( ++_scrollFollowFrames > 12 ) _scrollFollowPending = false;
			var c = GetCaseItem();
			int idx = c == null ? -1 : GetRenderIndexOf( c.Id );
			var panels = CardPanels();
			if ( idx >= 0 && idx < panels.Count && panels[idx].Box.Rect.Height > 1f )
			{
				_scrollFollowPending = false;
				var cur = panels[idx].Box.Rect;
				bool topRow = !panels.Any( p => p.Box.Rect.Top < cur.Top - 1f );
				bool bottomRow = !panels.Any( p => p.Box.Rect.Top > cur.Top + 1f );
				float curOff = gridRef.ScrollOffset.y;
				float? t;
				if ( topRow ) t = curOff > 0.5f ? 0f : null;
				else if ( bottomRow )
				{
					float max = Math.Max( 0f, gridRef.ScrollSize.y );
					t = Math.Abs( max - curOff ) > 0.5f ? max : null;
				}
				else t = UiGridScroll.ComputeOffset( gridRef, panels[idx] );
				if ( t.HasValue ) gridScrollGlideTarget = t.Value;
			}
		}

		if ( gridScrollGlideTarget < 0f ) return;
		float now = gridRef.ScrollOffset.y;
		float delta = gridScrollGlideTarget - now;
		if ( Math.Abs( delta ) < 1.5f )
		{
			gridRef.ScrollOffset = new Vector2( gridRef.ScrollOffset.x, gridScrollGlideTarget );
			gridScrollGlideTarget = -1f;
			return;
		}
		gridRef.ScrollOffset = new Vector2( gridRef.ScrollOffset.x, now + delta * 0.30f );
	}

	// ============================================================
	// OVERLAY SCROLLBAR — the roster UpdateScrollbar recipe (read-only thumb,
	// imperative Style writes, only-on-change caches).
	// ============================================================
	private int _sbTop = int.MinValue, _sbH = int.MinValue, _sbTrackH = int.MinValue;
	private Panel _sbSeen;

	private void UpdateScrollbar()
	{
		if ( !ReferenceEquals( _sbSeen, sbThumbRef ) ) { _sbSeen = sbThumbRef; _sbTop = _sbH = _sbTrackH = int.MinValue; }
		var scroll = gridRef;
		var track = sbTrackRef;
		var thumb = sbThumbRef;
		if ( track == null || thumb == null ) return;

		float maxOff = scroll?.ScrollSize.y ?? 0f;
		float viewH = scroll?.Box.Rect.Height ?? 0f;
		if ( scroll == null || maxOff < 2f || viewH <= 0f ) { track.SetClass( "on", false ); return; }

		float sc = ScaleFromScreen;
		if ( sc <= 0.01f || float.IsNaN( sc ) || float.IsInfinity( sc ) ) sc = 1f;

		int trackH = (int)(viewH * sc) - 16;
		if ( trackH < 40 ) { track.SetClass( "on", false ); return; }

		float contentH = viewH + maxOff;
		int h = Math.Max( 24, (int)(trackH * (viewH / contentH)) );
		float t01 = Math.Clamp( scroll.ScrollOffset.y / maxOff, 0f, 1f );
		int top = (int)((trackH - h) * t01);

		if ( trackH != _sbTrackH ) { _sbTrackH = trackH; track.Style.Height = Length.Pixels( trackH ); }
		if ( h != _sbH ) { _sbH = h; thumb.Style.Height = Length.Pixels( h ); }
		if ( top != _sbTop ) { _sbTop = top; thumb.Style.Top = Length.Pixels( top ); }
		track.SetClass( "on", true );
	}

	// ============================================================
	// KEYBOARD — polled from Tick while this panel is the top modal (the Bag
	// is an overlay, not a tab: GameHUD does not route TickInput here).
	//   Q            close (an open FilterBar menu / the picker eats it first)
	//   WASD/arrows  the ONE cursor across the true-2D grid (kicker rows are
	//                not stops; clamped, no wrap)
	//   Space/Enter  the case item's primary
	//   R            category forward (shown cap) · Z/X sort cycle (silent)
	// LANE: input — header walk-up (W off the top row → the FilterBar's
	// category chip via CollectHeaderControls), the CASE zone (D off a row's
	// last card → primary ↔ stepper ↔ SELL hold), picker W/S/Space, and the
	// two-stage Q are not wired here.
	// ============================================================
	private void TickInput()
	{
		if ( ChatPanel.IsChatFocused ) return;
		if ( filterBar != null && filterBar.IsSearchFocused ) return; // typing in the search chip

		// A FilterBar menu owns W/S/Space/Q while open.
		if ( filterBar != null && filterBar.IsAnyDropdownOpen && filterBar.HandleKeyboard() ) { SetInputDevice( InputDevice.Keyboard ); return; }

		if ( showPicker )
		{
			if ( Input.Pressed( "Menu" ) ) { ClosePicker(); GameHUD.PanelHandledBackKey = true; }
			return; // LANE: input — picker rows are mouse-only until the kb pass
		}

		if ( Input.Pressed( "Menu" ) ) { Close(); return; }

		if ( Input.Pressed( "Reload" ) ) { SetInputDevice( InputDevice.Keyboard ); CycleCategory( 1 ); return; }
		if ( Input.Pressed( "CyclePrev" ) ) { SetInputDevice( InputDevice.Keyboard ); CycleSort( -1 ); return; }
		if ( Input.Pressed( "CycleNext" ) ) { SetInputDevice( InputDevice.Keyboard ); CycleSort( 1 ); return; }

		int dir = -1; // 0 up · 1 down · 2 left · 3 right
		if ( Input.Pressed( "Up" ) ) dir = 0;
		else if ( Input.Pressed( "Down" ) ) dir = 1;
		else if ( Input.Pressed( "Left" ) ) dir = 2;
		else if ( Input.Pressed( "Right" ) ) dir = 3;
		bool confirm = UiInput.ConfirmPressed();
		if ( dir < 0 && !confirm ) return;

		SetInputDevice( InputDevice.Keyboard );

		if ( confirm ) { ActivateSelectedItem(); return; }

		var nav = GetNavItems();
		if ( nav.Count == 0 ) return;
		var caseItem = GetCaseItem();
		int idx = caseItem == null ? -1 : GetRenderIndexOf( caseItem.Id );
		if ( idx < 0 ) { SelectIndex( nav, 0 ); return; }

		int n = dir switch
		{
			2 => GetHorizontalNeighbor( idx, nav.Count, false ),
			3 => GetHorizontalNeighbor( idx, nav.Count, true ),
			0 => GetVerticalNeighbor( idx, nav.Count, false ),
			_ => GetVerticalNeighbor( idx, nav.Count, true ),
		};
		if ( n >= 0 ) SelectIndex( nav, n );
	}

	private void SelectIndex( List<(string ItemId, int Quantity)> nav, int idx )
	{
		if ( idx < 0 || idx >= nav.Count ) return;
		var def = ItemManager.Instance?.GetItem( nav[idx].ItemId );
		if ( def == null ) return;
		SelectItem( def, silent: true );
		SoundManager.PlayHover();
		RequestScrollFollow();
	}

	// TRUE-2D steps — the shop's geometry-honest neighbours (kicker rows are
	// not cards, so W/S skip them; A/D stay in the row). -1 = the edge.
	private int GetVerticalNeighbor( int idx, int itemCount, bool down )
	{
		var panels = CardPanels();
		if ( panels.Count != itemCount || idx < 0 || idx >= panels.Count ) return -1;
		var cur = panels[idx].Box.Rect;
		float curCentreX = cur.Left + cur.Width * 0.5f;
		int best = -1;
		float bestRowDist = float.MaxValue, bestDX = float.MaxValue;
		for ( int i = 0; i < panels.Count; i++ )
		{
			if ( i == idx ) continue;
			var r = panels[i].Box.Rect;
			if ( down ? r.Top <= cur.Top + 1f : r.Top >= cur.Top - 1f ) continue;
			float rowDist = Math.Abs( r.Top - cur.Top );
			float dx = Math.Abs( (r.Left + r.Width * 0.5f) - curCentreX );
			if ( rowDist < bestRowDist - 1f || (rowDist <= bestRowDist + 1f && dx < bestDX) ) { best = i; bestRowDist = rowDist; bestDX = dx; }
		}
		return best;
	}

	private int GetHorizontalNeighbor( int idx, int itemCount, bool right )
	{
		var panels = CardPanels();
		if ( panels.Count != itemCount || idx < 0 || idx >= panels.Count )
		{
			int flat = right ? idx + 1 : idx - 1;
			return flat >= 0 && flat < itemCount ? flat : -1;
		}
		var cur = panels[idx].Box.Rect;
		int best = -1;
		float bestDX = float.MaxValue;
		for ( int i = 0; i < panels.Count; i++ )
		{
			if ( i == idx ) continue;
			var r = panels[i].Box.Rect;
			if ( Math.Abs( r.Top - cur.Top ) > 1f ) continue;
			float dx = right ? r.Left - cur.Left : cur.Left - r.Left;
			if ( dx <= 1f || dx >= bestDX ) continue;
			best = i;
			bestDX = dx;
		}
		return best;
	}

	// ============================================================
	// TICK
	// ============================================================
	public override void Tick()
	{
		base.Tick();

		if ( IsVisible && UIModalState.IsTopModal( "InventoryPanel" ) ) TickInput();

		// Battle open → land on CONSUMABLES (the rest of the grid dims .45).
		if ( _pendingBattleCategory != null )
		{
			currentCategory = _pendingBattleCategory;
			_pendingBattleCategory = null;
		}

		ApplyDevPending();
		UpdateScrollFollow();
		UpdateRing();
		ApplyRingWave();
		UpdateScrollbar();

		// Hold-to-sell — 0.5s to commit; release resets.
		if ( isHoldingSell )
		{
			holdProgress += Time.Delta / HoldDuration;
			if ( holdProgress >= 1f )
			{
				holdProgress = 0f;
				isHoldingSell = false;
				SellSelectedItem();
			}
		}

		// Toast countdown — the exit class 0.3s before clear.
		if ( toastTimer > 0f )
		{
			toastTimer -= Time.Delta;
			if ( toastTimer <= 0.3f && !toastExiting ) toastExiting = true;
			if ( toastTimer <= 0f ) { toastTimer = 0f; toastMessage = ""; toastSuccess = false; toastExiting = false; }
		}
	}

	// ============================================================
	// DEV HOOK — `dev_bag [category|<itemId>]` opens the bag and parks the
	// case (screenshot instrument; the dev_shop pattern).
	//   dev_bag                  → open the bag
	//   dev_bag relic            → open on the RELICS category
	//   dev_bag held_ember_fang  → open ALL, select that item
	// REMOVE after the redesign is user-approved.
	// ============================================================
	private static string _devPending;

	[ConCmd( "dev_bag" )]
	public static void DevOpenBag( string arg = "" )
	{
		var gm = Beastborne.Core.GameManager.Instance;
		if ( gm != null && !gm.IsInGame ) gm.StartGame();
		PhoneLauncher.Close();
		if ( !IsVisible ) Show();
		_devPending = arg ?? "";
		Log.Info( $"[Bag] dev_bag → '{_devPending}'" );
	}

	private void ApplyDevPending()
	{
		if ( _devPending == null ) return;
		if ( Box.Rect.Width < 2f ) return;
		string arg = _devPending;
		_devPending = null;

		if ( string.IsNullOrEmpty( arg ) ) { SetCategory( "all" ); return; }
		if ( Array.IndexOf( CategoryCycle, arg ) >= 0 ) { SetCategory( arg ); return; }
		var def = ItemManager.Instance?.GetItem( arg );
		if ( def != null && GetItemQuantity( arg ) > 0 ) { SetCategory( "all" ); SelectItem( def, silent: true ); RequestScrollFollow(); return; }
		Log.Warning( $"[Bag] dev_bag: no owned item or category '{arg}'" );
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add( IsVisible );
		hash.Add( currentCategory );
		hash.Add( currentSort );
		hash.Add( sortAscending );
		hash.Add( searchQuery );
		hash.Add( selectedItem?.Id );
		hash.Add( sellQty );
		hash.Add( isHoldingSell );
		hash.Add( (int)(holdProgress * 100) );
		hash.Add( toastMessage );
		hash.Add( toastExiting );
		hash.Add( showPicker );
		hash.Add( pendingItem?.Id );
		hash.Add( IsInBattleMode() );
		hash.Add( GetGold() );
		CheckGoldFlash();
		hash.Add( IsGoldFlash );
		hash.Add( sellBeatVersion );
		// NEW stamps (one source) + the search chip's focus rim
		hash.Add( ItemManager.Instance?.NewItemCount ?? 0 );
		hash.Add( filterBar != null && filterBar.IsSearchFocused );
		// Living ring — markup-bound position + visibility class
		hash.Add( ringL );
		hash.Add( ringT );
		hash.Add( ringW );
		hash.Add( ringH );
		hash.Add( ringVisible );
		hash.Add( ringWarm < 2 );
		// One-device flag (root class)
		hash.Add( lastInputDevice );

		var relics = TamerManager.Instance?.CurrentTamer?.EquippedRelics;
		if ( relics != null ) foreach ( var r in relics ) hash.Add( r );

		var inventory = TamerManager.Instance?.CurrentTamer?.Inventory;
		if ( inventory != null )
		{
			foreach ( var kvp in inventory ) { hash.Add( kvp.Key ); hash.Add( kvp.Value ); }
		}

		// Held items move between beasts (EQUIP TO...) — the picker's HOLDING column.
		if ( showPicker && pickerMode == PickerMode.Held )
		{
			var owned = MonsterManager.Instance?.OwnedMonsters;
			if ( owned != null ) foreach ( var m in owned ) hash.Add( m.HeldItemId );
		}

		return hash.ToHashCode();
	}
}
