	// R cycles category in DOM order (ALL is a stop); Z/X cycle the sort silently.
	private static readonly string[] CategoryCycle = { "all", "consumable", "boost", "held", "relic", "material" };
	private static readonly string[] SortCycle = { "recent", "name", "quantity", "value", "rarity" };

	private void OnCategoryChanged( string key ) { SetCategory( key ); }
	private void OnSortChanged( string key ) { currentSort = key; RequestScrollFollow(); }
	private void OnSortDirectionChanged( bool asc ) { sortAscending = asc; RequestScrollFollow(); }
	private void OnSearchChanged( string text ) { searchQuery = text ?? ""; RequestScrollFollow(); }

	private void SetCategory( string key )
	{
		if ( currentCategory == key ) return;
		currentCategory = key;
		sellQty = 1;
		RequestScrollFollow();
	}

	private void CycleCategory( int dir )
	{
		int idx = Array.IndexOf( CategoryCycle, currentCategory );
		idx = idx < 0 ? 0 : (idx + dir + CategoryCycle.Length) % CategoryCycle.Length;
		SetCategory( CategoryCycle[idx] );
		filterBar?.CloseAllDropdowns();
		SoundManager.PlayTabSwitch();
	}

	private void CycleSort( int dir )
	{
		int idx = Array.IndexOf( SortCycle, currentSort );
		idx = idx < 0 ? 0 : (idx + dir + SortCycle.Length) % SortCycle.Length;
		currentSort = SortCycle[idx];
		filterBar?.CloseAllDropdowns();
		RequestScrollFollow();
		SoundManager.PlayClick();
	}

	// ── Selection — hover IS selection in mouse mode (the shop's grammar) ──
	private void SelectItem( ItemDefinition item, bool silent )
	{
		if ( item == null ) return;
		if ( selectedItem?.Id != item.Id )
		{
			selectedItem = item;
			sellQty = 1;
			StopHold();
		}
		// NEW = one source: an inspected item is a seen item.
		ItemManager.Instance?.MarkItemSeen( item.Id );
		if ( !silent ) SoundManager.PlaySelect();
	}

	private void OnCardHover( ItemDefinition item )
	{
		if ( IsKbMode || item == null ) return;
		if ( hoveredCardId == item.Id ) return;
		hoveredCardId = item.Id;
		SoundManager.PlayHover();
		SelectItem( item, silent: true );
	}

	private void OnCardClick( ItemDefinition item )
	{
		SetInputDevice( InputDevice.Mouse );
		SelectItem( item, silent: true );
		SoundManager.PlayClick();
	}

