@namespace Beastborne.UI.Panels
@using Sandbox;
@using Sandbox.UI;
@using Beastborne.Core;
@using Beastborne.Data;
@using Beastborne.Systems;
@using Beastborne.UI;
@using Beastborne.UI.Components;
@using Beastborne.UI.Primitives;
@inherits Panel

<root class="inventory-panel @(IsVisible ? "visible" : "")">

	<!-- ====== LEFT SPINE — identity + category pouch tabs ====== -->
	<div class="sat-spine">
		<div class="sat-ident">
			<BbSectionHeader Kicker="FIELD SATCHEL" Title=@L("ui.inventory.title") Size=@(52) AccentColor="#d9a054" />
		</div>

		@if (IsInBattleMode())
		{
			<div class="sat-battle-stamp">
				<BbStamp Text=@L("ui.inventory.battle_mode") Tone="orange" Dot=@true Tilt=@(3) />
			</div>
		}

		<div class="sat-spine-tabs">
			@for (int t = 0; t < CategoryKeyOrder.Length; t++)
			{
				var cat = CategoryKeyOrder[t];
				var capNum = t + 1;
				<div class="sat-tab @(currentCategory == cat ? "active" : "")" onclick=@(() => SetCategory(cat))>
					<span class="tab-cap">@capNum</span>
					<span class="tab-label">@GetCategoryTabLabel(cat)</span>
					@if (GetCategoryTabCount(cat) > 0)
					{
						<span class="tab-count">@GetCategoryTabCount(cat)</span>
					}
				</div>
			}
		</div>

		<div class="sat-gold">
			<img class="sat-gold-icon" src="ui/icons/currency/money.svg" />
			<span class="sat-gold-value">@GoldText()</span>
		</div>
		<span class="sat-hint">WASD MOVE · SPACE USE</span>
	</div>

	<!-- ====== CENTER — find tools + the open item spread ====== -->
	<div class="sat-center">
		<div class="sat-tools">
			<div class="sat-search">
				<iconify icon="lucide:search" Size=@(13) Color="rgba(214, 206, 236, 0.45)" />
				<TextEntry class="search-input" @ref="searchInput" Text="@searchQuery" Placeholder="@L("ui.inventory.search")" />
			</div>

			@foreach (var r in RarityKeys)
			{
				<button class="sat-rchip r-@r @(currentRarityFilter == r ? "active" : "")" onclick=@(() => SetRarityFilter(r))>
					<div class="rchip-dot"></div>
					<span class="rchip-label">@GetRarityChipLabel(r)</span>
				</button>
			}

			<div class="sat-tools-div"></div>

			<button class="sat-sort-chip @(currentSort == "name" ? "active" : "")" onclick=@(() => SetSort("name"))><span>@L("ui.inventory.sort_name")</span></button>
			<button class="sat-sort-chip @(currentSort == "qty" ? "active" : "")" onclick=@(() => SetSort("qty"))><span>@L("ui.inventory.sort_qty")</span></button>
			<button class="sat-sort-chip @(currentSort == "rarity" ? "active" : "")" onclick=@(() => SetSort("rarity"))><span>@L("ui.inventory.sort_rarity")</span></button>
		</div>

		<!-- Item grid. Cards are DIRECT children of the scroll container
		     (scroll-container law: no nested flex-row wrappers). Section
		     label rows span full width to force wrap breaks. -->
		<div class="sat-grid" @ref="satGridRef">
			@foreach (var group in GetRenderGroups())
			{
				@if (group.Label != null)
				{
					<div class="sat-section-row"><span class="sat-section-text">@group.Label</span></div>
				}
				@foreach (var (itemId, quantity) in group.Items)
				{
					var item = ItemManager.Instance?.GetItem(itemId);
					if (item == null) continue;
					<div class="sat-card @GetRarityClass(item.Rarity) @(selectedItem?.Id == itemId ? "selected" : "")"
						 onclick=@(() => SelectItem(item))
						 onmouseover=@(() => OnCardHover(itemId))>
						<div class="sat-card-art">
							<img class="sat-card-icon" src="@item.IconPath" onerror="this.style.display='none'" />
						</div>
						<div class="sat-card-foot"><span class="sat-card-name">@item.Name</span></div>
						<div class="sat-strip r-@GetRarityClass(item.Rarity)"></div>
						@if (quantity > 1)
						{
							<div class="sat-qty"><span>@QtyText(quantity)</span></div>
						}
						@if (IsEquipped(itemId))
						{
							<div class="sat-equipped"><span>E</span></div>
						}
						else if (IsNewItem(itemId))
						{
							<div class="sat-new @NewTiltClass(itemId)"><span>NEW</span></div>
						}
						<div class="sat-hover-ring"></div>
					</div>
				}
			}

			@if (GetFilteredItems().Count == 0)
			{
				<div class="empty-inventory">
					<iconify icon="lucide:package-x" Size=@(64) Color="rgba(214, 206, 236, 0.25)" />
					<span class="empty-headline">@L("ui.inventory.no_items_found")</span>
					<span class="empty-hint">@L("ui.inventory.empty_hint")</span>
				</div>
			}
		</div>
	</div>

	<!-- ====== RIGHT — inspection card + relic loadout ====== -->
	<div class="sat-right">
		<div class="sat-close-row">
			<span class="sat-cap">Q</span>
			<button class="sat-close" onclick=@Close>
				<iconify icon="lucide:x" Size=@(18) Color="rgba(244, 241, 234, 0.85)" />
			</button>
		</div>

		<div class="sat-detail @(selectedItem != null ? "has-item" : "")">
			@if (selectedItem != null)
			{
				<div class="sat-hero">
					<img class="sat-hero-img" src="@selectedItem.IconPath" onerror="this.style.display='none'" />
					<div class="sat-hero-strip r-@GetRarityClass(selectedItem.Rarity)"></div>
				</div>

				<span class="sat-detail-name">@selectedItem.Name</span>
				<div class="sat-detail-meta">
					<div class="sat-rarity-pill @GetRarityClass(selectedItem.Rarity)"><span>@selectedItem.Rarity</span></div>
					@if (GetItemQuantity(selectedItem.Id) > 0)
					{
						<span class="sat-detail-qty">@QtyText(GetItemQuantity(selectedItem.Id))</span>
					}
					@if (selectedItem.EffectDuration > 0)
					{
						<span class="sat-detail-duration">@DurationText()</span>
					}
				</div>

				<div class="sat-effect">
					<span class="sat-effect-kicker">@L("ui.inventory.effect_label")</span>
					<span class="sat-effect-text">@GetEffectDescription(selectedItem)</span>
				</div>

				<div class="sat-actions">
					@if (selectedItem.Category == ItemCategory.Consumable)
					{
						<BbButton Tier="primary" Size=@(56) Label=@L("ui.inventory.action_use") KeyCap="SPACE"
								  Disabled=@(!CanUseConsumable(selectedItem)) OnClick=@UseSelected />
					}
					else if (selectedItem.Category == ItemCategory.Relic)
					{
						@if (IsInBattleMode())
						{
							<span class="sat-action-hint">@L("ui.inventory.locked_in_battle")</span>
						}
						else if (IsRelicEquipped(selectedItem.Id))
						{
							<BbButton Tier="danger" Size=@(44) Label=@L("ui.inventory.action_unequip") OnClick=@UnequipSelected />
						}
						else
						{
							<BbButton Tier="primary" Size=@(56) Label=@EquipLabel() KeyCap="SPACE"
									  Disabled=@(!CanEquipRelic()) OnClick=@EquipSelected />
						}
					}
					else if (selectedItem.Category == ItemCategory.HeldItem)
					{
						<span class="sat-action-hint">@L("ui.inventory.held_hint")</span>
					}
					else if (selectedItem.Category == ItemCategory.Boost)
					{
						<BbButton Tier="primary" Size=@(56) Label=@L("ui.inventory.action_use") KeyCap="SPACE"
								  Disabled=@(!CanUseBoost(selectedItem)) OnClick=@BoostSelected />
					}

					@if (selectedItem.SellPrice > 0 && CanSellItem(selectedItem))
					{
						<button class="sat-sell @(isHoldingSell ? "holding" : "")"
								onmousedown=@StartHoldSell
								onmouseup=@StopHold
								onmouseleave=@StopHold>
							<div class="sat-sell-fill" style="width: @(SellFillPct())%;"></div>
							<span class="sat-sell-label">@GetSellLabel()</span>
							<span class="sat-sell-hold">HOLD</span>
						</button>
					}
				</div>
			}
			else
			{
				<EmptyState Icon="lucide:package-2"
							Title=@L("ui.inventory.no_selection")
							Size="inline" />
			}
		</div>

		<!-- Relic loadout — its own slab, always present -->
		<div class="sat-relics">
			<span class="sat-section-label">@L("ui.inventory.equipped_relics")</span>
			<div class="relics-slots-row">
				@for (int i = 0; i < 3; i++)
				{
					var relicId = GetEquippedRelic(i);
					var relic = relicId != null ? ItemManager.Instance?.GetItem(relicId) : null;
					<div class="relic-slot @(relic != null ? "filled " + GetRarityClass(relic.Rarity) : "empty") @(selectedItem?.Id == relicId ? "selected" : "") @(justEquippedSlot == i ? "just-equipped" : "")"
						 onclick=@(() => OnRelicSlotClick(relicId))>
						@if (relic != null)
						{
							<img class="relic-slot-icon" src="@relic.IconPath" onerror="this.style.display='none'" />
							<span class="relic-slot-name">@relic.Name</span>
						}
						else
						{
							<span class="relic-slot-plus">+</span>
						}
					</div>
				}
			</div>
		</div>
	</div>

	<!-- THE LIVING VIOLET RING — the one waving selection cursor, wrapping
	     the selected item card. Root-level absolute so the per-frame wave
	     never dirties the grid; position bound from UpdateGridRing each
	     tick, wave via imperative Style.Transform (roster recipe). -->
	<div @ref="gridRingRef" class="sat-ring @(ringVisible ? "on" : "") @(ringWarm < 2 ? "snap" : "")"
		 style="left: @(ringL)px; top: @(ringT)px; width: @(ringW)px; height: @(ringH)px;"></div>

	<!-- Monster Picker for consumables that need a target -->
	@if (showMonsterPicker && pendingConsumable != null)
	{
		<div class="monster-picker-overlay" onclick=@CloseMonsterPicker>
			<div class="monster-picker-panel" onclick:stopPropagation>
				<div class="picker-header">
					<div class="picker-seam"><span class="picker-title">@L("ui.inventory.picker_title")</span></div>
					<span class="picker-subtitle">@string.Format(L("ui.inventory.picker_subtitle"), pendingConsumable.Name)</span>
					<button class="picker-close" onclick=@CloseMonsterPicker>
						<iconify icon="lucide:x" Size=@(16) Color="rgba(244, 241, 234, 0.85)" />
					</button>
				</div>
				<div class="picker-scroll">
					@{ var pickerMonsters = GetOwnedMonsters(); }
					@for (int rowStart = 0; rowStart < pickerMonsters.Count; rowStart += 2)
					{
						<div class="picker-row">
							@for (int col = 0; col < 2 && rowStart + col < pickerMonsters.Count; col++)
							{
								var monster = pickerMonsters[rowStart + col];
								var species = MonsterManager.Instance?.GetSpecies(monster.SpeciesId);
								<div class="picker-monster" onclick=@(() => UseConsumableOnMonster(monster))>
									<div class="picker-monster-sprite">
										@if (species != null && !string.IsNullOrEmpty(species.IconPath))
										{
											<img src="@GetMonsterSprite(monster)" onerror="this.style.display='none'" />
										}
										else
										{
											<span class="sprite-placeholder">?</span>
										}
									</div>
									<div class="picker-monster-info">
										<span class="picker-monster-name">@monster.Nickname</span>
										<span class="picker-monster-level">@string.Format(L("ui.inventory.level_fmt"), monster.Level)</span>
									</div>
								</div>
							}
						</div>
					}
				</div>
			</div>
		</div>
	}

	<!-- Unified toast -->
	@if (!string.IsNullOrEmpty(toastMessage))
	{
		<div class="inventory-toast @(toastSuccess ? "success" : "error") @(toastExiting ? "exiting" : "")">
			<span>@toastMessage</span>
		</div>
	}
</root>

@code {
	private string L( string key ) => LocalizationManager.Get( key );
	private string L( string key, params object[] args ) => LocalizationManager.Get( key, args );

	public static bool IsVisible { get; set; } = false;
	private string currentCategory = "all";
	private ItemDefinition selectedItem;
	private string currentRarityFilter = "all";
	private string currentSort = "default";
	private string searchQuery = "";
	private TextEntry searchInput;

	// Hold-to-sell state
	private bool isHoldingSell = false;
	private float holdProgress = 0f;
	private const float HoldDuration = 0.5f;

	// Unified toast
	private string toastMessage = "";
	private bool toastSuccess = false;
	private float toastTimer = 0f;
	private const float ToastDuration = 3f;

	// Monster picker for consumables
	private bool showMonsterPicker = false;
	private ItemDefinition pendingConsumable = null;

	// Hover debounce — only play hover sound when moving to a DIFFERENT card
	private string lastHoveredItemId = null;

	// Equip flash — set slot index on equip, cleared after 0.6s
	private int justEquippedSlot = -1;
	private float justEquippedTimer = 0f;

	// Toast exit animation
	private bool toastExiting = false;

	private static string _pendingBattleCategory = null;

	// ── NEW-item tracking (session-local) ────────────────────────────────
	// Seeded with the full inventory on first open so nothing screams NEW
	// on a fresh session; items acquired AFTER that get a tilted NEW stamp
	// until the player selects (inspects) them.
	private static HashSet<string> _seenItemIds = new();
	private static bool _seenSeeded = false;

	private static void SeedSeenIfNeeded()
	{
		if (_seenSeeded) return;
		var inv = TamerManager.Instance?.CurrentTamer?.Inventory;
		if (inv == null) return;
		foreach (var k in inv.Keys) _seenItemIds.Add(k);
		_seenSeeded = true;
	}

	private bool IsNewItem(string itemId) => _seenSeeded && !_seenItemIds.Contains(itemId);
	private void MarkSeen(string itemId) { if (_seenSeeded && !string.IsNullOrEmpty(itemId)) _seenItemIds.Add(itemId); }
	// Stable per-item tilt so the stamps read hand-placed, not uniform.
	private string NewTiltClass(string itemId) => (itemId?.GetHashCode() & 1) == 0 ? "tilt-neg" : "tilt-pos";

	public static void Show()
	{
		IsVisible = true;
		SeedSeenIfNeeded();
		if (IsInBattleMode()) _pendingBattleCategory = "consumable";
		SoundManager.PlayPopup();
	}
	public static void Close() { IsVisible = false; SoundManager.PlayPopdown(); }
	public static void Toggle()
	{
		IsVisible = !IsVisible;
		if (IsVisible)
		{
			SeedSeenIfNeeded();
			if (IsInBattleMode()) _pendingBattleCategory = "consumable";
			SoundManager.PlayPopup();
		}
		else
		{
			SoundManager.PlayPopdown();
		}
	}

	private void SetCategory(string category)
	{
		currentCategory = category;
		selectedItem = null;
		SoundManager.PlayTabSwitch();
	}

	private void SetRarityFilter(string rarity)
	{
		currentRarityFilter = rarity;
		selectedItem = null;
		SoundManager.PlayTabSwitch();
	}

	private void SetSort(string sort)
	{
		currentSort = currentSort == sort ? "default" : sort;
		SoundManager.PlayClick();
	}

	private void SelectItem(ItemDefinition item)
	{
		selectedItem = item;
		MarkSeen(item?.Id);
		SoundManager.PlaySelect();
	}

	// ────────────────────── DISPLAY HELPERS ──────────────────────
	// No $"..." interpolation in markup (razor generator law) — every
	// dynamic string is computed here and bound with @Helper().

	private string GoldText() => (TamerManager.Instance?.CurrentTamer?.Gold ?? 0).ToString("N0");
	private string QtyText(int qty) => "x" + qty;
	private string DurationText() => selectedItem == null ? "" : selectedItem.EffectDuration + " waves";
	private string GetSellLabel() => selectedItem == null ? "" : (isHoldingSell ? "..." : "SELL · " + selectedItem.SellPrice.ToString("N0") + "G");
	private int SellFillPct() => isHoldingSell ? (int)(holdProgress * 100) : 0;
	private string EquipLabel() => CanEquipRelic() ? L("ui.inventory.action_equip") : L("ui.inventory.action_full");

	private string GetCategoryTabLabel(string cat) => cat switch
	{
		"all" => L("ui.inventory.all_items"),
		"consumable" => L("ui.inventory.consumables"),
		"relic" => L("ui.inventory.relics"),
		"held" => L("ui.inventory.held_items"),
		"boost" => L("ui.inventory.boosts"),
		"material" => L("ui.inventory.drops"),
		"quest" => L("ui.inventory.quest"),
		_ => cat
	};

	private int GetCategoryTabCount(string cat) => cat == "all" ? GetTotalItemCount() : GetCategoryItemCount(cat);

	private static readonly string[] RarityKeys = { "all", "common", "uncommon", "rare", "epic", "legendary" };
	private string GetRarityChipLabel(string r) => L("ui.inventory.rarity_" + r);

	// ────────────────────── KEYBOARD NAVIGATION ──────────────────────
	// Scheme (handled entirely in HandleInventoryKeyboardInput, polled
	// from Tick while this panel is the top modal):
	//   1-7      → switch category tab (Slot1..Slot7 input actions)
	//   W/A/S/D  → move the grid cursor (Forward/Backward/Left/Right actions)
	//   Space    → use/activate the selected item (Jump action == space)
	//   Q        → close the panel (Menu action == Q)
	// Selection reuses the existing `selectedItem` field + the living ring —
	// no parallel cursor state. Navigation order follows RENDER order
	// (grouped in ALL mode) so the cursor walks the grid as displayed.
	//
	// Grid column count: 150px cards + 14px gap in the ~1184px grid content
	// box (1920 page − 248 spine − 24 gap − 400 right lane − 40 right pad −
	// 24px grid padding) → 7 per row. MUST stay in sync with the .sat-card
	// layout in the .scss.
	private const int InvGridColumns = 7;

	// Category order for the 1-7 number keys — must match the .sat-tab loop.
	private static readonly string[] CategoryKeyOrder =
		{ "all", "consumable", "relic", "held", "boost", "material", "quest" };

	private void HandleInventoryKeyboardInput()
	{
		// Don't steal keys while the player is typing in the search box or chat.
		if (ChatPanel.IsChatFocused) return;
		if (searchInput != null && searchInput.HasFocus) return;

		// ── Q → close (Menu action is bound to Q). ──
		if (Input.Pressed("Menu"))
		{
			Close();
			return;
		}

		// ── 1-7 → category tab switch (Slot1..Slot7). ──
		for (int i = 0; i < CategoryKeyOrder.Length; i++)
		{
			if (Input.Pressed($"Slot{i + 1}"))
			{
				if (currentCategory != CategoryKeyOrder[i])
					SetCategory(CategoryKeyOrder[i]);
				return;
			}
		}

		// ── Space / Enter → use/activate the selected item. ──
		if (Input.Pressed("Jump") || Input.Pressed("Enter"))
		{
			var spaceItems = GetNavItems();
			if (selectedItem == null && spaceItems.Count > 0)
				SelectFilteredItem(spaceItems, 0);
			else
				ActivateSelectedItem();
			return;
		}

		// ── W/A/S/D → grid cursor. No-op on an empty category. ──
		var items = GetNavItems();
		if (items.Count == 0) return;

		int idx = selectedItem == null
			? -1
			: items.FindIndex(t => t.ItemId == selectedItem.Id);

		bool up    = Input.Pressed("Forward");
		bool down  = Input.Pressed("Backward");
		bool left  = Input.Pressed("Left");
		bool right = Input.Pressed("Right");

		if (left)
		{
			idx = idx <= 0 ? 0 : idx - 1;
			SelectFilteredItem(items, idx);
		}
		else if (right)
		{
			idx = idx < 0 ? 0 : Math.Min(items.Count - 1, idx + 1);
			SelectFilteredItem(items, idx);
		}
		else if (up)
		{
			idx = idx < 0 ? 0 : Math.Max(0, idx - InvGridColumns);
			SelectFilteredItem(items, idx);
		}
		else if (down)
		{
			idx = idx < 0 ? 0 : Math.Min(items.Count - 1, idx + InvGridColumns);
			SelectFilteredItem(items, idx);
		}
	}

	private void SelectFilteredItem(List<(string ItemId, int Quantity)> items, int idx)
	{
		idx = Math.Clamp(idx, 0, items.Count - 1);
		var def = ItemManager.Instance?.GetItem(items[idx].ItemId);
		if (def != null)
		{
			SelectItem(def);
			_scrollFollowPending = true;
		}
	}

	/// <summary>
	/// Fire the highlighted item's category-appropriate primary action —
	/// mirrors whatever button the detail panel currently shows for it.
	/// </summary>
	private void ActivateSelectedItem()
	{
		if (selectedItem == null) { SoundManager.PlayDeny(); return; }
		switch (selectedItem.Category)
		{
			case ItemCategory.Consumable:
				OnUsePressed(selectedItem);
				break;
			case ItemCategory.Relic:
				if (IsInBattleMode()) SoundManager.PlayDeny();
				else if (IsRelicEquipped(selectedItem.Id)) UnequipRelic(selectedItem);
				else OnEquipPressed(selectedItem);
				break;
			case ItemCategory.Boost:
				OnBoostPressed(selectedItem);
				break;
			default:
				// Held / Material / Quest items have no primary action.
				SoundManager.PlayDeny();
				break;
		}
	}

	private void OnCardHover(string itemId)
	{
		if (itemId == lastHoveredItemId) return;
		lastHoveredItemId = itemId;
		SoundManager.PlayHover();
	}

	private void OnRelicSlotClick(string relicId)
	{
		if (string.IsNullOrEmpty(relicId)) return;
		var item = ItemManager.Instance?.GetItem(relicId);
		if (item != null)
		{
			selectedItem = item;
			SoundManager.PlaySelect();
		}
	}

	private void OnUsePressed(ItemDefinition item)
	{
		if (!CanUseConsumable(item))
		{
			SoundManager.PlayDeny();
			return;
		}
		UseConsumable(item);
	}

	private void OnEquipPressed(ItemDefinition item)
	{
		if (!CanEquipRelic())
		{
			SoundManager.PlayDeny();
			return;
		}
		EquipRelic(item);
	}

	private void OnBoostPressed(ItemDefinition item)
	{
		if (!CanUseBoost(item))
		{
			SoundManager.PlayDeny();
			return;
		}
		UseBoost(item);
	}

	// No-arg wrappers so BbButton OnClick gets clean delegates.
	private void UseSelected() => OnUsePressed(selectedItem);
	private void EquipSelected() => OnEquipPressed(selectedItem);
	private void UnequipSelected() => UnequipRelic(selectedItem);
	private void BoostSelected() => OnBoostPressed(selectedItem);

	// ────────────────────── THE LIVING RING ──────────────────────
	// Roster recipe adapted: root-level absolute bordered div, position
	// recomputed every Tick from live Box.Rects (the grid scrolls +
	// reflows on filter changes), ink-lean wave via imperative
	// Style.Transform (flat panel — per-frame writes are cheap outside a
	// perspective lean). Self-hides when the card scrolls out of the grid
	// viewport (s&box never clips a root-level ring to the scroll clip).
	private Panel satGridRef;
	private Panel gridRingRef;
	private int ringL, ringT, ringW = 150, ringH = 164;
	private bool ringVisible;
	private int ringWarm; // <2 = snap to position (no glide) while first rects land
	private const int RingInset = 10;
	private bool _scrollFollowPending = false;

	private void UpdateGridRing()
	{
		bool wasVisible = ringVisible;
		ringVisible = false;

		if (!IsVisible || showMonsterPicker || selectedItem == null || satGridRef == null) return;

		int wantIdx = GetRenderIndexOf(selectedItem.Id);
		if (wantIdx < 0) return;

		Panel target = null;
		int n = 0;
		foreach (var c in satGridRef.Children)
		{
			if (!c.HasClass("sat-card")) continue;
			if (n == wantIdx) { target = c; break; }
			n++;
		}
		if (target == null) return;

		var rr = Box.Rect;
		var gr = satGridRef.Box.Rect;
		var cr = target.Box.Rect;
		if (rr.Width < 1f || cr.Width < 1f) return;

		// Keyboard scroll-follow — keep the cursor card inside the viewport.
		if (_scrollFollowPending && gr.Height > 0f && cr.Height > 0f)
		{
			float curOff = satGridRef.ScrollOffset.y;
			float top = cr.Top - gr.Top + curOff;
			float bot = top + cr.Height;
			const float margin = 24f;
			float newOff = curOff;
			if (top - margin < curOff) newOff = top - margin;
			else if (bot + margin > curOff + gr.Height) newOff = bot + margin - gr.Height;
			newOff = Math.Max(0f, newOff);
			if (Math.Abs(newOff - curOff) > 0.5f)
				satGridRef.ScrollOffset = new Vector2(satGridRef.ScrollOffset.x, newOff);
			_scrollFollowPending = false;
		}

		// Scroll-clip discipline: hide once the card has scrolled far enough
		// out that the ring would draw over the tools row / page bottom.
		if (cr.Top < gr.Top - 14f || cr.Bottom > gr.Bottom + 14f) return;

		float sc = ScaleFromScreen;
		if (sc <= 0.01f || float.IsNaN(sc) || float.IsInfinity(sc)) sc = 1f;

		// Content-box math: declared width = target + 2×inset − 2×4px border.
		ringL = (int)((cr.Left - rr.Left) * sc) - RingInset;
		ringT = (int)((cr.Top - rr.Top) * sc) - RingInset;
		ringW = (int)(cr.Width * sc) + RingInset * 2 - 8;
		ringH = (int)(cr.Height * sc) + RingInset * 2 - 8;

		ringVisible = true;
		if (!wasVisible) ringWarm = 0;
		else if (ringWarm < 2) ringWarm++;
	}

	// The liquid ink-lean — menu cursor multi-sine at the PawPad's ×0.6
	// amplitude + out-of-phase breathing. Imperative transform: repaints
	// the ring alone, never re-renders.
	private void ApplyGridRingWave()
	{
		if (gridRingRef == null || !ringVisible) return;
		float wt = Time.Now;
		float skX = (2.0f * MathF.Sin(wt * 2.2f) + 0.7f * MathF.Sin(wt * 3.5f + 1.1f)) * 0.6f;
		float skY = (2.3f * MathF.Sin(wt * 1.8f + 1.9f) + 0.9f * MathF.Sin(wt * 2.9f)) * 0.6f;
		float rotZ = (1.1f * MathF.Sin(wt * 1.0f) + 0.5f * MathF.Sin(wt * 2.4f + 0.5f)) * 0.6f;
		float brX = 1f + 0.013f * MathF.Sin(wt * 1.35f + 0.7f) + 0.006f * MathF.Sin(wt * 2.7f);
		float brY = 1f + 0.013f * MathF.Sin(wt * 1.15f + 2.6f) + 0.006f * MathF.Sin(wt * 2.3f + 1.4f);

		var t = new PanelTransform();
		t.AddRotation(0f, 0f, rotZ);
		t.AddSkew(skX, skY, 0f);
		t.AddScale(new Vector2(brX, brY));
		gridRingRef.Style.Transform = t;
	}

	public override void Tick()
	{
		base.Tick();

		// Keyboard navigation — only while this panel is the top open modal.
		// (Escape is NOT bound — s&box reserves it; Q closes instead.) The
		// monster picker is a sub-modal; leave it mouse-only so a stray
		// keypress can't target the wrong beast.
		if (IsVisible && !showMonsterPicker && UIModalState.IsTopModal("InventoryPanel"))
		{
			HandleInventoryKeyboardInput();
		}

		// Apply pending battle category override (set in Show/Toggle, consumed
		// here because SetCategory plays a sound we don't want on open)
		if (_pendingBattleCategory != null)
		{
			currentCategory = _pendingBattleCategory;
			selectedItem = null;
			_pendingBattleCategory = null;
		}

		// The living ring — recompute position + apply the wave.
		UpdateGridRing();
		ApplyGridRingWave();

		// Search query polling
		if (searchInput != null && searchInput.Text != searchQuery)
		{
			searchQuery = searchInput.Text;
		}

		// Hold-to-sell progress
		if (isHoldingSell && selectedItem != null)
		{
			holdProgress += Time.Delta / HoldDuration;
			if (holdProgress >= 1f)
			{
				holdProgress = 1f;
				SellSelectedItem();
				isHoldingSell = false;
				holdProgress = 0f;
			}
		}

		// Toast countdown — start exit animation 0.3s before clear
		if (toastTimer > 0f)
		{
			toastTimer -= Time.Delta;
			if (toastTimer <= 0.3f && !toastExiting)
			{
				toastExiting = true;
			}
			if (toastTimer <= 0f)
			{
				toastTimer = 0f;
				toastMessage = "";
				toastSuccess = false;
				toastExiting = false;
			}
		}

		// Equip flash timer
		if (justEquippedTimer > 0f)
		{
			justEquippedTimer -= Time.Delta;
			if (justEquippedTimer <= 0f)
			{
				justEquippedSlot = -1;
				justEquippedTimer = 0f;
			}
		}
	}

	private int GetTotalItemCount()
	{
		var inventory = TamerManager.Instance?.CurrentTamer?.Inventory;
		if (inventory == null) return 0;
		// Only count items that actually resolve via ItemManager — the grid
		// silently skips unresolvable IDs, so a raw sum would over-count and
		// produce "ALL ITEMS 573" while the grid shows fewer cards (ghost-ID
		// law). Filtering here makes the badge match the visible count by
		// construction, without touching the player's inventory dict.
		return inventory
			.Where( kvp => kvp.Value > 0 && ItemManager.Instance?.GetItem( kvp.Key ) != null )
			.Sum( kvp => kvp.Value );
	}

	private int GetCategoryItemCount(string category)
	{
		var inventory = TamerManager.Instance?.CurrentTamer?.Inventory;
		if (inventory == null) return 0;

		return inventory.Where(kvp => kvp.Value > 0)
			.Sum(kvp =>
			{
				var item = ItemManager.Instance?.GetItem(kvp.Key);
				if (item == null) return 0;
				bool matches = category switch
				{
					"consumable" => item.Category == ItemCategory.Consumable,
					"relic" => item.Category == ItemCategory.Relic,
					"held" => item.Category == ItemCategory.HeldItem,
					"boost" => item.Category == ItemCategory.Boost,
					"material" => item.Category == ItemCategory.Material,
					"quest" => item.Category == ItemCategory.QuestItem,
					_ => false
				};
				return matches ? kvp.Value : 0;
			});
	}

	private int GetRarityCount(string rarity)
	{
		var inventory = TamerManager.Instance?.CurrentTamer?.Inventory;
		if (inventory == null) return 0;
		return inventory.Where(kvp => kvp.Value > 0).Sum(kvp =>
		{
			var item = ItemManager.Instance?.GetItem(kvp.Key);
			if (item == null) return 0;
			return item.Rarity.ToString().ToLower() == rarity ? kvp.Value : 0;
		});
	}

	private List<(string ItemId, int Quantity)> GetFilteredItems()
	{
		var inventory = TamerManager.Instance?.CurrentTamer?.Inventory;
		if (inventory == null) return new();

		var items = inventory.Where(kvp => kvp.Value > 0).ToList();

		if (currentCategory != "all")
		{
			items = items.Where(kvp =>
			{
				var item = ItemManager.Instance?.GetItem(kvp.Key);
				if (item == null) return false;
				return currentCategory switch
				{
					"consumable" => item.Category == ItemCategory.Consumable,
					"relic" => item.Category == ItemCategory.Relic,
					"held" => item.Category == ItemCategory.HeldItem,
					"boost" => item.Category == ItemCategory.Boost,
					"material" => item.Category == ItemCategory.Material,
					"quest" => item.Category == ItemCategory.QuestItem,
					_ => true
				};
			}).ToList();
		}

		if (currentRarityFilter != "all")
		{
			items = items.Where(kvp =>
			{
				var item = ItemManager.Instance?.GetItem(kvp.Key);
				if (item == null) return false;
				return item.Rarity.ToString().ToLower() == currentRarityFilter;
			}).ToList();
		}

		if (!string.IsNullOrEmpty(searchQuery))
		{
			var q = searchQuery.ToLower();
			items = items.Where(kvp =>
			{
				var item = ItemManager.Instance?.GetItem(kvp.Key);
				if (item == null) return false;
				return item.Name.ToLower().Contains(q);
			}).ToList();
		}

		var result = currentSort switch
		{
			"name" => items.OrderBy(x => ItemManager.Instance?.GetItem(x.Key)?.Name ?? "").ToList(),
			"qty" => items.OrderByDescending(x => x.Value).ToList(),
			"rarity" => items.OrderByDescending(x => (int)(ItemManager.Instance?.GetItem(x.Key)?.Rarity ?? 0)).ToList(),
			_ => items
		};

		return result.Select(kvp => (kvp.Key, kvp.Value)).ToList();
	}

	private List<KeyValuePair<ItemCategory, List<(string ItemId, int Quantity)>>> GetGroupedItems()
	{
		var filtered = GetFilteredItems();
		var grouped = new Dictionary<ItemCategory, List<(string ItemId, int Quantity)>>();
		var categoryOrder = new[] { ItemCategory.Consumable, ItemCategory.Relic, ItemCategory.HeldItem, ItemCategory.Boost, ItemCategory.Material, ItemCategory.QuestItem };

		foreach (var (itemId, qty) in filtered)
		{
			var item = ItemManager.Instance?.GetItem(itemId);
			if (item == null) continue;
			if (!grouped.ContainsKey(item.Category))
				grouped[item.Category] = new();
			grouped[item.Category].Add((itemId, qty));
		}

		return categoryOrder
			.Where(c => grouped.ContainsKey(c))
			.Select(c => new KeyValuePair<ItemCategory, List<(string ItemId, int Quantity)>>(c, grouped[c]))
			.ToList();
	}

	// ── Render-order source of truth — the grid, the keyboard cursor and
	// the living ring all walk THIS order, so they can never disagree.
	// ALL mode = grouped sections; any other tab = the flat filtered list.
	private List<(string Label, List<(string ItemId, int Quantity)> Items)> GetRenderGroups()
	{
		if (currentCategory == "all")
		{
			return GetGroupedItems()
				.Select(g => (GetCategorySectionLabel(g.Key), g.Value))
				.ToList();
		}
		return new() { ((string)null, GetFilteredItems()) };
	}

	private List<(string ItemId, int Quantity)> GetNavItems()
	{
		var list = new List<(string ItemId, int Quantity)>();
		foreach (var g in GetRenderGroups()) list.AddRange(g.Items);
		return list;
	}

	private int GetRenderIndexOf(string itemId)
	{
		int i = 0;
		foreach (var g in GetRenderGroups())
		{
			foreach (var it in g.Items)
			{
				if (it.ItemId == itemId) return i;
				i++;
			}
		}
		return -1;
	}

	private string GetEquippedRelic(int slot)
	{
		var relics = TamerManager.Instance?.CurrentTamer?.EquippedRelics;
		if (relics == null || slot >= relics.Count) return null;
		return relics[slot];
	}

	private bool IsEquipped(string itemId)
	{
		var item = ItemManager.Instance?.GetItem(itemId);
		if (item == null) return false;
		if (item.Category == ItemCategory.Relic)
			return TamerManager.Instance?.CurrentTamer?.EquippedRelics?.Contains(itemId) ?? false;
		return false;
	}

	private bool IsRelicEquipped(string itemId)
	{
		return TamerManager.Instance?.CurrentTamer?.EquippedRelics?.Contains(itemId) ?? false;
	}

	private int GetItemQuantity(string itemId)
	{
		return TamerManager.Instance?.CurrentTamer?.Inventory?.GetValueOrDefault(itemId, 0) ?? 0;
	}

	private string GetRarityClass(ItemRarity rarity)
	{
		return rarity.ToString().ToLower();
	}

	private string GetCategorySectionLabel(ItemCategory category)
	{
		return category switch
		{
			ItemCategory.Consumable => "Consumables",
			ItemCategory.Relic => "Relics",
			ItemCategory.HeldItem => "Held Items",
			ItemCategory.Boost => "Boosts",
			ItemCategory.Material => "Drops",
			ItemCategory.QuestItem => "Quest Items",
			_ => category.ToString()
		};
	}

	private string GetEffectDescription(ItemDefinition item)
	{
		if (item == null) return "";
		return item.GetEffectDescription();
	}

	private bool CanUseConsumable(ItemDefinition item)
	{
		if (item.Category != ItemCategory.Consumable) return false;
		if (item.EffectType == ItemEffectType.MasterInk) return false;
		return GetItemQuantity(item.Id) > 0;
	}

	private bool NeedsTarget(ItemDefinition item)
	{
		return item.EffectType == ItemEffectType.XPGrant
			|| item.EffectType == ItemEffectType.NatureChange
			|| item.EffectType == ItemEffectType.TraitReroll
			|| item.EffectType == ItemEffectType.GeneBoost;
	}

	private void UseConsumable(ItemDefinition item)
	{
		if (!CanUseConsumable(item)) return;

		if (NeedsTarget(item))
		{
			pendingConsumable = item;
			showMonsterPicker = true;
			SoundManager.PlayClick();
			return;
		}

		// In battle, route through BattleManager so the turn is consumed.
		if (IsInBattleMode() && BattleManager.Instance != null)
		{
			if (BattleManager.Instance.ExecutePlayerItem(item.Id, null))
			{
				SoundManager.PlaySuccess();
				Close();
			}
			else
			{
				SoundManager.PlayDeny();
			}
			return;
		}

		if (ItemManager.Instance?.UseItem(item.Id, null) == true)
		{
			SoundManager.PlaySuccess();
		}
		else
		{
			SoundManager.PlayDeny();
		}
	}

	private void CloseMonsterPicker()
	{
		showMonsterPicker = false;
		pendingConsumable = null;
		SoundManager.PlayBack();
	}

	private static bool IsInBattleMode() => BattleManager.Instance?.IsInBattle == true;

	private List<Monster> GetOwnedMonsters()
	{
		if (IsInBattleMode())
		{
			var party = BattleManager.Instance?.PlayerTeam;
			if (party == null) return new();
			return party.Where(m => m != null && m.CurrentHP > 0).ToList();
		}

		var monsters = MonsterManager.Instance?.OwnedMonsters;
		if (monsters == null) return new();
		return monsters.OrderByDescending(m => m.Level).ToList();
	}

	private string GetMonsterSprite(Monster monster)
	{
		var species = MonsterManager.Instance?.GetSpecies(monster.SpeciesId);
		if (species == null) return "";
		if (species.AnimationFrames != null && species.AnimationFrames.Count > 0)
			return species.AnimationFrames[0];
		return species.IconPath ?? "";
	}

	private void UseConsumableOnMonster(Monster monster)
	{
		if (pendingConsumable == null || monster == null) return;

		bool success;
		// In battle, route through BattleManager so the turn is consumed and the enemy gets to act.
		if (IsInBattleMode() && BattleManager.Instance != null)
		{
			success = BattleManager.Instance.ExecutePlayerItem(pendingConsumable.Id, monster);
		}
		else
		{
			success = ItemManager.Instance?.UseItem(pendingConsumable.Id, monster) == true;
		}

		if (success)
		{
			toastMessage = string.Format(L("ui.inventory.toast_used"), pendingConsumable.Name, monster.Nickname);
			toastSuccess = true;
			toastTimer = ToastDuration;
			SoundManager.PlaySuccess();

			if (GetItemQuantity(pendingConsumable.Id) <= 0)
				selectedItem = null;

			// Close the bag in battle so the player sees the turn play out
			if (IsInBattleMode()) Close();
		}
		else
		{
			toastMessage = L("ui.inventory.toast_failed");
			toastSuccess = false;
			toastTimer = ToastDuration;
			SoundManager.PlayDeny();
		}

		showMonsterPicker = false;
		pendingConsumable = null;
	}

	private bool CanUseBoost(ItemDefinition item)
	{
		if (item == null || item.Category != ItemCategory.Boost) return false;
		return GetItemQuantity(item.Id) > 0;
	}

	private void UseBoost(ItemDefinition item)
	{
		if (!CanUseBoost(item)) return;
		if (ItemManager.Instance == null) return;

		var result = ItemManager.Instance.UseBoost(item.Id);
		toastMessage = result.Message;
		toastSuccess = result.Success;
		toastTimer = ToastDuration;

		if (result.Success)
		{
			SoundManager.PlaySuccess();
			if (GetItemQuantity(item.Id) <= 0)
				selectedItem = null;
		}
		else
		{
			SoundManager.PlayDeny();
		}
	}

	private bool CanEquipRelic()
	{
		if (IsInBattleMode()) return false;
		var relics = TamerManager.Instance?.CurrentTamer?.EquippedRelics;
		return relics == null || relics.Count < 3;
	}

	private void EquipRelic(ItemDefinition item)
	{
		if (item.Category != ItemCategory.Relic) return;
		if (!CanEquipRelic()) return;

		if (ItemManager.Instance?.EquipRelic(item.Id) == true)
		{
			SoundManager.PlayForward();
			// Flash the slot that just received this relic
			var relics = TamerManager.Instance?.CurrentTamer?.EquippedRelics;
			if (relics != null)
			{
				var idx = relics.IndexOf(item.Id);
				if (idx >= 0) { justEquippedSlot = idx; justEquippedTimer = 0.6f; }
			}
		}
		else
		{
			SoundManager.PlayBack();
		}
	}

	private void UnequipRelic(ItemDefinition item)
	{
		if (item == null || item.Category != ItemCategory.Relic) return;

		if (ItemManager.Instance?.UnequipRelic(item.Id) == true)
		{
			SoundManager.PlayBack();
		}
		else
		{
			SoundManager.PlayDeny();
		}
	}

	private bool CanSellItem(ItemDefinition item)
	{
		if (item == null || item.SellPrice <= 0) return false;
		if (IsInBattleMode()) return false;
		if (item.Category == ItemCategory.Relic && IsRelicEquipped(item.Id)) return false;
		return GetItemQuantity(item.Id) > 0;
	}

	private void StartHoldSell()
	{
		if (selectedItem == null || !CanSellItem(selectedItem)) return;
		isHoldingSell = true;
		holdProgress = 0f;
		SoundManager.PlayClick();
	}

	private void StopHold()
	{
		isHoldingSell = false;
		holdProgress = 0f;
	}

	private void SellSelectedItem()
	{
		if (selectedItem == null) return;

		if (ItemManager.Instance?.SellItem(selectedItem.Id, 1) == true)
		{
			SoundManager.PlayGoldReward();
			if (GetItemQuantity(selectedItem.Id) <= 0)
				selectedItem = null;
		}
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add(IsVisible);
		// currentCategory + selectedItem?.Id below ALSO cover the keyboard
		// navigation state — 1-7 mutate currentCategory, WASD mutates
		// selectedItem.
		hash.Add(currentCategory);
		hash.Add(currentRarityFilter);
		hash.Add(currentSort);
		hash.Add(searchQuery);
		hash.Add(selectedItem?.Id);
		hash.Add(GetTotalItemCount());
		hash.Add(isHoldingSell);
		hash.Add(justEquippedSlot);
		hash.Add(toastExiting);
		hash.Add(holdProgress);
		hash.Add(toastMessage);
		hash.Add(showMonsterPicker);
		hash.Add(IsInBattleMode());
		hash.Add(TamerManager.Instance?.CurrentTamer?.Gold ?? 0);

		// Living ring position + NEW-stamp state
		hash.Add(ringL);
		hash.Add(ringT);
		hash.Add(ringW);
		hash.Add(ringH);
		hash.Add(ringVisible);
		hash.Add(ringWarm < 2);
		hash.Add(_seenItemIds.Count);

		var relics = TamerManager.Instance?.CurrentTamer?.EquippedRelics;
		if (relics != null)
		{
			foreach (var r in relics) hash.Add(r);
		}

		var inventory = TamerManager.Instance?.CurrentTamer?.Inventory;
		if (inventory != null)
		{
			foreach (var kvp in inventory)
			{
				hash.Add(kvp.Key);
				hash.Add(kvp.Value);
			}
		}

		return hash.ToHashCode();
	}
}
