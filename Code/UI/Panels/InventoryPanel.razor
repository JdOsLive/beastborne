@namespace Beastborne.UI.Panels
@using Sandbox;
@using Sandbox.UI;
@using Beastborne.Core;
@using Beastborne.Data;
@using Beastborne.Systems;
@using Beastborne.UI;
@using Beastborne.UI.Components;
@using Beastborne.UI.Primitives;
@using System.Linq;
@inherits Panel

@*
	BAG — the item grid + one case (2026-09-03 pipeline rebuild, LAYOUT lane).

	Brief: .claude/design-system/components/bag-redesign-brief.html +
	bag-mock-page.html (user 2026-09-02: "same layout as shop is okay" — the
	mock's DEFAULT toggles are the rulings): the house FilterBar in the
	header (CATEGORY + R · CYCLE · SORT + dir · SEARCH chip) · kicker rows
	CONSUMABLES · BOOSTS · HELD ITEMS · RELICS · DROPS in ALL (a picked
	category collapses the grid to that section, no kicker) · cards = the
	SHOP's shipped geometry (150×168 r16, art 100, name 30, third line 26 =
	×N) · EQUIP TO... on held items via the existing beast picker · sell =
	stepper + hold-to-confirm for stacks · NO sell values on cards · relic
	loadout = "N / 3 EQUIPPED" on the RELICS kicker + green E chips · kicker
	TAMER, title BAG · accent TAN #d9a054.

	CUT (16): the 220px spine (7 pouch tabs · counts · 1-7 caps) · FIELD
	SATCHEL header · spine gold chip + WASD hint · 6 rarity chips · the body
	toolbar row · per-card hover ring · relic slab + flash · "Equip via
	Monster Details" · detail rarity pill · duration line · EFFECT: kicker ·
	"Select an item" · Q cap + X row · picker subtitle + seam chip + 2-col
	wrappers · "Locked during battle" · the Quest bucket · legendary name
	recolour · the violet E (→ green).
	MERGED (5): header → the house recipe · NEW → ItemManager (one source) ·
	boost USE → the consumable USE branch · corner ×N → the card's third
	line · search/sort → the FilterBar.
	ADDED (3): EQUIP TO... · sell stepper · picker datum column.

	ZONE MAP (1920×1080, PADDING-BOX math — declared size includes padding,
	borders add on top):
	  header  1920×88 + 2px strip = 90   (pad 16/32/12/28; kicker 12/14 + 2
	          + title 38/44 = 60 tall; the hub .oh-header recipe, accent tan)
	  body    pad 20/30/20/30 → column 1080 − 90 − 20 − 20 = 950 (NO HUD
	          reserve: .inventory-panel is not in GameHUD's 56px ::after list
	          — checked 2026-09-03, nothing to remove; .bag-body is flex 1 1 0)
	  goods   1330 = 12 inset + grid 1298 (8 × 150 + 7 × 14) + 20 scrollbar lane
	  gap     48 (the case's margin-left)
	  case    482 × 950 r22, pad 24 → 434 inner
	  row     30 + 1330 + 48 + 482 + 30 = 1920 ✓
	  column  90 + 20 + 950 + 20 = 1080 ✓
	Header right slot (flex 1 1 0, right-aligned; 1920 − 28 − ~160 identity
	  − 24 − 32 ≈ 1676 available): [IN BATTLE stamp] · FilterBar (CATEGORY
	  ~170 + 12 + SORT ~150 + 8 dir 32 + 12 SEARCH 180 ≈ 564) · R CYCLE hint
	  · balance 32 r11 (+12) · BACK · Q 30 r11 ≈ 830 → right-aligned.
	Grid rhythm (flat wrap list; kicker rows + cards DIRECT children):
	  row-gap 8 · card 168 + margin-bottom 8 → card→card 16 · kicker 24 +
	  margin-top 8 → card→kicker 24 · kicker→card 8.
	  The brief's 29-stack scenario: 5 kickers + 5 card rows = 120 + 32 +
	  5×176 + 9×8 = 1104 (scrolls 154 in the 950 viewport).
	Case interior (434): art 300 · +16 name 34 · +6 ×N 24 · +8 effect ≥44 ·
	  +12 PRIMARY 56 → ends at y 524 from the case top (24 + 500); the SELL
	  row (44) sits at the foot, y 882..926 (950 − 24 − 44); the 358px
	  between them carries the ghost glyph at .05 and nothing else.

	ENGINE LAWS honored: no AcceptsFocus; pointer-events all/none via a CLASS
	on every child of a pressable; explicit boxes on every absolute;
	line-height px; bare text in spans; explicit width + flex pin on every
	card; no width:100% inside padded parents; wrap grid pins width AND
	max-width; no transform/box-shadow on scroll-grid cards; `<img>` art
	carries background-repeat: no-repeat; imperative fills in px.

	LANE MARKERS left for the other passes:
	  // LANE: motion     header fade · body fade · sell-hold fill · toast ·
	                      picker enter · balance tick
	  // LANE: input      category R cycle + header walk-up (CollectHeaderControls)
	                      · case zone (stepper ↔ SELL hold ↔ primary) · picker
	                      kb · stepper hold-repeat · travel-guarded device flag
	  // LANE: color      FilterBar rim on a tan page · the E green · tan tints
	  // LANE: components .sat-card here == .shop-card (ShopPanelContent) —
	                      capture both into one BbItemCard primitive (DOC-6 #18)
	  // LANE: systems    GameHUD.OnInventoryClicked still calls
	                      ItemManager.MarkAllItemsSeen() on open — stop it so
	                      the NEW stamps survive to the select
*@

@* Root carries the device class (DOC-5 #5) — onmousemove is the mouse-mode
   reclaim (travel-gated, the shop's recipe). *@
<root class="@RootClass" onmousemove=@OnRootMouseMove>

	@* Living background: the bag glyph drifting at the house angle
	   (BbIconScroll supplies the opaque dark base — root paints none). *@
	<BbIconScroll Icon="bag" />

	@* ====================== HEADER — the hub .oh-header recipe, accent TAN ====================== *@
	<div class="bag-header">
		@* LANE: color — the TAN bake (Assets/ui/wave-tan-a/b.png); band opacity
		   .16/.24 in the SCSS (the house ladder). *@
		<BbHeaderWaves Accent=@("tan") />
		<div class="bag-identity">
			<span class="bag-kicker">TAMER</span>
			<div class="bag-title-row">
				<span class="bag-title">@L("ui.inventory.title")</span>
				<div class="bag-seam"></div>
				<div class="bag-seam dim"></div>
			</div>
		</div>

		@* Right slot (.oh-toolbar position): [IN BATTLE] · FilterBar · R CYCLE ·
		   balance · BACK · Q. LANE: input — the HEADER zone: W from the top card
		   row should land on the category chip (`.kb-focused`, no ring — the
		   roster's CollectHeaderControls + SyncHeaderKbFocus recipe); A/D walk
		   the controls; S returns to the grid. Not wired here. *@
		<div class="bag-toolbar">
			@if (IsInBattleMode())
			{
				<div class="bag-battle-stamp">
					<BbStamp Text=@L("ui.inventory.battle_mode") Tone="orange" Dot=@true Tilt=@(3) />
				</div>
			}
			<FilterBar @ref="filterBar"
					   PrimaryItems=@CategoryMenu
					   CurrentPrimary=@currentCategory
					   OnPrimaryChanged=@OnCategoryChanged
					   ItemSorts=@SortMenu
					   CurrentSort=@currentSort
					   SortAscending=@sortAscending
					   OnSortChanged=@OnSortChanged
					   OnSortDirectionChanged=@OnSortDirectionChanged
					   ShowSearchChip=@true
					   SearchPlaceholder=@L("ui.inventory.search")
					   OnNameFilterChanged=@OnSearchChanged
					   KbMode=@IsKbMode />
			@* R = category forward (the shown cycle key; Z/X cycle the sort
			   silently — DOC-5 #1). The roster's .rh-filter-hint recipe, placed
			   AFTER the bar as the roster does (the mock draws it between
			   CATEGORY and SORT — that slot is inside the shared component and
			   would need a fourth parameter; roster precedent kept). *@
			<div class="bag-filter-hint">
				<span class="bag-cap">R</span>
				<span class="bag-filter-hint-text">CYCLE</span>
			</div>
			@* Balance — the shop .sh-balance recipe. MOTION: `.flash flash-N`
			   (IsGoldFlash, keyed per sell) is the ONE balance pulse hook. *@
			<div class="@BalanceClass()">
				<img class="bag-balance-glyph" src="ui/icons/currency/money.svg" />
				<span class="bag-balance-value">@GoldText()</span>
			</div>
			@* BACK · Q — the hub .hb-back recipe. Click = Close; Q already closes. *@
			<div class="bag-back" onclick=@OnBackClicked onmouseover=@OnBackHover onmouseout=@OnBackOut>
				<span class="bag-back-label">BACK</span>
				<span class="bag-back-cap">Q</span>
			</div>
		</div>
	</div>

	@* ====================== BODY — item grid + the case ====================== *@
	<div class="bag-body">
		@{
			// Hoisted above BOTH columns (2026-09-03): a code block nested inside the
			// goods <div> compiles into that element's scope in s&box Razor, so the
			// case column could not see `caseItem` (11 CS0103s on first compile).
			var groups = GetRenderGroups();
			var navItems = GetNavItems();
			var caseItem = GetCaseItem();
			bool battle = IsInBattleMode();
			bool bagEmpty = GetOwnedStackCount() == 0;
		}

		@* ---- GOODS — 1330: 12 inset + the 1298 grid + a 20px overlay-scrollbar lane ---- *@
		@* MOTION: body fade on mount (the shop's shBodyIn) — not wired here. *@
		<div class="bag-goods">
			<div @ref="gridRef" class="@GridClass(navItems.Count == 0)">
				@if (navItems.Count == 0)
				{
					@* Empty state — the `.empty` grid flips to a centered column
					   (DOC-6 #9). Two honest lines: the whole bag is empty, or a
					   filter emptied it (R · CYCLE gets you out). *@
					@if (bagEmpty)
					{
						<span class="bag-empty-head">Nothing in the bag yet.</span>
						<span class="bag-empty-sub">Expeditions drop materials, held items and relics.</span>
					}
					else
					{
						<span class="bag-empty-head">@L("ui.inventory.no_items_found")</span>
						<div class="bag-empty-hint">
							<span class="bag-cap">R</span>
							<span class="bag-filter-hint-text">CYCLE</span>
						</div>
					}
				}
				else
				{
					foreach (var group in groups)
					{
						if (group.Label != null)
						{
							<div class="bag-kicker-row">
								<div class="bag-kicker-chip">
									<div class="bag-kicker-chip-inner"><span class="bag-kicker-text">@group.Label</span></div>
								</div>
								<div class="bag-kicker-line"></div>
								@if (group.Key == "relic")
								{
									@* Relic loadout = ONE number on the kicker (the slab died). *@
									<span class="bag-kicker-count">@EquippedCountText()</span>
								}
							</div>
						}
						foreach (var (itemId, quantity) in group.Items)
						{
							var item = ItemManager.Instance?.GetItem(itemId);
							if (item == null) continue;
							bool isCase = caseItem != null && caseItem.Id == itemId;
							bool locked = battle && item.Category != ItemCategory.Consumable;
							var art = ArtPx(item.IconPath, 100);
							var cardClass = "sat-card" + (isCase ? " selected" : "") + (locked ? " locked" : "");

							<div class="@cardClass"
								 onclick=@(() => OnCardClick(item))
								 onmouseover=@(() => OnCardHover(item))>
								<div class="sat-card-art">
									<img class="sat-card-icon" src="@item.IconPath" style="width: @(art.w)px; height: @(art.h)px;" />
								</div>
								<div class="sat-card-foot"><span class="sat-card-name">@item.Name</span></div>
								@* Third line 26 — ×N in tan (the shop's price slot). Always mounted
								   so the geometry never moves; the span only for stacks. *@
								<div class="sat-card-qty">
									@if (quantity > 1)
									{
										<span class="sat-card-qty-text">@QtyText(quantity)</span>
									}
								</div>
								<div class="@("sat-strip r-" + GetRarityClass(item.Rarity))"></div>
								@if (IsRelicEquipped(itemId))
								{
									<div class="sat-equipped"><span class="sat-equipped-text">E</span></div>
								}
								@if (IsNewItem(itemId))
								{
									<div class="@("sat-new " + NewTiltClass(itemId))"><span class="sat-new-text">NEW</span></div>
								}
							</div>
						}
					}
				}
			</div>

			@* Overlay scrollbar — the roster .col-scrollbar recipe: read-only thumb
			   written per tick (scrollbar-color/-width don't parse). *@
			<div @ref="sbTrackRef" class="bag-scrollbar">
				<div @ref="sbThumbRef" class="bag-sb-thumb"></div>
			</div>
		</div>

		@* ---- THE CASE — 482 × 950 r22, pad 24 → 434 inner ---- *@
		@* Never empty (NO NOTHING): the selection, else the first item in render
		   order. MOTION: the case's fade shares the body's — not wired here. *@
		<div class="bag-case">
			@if (caseItem != null)
			{
				int qty = GetItemQuantity(caseItem.Id);
				var art = ArtPx(caseItem.IconPath, 256);
				var ghost = ArtPx(caseItem.IconPath, 160);
				var primary = GetPrimaryContent(caseItem);
				bool sellable = CanSellItem(caseItem);
				int sq = Math.Clamp(sellQty, 1, Math.Max(1, qty));

				<div class="bag-case-art">
					<img class="bag-case-img" src="@caseItem.IconPath" style="width: @(art.w)px; height: @(art.h)px;" />
					<div class="@("bag-case-strip r-" + GetRarityClass(caseItem.Rarity))"></div>
				</div>
				<span class="bag-case-name">@caseItem.Name</span>
				@* ×N line 24 — always mounted so the effect line holds still. *@
				<div class="bag-case-qty">
					@if (qty > 1)
					{
						<span class="bag-case-qty-text">@QtyText(qty)</span>
					}
				</div>
				@* The ONE effect line. LANE: systems (bug rider, data untouched) —
				   ItemDefinition.GetEffectDescription drops positive HeldDEFBonus /
				   HeldSpDBonus / HeldBurnChance secondaries (Training Weight prints
				   "+8% ATK" and hides "+8% DEF"). Fix lives in Item.cs. *@
				<span class="bag-case-effect">@GetEffectDescription(caseItem)</span>

				@if (primary.show)
				{
					@* PRIMARY 434×56 r16 directly under the effect — the page's one gold.
					   `off` = the SAME slab desaturated (ghost tier + Disabled; BIG THINGS
					   BIG — a locked EQUIP stays big and dims). Tuple-computed so the
					   BbButton only swaps attribute values (ghost-child law).
					   LANE: input — the CASE zone: D off a row's last card / Space on a
					   card should park the ring here (r26); S → the SELL group. *@
					<BbButton Tier="@PrimaryTier(primary.off)" Size=@(56) Label="@primary.label" Icon="@primary.icon" KeyCap="SPACE"
							  Disabled=@primary.off Class="@PrimaryClass(primary.off)" OnClick=@ActivateSelectedItem />
				}

				@* Slack — a real flex basis (no bg, invisible), so the SELL row sits at the foot. *@
				<div class="bag-case-slack"></div>

				@if (sellable)
				{
					@* SELL row 44 at the foot: stacks > 1 → stepper (− 44 · N 52 · + 44) + 12
					   + hold SELL 282 = 434; singles → hold SELL 434. Absent when SellPrice
					   0, the relic is equipped, or in battle. The hold button is the
					   shipped .sat-sell recipe (BbButton has no hold-fill child) restyled
					   to the danger pair at r11. LANE: input — A/D on the stepper +
					   hold-repeat (the shop's ArmMouseHold recipe); Space on SELL = hold.
					   LANE: motion — the fill's 0.05s width step + the holding pulse. *@
					<div class="bag-sell-row">
						@if (qty > 1)
						{
							<div class="@QtyBtnClass(sq <= 1)" onclick=@(() => ChangeSellQty(-1)) onmouseover=@OnQtyHover onmouseout=@OnQtyOut>
								<iconify class="bag-qty-glyph" icon="lucide:minus" Size=@(18) Color="#f4f1ea" />
							</div>
							<div class="bag-qty-value"><span class="bag-qty-num">@sq</span></div>
							<div class="@QtyBtnClass(sq >= qty)" onclick=@(() => ChangeSellQty(1)) onmouseover=@OnQtyHover onmouseout=@OnQtyOut>
								<iconify class="bag-qty-glyph" icon="lucide:plus" Size=@(18) Color="#f4f1ea" />
							</div>
						}
						<div class="@SellBtnClass(qty > 1)"
							 onmousedown=@StartHoldSell
							 onmouseup=@StopHold
							 onmouseout=@StopHold
							 onmouseover=@OnSellHover>
							<div class="bag-sell-fill" style="width: @(SellFillPx(qty > 1))px;"></div>
							<span class="bag-sell-label">@GetSellLabel(sq)</span>
							<span class="bag-sell-hold">HOLD</span>
						</div>
					</div>
				}

				@* Ghost watermark — the item at .05 in the slack (texture, not content).
				   Explicit-box absolute holder centred in the 358px slack; z 0. *@
				<div class="bag-case-ghost-box">
					<img class="bag-case-ghost" src="@caseItem.IconPath" style="width: @(ghost.w)px; height: @(ghost.h)px;" />
				</div>
			}
		</div>
	</div>

	@* THE LIVING VIOLET RING — the one cursor. Wraps the case item's card
	   (root-level absolute, never clipped by the scroll); position bound from
	   UpdateRing each tick, wave via imperative Style.Transform. z 60.
	   LANE: input — the case-zone hosts (stepper pill r21 / SELL / PRIMARY r26). *@
	<div @ref="ringRef" class="@RingClass()"
		 style="left: @(ringL)px; top: @(ringT)px; width: @(ringW)px; height: @(ringH)px;"></div>

	@* ====================== BEAST PICKER (sub-modal) ====================== *@
	@* Two doors, one picker: USE <item> ON... (XP orbs, runes, rerolls, gene
	   boosts) and EQUIP <item> TO... (held items → ItemManager.EquipHeldItem).
	   Rows are DIRECT scroll children (DOC-1 #12); a datum column on the right
	   shows the ONE number the item is about to change. Title plain, no
	   subtitle, no seam chip. MOTION: the overlay/panel enter — not wired.
	   LANE: input — W/S rows · Space pick · Q close; the ring on the focused
	   row (r21). *@
	@if (showPicker && pendingItem != null)
	{
		<div class="bag-picker-overlay" onclick=@ClosePicker>
			<div class="bag-picker" onclick:stopPropagation>
				<div class="bag-picker-head">
					<span class="bag-picker-title">@PickerTitle()</span>
					<div class="bag-picker-spacer"></div>
					<div class="bag-back" onclick=@ClosePicker onmouseover=@OnBackHover onmouseout=@OnBackOut>
						<span class="bag-back-label">BACK</span>
						<span class="bag-back-cap">Q</span>
					</div>
				</div>
				<div class="bag-picker-scroll">
					@{ var pickerMonsters = GetOwnedMonsters(); }
					@foreach (var monster in pickerMonsters)
					{
						var species = MonsterManager.Instance?.GetSpecies(monster.SpeciesId);
						var datum = GetPickerDatum(monster);
						<div class="bag-picker-row" onclick=@(() => OnPickerRowClick(monster)) onmouseover=@OnPickerRowHover onmouseout=@OnPickerRowOut>
							<div class="bag-picker-sprite">
								@if (species != null && !string.IsNullOrEmpty(species.IconPath))
								{
									<img class="bag-picker-sprite-img" src="@GetMonsterSprite(monster)" />
								}
							</div>
							<div class="bag-picker-info">
								<span class="bag-picker-name">@monster.Nickname</span>
								<span class="bag-picker-sub">@PickerSubText(monster, species)</span>
							</div>
							<div class="bag-picker-datum">
								@if (datum.label != null)
								{
									<span class="bag-picker-datum-label">@datum.label</span>
									<span class="@("bag-picker-datum-value" + (datum.dim ? " dim" : ""))">@datum.value</span>
								}
							</div>
						</div>
					}
				</div>
			</div>
		</div>
	}

	@* Toast — FAILURES + used-on (the success sell beat is the balance tick).
	   MOTION: the shipped toastRise/toastFall recipe is kept in the SCSS. *@
	@if (!string.IsNullOrEmpty(toastMessage))
	{
		<div class="@("bag-toast " + (toastSuccess ? "success" : "error") + (toastExiting ? " exiting" : ""))">
			<span class="bag-toast-text">@toastMessage</span>
		</div>
	}
</root>

@code {
	// Localization — routed only where keys already exist. LANE: audit (loc) —
	// "TAMER" · "BACK" · "CYCLE" · "EQUIP TO..." · "SELL" · "HOLD" · "VALUE" ·
	// "N / 3 EQUIPPED" · the empty-state lines · the picker titles have no
	// keys. Dead ui.inventory.* keys are listed in the lane report (not deleted).
	private string L( string key ) => LocalizationManager.Get( key );

	public static bool IsVisible { get; set; } = false;

	// ── Filter state (the FilterBar rebinds from these) ──────────
	private string currentCategory = "all";   // all · consumable · boost · held · relic · material
	private string currentSort = "recent";    // recent · name · quantity · value · rarity
	private bool sortAscending = false;       // false = the natural order (newest / most / A→Z first)
	private string searchQuery = "";

	// Selection — null = the case shows the first item in render order.
	private ItemDefinition selectedItem;
	private int sellQty = 1;                  // reset to 1 on every selection change

	// Hold-to-sell
	private bool isHoldingSell = false;
	private float holdProgress = 0f;
	private const float HoldDuration = 0.5f;

	// Toast
	private string toastMessage = "";
	private bool toastSuccess = false;
	private bool toastExiting = false;
	private float toastTimer = 0f;
	private const float ToastDuration = 3f;

	// Beast picker — two doors, one overlay.
	private enum PickerMode { Consumable, Held }
	private bool showPicker = false;
	private PickerMode pickerMode = PickerMode.Consumable;
	private ItemDefinition pendingItem = null;

	// Hover guards (blip once per element)
	private string hoveredCardId = null;
	private bool hoveredBack, hoveredQty, hoveredSell, hoveredPickerRow;

	// Balance pulse hook (MOTION) — keyed per sell.
	private float goldFlashUntil = 0f;
	private int lastGoldValue = -1;
	private int sellBeatVersion = 0;
	private bool IsGoldFlash => RealTime.Now < goldFlashUntil;

	private static string _pendingBattleCategory = null;

	// Refs
	private FilterBar filterBar;
	private Panel gridRef;
	private Panel sbTrackRef, sbThumbRef;
	private Panel ringRef;

	// ============================================================
	// LANE: input — THE ONE-DEVICE FLAG (the shop's recipe, ported because
	// FilterBar.KbMode and every .mouse-mode gate in the SCSS read it).
	// Root .kbd-mode / .mouse-mode; any nav / confirm / back key takes the
	// keyboard and stamps the mouse position; the mouse reclaims only after
	// REAL travel (≥3px). Hover handlers ignore events in kb mode.
	// ============================================================
	private enum InputDevice { Mouse, Keyboard }
	private InputDevice lastInputDevice = InputDevice.Mouse;
	private bool IsKbMode => lastInputDevice == InputDevice.Keyboard;
	private Vector2 _kbTakeoverMousePos = new Vector2( -9999f, -9999f );
	private string RootClass => "inventory-panel " + (IsVisible ? "visible " : "") + (IsKbMode ? "kbd-mode" : "mouse-mode");

	private void SetInputDevice( InputDevice dev )
	{
		if ( lastInputDevice == dev ) return;
		lastInputDevice = dev;
		if ( dev == InputDevice.Keyboard )
		{
			_kbTakeoverMousePos = Mouse.Position;
			hoveredCardId = null;
			hoveredBack = hoveredQty = hoveredSell = hoveredPickerRow = false;
		}
	}

	private void OnRootMouseMove()
	{
		if ( IsKbMode && (Mouse.Position - _kbTakeoverMousePos).Length >= 3f )
			SetInputDevice( InputDevice.Mouse );
	}

	// ── Open / close ─────────────────────────────────────────────
	public static void Show()
	{
		IsVisible = true;
		if ( IsInBattleMode() ) _pendingBattleCategory = "consumable";
		SoundManager.PlayPopup();
	}
	public static void Close() { IsVisible = false; SoundManager.PlayPopdown(); }
	public static void Toggle()
	{
		if ( IsVisible ) Close(); else Show();
	}

	private void OnBackClicked() { SetInputDevice( InputDevice.Mouse ); SoundManager.PlayClick(); Close(); }
	private void OnBackHover() { if ( IsKbMode || hoveredBack ) return; hoveredBack = true; SoundManager.PlayHover(); }
	private void OnBackOut() => hoveredBack = false;

	// ── FilterBar menus — built once; labels via the existing keys ──
	private List<FilterBar.MenuItem> _categoryMenu;
	private List<FilterBar.MenuItem> CategoryMenu => _categoryMenu ??= new()
	{
