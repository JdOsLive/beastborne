@using Sandbox;
@using Sandbox.UI;
@using System.Linq;
@using Beastborne.Core;
@using Beastborne.Data;
@using Beastborne.Systems;
@namespace Beastborne.UI.Components
@inherits Panel

<root class="@(isExpanded ? "expanded" : "collapsed") @(hasUnread ? "has-unread" : "")">
	<!-- Drag wrapper receives the translate; chat-overlay keeps its scale
	     open/close transition unaffected. -->
	<div class="chat-drag-wrap" style="@GetDragStyle()">
	<div class="chat-overlay @(isExpanded ? "open" : "")">
			<!-- Header. Drag handle is ONLY the title area (header-left) so
			     the close button in header-right doesn't hijack click events
			     by triggering drag-start on its mousedown. The skewed blue
			     seam chip carries the panel identity (chat blue = PawPad tile). -->
			<div class="chat-header">
				<div class="header-left" onmousedown=@OnDragStart>
					<iconify icon="lucide:grip-horizontal" Size=@(16) Color="rgba(74, 168, 255, 0.4)" />
					<div class="chat-seam"><span class="seam-text">@L("ui.chat.title")</span></div>
				</div>
				<div class="header-right">
					<div class="online-chip">
						<div class="online-dot"><span> </span></div>
						<span class="online-count">@GetOnlineCount() @L("ui.chat.online")</span>
					</div>
					<button class="chat-close" onclick=@ToggleChat><iconify icon="lucide:x" Size=@(16) Color="rgba(255, 255, 255, 0.85)" /></button>
				</div>
			</div>

			<!-- Channel Tabs -->
			<div class="channel-tabs">
				<div class="ch-tab @(currentChannel == "global" ? "active" : "")" onclick=@(() => SetChannel("global"))><span>@L("ui.chat.global")</span></div>
				@if ( GuildManager.Instance?.IsInGuild == true )
				{
					<div class="ch-tab @(currentChannel == "guild" ? "active" : "")" onclick=@(() => SetChannel("guild"))><span>@L("ui.chat.guild_tab")</span></div>
				}
				<div class="ch-tab @(currentChannel == "trade" ? "active" : "")" onclick=@(() => SetChannel("trade"))><span>@L("ui.chat.trade_tab")</span></div>
			</div>

			<!-- Messages -->
			<div class="chat-messages" @ref="messagesContainer">
				@{ var channelMessages = GetMessages(); }
				@if (channelMessages.Count == 0 && currentChannel != "global")
				{
					<div class="chat-empty">
						<div class="chat-empty-icon">
							@if (currentChannel == "guild")
							{
								<iconify icon="lucide:shield" Size=@(44) Color="rgba(74, 168, 255, 0.45)" />
							}
							else if (currentChannel == "trade")
							{
								<iconify icon="lucide:coins" Size=@(44) Color="rgba(251, 191, 36, 0.55)" />
							}
						</div>
						<span class="chat-empty-label">@L(currentChannel == "guild" ? "ui.chat.empty_guild_title" : "ui.chat.empty_trade_title")</span>
						<span class="chat-empty-hint">@L(currentChannel == "guild" ? "ui.chat.empty_guild_hint" : "ui.chat.empty_trade_hint")</span>
					</div>
				}
				@foreach (var message in channelMessages)
				{
					@if (message.Type == ChatMessageType.Player || message.Type == ChatMessageType.GuildChat)
					{
						<!-- Player / Guild Message -->
						<div class="msg @(IsOwnMessage(message) ? "own" : "")">
							<div class="msg-avatar av-@message.ResolvedNameColor">
								<img src="avatar:@message.SteamId" />
								@{
									var playerLevel = GetPlayerLevel(message);
								}
								@if (playerLevel > 0)
								{
									<div class="lv-pip"><span>@playerLevel</span></div>
								}
							</div>
							<div class="msg-body">
								<div class="msg-top">
									@if (message.IsDeveloper)
									{
										<span class="role-pill dev">DEV</span>
									}
									@if (message.Type == ChatMessageType.GuildChat)
									{
										<span class="role-pill guild">GUILD</span>
									}
									<span class="msg-name c-@message.ResolvedNameColor">@message.PlayerName</span>
									<span class="msg-time">@message.FormattedTime</span>
								</div>
								<span class="msg-text">@message.Content</span>
							</div>
						</div>
					}
					else if (message.Type == ChatMessageType.BeastShowcase)
					{
						@{
							var beSpecies = !string.IsNullOrEmpty(message.ShowcaseSpeciesId)
								? MonsterManager.Instance?.GetSpecies(message.ShowcaseSpeciesId)
								: null;
							var beOffsetX = beSpecies?.IconOffsetX ?? 0f;
							var beOffsetY = beSpecies?.IconOffsetY ?? 0f;
						}
						<!-- Beast Showcase -->
						<div class="msg @(IsOwnMessage(message) ? "own" : "")">
							<div class="msg-avatar av-@message.ResolvedNameColor">
								<img src="avatar:@message.SteamId" />
							</div>
							<div class="msg-body">
								<div class="msg-top">
									@if (message.IsDeveloper)
									{
										<span class="role-pill dev">DEV</span>
									}
									<span class="msg-name c-@message.ResolvedNameColor">@message.PlayerName</span>
									<span class="msg-time">@message.FormattedTime</span>
								</div>
								<div class="beast-embed @message.ShowcaseElement.ToLower()" onclick=@(() => ShowShowcasePopup(message))>
									<div class="be-art">
										@if (!string.IsNullOrEmpty(message.IconPath))
										{
											<img src="@message.IconPath" style="margin-left: @(beOffsetX - 18)px; margin-top: @(beOffsetY)px" />
										}
									</div>
									<div class="be-info">
										<span class="be-name">@message.ShowcaseNickname</span>
										<div class="be-stats">
											<span class="be-stat">LV @message.ShowcaseLevel</span>
											<span class="be-sep">·</span>
											<span class="be-stat">PWR @message.ShowcasePower</span>
											<span class="be-sep">·</span>
											<span class="be-rarity @message.ShowcaseRarity.ToLower()">@message.ShowcaseRarity.ToUpper()</span>
										</div>
									</div>
								</div>
							</div>
						</div>
					}
					else if (message.Type == ChatMessageType.TamerCardShowcase)
					{
						@{
							var tcGenderClass = (message.CardGender?.ToLower() ?? "male") == "female" ? "female" : "male";
							var tcAvatarPath = tcGenderClass == "female"
								? "ui/characters/female/female_tamer.png"
								: "ui/characters/male/male_tamer.png";
							var tcExpBg = !string.IsNullOrEmpty( message.CardFavoriteExpeditionId )
								? ExpeditionManager.Instance?.GetExpedition( message.CardFavoriteExpeditionId )?.BackgroundImage
								: null;
							var tcFavSpecies = !string.IsNullOrEmpty( message.CardFavoriteSpeciesId )
								? MonsterManager.Instance?.GetSpecies( message.CardFavoriteSpeciesId )
								: null;
							var tcRankColor = CompetitiveManager.GetRankColor( message.CardArenaRank ?? "Unranked" );
						}
						<!-- Tamer Card Showcase -->
						<div class="msg @(IsOwnMessage(message) ? "own" : "")">
							<div class="msg-avatar av-@message.ResolvedNameColor">
								<img src="avatar:@message.SteamId" />
							</div>
							<div class="msg-body">
								<div class="msg-top">
									@if (message.IsDeveloper)
									{
										<span class="role-pill dev">DEV</span>
									}
									<span class="msg-name c-@message.ResolvedNameColor">@message.PlayerName</span>
									<span class="msg-time">@message.FormattedTime</span>
								</div>
								<span class="tc-shared-text">shared their Tamer Card</span>
								<div class="tc-showcase" onclick=@(() => ShowTamerCardPopup(message))>
									@if ( tcExpBg != null )
									{
										<div class="tc-showcase-bg" style="background-image: url(@tcExpBg)"></div>
									}
									<div class="tc-showcase-content">
										<div class="tc-showcase-avatar @tcGenderClass">
											<img src="@tcAvatarPath" />
										</div>
										<div class="tc-showcase-info">
											<div class="tc-showcase-name-row">
												@if (message.IsDeveloper)
												{
													<span class="role-pill dev">DEV</span>
												}
												<span class="tc-showcase-name">@message.CardName</span>
											</div>
											<span class="tc-showcase-title">@message.CardTitle</span>
											<div class="tc-showcase-stats">
												<span class="tc-showcase-level">Lv. @message.CardLevel</span>
												<span class="tc-showcase-rank" style="color: @tcRankColor">@(message.CardArenaRank ?? "Unranked")</span>
												<span class="tc-showcase-pts">@message.CardArenaPoints pts</span>
											</div>
										</div>
									</div>
									@if ( tcFavSpecies != null && !string.IsNullOrEmpty( tcFavSpecies.IconPath ) )
									{
										<img class="tc-showcase-beast" src="@tcFavSpecies.IconPath" />
									}
								</div>
							</div>
						</div>
					}
					else if (message.Type == ChatMessageType.Join)
					{
						<!-- Join Message -->
						<div class="msg-join">
							<span class="arrow-in">→</span>
							<span class="jn">@message.PlayerName</span>
							<span class="join-text">joined the server</span>
						</div>
					}
					else if (message.Type == ChatMessageType.Leave)
					{
						<!-- Leave Message -->
						<div class="msg-join">
							<span class="arrow-out">←</span>
							<span class="jn">@message.PlayerName</span>
							<span class="join-text">left the server</span>
						</div>
					}
					else if (message.Type == ChatMessageType.Achievement)
					{
						<!-- Achievement Message -->
						<div class="msg-achievement">
							<div class="ach-icon-wrap">
								@if (!string.IsNullOrEmpty(message.IconPath))
								{
									<img class="sys-icon-img" src="@message.IconPath" />
								}
								else
								{
									<iconify icon="lucide:trophy" Size=@(20) Color="#fcd34d" />
								}
							</div>
							<span class="sys-text">@message.Content</span>
						</div>
					}
					else if (message.Type == ChatMessageType.Trade)
					{
						<!-- Trade Message -->
						<div class="msg @(IsOwnMessage(message) ? "own" : "")">
							<div class="msg-avatar av-@message.ResolvedNameColor">
								<img src="avatar:@message.SteamId" />
							</div>
							<div class="msg-body">
								<div class="msg-top">
									@if (message.IsDeveloper)
									{
										<span class="role-pill dev">DEV</span>
									}
									<span class="role-pill trade">TRADE</span>
									<span class="msg-name c-@message.ResolvedNameColor">@message.PlayerName</span>
									<span class="msg-time">@message.FormattedTime</span>
								</div>
								<span class="msg-text trade-text">@message.Content</span>
							</div>
						</div>
					}
					else
					{
						<!-- System Message -->
						<div class="msg-system">
							<div class="sys-icon-slot">
								<iconify icon="lucide:lightbulb" Size=@(18) Color="#9ecfff" />
							</div>
							<span class="sys-text">@message.Content</span>
							@if (message.Content.Contains("discord.gg"))
							{
								<button class="sys-discord-btn" onclick=@CopyDiscordLink>
									<span>@discordBtnText</span>
								</button>
							}
						</div>
					}
				}
			</div>

			<!-- Input Area -->
			<div class="chat-input-area">
				<div class="input-row">
					<ChatInputBox @ref="chatInputBox" OnSubmit=@OnSendMessage />
					<button class="send-btn" onclick=@OnSendMessage>
						<div class="send-ring"></div>
						<iconify icon="lucide:send" Size=@(20) Color="#071523" />
					</button>
				</div>
			</div>
		</div>
	</div>
	@if ( _isDragging )
	{
		<!-- Drag shield: full-viewport transparent overlay that captures
		     mouse events DURING drag. Placed AFTER chat-overlay in the DOM
		     so it wins hit-testing in s&box (which appears to use DOM order
		     in addition to z-index). Sibling of drag-wrap so the shield
		     itself does NOT inherit the popup's transform — coordinate
		     system stays stable, no feedback-loop shake. -->
		<div class="chat-drag-shield" onmousemove=@OnDragMove onmouseup=@OnDragEnd></div>
	}
</root>

@code {
	// Localization helper
	private string L( string key ) => LocalizationManager.Get( key );
	private string L( string key, params object[] args ) => LocalizationManager.Get( key, args );

	private bool isExpanded = false;
	private bool hasUnread = false;
	private int unreadCount = 0;
	private string currentChannel = "global";
	private Panel messagesContainer;
	private ChatInputBox chatInputBox;

	// ─── Drag state ────────────────────────────────────────────────
	// Drag the chat popup around the screen by the header. Uses the same
	// onmousedown/onmousemove/onmouseup pattern as RadioWidget's volume
	// slider. `_dragOffsetX/Y` is the cumulative offset FROM the default
	// anchored position (bottom-right above the command bar), applied via
	// `transform: translate(...)`. Position persists across open/close.
	private bool _isDragging = false;
	private bool _needsDragAnchor = false;
	private float _dragStartMouseX, _dragStartMouseY;
	private float _dragStartOffsetX, _dragStartOffsetY;
	private float _dragOffsetX = 0f, _dragOffsetY = 0f;

	private void OnDragStart( PanelEvent e )
	{
		_isDragging = true;
		// `MousePosition` inside the handler of the chat-header reports
		// coords relative to the header's own box. The header IS moving
		// (as part of the popup), so this is NOT stable by itself.
		// But we only use OnDragStart once at the click moment — we
		// capture the CURRENT offset and delegate live tracking to the
		// drag shield. Record the shield-space mouse position lazily on
		// the first OnDragMove (see that handler).
		_dragStartOffsetX = _dragOffsetX;
		_dragStartOffsetY = _dragOffsetY;
		_needsDragAnchor = true;
		StateHasChanged(); // force drag-shield into DOM
	}

	private void OnDragMove( PanelEvent e )
	{
		if ( !_isDragging ) return;

		// First move after drag start: anchor to the current mouse position
		// on the SHIELD (a fixed/static element, so shield-local coords are
		// effectively viewport-absolute and immune to the popup's own motion).
		if ( _needsDragAnchor )
		{
			_dragStartMouseX = MousePosition.x;
			_dragStartMouseY = MousePosition.y;
			_needsDragAnchor = false;
			return;
		}

		_dragOffsetX = _dragStartOffsetX + ( MousePosition.x - _dragStartMouseX );
		_dragOffsetY = _dragStartOffsetY + ( MousePosition.y - _dragStartMouseY );
		StateHasChanged();
	}

	private void OnDragEnd( PanelEvent e )
	{
		_isDragging = false;
		var tamer = TamerManager.Instance?.CurrentTamer;
		if (tamer != null)
		{
			tamer.ChatPanelOffsetX = _dragOffsetX;
			tamer.ChatPanelOffsetY = _dragOffsetY;
			TamerManager.Instance?.SaveToCloud();
		}
		StateHasChanged();
	}

	private string GetDragStyle()
	{
		if ( _dragOffsetX == 0f && _dragOffsetY == 0f ) return "";
		// InvariantCulture via format string so s&box CSS gets `.` decimal
		return string.Format( System.Globalization.CultureInfo.InvariantCulture,
			"transform: translate({0:F0}px, {1:F0}px);", _dragOffsetX, _dragOffsetY );
	}

	// Incoming message ping debounce — play at most once per 1.5s, never when focused
	private RealTimeSince _lastIncomingPing;

	// Static instance for external access (bottom bar toggle)
	public static ChatPanel Instance { get; private set; }

	// Track if we're focused on chat input
	public static bool IsChatFocused { get; set; } = false;

	/// <summary>
	/// Get unread message count for badge display
	/// </summary>
	public static int UnreadMessageCount => Instance?.unreadCount ?? 0;

	private void ShowShowcasePopup(ChatMessage message)
	{
		BeastShowcasePopup.Show(message);
	}

	private void ShowTamerCardPopup(ChatMessage message)
	{
		TamerCardShowcasePopup.Show(message);
	}

	protected override void OnAfterTreeRender(bool firstTime)
	{
		if (firstTime)
		{
			Instance = this;

			if (ChatManager.Instance != null)
			{
				ChatManager.Instance.OnMessageReceived += OnMessageReceived;
				ChatManager.Instance.OnMessagesCleared += OnMessagesCleared;
			}

			var tamer = TamerManager.Instance?.CurrentTamer;
			if (tamer != null)
			{
				_dragOffsetX = tamer.ChatPanelOffsetX;
				_dragOffsetY = tamer.ChatPanelOffsetY;
			}
		}
	}

	public override void OnDeleted()
	{
		if (ChatManager.Instance != null)
		{
			ChatManager.Instance.OnMessageReceived -= OnMessageReceived;
			ChatManager.Instance.OnMessagesCleared -= OnMessagesCleared;
		}
		IsChatFocused = false;
	}

	private void OnMessageReceived(ChatMessage message)
	{
		if (!isExpanded)
		{
			hasUnread = true;
			unreadCount++;
			// Debounced ping: play once per 1.5s, never when focused
			if (!IsChatFocused && _lastIncomingPing > 1.5f)
			{
				SoundManager.PlayHover();
				_lastIncomingPing = 0;
			}
		}
		else
		{
			_ = ScrollToBottomDelayed();
		}

		StateHasChanged();
	}

	private void OnMessagesCleared()
	{
		hasUnread = false;
		unreadCount = 0;
		StateHasChanged();
	}

	public void ToggleChat()
	{
		isExpanded = !isExpanded;

		if (isExpanded)
		{
			SoundManager.PlayPopup();
			hasUnread = false;
			unreadCount = 0;
			_ = FocusInputDelayed();
			_ = ScrollToBottomDelayed();
		}
		else
		{
			SoundManager.PlayPopdown();
			IsChatFocused = false;
		}
	}

	private async Task FocusInputDelayed()
	{
		await Task.Delay(100);
		chatInputBox?.FocusInput();
		IsChatFocused = true;
	}

	private async Task ScrollToBottomDelayed()
	{
		await Task.Delay(50);
		if (messagesContainer != null)
		{
			messagesContainer.ScrollOffset = new Vector2(0, messagesContainer.ScrollSize.y);
		}
	}

	private void OnSendMessage()
	{
		var text = chatInputBox?.GetText() ?? "";
		if (string.IsNullOrWhiteSpace(text)) return;

		if (currentChannel == "guild")
			ChatManager.Instance?.SendGuildMessage(text);
		else if (currentChannel == "trade")
			ChatManager.Instance?.SendTradeMessage(text);
		else
			ChatManager.Instance?.SendMessage(text);

		chatInputBox?.ClearText();
		SoundManager.PlayForward();
		chatInputBox?.FocusInput();
	}

	private const string DiscordInviteUrl = "https://discord.gg/dJTTyCqKru";

	// Discord copy button
	private string discordBtnText = "Copy Link";

	private async void CopyDiscordLink()
	{
		SoundManager.PlayClick();
		Clipboard.SetText( DiscordInviteUrl );
		discordBtnText = L("ui.chat.copied");
		StateHasChanged();
		await Task.Delay( 2000 );
		discordBtnText = L("ui.chat.copy_link");
		StateHasChanged();
	}

	private List<ChatMessage> GetMessages()
	{
		var messages = ChatManager.Instance?.GetRecentMessages(100) ?? new List<ChatMessage>();
		if (currentChannel == "guild")
			return messages.Where(m => m.Type == ChatMessageType.GuildChat).TakeLast(50).ToList();
		if (currentChannel == "trade")
			return messages.Where(m => m.Type == ChatMessageType.Trade).TakeLast(50).ToList();
		// Global: everything except guild-only and trade-only messages
		return messages.Where(m => m.Type != ChatMessageType.GuildChat && m.Type != ChatMessageType.Trade).TakeLast(50).ToList();
	}

	private int GetOnlineCount()
	{
		return ChatManager.Instance?.OnlinePlayerCount ?? 1;
	}

	private void SetChannel(string channel)
	{
		if (currentChannel == channel) return;
		currentChannel = channel;
		SoundManager.PlayTabSwitch();
	}

	private bool IsOwnMessage(ChatMessage message)
	{
		var localId = ChatManager.Instance?.LocalSteamId ?? 0;
		return localId != 0 && message.SteamId == localId;
	}

	private int GetPlayerLevel(ChatMessage message)
	{
		// Local player — get from current tamer
		if (message.SteamId == (ChatManager.Instance?.LocalSteamId ?? 0))
		{
			return TamerManager.Instance?.CurrentTamer?.Level ?? 0;
		}

		// Remote players — card showcase messages carry level data
		if (message.CardLevel > 0) return message.CardLevel;

		return 0;
	}

	public override void Tick()
	{
		base.Tick();

		if (isExpanded)
		{
			if (Input.Pressed("Escape"))
			{
				isExpanded = false;
				IsChatFocused = false;
				SoundManager.PlayPopdown();
			}
		}
		else
		{
			if (Input.Pressed("Chat") || Input.Pressed("Enter"))
			{
				isExpanded = true;
				hasUnread = false;
				unreadCount = 0;
				_ = FocusInputDelayed();
				SoundManager.PlayPopup();
			}
		}
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add(isExpanded);
		hash.Add(hasUnread);
		hash.Add(unreadCount);
		hash.Add(currentChannel);
		hash.Add(chatInputBox?.GetText());
		hash.Add(ChatManager.Instance?.Messages?.Count ?? 0);
		hash.Add(GetOnlineCount());
		// Drag state — without these the popup won't visually move while being
		// dragged (s&box only re-renders when BuildHash changes). Matches the
		// RadioWidget / NotificationPanel / ActiveEffectsPanel drag-hash pattern.
		hash.Add(_isDragging);
		hash.Add((int)_dragOffsetX);
		hash.Add((int)_dragOffsetY);
		return hash.ToHashCode();
	}
}
