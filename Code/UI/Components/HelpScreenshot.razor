@namespace Beastborne.UI.Components
@using Sandbox;
@using Sandbox.UI;
@inherits Panel

@*
    HelpScreenshot — Persona-stamp framed screenshot slot for the Help panel.

    Two variants via Variant prop:
        "wide"    (default) — full content-width hero image
        "inline"           — half-width, can sit beside text

    When Src is empty, renders a dashed-border placeholder with a camera icon
    and "screenshot pending" caption — lets us ship the redesign with all
    slots in place and the user fills them as they take screenshots.

    Caption renders below the image in italic uppercase letterspaced style.

    Usage:
        <HelpScreenshot Src="ui/help/screenshots/expedition-map.png"
                        Caption="Wave map, mid-run" />

        <HelpScreenshot Src="" Caption="Starter selection screen" Variant="inline" />
*@

<root class="help-screenshot variant-@ShotVariant @(string.IsNullOrEmpty(ShotSrc) ? "is-empty" : "is-filled")">
    <div class="help-screenshot-frame">
        @if (string.IsNullOrEmpty(ShotSrc))
        {
            <div class="help-screenshot-placeholder">
                <iconify icon="lucide:camera" Size=@(36) Color="rgba(196, 181, 253, 0.5)" />
                <span class="help-screenshot-placeholder-label">Screenshot pending</span>
            </div>
        }
        else
        {
            <img class="help-screenshot-img" src="@ShotSrc" />
        }
    </div>
    @if (!string.IsNullOrEmpty(ShotCaption))
    {
        <span class="help-screenshot-caption">@ShotCaption</span>
    }
</root>

@code {
    [Property] public string ShotSrc { get; set; } = "";
    [Property] public string ShotCaption { get; set; } = "";
    [Property] public string ShotVariant { get; set; } = "wide";

    protected override int BuildHash()
    {
        return HashCode.Combine(ShotSrc, ShotCaption, ShotVariant);
    }
}
