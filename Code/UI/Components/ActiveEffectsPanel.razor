@namespace Beastborne.UI.Components
@using Sandbox;
@using Sandbox.UI;
@using Beastborne.Core;
@using Beastborne.Data;
@using Beastborne.Systems;
@inherits Panel

<div class="active-effects-panel @(isExpanded ? "expanded" : "")">
<div class="effects-drag-wrap" style="@GetDragStyle()">
	<div class="effects-popup @(isExpanded ? "open" : "")">
		<div class="bg-scroll"><img src="ui/bg-patterns/bg-effects.svg" /></div>
		<!-- Header -->
		<div class="ep-header">
			<div class="ep-title" onmousedown=@OnDragStart>
				<iconify icon="lucide:grip-horizontal" Size=@(16) Color="rgba(139,92,246,0.45)" />
				<iconify icon="lucide:sparkles" Size=@(22) Color="#c4b5fd" />
				<span>@L("ui.effects.title")</span>
			</div>
			<button class="close-btn" onclick=@ToggleExpanded>
				<iconify icon="lucide:x" Size=@(15) Color="rgba(255, 255, 255, 0.85)" />
			</button>
		</div>

		<!-- Tabs -->
		<div class="ep-tabs">
			<div class="ep-tab @(currentTab == "boosts" ? "active" : "")" onclick=@(() => SetTab("boosts"))>
				<span>@L("ui.effects.boosts_relics")</span>
				<span class="ep-tab-count">@GetBoostsRelicsCount()</span>
			</div>
			<div class="ep-tab @(currentTab == "skills" ? "active" : "")" onclick=@(() => SetTab("skills"))>
				<span>@L("ui.effects.skill_bonuses")</span>
				<span class="ep-tab-count">@GetActiveSkillCount()</span>
			</div>
		</div>
		<div class="ep-divider"></div>

		<!-- Scroll Content — all items must be direct children for s&box scroll -->
		<div class="ep-scroll">
			@if (currentTab == "boosts")
			{
				@{
					var boosts = GetActiveBoosts();
					var hasEliteInk = HasEliteInk();
				}

				<!-- Boosts Section Header -->
				<div class="ep-sec-head">
					<div class="ep-sec-title">
						<iconify icon="lucide:zap" Size=@(13) Color="#c4b5fd" />
						<span>@L("ui.effects.boosts")</span>
					</div>
					<span class="ep-sec-count @(GetBoostSectionCount() == 0 ? "zero" : "")">@GetBoostSectionCount()</span>
				</div>

				@if (TamerManager.IsDoubleXPActive)
				{
					<div class="boost-card event-boost">
						<div class="boost-accent event"></div>
						<div class="boost-icon event"><span>2X</span></div>
						<div class="boost-info">
							<span class="boost-name">@L("ui.effects.double_xp")</span>
							<span class="boost-desc">@L("ui.effects.double_xp_desc")</span>
						</div>
						<span class="boost-timer">@FormatEventTime()</span>
						<span class="boost-server">@L("ui.effects.event")</span>
					</div>
				}

				@if (LiveEventManager.IsLaunchWeekXPActive)
				{
					<div class="boost-card event-boost">
						<div class="boost-accent event"></div>
						<div class="boost-icon event"><span>+50%</span></div>
						<div class="boost-info">
							<span class="boost-name">@L("ui.effects.launch_week_xp")</span>
							<span class="boost-desc">@L("ui.effects.launch_week_xp_desc")</span>
						</div>
						<span class="boost-timer">@FormatLaunchWeekTime()</span>
						<span class="boost-server">@L("ui.effects.event")</span>
					</div>
				}

				@if (boosts.Count == 0 && !hasEliteInk && !TamerManager.IsDoubleXPActive && !LiveEventManager.IsLaunchWeekXPActive)
				{
					<div class="ep-empty-full">
						<div class="ep-empty-icon">
							<iconify icon="lucide:circle-off" Size=@(26) Color="#8b5cf6" />
						</div>
						<span class="ep-empty-label">@L("ui.effects.no_boosts")</span>
						<span class="ep-empty-hint">@L("ui.effects.no_boosts_hint")</span>
					</div>
				}
				else
				{
					@foreach (var boost in boosts)
					{
						@{
							var isExpiringSoon = boost.TimeRemaining.TotalSeconds < 60;
							var isExpiring = boost.TimeRemaining.TotalMinutes < 5;
						}
						<div class="boost-card @(isExpiringSoon ? "expiring-soon" : "")">
							<div class="boost-accent @GetBoostIconClass(boost.Type)"></div>
							<div class="boost-icon @GetBoostIconClass(boost.Type)">
								<img src="@GetBoostIconPath(boost.Type)" />
							</div>
							<div class="boost-info">
								<span class="boost-name">@GetBoostLabel(boost.Type)</span>
								<span class="boost-desc">@GetBoostDescription(boost.Type, boost.Multiplier)</span>
								@if (boost.IsServer && !string.IsNullOrEmpty(boost.ActivatedBy))
								{
									<span class="boost-source">@L("ui.effects.activated_by", boost.ActivatedBy)</span>
								}
							</div>
							<span class="boost-timer @(isExpiring ? "expiring" : "")">@FormatBoostTime(boost.TimeRemaining)</span>
							@if (boost.IsServer)
							{
								<span class="boost-server">@L("ui.effects.server")</span>
							}
						</div>
					}

					@if (hasEliteInk)
					{
						@{
							var inkExpiringSoon = GetEliteInkRemaining().TotalSeconds < 60;
							var inkExpiring = GetEliteInkRemaining().TotalMinutes < 5;
						}
						<div class="boost-card @(inkExpiringSoon ? "expiring-soon" : "")">
							<div class="boost-accent ink"></div>
							<div class="boost-icon ink"><img src="ui/items/consumables/elite_ink.png" /></div>
							<div class="boost-info">
								<span class="boost-name">@L("ui.effects.elite_ink")</span>
								<span class="boost-desc">@L("ui.effects.elite_ink_desc")</span>
							</div>
							<span class="boost-timer @(inkExpiring ? "expiring" : "")">@FormatBoostTime(GetEliteInkRemaining())</span>
						</div>
					}
				}

				<div class="ep-divider"></div>

				<!-- Relics Section Header -->
				@{
					var relics = GetEquippedRelics();
				}

				<div class="ep-sec-head">
					<div class="ep-sec-title">
						<iconify icon="lucide:gem" Size=@(13) Color="#c4b5fd" />
						<span>@L("ui.effects.equipped_relics")</span>
					</div>
					<span class="ep-sec-count @(relics.Count == 0 ? "zero" : "")">@relics.Count / 3</span>
				</div>

				@if (relics.Count == 0)
				{
					<div class="ep-empty"><span>@L("ui.effects.no_relics")</span></div>
				}
				else
				{
					@foreach (var relic in relics)
					{
						<div class="relic-card @GetRarityClass(relic.Rarity)">
							<div class="relic-icon"><img src="@relic.IconPath" /></div>
							<div class="relic-info">
								<span class="relic-name">@relic.Name</span>
								<span class="relic-desc">@GetRelicEffect(relic)</span>
							</div>
							<span class="relic-rarity-pill @GetRarityClass(relic.Rarity)">@relic.Rarity</span>
						</div>
					}
				}
			}
			else
			{
				@{
					var skills = GetActiveSkillBonuses();
				}

				<!-- Skill Bonuses Section Header -->
				<div class="ep-sec-head">
					<div class="ep-sec-title">
						<iconify icon="lucide:leaf" Size=@(13) Color="#c4b5fd" />
						<span>@L("ui.effects.skill_bonuses_header")</span>
					</div>
					<span class="ep-sec-count @(GetActiveSkillCount() == 0 ? "zero" : "")">@GetActiveSkillCount()</span>
				</div>

				@if (skills.Count == 0)
				{
					<div class="ep-empty"><span>@L("ui.effects.no_skill_bonuses")</span></div>
				}
				else
				{
					@foreach (var skill in skills)
					{
						<div class="skill-card">
							<div class="skill-icon"><span>@skill.Icon</span></div>
							<div class="skill-info">
								<span class="skill-name">@skill.Name</span>
								<span class="skill-desc">@skill.Description</span>
							</div>
							<span class="skill-rank"><img class="rank-icon" src="ui/icons/ranking/@GetRankIcon(skill.Rank)" /><span>@skill.Rank</span></span>
						</div>
					}
				}
			}
		</div>
	</div>
</div>
</div>
@if ( _isDragging )
{
	<div class="effects-drag-shield" onmousemove=@OnDragMove onmouseup=@OnDragEnd></div>
}

@code {
	// Localization helper
	private string L( string key ) => LocalizationManager.Get( key );
	private string L( string key, params object[] args ) => LocalizationManager.Get( key, args );

	private bool isExpanded = false;
	private string currentTab = "boosts";

	// ─── Drag state ────────────────────────────────────────────────
	private bool _isDragging = false;
	private bool _needsDragAnchor = false;
	private float _dragStartMouseX, _dragStartMouseY;
	private float _dragStartOffsetX, _dragStartOffsetY;
	private float _dragOffsetX = 0f, _dragOffsetY = 0f;

	private void OnDragStart( PanelEvent e )
	{
		_isDragging = true;
		_dragStartOffsetX = _dragOffsetX;
		_dragStartOffsetY = _dragOffsetY;
		_needsDragAnchor = true;
		StateHasChanged();
	}

	private void OnDragMove( PanelEvent e )
	{
		if ( !_isDragging ) return;
		if ( _needsDragAnchor )
		{
			_dragStartMouseX = MousePosition.x;
			_dragStartMouseY = MousePosition.y;
			_needsDragAnchor = false;
			return;
		}
		_dragOffsetX = _dragStartOffsetX + ( MousePosition.x - _dragStartMouseX );
		_dragOffsetY = _dragStartOffsetY + ( MousePosition.y - _dragStartMouseY );
		StateHasChanged();
	}

	private void OnDragEnd( PanelEvent e )
	{
		_isDragging = false;
		var tamer = TamerManager.Instance?.CurrentTamer;
		if (tamer != null)
		{
			tamer.EffectsPanelOffsetX = _dragOffsetX;
			tamer.EffectsPanelOffsetY = _dragOffsetY;
			TamerManager.Instance?.SaveToCloud();
		}
		StateHasChanged();
	}

	private string GetDragStyle()
	{
		if ( _dragOffsetX == 0f && _dragOffsetY == 0f ) return "";
		return string.Format( System.Globalization.CultureInfo.InvariantCulture,
			"transform: translate({0:F0}px, {1:F0}px);", _dragOffsetX, _dragOffsetY );
	}

	// Static instance for external access (bottom bar toggle)
	public static ActiveEffectsPanel Instance { get; private set; }

	public static bool IsEffectsExpanded { get; private set; } = false;

	/// <summary>
	/// Get total active effect count for badge display
	/// </summary>
	public static int TotalEffectCount => Instance?.GetTotalEffectCount() ?? 0;

	/// <summary>
	/// Compact rows for the PawPad's in-phone EFFECTS app (v9) — label +
	/// value pairs built from the same private data this panel renders.
	/// </summary>
	public static List<(string Label, string Value)> GetPhoneRows()
	{
		var rows = new List<(string, string)>();
		var inst = Instance;
		if ( inst == null ) return rows;
		foreach ( var b in inst.GetActiveBoosts() )
		{
			var t = b.TimeRemaining;
			var left = t.TotalHours >= 1 ? $"{(int)t.TotalHours}h {t.Minutes}m" : $"{t.Minutes}m {t.Seconds}s";
			rows.Add( ($"{b.Type} x{b.Multiplier:0.#}", left) );
		}
		foreach ( var s in inst.GetActiveSkillBonuses() )
			rows.Add( (s.Name, $"RANK {s.Rank}") );
		return rows;
	}

	protected override void OnAfterTreeRender( bool firstTime )
	{
		if ( firstTime )
		{
			Instance = this;
			var tamer = TamerManager.Instance?.CurrentTamer;
			if (tamer != null)
			{
				_dragOffsetX = tamer.EffectsPanelOffsetX;
				_dragOffsetY = tamer.EffectsPanelOffsetY;
			}
		}
	}

	public void ToggleExpanded()
	{
		isExpanded = !isExpanded;
		IsEffectsExpanded = isExpanded;
		if (isExpanded)
		{
			currentTab = "boosts";
			SoundManager.PlayPopup();
		}
		else
			SoundManager.PlayPopdown();
	}

	private void SetTab(string tab)
	{
		if (currentTab != tab)
		{
			currentTab = tab;
			SoundManager.PlayTabSwitch();
		}
	}

	private int GetTotalEffectCount()
	{
		return GetBoostSectionCount() + GetEquippedRelics().Count;
	}

	private int GetBoostsRelicsCount()
	{
		return GetBoostSectionCount() + GetEquippedRelics().Count;
	}

	private int GetBoostSectionCount()
	{
		return GetActiveBoosts().Count + (HasEliteInk() ? 1 : 0) + (TamerManager.IsDoubleXPActive ? 1 : 0) + (LiveEventManager.IsLaunchWeekXPActive ? 1 : 0);
	}

	private bool HasEliteInk()
	{
		return TamerManager.Instance?.CurrentTamer?.EliteInkExpiresAt > DateTime.Now;
	}

	private bool HasMasterInk()
	{
		return TamerManager.Instance?.CurrentTamer?.HasMasterInk == true
			|| ItemManager.Instance?.HasItem("boss_master_ink") == true;
	}

	private TimeSpan GetEliteInkRemaining()
	{
		var expiry = TamerManager.Instance?.CurrentTamer?.EliteInkExpiresAt ?? DateTime.MinValue;
		if (expiry <= DateTime.Now) return TimeSpan.Zero;
		return expiry - DateTime.Now;
	}

	private List<(ShopItemType Type, float Multiplier, TimeSpan TimeRemaining, bool IsServer, string ActivatedBy)> GetActiveBoosts()
	{
		return ShopManager.Instance?.GetAllActiveBoosts() ?? new();
	}

	private string GetBoostIconPath(ShopItemType type)
	{
		return type switch
		{
			ShopItemType.TamerXPBoost => "ui/items/boosts/tamer_xp_scroll.png",
			ShopItemType.BeastXPBoost => "ui/items/boosts/beast_xp_tome.png",
			ShopItemType.XPBoost => "ui/items/boosts/tamer_xp_scroll.png",
			ShopItemType.GoldBoost => "ui/items/boosts/gold_multiplier.png",
			ShopItemType.RareEncounter => "ui/items/boosts/rare_radar.png",
			ShopItemType.LuckyCharm => "ui/items/boosts/lucky_clover.png",
			_ => "ui/items/boosts/tamer_xp_scroll.png"
		};
	}

	private string GetBoostIconClass(ShopItemType type)
	{
		return type switch
		{
			ShopItemType.GoldBoost => "gold",
			ShopItemType.TamerXPBoost or ShopItemType.BeastXPBoost or ShopItemType.XPBoost => "xp",
			_ => "ink"
		};
	}

	private string GetBoostLabel(ShopItemType type)
	{
		return type switch
		{
			ShopItemType.TamerXPBoost => L("ui.effects.boost_tamer_xp"),
			ShopItemType.BeastXPBoost => L("ui.effects.boost_beast_xp"),
			ShopItemType.XPBoost => L("ui.effects.boost_xp"),
			ShopItemType.GoldBoost => L("ui.effects.boost_gold"),
			ShopItemType.RareEncounter => L("ui.effects.boost_lucky"),
			ShopItemType.LuckyCharm => L("ui.effects.boost_lucky"),
			_ => type.ToString()
		};
	}

	private string GetBoostDescription(ShopItemType type, float multiplier)
	{
		return type switch
		{
			ShopItemType.TamerXPBoost => L("ui.effects.boost_tamer_xp_desc", multiplier),
			ShopItemType.BeastXPBoost => L("ui.effects.boost_beast_xp_desc", multiplier),
			ShopItemType.XPBoost => L("ui.effects.boost_xp_desc", multiplier),
			ShopItemType.GoldBoost => L("ui.effects.boost_gold_desc", multiplier),
			ShopItemType.RareEncounter => L("ui.effects.boost_rare_desc", multiplier),
			ShopItemType.LuckyCharm => L("ui.effects.boost_lucky_desc", multiplier),
			_ => L("ui.effects.boost_generic_desc", multiplier)
		};
	}

	private string FormatBoostTime(TimeSpan time)
	{
		if (time.TotalHours >= 1)
			return $"{(int)time.TotalHours}h {time.Minutes}m";
		if (time.TotalMinutes >= 1)
			return $"{(int)time.TotalMinutes}m {time.Seconds}s";
		return $"{time.Seconds}s";
	}

	private string FormatEventTime()
	{
		var remaining = TamerManager.EventXPEnd - DateTime.UtcNow;
		if (remaining.TotalHours >= 1)
			return $"{(int)remaining.TotalHours}h {remaining.Minutes}m";
		if (remaining.TotalMinutes >= 1)
			return $"{(int)remaining.TotalMinutes}m";
		return L("ui.effects.ending_soon");
	}

	private string FormatLaunchWeekTime()
	{
		var remaining = LiveEventManager.LaunchWeekXPEnd - DateTime.UtcNow;
		if (remaining.TotalDays >= 1)
			return $"{(int)remaining.TotalDays}d {remaining.Hours}h";
		if (remaining.TotalHours >= 1)
			return $"{(int)remaining.TotalHours}h {remaining.Minutes}m";
		if (remaining.TotalMinutes >= 1)
			return $"{(int)remaining.TotalMinutes}m";
		return L("ui.effects.ending_soon");
	}

	private List<ItemDefinition> GetEquippedRelics()
	{
		var relicIds = TamerManager.Instance?.CurrentTamer?.EquippedRelics;
		if (relicIds == null || relicIds.Count == 0) return new();

		var relics = new List<ItemDefinition>();
		foreach (var id in relicIds)
		{
			var item = ItemManager.Instance?.GetItem(id);
			if (item != null)
				relics.Add(item);
		}
		return relics;
	}

	private string GetRarityClass(ItemRarity rarity)
	{
		return rarity.ToString().ToLower();
	}

	private string GetRelicEffect(ItemDefinition relic)
	{
		if (relic == null) return "";

		return relic.EffectType switch
		{
			ItemEffectType.PassiveGoldFind => L("ui.effects.relic_gold_find", relic.EffectValue),
			ItemEffectType.PassiveItemFind => L("ui.effects.relic_item_find", relic.EffectValue),
			ItemEffectType.PassiveCatchRate => L("ui.effects.relic_catch_rate", relic.EffectValue),
			ItemEffectType.PassiveXPGain => L("ui.effects.relic_xp_gain", relic.EffectValue),
			_ => relic.Description
		};
	}

	private int GetActiveSkillCount()
	{
		return TamerManager.Instance?.CurrentTamer?.SkillRanks?.Count ?? 0;
	}

	private List<(string Name, string Icon, string Description, int Rank)> GetActiveSkillBonuses()
	{
		var result = new List<(string, string, string, int)>();
		var tamer = TamerManager.Instance?.CurrentTamer;
		var skillTree = TamerManager.Instance?.SkillTree;

		if (tamer?.SkillRanks == null || skillTree == null) return result;

		foreach (var (skillId, rank) in tamer.SkillRanks)
		{
			var node = skillTree.GetNode(skillId);
			if (node == null) continue;

			string icon = GetBranchIcon(node.Branch);
			string desc = GetSkillBonusDescription(node, rank);
			result.Add((node.Name, icon, desc, rank));
		}

		return result;
	}

	private string GetBranchIcon(SkillBranch branch)
	{
		return branch switch
		{
			SkillBranch.Power => "⚔",
			SkillBranch.Fusion => "⚗",
			SkillBranch.Expedition => "🗺",
			SkillBranch.Mastery => "👑",
			SkillBranch.Fortune => "💰",
			_ => "🌳"
		};
	}

	private string GetSkillBonusDescription(SkillNode node, int rank)
	{
		if (node == null || node.Effects == null || node.Effects.Count == 0)
			return node?.Description ?? "";

		var effect = node.Effects[0];
		float totalValue = effect.Value * rank;

		return effect.Type switch
		{
			SkillEffectType.ShopDiscount => L("ui.effects.skill_shop_discount", totalValue),
			SkillEffectType.ExpeditionXPBonus or SkillEffectType.XPGainBonus => L("ui.effects.skill_xp_gain", totalValue),
			SkillEffectType.ExpeditionGoldBonus or SkillEffectType.GoldDropBonus or SkillEffectType.GoldFindBonus => L("ui.effects.skill_gold", totalValue),
			SkillEffectType.CritChanceBonus or SkillEffectType.CritChance => L("ui.effects.skill_crit_chance", totalValue),
			SkillEffectType.CritDamageBonus => L("ui.effects.skill_crit_damage", totalValue),
			SkillEffectType.CatchRateBonus => L("ui.effects.skill_catch_rate", totalValue),
			SkillEffectType.AllMonsterATKPercent => L("ui.effects.skill_atk", totalValue),
			SkillEffectType.AllMonsterDEFPercent => L("ui.effects.skill_def", totalValue),
			SkillEffectType.AllMonsterHPPercent => L("ui.effects.skill_hp", totalValue),
			SkillEffectType.AllMonsterSPDPercent => L("ui.effects.skill_spd", totalValue),
			SkillEffectType.GeneticInheritanceBonus or SkillEffectType.GeneInheritanceBonus => L("ui.effects.skill_gene_inheritance", totalValue),
			SkillEffectType.BossDamageBonus => L("ui.effects.skill_boss_damage", totalValue),
			SkillEffectType.ItemFindBonus => L("ui.effects.skill_item_find", totalValue),
			_ => effect.GetDescription()
		};
	}

	private string GetRankIcon(int rank)
	{
		return rank switch
		{
			<= 1 => "bronze.svg",
			<= 2 => "silver.svg",
			<= 3 => "gold.svg",
			<= 5 => "platinum.svg",
			<= 7 => "diamond.svg",
			<= 8 => "legendary.svg",
			<= 9 => "master.svg",
			_ => "mythic.svg"
		};
	}

	public override void Tick()
	{
		base.Tick();

		if (isExpanded && Input.Pressed("Escape"))
		{
			isExpanded = false;
			IsEffectsExpanded = false;
			SoundManager.PlayBack();
		}
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add(isExpanded);
		hash.Add(currentTab);
		hash.Add(GetTotalEffectCount());
		hash.Add(_isDragging);
		hash.Add((int)_dragOffsetX);
		hash.Add((int)_dragOffsetY);

		var boosts = GetActiveBoosts();
		foreach (var boost in boosts)
		{
			// Round to whole seconds — hash changes once per second, not every frame
			hash.Add((int)boost.TimeRemaining.TotalSeconds);
		}

		hash.Add(HasEliteInk());
		if (HasEliteInk())
			hash.Add((int)GetEliteInkRemaining().TotalSeconds);

		hash.Add(LiveEventManager.IsLaunchWeekXPActive);
		hash.Add(TamerManager.IsDoubleXPActive);

		var relics = GetEquippedRelics();
		foreach (var relic in relics)
		{
			hash.Add(relic.Id);
		}

		hash.Add(GetActiveSkillCount());

		return hash.ToHashCode();
	}
}
