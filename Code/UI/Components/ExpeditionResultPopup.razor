@namespace Beastborne.UI.Components
@using Sandbox;
@using Sandbox.UI;
@using System.Linq;
@using Beastborne.Core;
@using Beastborne.Data;
@using Beastborne.Systems;
@using Beastborne.UI;
@using Beastborne.UI.Panels;
@using Beastborne.UI.Primitives;
@inherits Panel

@*
	End-of-run result popup (2026-07 dialect sweep).
	Class names are xr-prefixed on purpose: s&box stylesheets are GLOBAL and
	ExpeditionPanel.razor(.scss) still carries a legacy in-panel copy of this
	popup using the old result-popup-* / result-btn names — sharing those
	names meant unspecified cross-sheet rule order. Do not rename back.
*@

<root class="xr-root @(_won ? "victory" : "defeat") @(IsVisible ? "visible" : "")">
	@if ( IsVisible )
	{
		var zone = ExpeditionManager.Instance?.GetExpedition( _zoneId );
		var isComplete = _won && _wave >= (zone?.Waves ?? 0);

		<div class="xr-backdrop"></div>
		<div class="xr-modal">

			<div class="xr-banner">
				@if ( isComplete )
				{
					<div class="xr-icon victory">
						<img src="ui/icons/rarity/gold.svg" />
					</div>
					<div class="xr-kicker"><span>EXPEDITION COMPLETE</span></div>
					<span class="xr-title">VICTORY</span>
					<span class="xr-subtitle">@zone.Name conquered</span>
				}
				else
				{
					<div class="xr-icon defeat">
						<img src="ui/icons/sort/skull.svg" />
					</div>
					<div class="xr-kicker"><span>EXPEDITION FAILED</span></div>
					<span class="xr-title">DEFEATED</span>
					<span class="xr-subtitle">Your team fell on Wave @_wave of @zone.Waves</span>
				}
			</div>

			@if ( _won )
			{
				<div class="xr-rewards">
					<div class="xr-reward-row">
						<div class="xr-reward-chip gold">
							<img class="xr-reward-icon" src="ui/icons/currency/money.svg" />
						</div>
						<span class="xr-reward-label">GOLD EARNED</span>
						<span class="xr-reward-amount gold">+@_gold</span>
					</div>
					<div class="xr-reward-row">
						<div class="xr-reward-chip xp">
							<img class="xr-reward-icon" src="ui/icons/expedition_badges/xp.svg" />
						</div>
						<span class="xr-reward-label">TAMER XP</span>
						<span class="xr-reward-amount xp">+@_xp</span>
					</div>
					@if ( _tokens > 0 )
					{
						<div class="xr-reward-row">
							<div class="xr-reward-chip tokens">
								<img class="xr-reward-icon" src="ui/icons/currency/token.svg" />
							</div>
							<span class="xr-reward-label">BOSS TOKENS</span>
							<span class="xr-reward-amount tokens">+@_tokens</span>
						</div>
					}
				</div>
			}

			@if ( _won )
			{
				<div class="xr-actions">
					<BbButton Tier="primary" Size=@(56) Label="EMBARK AGAIN" Icon="lucide:compass" Stretch=@true Focused=@(_kbIndex == 0) OnClick=@OnEmbarkAgain />
					<BbButton Tier="ghost" Size=@(56) Label="RETURN TO MAP" Icon="lucide:map" Focused=@(_kbIndex == 1) OnClick=@OnReturnToMap />
				</div>
			}
			else
			{
				<div class="xr-actions">
					<BbButton Tier="primary" Size=@(56) Label="RETRY" Icon="lucide:rotate-ccw" Stretch=@true Focused=@(_kbIndex == 0) OnClick=@OnRetry />
				</div>
				<div class="xr-actions row2">
					<BbButton Tier="secondary" Size=@(44) Label="CHANGE TEAM" Icon="lucide:users" IconTint="#ee5421" Stretch=@true Focused=@(_kbIndex == 1) OnClick=@OnEmbarkAgain />
					<BbButton Tier="ghost" Size=@(44) Label="MAP" Icon="lucide:map" Focused=@(_kbIndex == 2) OnClick=@OnReturnToMap />
				</div>
			}
		</div>
	}
</root>

@code {
	public static ExpeditionResultPopup Instance { get; private set; }
	public static bool IsVisible { get; private set; }

	// Stashed result data. Set by Show(...); cleared on Close().
	private static bool _won;
	private static int _wave;
	private static string _zoneId;
	private static int _gold;
	private static int _xp;
	private static int _tokens;

	// Stash the player's team at the moment of failure so Retry can re-use
	// it. ExpeditionManager clears SelectedTeam when the expedition resolves,
	// so we have to capture it here before it goes away.
	private static System.Collections.Generic.List<Monster> _lastTeam;

	protected override void OnAfterTreeRender( bool firstTime )
	{
		if ( firstTime ) Instance = this;
	}

	/// <summary>
	/// Surface the result popup. Called from ExpeditionPanel.OnBattleComplete.
	/// Must be mounted globally (GameHUD), not inside ExpeditionPanel, because
	/// by the time this fires, CurrentExpedition is already null and GameHUD
	/// is about to destroy ExpeditionPanel.
	/// </summary>
	public static void Show( bool won, int wave, string zoneId, int gold, int xp, int tokens, System.Collections.Generic.List<Monster> team )
	{
		_won = won;
		_wave = wave;
		_zoneId = zoneId;
		_gold = gold;
		_xp = xp;
		_tokens = tokens;
		_lastTeam = team != null ? new System.Collections.Generic.List<Monster>( team ) : new System.Collections.Generic.List<Monster>();
		_kbIndex = 0;
		IsVisible = true;
		Instance?.StateHasChanged();
		Log.Info( $"[ExpeditionResultPopup] Show: won={won}, wave={wave}, zone={zoneId}, gold={gold}, xp={xp}" );
		// Victory/defeat sting covers the popup open — no extra PlayPopup so the
		// two cues don't fire on the same frame and step on each other.
		if ( won ) SoundManager.PlayVictory();
		else SoundManager.PlayDefeat();
	}

	public static void Close()
	{
		IsVisible = false;
		Instance?.StateHasChanged();
		SoundManager.PlayPopdown();
	}

	// s&box only re-evaluates the Razor template when BuildHash changes.
	// Without this override, IsVisible / zoneId / won flipping via static
	// Show(...) calls doesn't re-render the panel and the popup never
	// appears.
	protected override int BuildHash()
	{
		var h = new System.HashCode();
		h.Add( IsVisible );
		h.Add( _won );
		h.Add( _wave );
		h.Add( _zoneId );
		h.Add( _gold );
		h.Add( _xp );
		h.Add( _tokens );
		h.Add( _kbIndex );
		return h.ToHashCode();
	}

	// ────────────────────── KEYBOARD NAVIGATION ──────────────────────
	// Cursor over the result buttons. Victory has 2 (Embark / Map), defeat
	// has 3 (Retry / Change Team / Map). Left/Right move, Space/Enter
	// activates, Menu/run = Return to Map. Escape NOT bound (s&box-reserved).
	// The cursor renders as the BbButton Focused violet ring.
	private static int _kbIndex = 0;

	public override void Tick()
	{
		base.Tick();
		if ( !IsVisible ) return;
		if ( !UIModalState.IsTopModal( "ExpeditionResultPopup" ) ) return;

		int count = _won ? 2 : 3;
		_kbIndex = System.Math.Clamp( _kbIndex, 0, count - 1 );

		if ( Input.Pressed( "Left" ) || Input.Pressed( "Up" ) )
		{
			_kbIndex = System.Math.Max( 0, _kbIndex - 1 );
			SoundManager.PlayHover();
			StateHasChanged();
		}
		else if ( Input.Pressed( "Right" ) || Input.Pressed( "Down" ) )
		{
			_kbIndex = System.Math.Min( count - 1, _kbIndex + 1 );
			SoundManager.PlayHover();
			StateHasChanged();
		}
		else if ( Input.Pressed( "Jump" ) || Input.Pressed( "Enter" ) )
		{
			if ( _won )
			{
				if ( _kbIndex == 0 ) OnEmbarkAgain();
				else OnReturnToMap();
			}
			else
			{
				if ( _kbIndex == 0 ) OnRetry();
				else if ( _kbIndex == 1 ) OnEmbarkAgain();
				else OnReturnToMap();
			}
		}
		else if ( Input.Pressed( "Menu" ) || Input.Pressed( "run" ) )
		{
			OnReturnToMap();
		}
	}

	// ─── ACTIONS ─────────────────────────────────────────────────────

	private void OnRetry()
	{
		var em = ExpeditionManager.Instance;
		if ( em == null || string.IsNullOrEmpty( _zoneId ) )
		{
			SoundManager.PlayDeny();
			return;
		}

		var team = _lastTeam?.Where( m => m != null ).ToList() ?? new System.Collections.Generic.List<Monster>();
		if ( team.Count == 0 )
		{
			// All beasts gone? Bail to map instead of softlocking.
			OnReturnToMap();
			return;
		}

		IsVisible = false;
		SoundManager.PlayBattleStart();

		// Tear down the resolved expedition state before starting a fresh run.
		// ResolveExpedition left CurrentExpedition set so the battle scene
		// could stay rendered; StartExpedition needs a clean slate.
		em.FinalizeExpedition();

		var zoneId = _zoneId;
		_ = BattleTransition.PlayEmbarkSequence( () =>
		{
			em.SelectTeam( team );
			em.StartExpedition( zoneId );
		} );
	}

	private void OnEmbarkAgain()
	{
		// Same idea as Retry, but routes through the team picker so the
		// player can re-pick a different squad.
		var zoneId = _zoneId;
		IsVisible = false;
		// Clear the resolved expedition — GameHUD will swap to the world map
		// and the picker will open on top of it.
		ExpeditionManager.Instance?.FinalizeExpedition();
		if ( !string.IsNullOrEmpty( zoneId ) )
		{
			TeamPickerPopup.Show( zoneId );
		}
	}

	private void OnReturnToMap()
	{
		IsVisible = false;
		SoundManager.PlayBack();
		// Finalize the resolved expedition so GameHUD swaps the battle scene
		// out for the world map. ResolveExpedition kept CurrentExpedition set
		// for the duration of the popup so the scene stayed behind it; we're
		// done with it now.
		ExpeditionManager.Instance?.FinalizeExpedition();
	}
}
