@namespace Beastborne.UI.Components
@using System;
@using System.Collections.Generic;
@using Sandbox;
@using Sandbox.UI;
@using Iconify;
@inherits Panel

@* ============================================================
   LIGHTHOUSE SCENE SHELL — Roadmap / Options / Patch Notes
   (`lh-scene` + `lhd-` + `lhp-`; styles live in MainMenu.razor.scss and
   cascade — this component mounts INSIDE the menu root, so every existing
   selector still matches.)

   Split out of MainMenu.razor 2026-06-10: this component owns its OWN
   render tree, so the menu's swap-frame rebuild can never duplicate or
   churn scene panels (the differ-ghost family), and a scene class flip
   re-renders ~250 lines instead of 3,300. MainMenu keeps the whole
   swap state machine and drives this shell via params; callbacks go
   back through the Action properties below, assigned as METHOD GROUPS
   from MainMenu markup (hotload-safe — method groups substitute across
   hot reloads; stored closures don't: the PlaneTween lesson).

   @using Iconify — the gem/diamond <iconify> icons rendered EMPTY after
   the split (worked verbatim in MainMenu.razor pre-split). BattleView is
   the one other file that imports the library's namespace explicitly and
   its icons are bulletproof, so the import rides here too. The ICON_DEBUG
   census below logs what each iconify panel actually resolved to at
   runtime — if they print as plain "Panel" the tag never bound to
   Iconify.IconifyPanel and the fallback is fully-qualified component tags.

   The shell is ALWAYS display:flex and hides by PARKING OFFSCREEN
   (left: -10000px, see .lh-scene SCSS) — its layout stays warm from
   boot, so the swap frame doesn't pay a first-layout of ~200 panels.

   SCENE IDENTITY v3: one accent per view — Roadmap GOLD #FFCE3A (+7°
   backdrop lean) · Patch Notes VIOLET #9B6CFF (−7°, mirrored) · Options
   TEAL #2DD4BF (+5°). The .lhd-topline signature strip signs in (width
   0 → 220px) on every arrival; stamp/gem colors are semantic and FUN
   (saturated tinted fills, never gray-on-gray).

   DECISION 1: the .lh-scene-bg slab is the ANGLED plane (driven by
   MainMenu's PlaneTween through the public SceneBg ref); the content
   frame sits FLAT on top for reading. _Mounted keeps Roadmap/PatchNotes
   content mounted through the scene's departure so it never empties
   mid-exit; the docked OptionsPanel is always mounted (its own .visible
   gates display). z 90: above the menu, UNDER the living cursor (100).
   Scene/Mounted codes are in LOCKSTEP with MainMenu.SceneId:
   Menu 0 · Roadmap 1 · Options 2 · PatchNotes 3.
   ============================================================ *@
<root class="lh-scene @ShellClasses()">
	<div class="lh-scene-bg" @ref="SceneBg"></div>
	<div class="lh-scene-frame">
	@if (MountedCode == 1)
	{
		<div class="lhd-topline"></div>
		<div class="lhd-header">
			<div class="lhd-header-left">
				<div class="lhd-icon-frame tone-gold">
					<iconify icon="lucide:map" Size=@(22) Color="#fbbf24" />
				</div>
				<div class="lhd-header-text">
					@* Kicker ABOVE the display title (menu voice). It carries the
					   context the deleted lead paragraph used to. *@
					<span class="lhd-subtitle">ROAD TO FULL RELEASE</span>
					@* Title words are SIBLING spans in a gap-flex row — bare text + nested
					   span fused together in s&box ("What We'reBuilding"): the whitespace
					   between a text node and an element node gets dropped. *@
					<span class="lhd-title"><span class="lhd-title-white">What We're</span><span class="lhd-title-gold">Building</span></span>
				</div>
			</div>
			<div class="lhd-header-right">
				@* v3.1: status pill REMOVED (user delta 1 — no "OPEN BETA · LIVE"
				   in scenes). Close is the 56px family now (comfortable mouse
				   target); Q cap scales with it (.lhd-key-lg). CursorGeom(20)
				   in MainMenu is in LOCKSTEP — (9, 9, 21) for radius 12 + gap 9. *@
				<button class="lhd-close @(KbIndex == 20 ? "kb-sel" : "")" onclick=@OnCloseClicked
						@ref="CloseButton" onmouseover=@(() => OnHover(20))>
					<iconify icon="lucide:x" Size=@(24) Color="rgba(255, 255, 255, 0.85)" />
					<span class="lhd-key lhd-key-lg">Q</span>
				</button>
			</div>
		</div>
		@* 3-POSTER MARQUEE (Scene Identity v3, user's cut list — exactly these
		   three). .lhd-body IS the marquee row: the posters are its direct
		   children, so the existing `.lhd-body > *` arrival stagger drives them
		   (0/50/100ms within-group). Posters are FOCUSABLE (ring indices
		   23/24/25; hover == focus == .kb-sel); ENTER/click opens Send Feedback.
		   COMMANDING hover lives in SCSS: bg step + under-title rule flare
		   72→128px (v3.1) + scale 1.02 + stamp straightens −3°→0°, ≤0.12s. *@
		<div class="lhd-body">
			@* v3.1 delta 5: the identity accent moved from the 4px left edge to an
			   UNDER-TITLE rule (.lhp-rule, scene gold) that FLARES WIDER on
			   hover/focus — the commanding flare lives there now. *@
			<button class="lhp lhp-1 lhp-tower @(KbIndex == 23 ? "kb-sel" : "")" @ref="Poster1"
					onclick=@OnPosterClicked onmouseover=@(() => OnHover(23))>
				<div class="lhp-toprow">
					<div class="lhp-gem"><iconify icon="lucide:castle" Size=@(30) Color="#2A1605" /></div>
					<div class="lhp-stamp stamp-dev"><div class="lhp-stamp-dot"></div><span>IN DEVELOPMENT</span></div>
				</div>
				<span class="lhp-title">Tower Mode</span>
				<span class="lhp-rule"></span>
				<span class="lhp-line">An endless climb. Our biggest mode yet.</span>
			</button>
			<button class="lhp lhp-2 lhp-story @(KbIndex == 24 ? "kb-sel" : "")" @ref="Poster2"
					onclick=@OnPosterClicked onmouseover=@(() => OnHover(24))>
				<div class="lhp-toprow">
					<div class="lhp-gem"><iconify icon="lucide:book-open" Size=@(30) Color="#ffffff" /></div>
					<div class="lhp-stamp stamp-soon"><span>COMING UP</span></div>
				</div>
				<span class="lhp-title">Story</span>
				<span class="lhp-rule"></span>
				<span class="lhp-line">Creating the journey you will take.</span>
			</button>
			<button class="lhp lhp-3 lhp-bugs @(KbIndex == 25 ? "kb-sel" : "")" @ref="Poster3"
					onclick=@OnPosterClicked onmouseover=@(() => OnHover(25))>
				<div class="lhp-toprow">
					<div class="lhp-gem"><iconify icon="lucide:bug" Size=@(30) Color="#ffffff" /></div>
					<div class="lhp-stamp stamp-ongoing"><span>ONGOING</span></div>
				</div>
				<span class="lhp-title">Bug Fixing</span>
				<span class="lhp-rule"></span>
				<span class="lhp-line">Forever stomping bugs. Ew.</span>
			</button>
		</div>
		@* v3.1 delta 3: FOOTER REMOVED — the posters get the vertical room. ENTER
		   on a poster still opens Send Feedback; Q rides the close button's cap;
		   the A/D vocabulary moved onto the arrows below (they ARE the key hint).
		   v3.1 delta 4: PREV/NEXT SCENE ARROWS — the mouse affordance for the
		   A/D cycle (Roadmap ⇄ Patch Notes). Floating chevron slabs riding the
		   backdrop's wings at mid-height (absolute, outside the flat frame),
		   chevron in the scene identity color. Focusable 26/27 at the rail's
		   ENDS, so A from prev / D from next cycles naturally. *@
		<button class="lhd-arrow lhd-arrow-prev @(KbIndex == 26 ? "kb-sel" : "")" @ref="ArrowPrev"
				onclick=@OnPrevClicked onmouseover=@(() => OnHover(26))>
			<iconify icon="lucide:chevron-left" Size=@(34) Color="#FFCE3A" />
			<span class="lhd-key">A</span>
		</button>
		<button class="lhd-arrow lhd-arrow-next @(KbIndex == 27 ? "kb-sel" : "")" @ref="ArrowNext"
				onclick=@OnNextClicked onmouseover=@(() => OnHover(27))>
			<iconify icon="lucide:chevron-right" Size=@(34) Color="#FFCE3A" />
			<span class="lhd-key">D</span>
		</button>
	}
	else if (MountedCode == 3)
	{
		<div class="lhd-topline"></div>
		<div class="lhd-header">
			<div class="lhd-header-left">
				<div class="lhd-icon-frame">
					<iconify icon="lucide:scroll-text" Size=@(22) Color="#a78bfa" />
				</div>
				<div class="lhd-header-text">
					<span class="lhd-subtitle">PATCH NOTES</span>
					@* Sibling spans in a gap-flex row — see the roadmap title note
					   (bare text + nested span fuses without the space in s&box).
					   The accent word wears the scene identity (violet here —
					   .scene-patchnotes recolors .lhd-title-gold). *@
					<span class="lhd-title"><span class="lhd-title-white">Whispering</span><span class="lhd-title-gold">Hollow</span></span>
				</div>
			</div>
			<div class="lhd-header-right">
				<button class="lhd-close @(KbIndex == 20 ? "kb-sel" : "")" onclick=@OnCloseClicked
						@ref="CloseButton" onmouseover=@(() => OnHover(20))>
					<iconify icon="lucide:x" Size=@(24) Color="rgba(255, 255, 255, 0.85)" />
					<span class="lhd-key lhd-key-lg">Q</span>
				</button>
			</div>
		</div>
		@* Full-width body: fixed version/category rail on the left + the wide
		   reading column (the only scroll container) on the right. *@
		<div class="lhd-pn">
			<div class="lhd-rail">
				<div class="lhd-rail-version">
					@* BIG version hero — two-tone per the v3 spec (violet "v" +
					   gold number; sibling spans, gap-flex). *@
					<span class="lhd-rail-v"><span class="lhd-rail-v-pre">v</span><span class="lhd-rail-v-num">1.2.0</span></span>
					<span class="lhd-rail-vname">Whispering Hollow</span>
					<span class="lhd-rail-date">MAY 9, 2026</span>
				</div>
				<div class="lhd-rail-lead">
					<span>A hidden mini-expedition opens above Weavermere. Seven new beasts join the Beastbook. <span class="lhd-lead-bright">Polish and balance across every panel.</span></span>
				</div>
				<div class="lhd-rail-toc">
					<span class="lhd-toc-head">IN THIS PATCH</span>
					<div class="lhd-toc-row tone-features"><div class="lhd-toc-d"></div><span class="lhd-toc-name">Features</span><span class="lhd-toc-count">6</span></div>
					<div class="lhd-toc-row tone-balance"><div class="lhd-toc-d"></div><span class="lhd-toc-name">Balance</span><span class="lhd-toc-count">5</span></div>
					<div class="lhd-toc-row tone-fixes"><div class="lhd-toc-d"></div><span class="lhd-toc-name">Fixes</span><span class="lhd-toc-count">6</span></div>
					<div class="lhd-toc-row tone-polish"><div class="lhd-toc-d"></div><span class="lhd-toc-name">Polish</span><span class="lhd-toc-count">6</span></div>
				</div>
				<div class="lhd-rail-hint">
					<span class="lhd-key">W</span><span class="lhd-key">S</span><span class="lhd-hint-lbl">SCROLL THE NOTES</span>
				</div>
			</div>
			<div class="lhd-scroll" @ref="ScrollBody">
			<div class="lhd-section tone-features">
				<div class="lhd-section-head">
					<iconify icon="lucide:sparkles" Size=@(18) Color="#fbbf24" />
					<span class="lhd-section-title">Features</span>
				</div>
				@* v3.1 delta 5: under-title accent rule (same language as the
				   roadmap posters), tone-colored per category. *@
				<span class="lhd-section-rule"></span>
				<div class="lhd-rows">
					<div class="lhd-row"><div class="lhd-row-d"></div><span class="lhd-row-text"><span class="lhd-row-strong">Battle UI Reborn.</span> The whole battle screen redrawn in a stamp-and-slab dialect. Action bar is now a diamond cluster — FIGHT anchored full-size with a strobe-jitter flame, SWITCH / BAG / CONTRACT / END zig-zagging beside it.</span></div>
					<div class="lhd-row"><div class="lhd-row-d"></div><span class="lhd-row-text"><span class="lhd-row-strong">Move Picker.</span> Clicking FIGHT blooms 4 element-tinted move diamonds in a chevron. Hover any move for a slide-in info card with PP, power, and description. FIGHT itself becomes BACK.</span></div>
					<div class="lhd-row"><div class="lhd-row-d"></div><span class="lhd-row-text"><span class="lhd-row-strong">Target / Contract / Switch Pickers.</span> Target picker shows 3 element-tinted enemy diamonds numbered #1 / #2 / #3 — same numbering as the HP cards. Switch is a 4-diamond carousel (BACK · ◀ PREV · ▶ NEXT · ✓ SWAP) with the active beast in a side card.</span></div>
					<div class="lhd-row"><div class="lhd-row-d"></div><span class="lhd-row-text"><span class="lhd-row-strong">Sheepot &amp; Cerametz.</span> New beast line — pale roots tangle under Sheepot's fleece so it wears a clay pot like armor. Spawns wild in Weaverton, evolves into Cerametz at Lv 25. Art by new artist Jet — welcome to the team!</span></div>
					<div class="lhd-row"><div class="lhd-row-d"></div><span class="lhd-row-text"><span class="lhd-row-strong">Live Events.</span> +50% XP for everyone all launch week. Live announcements ticker now drives in-game XP/gold boosts — server-pushed events light up across battles and expeditions automatically (no client patch required).</span></div>
					<div class="lhd-row"><div class="lhd-row-d"></div><span class="lhd-row-text"><span class="lhd-row-strong">Battle Comms.</span> Chat &amp; Radio docked at the bottom-left of battle — read the latest message and skip tracks without leaving combat. Click either dock body to open the full panel.</span></div>
				</div>
			</div>
			<div class="lhd-section tone-balance">
				<div class="lhd-section-head">
					@* lucide:sliders-horizontal — lucide:scale renders empty in-engine
					   (unverified icon name; the one PRE-split empty gem). *@
					<iconify icon="lucide:sliders-horizontal" Size=@(18) Color="#7dd3fc" />
					<span class="lhd-section-title">Balance</span>
				</div>
				<span class="lhd-section-rule"></span>
				<div class="lhd-rows">
					<div class="lhd-row"><div class="lhd-row-d"></div><span class="lhd-row-text"><span class="lhd-row-strong">Linear stat growth all the way to 100.</span> Stats no longer slow to a crawl past Lv 30 — high-level beasts actually feel high-level. Damage formula retuned to match.</span></div>
					<div class="lhd-row"><div class="lhd-row-d"></div><span class="lhd-row-text"><span class="lhd-row-strong">Defense rebased.</span> Same-level fights now resolve in 3–5 turns at every level band, not 7–10 against tank archetypes.</span></div>
					<div class="lhd-row"><div class="lhd-row-d"></div><span class="lhd-row-text"><span class="lhd-row-strong">Boss tier multipliers retuned.</span> HP scaled up across all tiers (Normal 1.4×→1.9×, Elite 1.7×→2.4×, Legendary 2.0×→2.9×, Mythic 2.4×→3.5×); ATK/DEF trimmed so they don't one-shot the player team.</span></div>
					<div class="lhd-row"><div class="lhd-row-d"></div><span class="lhd-row-text"><span class="lhd-row-strong">Wave scaling +1 instead of +2.</span> Expeditions feel like a steady climb instead of hitting a wall on wave 4.</span></div>
					<div class="lhd-row"><div class="lhd-row-d"></div><span class="lhd-row-text"><span class="lhd-row-strong">Status ticks rebalanced.</span> Poison 1/8 → 1/12 max HP per turn, Burn 1/16 → 1/20. Status pressure still matters without single-handedly winning fights.</span></div>
				</div>
			</div>
			<div class="lhd-section tone-fixes">
				<div class="lhd-section-head">
					<iconify icon="lucide:wrench" Size=@(18) Color="#fb7185" />
					<span class="lhd-section-title">Fixes</span>
				</div>
				<span class="lhd-section-rule"></span>
				<div class="lhd-rows">
					<div class="lhd-row"><div class="lhd-row-d"></div><span class="lhd-row-text"><span class="lhd-row-strong">Cloud save protection.</span> Cloud saves can no longer get silently overwritten by an empty save after a network blip on a fresh machine. Sync pauses for the session (with a warning toast) instead of pushing an empty blob over your real save.</span></div>
					<div class="lhd-row"><div class="lhd-row-d"></div><span class="lhd-row-text"><span class="lhd-row-strong">Expedition unlock chain.</span> Clearing the first expedition now actually unlocks the second — the cleared-counter was off by one because the tutorial zone was being miscounted.</span></div>
					<div class="lhd-row"><div class="lhd-row-d"></div><span class="lhd-row-text"><span class="lhd-row-strong">Skill points no longer drained between sessions.</span> The save-migration that runs on load is now non-destructive. If you've been losing SP to this bug, your next login will set you right.</span></div>
					<div class="lhd-row"><div class="lhd-row-d"></div><span class="lhd-row-text">Tutorial highlight no longer floats above the wrong spot — the arrow waits for the target button to settle into its real position before locking on.</span></div>
					<div class="lhd-row"><div class="lhd-row-d"></div><span class="lhd-row-text">Beastbook grid stops squashing non-square art — Aurael especially shows much more wing/halo/blade detail.</span></div>
					<div class="lhd-row"><div class="lhd-row-d"></div><span class="lhd-row-text">Chat join notices show the player's name instead of "System joined the server."</span></div>
				</div>
			</div>
			<div class="lhd-section tone-polish">
				<div class="lhd-section-head">
					<iconify icon="lucide:gem" Size=@(18) Color="#c4b5fd" />
					<span class="lhd-section-title">Polish</span>
				</div>
				<span class="lhd-section-rule"></span>
				<div class="lhd-rows">
					<div class="lhd-row"><div class="lhd-row-d"></div><span class="lhd-row-text"><span class="lhd-row-strong">Stamp-and-slab dialect everywhere.</span> Expedition · Beastbook · Arena · Quest · Trading · Breeding · Daily · Card Collection · Contract Negotiation panels all redrawn — slab tab pills, italic-display headers, hard-offset shadow buttons. The whole game speaks one voice now.</span></div>
					<div class="lhd-row"><div class="lhd-row-d"></div><span class="lhd-row-text"><span class="lhd-row-strong">Cinematic battle moments.</span> Slanted CRITICAL stamp on every crit. Boss splash card on wave entry. "WAVE CLEAR!" banner on wave end. Slab stamps for poison / burn / paralyze / sleep / freeze / confuse.</span></div>
					<div class="lhd-row"><div class="lhd-row-d"></div><span class="lhd-row-text"><span class="lhd-row-strong">Punchier feel.</span> Move names slam in from the right, HP bars shake on hit, swap-outs get a slanted yellow-edged banner moment, HP bars wait for the attack visual to land before draining.</span></div>
					<div class="lhd-row"><div class="lhd-row-d"></div><span class="lhd-row-text">HP cards now color-match each beast's element with a #1 / #2 / #3 slot tag matching the target picker.</span></div>
					<div class="lhd-row"><div class="lhd-row-d"></div><span class="lhd-row-text">Battle nameplates rebuilt — flat saturated element diamonds (both shown for dual-typed beasts), yellow LV slab pills, crisp HP bar borders.</span></div>
					<div class="lhd-row"><div class="lhd-row-d"></div><span class="lhd-row-text">WAVE badge now shows progress through the expedition (e.g. WAVE 3/5) instead of just the current wave number.</span></div>
				</div>
			</div>
			</div>
		</div>
		@* v3.1 deltas 3+4: footer removed; prev/next scene arrows (violet
		   identity here) carry the A/D vocabulary. See the roadmap branch note. *@
		<button class="lhd-arrow lhd-arrow-prev @(KbIndex == 26 ? "kb-sel" : "")" @ref="ArrowPrev"
				onclick=@OnPrevClicked onmouseover=@(() => OnHover(26))>
			<iconify icon="lucide:chevron-left" Size=@(34) Color="#9B6CFF" />
			<span class="lhd-key">A</span>
		</button>
		<button class="lhd-arrow lhd-arrow-next @(KbIndex == 27 ? "kb-sel" : "")" @ref="ArrowNext"
				onclick=@OnNextClicked onmouseover=@(() => OnHover(27))>
			<iconify icon="lucide:chevron-right" Size=@(34) Color="#9B6CFF" />
			<span class="lhd-key">D</span>
		</button>
	}

	@* OPTIONS — the SAME OptionsPanel component GameHUD mounts as a centered
	   modal, here in Docked mode: it fills the scene frame instead of
	   rendering its own overlay + centered card. Always mounted (its own
	   .visible class gates display), so Show()/Hide() transitions replay.
	   OptionsPanel routes Show() to whichever instance sits under a
	   non-hidden ancestor — see PickActiveInstance() in OptionsPanel.razor. *@
	<OptionsPanel Docked=@true />
	</div>
</root>

@code {
	// ─── Public refs the host (MainMenu) reads ───────────────────────────
	// SceneBg — the angled backdrop slab MainMenu's PlaneTween drives (p2).
	// CloseButton / Poster1-3 / ArrowPrev / ArrowNext — scene focusables for
	// the living cursor (indices 20 close · 23/24/25 roadmap posters · 26/27
	// prev/next scene arrows in MainMenu.FocusEl; the v3 footer CTAs 21/22
	// left with the footer, v3.1 delta 3). ScrollBody — the patch-notes
	// reading column (W/S keys + mouse wheel scroll it from MainMenu). Host
	// code resolves all of these through FindFocusable()/ResolveScrollBody()
	// below — NEVER the raw fields — so a stale/unbound @ref can no longer
	// strand the ring (the post-split stranded-ring bug: SceneBg, outside the
	// @if, kept binding while the branch refs went stale).
	public Panel SceneBg, CloseButton, ArrowPrev, ArrowNext, Poster1, Poster2, Poster3, ScrollBody;

	// ─── Host-driven state (set as razor params from MainMenu) ───────────
	// Codes are in LOCKSTEP with MainMenu.SceneId: Menu 0 · Roadmap 1 ·
	// Options 2 · PatchNotes 3. Named *Code to dodge member-name collisions
	// on engine base types (Panel.Scene exists — the pre-rename `Scene`
	// param hid it and broke the generated host assignment).
	public int SceneCode { get; set; } = 0;

	private int _mounted = 1;
	public int MountedCode
	{
		get => _mounted;
		set
		{
			if ( _mounted == value ) return;
			_mounted = value;
			// The @if branch is about to REMOUNT — drop the stale refs NOW so
			// the host's cursor retarget can never read a deleted panel's
			// frozen Box.Rect (the stranded-ring bug's second failure mode,
			// scene-swap-spec V2 amendment 2). @ref re-binds on the next render;
			// FindFocusable() self-heals by class if it doesn't.
			CloseButton = null;
			ArrowPrev = null;
			ArrowNext = null;
			Poster1 = null;
			Poster2 = null;
			Poster3 = null;
			ScrollBody = null;
		}
	}

	public bool Arrived { get; set; }     // .arrived — group A in, stagger firing
	public bool Settled { get; set; }     // .settled — stagger delays zeroed
	public bool Departing { get; set; }   // .departing — scene flying out (return trip)
	public int KbIndex { get; set; } = -1; // host selectedIndex (kb-sel on 20-25)

	// ─── Host callbacks — assigned from MainMenu markup as METHOD GROUPS ──
	// (hotload-safe: method groups substitute across hot reloads; stored
	// closures don't — the PlaneTween lesson. The parent re-render also
	// reassigns them every build, so even a stale delegate self-heals.)
	public Action CloseRequested { get; set; }
	public Action FeedbackRequested { get; set; }
	// v3.1: CycleRequested(±1) replaces the footer's Feedback/Discord click
	// routes (the footer is gone). Fired by the prev/next scene arrows.
	public Action<int> CycleRequested { get; set; }
	public Action<int> HoverRequested { get; set; }

	private void OnCloseClicked() => CloseRequested?.Invoke();
	// Posters open Send Feedback (v3 spec: ENTER/click on a poster = "tell us
	// about this" — plain feedback panel for now, pre-contextualizing later).
	private void OnPosterClicked() => FeedbackRequested?.Invoke();
	private void OnPrevClicked() => CycleRequested?.Invoke( -1 );
	private void OnNextClicked() => CycleRequested?.Invoke( 1 );
	private void OnHover( int index ) => HoverRequested?.Invoke( index );

	// ─── SELF-HEALING FOCUSABLE RESOLUTION (stranded-ring fix, 2026-06-10) ──
	// The post-split bug: after a swap the living ring froze over the dead
	// sidebar control because the host's focus poll read a CloseButton ref
	// that never (re)bound — while SceneBg, OUTSIDE the @if branch, kept
	// working (tween p2 ran every swap). Root cause lives in the @if-branch
	// @ref lifecycle, so the host now resolves every focusable through this
	// method: trust the @ref when it reads live on-screen geometry, otherwise
	// WALK THE TREE by class and re-cache. Class lookup is cheap (only runs
	// while the ref is null/stale) and immune to differ/remount/hotload churn.
	public Panel FindFocusable( int index )
	{
		var direct = index switch
		{
			20 => CloseButton,
			23 => Poster1,
			24 => Poster2,
			25 => Poster3,
			26 => ArrowPrev,
			27 => ArrowNext,
			_ => null,
		};
		// Parked shell (SceneCode 0): geometry is offscreen by design — return
		// whatever we have, nothing visual depends on it.
		if ( SceneCode == 0 ) return direct;
		// Live + on-screen rect → the fast path.
		if ( direct != null && direct.Box.Rect.Left > -1000f && direct.Box.Rect.Width >= 1f ) return direct;

		var found = index switch
		{
			20 => FindByClass( this, "lhd-close" ),
			23 => FindByClass( this, "lhp-1" ),
			24 => FindByClass( this, "lhp-2" ),
			25 => FindByClass( this, "lhp-3" ),
			26 => FindByClass( this, "lhd-arrow-prev" ),
			27 => FindByClass( this, "lhd-arrow-next" ),
			_ => null,
		};
		if ( found != null )
		{
			switch ( index )
			{
				case 20: CloseButton = found; break;
				case 23: Poster1 = found; break;
				case 24: Poster2 = found; break;
				case 25: Poster3 = found; break;
				case 26: ArrowPrev = found; break;
				case 27: ArrowNext = found; break;
			}
		}
		return found ?? direct;
	}

	// Same healing for the patch-notes scroll column (W/S + wheel scrolling).
	public Panel ResolveScrollBody()
	{
		if ( ScrollBody != null && ScrollBody.Box.Rect.Width >= 1f ) return ScrollBody;
		var found = FindByClass( this, "lhd-scroll" );
		if ( found != null ) ScrollBody = found;
		return found ?? ScrollBody;
	}

	private static Panel FindByClass( Panel root, string cls )
	{
		if ( root == null ) return null;
		foreach ( var c in root.Children )
		{
			if ( c == null ) continue;
			if ( c.HasClass( cls ) ) return c;
			var r = FindByClass( c, cls );
			if ( r != null ) return r;
		}
		return null;
	}

	// ─── TEMP DIAGNOSTIC (rides the SWAP_DEBUG verification window) ──────
	// One-shot census of every iconify panel under this component, a few
	// seconds after boot. Tells us EXACTLY which failure family the empty
	// gems are: type=Panel → the <iconify> tag never resolved to
	// Iconify.IconifyPanel (compile-level; fix = qualified component tags);
	// type=IconifyPanel + kids=0 → the panel exists but never loaded its
	// texture (runtime; fix = the library's load trigger); kids=1 → icon is
	// there and INVISIBLE (styling). Delete with SWAP_DEBUG when verified.
	private const bool ICON_DEBUG = true;
	private bool _iconDiagDone = false;

	public override void Tick()
	{
		base.Tick();
		TickContentSlide();
		if ( !ICON_DEBUG || _iconDiagDone || Time.Now < 5f ) return;
		_iconDiagDone = true;
		int n = 0;
		IconCensus( this, ref n );
		Log.Info( $"[scenedbg] iconify census complete: {n} icon panel(s) under LighthouseScene (mounted={_mounted})" );
	}

	// ─── CONTENT SLIDE — IMPERATIVE (class-toggle transform transitions SNAP) ──
	// The v3.1 arrival/departure slides were authored as class-toggle transform
	// transitions; the engine snaps those (the same law the planes obey — spec
	// compliance section), so posters "spawned" in place (user report). The
	// slide is driven per-frame here instead; the inline transform is NULLED at
	// arrival settle so the steady CSS and the settle-gated hover transforms
	// take over seamlessly. The CSS keeps the same targets as a harmless
	// fallback (inline wins while the slide runs).
	private bool _prevArrived, _prevDeparting;
	private float _slideT0 = -1f;
	private bool _slideIn;

	private static readonly (string cls, float from, float stagger)[] SlideSpec = new[]
	{
		("lhp-1", 60f, 0.00f),
		("lhp-2", 60f, 0.05f),
		("lhp-3", 60f, 0.10f),
		("lhd-rail", 60f, 0.00f),
		("lhd-arrow-prev", -24f, 0.14f),
		("lhd-arrow-next", 24f, 0.14f),
	};

	private void TickContentSlide()
	{
		if ( Arrived && !_prevArrived ) { _slideT0 = Time.Now; _slideIn = true; }
		if ( Departing && !_prevDeparting ) { _slideT0 = Time.Now; _slideIn = false; }
		_prevArrived = Arrived;
		_prevDeparting = Departing;
		if ( _slideT0 < 0f ) return;

		float dur = _slideIn ? 0.30f : 0.14f;
		bool allDone = true;
		foreach ( var (cls, from, stagger) in SlideSpec )
		{
			var el = FindByClass( this, cls );
			if ( el == null ) continue;
			float t = Time.Now - _slideT0 - ( _slideIn ? stagger : 0f );
			float u = Math.Clamp( t / dur, 0f, 1f );
			if ( u < 1f ) allDone = false;
			// out-cubic on arrival (decelerating land), in-quad on departure (accelerating exit)
			float e = _slideIn ? 1f - MathF.Pow( 1f - u, 3f ) : u * u;
			float x = _slideIn ? from * ( 1f - e ) : from * e;
			if ( _slideIn && u >= 1f ) { el.Style.Transform = null; continue; }
			var tr = new PanelTransform();
			tr.AddTranslate( Length.Pixels( x ), Length.Pixels( 0f ), Length.Pixels( 0f ) );
			el.Style.Transform = tr;
		}
		// Arrival ends by nulling everything (CSS resumes); a finished departure
		// holds its final pose — the wrapper parks offscreen right after, and the
		// next arrival's rising edge restarts from its own start poses.
		if ( allDone ) _slideT0 = -1f;
	}

	private void IconCensus( Panel p, ref int n )
	{
		if ( p == null ) return;
		foreach ( var c in p.Children )
		{
			if ( c == null ) continue;
			var typeName = c.GetType().Name;
			if ( c.ElementName == "iconify" || typeName.Contains( "Iconify" ) )
			{
				n++;
				Log.Info( $"[scenedbg] icon #{n}: type={typeName} el={c.ElementName} kids={c.ChildrenCount} rect={c.Box.Rect}" );
			}
			IconCensus( c, ref n );
		}
	}

	// Shell class string — same contract the old SceneShellClasses() had.
	private string ShellClasses()
	{
		var cls = SceneCode != 0 ? "shown" : "";
		if ( Arrived ) cls += " arrived";
		if ( Settled ) cls += " settled";
		if ( Departing ) cls += " departing";
		cls += SceneCode switch
		{
			1 => " scene-roadmap",
			2 => " scene-options",
			3 => " scene-patchnotes",
			_ => "",
		};
		return cls;
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add( SceneCode );
		hash.Add( _mounted );
		hash.Add( Arrived );
		hash.Add( Settled );
		hash.Add( Departing );
		// Only scene focusables (20+) affect this markup — menu-side cursor
		// moves (0-10) must NOT re-render the scene tree.
		hash.Add( KbIndex >= 20 ? KbIndex : -1 );
		return hash.ToHashCode();
	}
}
