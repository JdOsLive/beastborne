@namespace Beastborne.UI.Components
@using Sandbox;
@using Sandbox.UI;
@using Beastborne.Core;
@using Beastborne.Data;
@using Beastborne.Systems;
@inherits Panel


@* LANE: input 2026-09-02 — the root carries the host page's device mode
   (KbMode parameter → .kbd-mode / .mouse-mode; default mouse-mode so
   consumers that never pass it keep their hover untouched). Inside an
   OPEN menu there is ONE cursor: `.kb-focused` on the focused row; the
   scss gates hover under .mouse-mode and the class under .kbd-mode so a
   parked mouse and the keyboard never light two rows (DOC-5 #5/#6). *@
<root class="filter-bar @(KbMode ? "kbd-mode" : "mouse-mode")">
	<!-- Element Dropdown -->
	<div class="dropdown-container">
		<button class="dropdown-btn element-btn @GetElementClass(CurrentElement)" @ref="elementBtnRef" onclick=@ToggleElementDropdown onmouseover=@OnTriggerHover>
			<img class="dropdown-icon" src="ui/icons/elements/background/@(GetElementIconPath(CurrentElement)).png" />
			<span class="dropdown-label">@GetElementLabel(CurrentElement)</span>
			<span class="dropdown-arrow @(elementDropdownOpen ? "open" : "")">▼</span>
		</button>
		@if (elementDropdownOpen)
		{
			<div class="dropdown-menu element-menu" @ref="elementMenuRef">
				@foreach (var id in ElementItems)
				{
					var idx = Array.IndexOf(ElementItems, id);
					if (id == "neutral")
					{
						<div class="dropdown-divider"></div>
					}
					<div class="dropdown-item @(id == "all" ? "" : id) @(CurrentElement == id ? "active" : "") @(idx == focusedItemIndex ? "kb-focused" : "")" onclick=@(() => SelectElement(id)) onmouseover=@(() => OnItemHover(idx))>
						<img class="item-icon" src="ui/icons/elements/background/@(id).png" />
						<span class="item-label">@GetElementLabel(id)</span>
					</div>
				}
			</div>
		}
	</div>

	<!-- Rarity Dropdown (optional) -->
	@if (ShowRarityFilter)
	{
		<div class="dropdown-container">
			<button class="dropdown-btn rarity-btn @GetRarityClass(CurrentRarity)" @ref="rarityBtnRef" onclick=@ToggleRarityDropdown onmouseover=@OnTriggerHover>
				<img class="dropdown-icon-svg" src="@GetRarityIconPath(CurrentRarity)" />
				<span class="dropdown-label">@GetRarityLabel(CurrentRarity)</span>
				<span class="dropdown-arrow @(rarityDropdownOpen ? "open" : "")">▼</span>
			</button>
			@if (rarityDropdownOpen)
			{
				<div class="dropdown-menu rarity-menu" @ref="rarityMenuRef">
					@foreach (var id in RarityItems)
					{
						var idx = Array.IndexOf(RarityItems, id);
						if (id == "common")
						{
							<div class="dropdown-divider"></div>
						}
						<div class="dropdown-item @(id == "all" ? "" : id) @(CurrentRarity == id ? "active" : "") @(idx == focusedItemIndex ? "kb-focused" : "")" onclick=@(() => SelectRarity(id)) onmouseover=@(() => OnItemHover(idx))>
							<img class="item-icon-svg" src="@GetRarityIconPath(id)" />
							<span class="item-label">@GetRarityLabel(id)</span>
						</div>
					}
				</div>
			}
		</div>
	}

	<!-- Sort Dropdown -->
	<div class="dropdown-container">
		<button class="dropdown-btn sort-btn" @ref="sortBtnRef" onclick=@ToggleSortDropdown onmouseover=@OnTriggerHover>
			<img class="dropdown-icon-svg" src="@GetSortIconPath(CurrentSort)" />
			<span class="dropdown-label">@GetSortLabel(CurrentSort)</span>
			<span class="dropdown-arrow @(sortDropdownOpen ? "open" : "")">▼</span>
		</button>
		@if (sortDropdownOpen)
		{
			var sortItems = GetSortItems();
			<div class="dropdown-menu sort-menu" @ref="sortMenuRef">
				@foreach (var id in sortItems)
				{
					var idx = sortItems.IndexOf(id);
					if (id == "fav" || id == "name")
					{
						<div class="dropdown-divider"></div>
					}
					<div class="dropdown-item @(id == "fav" ? "fav" : "") @(CurrentSort == id ? "active" : "") @(idx == focusedItemIndex ? "kb-focused" : "")" onclick=@(() => ActivateSortItem(id)) onmouseover=@(() => OnItemHover(idx))>
						<img class="item-icon-svg" src="@GetSortIconPath(id)" />
						<span class="item-label">@GetSortItemLabel(id)</span>
					</div>
				}
			</div>
		}
	</div>

	<!-- Sort Direction Toggle -->
	<button class="sort-direction-btn" onclick=@ToggleSortDirection onmouseover=@OnTriggerHover>
		@(SortAscending ? "↑" : "↓")
	</button>

	<!-- Name Search Popup -->
	@if (nameSearchOpen)
	{
		<div class="search-overlay" onclick=@OnOverlayClicked>
			<div class="search-popup" onclick=@OnPopupClicked>
				<div class="search-header">
					<span class="search-title">@L("ui.filter.search_by_name")</span>
					<button class="search-close" onclick=@CloseNameSearch>×</button>
				</div>
				<div class="search-input-wrapper">
					<TextEntry class="search-input" @ref="searchInput" Text="@searchText" Placeholder="@L("ui.filter.type_to_filter")" />
				</div>
				<div class="search-results">
					@foreach (var name in GetFilteredNames())
					{
						var species = GetSpeciesByName(name);
						<div class="search-result" onclick=@(() => SelectName(name))>
							@if (species != null)
							{
								<span class="result-number">#@species.BeastiaryNumber</span>
								<img class="result-element-icon" src="ui/icons/elements/background/@(species.Element.ToString().ToLower()).png" />
							}
							<span class="result-name">@name</span>
						</div>
					}
					@if (GetFilteredNames().Count == 0)
					{
						<div class="search-empty">@L("ui.filter.no_matches")</div>
					}
				</div>
			</div>
		</div>
	}
</root>

@code {
	// Localization helper
	private string L( string key ) => LocalizationManager.Get( key );
	private string L( string key, params object[] args ) => LocalizationManager.Get( key, args );

	// Properties that parent panels bind to
	[Property] public string CurrentElement { get; set; } = "all";
	[Property] public string CurrentSort { get; set; } = "power";
	[Property] public string CurrentRarity { get; set; } = "all";
	[Property] public string CurrentNameFilter { get; set; } = "";
	[Property] public bool SortAscending { get; set; } = false; // false = descending (high to low), true = ascending (low to high)

	// Feature toggles
	[Property] public bool ShowBeastiarySort { get; set; } = false;
	[Property] public bool ShowRarityFilter { get; set; } = false;
	[Property] public bool HideMonsterOnlySorts { get; set; } = false; // Hides Level, Genes, Favorites, Recent (for Beastiary)

	// Callbacks
	[Property] public Action<string> OnElementChanged { get; set; }
	[Property] public Action<string> OnSortChanged { get; set; }
	[Property] public Action<string> OnRarityChanged { get; set; }
	[Property] public Action<string> OnNameFilterChanged { get; set; }
	[Property] public Action<bool> OnSortDirectionChanged { get; set; }

	// Available names for search (set by parent)
	[Property] public List<string> AvailableNames { get; set; } = new();

	// ── KEYBOARD INSIDE THE MENUS (LANE: input 2026-09-02; user: "when I
	// open the tabs at the top — elements, rarity, power — I can't scroll
	// through them with W and S") ──────────────────────────────────────
	// The host page owns the device model (its lastInputDevice); it hands
	// the flag down here so hover and kb never fight (one device flag,
	// DOC-5 #5 — no second model invented). Consumers that never pass it
	// stay in mouse-mode and see zero change.
	[Property] public bool KbMode { get; set; } = false;

	// A/D while a menu is open: this menu closes and the page moves its
	// header cursor to the neighbour of `trigger` in the given direction
	// (the header walk is measured at the page layer — CollectHeaderControls
	// — so only the page knows what sits beside a trigger). Pages open the
	// neighbour when it is another dropdown (menubar convention).
	[Property] public Action<Panel, int> OnKbSideStep { get; set; }

	/// <summary>True while the element / rarity / sort menu is open.</summary>
	public bool IsAnyDropdownOpen => elementDropdownOpen || rarityDropdownOpen || sortDropdownOpen;

	/// <summary>Row cursor inside the open menu (index into the item list, dividers excluded).</summary>
	public int FocusedItemIndex => focusedItemIndex;

	private static readonly string[] ElementItems =
		{ "all", "neutral", "fire", "water", "earth", "wind", "electric", "ice", "nature", "metal", "shadow", "spirit" };
	private static readonly string[] RarityItems =
		{ "all", "common", "uncommon", "rare", "epic", "legendary", "mythic" };

	// The sort list is conditional — ONE builder feeds both the markup and
	// the keyboard so the cursor index can never drift from the rows on
	// screen (DOC-5 #12: same live list, same order).
	private List<string> GetSortItems()
	{
		var list = new List<string>();
		if (ShowBeastiarySort) list.Add("beastiary");
		if (!HideMonsterOnlySorts) { list.Add("power"); list.Add("level"); list.Add("genes"); }
		list.Add("basestats");
		if (!HideMonsterOnlySorts) { list.Add("fav"); list.Add("recent"); }
		list.Add("name");
		return list;
	}

	private List<string> GetOpenMenuItems()
	{
		if (elementDropdownOpen) return ElementItems.ToList();
		if (rarityDropdownOpen) return RarityItems.ToList();
		if (sortDropdownOpen) return GetSortItems();
		return new List<string>();
	}

	private Panel OpenMenuPanel =>
		elementDropdownOpen ? elementMenuRef : rarityDropdownOpen ? rarityMenuRef : sortDropdownOpen ? sortMenuRef : null;

	private Panel OpenTriggerPanel =>
		elementDropdownOpen ? elementBtnRef : rarityDropdownOpen ? rarityBtnRef : sortDropdownOpen ? sortBtnRef : null;

	// Internal state
	private bool elementDropdownOpen = false;
	private bool sortDropdownOpen = false;
	private bool rarityDropdownOpen = false;
	private bool nameSearchOpen = false;
	private string searchText = "";
	private TextEntry searchInput;
	private int focusedItemIndex = 0;
	private Panel elementMenuRef, rarityMenuRef, sortMenuRef;
	private Panel elementBtnRef, rarityBtnRef, sortBtnRef;
	// Scroll-follow: set on the open edge and on every kb move; Tick
	// resolves it once the menu has a rect (retry-until-laid-out), then
	// glides (0.30/tick, the roster grid recipe). <0 = idle.
	private bool menuScrollPending = false;
	private float menuScrollTarget = -1f;

	// Seed the row cursor on the OPEN EDGE (DOC-5 #12 — menus open by mouse
	// too): it starts on the currently-selected item so Space re-confirms
	// and W/S step away from "where you are".
	private void SeedMenuCursor(string selectedId)
	{
		var items = GetOpenMenuItems();
		int i = items.IndexOf(selectedId);
		focusedItemIndex = i < 0 ? 0 : i;
		menuScrollPending = true;
		menuScrollTarget = -1f;
	}

	private void ToggleElementDropdown()
	{
		elementDropdownOpen = !elementDropdownOpen;
		sortDropdownOpen = false;
		rarityDropdownOpen = false;
		if (elementDropdownOpen) SeedMenuCursor(CurrentElement);
		SoundManager.PlayClick();
	}

	private void ToggleSortDropdown()
	{
		sortDropdownOpen = !sortDropdownOpen;
		elementDropdownOpen = false;
		rarityDropdownOpen = false;
		if (sortDropdownOpen) SeedMenuCursor(CurrentSort);
		SoundManager.PlayClick();
	}

	private void ToggleRarityDropdown()
	{
		rarityDropdownOpen = !rarityDropdownOpen;
		elementDropdownOpen = false;
		sortDropdownOpen = false;
		if (rarityDropdownOpen) SeedMenuCursor(CurrentRarity);
		SoundManager.PlayClick();
	}

	private void ToggleSortDirection()
	{
		SortAscending = !SortAscending;
		OnSortDirectionChanged?.Invoke(SortAscending);
		SoundManager.PlayClick();
	}

	// Hover blips honored in mouse mode only (DOC-5 #15): kb scroll-follow
	// slides rows under a parked cursor and fires synthetic onmouseover.
	private void OnTriggerHover()
	{
		if (KbMode) return;
		SoundManager.PlayHover();
	}

	// ONE CURSOR: mouse hover moves the SAME index the keyboard walks
	// (DOC-5 #6). Ignored in kb mode — the page flips to mouse on real
	// motion via its root onmousemove first, then hovers are honored.
	private void OnItemHover(int idx)
	{
		if (KbMode) return;
		if (focusedItemIndex == idx) return;
		focusedItemIndex = idx;
		SoundManager.PlayHover();
	}

	/// <summary>
	/// Keyboard inside an OPEN menu. Call FIRST in the page's TickInput
	/// (before its own zone handling) every tick a menu is open — including
	/// when the page cursor is elsewhere (mouse-opened menu) so Q always
	/// closes it. Returns true when a key was consumed this tick.
	///   W/S (Up/Down)      move the row cursor (clamp, no wrap) + scroll-follow
	///   Space/Enter/E      select the row (existing per-item handler) → menu closes
	///   Q/Tab (Menu/Score) close without changing (claims PanelHandledBackKey)
	///   A/D (Left/Right)   close + OnKbSideStep(trigger, ±1) — page moves its header cursor
	/// Escape is engine-reserved (DOC-5 #2) and deliberately not bound.
	/// </summary>
	public bool HandleKeyboard()
	{
		if (!IsAnyDropdownOpen) return false;
		var items = GetOpenMenuItems();
		if (items.Count == 0) { CloseAllDropdowns(); return false; }
		focusedItemIndex = Math.Clamp(focusedItemIndex, 0, items.Count - 1);

		if (Input.Pressed("Menu") || Input.Pressed("Score"))
		{
			CloseAllDropdowns();
			GameHUD.PanelHandledBackKey = true;
			SoundManager.PlayBack();
			return true;
		}
		if (Input.Pressed("Up"))
		{
			if (focusedItemIndex > 0) { focusedItemIndex--; SoundManager.PlayHover(); }
			menuScrollPending = true;
			return true;
		}
		if (Input.Pressed("Down"))
		{
			if (focusedItemIndex < items.Count - 1) { focusedItemIndex++; SoundManager.PlayHover(); }
			menuScrollPending = true;
			return true;
		}
		if (UiInput.ConfirmPressed())
		{
			ActivateFocusedItem(items[focusedItemIndex]);
			return true;
		}
		if (Input.Pressed("Left") || Input.Pressed("Right"))
		{
			int dir = Input.Pressed("Left") ? -1 : 1;
			var trigger = OpenTriggerPanel;
			CloseAllDropdowns();
			OnKbSideStep?.Invoke(trigger, dir);
			return true;
		}
		return false;
	}

	// Fires exactly what a click on the row does (Select* / OpenNameSearch),
	// which also closes the menu — the page's header cursor stays on the trigger.
	private void ActivateFocusedItem(string id)
	{
		if (elementDropdownOpen) SelectElement(id);
		else if (rarityDropdownOpen) SelectRarity(id);
		else if (sortDropdownOpen) ActivateSortItem(id);
	}

	private void ActivateSortItem(string id)
	{
		if (id == "name") OpenNameSearch();
		else SelectSort(id);
	}

	// Scroll-follow for the open menu (the element list outgrows the
	// 360px menu — 12 rows + ALL): retry until the row has a rect, compute
	// the offset that brings it fully into view, glide toward it.
	private void UpdateMenuScrollFollow()
	{
		var menu = OpenMenuPanel;
		if (menu == null) { menuScrollPending = false; menuScrollTarget = -1f; return; }
		if (menuScrollPending)
		{
			if (menu.Box.Rect.Height > 0f)
			{
				var t = UiGridScroll.ComputeIndexOffset(menu, focusedItemIndex, "dropdown-item", null, 8f);
				menuScrollTarget = t ?? -1f;
				menuScrollPending = false;
			}
		}
		if (menuScrollTarget < 0f) return;
		float cur = menu.ScrollOffset.y;
		float delta = menuScrollTarget - cur;
		if (Math.Abs(delta) < 1.5f)
		{
			menu.ScrollOffset = new Vector2(menu.ScrollOffset.x, menuScrollTarget);
			menuScrollTarget = -1f;
			return;
		}
		menu.ScrollOffset = new Vector2(menu.ScrollOffset.x, cur + delta * 0.30f);
	}

	private void SelectElement(string element)
	{
		CurrentElement = element;
		elementDropdownOpen = false;
		OnElementChanged?.Invoke(element);
		SoundManager.PlaySelect();
	}

	private void SelectSort(string sort)
	{
		CurrentSort = sort;
		sortDropdownOpen = false;
		OnSortChanged?.Invoke(sort);
		SoundManager.PlaySelect();
	}

	private void SelectRarity(string rarity)
	{
		CurrentRarity = rarity;
		rarityDropdownOpen = false;
		OnRarityChanged?.Invoke(rarity);
		SoundManager.PlaySelect();
	}

	private void OpenNameSearch()
	{
		sortDropdownOpen = false;
		nameSearchOpen = true;
		searchText = "";
		SoundManager.PlayForward();
	}

	private void CloseNameSearch()
	{
		nameSearchOpen = false;
		SoundManager.PlayBack();
	}

	// Flag to track if popup was clicked (to prevent overlay close)
	private bool popupClicked = false;

	private void OnPopupClicked()
	{
		// Mark that the popup was clicked - don't close
		popupClicked = true;
	}

	private void OnOverlayClicked()
	{
		// Only close if the popup wasn't clicked
		if (!popupClicked)
		{
			CloseNameSearch();
		}
		popupClicked = false;
	}

	private void SelectName(string name)
	{
		CurrentNameFilter = name;
		CurrentSort = "name";
		nameSearchOpen = false;
		OnNameFilterChanged?.Invoke(name);
		OnSortChanged?.Invoke("name");
		SoundManager.PlaySelect();
	}

	private List<string> GetFilteredNames()
	{
		if (string.IsNullOrEmpty(searchText))
			return AvailableNames.Take(20).ToList();

		return AvailableNames
			.Where(n => n.ToLower().Contains(searchText.ToLower()))
			.Take(20)
			.ToList();
	}

	private MonsterSpecies GetSpeciesByName(string name)
	{
		return MonsterManager.Instance?.GetAllSpecies()?.FirstOrDefault(s => s.Name == name);
	}

	// Close dropdowns when clicking elsewhere
	public void CloseAllDropdowns()
	{
		elementDropdownOpen = false;
		sortDropdownOpen = false;
		rarityDropdownOpen = false;
		menuScrollPending = false;
		menuScrollTarget = -1f;
	}

	// UI Helpers
	private string GetElementClass(string element)
	{
		if (element == "all" || element == "neutral") return "";
		return element;
	}

	private string GetElementIconPath(string element)
	{
		return element?.ToLower() ?? "neutral";
	}

	private string GetElementLabel(string element)
	{
		if (element == "all") return L("ui.filter.all_elements");
		return L($"ui.filter.{element}");
	}

	private string GetSortIconPath(string sort)
	{
		return sort switch
		{
			"power" => "ui/icons/sort/power.svg",
			"level" => "ui/icons/sort/arrow-up.svg",
			"genes" => "ui/icons/sort/dna.svg",
			"basestats" => "ui/icons/sort/chart.svg",
			"rarity" => "ui/icons/sort/star.svg",
			"fav" => "ui/icons/sort/heart.svg",
			"recent" => "ui/icons/sort/clock.svg",
			"beastiary" => "ui/icons/sort/beastiary-white.svg",
			"name" => "ui/icons/sort/search.svg",
			_ => "ui/icons/sort/power.svg"
		};
	}

	private string GetSortLabel(string sort)
	{
		return sort switch
		{
			"power" => L("ui.filter.sort_power"),
			"level" => L("ui.filter.sort_level"),
			"genes" => L("ui.filter.sort_genes"),
			"basestats" => L("ui.filter.sort_basestats"),
			"rarity" => L("ui.filter.sort_rarity"),
			"fav" => L("ui.filter.sort_favorites"),
			"recent" => L("ui.filter.sort_recent"),
			"beastiary" => L("ui.filter.sort_beastiary"),
			"name" => string.IsNullOrEmpty(CurrentNameFilter) ? L("ui.filter.sort_name") : CurrentNameFilter,
			_ => L("ui.filter.sort_power")
		};
	}

	// Menu-row label for the sort list — the "name" row always reads
	// SEARCH NAME (the trigger label is what shows the picked name).
	private string GetSortItemLabel(string sort)
	{
		if (sort == "name") return L("ui.filter.search_name");
		return GetSortLabel(sort);
	}

	private string GetRarityIconPath(string rarity)
	{
		if (rarity == "all") return "ui/icons/rarity/all.svg";
		return $"ui/icons/rarity/{rarity}.svg";
	}

	private string GetRarityClass(string rarity)
	{
		if (rarity == "all") return "";
		return rarity;
	}

	private string GetRarityLabel(string rarity)
	{
		if (rarity == "all") return L("ui.filter.all_rarities");
		return L($"ui.filter.{rarity}");
	}

	// Unmount (the roster swaps its collection / fusion bars): drop the open
	// flags so a host still holding the old @ref reads IsAnyDropdownOpen =
	// false and never routes keys into a dead menu.
	public override void OnDeleted()
	{
		CloseAllDropdowns();
		base.OnDeleted();
	}

	public override void Tick()
	{
		base.Tick();

		// Update search text from input
		if (searchInput != null && nameSearchOpen)
		{
			searchText = searchInput.Text ?? "";
		}

		UpdateMenuScrollFollow();
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add(CurrentElement);
		hash.Add(CurrentSort);
		hash.Add(CurrentRarity);
		hash.Add(CurrentNameFilter);
		hash.Add(SortAscending);
		hash.Add(elementDropdownOpen);
		hash.Add(sortDropdownOpen);
		hash.Add(rarityDropdownOpen);
		hash.Add(nameSearchOpen);
		hash.Add(searchText);
		hash.Add(focusedItemIndex); // menu row cursor (DOC-7 #22)
		hash.Add(KbMode);           // root .kbd-mode / .mouse-mode gate
		return hash.ToHashCode();
	}
}
