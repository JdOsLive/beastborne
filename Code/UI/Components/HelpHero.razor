@namespace Beastborne.UI.Components
@using Sandbox;
@using Sandbox.UI;
@inherits Panel

@*
    HelpHero — page-top hero for each Help subtab.
    88px diamond-frame icon (rotate 45 with counter-rotated iconify) + uppercase
    letterspaced title + optional italic subtitle + thin purple gradient rule.

    Vocabulary borrowed from FeedbackPanel .fb-empty diamond + roster section
    headers + the P5-stamp brand language.
*@

<root class="help-hero">
    <div class="help-hero-frame">
        <iconify icon="@HeroIcon" Size=@(38) Color="#c4b5fd" />
    </div>
    <div class="help-hero-text">
        <span class="help-hero-title">@HeroTitle</span>
        @if (!string.IsNullOrEmpty(HeroSubtitle))
        {
            <span class="help-hero-subtitle">@HeroSubtitle</span>
        }
    </div>
    <div class="help-hero-rule"></div>
</root>

@code {
    [Property] public string HeroIcon { get; set; } = "lucide:book-open";
    [Property] public string HeroTitle { get; set; } = "";
    [Property] public string HeroSubtitle { get; set; } = "";

    protected override int BuildHash()
    {
        return HashCode.Combine(HeroIcon, HeroTitle, HeroSubtitle);
    }
}
