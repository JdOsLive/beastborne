@namespace Beastborne.UI.Components
@using System.Linq;
@using Sandbox;
@using Sandbox.UI;
@using Beastborne.Core;
@using Beastborne.Systems;
@inherits Panel


<div class="notification-panel @(isExpanded ? "expanded" : "")">
	<!-- Expanded History View — always rendered, animated via CSS -->
	<div class="notification-history @(isExpanded ? "open" : "")">
			<div class="bg-scroll"><img src="ui/bg-patterns/bg-notifications.svg" /></div>
			<!-- Header -->
			<div class="notif-header">
				<div class="notif-header-left">
					<iconify icon="lucide:bell" Size=@(22) Color="#c4b5fd" />
					<span class="notif-title">@L("ui.notifications.title")</span>
				</div>
				<div class="notif-header-right">
					@{
						var unread = GetUnreadCount();
					}
					@if (unread > 0)
					{
						<span class="notif-badge">@unread @L("ui.notifications.new")</span>
					}
					<button class="close-btn" onclick=@ToggleExpanded><img class="close-icon" src="ui/icons/buttons/close.svg" /><img class="close-icon-anim" src="ui/icons/animated/close.webp" /></button>
				</div>
			</div>

			<!-- Filter Tabs -->
			<div class="notif-filter">
				<div class="nf-pill @(currentFilter == "all" ? "active" : "")" onclick=@(() => SetFilter("all"))><span>@L("ui.notifications.all")</span></div>
				<div class="nf-pill @(currentFilter == "game" ? "active" : "")" onclick=@(() => SetFilter("game"))><span>@L("ui.notifications.game")</span></div>
				<div class="nf-pill @(currentFilter == "social" ? "active" : "")" onclick=@(() => SetFilter("social"))><span>@L("ui.notifications.social")</span></div>
				<div class="nf-pill @(currentFilter == "system" ? "active" : "")" onclick=@(() => SetFilter("system"))><span>@L("ui.notifications.system")</span></div>
			</div>

			<!-- Notification List -->
			<div class="notif-list">
				@{
					var filtered = GetFilteredHistory();
				}
				@if (filtered.Count == 0)
				{
					<div class="no-notifications"><span>@L("ui.notifications.no_notifications")</span></div>
				}
				else
				{
					@foreach (var notification in filtered)
					{
						<div class="notif-msg @GetTypeClass(notification.Type)">
							<div class="ni @GetTypeClass(notification.Type)">
								@if (notification.HasImageIcon)
								{
									<img class="ni-img" src=@notification.IconPath />
								}
								else
								{
									<iconify icon="@GetNotificationIconName(notification.Type)" Size=@(20) Color="@GetNotificationIconColor(notification.Type)" />
								}
							</div>
							<div class="nc">
								<span class="nt @GetTypeClass(notification.Type)">@notification.Title</span>
								<span class="ns">@notification.Message</span>
							</div>
							<span class="ntime">@GetTimeAgo(notification.CreatedAt)</span>
						</div>
					}
				}
			</div>

			<!-- Clear All -->
			@if (GetHistory().Count > 0)
			{
				<div class="notif-clear">
					<div class="notif-clear-btn" onclick=@ClearHistory><span>@L("ui.notifications.clear_all")</span></div>
				</div>
			}
		</div>

	@if (!isExpanded)
	{
		<!-- Toast Notifications (below button) -->
		@foreach (var notification in GetNotifications())
		{
			<div class="notification @GetTypeClass(notification.Type) @(_dismissingIds.Contains(notification.Id) ? "dismissing" : "")" onclick=@(() => DismissNotification(notification.Id))>
				<div class="notification-icon">
					@if (notification.HasImageIcon)
					{
						<img class="notification-icon-img" src=@notification.IconPath />
					}
					else
					{
						<iconify icon="@GetNotificationIconName(notification.Type)" Size=@(20) Color="@GetNotificationIconColor(notification.Type)" />
					}
				</div>
				<div class="notification-content">
					<div class="notification-title">@notification.Title</div>
					<div class="notification-message">@notification.Message</div>
				</div>
				<div class="notification-close"><img class="close-icon" src="ui/icons/buttons/close.svg" /></div>
				<div class="notification-progress">
					<div class="notification-progress-bar" style="width: @(notification.Progress * 100)%"></div>
				</div>
			</div>
		}
	}
</div>

@code {
	// Localization helper
	private string L( string key ) => LocalizationManager.Get( key );
	private string L( string key, params object[] args ) => LocalizationManager.Get( key, args );

	private bool isExpanded = false;
	private string currentFilter = "all";
	private HashSet<Guid> _dismissingIds = new();

	// Static instance for external access
	public static NotificationPanel Instance { get; private set; }

	// Static property so other components can check if notifications are open
	public static bool IsNotificationsExpanded { get; private set; } = false;

	/// <summary>
	/// Static toggle for external callers (e.g. bottom bar button)
	/// </summary>
	public static void Toggle() => Instance?.ToggleExpanded();

	/// <summary>
	/// Static unread count for external callers
	/// </summary>
	public static int UnreadCount => Instance?.GetUnreadCount() ?? 0;

	protected override void OnAfterTreeRender( bool firstTime )
	{
		if ( firstTime ) Instance = this;
	}

	private List<Notification> GetNotifications()
	{
		return NotificationManager.Instance?.ActiveNotifications?.ToList() ?? new();
	}

	private List<Notification> GetHistory()
	{
		return NotificationManager.Instance?.NotificationHistory?.ToList() ?? new();
	}

	private List<Notification> GetFilteredHistory()
	{
		var history = GetHistory();
		if (currentFilter == "all") return history;
		return history.Where(n => GetFilterCategory(n.Type) == currentFilter).ToList();
	}

	private string GetFilterCategory(NotificationType type)
	{
		return type switch
		{
			NotificationType.Evolution => "game",
			NotificationType.Catch => "game",
			NotificationType.ServerBoost => "game",
			NotificationType.ExpeditionUnlock => "game",
			NotificationType.Achievement => "game",
			NotificationType.TamerLevelUp => "game",
			NotificationType.RankedBattle => "social",
			_ => "system"
		};
	}

	private int GetUnreadCount()
	{
		return NotificationManager.Instance?.UnreadCount ?? 0;
	}

	private string GetNotificationIconName(NotificationType type)
	{
		return type switch
		{
			NotificationType.Achievement    => "lucide:trophy",
			NotificationType.Evolution      => "lucide:zap",
			NotificationType.Catch          => "lucide:target",
			NotificationType.ServerBoost    => "lucide:rocket",
			NotificationType.TamerLevelUp   => "lucide:trending-up",
			NotificationType.RankedBattle   => "lucide:swords",
			NotificationType.ExpeditionUnlock => "lucide:map",
			NotificationType.Warning        => "lucide:triangle-alert",
			NotificationType.Success        => "lucide:check-circle",
			_                               => "lucide:info"
		};
	}

	private string GetNotificationIconColor(NotificationType type)
	{
		return type switch
		{
			NotificationType.Achievement    => "#fcd34d",
			NotificationType.Evolution      => "#c4b5fd",
			NotificationType.Catch          => "#60a5fa",
			NotificationType.ServerBoost    => "#4ade80",
			NotificationType.TamerLevelUp   => "#fbbf24",
			NotificationType.RankedBattle   => "#f472b6",
			NotificationType.ExpeditionUnlock => "#34d399",
			NotificationType.Warning        => "#f87171",
			NotificationType.Success        => "#34d399",
			_                               => "#c4b5fd"
		};
	}

	private string GetTypeClass(NotificationType type)
	{
		return type switch
		{
			NotificationType.Info => "info",
			NotificationType.Success => "success",
			NotificationType.Warning => "warning",
			NotificationType.Evolution => "evolution",
			NotificationType.ServerBoost => "server-boost",
			NotificationType.RankedBattle => "ranked-battle",
			NotificationType.Catch => "catch",
			NotificationType.TamerLevelUp => "tamer-level-up",
			NotificationType.ExpeditionUnlock => "expedition-unlock",
			NotificationType.Achievement => "achievement",
			_ => "info"
		};
	}

	private string GetTimeAgo(DateTime time)
	{
		var diff = DateTime.UtcNow - time;
		if (diff.TotalSeconds < 60) return "Just now";
		if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m";
		if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h";
		return $"{(int)diff.TotalDays}d";
	}

	private void SetFilter(string filter)
	{
		if (currentFilter == filter) return;
		currentFilter = filter;
		SoundManager.PlayTabSwitch();
	}

	private void DismissNotification(Guid id)
	{
		if (_dismissingIds.Contains(id)) return;
		SoundManager.PlayClick();
		_dismissingIds.Add(id);
		StateHasChanged();
		_ = RemoveAfterDismissAnimation(id);
	}

	private async Task RemoveAfterDismissAnimation(Guid id)
	{
		await Task.Delay(220);
		_dismissingIds.Remove(id);
		NotificationManager.Instance?.RemoveNotification(id);
		StateHasChanged();
	}

	private void ToggleExpanded()
	{
		isExpanded = !isExpanded;
		IsNotificationsExpanded = isExpanded;
		if (isExpanded)
		{
			NotificationManager.Instance?.MarkAllRead();
			SoundManager.PlayPopup();
		}
		else
		{
			SoundManager.PlayPopdown();
		}
	}

	private void ClearHistory()
	{
		NotificationManager.Instance?.ClearHistory();
		SoundManager.PlayBack();
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add(isExpanded);
		hash.Add(currentFilter);
		hash.Add(GetNotifications().Count);
		hash.Add(GetHistory().Count);
		hash.Add(GetUnreadCount());
		hash.Add(_dismissingIds.Count);
		foreach (var n in GetNotifications())
		{
			hash.Add(n.Id);
			hash.Add((int)(n.Progress * 100));
			hash.Add(_dismissingIds.Contains(n.Id));
		}
		return hash.ToHashCode();
	}
}
