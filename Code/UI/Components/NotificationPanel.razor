@namespace Beastborne.UI.Components
@using System.Linq;
@using Sandbox;
@using Sandbox.UI;
@using Beastborne.Core;
@using Beastborne.Systems;
@inherits Panel

@*
	NOTIFICATION PEEKS (v10, 2026-07-12) — the floating toast stack + the
	draggable history dropdown are RETIRED (user: "can popup notifications
	just be on the notifications app of your phone instead? they are so
	oddly placed and i hate it"). The PawPad's ALERTS app is the ONE
	persistent record now (PhoneLauncher reads NotificationHistory — up
	to 50, written at AddNotification time, so dismissal never loses
	anything). This component renders only the transient "phone peek"
	stream: compact cards in the phone's own row dialect that slide out
	of the PawPad button's corner (bottom-right, stacked directly above
	the paw chip, right edges aligned), read for ~3.6s, then slide back
	toward the phone. Clicking a peek opens the phone onto ALERTS.
	Max 3 live peeks; older ones dim/compress. Mouse-only — no keyboard
	cursor on ephemera (N still opens the alerts app via NavManager).

	Engine laws honored: entrance = @@keyframes on MOUNT (each peek is a
	fresh transient element — the one lawful mount-keyframe use); exit =
	class toggle + transition (replays every time, keyframes wouldn't);
	anchored `position: absolute` against the fullscreen HUD root (no
	position: fixed); every bare string wrapped in a <span>.
*@

<root class="peek-root">
	@{ var last = LastLivePeek(); }
	@foreach (var p in _peeks)
	{
		<div class="peek @(p.Leaving ? "leaving" : "") @(!p.Leaving && p != last ? "stale" : "")"
		     onclick=@OnPeekClicked>
			<div class="peek-icon">
				@if (p.Notif.HasImageIcon)
				{
					<img class="peek-icon-img" src=@p.Notif.IconPath />
				}
				else
				{
					<iconify icon="@GetNotificationIconName(p.Notif.Type)" Size=@(18) Color="@GetNotificationIconColor(p.Notif.Type)" />
				}
			</div>
			<div class="peek-body">
				<span class="peek-title" style="color: @GetNotificationIconColor(p.Notif.Type);">@p.Notif.Title</span>
				<span class="peek-msg">@p.Notif.Message</span>
			</div>
		</div>
	}
</root>

@code {
	// ── Peek model ──────────────────────────────────────────────────────
	private class Peek
	{
		public Notification Notif;
		public float BornAt;
		public bool Leaving;
		public float GoneAt;   // when a leaving peek is removed from the list
	}

	private readonly List<Peek> _peeks = new();
	private readonly HashSet<Guid> _seen = new();

	private const int MaxPeeks = 3;
	private const float PeekLifeSeconds = 3.6f;
	private const float PeekExitSeconds = 0.24f;

	/// <summary>Unread count for the HUD chip + PawPad badges (proxies the manager).</summary>
	public static int UnreadCount => NotificationManager.Instance?.UnreadCount ?? 0;

	/// <summary>Time.Now stamp of the most recent peek arrival — GameHUD
	/// reads this to pop the PawPad chip when the phone "announces".</summary>
	public static float LastPeekBornAt { get; private set; } = -999f;

	public override void Tick()
	{
		base.Tick();

		var active = NotificationManager.Instance?.ActiveNotifications;
		if (active != null)
		{
			foreach (var n in active)
			{
				if (_seen.Contains(n.Id)) continue;
				_seen.Add(n.Id);

				// While the phone is up, the app list + badge already show
				// it — announcing over the announcer would be noise.
				if (PhoneLauncher.IsVisible) continue;

				_peeks.Add(new Peek { Notif = n, BornAt = Time.Now });
				LastPeekBornAt = Time.Now;

				// Max 3 live peeks — push the oldest out early.
				var live = _peeks.Where(p => !p.Leaving).ToList();
				for (int i = 0; i < live.Count - MaxPeeks; i++)
					BeginLeave(live[i]);
			}

			// Prune the seen-set against the active list (expired ids never
			// return, so this can't re-admit an old notification).
			if (_seen.Count > 0)
				_seen.RemoveWhere(id => !active.Any(n => n.Id == id));
		}

		// Session-restart sanity: Time.Now resets to ~0 per editor session
		// while instance fields can survive hotload — future stamps are stale.
		if (LastPeekBornAt > Time.Now + 1f) LastPeekBornAt = -999f;

		// Age out.
		for (int i = _peeks.Count - 1; i >= 0; i--)
		{
			var p = _peeks[i];
			if (p.BornAt > Time.Now + 1f) p.BornAt = Time.Now;       // stale-session stamp
			if (p.GoneAt > Time.Now + 1f) p.GoneAt = Time.Now;       // stale-session stamp
			if (!p.Leaving && Time.Now - p.BornAt >= PeekLifeSeconds) BeginLeave(p);
			if (p.Leaving && Time.Now >= p.GoneAt) _peeks.RemoveAt(i);
		}
	}

	private void BeginLeave(Peek p)
	{
		if (p.Leaving) return;
		p.Leaving = true;
		p.GoneAt = Time.Now + PeekExitSeconds;
	}

	private Peek LastLivePeek() => _peeks.LastOrDefault(p => !p.Leaving);

	private void OnPeekClicked()
	{
		SoundManager.PlayClick();
		// Everything on screen is already in the record — sweep the peeks
		// and open the phone onto ALERTS (which marks all read).
		foreach (var p in _peeks) BeginLeave(p);
		PhoneLauncher.OpenToApp("alerts");
	}

	// ── Per-type icon vocabulary (carried over from the old toast) ──────
	private string GetNotificationIconName(NotificationType type)
	{
		return type switch
		{
			NotificationType.Achievement    => "lucide:trophy",
			NotificationType.Evolution      => "lucide:zap",
			NotificationType.Catch          => "lucide:target",
			NotificationType.ServerBoost    => "lucide:rocket",
			NotificationType.TamerLevelUp   => "lucide:trending-up",
			NotificationType.RankedBattle   => "lucide:swords",
			NotificationType.ExpeditionUnlock => "lucide:map",
			NotificationType.Warning        => "lucide:triangle-alert",
			NotificationType.Success        => "lucide:check-circle",
			_                               => "lucide:info"
		};
	}

	private string GetNotificationIconColor(NotificationType type)
	{
		return type switch
		{
			NotificationType.Achievement    => "#fcd34d",
			NotificationType.Evolution      => "#c4b5fd",
			NotificationType.Catch          => "#60a5fa",
			NotificationType.ServerBoost    => "#4ade80",
			NotificationType.TamerLevelUp   => "#fbbf24",
			NotificationType.RankedBattle   => "#f472b6",
			NotificationType.ExpeditionUnlock => "#34d399",
			NotificationType.Warning        => "#f87171",
			NotificationType.Success        => "#34d399",
			_                               => "#c4b5fd"
		};
	}

	// ────────────────────────────────────────────────────────────────────
	// TEMP dev tooling — REMOVE once peek verification is done.
	// `dev_notify` fires one test notification; `dev_notify 4` fires four
	// rapid ones to exercise the max-3 stack compression.
	// ────────────────────────────────────────────────────────────────────
	[ConCmd("dev_notify")]
	public static void DevNotify(int count = 1)
	{
		var types = new[] { NotificationType.Success, NotificationType.Catch, NotificationType.TamerLevelUp, NotificationType.Achievement, NotificationType.Info };
		for (int i = 0; i < count; i++)
		{
			var t = types[i % types.Length];
			NotificationManager.Instance?.AddNotification(t, $"Test {t}", $"Peek verification #{i + 1} — routed via the PawPad.", 5f);
		}
	}

	// TEMP — REMOVE with dev_notify: opens the PawPad onto the ALERTS app
	// (what clicking a peek / pressing N does) for hands-off verification.
	[ConCmd("dev_alerts")]
	public static void DevAlerts()
	{
		PhoneLauncher.OpenToApp("alerts");
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add(_peeks.Count);
		foreach (var p in _peeks)
		{
			hash.Add(p.Notif.Id);
			hash.Add(p.Leaving);
		}
		// Which peek is "last live" drives the .stale class distribution.
		hash.Add(LastLivePeek()?.Notif.Id ?? Guid.Empty);
		return hash.ToHashCode();
	}
}
