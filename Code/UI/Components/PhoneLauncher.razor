    // ── DEV: bloom-disc inspector (the dev_fusefx pattern) ───────────────
    // dev_bloom hold   — freeze the launch bloom at the FULL opaque disc (opens
    //                    Chat if no app is up) so a screenshot can inspect the
    //                    clip host + the disc geometry at leisure
    // dev_bloom play   — replay the launch bloom on the current app (last seed)
    // dev_bloom off    — release a hold (the disc fade proceeds)
    // dev_bloom close  — run the reverse bloom (CloseApp)
    [ConCmd( "dev_bloom" )]
    public static void DevBloom( string mode = "hold" )
    {
        var me = Instance;
        if ( me == null ) { Log.Warning( "[dev_bloom] PhoneLauncher not mounted." ); return; }
        switch ( mode )
        {
            case "hold":
                if ( me._appView == null || !IsVisible ) { DevOpenApp( "chat" ); me = Instance; if ( me == null ) return; }
                me._devBloomHold = true;
                if ( me._bloomArmFrames <= 0 && me._appView != null )
                {
                    // Already landed: re-raise the disc and hold it there.
                    me._bloomCircleGrow = true;
                    me._bloomCircleFade = false;
                    me._bloomCircleFadeAt = -1f;
                    me._appUiOn = true;
                    me._appUiAt = -1f;
                }
                me.StateHasChanged();
                Log.Info( "[dev_bloom] HOLD — disc full + opaque (dev_bloom off releases it)." );
                break;
            case "play":
                if ( me._appView == null || !IsVisible ) { DevOpenApp( "chat" ); Log.Info( "[dev_bloom] PLAY — opened Chat (launch bloom from the screen centre)." ); return; }
                me._devBloomHold = false;
                me._bloomLive = false;
                me._appUiOn = false;
                me._appUiAt = -1f;
                me._bloomCircleGrow = false;
                me._bloomCircleFade = false;
                me._bloomCircleFadeAt = -1f;
                me._appClosingUntil = -1f;
                me._appUnmountAt = -1f;
                me._bloomArmFrames = 2;
                me.StateHasChanged();
                Log.Info( "[dev_bloom] PLAY — replaying the launch bloom from the last seed." );
                break;
            case "off":
                me._devBloomHold = false;
                if ( me._bloomCircleGrow && !me._bloomCircleFade ) me._bloomCircleFadeAt = Time.Now;
                Log.Info( "[dev_bloom] released." );
                break;
            case "close":
                me._devBloomHold = false;
                me.CloseApp();
                Log.Info( "[dev_bloom] CLOSE — reverse bloom." );
                break;
            default:
                Log.Warning( "[dev_bloom] modes: hold | play | off | close" );
                break;
        }
    }

    // ── App registry — grid order (3 cols × 4 rows) ─────────────────────
    // Each destination owns ONE accent (guiding-star three-color identity:
    // that token drives the icon fill, the badge, and the accent swipe).
    //
    // ⚠ HOTLOAD DATA-STALENESS LAW (learned the hard way): this array is
    // static, and s&box hotload MIGRATES static data across recompiles by
    // copying record members BY NAME — the initializer never re-runs. When
    // v2 renamed the `Liquid` flag to `Sweep`, every live session's
    // migrated PhoneApp got Sweep=default(false) and EVERY destination
    // silently took the widget branch (log-proven: "[sweepdbg] widget
    // launch 'beasts'"). Rules: (1) behavior BRANCHES live in code
    // (IsWidgetApp below), never in migrated data; (2) never rename a
    // field in this record without expecting stale values until a full
    // editor restart.
    private record PhoneApp( string Id, string Label, string Icon, string Accent, string Key, bool IsTab, string RouteId, bool DarkGlyph );

