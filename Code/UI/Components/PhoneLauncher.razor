    // ── Open/close plumbing ──────────────────────────────────────────────
    private void ResetForOpen()
    {
        ResetAppState(); // rev-7: every open lands on the grid (OpenToApp re-opens its app right after)
        // Land the cursor on the CURRENT tab's tile (tabs occupy tiles 0-5
        // in NavManager order) so Enter re-launches where you are.
        var idx = NavManager.IndexOf( NavManager.CurrentTab );
        _kb = idx >= 0 ? idx : 0;
        _ringWarmup = 0;   // ring SNAPS to its first position on open, glides thereafter
        _ringDirty = true; // wake the event-driven ring update
        // v4.2: the ring is at root level — it no longer rides the wrap's
        // entrance slide, so keep re-targeting until the icons settle
        // (0.28s slide + margin). The ring's own opacity delay hides the
        // chase; it fades in already on target.
        _ringHoldUntil = Time.Now + 0.4f;
    }

    // v7.2 MOUSE ROUTER — the backdrop catches EVERY click while the phone
    // is open (the device subtree never receives pointer events: the
    // engine hit-tests layout rects, ~30-50px off the paint under the
    // lean, and a pointer-events:none ancestor blocks children's auto —
    // clicks were landing on the GAME behind the phone, user-reported).
    // Inverse-project the cursor into layout space and route.
    private void OnBackdropClicked()
    {
        // v9: in an app view, hit-test the app controls instead of tiles.
        if ( _appView != null )
        {
            if ( _appClosingUntil > 0f )
            {
                // Reverse bloom in flight (the view stays mounted for its first
                // 120ms): taps ON the phone wait, a tap OUTSIDE it still closes.
                if ( !IsOnDevice( Mouse.Position ) ) Close();
                return;
            }
            var act = ActionAtScreen( Mouse.Position );
            if ( WALK_DEBUG ) Log.Info( $"[walkdbg] appview click -> {act ?? "none"}" );
            // Any tap that isn't the input, SEND or a channel pill (all three keep
            // you typing — 2026-09-01: switching channel mid-sentence used to drop
            // the keyboard) takes it back from the TextEntry — nothing else would.
            bool keepsTyping = act == "hit-input" || act == "hit-send" || ( act != null && act.StartsWith( "hit-chan-" ) );
            if ( !keepsTyping ) BlurPhoneInput();
            if ( act != null ) { RunAppAction( act ); return; }
            // 2026-09-01 (usability audit): a tap on the phone BODY that hits no
            // control (header, wallpaper, the gap between rows) is inert — it used
            // to close the whole phone, so a misclick threw the player out.
            if ( IsOnDevice( Mouse.Position ) ) return;
            // Clicked outside the phone = close entirely. The app view STAYS
            // mounted for the 180ms slide-out (polish pass 2026-08-30: resetting
            // here mounted the home grid under the departing phone — the "goes
            // into one form" flash); ResetForOpen resets on the next Show().
            Close();
            return;
        }
        int idx = TileAtScreen( Mouse.Position );
        if ( WALK_DEBUG ) Log.Info( $"[walkdbg] backdrop click at {Mouse.Position} -> tile {idx}" );
        if ( idx >= 0 ) { LaunchIndex( idx ); return; }
        if ( IsOnDevice( Mouse.Position ) ) return; // a miss between tiles is inert, not a close (2026-09-01)
        Close();
    }

    // Is a SCREEN-px point on the device (bezel included)? The lean is zero
    // (v9 FLAT), so the layout rect IS the paint; if the lean ever returns,
    // inverse-project first (TileAtScreen shows the recipe).
    private bool IsOnDevice( Vector2 screenPx )
    {
        if ( _deviceRef == null ) return false;
        var r = _deviceRef.Box.Rect;
        if ( r.Width < 1f ) return false;
        return screenPx.x >= r.Left && screenPx.x <= r.Right && screenPx.y >= r.Top && screenPx.y <= r.Bottom;
    }

    private void HoverTile( int i )
    {
        if ( !IsVisible || i == _kb ) return;
        _kb = i;
        _ringDirty = true;
        SoundManager.PlayHover();
    }

    // ── Launch ───────────────────────────────────────────────────────────
    private void LaunchIndex( int i )
    {
        if ( i < 0 || i >= GridCount + DockCount ) return;
        // Reverse bloom: only the first 120ms (old view still mounted) block a
        // launch. 2026-09-01 (usability audit): once the grid is up (+120ms) the
        // disc is merely collapsing — a launch re-seeds it on the new tile and it
        // blooms from wherever it is. Before, Enter/click were SWALLOWED for the
        // whole 360ms, which read as "the phone ignored me".
        if ( _appView != null && _appClosingUntil > 0f ) return;
        if ( i >= GridCount ) { LaunchDock( i - GridCount ); return; }
        var app = Apps[i];
        _kb = i;
        _ringDirty = true;

        if ( !IsWidgetApp( app.Id ) )
        {
            SoundManager.PlayForward();
            StartSwipe( i, app );
        }
        else
        {
            // v9: widget apps open ON the phone (TamerLink OS apps — user
            // call: "the chat lives in the phone"), no popup, no sweep.
            if ( SWEEP_DEBUG ) Log.Info( $"[sweepdbg] widget launch '{app.Id}' — opens IN-PHONE t={Time.Now:F3}" );
            OpenApp( app.Id );
        }
    }

    // ═══ IN-PHONE APPS (TamerLink OS v9 → the rev-7 apps build, 2026-08-29) ═
    // chat / radio / effects / alerts open ON the phone screen (user call —
    // "the chat lives in the phone"). Brief: .claude/design-system/components/
    // pawpad-apps-brief.html rev 7. State + routing in code (hotload law).
    // EVERY field a view renders is in BuildHash — the view never updates
    // otherwise.
    private string _appView;             // null = home grid
    private string _phoneChan = "global";
    private Panel _appviewRef;
    private Panel _chatScrollRef;
    private Panel _listScrollRef;        // effects / alerts scroller — the wheel routes to the ACTIVE app's ref
    private ChatInputBox _phoneChatBox;

    // ── Overlay scrollbar (rev 7.1) — the Beastbook dossier recipe. Track +
    // thumb geometry is written imperatively in px, only when a value
    // changes; the writes are gated to wheel / 1 Hz / post-cascade so the
    // leaned subtree is never dirtied per frame (the 7fps law). ──
    private Panel _sbTrackRef, _sbThumbRef;
    private Panel _sbSeenTrack;                 // ReferenceEquals guard — a remount invalidates the caches
    private int _sbTrackTop = -1, _sbTrackH = -1, _sbThumbTop = -1, _sbThumbH = -1;
    private bool _sbOn;                         // markup-driven .on (hashed) — false when the content fits
    private int _sbDirtyFrames;                 // frames left to re-measure (wheel / auto-scroll / open)
    private float _sbRefreshAt = -1f;           // one-shot re-measure after the cascade settles

    private Panel ActiveScroller() => _appView == "chat" ? _chatScrollRef : ( _appView is "effects" or "alerts" ? _listScrollRef : null );

    private void ArmScrollbar( int frames = 2 ) => _sbDirtyFrames = Math.Max( _sbDirtyFrames, frames );

    // Thumb math (proven ratio recipe): rect px and scroll px are commensurate,
    // so viewH / (viewH + maxOff) and offset / maxOff are unit-free — only the
    // track length is converted to style px (× ScaleFromScreen). Box.Rect is
    // LAYOUT space (pre-transform, log-proven in v5), and the track lives in
    // the same leaned subtree as the list, so the flat delta needs no projection.
    private void UpdateAppScrollbar()
    {
        var sref = ActiveScroller();
        if ( _sbTrackRef == null || _sbThumbRef == null || sref == null || _appviewRef == null ) return;

        if ( !ReferenceEquals( _sbSeenTrack, _sbTrackRef ) )
        {
            // Fresh mount (app switch re-keyed the view) — the caches describe a dead panel.
            _sbSeenTrack = _sbTrackRef;
            _sbTrackTop = _sbTrackH = _sbThumbTop = _sbThumbH = -1;
        }

        float maxOff = sref.ScrollSize.y;
        if ( maxOff < 2f ) { _sbOn = false; return; }

        var ar = _appviewRef.Box.Rect;
        var sr = sref.Box.Rect;
        if ( ar.Height < 1f || sr.Height < 1f ) return;

        float sc = ScaleFromScreen;
        if ( sc <= 0.01f || float.IsNaN( sc ) || float.IsInfinity( sc ) ) sc = 1f;

        int trackTop = (int)( ( sr.Top - ar.Top ) * sc );
        int trackH = (int)( sr.Height * sc );
        if ( trackH < 30 ) return;
        float viewH = sr.Height;
        float contentH = viewH + maxOff;
        int thumbH = Math.Max( 24, (int)( trackH * ( viewH / contentH ) ) );
        int thumbTop = (int)( ( trackH - thumbH ) * ( sref.ScrollOffset.y / maxOff ) );
        thumbTop = Math.Clamp( thumbTop, 0, Math.Max( 0, trackH - thumbH ) ); // a wheel write can overshoot until the engine clamps

        if ( trackTop != _sbTrackTop ) { _sbTrackRef.Style.Top = Length.Pixels( trackTop ); _sbTrackTop = trackTop; }
        if ( trackH != _sbTrackH ) { _sbTrackRef.Style.Height = Length.Pixels( trackH ); _sbTrackH = trackH; }
        if ( thumbH != _sbThumbH ) { _sbThumbRef.Style.Height = Length.Pixels( thumbH ); _sbThumbH = thumbH; }
        if ( thumbTop != _sbThumbTop ) { _sbThumbRef.Style.Top = Length.Pixels( thumbTop ); _sbThumbTop = thumbTop; }
        _sbOn = true;
    }

