@namespace Beastborne.UI.Components
@using System;
@using System.Collections.Generic;
@using Sandbox;
@using Sandbox.UI;
@using Beastborne.UI;
@using Beastborne.UI.Primitives;
@using Beastborne.Systems;
@inherits Panel

@*
    PhoneLauncher v3 — the PawPad, running TamerLink OS (player-facing
    branding only; code identity stays PhoneLauncher). The phone-shaped
    navigation launcher (Fable 5 sweep, guiding-star §Navigation).
    Summoned by the MENU button / Slot8; the persistent bottom bar stays
    mounted for now (A/B trial — retirement comes after the user blesses
    the phone).

    v4 (live screenshot feedback — "sell the DEVICE"):
    - HIGHLIGHT BARS REMOVED (user dislikes) — the gold→violet energy
      hairline is deleted and the header's gold accent rule is switched
      off (AccentWidth 0 in markup + display:none in our scss — a 0-width
      div can still render as an artifact; empty-div quirk). The title
      breathes on its own.
    - REAL BEZEL — .pl-shell wraps the screen: near-black frame (r-38
      outer / screen keeps r-30; 10px sides, 20px top strip, 12px chin),
      speaker slit + camera lens centered in the top strip, two side-
      button nubs on the LEFT (receding) edge. Footprint 576px wide incl.
      bezel — every doctrine width recomputed: screen content 512, tiles
      160, gaps 16 (rows sum 512 exactly). Shadow/lean/entrance unchanged.
    - LABELS RE-CENTERED, v4.1 FINAL (v4's main-axis-width theory was
      DISPROVEN live: the 160px/392px boxes held, yet the text still drew
      left — text-align is a NO-OP under the leaned ancestor, because the
      transform poisons derived width resolution and the Label's inner
      text box collapses to content width; nothing to align within).
      Fix: centering BY CONSTRUCTION — auto-width spans + razor-computed
      margin-left (LabelPadPx/NamePadPx, calibrated glyph estimates).
      Doctrine: inside a transformed subtree, only explicit px layout
      exists; text-align does not.
    - AVATAR (screenshot: no circle) — the command bar's cb-avatar recipe
      copied VERBATIM (fallback emoji span + absolute 50%+negative-half-
      margin img — cb's comment says flex-centering shifts images), then
      cosmetics adapted to a 22px circle with a 2px violet rim. One-shot
      [pawpad] log of the resolved src fires on first visible frame so
      the next session can diagnose from the log if it's STILL missing.
    - HINTS REBUILT (screenshot: WASD wrapped to "WA/SD"; ENTER cap an
      empty gold blob) — the caps were sized under their text (32px for
      4 chars) with auto-width spans centered by justify-content (zero-
      width anchor under the lean). Every cap AND its inner span now
      carry explicit widths + white-space: nowrap; ENTER's dark GoldInk
      on gold verified in the scss.
    - FPS FIX (live: 7fps open / 43-87 closed) — the ring's per-frame
      ink-lean wave (`Style.Transform` write EVERY frame on an element
      INSIDE the perspective-leaned device) re-dirtied the whole leaned
      subtree each frame and forced a full 3D re-composite. THE WAVE IS
      RETIRED on the PawPad (the menu keeps its waving cursor at ROOT
      level, outside its tilted panels — that's why it's cheap there).
      Ring rect math is now EVENT-DRIVEN (_ringDirty on open/focus move,
      not per-frame), and ClockText is cached (refreshed ≤1/s) so
      BuildHash isn't allocating a DateTime string per frame. Target:
      zero measurable per-frame work while open and idle.
    - ANCHOR HARDENED (live: only a ~40px sliver at the right edge) —
      the root placed the AUTO-width .pl-wrap with justify-content:
      flex-end — the doctrine's zero-width-anchor pattern at the one
      scope it hadn't been applied to. .pl-wrap and .pl-device now carry
      explicit width 576px so flex-end sums a real number. (The sliver
      was possibly also mid-edit hotload — the shell div briefly existed
      with no scss — but the explicit widths make the anchor lawful
      either way.)

    v3.1 (live-test feedback + "make it actually look good" pass):
    - SWEEP BUG ROOT-CAUSED — log-proven: every MAIN APP took the widget
      branch ("[sweepdbg] widget launch 'beasts'"). The record flag was
      renamed Liquid→Sweep in v2, and s&box hotload migrates STATIC data
      across recompiles by copying record members BY NAME — no name match,
      so every migrated PhoneApp got Sweep=default(false), and every later
      hotload faithfully copied the stale false forward. Fix: destination
      vs widget is now classified IN CODE (IsWidgetApp — method bodies are
      always fresh after hotload; only DATA can go stale). The Sweep field
      is deleted so nothing misleading remains. ⚠ Never rename fields in
      the PhoneApp record without expecting a full-restart requirement.
    - RIGHT-SIDE ANCHOR — the phone lives at the right edge (72px in,
      vertically centered) so the game stays visible; entrance is a
      slide-in from the right edge, exit mirrors. Backdrop dim lightened
      to 0.55 — seeing the game behind is now the point.
    - THE LEAN FLIPPED — perspective(1600px) rotateY(-13deg), origin
      right center (the PawPad mockup's values): right side toward the
      camera, left recedes, sold by a left-edge shade overlay + the
      energy hairline along the top edge (device is "on").
    - FOCUS POP — the focused icon lifts toward the player
      (translateY(-4px) scale(1.06), 0.12s) and the living ring RIDES the
      lift: Box.Rect doesn't move with CSS transforms, so UpdateRing
      mirrors the pop into the ring's target rect (the menu's SelectedPop
      lockstep). Press settles back down to scale(0.98) inside the ring.
    - HEADER v2 — PROTOTYPE stamp deleted; status row gains signal bars;
      TAMERLINK OS eyebrow in violet over a 34px italic PawPad with the
      gold accent rule (BbSectionHeader, KickerColor override); Steam
      avatar (command-bar house pattern) beside the tamer line.
    - DOCTRINE TIGHTENED (live: EXPEDITION's label row overran its tile
      and clipped the body edge) — justify-content placement of AUTO-width
      children drifts too, not just space-between/align-items. Labels are
      now single full-width text-align: center spans; keycaps ride the
      icon corner as fixed absolutes; the hints/status rows give every
      child an explicit width. Full strict doctrine in the SCSS header.

    v3 (live-test feedback):
    - THE LIVING RING — the per-tile static rings are dead; ONE violet
      cursor ring (the main menu's signature) glides between focused
      icons on the 0.27s signature ease, with the ink-lean wave running
      per-frame (menu's multi-sine at 60% amplitude). It lives INSIDE
      .pl-grid, so it shares the device's 3D lean with the icons —
      flat Box.Rect delta math positions it, no perspective compensation
      needed (unlike MainMenu's tilted-panel cursor). Snaps on open
      (warmup frames), glides thereafter.
    - ALIGNMENT HARDENED — v2 drifted right in-engine: auto-width flex
      children placed by align-items/space-between landed as if their
      width were zero (labels started at the icon's center and ran right;
      the stamp/LV line ran off the body edge). Fix: every centered or
      right-anchored box now has an EXPLICIT width; centering is done by
      justify-content inside fixed boxes or hard margins, never by
      cross-axis auto placement. Absolute badges get explicit widths
      (width:auto never shrink-wraps an absolute element — quirk).
    - SWEEP_DEBUG — temp per-phase Log.Info proving the accent swipe
      runs (SWAP_DEBUG precedent). Flip false once verified live.

    The phone is a ROUTER, not content: a 3×4 grid of "app" icons, one per
    destination. v2 (live feedback): apps look like APPS — each is an 88px
    rounded square FILLED SOLID with its accent color (the color IS the
    icon; the launcher grid is the one sanctioned full-rainbow surface),
    glyph centered, label below. Tapping an app plays THE ACCENT SWIPE:
    a full-screen angled slab in the app's accent sweeps across the screen
    (the menu→game Persona-wipe vocabulary, single accent, phone-speed),
    NavManager routes at full cover, the slab sweeps off the far side.

    Juice-tier discipline: the swipe plays for DESTINATIONS (the 6 tabs +
    Quests + Bag — full-screen contexts). The four widget apps
    (Chat/Radio/Effects/Notifications) just close the phone and toggle
    their popup — a fullscreen accent sweep to open a chat widget would
    be Tier-4 juice on a Tier-1 action.

    Engine rules honored (css-quirks.md):
    - Root PARKS OFFSCREEN when closed (left -10000px, never display-flip).
    - Backdrop uses top/left + width/height 100% — all-edge absolute
      stretching resolves to ZERO SIZE on an empty element.
    - 3D lean holder (.pl-device) carries NO bg/border — the painted
      device lives on a direct child (.pl-shell, screen inside it).
    - Swipe slab = solid div; position/size/translate/skew are IMPERATIVE
      per-frame Style writes (class-toggle transforms snap; per-frame
      re-assert survives any mid-cover rebuild — the held-tween lesson).
    - Slab geometry converts Box.Rect screen px → style px via
      ScaleFromScreen (+30% oversize) so cover is guaranteed at any
      window scale (the liquid circle under-covered without this).
    - Icon children are pointer-events: none (hover-flicker rule).

    Keyboard (registered with UIModalState as "PhoneLauncher"):
    WASD walk the grid · Enter/Space launch · number keys + T/R/C/N route
    directly to their app · Q/Esc/Slot8 close. Hover == focus (one cursor).

    IN-PHONE APPS — keyboard + hover (2026-08-30, see the CURSOR block in
    code): one cursor per app view (`_appKb`, an action string) stamped as
    `.kb-focused`; mouse hover resolves through the click router on movement
    and stamps `.hovered` (and moves the cursor — last-input-wins).
    POLISH PASS 2026-08-30 (user playtest of e8733e0): the cursor is a ROW
    HIGHLIGHT (slab step + 4px violet left edge) on rows and a violet border
    value-swap on controls — the spread-shadow ring read as nothing.
      CHAT    opens ON the input (one press from typing) · W climbs into the
              log newest-first, S walks back down to the input · A/D channel
              (caps printed on the bar) · Space/E = the row's tap (embed /
              author card) · Enter ANYWHERE = focus the input · while typing
              the phone stands down; Esc blurs back to it, a second Esc backs
              out to the grid.
      RADIO   the cursor walks EVERY control on a 3-row grid — station chip /
              transport / volume: A/D within a row, W/S between rows (column-
              mapped: PLAY ↔ seg 3, station ↔ PLAY) · Space/Enter = tap the
              focused control (on a volume segment: commit that level) ·
              direct keys R tune · Z shuffle · X repeat (they do NOT move the
              cursor).
      EFFECTS W/S walk boost rows then skill rows (reading focus).
      ALERTS  W/S walk rows → CLEAR ALL · Space = tap · R jumps to CLEAR ALL.
    BACK = the accent circle + a Q cap, ONE always-mounted group in the status
    row that grows/shrinks with the app chrome (AppChrome) so the row never
    pops; the reverse bloom keeps the app view mounted until the collapse
    ends and the home grid FADES in (mount keyframe) instead of popping.
*@

<root class="phone-root @(Shown ? "shown" : "") @(IsVisible ? "open" : "") @(_fx != FxPhase.Idle ? "fx-live" : "")">
    <div class="pl-backdrop" @ref="_backdropRef" onclick=@OnBackdropClicked></div>

    <div class="pl-wrap" @ref="_wrapRef">
        <div class="pl-device" @ref="_deviceRef">

            <!-- THE SHELL — the physical device: near-black bezel frame,
                 r-38 outer. Speaker slit + camera lens live in the top
                 strip; the old surface becomes the SCREEN inside (r-30).
                 The shell is a CHILD of the transform holder, so its
                 bg/shadow project correctly with the 3D lean (only the
                 holder's OWN fills render flat — quirk). -->
            <div class="pl-shell">
                <div class="pl-bezel-top">
                    <div class="pl-speaker"></div>
                    <div class="pl-camera"><div class="pl-camera-lens"></div></div>
                </div>

                <div class="pl-surface" @ref="_surfaceRef">
                <!-- v7.2: the LOOPING wallpaper (spec animations, retimed to
                     a seamless 16s master loop, baked to animated WebP) —
                     an absolute img so the texture animates; the surface
                     paints no fill of its own. Geometry is FIXED (v7.3):
                     surface height is deterministic, the img is the bake
                     size 1:1 — runtime measuring stretched the texture and
                     squared off the corner curves (user report). -->
                <img class="pl-wall" src="ui/pawpad/wallpaper-538.webp" />
                <!-- ═══ THE APP SURFACE STACK (pawpad-apps brief rev 4/6, 2026-08-29) —
                     three STATIC in-flow ZERO-FOOTPRINT layers under the OS chrome
                     (the .pl-wall trick: explicit box pulled to the padding-box
                     origin by negative margins, bottom margin cancels the height so
                     later siblings reflow on top; DOM order = paint order — never
                     absolute overlays, which paint BEHIND a filled parent). All
                     PRE-MOUNTED and opacity 0 on the home grid; they rise on the
                     .on class-toggle UNDER the bloom disc (next block). Effects wears
                     the "hot" opacities (yellow runs hot). -->
                <div class="pl-app-tint @(_bloomLive ? "on" : "")" style="background-color: @BloomTint();"></div>
                <div class="pl-app-wash @(_bloomLive ? "on" : "")" style="background-image: @WashGradient();"></div>
                <div class="pl-app-ghost @(_bloomLive ? "on" : "") @(BloomApp() == "effects" ? "hot" : "")">
                    <iconify class="pl-app-ghost-icon" icon="@GhostIconOf( BloomApp() )" Size=@(260) Color="@BloomAccent()" />
                </div>
                <!-- THE BLOOM DISC (live 2026-08-30) — an accent disc that grows out of
                     the tapped tile's centre until it covers the screen, then fades
                     onto the landed tint; the reverse bloom collapses it back into the
                     tile. Growth = class-toggle TRANSITION on width/height + left/top
                     (explicit px, no transform — device law). It lives in its OWN clip
                     host: a zero-footprint explicit-px 538x692 box at the padding-box
                     origin (the .pl-wall placement trick) with overflow hidden, so the
                     disc never overhangs the bezel and the SCREEN never gains overflow
                     hidden (flex-child collapse law). DOM order = paint order: above
                     the tint/wash/ghost, under the status row + the app view. left/top
                     ALWAYS emitted + value-swapped (never-cleared inline-style law). -->
                <div class="pl-bloom-clip">
                    <div class="pl-bloom-circle @(_bloomCircleGrow ? "grow" : "") @(_bloomCircleFade ? "fade" : "")" style="left: @(DiscLeft())px; top: @(DiscTop())px; background-color: @BloomAccent();"></div>
                </div>
                <!-- v7 "3a Graphite" status row (design handoff spec): clock
                     left; right group = GOLD signal bars · battery · divider
                     · name · gold-ringed avatar. NO title header anymore —
                     the spec's screen is status → grid → dock; the paw brand
                     lives on the chin deboss. Right group is right-anchored
                     BY CONSTRUCTION (computed margin — the only alignment
                     primitive under the lean); every box explicit px.
                     rev 6 (2026-08-29): in app views the BACK affordance is OS
                     chrome — a 28px app-accent circle with a cream ‹ FIRST in
                     the row (hit-back rides with it; Q stays); the right group
                     shrinks 438 → 406 and the row's mb 20 → 12. -->
                <div class="pl-top @(AppChrome ? "app" : "")">
                    <span class="pl-clock">@ClockText</span>
                    <div class="pl-right @(AppChrome ? "app" : "")">
                        <!-- 2026-08-30 (user): the fake signal bars + battery are gone - the
                             row is clock · name · avatar. The name carries the computed
                             right-anchor margin now. -->
                        <span class="pl-lv" style="margin-left: @(RightPadPx())px;">@TamerLine</span>
                        <!-- Avatar: ROUNDED SQUARE (r8) like the hub's people heads, 2px gold
                             OS rim; plain in-flow img, explicit px. -->
                        @if ( GetSteamId() > 0 )
                        {
                            <img class="pl-ava-steam" src="avatar:@GetSteamId()" />
                        }
                        else
                        {
                            <img class="pl-ava-steam" src="@GetAvatarImagePath()" />
                        }
                    </div>
                </div>

                @if ( _appView != null )
                {
                    <!-- ═══ IN-PHONE APPS (TamerLink OS v9 → the rev-7 apps build,
                         2026-08-29: brief .claude/design-system/components/
                         pawpad-apps-brief.html). Mouse goes through the backdrop
                         router: every clickable carries `pl-hit hit-<action>`
                         (indexed families hit-alert-N / hit-chat-author-N /
                         hit-embed-N / hit-vol-N resolve by prefix) and
                         ActionAtScreen inverse-projects the cursor onto it, walking
                         POST-ORDER from the surface (innermost wins; a scroller
                         only admits points inside its own rect). Q backs out to
                         the home grid through the reverse bloom. Every box is
                         explicit px (lean law); rows in scroll lists never carry
                         overflow:hidden; meta boxes are placed by computed
                         margins, never margin-left:auto. -->
                    <div class="pl-appview @(_appUiOn ? "on" : "") app-@(_appView)" @ref="_appviewRef">
                        <!-- THE HEADER (rev 6, NO BOX) — title row · wave band, straight
                             on the derived bg (the one-word kicker was cut 2026-08-30:
                             the title already says it). Title box measured at
                             34px per app; util slot right-aligned to x496 by
                             computed margin, only where it means something. The
                             seam bars are the ONE angled element on the device. -->
                        <div class="pl-av-head">
                            <div class="pl-av-titlerow">
                                <span class="pl-av-title" style="width: @(TitleBoxPx())px;">@AppViewTitle()</span>
                                <div class="pl-av-seam" style="background-color: @AppViewAccent();"></div>
                                <div class="pl-av-seam tail" style="background-color: @AccentRgba( AppViewAccent(), 0.45f );"></div>
                                @if ( _appView == "radio" )
                                {
                                    <div class="pl-av-util chip pl-hit hit-radio-station @HitState( "hit-radio-station" )" style="margin-left: 218px; background-color: @AppViewAccent();"><span>@StationChipLabel()</span></div>
                                }
                                else if ( _appView == "effects" )
                                {
                                    <div class="pl-av-util stamp @("pl-stamp-" + ( EffectsCount() % 2 ))" style="margin-left: 204px; background-color: @AppViewAccent();"><span>@EffectsCount() ACTIVE</span></div>
                                }
                            </div>
                            <!-- WAVE BAND — the strips are <img> elements, TWO per layer, drifting
                                 by imperative `left` writes (DriftWaves) inside the clipped band.
                                 NOT background-image: an alpha PNG as a div background paints its
                                 transparent pixels BLACK in-engine (probe-proven 2026-08-30 — the
                                 band read as a dark box on every app); <img> keeps the alpha. The
                                 two END FADES are absolute siblings AFTER the strips under this
                                 band. NO END FADES (user 2026-08-30): the band runs EDGE TO EDGE
                                 of the screen like the page headers (538 wide, -13 margins);
                                 every fade overlay tried (gradient div, baked img, absolute,
                                 in-flow, sibling row) made the engine paint the band as a dark
                                 box; three chasing copies per layer keep 538 covered. -->
                            <div class="pl-av-waves @(_appView == "effects" ? "hot" : "")">
                                <img class="pl-av-wave a" @ref="_waveA1" src="@WaveUrlA()" />
                                <img class="pl-av-wave a" @ref="_waveA2" src="@WaveUrlA()" />
                                <img class="pl-av-wave a" @ref="_waveA3" src="@WaveUrlA()" />
                                <img class="pl-av-wave b" @ref="_waveB1" src="@WaveUrlB()" />
                                <img class="pl-av-wave b" @ref="_waveB2" src="@WaveUrlB()" />
                                <img class="pl-av-wave b" @ref="_waveB3" src="@WaveUrlB()" />
                            </div>
                        </div>

                        @if ( _appView == "chat" )
                        {
                            @{
                                var chanCounts = ChanCounts();
                                var unreadGlobal = ChanUnread( "global", chanCounts );
                                var unreadGuild = ChanUnread( "guild", chanCounts );
                                var unreadTrade = ChanUnread( "trade", chanCounts );
                                var msgs = PhoneMessages();
                                RebuildStops( "chat", msgs.Count );
                            }
                            <!-- channel bar (polish pass 2026-08-30): A cap 22 + 8 + 3 × 144
                                 (140 declared + 2px cursor border) + 2 × 10 + 8 + D cap 22 = 512
                                 — the A/D keys are printed ON the bar. Lit = .pl-chan.on
                                 (accent fill + dark ink); unread dot = a fresh element per
                                 count (render-key parity → plDotPop). -->
                            <div class="pl-chan-row">
                                <div class="pl-akey chan-cap a"><span>A</span></div>
                                <div class="pl-chan c1 pl-hit hit-chan-global @(_phoneChan == "global" ? "on" : "") @HitState( "hit-chan-global" )">
                                    <span>GLOBAL</span>
                                    @if ( unreadGlobal > 0 )
                                    {
                                        <div class="pl-chan-dot @("pl-dot-" + ( unreadGlobal % 2 ))"><span>@FormatBadge( unreadGlobal )</span></div>
                                    }
                                </div>
                                <div class="pl-chan c2 pl-hit hit-chan-guild @(_phoneChan == "guild" ? "on" : "") @HitState( "hit-chan-guild" )">
                                    <span>GUILD</span>
                                    @if ( unreadGuild > 0 )
                                    {
                                        <div class="pl-chan-dot @("pl-dot-" + ( unreadGuild % 2 ))"><span>@FormatBadge( unreadGuild )</span></div>
                                    }
                                </div>
                                <div class="pl-chan c3 pl-hit hit-chan-trade @(_phoneChan == "trade" ? "on" : "") @HitState( "hit-chan-trade" )">
                                    <span>TRADE</span>
                                    @if ( unreadTrade > 0 )
                                    {
                                        <div class="pl-chan-dot @("pl-dot-" + ( unreadTrade % 2 ))"><span>@FormatBadge( unreadTrade )</span></div>
                                    }
                                </div>
                                <div class="pl-akey chan-cap d"><span>D</span></div>
                            </div>
                            <div class="pl-chat-scroll pl-scroll-clip" @ref="_chatScrollRef">
                                @if ( msgs.Count == 0 )
                                {
                                    <div class="pl-empty-state chat">
                                        <img class="pl-empty-paw" src="ui/pawpad/paw-deboss-hi.png" />
                                        <span class="pl-empty-title">@ChatEmptyTitle()</span>
                                        <span class="pl-empty-hint">@ChatEmptyHint()</span>
                                    </div>
                                }
                                @for ( int mi = 0; mi < msgs.Count; mi++ )
                                {
                                    var m = msgs[mi];
                                    var own = IsOwnPhoneMsg( m );
                                    var motion = RowMotion( m.Id, mi, own );
                                    var authorHit = ( !own && HasCardFor( m.SteamId ) ) ? "pl-hit hit-chat-author-" + mi : "";
                                    var authorPressed = HitState( "hit-chat-author-" + mi );
                                    <div class="pl-msg pl-hit @("hit-msg-" + mi) @(own ? "own" : "") @motion @HitState( "hit-msg-" + mi )">
                                        <div class="pl-msg-top">
                                            <span class="pl-msg-author @authorHit @authorPressed">@m.PlayerName</span>
                                            <span class="pl-msg-time">@m.FormattedTime</span>
                                        </div>
                                        @if ( m.Type == Beastborne.Data.ChatMessageType.BeastShowcase )
                                        {
                                            <!-- beast showcase embed — row-flex 56: element edge 4 (in-flow
                                                 first child) · neutral 34 tile with the pixelated sprite ·
                                                 text 300 · TAP TO VIEW 100. Tap (hit-embed-N) opens the
                                                 full-screen showcase popup OVER the phone. -->
                                            <div class="pl-embed pl-hit @("hit-embed-" + mi) @HitState( "hit-embed-" + mi )">
                                                <div class="pl-embed-edge" style="background-color: @ElementRim( m.ShowcaseElement );"></div>
                                                <div class="pl-tile">
                                                    @if ( !string.IsNullOrEmpty( ShowcaseSprite( m ) ) )
                                                    {
                                                        <img class="pl-tile-sprite" src="@ShowcaseSprite( m )" />
                                                    }
                                                </div>
                                                <div class="pl-embed-text">
                                                    <span class="pl-embed-name">@(string.IsNullOrEmpty( m.ShowcaseNickname ) ? m.ShowcaseSpeciesName : m.ShowcaseNickname)</span>
                                                    <div class="pl-embed-statrow">
                                                        <span class="pl-embed-stat">LV @m.ShowcaseLevel · PWR @m.ShowcasePower · </span>
                                                        <span class="pl-embed-rarity" style="color: @RarityColor( m.ShowcaseRarity );">@(( m.ShowcaseRarity ?? "" ).ToUpperInvariant())</span>
                                                    </div>
                                                </div>
                                                <span class="pl-embed-tap">TAP TO VIEW ›</span>
                                            </div>
                                        }
                                        else if ( m.Type == Beastborne.Data.ChatMessageType.TamerCardShowcase )
                                        {
                                            <div class="pl-embed pl-hit @("hit-embed-" + mi) @HitState( "hit-embed-" + mi )">
                                                <div class="pl-embed-edge" style="background-color: #4aa8ff;"></div>
                                                <div class="pl-tile">
                                                    <img class="pl-tile-avatar" src="avatar:@m.SteamId" />
                                                </div>
                                                <div class="pl-embed-text">
                                                    <span class="pl-embed-name">@m.CardName</span>
                                                    <div class="pl-embed-statrow">
                                                        <span class="pl-embed-stat">TAMER CARD · LV @m.CardLevel · @(( m.CardArenaRank ?? "UNRANKED" ).ToUpperInvariant())</span>
                                                    </div>
                                                </div>
                                                <span class="pl-embed-tap">TAP TO VIEW ›</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="pl-msg-text">@m.Content</span>
                                        }
                                    </div>
                                }
                            </div>
                            <!-- input row: 426 + 8 + 78 = 512. The INPUT BOX is the hit
                                 (focus); SEND is its sibling — a row that contains a hit
                                 is never one itself (post-order law). -->
                            <div class="pl-chat-inputrow">
                                <div class="pl-chat-inputbox pl-hit hit-input @HitState( "hit-input" )">
                                    <ChatInputBox @ref="_phoneChatBox" OnSubmit=@OnPhoneChatSend Placeholder="@InputPlaceholder()" />
                                </div>
                                <div class="pl-send pl-hit hit-send @HitState( "hit-send" )"><span>SEND</span></div>
                            </div>
                        }
                        else if ( _appView == "radio" )
                        {
                            @{ RebuildStops( "radio", 0 ); }
                            <!-- now-playing hero — visualizer (baked animated WebP <img>,
                                 src value-swapped on IsPlaying; until the asset lands, nine
                                 STATIC bars) · station kicker · track title (re-keyed on
                                 track change → plFadeIn) · honest caption. -->
                            <div class="pl-radio-hero">
                                <div class="pl-viz">
                                    @if ( VizSrc() != null )
                                    {
                                        <img class="pl-viz-img" src="@VizSrc()" />
                                    }
                                    else
                                    {
                                        <div class="pl-viz-bars">
                                            <div class="pl-viz-bar" style="height: 12px;"></div>
                                            <div class="pl-viz-bar" style="height: 30px;"></div>
                                            <div class="pl-viz-bar" style="height: 20px;"></div>
                                            <div class="pl-viz-bar" style="height: 42px;"></div>
                                            <div class="pl-viz-bar" style="height: 26px;"></div>
                                            <div class="pl-viz-bar" style="height: 38px;"></div>
                                            <div class="pl-viz-bar" style="height: 16px;"></div>
                                            <div class="pl-viz-bar" style="height: 34px;"></div>
                                            <div class="pl-viz-bar" style="height: 10px;"></div>
                                        </div>
                                    }
                                </div>
                                <span class="pl-radio-station">@StationName()</span>
                                <span class="pl-radio-track @("pl-title-" + ( _trackKey % 2 ))">@TrackName()</span>
                                <span class="pl-radio-caption @("pl-title-" + ( _trackKey % 2 ))">@RadioCaption()</span>
                            </div>
                            <!-- progress: track 476 (ml 18) · fill in PX from the 1 Hz cache ·
                                 time boxes 48 + 380 computed + 48. Not seekable. -->
                            <div class="pl-prog">
                                <div class="pl-prog-track"><div class="pl-prog-fill" style="width: @(_progFillPx)px;"></div></div>
                                <div class="pl-prog-times">
                                    <span class="pl-prog-t">@_progPos</span>
                                    <span class="pl-prog-t end">@_progDur</span>
                                </div>
                            </div>
                            <!-- transport: 64 + 54 + 72 + 54 + 64 + 4×22 = 396, centered
                                 (every child explicit → justify-content is legal). Play is
                                 ONE iconify whose name value-swaps (never an if-swap). -->
                            <div class="pl-radio-ctls">
                                <div class="pl-rtog pl-hit hit-radio-shuffle @(Beastborne.Systems.RadioManager.IsShuffle ? "on" : "") @HitState( "hit-radio-shuffle" )"><span>SHUFFLE</span></div>
                                <div class="pl-rctl pl-hit hit-radio-prev @HitState( "hit-radio-prev" )"><iconify class="pl-rctl-icon" icon="lucide:skip-back" Size=@(20) Color="#f4f1ea" /></div>
                                <div class="pl-rctl big pl-hit hit-radio-play @HitState( "hit-radio-play" )"><iconify class="pl-rctl-icon" icon="@(Beastborne.Systems.RadioManager.IsPlaying ? "lucide:pause" : "lucide:play")" Size=@(26) Color="#1d0433" /></div>
                                <div class="pl-rctl pl-hit hit-radio-next @HitState( "hit-radio-next" )"><iconify class="pl-rctl-icon" icon="lucide:skip-forward" Size=@(20) Color="#f4f1ea" /></div>
                                <div class="pl-rtog pl-hit hit-radio-repeat @(Beastborne.Systems.RadioManager.IsRepeat ? "on" : "") @HitState( "hit-radio-repeat" )"><span>REPEAT</span></div>
                            </div>
                            <!-- stepped volume: VOLUME chip 96 + 28 computed + 5 × 64 + 4 × 8 =
                                 476 (ml 18). hit-vol-1..5 → SetVolume .2–1.0; raising lights the
                                 segments in sequence (per-segment ladder classes, parity-keyed
                                 so a re-tap replays); lowering goes dark at once. -->
                            <div class="pl-vol-row">
                                <div class="pl-sect radio vol"><span>VOLUME</span></div>
                                <div class="pl-vol-segs">
                                    @for ( int k = 1; k <= 5; k++ )
                                    {
                                        var lit = k <= VolStep();
                                        var ladder = ( lit && VolLadderActive() ) ? "pl-voln-" + k + "-" + ( _volKey % 2 ) : "";
                                        <div class="pl-vol-seg pl-hit @("hit-vol-" + k) @(lit ? "lit" : "") @ladder @HitState( "hit-vol-" + k )"></div>
                                    }
                                </div>
                            </div>
                        }
                        else if ( _appView == "effects" )
                        {
                            @{
                                var boosts = PhoneBoosts();
                                var skills = PhoneSkills();
                                var ghosts = FxGhosts();
                                int fxRow = 0;
                                int fxHit = 0;
                                int skHit = 0;
                                RebuildEffectsStops( boosts.Count, skills.Count );
                            }
                            <div class="pl-list-scroll pl-scroll-clip" @ref="_listScrollRef">
                                @if ( boosts.Count == 0 && skills.Count == 0 && ghosts.Count == 0 )
                                {
                                    <div class="pl-empty-state fx">
                                        <img class="pl-empty-paw" src="ui/pawpad/paw-deboss-hi.png" />
                                        <span class="pl-empty-title">NO ACTIVE EFFECTS</span>
                                        <span class="pl-empty-hint">Boosts from the shop and your skill bonuses show up here.</span>
                                    </div>
                                }
                                @if ( boosts.Count > 0 || ghosts.Count > 0 )
                                {
                                    <div class="pl-sect fx w-timed"><span>TIMED BOOSTS</span></div>
                                }
                                @foreach ( var b in boosts )
                                {
                                    var motion = RowMotion( b.Key, fxRow++ );
                                    var fxAct = "hit-fx-" + ( fxHit++ );
                                    var secs = (int)b.Remaining.TotalSeconds;
                                    var lastMin = secs < 60;
                                    var fillPx = FillPx( b.Remaining, b.TotalSeconds );
                                    <!-- column-flex fixed 56 = 53 content + 3px strip HOLDER
                                         (explicit-px fill child). Never overflow:hidden. -->
                                    <div class="pl-fx-row pl-hit @fxAct @motion @HitState( fxAct )">
                                        <div class="pl-fx-content">
                                            <div class="pl-tile">
                                                @if ( !string.IsNullOrEmpty( b.IconPath ) )
                                                {
                                                    <img class="pl-tile-img" src="@b.IconPath" />
                                                }
                                                else
                                                {
                                                    <span class="pl-tile-glyph fx">@b.Glyph</span>
                                                }
                                            </div>
                                            <div class="pl-fx-text">
                                                <span class="pl-fx-name">@b.Label</span>
                                                <span class="pl-fx-src">@b.Source</span>
                                            </div>
                                            <span class="pl-fx-val @(lastMin ? "last-min pl-pulse-" + ( _tick % 2 ) : "")">@FormatRemaining( b.Remaining )</span>
                                        </div>
                                        <div class="pl-fx-strip"><div class="pl-fx-fill @(lastMin ? "amber" : "") @(fillPx >= 508 ? "full" : "")" style="width: @(fillPx)px;"></div></div>
                                    </div>
                                }
                                @foreach ( var g in ghosts )
                                {
                                    <div class="pl-fx-row expired">
                                        <div class="pl-fx-content">
                                            <div class="pl-tile">
                                                @if ( !string.IsNullOrEmpty( g.IconPath ) )
                                                {
                                                    <img class="pl-tile-img" src="@g.IconPath" />
                                                }
                                                else
                                                {
                                                    <span class="pl-tile-glyph fx">@g.Glyph</span>
                                                }
                                            </div>
                                            <div class="pl-fx-text">
                                                <span class="pl-fx-name">@g.Label</span>
                                                <span class="pl-fx-src">@g.Source</span>
                                            </div>
                                            <span class="pl-fx-val last-min">0s</span>
                                        </div>
                                        <div class="pl-fx-strip"><div class="pl-fx-fill amber" style="width: 0px;"></div></div>
                                    </div>
                                }
                                @if ( skills.Count > 0 )
                                {
                                    <div class="pl-sect fx w-skills @(( boosts.Count > 0 || ghosts.Count > 0 ) ? "mt" : "")"><span>SKILL BONUSES · ALWAYS ON</span></div>
                                }
                                @foreach ( var sk in skills )
                                {
                                    var motion = RowMotion( "sk:" + sk.Name, fxRow++ );
                                    var skAct = "hit-sk-" + ( skHit++ );
                                    <div class="pl-sk-row pl-hit @skAct @motion @HitState( skAct )">
                                        <div class="pl-tile">
                                            @if ( !string.IsNullOrEmpty( sk.IconPath ) )
                                            {
                                                <img class="pl-tile-img" src="@sk.IconPath" />
                                            }
                                            else
                                            {
                                                <span class="pl-tile-glyph cream">@sk.Glyph</span>
                                            }
                                        </div>
                                        <span class="pl-sk-name">@sk.Name</span>
                                        <span class="pl-sk-rank">@(sk.Rank > 0 ? "RANK " + sk.Rank : "EVENT")</span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            @{
                                var alerts = PhoneNotifications();
                                bool todayShown = false;
                                bool earlierShown = false;
                                RebuildAlertStops( alerts.Count, alerts.Count > 0 && _clearingAt <= 0f );
                            }
                            <div class="pl-list-scroll pl-scroll-clip" @ref="_listScrollRef">
                                @if ( alerts.Count == 0 )
                                {
                                    <div class="pl-empty-state al pl-fade-in">
                                        <img class="pl-empty-paw" src="ui/pawpad/paw-deboss-hi.png" />
                                        <span class="pl-empty-title">ALL CAUGHT UP</span>
                                        <span class="pl-empty-hint">Contracts, level-ups and unlocks land here.</span>
                                    </div>
                                }
                                @for ( int ai = 0; ai < alerts.Count; ai++ )
                                {
                                    var n = alerts[ai];
                                    var isToday = n.CreatedAt.ToLocalTime().Date == DateTime.Now.Date;
                                    if ( isToday && !todayShown )
                                    {
                                        todayShown = true;
                                        <div class="pl-sect al w-today"><span>TODAY</span></div>
                                    }
                                    if ( !isToday && !earlierShown )
                                    {
                                        earlierShown = true;
                                        <div class="pl-sect al w-earlier @(todayShown ? "mt" : "")"><span>EARLIER</span></div>
                                    }
                                    var unread = IsAlertUnread( n );
                                    var hasRoute = !string.IsNullOrEmpty( n.Route );
                                    var motion = RowMotion( n.Id, ai, false );
                                    var clr = _clearingAt > 0f ? "pl-clr-" + Math.Min( 5, alerts.Count - 1 - ai ) : "";
                                    <!-- row-flex 512×56, padding 0: tick 4 (ALWAYS emitted, colour
                                         value-swapped) · +10 tile 34 · +12 text 330 · +42 time 48 ·
                                         +4 chevron 14 · 14 edge. The ROW is the hit (hit-alert-N);
                                         nothing inside it is. -->
                                    <div class="pl-alert-row pl-hit @("hit-alert-" + ai) @motion @clr @HitState( "hit-alert-" + ai ) @(isToday ? "" : "earlier")">
                                        <div class="pl-alert-tick @(unread ? "unread" : "") @(( unread && motion == "pl-arrive" ) ? "tick-in" : "")"></div>
                                        <div class="pl-tile">
                                            @if ( n.HasImageIcon )
                                            {
                                                <img class="pl-tile-img" src="@n.IconPath" />
                                            }
                                            else
                                            {
                                                <iconify class="pl-tile-icon" icon="@NotificationPanel.GetNotificationIconName( n.Type )" Size=@(18) Color="@AlertGlyphColor( n.Type )" />
                                            }
                                        </div>
                                        <div class="pl-alert-text">
                                            <span class="pl-alert-title">@n.Title</span>
                                            <span class="pl-alert-msg">@Truncate( n.Message, 96 )</span>
                                        </div>
                                        <span class="pl-alert-time">@RelativeTime( n.CreatedAt )</span>
                                        <span class="pl-alert-chev @(hasRoute ? "" : "none")">›</span>
                                    </div>
                                }
                            </div>
                            @* CLEAR ALL — the danger-tier slab with TWO-TAP confirm (first tap
                               arms → "SURE?" for 2s; second commits: rows fade bottom-up on the
                               pl-clr-N ladder, the +500ms one-shot empties the record). *@
                            @if ( alerts.Count > 0 && _clearingAt <= 0f )
                            {
                                <div class="pl-alert-clear pl-hit hit-clear @HitState( "hit-clear" ) @(ClearArmed ? "armed" : "")"><span>@(ClearArmed ? "SURE?" : "CLEAR ALL")</span></div>
                            }
                        }

                        @* OVERLAY SCROLLBAR (rev 7.1, 2026-08-29 — user: "shouldn't we have a
                           side scrollbar?") — the Beastbook dossier recipe ported: a 4px track
                           at the app view's right edge (x 508) + a 4px thumb, geometry written
                           in px ONLY when it changes (UpdateAppScrollbar) on wheel / the 1 Hz
                           tick / once after the cascade. Lives in the APP VIEW, never inside
                           the scroller (flat-children law); the view paints no fill, so the
                           absolute child stacks ABOVE the list by DOM order. .on is markup-
                           driven (hashed) — hidden entirely when the content fits. No pl-hit:
                           the backdrop router never sees it; wheel is the input. *@
                        @if ( _appView != "radio" )
                        {
                            <div class="pl-sb-track @(_sbOn ? "on" : "")" @ref="_sbTrackRef">
                                <div class="pl-sb-thumb" @ref="_sbThumbRef"></div>
                            </div>
                        }
                    </div>
                }
                else
                {
                <div class="pl-grid" @ref="_gridRef">
                    @for ( int r = 0; r < 4; r++ )
                    {
                        <div class="pl-row">
                            @for ( int c = 0; c < 3; c++ )
                            {
                                var i = r * 3 + c;
                                var app = Apps[i];
                                var badge = GetBadgeCount( app.Id );
                                <div class="pl-app @(i == _kb ? "focused" : "")"
                                     onclick=@(() => LaunchIndex( i ))
                                     onmouseover=@(() => HoverTile( i ))>
                                    <div class="pl-app-iconwrap">
                                        <!-- v5.3 (user call): apps are FLAT on the glass at rest —
                                             a phone reads 2D until you pick one up. On focus the
                                             tile lifts 6px and a planted shadow appears beneath it
                                             (y: 5 + FocusPopLift 6 = 11 counters the lift so the
                                             shading sits ON the glass, not on the tile). The rest
                                             value is a ZERO-SIZE shadow, not a removed property —
                                             s&box never clears a removed inline style prop. -->
                                        <!-- v7: NO hover-brighten (user: it messes with the
                                             colors) — the accent stays true; lift + planted
                                             shadow + ring + animated glyph carry the focus. -->
                                        <div class="pl-app-icon" style="background-color: @app.Accent; box-shadow: @(i == _kb ? "5px 9px" : "0px 0px") 0px @(Darken( app.Accent ));">
                                            <!-- v5: the commissioned icon set (Claude Design,
                                                 icons/v2) — filled-silhouette SVGs that carry
                                                 their own fill color (white; dark ink baked in
                                                 for shop/effects), so DarkGlyph stays data-only.
                                                 The PhoneApp.Icon lucide id is retired but the
                                                 FIELD stays: hotload migrates static records BY
                                                 NAME and shape changes force restarts.
                                                 v6: focus swaps the SRC to the looping animated
                                                 WebP (attribute VALUE swap — the diff-safe path;
                                                 an if-branch icon swap leaves ghost children.
                                                 NOTE: razor parses at-directives INSIDE html
                                                 comments — never write at-if in a comment). -->
                                            <img class="pl-app-glyph" src="@GlyphSrc( i, app.Id )" />
                                        </div>
                                        <!-- v5.1: corner keycaps REMOVED (user: "just in the
                                             way"). The hotkeys still WORK — they're just not
                                             printed on every tile anymore. -->
                                        @if ( app.Id == "bag" && HasNewItems() )
                                        {
                                            <BbStamp Text="NEW" Tone="gold" Tilt=@(3) Class="pl-new-stamp" />
                                        }
                                        else if ( badge > 0 )
                                        {
                                            <!-- § 6 LIFE: the badge POPS on every count change — parity
                                                 render-key (pl-badge-0/1 → plDotPop A/B twins). -->
                                            <span class="pl-badge @(app.DarkGlyph ? "dark-ink" : "") @("pl-badge-" + ( badge % 2 ))" style="background-color: @app.Accent;">@FormatBadge( badge )</span>
                                        }
                                    </div>
                                    <!-- v4.1: centering BY CONSTRUCTION. Live capture proved
                                         text-align is a no-op anywhere under the lean: the
                                         transformed ancestor poisons derived width resolution
                                         (the documented translate(-50%) flex-poison law), so
                                         the Label's inner text box collapses to content width
                                         and there is nothing to center within — even when the
                                         span's own 160px main-axis box HOLDS (proven by the
                                         avatar landing flush right of .pl-lv's held 392px).
                                         Only explicit px survive in here: auto-width span
                                         (content-collapse now works FOR us) + computed
                                         margin-left. -->
                                    <div class="pl-app-labelrow">
                                        <span class="pl-app-label" style="margin-left: @(LabelPadPx( app.Label ))px;">@app.Label</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                </div>

                <!-- THE SYSTEM DOCK (v5) — meta destinations (Profile /
                     Settings / Guide / Feedback) as a quieter tier below
                     the grid: smaller dark-violet tiles, violet glyphs
                     (system chrome, not apps). No labels — dock convention;
                     the ring + glyphs carry it. Indices 12-15 in the one
                     cursor space. justify-content: center is LEGAL here:
                     every child is an explicit 56px box (doctrine rule 2). -->
                <div class="pl-dock" @ref="_dockRef">
                    @for ( int d = 0; d < Dock.Length; d++ )
                    {
                        var di = GridCount + d;
                        var dockId = Dock[d];
                        <div class="pl-dock-app @(di == _kb ? "focused" : "")"
                             onclick=@(() => LaunchIndex( di ))
                             onmouseover=@(() => HoverTile( di ))>
                            <img class="pl-dock-glyph" src="@GlyphSrc( di, dockId )" />
                        </div>
                    }
                </div>
                }
                @* (Corner masks RETIRED 2026-07-10 — root cause fixed
                   instead: wallpaper-538.webp is rebaked frame-by-frame at
                   the TRUE 538×692 with r30 corners composited against the
                   CURRENT shell tones. No stretch, no masks.) *@
                </div>

                <!-- v7 chin — the spec's DEBOSSED paw: highlight copy offset
                     1px down under a recess copy (stacked absolute imgs with
                     explicit px inside an unpainted holder — lawful). -->
                <!-- 2026-08-30: the chin paw is the phone's HOME button - in an app view a
                     tap collapses back to the grid (hit-home; Q is the key twin). The back
                     pill in the status row was cut ("do we even need a back button?"). -->
                <div class="pl-chin pl-hit hit-home @HitState( "hit-home" )" @ref="_chinRef">
                    <div class="pl-deboss">
                        <img class="pl-deboss-hi" src="ui/pawpad/paw-deboss-hi.png" />
                        <img class="pl-deboss-lo" src="ui/pawpad/paw-deboss-lo.png" />
                    </div>
                </div>
            </div>

            <!-- Side-button nubs — RIGHT edge, DOM-AFTER the shell (v7.2:
                 painted OVER the trim; DOM-before let the opaque shell
                 cover their overlap and only a detached sliver showed,
                 user-reported twice). Explicit boxes throughout. -->
            <div class="pl-nub nub-a"></div>
            <div class="pl-nub nub-b"></div>

            <!-- Receding-side shade — a SIBLING of the shell (absolute
                 children paint BEHIND a panel's own background fill —
                 engine quirk — so it must sit beside the painted shell,
                 not inside it). DOM order paints it above; pointer-events
                 none. The v3.1 energy hairline is DELETED (v4 user call). -->
            <div class="pl-shade"></div>
        </div>
    </div>

    <!-- THE LIVING RING — one violet cursor for the whole grid (menu
         signature). v4.2: RELOCATED to ROOT level, OUTSIDE the leaned
         subtree — the menu's own placement, and the fix for BOTH v4
         regressions at once: (1) per-frame wave writes are cheap again
         (they no longer dirty the 3D device — the 7fps law), so the
         liquid ink-lean is BACK; (2) position comes straight from the
         icons' PROJECTED screen rects, so the ring centers exactly on
         every column (the old in-lean delta math assumed uniform scale,
         but perspective compresses the far/left side more — the ring
         drifted sideways on left/middle columns, user-reported).
         left/top/w/h via markup style (CSS transitions glide), wave via
         imperative Style.Transform per frame (never re-renders). -->
    <div @ref="_ringRef" class="pl-cursor @(_ringWarmup >= 2 ? "" : "snap") @(_appView != null ? "hidden" : "")"
         style="left: @(_ringL)px; top: @(_ringT)px; width: @(_ringW)px; height: @(_ringH)px;"></div>

    <!-- THE ACCENT SWIPE slab — solid accent fill, driven entirely
         imperatively from StepFx(). Sits AFTER .pl-wrap so it paints over
         the phone. pointer-events: none — input outruns animation. -->
    <div class="pl-swipe" @ref="_swipe" style="background-color: @_fxAccent;"></div>
</root>

@code {
    // ── Static show/hide API (the house pattern: static IsVisible + BuildHash) ──

    public static PhoneLauncher Instance { get; private set; }

    /// <summary>True while the phone UI is open (UIModalState reads this).</summary>
    public static bool IsVisible { get; private set; }

    // Close animation window — the root stays on-screen (parked-open) until
    // this expires so the reverse transition is visible before parking.
    private static float _closingUntil;

    public static void Show()
    {
        if ( IsVisible ) return;
        IsVisible = true;
        _closingUntil = 0f;
        SoundManager.PlayPopup();
        Instance?.ResetForOpen();
    }

    public static void Close()
    {
        if ( !IsVisible ) return;
        IsVisible = false;
        _closingUntil = Time.Now + 0.18f;
        Instance?.BlurPhoneInput(); // 2026-08-30: a parked phone must never keep keyboard focus (dead game keys)
        SoundManager.PlayPopdown();
    }

    public static void Toggle()
    {
        if ( IsVisible ) Close();
        else Show();
    }

    /// <summary>Open the phone directly onto a TamerLink app ("chat",
    /// "radio", "effects", "alerts"). v9.2: the chat POPUP is retired —
    /// T and every chat entry point land here instead.</summary>
    // TEMP dev instrument (2026-08-29): `dev_pawpad chat|radio|effects|alerts` opens the
    // phone straight into an app for MCP screenshot verification. Remove after review.
    // TEMP diagnostic (2026-08-29, "can't scroll the phone / input goes to the
    // page behind"): `dev_phonefocus` arms 60s of state logging — modal top,
    // which panel actually holds the hover, and every wheel event this panel
    // receives (with the scroller it routed to). Logs on CHANGE only, so the
    // console stays readable while the user hovers/scrolls the device.
    private static float _diagUntil = -1f;
    private static string _diagLast = "";
    private static int _diagWheel = 0;
    private Panel _backdropRef;
    private Panel _wrapRef;

    [ConCmd( "dev_phonefocus" )]
    public static void DevPhoneFocus( string arg = "on" )
    {
        _diagUntil = arg == "off" ? -1f : Time.Now + 600f;
        _diagLast = "";
        _diagWheel = 0;
        Log.Info( $"[phonefocus] {( _diagUntil > 0 ? "armed 10 min" : "off" )}" );
    }

    private static float _diagNextAt = 0f;
    private static int _diagScrollerId = 0;
    private static int _diagScrollerSwaps = 0;

    private static string HoveredLeafPath( Panel root )
    {
        if ( root == null ) return "-";
        var sb = new System.Text.StringBuilder();
        var p = root;
        int guard = 0;
        while ( p != null && guard++ < 40 )
        {
            Panel next = null;
            foreach ( var c in p.Children ) { if ( c.HasHovered ) { next = c; break; } }
            if ( next == null ) break;
            sb.Append( '>' ).Append( next.ElementName ).Append( '.' ).Append( string.Join( '.', next.Class ) );
            p = next;
        }
        return sb.Length == 0 ? "(none)" : sb.ToString();
    }

    private static string ChainInfo( Panel p )
    {
        if ( p == null ) return "-";
        var parts = new List<string>();
        int guard = 0;
        for ( var q = p; q != null && guard++ < 12; q = q.Parent )
            parts.Add( $"{q.ElementName}.{string.Join( '.', q.Class )}[z={q.ComputedStyle?.ZIndex?.ToString() ?? "-"} vis={q.IsVisible} pe={q.ComputedStyle?.PointerEvents?.ToString() ?? "-"} sib={q.SiblingIndex}]" );
        parts.Reverse();
        return string.Join( " > ", parts );
    }

    [ConCmd( "dev_phonechain" )]
    public static void DevPhoneChain()
    {
        var me = Instance;
        Log.Info( $"[phonechain] PHONE: {ChainInfo( me )}" );
        Log.Info( $"[phonechain] BACKDROP: {ChainInfo( me?._backdropRef )}" );
        Log.Info( $"[phonechain] HUB: {ChainInfo( Beastborne.UI.Panels.OnlineHubPanel.DevInstance )}" );
        var root = me?.FindRootPanel();
        var gh = root?.Children?.FirstOrDefault();
        if ( gh != null )
