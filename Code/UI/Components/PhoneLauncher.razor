    }

    private void DiagTick()
    {
        if ( _diagUntil < 0f || Time.Now > _diagUntil ) return;
        var sc = ActiveScroller();
        int scId = sc?.GetHashCode() ?? 0;
        if ( scId != _diagScrollerId ) { _diagScrollerSwaps++; _diagScrollerId = scId; }
        if ( Time.Now < _diagNextAt ) return;
        _diagNextAt = Time.Now + 0.5f;
        var hub = Beastborne.UI.Panels.OnlineHubPanel.DevInstance;
        var gameRoot = FindRootPanel();
        string state =
            $"vis={IsVisible} app={_appView ?? "-"} top={UIModalState.TopModal ?? "-"} chatfocus={ChatPanel.IsChatFocused} " +
            $"mouse={Mouse.Position.x:F0},{Mouse.Position.y:F0} rootRect={Box.Rect.Left:F0},{Box.Rect.Top:F0} {Box.Rect.Width:F0}x{Box.Rect.Height:F0} " +
            $"backdropRect={( _backdropRef == null ? "null" : $"{_backdropRef.Box.Rect.Width:F0}x{_backdropRef.Box.Rect.Height:F0}" )} " +
            $"hov: phone={HasHovered} backdrop={_backdropRef?.HasHovered} hub={hub?.HasHovered} leaf={HoveredLeafPath( gameRoot )} " +
            $"scroller={( sc == null ? "null" : $"{sc.ScrollOffset.y:F0}/{sc.ScrollSize.y:F0} h={sc.Box.Rect.Height:F0} kids={sc.ChildrenCount}" )} swaps={_diagScrollerSwaps} wheel#={_diagWheel}";
        Log.Info( $"[phonefocus] {state}" );
    }

