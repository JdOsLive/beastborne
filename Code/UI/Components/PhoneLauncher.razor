    // double as the icon filenames (ui/icons/pawpad/<id>.svg). Routing is
    // CODE (LaunchDock's switch), not data — the hotload static-data law.
    // Cursor space: grid 0..11, dock 12..15.
    private const int GridCount = 12;
    private static readonly string[] Dock = { "profile", "settings", "guide", "feedback" };
    private const int DockCount = 4;

    // Widget vs destination classification — CODE, not data (see the
    // hotload law above; method bodies are always fresh after a hotload).
    // Widgets (Tier-1 popup toggles) close-and-toggle with no sweep; every
    // other app is a full-screen destination and gets the accent swipe.
