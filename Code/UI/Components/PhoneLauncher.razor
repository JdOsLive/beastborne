    private string AppViewTitle() => _appView switch { "chat" => "CHAT", "radio" => "RADIO", "effects" => "EFFECTS", _ => "ALERTS" };
    private string AppViewKicker() => _appView switch { "chat" => "MESSAGES", "radio" => "MUSIC", "effects" => "BOOSTS", _ => "ALERTS" };
    private string AppViewAccent() => AccentOf( _appView );
