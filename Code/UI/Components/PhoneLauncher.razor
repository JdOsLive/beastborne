    // PHONE-PERIOD wave tiles (512×36 / 512×28, 256px crest period) — native tile.
    private string WaveUrlA() => "ui/wave-" + ( _appView ?? "chat" ) + "-phone-a.png";
    private string WaveUrlB() => "ui/wave-" + ( _appView ?? "chat" ) + "-phone-b.png";

    // ── WAVE DRIFT (polish pass 2026-08-30) — the brief's VERIFY-LIVE item,
    // switched on (user: "the wave animation should also be playing"). Mirrors
    // BbHeaderWaves' timing at the phone tile's period: one full tile (512px)
    // in 30s leftward (A) / 18s rightward (B), ROUNDED to whole px (seam law),
    // B holding its −128px half-period phase. Written as background-position-x
    // — not a transform, so nothing composites and no derived width is poisoned
    // — every frame while an app view is mounted (per-frame re-assert is what
    // survives the 1 Hz re-render; a one-shot write would be wiped). ──
    private Panel _waveA1, _waveA2, _waveA3, _waveB1, _waveB2, _waveB3;
    private const float WavePeriodPx = 512f;

    private void DriftWaves()
    {
        if ( _waveA1 == null || _waveA2 == null || _waveA3 == null || _waveB1 == null || _waveB2 == null || _waveB3 == null ) return;
        // Three copies per layer chase each other across the 538px edge-to-edge
        // band (tile period 512) - whole-px `left` writes, never a transform.
        float offA = MathF.Round( ( Time.Now * ( WavePeriodPx / 30f ) ) % WavePeriodPx );           // leftward
        float offB = MathF.Round( ( WavePeriodPx - ( Time.Now * ( WavePeriodPx / 18f ) ) % WavePeriodPx + 128f ) % WavePeriodPx ); // rightward, -128 phase
        _waveA1.Style.Left = Length.Pixels( -offA );
        _waveA2.Style.Left = Length.Pixels( WavePeriodPx - offA );
        _waveA3.Style.Left = Length.Pixels( 2f * WavePeriodPx - offA );
        _waveB1.Style.Left = Length.Pixels( -offB );
        _waveB2.Style.Left = Length.Pixels( WavePeriodPx - offB );
        _waveB3.Style.Left = Length.Pixels( 2f * WavePeriodPx - offB );
    }

    // Corner wash (keyword gradient — the radial + mask clip is the VERIFY-LIVE upgrade); effects .10, others .12.
    private string WashGradient() => "linear-gradient(to bottom, " + AccentRgba( BloomAccent(), BloomApp() == "effects" ? 0.10f : 0.12f ) + ", rgba(0, 0, 0, 0))";
    private static string AccentOf( string id ) => id switch { "chat" => "#4aa8ff", "radio" => "#c26bff", "effects" => "#f7e024", "alerts" => "#e0414a", _ => "#9b6cff" };
    // The bloom's LANDED bg — accent over #14101f at ~10% (effects 8%: yellow runs hot).
    private static string DerivedOf( string id ) => id switch { "chat" => "#191f35", "radio" => "#251935", "effects" => "#26211f", "alerts" => "#281523", _ => "#14101f" };
    private static string GhostIconOf( string id ) => id switch { "chat" => "lucide:message-circle", "radio" => "lucide:radio", "effects" => "lucide:sparkles", _ => "lucide:bell" };

    private static readonly Dictionary<string, string> _rgbaCache = new();
    private static string AccentRgba( string hex, float alpha )
    {
        var a = alpha.ToString( "0.##", System.Globalization.CultureInfo.InvariantCulture );
        var key = hex + ":" + a;
        if ( _rgbaCache.TryGetValue( key, out var cached ) ) return cached;
        int r = 155, g = 108, b = 255;
        if ( hex != null && hex.Length == 7 && hex[0] == '#' )
        {
            r = Convert.ToInt32( hex.Substring( 1, 2 ), 16 );
            g = Convert.ToInt32( hex.Substring( 3, 2 ), 16 );
            b = Convert.ToInt32( hex.Substring( 5, 2 ), 16 );
        }
        var result = "rgba(" + r + ", " + g + ", " + b + ", " + a + ")";
        _rgbaCache[key] = result;
        return result;
    }

    // ── THE ACCENT BLOOM — launch/return transition + the bg model ────────
    // LIVE (2026-08-30). LAUNCH (t = the arm, two frames after the tap):
    //   t0     tint/wash/ghost rise (240ms) UNDER the disc, which grows out of
    //          the tile centre 0 -> 1440px on the glide ease (260ms)
    //   +140   the app UI fades in over the disc's last 120ms (lands +260)
    //   +260   the disc fades onto the landed tint (180ms; parked full at +440)
    // REVERSE (CloseApp, t = the tap):
    //   t0     the app UI drops out (120ms) while the disc fades back to a
    //          solid accent cover (120ms) — the UI dissolves INTO the accent
    //   +120   app view unmounts, home grid mounts UNDER the disc (its mount
    //          fade), the layers fade out (240ms) and the disc COLLAPSES back
    //          into the tile (240ms)
    //   +360   landed: accent released, taps unblock, deferred deep-links fire
    // Everything is class-toggle transitions on explicit px — no transforms,
    // no animation-delay; the beats are Time stamps compared in TickApps.
    private string _bloomApp;            // the app whose accent/tint the layers wear (held through the reverse bloom)
    private bool _bloomLive;             // the class toggle: tint/wash/ghost shown
    private bool _appUiOn;               // the app view's own .on (rides the disc's last 120ms; drops first on close)
    private float _appUiAt = -1f;        // stamp: when the app UI fades in (arm + 140ms)
    private int _bloomArmFrames;         // mount hidden, toggle .on two frames later (the transition needs the rest state laid out)
    private float _appClosingUntil = -1f; // the reverse bloom LANDS (disc parked on the tile, taps unblock)
    private float _appUnmountAt = -1f;   // the reverse bloom's mid-beat: app view out, home grid in, collapse starts
    private int _pendingRoute = -1;      // tile index to swipe to once the reverse bloom lands (alerts deep-links)
    private string _pendingPopup;        // "achievements" — dock-discipline popup after the reverse bloom
    private bool _swipeNextFrame;        // the grid renders once before StartSwipe grabs its icon
    private float _appOpenedAt = -999f;
    private bool _bloomCircleGrow, _bloomCircleFade;
    private float _bloomCircleFadeAt = -1f;
    private bool _devBloomHold;          // dev_bloom hold — the disc stays full + opaque (screenshot freeze)
    private int _bloomCx = ScreenCx, _bloomCy = ScreenCy; // disc CENTRE in surface padding-box px
    private const int DiscRadius = 720;  // 1440px disc: covers the 538x692 screen from any tile centre (corner tile to the far corner is ~712)
    private const int ScreenCx = 269, ScreenCy = 346; // the screen's centre (538x692 padding box)

    // The disc's inline box origin: at rest a 0x0 point ON the centre; grown,
    // the centre minus the radius (width/height come from the .grow class, so
    // all four glide together and the disc stays centred on the tile).
    private int DiscLeft() => _bloomCircleGrow ? _bloomCx - DiscRadius : _bloomCx;
    private int DiscTop() => _bloomCircleGrow ? _bloomCy - DiscRadius : _bloomCy;

    private string BloomApp() => _bloomApp ?? _appView ?? "chat";
    private string BloomTint() => DerivedOf( BloomApp() );
    private string BloomAccent() => AccentOf( BloomApp() );

    private void OpenApp( string id, bool playSound = true, bool fromTile = true )
    {
        // An in-phone hop (alerts → effects) cross-fades the tint + re-keys the
        // header; only a launch from the grid (or a re-open) blooms.
        bool switching = _appView != null && _appClosingUntil < 0f;
        _appView = id;
        _bloomApp = id;
        _appClosingUntil = -1f;
        _appUnmountAt = -1f;
        _pendingRoute = -1;
        _pendingPopup = null;
        _swipeNextFrame = false;
        _appOpenedAt = Time.Now;
        _rowMotionG.Clear();
        _rowMotionS.Clear();
        _fxLast.Clear();
        _fxExpired.Clear();
        _pressedHit = null;
        _clearArmedAt = -1f;
        _clearingAt = -1f;
        _volLadderUntil = -1f;
        // Cursor + hover start clean per view; a lingering input focus from the
        // previous view would eat every key (the stuck-IsChatFocused trap).
        _appKb = null;
        _hoverHit = null;
        _stops.Clear();
        _kbScrollPending = 0;
        BlurPhoneInput();
        // Overlay scrollbar: forget the previous app's geometry, measure over the
        // first frames of the new view, and once more after the cascade (0.7s).
        _sbOn = false;
        _sbSeenTrack = null;
        _sbTrackTop = _sbTrackH = _sbThumbTop = _sbThumbH = -1;
        _sbDirtyFrames = 4;
        _sbRefreshAt = Time.Now + 0.8f;
        if ( !switching )
        {
            _bloomLive = false;
            _appUiOn = false;
            _appUiAt = -1f;
            _bloomArmFrames = 2;
            SeedBloomCircle( fromTile );
        }
        switch ( id )
        {
            case "alerts":
                // v10: opening ALERTS is "reading your notifications" — clears the
                // badge. The unread ticks read against the PREVIOUS open.
                Beastborne.Core.NotificationManager.Instance?.MarkAllRead();
                _alertsSeenBefore = LastAlertsOpenedAt;
                LastAlertsOpenedAt = DateTime.UtcNow;
                break;
            case "chat":
                _chatLastCount = Beastborne.Core.ChatManager.Instance?.Messages?.Count ?? 0;
                _chatScrollPending = 4;
                break;
            case "radio":
                _lastTrackSig = Beastborne.Systems.RadioManager.CurrentStationIndex * 1000 + Beastborne.Systems.RadioManager.CurrentTrackIndex;
                RefreshProgress();
                break;
        }
        if ( playSound ) SoundManager.PlayForward();
        StateHasChanged();
    }

    // Q / back / the chin paw: the reverse bloom (timeline in the field block).
    // Beat 1 (0-120ms): the app UI drops out while the disc fades back to a
    // solid accent cover (leaving .fade rides the .grow rule's 120ms opacity).
    // The disc must be full for this — a close mid-launch holds .grow (the
    // width transition simply continues toward full). Beat 2 = UnmountApp at
    // +120, beat 3 = LandCloseApp at +360 (both from TickApps).
    private void CloseApp()
    {
        if ( _appView == null || _appClosingUntil > 0f ) return;
        _appUiOn = false;
        _appUiAt = -1f;
        _bloomArmFrames = 0;
        _bloomLive = true;           // the layers stay landed under the solid disc until the collapse starts
        _bloomCircleGrow = true;
        _bloomCircleFade = false;
        _bloomCircleFadeAt = -1f;
        _devBloomHold = false;
        _appUnmountAt = Time.Now + 0.12f;
        _appClosingUntil = Time.Now + 0.36f;
        _hoverHit = null;
        BlurPhoneInput(); // the view unmounts — an unmounted TextEntry never fires onblur
        SoundManager.PlayBack();
        StateHasChanged();
    }

    // Beat 2 (+120ms): the app UI is gone and the disc is a solid cover — swap
    // the views UNDER it (app view out, home grid in with its mount fade) and
    // start the collapse: the disc back into the tile + the layers out (240ms).
    private void UnmountApp()
    {
        _appView = null;
        _ringWarmup = 0;
        _ringDirty = true; // the home grid's ring re-locks
        if ( _pendingRoute >= 0 ) _kb = _pendingRoute; // the grid mounts with the cursor already on the destination
        _bloomLive = false;
        _bloomCircleGrow = false;
        _bloomCircleFade = false;
        StateHasChanged();
    }

    // Beat 3 (+360ms): the disc is parked 0x0 on the tile — release the accent
    // (the tint/disc colours may now swap invisibly), then any deferred deep-link.
    private void LandCloseApp()
    {
        _appClosingUntil = -1f;
        _appUnmountAt = -1f;
        _bloomApp = null;
        if ( _pendingPopup == "achievements" )
        {
            // Dock discipline: popups open OVER the game, not through a swipe.
            _pendingPopup = null;
            Close();
            NavManager.MarkRouted();
            Beastborne.UI.Panels.AchievementPanel.Show();
        }
        else if ( _pendingRoute >= 0 )
        {
            _swipeNextFrame = true; // the grid is up; the accent swipe launches next frame — exactly a home-grid launch
        }
        StateHasChanged();
    }

    // Hard reset — a full phone close / re-open lands on the grid.
    private void ResetAppState()
    {
        _appView = null;
        _bloomApp = null;
        _bloomLive = false;
        _bloomArmFrames = 0;
        _appClosingUntil = -1f;
        _pendingRoute = -1;
        _pendingPopup = null;
        _swipeNextFrame = false;
        _pressedHit = null;
        _bloomCircleGrow = false;
        _bloomCircleFade = false;
        _bloomCircleFadeAt = -1f;
        _appUiOn = false;
        _appUiAt = -1f;
        _appUnmountAt = -1f;
        _devBloomHold = false;
        _appKb = null;
        _hoverHit = null;
        _stops.Clear();
        _kbScrollPending = 0;
        BlurPhoneInput();
    }

    // Park the disc (0x0) on the launch origin: the focused tile's icon centre
    // (mouse tap and keyboard Space both set _kb before OpenApp, so both seed
    // from the tile); OpenToApp / deep-links have no tile — the screen centre.
    private void SeedBloomCircle( bool fromTile )
    {
        _bloomCircleGrow = false;
        _bloomCircleFade = false;
        _bloomCircleFadeAt = -1f;
        _bloomCx = ScreenCx;
        _bloomCy = ScreenCy;
        if ( !fromTile ) return;
        var icon = FocusedIconEl();
        if ( icon == null || _surfaceRef == null ) return;
        var ir = icon.Box.Rect;
        var sr = _surfaceRef.Box.Rect;
        if ( ir.Width < 1f || sr.Width < 1f ) return;
        float sc = ScaleFromScreen;
        if ( sc <= 0.01f || float.IsNaN( sc ) || float.IsInfinity( sc ) ) sc = 1f;
        // Icon centre in the surface's box space = the padding-box space the clip
        // host occupies (the surface's 1px border is below a pixel of care).
        int cx = (int)( ( ir.Left + ir.Width / 2f - sr.Left ) * sc );
        int cy = (int)( ( ir.Top + ir.Height / 2f - sr.Top ) * sc );
        if ( cx < 0 || cy < 0 || cx > 538 || cy > 692 ) return; // stale / unlaid-out rect — keep the centre
        _bloomCx = cx;
        _bloomCy = cy;
    }

    // ── Press feedback — router-stamped (no :hover/:active reaches the device) ──
    private string _pressedHit;
    private float _pressedAt;
    private bool IsPressed( string hit ) => _pressedHit == hit;

    // ── The 1 Hz clock the timers ride (progress fill, depletion strips,
    // relative times, last-minute parity). A value update, not motion. ──
    private int _tick;
    private float _tickAt = -999f;

    // Per-frame app upkeep — comparisons + rare StateHasChanged; NO style
    // writes (the 7fps law stays policy inside the device).
    private void TickApps()
    {
        // Stale-stamp hygiene: Time.Now resets per session while fields survive hotload.
        if ( _appClosingUntil > Time.Now + 1f ) _appClosingUntil = -1f;
        if ( _appUnmountAt > Time.Now + 1f ) _appUnmountAt = -1f;
        if ( _appUiAt > Time.Now + 1f ) _appUiAt = -1f;
        if ( _bloomCircleFadeAt > Time.Now + 1f ) _bloomCircleFadeAt = -1f;
        if ( _clearArmedAt > Time.Now + 3f ) _clearArmedAt = -1f;
        if ( _clearingAt > Time.Now + 1f ) _clearingAt = -1f;
        if ( _volLadderUntil > Time.Now + 1f ) _volLadderUntil = -1f;

        bool dirty = false;

        // The bloom arm: the app view mounted hidden; toggle .on once layout holds the rest state.
        if ( _bloomArmFrames > 0 && _appView != null )
        {
            _bloomArmFrames--;
            if ( _bloomArmFrames == 0 )
            {
                // t0: the layers rise (240ms) under the disc growing out of the tile (260ms).
                _bloomLive = true;
                _bloomCircleGrow = true;
                _appUiAt = Time.Now + 0.14f;           // the app UI fades in over the disc's last 120ms
                _bloomCircleFadeAt = Time.Now + 0.26f; // disc full -> fade onto the landed tint (180ms)
                dirty = true;
            }
        }
        if ( _appUiAt > 0f && Time.Now >= _appUiAt ) { _appUiAt = -1f; _appUiOn = true; dirty = true; }
        // dev_bloom hold parks this stamp (the disc stays full); off lets it fire.
        if ( _bloomCircleFadeAt > 0f && Time.Now >= _bloomCircleFadeAt && !_devBloomHold )
        {
            _bloomCircleFadeAt = -1f;
            _bloomCircleFade = true;
            dirty = true;
        }

        // Reverse bloom: +120ms swap the views under the solid disc and start the
        // collapse; +360ms the disc has parked on its tile — release + deep-link.
        if ( _appUnmountAt > 0f && Time.Now >= _appUnmountAt ) { _appUnmountAt = -1f; UnmountApp(); }
        if ( _appClosingUntil > 0f && Time.Now >= _appClosingUntil ) { LandCloseApp(); return; }
        if ( _swipeNextFrame )
        {
            _swipeNextFrame = false;
            int i = _pendingRoute;
            _pendingRoute = -1;
            if ( i >= 0 && i < Apps.Length ) { SoundManager.PlayForward(); StartSwipe( i, Apps[i] ); }
            return;
        }

        // The press stamp clears at +120ms — this IS the one-shot (a ≤1 Hz tick is not enough).
        if ( _pressedHit != null && Time.Now - _pressedAt > 0.12f ) { _pressedHit = null; dirty = true; }

        // The header's wave band drifts while an app view is mounted (including
        // the reverse bloom — it fades out mid-drift, never freezes first).
        if ( _appView != null ) DriftWaves();

        // Keyboard walk: bring the focused row fully into the scroller (two frames —
        // the stamped row must have laid out under its new class first).
        if ( _kbScrollPending > 0 ) { _kbScrollPending--; ScrollFocusedIntoView(); }

        float tdt = Time.Now - _tickAt;
        bool ticked = tdt < 0f || tdt >= 1f;
        if ( ticked )
        {
            _tickAt = Time.Now;
            _tick++;
            if ( _appView == "radio" ) RefreshProgress();
            if ( _appView is "radio" or "effects" or "alerts" ) dirty = true;
        }

        if ( _appView == "radio" )
        {
            int sig = Beastborne.Systems.RadioManager.CurrentStationIndex * 1000 + Beastborne.Systems.RadioManager.CurrentTrackIndex;
            if ( sig != _lastTrackSig ) { _lastTrackSig = sig; _trackKey++; RefreshProgress(); dirty = true; }
            if ( _volLadderUntil > 0f && Time.Now >= _volLadderUntil ) { _volLadderUntil = -1f; dirty = true; }
        }
        else if ( _appView == "chat" )
        {
            // Auto-scroll to newest on open + on arrival (deferred a few frames so
            // the new row has laid out — the roster's scroll-reset pattern).
            int count = Beastborne.Core.ChatManager.Instance?.Messages?.Count ?? 0;
            if ( count != _chatLastCount ) { _chatLastCount = count; _chatScrollPending = 3; }
            if ( _chatScrollPending > 0 && _chatScrollRef != null )
            {
                _chatScrollRef.ScrollOffset = new Vector2( 0f, _chatScrollRef.ScrollSize.y );
                _chatScrollPending--;
                ArmScrollbar(); // the thumb rides the auto-scroll to newest
            }
        }
        else if ( _appView == "effects" )
        {
            if ( _fxExpired.Count > 0 && _fxExpired.RemoveAll( g => Time.Now - g.At > 0.4f ) > 0 ) dirty = true;
        }
        else if ( _appView == "alerts" )
        {
            if ( _clearArmedAt > 0f && Time.Now - _clearArmedAt >= 2f ) { _clearArmedAt = -1f; dirty = true; }
            if ( _clearingAt > 0f && Time.Now - _clearingAt >= 0.5f )
            {
                _clearingAt = -1f;
                Beastborne.Core.NotificationManager.Instance?.ClearHistory();
                _readIds.Clear();
                dirty = true;
                ArmScrollbar(); // the list empties — the track hides on the next measure
            }
        }

        // Overlay scrollbar upkeep — measured on the 1 Hz tick, on armed
        // frames (wheel / auto-scroll / open), and once after the cascade has
        // settled (+0.8s). Never every frame. _sbOn flips are picked up by
        // BuildHash; the px writes go straight to the refs.
        if ( _appView is "chat" or "effects" or "alerts" )
        {
            if ( _sbRefreshAt > Time.Now + 2f ) _sbRefreshAt = -1f;   // stale stamp from a prior session
            if ( _sbRefreshAt > 0f && Time.Now >= _sbRefreshAt ) { _sbRefreshAt = -1f; ArmScrollbar( 1 ); }
            if ( ticked || _sbDirtyFrames > 0 )
            {
                if ( _sbDirtyFrames > 0 ) _sbDirtyFrames--;
                UpdateAppScrollbar();
            }
        }

        if ( dirty ) StateHasChanged();
    }

    // ── Row motion (§ 6 LIFE) — the class is assigned at FIRST render and
    // cached per row id, because a class change IS a replay. Launch rows get
    // the shared cascade (hold through the bloom, then 40ms apart, cap 5);
    // rows first seen after launch ARRIVE. ──
    private readonly Dictionary<Guid, string> _rowMotionG = new();
    private readonly Dictionary<string, string> _rowMotionS = new();
    private string MotionFor( int index, bool own ) =>
        ( Time.Now - _appOpenedAt < 0.7f ) ? "pl-cas-" + Math.Min( index, 5 ) : ( own ? "pl-arrive-own" : "pl-arrive" );
    private string RowMotion( Guid id, int index, bool own )
    {
        if ( _rowMotionG.TryGetValue( id, out var c ) ) return c;
        c = MotionFor( index, own );
        _rowMotionG[id] = c;
        return c;
    }
    private string RowMotion( string key, int index )
    {
        if ( _rowMotionS.TryGetValue( key, out var c ) ) return c;
        c = MotionFor( index, false );
        _rowMotionS[key] = c;
        return c;
    }

    // ── CHAT ─────────────────────────────────────────────────────────────
    private int _chatLastCount;
    private int _chatScrollPending;
    private int _seenGlobal, _seenGuild, _seenTrade;

    // Per-channel counts; the channel ON SCREEN is "seen" by definition
    // (render-time latch). Unread = arrivals in channels you're not looking at.
    private (int Global, int Guild, int Trade) ChanCounts()
    {
        int g = 0, gu = 0, t = 0;
        var msgs = Beastborne.Core.ChatManager.Instance?.Messages;
        if ( msgs != null )
        {
            foreach ( var m in msgs )
            {
                if ( m.Type == Beastborne.Data.ChatMessageType.GuildChat ) gu++;
                else if ( m.Type == Beastborne.Data.ChatMessageType.Trade ) t++;
                else g++;
            }
        }
        if ( _appView == "chat" )
        {
            if ( _phoneChan == "global" ) _seenGlobal = g;
            else if ( _phoneChan == "guild" ) _seenGuild = gu;
            else _seenTrade = t;
        }
        return (g, gu, t);
    }

    private int ChanUnread( string chan, (int Global, int Guild, int Trade) c ) => chan switch
    {
        "global" => Math.Max( 0, c.Global - _seenGlobal ),
        "guild" => Math.Max( 0, c.Guild - _seenGuild ),
        _ => Math.Max( 0, c.Trade - _seenTrade ),
    };

    // The visible log: FILTERED by channel (the desktop ChatPanel's rule), last 50.
    private List<Beastborne.Data.ChatMessage> PhoneMessages()
    {
        var list = new List<Beastborne.Data.ChatMessage>();
        var all = Beastborne.Core.ChatManager.Instance?.Messages;
        if ( all == null ) return list;
        foreach ( var m in all )
        {
            bool isGuild = m.Type == Beastborne.Data.ChatMessageType.GuildChat;
            bool isTrade = m.Type == Beastborne.Data.ChatMessageType.Trade;
            bool ok = _phoneChan == "guild" ? isGuild : _phoneChan == "trade" ? isTrade : ( !isGuild && !isTrade );
            if ( ok ) list.Add( m );
        }
        if ( list.Count > 50 ) list.RemoveRange( 0, list.Count - 50 );
        return list;
    }

    private bool IsOwnPhoneMsg( Beastborne.Data.ChatMessage m ) =>
        m.SteamId == ( Beastborne.Core.ChatManager.Instance?.LocalSteamId ?? 0 );

    private string ChatEmptyTitle()
    {
        int total = Beastborne.Core.ChatManager.Instance?.Messages?.Count ?? 0;
        return total == 0 ? "NOTHING YET" : _phoneChan.ToUpperInvariant() + " IS QUIET";
    }

    private string ChatEmptyHint()
    {
        int total = Beastborne.Core.ChatManager.Instance?.Messages?.Count ?? 0;
        return total == 0 ? "Say hi — global is everyone online." : "Messages land here as they arrive.";
    }

    private string InputPlaceholder() => "Message " + _phoneChan + "...";

    // Author taps open the tamer card — the card is the LAST TamerCardShowcase
    // that SteamId posted this session (no request-by-SteamId exists yet);
    // authors with no card are INERT (no hit class, no press stamp).
    private bool HasCardFor( long steamId ) => steamId != 0 && CardFor( steamId ) != null;

    private Beastborne.Data.ChatMessage CardFor( long steamId )
    {
        var msgs = Beastborne.Core.ChatManager.Instance?.Messages;
        if ( msgs == null ) return null;
        for ( int i = msgs.Count - 1; i >= 0; i-- )
        {
            var m = msgs[i];
            if ( m.SteamId == steamId && m.Type == Beastborne.Data.ChatMessageType.TamerCardShowcase ) return m;
        }
        return null;
    }

    private string ShowcaseSprite( Beastborne.Data.ChatMessage m )
    {
        if ( !string.IsNullOrEmpty( m.IconPath ) ) return m.IconPath;
        if ( string.IsNullOrEmpty( m.ShowcaseSpeciesId ) ) return null;
        return Beastborne.Core.MonsterManager.Instance?.GetSpecies( m.ShowcaseSpeciesId )?.IconPath;
    }

    // Element bright-rim map (style-guide canonical) for the embed's 4px edge.
    private static string ElementRim( string element ) => ( element ?? "" ).ToLowerInvariant() switch
    {
        "fire" => "#dc2626", "water" => "#2563eb", "earth" => "#92400e", "wind" => "#2dd4bf",
        "electric" => "#ca8a04", "ice" => "#0ea5e9", "nature" => "#22c55e", "metal" => "#64748b",
        "shadow" => "#5b21b6", "spirit" => "#be185d", _ => "#737373",
    };

    private static string RarityColor( string rarity ) => ( rarity ?? "" ).ToLowerInvariant() switch
    {
        "uncommon" => "#22c55e", "rare" => "#3b82f6", "epic" => "#a855f7",
        "legendary" => "#fbbf24", "mythic" => "#ec4899", _ => "#9ca3af",
    };

    private void OnPhoneChatSend()
    {
        var text = _phoneChatBox?.GetText()?.Trim();
        // 2026-09-01 (usability audit): Enter SENDS AND HANDS THE KEYBOARD BACK
        // (the game-chat convention). Before, the entry kept focus after a send,
        // so the next Q typed a "q" instead of backing out and W/S/A/D were dead
        // until an Esc nobody was told about. The cursor stays parked ON the
        // input, so Enter (or Space) is one press back into typing; Enter on an
        // empty entry = just stop typing. LastBlurAt latches this same frame.
        _appKb = "hit-input";
        BlurPhoneInput();
        if ( string.IsNullOrEmpty( text ) ) { StateHasChanged(); return; }
        switch ( _phoneChan )
        {
            case "guild": Beastborne.Core.ChatManager.Instance?.SendGuildMessage( text ); break;
            case "trade": Beastborne.Core.ChatManager.Instance?.SendTradeMessage( text ); break;
            default: Beastborne.Core.ChatManager.Instance?.SendMessage( text ); break;
        }
        _phoneChatBox?.ClearText();
        _chatScrollPending = 3;
        StateHasChanged();
    }

    private void TapAuthor( int idx )
    {
        var msgs = PhoneMessages();
        if ( idx < 0 || idx >= msgs.Count ) return;
        var card = CardFor( msgs[idx].SteamId );
        if ( card == null ) return;
        SoundManager.PlayClick();
        TamerCardShowcasePopup.Show( card );
    }

    private void TapEmbed( int idx )
    {
        var msgs = PhoneMessages();
        if ( idx < 0 || idx >= msgs.Count ) return;
        var m = msgs[idx];
        SoundManager.PlayClick();
        if ( m.Type == Beastborne.Data.ChatMessageType.BeastShowcase ) BeastShowcasePopup.Show( m );
        else if ( m.Type == Beastborne.Data.ChatMessageType.TamerCardShowcase ) TamerCardShowcasePopup.Show( m );
    }

    // ── RADIO ────────────────────────────────────────────────────────────
    private int _trackKey;
    private int _lastTrackSig = -1;
    private int _progFillPx;
    private string _progPos = "0:00";
    private string _progDur = "0:00";
    private int _volKey;
    private float _volLadderUntil = -1f;

    // 1 Hz cached progress (ClockText pattern) — px fill on the fixed 476 track.
    private void RefreshProgress()
    {
        float pos = Beastborne.Systems.RadioManager.TrackPosition;
        float dur = Beastborne.Systems.RadioManager.TrackDuration;
        _progFillPx = dur > 0.5f ? (int)Math.Clamp( 476f * pos / dur, 0f, 476f ) : 0;
        _progPos = FormatClock( pos );
        _progDur = FormatClock( dur );
    }

    private static string FormatClock( float s )
    {
        if ( s < 0f || float.IsNaN( s ) || float.IsInfinity( s ) ) s = 0f;
        int t = (int)s;
        return ( t / 60 ) + ":" + ( t % 60 ).ToString( "00" );
    }

    private string StationName() => ( Beastborne.Systems.RadioManager.CurrentStation?.Name ?? "RADIO" ).ToUpperInvariant();
    private string TrackName() => Beastborne.Systems.RadioManager.CurrentTrack?.Name ?? "No track";
    private string StationChipLabel() => StationName() + " ›";

    // Honest caption: where you are in the station + the auto-switch rule.
    private string RadioCaption()
    {
        var st = Beastborne.Systems.RadioManager.CurrentStation;
        if ( st == null ) return "";
        int n = st.Tracks.Count;
        int i = Math.Clamp( Beastborne.Systems.RadioManager.CurrentTrackIndex + 1, 1, Math.Max( 1, n ) );
        string other = null;
        foreach ( var s in Beastborne.Systems.RadioManager.Stations )
            if ( s != st ) { other = s.Name.ToUpperInvariant(); break; }
        string where = st.Context == Beastborne.Systems.RadioContext.Battle ? "in menus" : "in battle";
        return other == null ? "Track " + i + " of " + n : "Track " + i + " of " + n + " · switches to " + other + " " + where;
    }

    private int VolStep() => Math.Clamp( (int)MathF.Round( Beastborne.Systems.RadioManager.Volume * 5f ), 0, 5 );
    private bool VolLadderActive() => _volLadderUntil > 0f && Time.Now < _volLadderUntil;

    // Stepped volume: raising lights the segments in sequence (re-keyed ladder),
    // lowering goes dark at once.
    private void TapVolume( int k )
    {
        if ( k < 1 || k > 5 ) return;
        int old = VolStep();
        Beastborne.Systems.RadioManager.SetVolume( k * 0.2f );
        if ( k > old ) { _volKey++; _volLadderUntil = Time.Now + 0.25f; }
        SoundManager.PlayClick();
    }

    // Visualizer — baked LOSSLESS animated WebP <img>, src value-swapped on
    // IsPlaying. ASSET ASK: neither file ships yet; existence is checked once
    // and the nine static CSS bars stand in until they land.
    private const string VizAnimPath = "ui/pawpad/radio-viz.webp";
    private const string VizStaticPath = "ui/pawpad/radio-viz-static.png";
    private static int _vizChecked;
    private static bool _vizAnim, _vizStatic;

    private string VizSrc()
    {
        if ( _vizChecked == 0 )
        {
            _vizChecked = 1;
            try
            {
                _vizAnim = FileSystem.Mounted.FileExists( VizAnimPath );
                _vizStatic = FileSystem.Mounted.FileExists( VizStaticPath );
            }
            catch { _vizAnim = false; _vizStatic = false; }
        }
        if ( Beastborne.Systems.RadioManager.IsPlaying && _vizAnim ) return VizAnimPath;
        if ( _vizStatic ) return VizStaticPath;
        if ( _vizAnim ) return VizAnimPath;
        return null;
    }

    // ── EFFECTS ──────────────────────────────────────────────────────────
    private class FxGhost { public string Key, Label, Source, Glyph, IconPath; public float At; }
    private readonly Dictionary<string, FxGhost> _fxLast = new();
    private readonly List<FxGhost> _fxExpired = new();

    private int EffectsCount() => ActiveEffectsPanel.TotalEffectCount;
    private List<(string Name, int Rank, string IconPath, string Glyph)> PhoneSkills() => ActiveEffectsPanel.GetPhoneSkills();
    private List<FxGhost> FxGhosts() => _fxExpired;

    // Timed boosts + expiry ghosts: a key that vanished since the last render
    // fades 400ms as .expired, then the rows below settle up.
    private List<(string Key, string Label, string Source, TimeSpan Remaining, float TotalSeconds, string Glyph, string IconPath)> PhoneBoosts()
    {
        var rows = ActiveEffectsPanel.GetPhoneBoosts();
        if ( _fxLast.Count > 0 )
        {
            foreach ( var kv in _fxLast )
            {
                bool present = false;
                foreach ( var r in rows ) if ( r.Key == kv.Key ) { present = true; break; }
                if ( !present ) { kv.Value.At = Time.Now; _fxExpired.Add( kv.Value ); }
            }
        }
        _fxLast.Clear();
        foreach ( var r in rows )
            _fxLast[r.Key] = new FxGhost { Key = r.Key, Label = r.Label, Source = r.Source, Glyph = r.Glyph, IconPath = r.IconPath };
        return rows;
    }

    // 508 = the row's declared width (512 occupied − the 4px cursor edge border).
    private static int FillPx( TimeSpan remaining, float totalSeconds ) =>
        (int)Math.Clamp( 508f * (float)remaining.TotalSeconds / Math.Max( 1f, totalSeconds ), 0f, 508f );

    private static string FormatRemaining( TimeSpan t )
    {
        if ( t.TotalHours >= 1 ) return (int)t.TotalHours + "h " + t.Minutes + "m";
        if ( t.TotalMinutes >= 1 ) return t.Minutes + "m " + t.Seconds + "s";
        return Math.Max( 0, t.Seconds ) + "s";
    }

    // ── ALERTS ───────────────────────────────────────────────────────────
    /// <summary>UTC stamp of the last ALERTS open — the unread-tick watermark (UI-side, session-scoped).</summary>
    public static DateTime LastAlertsOpenedAt = DateTime.MinValue;
    private DateTime _alertsSeenBefore = DateTime.MinValue;
    private readonly HashSet<Guid> _readIds = new();
    private float _clearArmedAt = -1f;
    private float _clearingAt = -1f;
    private bool ClearArmed => _clearArmedAt > 0f && Time.Now - _clearArmedAt < 2f;

    // v10: ALERTS reads the persistent HISTORY (the record, up to 50 —
    // written at AddNotification time), not the transient active list.
    private List<Beastborne.Core.Notification> PhoneNotifications() =>
        Beastborne.Core.NotificationManager.Instance?.NotificationHistory?.ToList() ?? new List<Beastborne.Core.Notification>();

    private bool IsAlertUnread( Beastborne.Core.Notification n ) => n.CreatedAt > _alertsSeenBefore && !_readIds.Contains( n.Id );

    // The SHIPPED peek map; its violet entries (Evolution, default) render cream here — violet is the cursor.
    private static string AlertGlyphColor( Beastborne.Core.NotificationType t )
    {
        var c = NotificationPanel.GetNotificationIconColor( t );
        return c == "#c4b5fd" ? "#f4f1ea" : c;
    }

    private static string RelativeTime( DateTime utc )
    {
        var span = DateTime.UtcNow - utc;
        if ( span.TotalSeconds < 60 ) return "now";
        if ( span.TotalMinutes < 60 ) return (int)span.TotalMinutes + "m";
        if ( span.TotalHours < 24 ) return (int)span.TotalHours + "h";
        return (int)span.TotalDays + "d";
    }

    private static string Truncate( string s, int n ) =>
        string.IsNullOrEmpty( s ) || s.Length <= n ? s : s.Substring( 0, n - 3 ) + "...";

    // Tap = mark read + deep-link to the subject. Leaving the phone runs the
    // launch grammar in reverse: reverse bloom → the destination tile's
    // accent swipe → route. In-phone targets keep the phone open.
    private void TapAlert( int idx )
    {
        var list = PhoneNotifications();
        if ( idx < 0 || idx >= list.Count ) return;
        var n = list[idx];
        _readIds.Add( n.Id );
        SoundManager.PlayClick();
        var route = n.Route;
        if ( string.IsNullOrEmpty( route ) ) return;
        if ( route == "effects" ) { OpenApp( "effects" ); return; }
        if ( route == "achievements" ) { _pendingPopup = "achievements"; CloseApp(); return; }
        int tile = -1;
        if ( route.StartsWith( "monsters" ) )
        {
            int c = route.IndexOf( ':' );
            if ( c >= 0 && Guid.TryParse( route.Substring( c + 1 ), out var g ) )
                Beastborne.UI.Panels.MonsterRosterPanel.PendingFocusMonsterId = g; // the roster's existing select latch
            tile = 0;
        }
        else if ( route == "skills" ) tile = 1;
        else if ( route == "expedition" ) tile = 2;
        else if ( route.StartsWith( "online" ) ) tile = 3; // guild-section latch = follow-up (OnlineHubPanel is being edited concurrently)
        if ( tile < 0 ) return;
        _pendingRoute = tile;
        CloseApp();
    }

    private void TapClear()
    {
        if ( _clearingAt > 0f ) return;
        if ( !ClearArmed ) { _clearArmedAt = Time.Now; SoundManager.PlayClick(); return; }
        _clearArmedAt = -1f;
        _clearingAt = Time.Now; // rows fade bottom-up (pl-clr-N); the +500ms one-shot empties the record
        SoundManager.PlayBack();
    }

    // ── The app-view mouse router: same inverse projection as the tiles,
    // but hit-testing `pl-hit` controls walked from the SURFACE (the OS
    // status row carries hit-back now). ──
    private static readonly string[] HitActions =
    {
        "hit-back", "hit-home", "hit-chan-global", "hit-chan-guild", "hit-chan-trade",
        "hit-send", "hit-input", "hit-radio-prev", "hit-radio-play", "hit-radio-next",
        "hit-radio-shuffle", "hit-radio-repeat", "hit-radio-station",
        "hit-clear",
    };

    // Indexed families resolve by PREFIX (class starts-with → the whole class is the action).
    private static readonly string[] HitPrefixes = { "hit-alert-", "hit-chat-author-", "hit-embed-", "hit-vol-", "hit-msg-", "hit-fx-", "hit-sk-" };

    private string ActionAtScreen( Vector2 screenPx )
    {
        var walkRoot = _surfaceRef ?? _appviewRef;
        if ( walkRoot == null || _deviceRef == null ) return null;
        var rr = Box.Rect;
        var dr = _deviceRef.Box.Rect;
        if ( rr.Width < 1f || dr.Width < 1f ) return null;
        float sc = ScaleFromScreen;
        if ( sc <= 0.01f || float.IsNaN( sc ) || float.IsInfinity( sc ) ) sc = 1f;
        float x0 = ( dr.Right - rr.Left ) * sc;
        float y0 = ( dr.Top + dr.Height / 2f - rr.Top ) * sc;
        var pt = new Vector2( ( screenPx.x - rr.Left ) * sc, ( screenPx.y - rr.Top ) * sc );
        var lp = InverseLean( pt, x0, y0 );

        string found = null;
        WalkHits( walkRoot, rr, sc, lp, ref found );
        // The chin paw (HOME) sits outside the surface subtree - walk it too.
        if ( found == null && _chinRef != null ) WalkHits( _chinRef, rr, sc, lp, ref found );
        return found;
    }

    // POST-ORDER walk (2026-08-28 fix): children first, so the INNERMOST hit
    // target wins. The old pre-order walk returned on the first match, which
    // made any nested target unreachable — phone chat's SEND (a child of the
    // `hit-input` row) resolved to "focus input" on every tap. Law recorded in
    // learnings: a parent must never carry pl-hit if a child does; this walk
    // makes the layout tolerant of it anyway.
    // 2026-08-29: a scroller (`pl-scroll-clip`) only admits points inside its
    // OWN rect — LayoutContains tests a panel's rect alone, so a row scrolled
    // out of the viewport would otherwise be tappable through the header.
    private static void WalkHits( Panel p, Rect rr, float sc, Vector2 lp, ref string found )
    {
        if ( found != null || p == null ) return;
        if ( p.HasClass( "pl-scroll-clip" ) && !LayoutContains( p.Box.Rect, rr, sc, lp, 0f ) ) return;
        foreach ( var child in p.Children )
        {
            WalkHits( child, rr, sc, lp, ref found );
            if ( found != null ) return;
        }
        if ( p.HasClass( "pl-hit" ) && LayoutContains( p.Box.Rect, rr, sc, lp, 4f ) )
        {
            foreach ( var act in HitActions )
                if ( p.HasClass( act ) ) { found = act; return; }
            var classes = p.Classes;
            if ( string.IsNullOrEmpty( classes ) ) return;
            foreach ( var c in classes.Split( ' ' ) )
                foreach ( var pre in HitPrefixes )
                    if ( c.StartsWith( pre ) ) { found = c; return; }
        }
    }

    private static int HitIndex( string act )
    {
        int i = act.LastIndexOf( '-' );
        return ( i >= 0 && int.TryParse( act.Substring( i + 1 ), out var n ) ) ? n : -1;
    }

    private void RunAppAction( string act )
    {
        if ( _appClosingUntil > 0f ) return;
        // Info rows (effects) are reading stops only — no press flash on a slab
        // that leads nowhere (a flash promises a button).
        if ( act.StartsWith( "hit-fx-" ) || act.StartsWith( "hit-sk-" ) ) return;
        // A whole chat message is a stop; its ACTION is the embed (showcase) or
        // the author (tamer card) inside it — the same thing a tap on those
        // resolves to. A plain message with no card is inert.
        if ( act.StartsWith( "hit-msg-" ) )
        {
            var sub = MsgActionOf( HitIndex( act ) );
            if ( sub != null ) RunAppAction( sub );
            return;
        }
        // Press stamp — brighten / dim for ~120ms (SNAP layer).
        if ( act != "hit-input" ) { _pressedHit = act; _pressedAt = Time.Now; }

        if ( act.StartsWith( "hit-alert-" ) ) TapAlert( HitIndex( act ) );
        else if ( act.StartsWith( "hit-chat-author-" ) ) TapAuthor( HitIndex( act ) );
        else if ( act.StartsWith( "hit-embed-" ) ) TapEmbed( HitIndex( act ) );
        else if ( act.StartsWith( "hit-vol-" ) ) TapVolume( HitIndex( act ) );
        else
        {
            switch ( act )
            {
                case "hit-back": CloseApp(); break;
                case "hit-home": CloseApp(); break; // the chin paw
                case "hit-chan-global": _phoneChan = "global"; _chatScrollPending = 3; SoundManager.PlayClick(); break;
                case "hit-chan-guild": _phoneChan = "guild"; _chatScrollPending = 3; SoundManager.PlayClick(); break;
                case "hit-chan-trade": _phoneChan = "trade"; _chatScrollPending = 3; SoundManager.PlayClick(); break;
                case "hit-send": OnPhoneChatSend(); break;
                case "hit-input": _appKb = "hit-input"; _phoneChatBox?.FocusInput(); break;
                case "hit-radio-prev": Beastborne.Systems.RadioManager.PreviousTrack(); break;
                case "hit-radio-play": Beastborne.Systems.RadioManager.TogglePlay(); SoundManager.PlayClick(); break;
                case "hit-radio-next": Beastborne.Systems.RadioManager.NextTrack(); break;
                case "hit-radio-shuffle": Beastborne.Systems.RadioManager.ToggleShuffle(); SoundManager.PlayClick(); break;
                case "hit-radio-repeat": Beastborne.Systems.RadioManager.ToggleRepeat(); SoundManager.PlayClick(); break;
                case "hit-radio-station": Beastborne.Systems.RadioManager.NextStation(); break;
                case "hit-clear": TapClear(); break;
            }
        }
        StateHasChanged();
    }

    // Dock launches are all Tier-1 popups/overlays — no sweep (widget
    // discipline): close the phone, open the destination. Routing lives
    // in code, not data (hotload law).
    private void LaunchDock( int d )
    {
        if ( d < 0 || d >= Dock.Length ) return;
        _kb = GridCount + d;
        Close();
        // Stamp the route latch — these open via panel statics, not
        // NavManager, so without this the same edge-triggered Enter also
        // fires the global open-chat bind (live: chat popped over the
        // freshly-opened dock destination).
        NavManager.MarkRouted();
        switch ( Dock[d] )
        {
            case "profile": NavManager.OpenOverlay( NavManager.OverlayProfile ); break;
            case "settings": OptionsPanel.Show(); break;
            case "guide": Beastborne.UI.Panels.HelpPanel.Show(); break;
            case "feedback": Beastborne.UI.Panels.FeedbackPanel.Show(); break;
        }
    }

    private void RouteApp( int i )
    {
        if ( i < 0 || i >= Apps.Length ) return;
        var app = Apps[i];
        if ( app.IsTab ) NavManager.GoTo( app.RouteId );
        else NavManager.OpenOverlay( app.RouteId );
    }

    // ── The accent swipe ─────────────────────────────────────────────────
    private void StartSwipe( int i, PhoneApp app )
    {
        // Screen size in STYLE px. Box.Rect is screen space; ScaleFromScreen
        // converts to local style units (at 1080p scale-1 they're identical
        // — the MainMenu precedent — but the liquid circle under-covered on
        // scaled windows, so v2 converts properly and oversizes on top).
        var r = Box.Rect;
        float sc = ScaleFromScreen;
        if ( sc <= 0.01f || float.IsNaN( sc ) || float.IsInfinity( sc ) ) sc = 1f;
        float w = MathF.Max( r.Width * sc, 320f );
        float h = MathF.Max( r.Height * sc, 180f );

        // Oversized slab, centered on the screen: +30% wide / +24% tall, so
        // the skewed leading edge can never expose a corner at full cover.
        _swW = w * 1.30f;
        _swH = h * 1.24f;
        _swLeft = -( _swW - w ) / 2f;
        _swTop = -( _swH - h ) / 2f;

        // Travel offset: fully off the right edge including the skew reach
        // (skewX shifts the vertical edges by tan(deg) × half-height).
        float skewReach = MathF.Tan( MathF.Abs( SwipeSkewDeg ) * MathF.PI / 180f ) * _swH / 2f;
        _swXOff = ( w - _swLeft ) + skewReach + 24f;

        _fxAccent = app.Accent;
        _fxAppIndex = i;
        _fxRouted = false;
        _fxT0 = Time.Now;
        _fx = FxPhase.SweepIn;   // re-seeding mid-flight IS the interrupt path

        // v5.1 launch beat (user call): the tapped icon SHOOTS OUT left,
        // ahead of the incoming slab — grab its panel now (fresh walk;
        // refs die on hotload and re-renders). Per-frame transform inside
        // the lean is a knowing, TRANSIENT violation of the 7fps law:
        // ~13 frames during SweepIn, then the slab covers everything.
        _fxIcon = FocusedIconEl();

        // Seed the first frame immediately so there's no 1-frame pop.
        if ( _swipe != null ) ApplySwipe( _swipe, _swXOff );
        if ( SWEEP_DEBUG ) Log.Info( $"[sweepdbg] SWEEP-IN '{app.Id}' accent={app.Accent} slab={_swW:F0}x{_swH:F0} at=({_swLeft:F0},{_swTop:F0}) xoff={_swXOff:F0} sc={sc:F2} refBound={_swipe != null} t={Time.Now:F3}" );
        StateHasChanged();
    }

    /// <summary>
    /// Per-frame swipe step. Everything is TIME-based (not per-frame lerp)
    /// so the mount-stall a tab swap can cause under cover only skips
    /// frames, never changes the total duration — and the freeze lands
    /// while the screen is a solid accent slab, which is the whole point
    /// of routing at full cover.
    /// </summary>
    private void StepFx()
    {
        if ( _fx == FxPhase.Idle ) return;
        var el = _swipe;
        if ( el == null ) { _fx = FxPhase.Idle; return; }

        if ( _fx == FxPhase.SweepIn )
        {
            float u = Math.Clamp( ( Time.Now - _fxT0 ) / SweepInSeconds, 0f, 1f );
            float e = 1f - MathF.Pow( 1f - u, 3f );   // ease-out cubic — fast attack, soft landing
            ApplySwipe( el, _swXOff * ( 1f - e ) );

            // The launched icon rockets left ahead of the slab. EASE-OUT,
            // not ease-in: the slab sweeps right-to-left and swallows the
            // phone almost immediately, so the icon only reads if it leaps
            // in the first ~100ms (live-verified — the ease-in version was
            // fully covered before it moved).
            if ( _fxIcon != null )
            {
                float li = 1f - ( 1f - u ) * ( 1f - u );
                var lt = new PanelTransform();
                lt.AddTranslate( Length.Pixels( -340f * li ), Length.Pixels( 0f ), Length.Pixels( 0f ) );
                lt.AddScale( 1f + 0.12f * li );
                _fxIcon.Style.Transform = lt;
            }

            if ( u >= 1f )
            {
                // Under full cover: return the icon to rest (unseen) so the
                // grid is intact next open, and stop the per-frame writes.
                if ( _fxIcon != null ) { _fxIcon.Style.Transform = null; _fxIcon = null; }
                if ( !_fxRouted )
                {
                    _fxRouted = true;
                    // Full cover: hide the phone body instantly behind the
                    // slab — no close animation (it would never be seen) and
                    // the modal releases so the destination owns input.
                    IsVisible = false;
                    _closingUntil = 0f;
                    if ( SWEEP_DEBUG ) Log.Info( $"[sweepdbg] ROUTE '{Apps[_fxAppIndex].Id}' at full cover t={Time.Now:F3}" );
                    RouteApp( _fxAppIndex );
                }
                _fx = FxPhase.Covered;
                _fxT0 = Time.Now;
            }
        }
        else if ( _fx == FxPhase.Covered )
        {
            // Held at full cover for a beat — the destination's first-layout
            // frame lands here, invisible behind the slab.
            ApplySwipe( el, 0f );
            if ( Time.Now - _fxT0 >= CoverHoldSeconds )
            {
                if ( SWEEP_DEBUG ) Log.Info( $"[sweepdbg] SWEEP-OUT begins t={Time.Now:F3}" );
                _fx = FxPhase.SweepOut;
                _fxT0 = Time.Now;
            }
        }
        else if ( _fx == FxPhase.SweepOut )
        {
            float v = Math.Clamp( ( Time.Now - _fxT0 ) / SweepOutSeconds, 0f, 1f );
            float e = v * v * v;   // ease-in cubic — the slab accelerates off
            ApplySwipe( el, -_swXOff * e );

            if ( v >= 1f )
            {
                if ( SWEEP_DEBUG ) Log.Info( $"[sweepdbg] DONE — slab cleared, back to Idle t={Time.Now:F3}" );
                _fx = FxPhase.Idle;
                _fxAppIndex = -1;
                ClearSwipeStyles( el );
                StateHasChanged();
            }
        }
    }

    // Re-asserts position + size + transform + opacity EVERY frame
    // (rebuild-proof — the PlaneTween HoldUntil lesson: one-shot style
    // writes get wiped by re-renders; per-frame writes survive anything).
    private void ApplySwipe( Panel el, float x )
    {
        el.Style.Left = Length.Pixels( _swLeft );
        el.Style.Top = Length.Pixels( _swTop );
        el.Style.Width = Length.Pixels( _swW );
        el.Style.Height = Length.Pixels( _swH );
        var t = new PanelTransform();
        t.AddTranslate( Length.Pixels( x ), Length.Pixels( 0f ), Length.Pixels( 0f ) );
        t.AddSkew( SwipeSkewDeg, 0f, 0f );
        el.Style.Transform = t;
        el.Style.Opacity = 1f;
    }

    // Return the slab to its CSS rest state (parked 100×100, opacity 0).
    private void ClearSwipeStyles( Panel el )
    {
        el.Style.Left = null;
        el.Style.Top = null;
        el.Style.Width = null;
        el.Style.Height = null;
        el.Style.Transform = null;
        el.Style.Opacity = null;
    }

    // ── Per-frame — s&box auto-ticks Panel-derived razor components ──────
    public override void Tick()
    {
        base.Tick();
        Instance = this;   // re-asserted every frame — hotload can never strand a stale instance
        DiagTick();        // TEMP dev_phonefocus probe (no-op unless armed)

        // Session-restart sanity (the RoutedThisFrame lesson): statics survive
        // across editor play sessions while Time.Now resets to ~0, so a stale
        // FUTURE _closingUntil from the previous session would hold Shown true
        // (root parked at left: 0) for as long as that session ran. The max
        // legit window is 0.18s — anything further out is stale; clear it.
        if ( _closingUntil > Time.Now + 1f ) _closingUntil = 0f;

        // Leaving the game (back to main menu) force-closes the phone —
        // otherwise the static IsVisible would hold UIModalState.AnyModalOpen
        // true over the menu forever.
        if ( Beastborne.Core.GameManager.Instance?.IsInGame != true )
        {
            if ( IsVisible ) { IsVisible = false; _closingUntil = 0f; }
            if ( _fx != FxPhase.Idle )
            {
                // Abandon the flight AND clear the slab's inline styles —
                // a stale opacity-1 cover would otherwise flash on next open.
                if ( SWEEP_DEBUG ) Log.Info( $"[sweepdbg] ABANDONED — left game mid-sweep t={Time.Now:F3}" );
                _fx = FxPhase.Idle;
                _fxAppIndex = -1;
                if ( _swipe != null ) ClearSwipeStyles( _swipe );
                if ( _fxIcon != null ) { _fxIcon.Style.Transform = null; _fxIcon = null; }
            }
            return;
        }

        StepFx();

        if ( !IsVisible ) return;

        // rev-7 in-phone apps: bloom arm / reverse-bloom landing / press stamp /
        // 1 Hz tick / per-app upkeep (comparisons only — no style writes).
        TickApps();

        // One-shot avatar-source diagnostic (v4 — see field comment).
        if ( !_avaLogged )
        {
            _avaLogged = true;
            var sid = GetSteamId();
            Log.Info( $"[pawpad] avatar src = '{( sid > 0 ? $"avatar:{sid}" : GetAvatarImagePath() )}' (steamId={sid}, ref-in-dom={_ringRef != null})" );
        }

        // The living ring — rect math stays EVENT-DRIVEN (open/focus/
        // entrance-hold), but the WAVE runs per frame now that the ring is
        // outside the leaned subtree (v4.2 — imperative transform only,
        // no re-render). Sign-checked hold: Time.Now resets per session
        // while this instance's field can survive hotload.
        float holdDt = _ringHoldUntil - Time.Now;
        if ( holdDt > 1f ) _ringHoldUntil = 0f;            // stale stamp from a prior session
        else if ( holdDt > 0f ) _ringDirty = true;         // entrance slide still moving the icons
        if ( _ringDirty ) UpdateRing();
        ApplyRingWave();
        if ( WALK_DEBUG && ( Input.Pressed( "Backward" ) || Input.Pressed( "Forward" ) ) )
            Log.Info( $"[walkdbg] tick gate: top={UIModalState.IsTopModal( "PhoneLauncher" )} chatfocus={ChatPanel.IsChatFocused}" );
        if ( !UIModalState.IsTopModal( "PhoneLauncher" ) ) return;

        // 2026-08-30: Esc while TYPING in the phone's chat input blurs back to
        // the phone (the text stays) — it must not back out of the app. Polled
        // here because the TextEntry owns the keys while focused; ChatInputBox
        // also listens for the entry's own cancel event (belt and braces —
        // VERIFY LIVE which path fires; either one stamps the same-frame latch).
        if ( ChatPanel.IsChatFocused && _appView == "chat" && Input.Pressed( "Escape" ) ) { BlurPhoneInput(); return; }

        // v7.2 mouse hover — per-frame poll + inverse projection (pure
        // math + rect walks; NO style writes, so the 7fps law is safe).
        // Replaces the tiles' own onmouseover, which never fired (layout
        // hit rects sit off the paint under the lean).
        // LAST-INPUT-WINS (the Beasts-tab house pattern, user call):
        // hover only reasserts when the mouse actually MOVES, so keyboard
        // navigation isn't snapped back to the hovered tile every frame.
        // 2026-08-30: in an APP VIEW the same poll resolves the pl-hit under
        // the mouse (ActionAtScreen — the click router's walk, only on
        // movement) → `_hoverHit` (.hovered stamp) and moves the one cursor.
        // Runs even while typing so SEND/rows still light under the mouse.
        // 2026-09-01: 3px travel (the My Beasts synthetic-move guard's figure) —
        // KbTakeover() re-stamps _lastMousePos on every keyboard cursor move, so a
        // parked mouse must REALLY travel to win the cursor back.
        var mp = Mouse.Position;
        bool mouseMoved = ( mp - _lastMousePos ).Length > 3f;
        if ( mouseMoved ) _lastMousePos = mp;
        if ( _appView != null && mouseMoved ) PollAppHover( mp );

        if ( ChatPanel.IsChatFocused ) return;

        if ( _appView == null && mouseMoved )
        {
            int hover = TileAtScreen( mp );
            if ( hover >= 0 && hover != _kb )
            {
                _kb = hover;
                _ringDirty = true;
                SoundManager.PlayHover();
            }
        }

        HandleKeyboard();
    }

    // Diagnostics — mouse router blessed 2026-07-02; re-enable only for
    // backdrop click-routing forensics.
    private const bool WALK_DEBUG = false;

    private void HandleKeyboard()
    {
        if ( WALK_DEBUG && ( Input.Pressed( "Forward" ) || Input.Pressed( "Backward" ) || Input.Pressed( "Left" ) || Input.Pressed( "Right" ) ) )
            Log.Info( $"[walkdbg] press F={Input.Pressed( "Forward" )} B={Input.Pressed( "Backward" )} L={Input.Pressed( "Left" )} R={Input.Pressed( "Right" )} kb={_kb} routed={NavManager.RoutedThisFrame}" );
        // Same-frame double-fire guard: Input.Pressed is edge-triggered and
        // reports true to EVERY handler this frame. The Slot8 press that just
        // OPENED the phone (via GameHUD → NavManager) must not also be read
        // here as "close"; ditto any direct-route key GameHUD handled.
        if ( NavManager.RoutedThisFrame ) return;

        // v9: while typing in an in-phone input, the phone keys stand down
        // (ChatPanel.IsChatFocused already gates in Tick for the popup;
        // this covers the phone's own ChatInputBox).
        if ( _appView != null )
        {
            // The Esc that just BLURRED the chat input is still edge-true this
            // frame — it must not also read as "back" (the RoutedThisFrame lesson).
            if ( Time.Now - ChatInputBox.LastBlurAt < 0.05f ) return;
            // 2026-09-01 (usability audit): M ("Phone" — the key that OPENED the
            // phone) and 8 close it from ANY depth, reverse bloom included. Only
            // Slot8 was read before, so M did nothing inside the phone — the
            // "true toggle" never worked with the key the player actually uses.
            // MarkRouted: GameHUD's modal gate releases the frame IsVisible drops,
            // and it must not re-open the phone on this same edge.
            if ( Input.Pressed( "Phone" ) || Input.Pressed( "Slot8" ) ) { Close(); NavManager.MarkRouted(); return; }
            if ( _appClosingUntil > 0f )
            {
                // Reverse bloom in flight (360ms): a second Q/Esc inside it means
                // "get out" — close the phone instead of swallowing the press.
                if ( Input.Pressed( "Menu" ) || Input.Pressed( "Escape" ) ) { Close(); NavManager.MarkRouted(); }
                return;
            }
            if ( Input.Pressed( "Menu" ) || Input.Pressed( "Escape" ) ) { CloseApp(); return; }
            HandleAppKeys();
            return; // app views own the rest of the keys (input typing etc.)
        }

        // Close — Q ("Menu"), Escape, M ("Phone" — the opener: true toggle) or 8.
        if ( Input.Pressed( "Menu" ) || Input.Pressed( "Escape" ) || Input.Pressed( "Phone" ) || Input.Pressed( "Slot8" ) )
        {
            Close();
            NavManager.MarkRouted(); // same-frame re-open / tab-nav guard for GameHUD (see above)
            return;
        }

        // Direct-route keys — number keys + the widget letters, same map as
        // the command bar so muscle memory transfers 1:1.
        if ( Input.Pressed( "Slot1" ) ) { LaunchIndex( 0 ); return; }
        if ( Input.Pressed( "Slot2" ) ) { LaunchIndex( 1 ); return; }
        if ( Input.Pressed( "Slot3" ) ) { LaunchIndex( 2 ); return; }
        if ( Input.Pressed( "Slot4" ) ) { LaunchIndex( 3 ); return; }
        if ( Input.Pressed( "Slot5" ) ) { LaunchIndex( 4 ); return; }
        if ( Input.Pressed( "Slot6" ) ) { LaunchIndex( 5 ); return; }
        if ( Input.Pressed( "Slot7" ) ) { LaunchIndex( 6 ); return; }
        if ( Input.Pressed( "Slot9" ) ) { LaunchIndex( 7 ); return; }
        if ( Input.Pressed( "Chat" ) ) { LaunchIndex( 8 ); return; }
        if ( Input.Pressed( "Reload" ) ) { LaunchIndex( 9 ); return; }
        if ( Input.Pressed( "View" ) ) { LaunchIndex( 10 ); return; }
        if ( Input.Pressed( "Notifications" ) ) { LaunchIndex( 11 ); return; }
        if ( Input.Pressed( "Slot0" ) ) { LaunchIndex( GridCount ); return; } // 0 = Profile (old-bar muscle memory)

        // Grid + dock walk — WASD, wrapping both axes. The dock is a 5th
        // row with 4 columns; horizontal wraps stay within the row you're
        // on, vertical crossings map columns proportionally (3-wide grid ↔
        // 4-wide dock).
        bool onDock = _kb >= GridCount;
        int next = -1;
        if ( Input.Pressed( "Left" ) )
        {
            next = onDock
                ? GridCount + ( ( _kb - GridCount + DockCount - 1 ) % DockCount )
                : ( _kb / Cols ) * Cols + ( ( _kb % Cols + Cols - 1 ) % Cols );
        }
        else if ( Input.Pressed( "Right" ) )
        {
            next = onDock
                ? GridCount + ( ( _kb - GridCount + 1 ) % DockCount )
                : ( _kb / Cols ) * Cols + ( ( _kb % Cols + 1 ) % Cols );
        }
        else if ( Input.Pressed( "Forward" ) ) // up
        {
            if ( onDock ) next = ( Rows - 1 ) * Cols + DockColToGridCol( _kb - GridCount );
            else if ( _kb / Cols == 0 ) next = GridCount + GridColToDockCol( _kb % Cols ); // wrap up → dock
            else next = _kb - Cols;
        }
        else if ( Input.Pressed( "Backward" ) ) // down
        {
            if ( onDock ) next = GridColToGridIndexRow0( _kb - GridCount ); // wrap down → grid top
            else if ( _kb / Cols == Rows - 1 ) next = GridCount + GridColToDockCol( _kb % Cols );
            else next = _kb + Cols;
        }

        if ( next >= 0 )
        {
            if ( WALK_DEBUG ) Log.Info( $"[walkdbg] moved {_kb} -> {next}" );
            _kb = next;
            _ringDirty = true;
            KbTakeover();
            SoundManager.PlayHover();
            return;
        }

        // Column mapping between the 3-wide grid and 4-wide dock: keep the
        // crossing feeling straight-down/straight-up (proportional, rounded).
        static int GridColToDockCol( int c ) => c switch { 0 => 0, 1 => 2, _ => 3 };
        static int DockColToGridCol( int d ) => d switch { 0 => 0, 1 => 1, 2 => 1, _ => 2 };
        static int GridColToGridIndexRow0( int d ) => DockColToGridCol( d );

        // Launch — Space (advertised) · Enter / E silent twins (UiInput house pair;
        // E was missing here, 2026-09-01).
        if ( UiInput.ConfirmPressed() )
        {
            LaunchIndex( _kb );
        }
    }

    // ═══ KEYBOARD CURSOR + MOUSE HOVER for the in-phone apps (2026-08-30) ═══
    // House grammar: WASD move · Space confirm (E silent twin, Enter too) · Q
    // back · R cycle · Z/X pair · last-input-wins ONE cursor.
    //
    // `_appKb` holds the ACTION STRING of the focused stop, not an index — a
    // chat message arriving must not shove the cursor off the input stop, and
    // an alert clearing must not re-target by number. Stops are rebuilt at
    // RENDER time from the very lists the view draws (RebuildStops in each
    // app's razor block), so DOM order == walk order by construction.
    //
    // VISUAL = the hashed `.kb-focused` class stamp on the pl-hit element,
    // NOT the living ring. The ring lives at ROOT level, outside the scroll
    // clip: on a half-visible row it would overhang the header/input row (the
    // documented scroll-leak class), and the five control silhouettes (row /
    // pill / circle / segment / slab) can't share one fixed-radius ring. The
    // stamp needs zero geometry and zero per-frame writes (7fps law) and stays
    // correct through scrolling. It reads as a 2px violet SPREAD ring (hard-
    // edged, the flat-panel cousin of the ring — "violet is the cursor") plus
    // one slab step; the scss carries the recipe.
    //
    // `_hoverHit` = the pl-hit under the mouse (hashed → `.hovered`); a hover
    // also MOVES the cursor (last-input-wins). Polled only on mouse movement
    // (>2px) through the click router's own walk — no per-frame cost at rest.
    private string _appKb;
    private string _hoverHit;
    private readonly List<string> _stops = new();
    private int _kbScrollPending;

    // The three router-stamped states, joined for the class attribute.
    private string HitState( string act )
    {
        if ( act == null ) return "";
        bool p = _pressedHit == act, h = _hoverHit == act, k = _appKb == act;
        if ( !p && !h && !k ) return "";
        return ( p ? "pressed " : "" ) + ( h ? "hovered " : "" ) + ( k ? "kb-focused" : "" );
    }

    // Stop lists — DOM order. chat: every message then the input; radio: the
    // transport row, the station chip, the five volume segments.
    private void RebuildStops( string app, int count )
    {
        _stops.Clear();
        switch ( app )
        {
            case "chat":
                for ( int i = 0; i < count; i++ ) _stops.Add( "hit-msg-" + i );
                _stops.Add( "hit-input" );
                break;
            case "radio":
                _stops.Add( "hit-radio-shuffle" );
                _stops.Add( "hit-radio-prev" );
                _stops.Add( "hit-radio-play" );
                _stops.Add( "hit-radio-next" );
                _stops.Add( "hit-radio-repeat" );
                _stops.Add( "hit-radio-station" );
                for ( int k = 1; k <= 5; k++ ) _stops.Add( "hit-vol-" + k );
                break;
        }
        SettleCursor( app );
    }

    private void RebuildEffectsStops( int boosts, int skills )
    {
        _stops.Clear();
        for ( int i = 0; i < boosts; i++ ) _stops.Add( "hit-fx-" + i );
        for ( int i = 0; i < skills; i++ ) _stops.Add( "hit-sk-" + i );
        SettleCursor( "effects" );
    }

    private void RebuildAlertStops( int alerts, bool clearVisible )
    {
        _stops.Clear();
        for ( int i = 0; i < alerts; i++ ) _stops.Add( "hit-alert-" + i );
        if ( clearVisible ) _stops.Add( "hit-clear" );
        SettleCursor( "alerts" );
    }

    // Landing per app: chat = the input (you open chat to type), radio = PLAY
    // (the hero — Space lands there), lists = the top row. Re-settles whenever
    // the focused stop vanishes (alert cleared, boost expired).
    private void SettleCursor( string app )
    {
        if ( _appKb != null && _stops.Contains( _appKb ) ) return;
        _appKb = _stops.Count == 0 ? null : app switch { "chat" => "hit-input", "radio" => "hit-radio-play", _ => _stops[0] };
    }

    // Which stop a hovered hit belongs to — the author name / embed inside a
    // message map to the message; chrome (back, channels, SEND) moves nothing.
    private string StopOf( string act )
    {
        if ( act == null ) return null;
        if ( act.StartsWith( "hit-chat-author-" ) || act.StartsWith( "hit-embed-" ) ) act = "hit-msg-" + HitIndex( act );
        return _stops.Contains( act ) ? act : null;
    }

    // A message's action: the showcase embed, else the author's tamer card, else none.
    private string MsgActionOf( int idx )
    {
        var msgs = PhoneMessages();
        if ( idx < 0 || idx >= msgs.Count ) return null;
        var m = msgs[idx];
        if ( m.Type == Beastborne.Data.ChatMessageType.BeastShowcase || m.Type == Beastborne.Data.ChatMessageType.TamerCardShowcase ) return "hit-embed-" + idx;
        if ( !IsOwnPhoneMsg( m ) && HasCardFor( m.SteamId ) ) return "hit-chat-author-" + idx;
        return null;
    }

    // W/S on a list — clamped, no wrap (a reading list that jumps from the
    // newest message to the oldest is disorienting); the edge is silent.
    private void WalkStops( int dir )
    {
        if ( _stops.Count == 0 ) return;
        int idx = _appKb == null ? -1 : _stops.IndexOf( _appKb );
        int next = idx < 0 ? ( dir > 0 ? 0 : _stops.Count - 1 ) : Math.Clamp( idx + dir, 0, _stops.Count - 1 );
        if ( next == idx ) return;
        _appKb = _stops[next];
        _kbScrollPending = 2;
        KbTakeover();
        SoundManager.PlayHover();
        StateHasChanged();
    }

    // Keyboard takeover (2026-09-01, the My Beasts travel-guard law adapted to a
    // polled router): the `.hovered` stamp under a PARKED mouse is dropped the
    // moment a key moves the cursor — otherwise the parked row stayed lit beside
    // the cursor row (two highlights, the kb/mouse style fight). The mouse only
    // reclaims the cursor after REAL travel (> 3px from where it sat at
    // takeover); the hover poll is movement-gated, so a re-render under the
    // parked cursor can never re-stamp it by itself.
    private void KbTakeover()
    {
        _lastMousePos = Mouse.Position;
        if ( _hoverHit == null ) return;
        _hoverHit = null;
        StateHasChanged();
    }

    // The focused row rides into the scroller's viewport (rect px and scroll
    // px are commensurate — the scrollbar recipe's proven ratio). Stops that
    // live OUTSIDE the scroller (CLEAR ALL, the input) need no scroll.
    private void ScrollFocusedIntoView()
    {
        var sc = ActiveScroller();
        if ( sc == null || _appKb == null ) return;
        Panel row = null, firstHit = null, lastHit = null;
        foreach ( var c in sc.Children )
        {
            if ( !c.HasClass( "pl-hit" ) ) continue;
            firstHit ??= c;
            lastHit = c;
            if ( c.HasClass( _appKb ) ) row = c;
        }
        if ( row == null ) return;
        var sr = sc.Box.Rect;
        var rr = row.Box.Rect;
        if ( sr.Height < 1f || rr.Height < 1f ) return;
        // Endpoint semantics (DOC-5 §13, 2026-09-01): the FIRST row scrolls the
        // list fully to the top so its section header ("TIMED BOOSTS" / "TODAY")
        // is in view; the LAST row lands fully at the bottom. Rows between ride
        // in with an 8px pad.
        float target;
        if ( ReferenceEquals( row, firstHit ) ) target = 0f;
        else if ( ReferenceEquals( row, lastHit ) ) target = sc.ScrollSize.y;
        else
        {
            const float pad = 8f;
            float dy = 0f;
            if ( rr.Top < sr.Top + pad ) dy = rr.Top - ( sr.Top + pad );
            else if ( rr.Bottom > sr.Bottom - pad ) dy = rr.Bottom - ( sr.Bottom - pad );
            if ( MathF.Abs( dy ) < 0.5f ) return;
            target = MathF.Max( 0f, sc.ScrollOffset.y + dy );
        }
        if ( MathF.Abs( target - sc.ScrollOffset.y ) < 0.5f ) return;
        sc.ScrollOffset = new Vector2( 0f, target );
        ArmScrollbar();
    }

    // Mouse over an app view (movement-gated from Tick).
    private void PollAppHover( Vector2 mp )
    {
        if ( _appClosingUntil > 0f ) return;
        var act = ActionAtScreen( mp );
        if ( act == _hoverHit ) return;
        _hoverHit = act;
        if ( act != null )
        {
            SoundManager.PlayHover();
            var stop = StopOf( act );
            if ( stop != null ) _appKb = stop; // last-input-wins: the mouse moves the one cursor
        }
        StateHasChanged();
    }

    // Keyboard, per app (Q/Esc/Slot8 are handled by the caller).
    private void HandleAppKeys()
    {
        bool up = Input.Pressed( "Forward" ), down = Input.Pressed( "Backward" );
        bool left = Input.Pressed( "Left" ), right = Input.Pressed( "Right" );
        bool confirm = Input.Pressed( "Jump" ) || Input.Pressed( "Enter" ) || Input.Pressed( "Use" );
        bool cycle = Input.Pressed( "Reload" );

        // 2026-09-01 (usability audit): the grid's direct keys were DEAD inside an
        // app — leaving RADIO for ALERTS was Q, wait 360ms, N. Now T/C/N hop
        // between apps in place (OpenApp's `switching` cross-fade, the proven
        // alerts→effects path) and 1-7/9 swipe straight to their destination
        // (the slab covers the phone; the next Show() lands on the grid). R is
        // NOT a hop: it is the radio's tune key and the alerts' CLEAR ALL jump.
        if ( Input.Pressed( "Chat" ) )
        {
            if ( _appView != "chat" ) { OpenApp( "chat" ); return; }
            _appKb = "hit-input"; RunAppAction( "hit-input" ); return; // T in chat = talk
        }
        if ( Input.Pressed( "View" ) && _appView != "effects" ) { OpenApp( "effects" ); return; }
        if ( Input.Pressed( "Notifications" ) && _appView != "alerts" ) { OpenApp( "alerts" ); return; }
        int direct = Input.Pressed( "Slot1" ) ? 0 : Input.Pressed( "Slot2" ) ? 1 : Input.Pressed( "Slot3" ) ? 2
                   : Input.Pressed( "Slot4" ) ? 3 : Input.Pressed( "Slot5" ) ? 4 : Input.Pressed( "Slot6" ) ? 5
                   : Input.Pressed( "Slot7" ) ? 6 : Input.Pressed( "Slot9" ) ? 7 : -1;
        if ( direct >= 0 ) { _kb = direct; SoundManager.PlayForward(); StartSwipe( direct, Apps[direct] ); return; }

        switch ( _appView )
        {
            case "chat":
                // Typing is ONE press away: the input is the landing stop, and
                // ENTER from ANYWHERE in chat focuses it (the Enter twin). A/D
                // channel · W climbs into the log newest-first, S walks back down
                // to the input · Space/E = the row's tap (embed / author card) or,
                // on the input stop, start typing.
                if ( Input.Pressed( "Enter" ) ) { _appKb = "hit-input"; RunAppAction( "hit-input" ); return; }
                if ( left || right ) { CycleChannel( right ? 1 : -1 ); return; }
                if ( up || down ) { WalkStops( up ? -1 : 1 ); return; }
                if ( confirm && _appKb != null ) { RunAppAction( _appKb ); return; }
                break;
            case "radio":
                // Polish pass 2026-08-30 (user: "I should be able to go through
                // ALL of the buttons"): the cursor walks a 3-row GRID — station /
                // transport / volume — A/D within a row, W/S between rows (column-
                // mapped). Space/Enter taps the focused control (a volume segment
                // COMMITS that level — A/D on the row only move). The direct keys
                // R tune · Z shuffle · X repeat fire without moving the cursor;
                // "A/D = skip" and "W/S = volume" are RETIRED (they hijacked the
                // cursor).
                if ( confirm ) { RunAppAction( _appKb ?? "hit-radio-play" ); return; }
                if ( left || right ) { MoveRadioCursor( 0, right ? 1 : -1 ); return; }
                if ( up || down ) { MoveRadioCursor( up ? -1 : 1, 0 ); return; }
                if ( cycle ) { RunAppAction( "hit-radio-station" ); return; }
                if ( Input.Pressed( "CyclePrev" ) ) { RunAppAction( "hit-radio-shuffle" ); return; }
                if ( Input.Pressed( "CycleNext" ) ) { RunAppAction( "hit-radio-repeat" ); return; }
                break;
            case "effects":
                // Reading stops only — Space is a no-op by design.
                if ( up || down ) { WalkStops( up ? -1 : 1 ); return; }
                break;
            case "alerts":
                // W/S rows → CLEAR ALL · Space = the tap (deep-link / two-tap clear)
                // · R jumps the cursor to CLEAR ALL (then Space, Space).
                if ( up || down ) { WalkStops( up ? -1 : 1 ); return; }
                if ( confirm && _appKb != null ) { RunAppAction( _appKb ); return; }
                if ( cycle && _stops.Contains( "hit-clear" ) )
                {
                    if ( _appKb != "hit-clear" ) { _appKb = "hit-clear"; KbTakeover(); SoundManager.PlayHover(); StateHasChanged(); }
                    return;
                }
                break;
        }
    }

    // ── The radio cursor GRID — row 0 = station chip · row 1 = transport ·
    // row 2 = volume. A/D move within a row (clamped, silent at the ends like
    // every list); W/S move between rows column-mapped: transport col i ↔
    // volume seg i+1 (PLAY ↔ seg 3), station ↔ PLAY. ──
    private static readonly string[][] RadioGrid =
    {
        new[] { "hit-radio-station" },
        new[] { "hit-radio-shuffle", "hit-radio-prev", "hit-radio-play", "hit-radio-next", "hit-radio-repeat" },
        new[] { "hit-vol-1", "hit-vol-2", "hit-vol-3", "hit-vol-4", "hit-vol-5" },
    };

    private void MoveRadioCursor( int dr, int dc )
    {
        int r = 1, c = 2; // PLAY is home
        for ( int i = 0; i < RadioGrid.Length; i++ )
        {
            int j = Array.IndexOf( RadioGrid[i], _appKb );
            if ( j >= 0 ) { r = i; c = j; break; }
        }
        int nr = Math.Clamp( r + dr, 0, RadioGrid.Length - 1 );
        int nc;
        if ( dr != 0 )
        {
            if ( nr == 0 ) nc = 0;                 // up into the station chip
            else if ( r == 0 ) nc = 2;             // down from the chip lands on PLAY
            else nc = Math.Clamp( c, 0, RadioGrid[nr].Length - 1 ); // transport ↔ volume share columns
        }
        else nc = Math.Clamp( c + dc, 0, RadioGrid[nr].Length - 1 );
        var next = RadioGrid[nr][nc];
        if ( next == _appKb ) return;
        _appKb = next;
        KbTakeover();
        SoundManager.PlayHover();
        StateHasChanged();
    }

    private void CycleChannel( int dir )
    {
        string next = _phoneChan switch
        {
            "global" => dir > 0 ? "guild" : "trade",
            "guild" => dir > 0 ? "trade" : "global",
            _ => dir > 0 ? "global" : "guild",
        };
        RunAppAction( "hit-chan-" + next ); // the tap path — press stamp on the pill, scroll to newest
    }

    // Takes the keyboard back from the phone's TextEntry. Safe when nothing is focused.
    private void BlurPhoneInput()
    {
        if ( _phoneChatBox == null ) return;
        _phoneChatBox.BlurInput();
    }


    // v7.5: consume the mouse wheel while the phone is open — wheel events
    // fell through to the scrollable panel behind it (user report). The
    // backdrop catches the wheel, it bubbles here; NOT calling base eats it.
    public override void OnMouseWheel( Vector2 delta )
    {
        if ( _diagUntil > 0f && Time.Now < _diagUntil )
        {
            _diagWheel++;
            var sc = ActiveScroller();
            Log.Info( $"[phonefocus] WHEEL dy={delta.y:F1} vis={IsVisible} app={_appView ?? "-"} scroller={( sc == null ? "null" : $"{sc.ScrollOffset.y:F0}/{sc.ScrollSize.y:F0} h={sc.Box.Rect.Height:F0}" )}" );
        }
        if ( IsVisible || _fx != FxPhase.Idle )
        {
            // v9: in-phone scrollables still scroll — routed to the ACTIVE app's
            // scroller (2026-08-29 fix: only chat's list was wired before, so the
            // EFFECTS / ALERTS lists could not wheel at all).
            if ( _appView != null )
            {
                var sref = ActiveScroller(); // radio → null (a stale _listScrollRef from the previous app must not take the wheel)
                if ( sref != null ) { sref.ScrollOffset += new Vector2( 0f, delta.y * 40f ); ArmScrollbar(); }
            }
            return; // consumed either way
        }
        base.OnMouseWheel( delta );
    }

    protected override int BuildHash()
    {
        return HashCode.Combine(
            HashCode.Combine( IsVisible, Shown, (int)_fx, _kb, _fxAccent, GetSteamId() ),
            HashCode.Combine(
                GetBadgeCount( "quests" ),
                GetBadgeCount( "chat" ),
                GetBadgeCount( "effects" ),
                GetBadgeCount( "alerts" ),
                HasNewItems(),
                ClockText ),
            // The living ring's markup-driven geometry — without these the
            // panel never repaints a focus glide (missing-BuildHash trap).
            HashCode.Combine( _ringL, _ringT, _ringW, _ringH, _ringWarmup ),
            // v9 in-phone apps: view + channel + live data the views render.
            // v10: + the alert record's count so the ALERTS list re-renders
            // as history arrives/clears.
            HashCode.Combine(
                _appView,
                _phoneChan,
                Beastborne.Core.ChatManager.Instance?.Messages?.Count ?? 0,
                Beastborne.Systems.RadioManager.IsPlaying,
                Beastborne.Systems.RadioManager.CurrentTrackIndex,
                NotificationPanel.UnreadCount,
                Beastborne.Core.NotificationManager.Instance?.NotificationHistory?.Count ?? 0 ),
            // rev-7 apps (2026-08-29): bloom + press stamp + the 1 Hz tick + per-app state.
            HashCode.Combine( _bloomApp, _bloomLive, _appClosingUntil > 0f, _pressedHit, _bloomCircleGrow, _bloomCircleFade, HashCode.Combine( _bloomCx, _bloomCy ), _appUiOn ),
            HashCode.Combine(
                ( _appView is "radio" or "effects" or "alerts" ) ? _tick : 0,
                _trackKey, _volKey, VolLadderActive(),
                Beastborne.Systems.RadioManager.IsShuffle,
                Beastborne.Systems.RadioManager.IsRepeat,
                Beastborne.Systems.RadioManager.CurrentStationIndex,
                _progFillPx ),
            // + the one cursor and the hovered hit (2026-08-30; both are class stamps) — HashCode.Combine caps at 8 args.
            HashCode.Combine( _appView == "chat" ? ChanCounts() : default, _seenGlobal, _seenGuild, _seenTrade, ChatPanel.IsChatFocused, _appKb, _hoverHit ),
            HashCode.Combine( ClearArmed, _clearingAt > 0f, _readIds.Count, _fxExpired.Count, ActiveEffectsPanel.TotalEffectCount, _alertsSeenBefore, _sbOn ) );
    }
}
