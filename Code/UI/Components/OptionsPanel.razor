@namespace Beastborne.UI.Components
@using System.Collections.Generic
@using Sandbox;
@using Sandbox.UI;
@using Beastborne.Core;
@using Beastborne.Data;
@using Beastborne.Systems;
@using Beastborne.UI;
@inherits Panel

<root class="options-container @(IsVisible ? "visible" : "")">

	@* Reset the per-render toggle-row counter so RenderToggleRow can assign
	   each row a stable index for the keyboard `.kb-active` highlight. *@
	@{ _toggleRowCounter = 0; }

	@* Dimming overlay — click anywhere outside to close *@
	<div class="options-overlay" onclick=@Close></div>

	@* Center modal — large, scales-in from center origin *@
	<div class="options-modal">

		@* No ambient bg pattern: modal bg is near-opaque (0.985 alpha) so any
		   pattern at the tasteful 5-8% opacity range is masked, and higher
		   opacity competes with the per-section colored diamonds that carry
		   the visual identity. *@

		@* Top accent line — 2px gradient bar (matches MenuPopup) *@
		<div class="modal-top-line"></div>

		@* Header — title icon + title left, close button right *@
		<div class="modal-header">
			<div class="header-left">
				<div class="header-icon-frame">
					<iconify icon="lucide:settings" Size=@(18) Color="#a78bfa" />
				</div>
				<div class="header-text">
					<span class="header-title">@L("ui.options.title")</span>
					<span class="header-subtitle">PREFERENCES · CONTROLS</span>
				</div>
			</div>
			<div class="header-right">
				<button class="reset-chip"
						onclick=@OnResetClicked
						onmouseover=@(() => OnHover("reset-defaults"))>
					<iconify icon="lucide:rotate-ccw" Size=@(12) Color="#c4b5fd" />
					<span>@L("ui.options.reset_defaults")</span>
				</button>
				<button class="close-btn"
						onclick=@Close
						onmouseover=@(() => OnHover("close"))>
					<iconify icon="lucide:x" Size=@(15) Color="rgba(255, 255, 255, 0.85)" />
				</button>
			</div>
		</div>

		@* Scrollable settings content — sectioned *@
		<div class="modal-scroll-wrap">
			<div class="modal-content">

				@* ──────── GAMEPLAY ──────── *@
				<div class="settings-section section-gameplay">
					<div class="section-header">
						<div class="section-icon-frame tone-gold">
							<iconify icon="lucide:gamepad-2" Size=@(15) Color="#fbbf24" />
						</div>
						<span class="section-title">GAMEPLAY</span>
						<div class="section-rule"></div>
					</div>
					<div class="section-rows">

						@RenderToggleRow(
							"lucide:fast-forward",
							L("ui.options.skip_animations"),
							"Battles play in fast-forward, skipping ability animations.",
							GetSkipAnimations(),
							ToggleSkipAnimations,
							"skip-anims")

						@RenderToggleRow(
							"lucide:badge-check",
							L("ui.options.level_up_notifications"),
							"Show a popup when one of your beasts levels up.",
							GetShowLevelUpNotifications(),
							ToggleShowLevelUpNotifications,
							"levelup-notif")

						@RenderToggleRow(
							"lucide:sparkle",
							L("ui.options.discovery_alerts"),
							"Notify me when I encounter or unlock something new.",
							GetShowDiscoveryAlerts(),
							ToggleShowDiscoveryAlerts,
							"discovery-alerts")

						@* Replay tutorial — fires the 14-step walkthrough fresh. *@
						<div class="setting-row" onmouseover=@(() => OnHover("replay-tutorial"))>
							<div class="setting-icon-frame">
								<iconify icon="lucide:graduation-cap" Size=@(14) Color="rgba(255, 255, 255, 0.65)" />
							</div>
							<div class="setting-text">
								<span class="setting-label">Replay Tutorial</span>
								<span class="setting-desc">Walk through the first expedition and contract again.</span>
							</div>
							<button class="reset-chip" onclick=@OnReplayTutorialClicked>
								<iconify icon="lucide:rotate-ccw" Size=@(12) Color="#c4b5fd" />
								<span>Replay</span>
							</button>
						</div>

					</div>
				</div>

				@* ──────── DISPLAY ──────── *@
				<div class="settings-section section-display">
					<div class="section-header">
						<div class="section-icon-frame tone-sky">
							<iconify icon="lucide:monitor" Size=@(15) Color="#7dd3fc" />
						</div>
						<span class="section-title">DISPLAY</span>
						<div class="section-rule"></div>
					</div>
					<div class="section-rows">

						@RenderToggleRow(
							"lucide:hash",
							L("ui.options.damage_numbers"),
							"Show floating damage numbers during combat.",
							GetShowDamageNumbers(),
							ToggleShowDamageNumbers,
							"damage-numbers")

						@RenderToggleRow(
							"lucide:flame",
							L("ui.options.type_effectiveness"),
							"Show super-effective and resist hints in battle.",
							GetShowTypeEffectiveness(),
							ToggleShowTypeEffectiveness,
							"type-effectiveness")

						@RenderToggleRow(
							"lucide:dna",
							L("ui.options.genetics_cards"),
							"Display IV genetics on monster roster cards.",
							GetShowGeneticsOnCards(),
							ToggleShowGeneticsOnCards,
							"genetics-cards")

						@RenderToggleRow(
							"lucide:bar-chart-3",
							L("ui.options.power_ratings"),
							"Show numeric power ratings on monster cards.",
							GetShowPowerRatings(),
							ToggleShowPowerRatings,
							"power-ratings")
					</div>
				</div>

				@* ──────── CONFIRMATIONS ──────── *@
				<div class="settings-section section-confirm">
					<div class="section-header">
						<div class="section-icon-frame tone-rose">
							<iconify icon="lucide:shield-check" Size=@(15) Color="#fb7185" />
						</div>
						<span class="section-title">CONFIRMATIONS</span>
						<div class="section-rule"></div>
					</div>
					<div class="section-rows">

						@RenderToggleRow(
							"lucide:circle-x",
							L("ui.options.confirm_release"),
							"Show a confirmation popup before releasing a beast.",
							GetConfirmBeforeRelease(),
							ToggleConfirmBeforeRelease,
							"confirm-release")

						@RenderToggleRow(
							"lucide:git-merge",
							L("ui.options.confirm_fusion"),
							"Show a confirmation popup before fusing two beasts.",
							GetConfirmBeforeFusion(),
							ToggleConfirmBeforeFusion,
							"confirm-fusion")

					</div>
				</div>

				@* ──────── ACCESSIBILITY (planned features — disabled UI) ──────── *@
				<div class="settings-section section-access">
					<div class="section-header">
						<div class="section-icon-frame tone-green">
							<iconify icon="lucide:accessibility" Size=@(15) Color="#86efac" />
						</div>
						<span class="section-title">ACCESSIBILITY</span>
						<div class="section-rule"></div>
					</div>
					<div class="section-rows">

						@RenderDisabledRow(
							"lucide:type",
							L("ui.options.larger_text"),
							"Increase the size of UI text where supported.")

						@RenderDisabledRow(
							"lucide:contrast",
							L("ui.options.high_contrast"),
							"Boost contrast for better readability.")
					</div>
				</div>

				@* ──────── LANGUAGE ──────── *@
				<div class="settings-section section-lang">
					<div class="section-header">
						<div class="section-icon-frame tone-purple">
							<iconify icon="lucide:globe" Size=@(15) Color="#c4b5fd" />
						</div>
						<span class="section-title">LANGUAGE</span>
						<div class="section-rule"></div>
					</div>
					<div class="section-rows">
						<div class="lang-row">
							<button class="lang-card @(LocalizationManager.CurrentLanguage == "en" ? "active" : "")"
									onclick=@(() => ChangeLanguage("en"))
									onmouseover=@(() => OnHover("lang-en"))>
								<iconify class="lang-flag" icon="circle-flags:gb" Size=@(28) Color="white" />
								<div class="lang-meta">
									<span class="lang-name">English</span>
									<span class="lang-code">EN</span>
								</div>
								@if (LocalizationManager.CurrentLanguage == "en")
								{
									<iconify class="lang-check" icon="lucide:check" Size=@(14) Color="#a78bfa" />
								}
							</button>
							<button class="lang-card @(LocalizationManager.CurrentLanguage == "fr" ? "active" : "")"
									onclick=@(() => ChangeLanguage("fr"))
									onmouseover=@(() => OnHover("lang-fr"))>
								<iconify class="lang-flag" icon="circle-flags:fr" Size=@(28) Color="white" />
								<div class="lang-meta">
									<span class="lang-name">Français</span>
									<span class="lang-code">FR</span>
								</div>
								@if (LocalizationManager.CurrentLanguage == "fr")
								{
									<iconify class="lang-check" icon="lucide:check" Size=@(14) Color="#a78bfa" />
								}
							</button>
						</div>
					</div>
				</div>

				@* ──────── DANGER ZONE ──────── *@
				<div class="settings-section section-danger">
					<div class="section-header danger-header">
						<div class="section-icon-frame tone-danger">
							<iconify icon="lucide:triangle-alert" Size=@(15) Color="#fca5a5" />
						</div>
						<span class="section-title danger-title">DANGER ZONE</span>
						<div class="section-rule danger-rule"></div>
					</div>
					<div class="section-rows danger-rows">

						<div class="danger-row">
							<div class="danger-info">
								<div class="danger-info-head">
									<iconify icon="lucide:trash-2" Size=@(13) Color="#fca5a5" />
									<span class="danger-label">Reset Game Data</span>
								</div>
								<span class="danger-desc">@(IsTutorialActive() ? "Locked while the tutorial is in progress — finish or skip it first." : "Permanently deletes ALL progress — beasts, items, missions, achievements. Cannot be undone.")</span>
							</div>
							@if (IsTutorialActive())
							{
								<button class="danger-btn disabled"
										onmouseover=@(() => OnHover("reset-game"))>
									<iconify icon="lucide:lock" Size=@(13) Color="rgba(255, 255, 255, 0.4)" />
									<span class="danger-btn-text">LOCKED</span>
								</button>
							}
							else if (!showResetConfirm)
							{
								<button class="danger-btn"
										onclick=@OnResetGameClicked
										onmouseover=@(() => OnHover("reset-game"))>
									<iconify icon="lucide:shield-alert" Size=@(13) Color="#fca5a5" />
									<span class="danger-btn-text">RESET</span>
								</button>
							}
							else
							{
								<span class="danger-btn-stub"></span>
							}
						</div>

						@if (showResetConfirm)
						{
							<div class="danger-confirm">
								<div class="danger-confirm-warning">
									<iconify icon="lucide:octagon-alert" Size=@(18) Color="#fca5a5" />
									<div class="danger-confirm-text">
										<span class="danger-confirm-title">Are you absolutely sure?</span>
										<span class="danger-confirm-body">This permanently deletes ALL progress: beasts, items, guild membership, mission progress, achievements. This cannot be undone.</span>
									</div>
								</div>
								<div class="danger-confirm-actions">
									<button class="danger-cancel-btn"
											onclick=@OnCancelResetClicked
											onmouseover=@(() => OnHover("danger-cancel"))
											disabled=@isResetting>
										<span>CANCEL</span>
									</button>
									<button class="danger-confirm-btn"
											onclick=@OnConfirmResetClicked
											onmouseover=@(() => OnHover("danger-confirm"))
											disabled=@isResetting>
										<iconify icon="@(isResetting ? "lucide:loader" : "lucide:trash-2")" Size=@(13) Color="#ffffff" />
										<span>@(isResetting ? "RESETTING..." : "YES, DELETE EVERYTHING")</span>
									</button>
								</div>
							</div>
						}
					</div>
				</div>

			</div>
		</div>

		@* Footer — Done button *@
		<div class="modal-footer">
			<button class="done-btn"
					onclick=@Close
					onmouseover=@(() => OnHover("done"))>
				<iconify icon="lucide:check" Size=@(14) Color="#ffffff" />
				<span>@L("ui.options.done")</span>
			</button>
		</div>

		@* Bottom accent line *@
		<div class="modal-bottom-line"></div>

	</div>
</root>

@code {
	// Localization helper
	private string L( string key ) => LocalizationManager.Get( key );
	private string L( string key, params object[] args ) => LocalizationManager.Get( key, args );

	// Track every mounted instance — the panel is mounted under BOTH MainMenu
	// AND GameHUD so Show() can be called from either screen. `Instance` still
	// points at "most recently rendered" for back-compat, but Show() picks the
	// first instance with a visible ancestry chain so it routes to the correct
	// panel regardless of which screen is currently active.
	public static OptionsPanel Instance { get; private set; }
	private static readonly List<OptionsPanel> _instances = new();

	public bool IsVisible { get; private set; }

	/// <summary>
	/// True when ANY mounted OptionsPanel instance is showing. The panel is
	/// mounted under both MainMenu and GameHUD, so a single `Instance.IsVisible`
	/// read is unreliable — UIModalState consults this instead.
	/// </summary>
	public static bool AnyVisible
	{
		get
		{
			foreach ( var inst in _instances )
				if ( inst != null && inst.IsVisible ) return true;
			return false;
		}
	}

	// Two-stage reset confirmation state
	private bool showResetConfirm = false;
	private bool isResetting = false;

	// Hover sound dedupe — reset on Show/Hide so re-opening replays first hover sound.
	private string _lastHoveredKey;

	protected override void OnAfterTreeRender( bool firstTime )
	{
		Instance = this;
		if ( firstTime && !_instances.Contains( this ) )
		{
			_instances.Add( this );
		}
	}

	public override void OnDeleted()
	{
		_instances.Remove( this );
		base.OnDeleted();
	}

	// Walks up the ancestor chain — if any ancestor has HasClass("hidden"),
	// the subtree is display:none and this instance can't be visibly shown.
	// Used by Show() to pick the right instance when both screens mount a
	// copy of this panel.
	private bool IsInVisibleSubtree()
	{
		var p = this.Parent;
		while ( p != null )
		{
			if ( p.HasClass( "hidden" ) ) return false;
			p = p.Parent;
		}
		return true;
	}

	private static OptionsPanel PickActiveInstance()
	{
		// Prefer an instance whose ancestry has no `.hidden` flag (MainMenu
		// and GameHUD both use `.hidden` on their root to gate display:none).
		foreach ( var inst in _instances )
		{
			if ( inst != null && inst.IsInVisibleSubtree() ) return inst;
		}
		// Fallback — latch on the most recently rendered instance.
		return Instance;
	}

	public static void Show()
	{
		var target = PickActiveInstance();
		if ( target != null )
		{
			target.IsVisible = true;
			target.showResetConfirm = false; // always start collapsed
			target.isResetting = false;
			target._lastHoveredKey = null;
			target.StateHasChanged();
			SoundManager.PlayPopup();
		}
	}

	public static void Hide()
	{
		// Hide EVERY instance — avoids the case where a panel was shown on one
		// screen and the user switches away with the modal still open.
		foreach ( var inst in _instances )
		{
			if ( inst == null ) continue;
			inst.IsVisible = false;
			inst.showResetConfirm = false;
			inst._lastHoveredKey = null;
			inst.StateHasChanged();
		}
		SoundManager.PlayPopdown();
	}

	// NOTE: Esc is reserved by s&box (it opens the system pause / leave-game menu).
	// Don't bind it. Close via overlay click + close button.

	private void Close()
	{
		// Don't play PlayBack here — Hide() already plays PlayPopdown.
		// Calling both was producing two overlapping sounds on close.
		Hide();
	}

	// ────────────────────── KEYBOARD NAVIGATION ──────────────────────
	// Cursor over the toggle rows (the only routinely-changed settings).
	// Up/Down move, Space/Enter flips the highlighted toggle, Menu/run
	// closes the panel. Order MUST match the RenderToggleRow render order:
	// gameplay (3) → display (4) → confirmations (2) = 9 rows.
	private int _kbRowIndex = 0;

	/// <summary>Toggle actions in render order — index aligns with _kbRowIndex.</summary>
	private List<Action> GetKbToggleActions() => new()
	{
		ToggleSkipAnimations,
		ToggleShowLevelUpNotifications,
		ToggleShowDiscoveryAlerts,
		ToggleShowDamageNumbers,
		ToggleShowTypeEffectiveness,
		ToggleShowGeneticsOnCards,
		ToggleShowPowerRatings,
		ToggleConfirmBeforeRelease,
		ToggleConfirmBeforeFusion,
	};

	/// <summary>
	/// Keyboard handling — s&box calls Panel.Tick() automatically. Only acts
	/// while this panel is the top-priority open modal. Escape is intentionally
	/// NOT bound (reserved by s&box).
	/// </summary>
	public override void Tick()
	{
		base.Tick();
		if ( !IsVisible ) return;
		if ( !UIModalState.IsTopModal( "OptionsPanel" ) ) return;
		// The two-stage reset confirmation is a sub-modal — leave it mouse-only
		// so a stray keypress can't wipe the player's save.
		if ( showResetConfirm ) return;

		var toggles = GetKbToggleActions();
		_kbRowIndex = Math.Clamp( _kbRowIndex, 0, toggles.Count - 1 );

		if ( Input.Pressed( "Up" ) || Input.Pressed( "Left" ) )
		{
			_kbRowIndex = Math.Max( 0, _kbRowIndex - 1 );
			SoundManager.PlayHover();
		}
		else if ( Input.Pressed( "Down" ) || Input.Pressed( "Right" ) )
		{
			_kbRowIndex = Math.Min( toggles.Count - 1, _kbRowIndex + 1 );
			SoundManager.PlayHover();
		}
		else if ( Input.Pressed( "Jump" ) || Input.Pressed( "Enter" ) )
		{
			toggles[_kbRowIndex]?.Invoke();
		}
		else if ( Input.Pressed( "Menu" ) || Input.Pressed( "run" ) )
		{
			Close();
		}
	}

	private void OnHover( string key )
	{
		if ( _lastHoveredKey == key ) return;
		_lastHoveredKey = key;
		SoundManager.PlayHover();
	}

	private void ChangeLanguage( string langCode )
	{
		if ( LocalizationManager.CurrentLanguage == langCode ) return;
		LocalizationManager.SetLanguage( langCode );
		SoundManager.PlayClick();
		StateHasChanged();
	}

	// ============================================
	// GETTERS
	// ============================================

	private GameSettings GetSettings() => SettingsManager.Instance?.Settings ?? new GameSettings();

	private bool GetAutoContract() => GetSettings().DefaultAutoContract;
	private bool GetSkipAnimations() => GetSettings().SkipBattleAnimations;

	private bool GetShowDamageNumbers() => GetSettings().ShowDamageNumbers;
	private bool GetShowTypeEffectiveness() => GetSettings().ShowTypeEffectiveness;
	private bool GetShowGeneticsOnCards() => GetSettings().ShowGeneticsOnCards;
	private bool GetCompactCardView() => GetSettings().CompactCardView;
	private bool GetShowPowerRatings() => GetSettings().ShowPowerRatings;

	private int GetContractWarning() => GetSettings().ContractWarningThreshold;
	private bool GetShowLevelUpNotifications() => GetSettings().ShowLevelUpNotifications;
	private bool GetShowDiscoveryAlerts() => GetSettings().ShowDiscoveryAlerts;

	private bool GetConfirmBeforeRelease() => GetSettings().ConfirmBeforeRelease;
	private bool GetConfirmBeforeFusion() => GetSettings().ConfirmBeforeFusion;
	private int GetPurchaseThreshold() => GetSettings().ConfirmPurchaseThreshold;

	private bool GetLargerTextMode() => GetSettings().LargerTextMode;
	private bool GetHighContrastMode() => GetSettings().HighContrastMode;

	// ============================================
	// SETTERS
	// ============================================

	private void ToggleAutoContract()
	{
		var current = GetAutoContract();
		SettingsManager.Instance?.SetAutoContract( !current );
		PlayToggleSound( !current );
	}

	private void ToggleSkipAnimations()
	{
		var current = GetSkipAnimations();
		SettingsManager.Instance?.SetSkipAnimations( !current );
		PlayToggleSound( !current );
	}

	private void ToggleShowDamageNumbers()
	{
		var current = GetShowDamageNumbers();
		SettingsManager.Instance?.SetShowDamageNumbers( !current );
		PlayToggleSound( !current );
	}

	private void ToggleShowTypeEffectiveness()
	{
		var current = GetShowTypeEffectiveness();
		SettingsManager.Instance?.SetShowTypeEffectiveness( !current );
		PlayToggleSound( !current );
	}

	private void ToggleShowGeneticsOnCards()
	{
		var current = GetShowGeneticsOnCards();
		SettingsManager.Instance?.SetShowGeneticsOnCards( !current );
		PlayToggleSound( !current );
	}

	private void ToggleCompactCardView()
	{
		var current = GetCompactCardView();
		SettingsManager.Instance?.SetCompactCardView( !current );
		PlayToggleSound( !current );
	}

	private void ToggleShowPowerRatings()
	{
		var current = GetShowPowerRatings();
		SettingsManager.Instance?.SetShowPowerRatings( !current );
		PlayToggleSound( !current );
	}

	private void DecreaseContractWarning()
	{
		var current = GetContractWarning();
		if ( current > 0 )
		{
			SettingsManager.Instance?.SetContractWarningThreshold( current - 1 );
			SoundManager.PlayClick();
		}
	}

	private void IncreaseContractWarning()
	{
		var current = GetContractWarning();
		if ( current < 20 )
		{
			SettingsManager.Instance?.SetContractWarningThreshold( current + 1 );
			SoundManager.PlayClick();
		}
	}

	private void ToggleShowLevelUpNotifications()
	{
		var current = GetShowLevelUpNotifications();
		SettingsManager.Instance?.SetShowLevelUpNotifications( !current );
		PlayToggleSound( !current );
	}

	private void ToggleShowDiscoveryAlerts()
	{
		var current = GetShowDiscoveryAlerts();
		SettingsManager.Instance?.SetShowDiscoveryAlerts( !current );
		PlayToggleSound( !current );
	}

	private void ToggleConfirmBeforeRelease()
	{
		var current = GetConfirmBeforeRelease();
		SettingsManager.Instance?.SetConfirmBeforeRelease( !current );
		PlayToggleSound( !current );
	}

	private void ToggleConfirmBeforeFusion()
	{
		var current = GetConfirmBeforeFusion();
		SettingsManager.Instance?.SetConfirmBeforeFusion( !current );
		PlayToggleSound( !current );
	}

	private void DecreasePurchaseThreshold()
	{
		var current = GetPurchaseThreshold();
		var newValue = current <= 100 ? 0 : current - 500;
		SettingsManager.Instance?.SetConfirmPurchaseThreshold( Math.Max( 0, newValue ) );
		SoundManager.PlayClick();
	}

	private void IncreasePurchaseThreshold()
	{
		var current = GetPurchaseThreshold();
		var newValue = current == 0 ? 100 : current + 500;
		SettingsManager.Instance?.SetConfirmPurchaseThreshold( Math.Min( 10000, newValue ) );
		SoundManager.PlayClick();
	}

	private void ToggleLargerTextMode()
	{
		var current = GetLargerTextMode();
		SettingsManager.Instance?.SetLargerTextMode( !current );
		PlayToggleSound( !current );
	}

	private void ToggleHighContrastMode()
	{
		var current = GetHighContrastMode();
		SettingsManager.Instance?.SetHighContrastMode( !current );
		PlayToggleSound( !current );
	}

	private void PlayToggleSound( bool newState )
	{
		if ( newState )
			SoundManager.PlayToggleOn();
		else
			SoundManager.PlayToggleOff();
	}

	private void OnResetClicked()
	{
		SettingsManager.Instance?.ResetToDefaults();
		SoundManager.PlayClick();
		NotificationManager.Instance?.AddNotification( NotificationType.Info, L("ui.options.settings_reset"), L("ui.options.settings_reset_desc") );
	}

	private void OnReplayTutorialClicked()
	{
		SoundManager.PlayClick();
		// Restart re-fires from step 0 even if HasCompletedTutorial was set.
		// Closes the Options panel so the tutorial banner isn't covered.
		TutorialManager.Instance?.RestartTutorial();
		Close();
	}

	// ============================================
	// DANGER ZONE — Full game data wipe
	// ============================================

	/// <summary>
	/// Reset Game Data is locked during the tutorial. Wiping mid-tutorial would
	/// strip the tutorial-only Weaverton Approach zone and the rigged contract
	/// and leave the player in a broken intermediate state.
	/// </summary>
	private bool IsTutorialActive()
	{
		return TutorialManager.Instance?.IsTutorialActive == true;
	}

	private void OnResetGameClicked()
	{
		// Defense-in-depth: button is hidden when tutorial is active, but if
		// something bypasses the UI gate, refuse here too.
		if ( IsTutorialActive() )
		{
			SoundManager.PlayDeny();
			return;
		}

		SoundManager.PlayClick();
		showResetConfirm = true;
		StateHasChanged();
	}

	private void OnCancelResetClicked()
	{
		if ( isResetting ) return;
		SoundManager.PlayBack();
		showResetConfirm = false;
		StateHasChanged();
	}

	private async void OnConfirmResetClicked()
	{
		if ( isResetting ) return;

		isResetting = true;
		StateHasChanged();
		SoundManager.PlayClick();

		try
		{
			if ( SaveService.Instance != null )
			{
				await SaveService.Instance.ForceResetAsync();
			}
		}
		catch ( System.Exception ex )
		{
			Log.Warning( $"[OptionsPanel] ForceResetAsync threw: {ex.Message}" );
		}

		// Kick back to the main menu regardless of cloud reachability — the local
		// wipe always succeeds, so the session is dead either way.
		GameManager.Instance?.ReturnToMainMenu();

		NotificationManager.Instance?.AddNotification(
			NotificationType.Info,
			"Game data reset",
			"All progress has been wiped. Starting fresh.",
			duration: 6f );

		showResetConfirm = false;
		isResetting = false;
		Hide();
	}

	// ============================================
	// ROW RENDER HELPERS — single source of truth for each row template
	// keeps the markup in the main file readable and per-row tweaks consistent.
	// ============================================

	// `rowIndex` advances per toggle row in render order. The keyboard cursor
	// (`_kbRowIndex`) compares against it to paint the `.kb-active` highlight.
	// Each call site passes the running counter via `_toggleRowCounter`.
	private int _toggleRowCounter = 0;

	private RenderFragment RenderToggleRow( string icon, string label, string desc, bool isOn, Action onToggle, string hoverKey ) => __builder =>
	{
		int rowIndex = _toggleRowCounter++;
		<div class="setting-row @(_kbRowIndex == rowIndex ? "kb-active" : "")" onmouseover=@(() => OnHover(hoverKey))>
			<div class="setting-icon-frame">
				<iconify icon="@icon" Size=@(14) Color="@(isOn ? "#a78bfa" : "rgba(255, 255, 255, 0.55)")" />
			</div>
			<div class="setting-text">
				<span class="setting-label">@label</span>
				<span class="setting-desc">@desc</span>
			</div>
			<button class="bb-toggle @(isOn ? "on" : "off")" onclick=@onToggle>
				<div class="bb-toggle-thumb"></div>
			</button>
		</div>
	};

	private RenderFragment RenderStepperRow( string icon, string label, string desc, string value, Action onDec, Action onInc, string hoverKey, bool wide ) => __builder =>
	{
		<div class="setting-row" onmouseover=@(() => OnHover(hoverKey))>
			<div class="setting-icon-frame">
				<iconify icon="@icon" Size=@(14) Color="rgba(255, 255, 255, 0.65)" />
			</div>
			<div class="setting-text">
				<span class="setting-label">@label</span>
				<span class="setting-desc">@desc</span>
			</div>
			<div class="bb-stepper @(wide ? "wide" : "")">
				<button class="step-btn step-dec"
						onclick=@onDec
						onmouseover=@(() => OnHover(hoverKey + "-dec"))>
					<iconify icon="lucide:minus" Size=@(12) Color="#c4b5fd" />
				</button>
				<span class="step-value">@value</span>
				<button class="step-btn step-inc"
						onclick=@onInc
						onmouseover=@(() => OnHover(hoverKey + "-inc"))>
					<iconify icon="lucide:plus" Size=@(12) Color="#c4b5fd" />
				</button>
			</div>
		</div>
	};

	// Disabled row — rendered for planned features (e.g. accessibility) so
	// players see what's coming. Identical structure to a toggle row but the
	// toggle is replaced with a "SOON" pill and the whole row is muted.
	private RenderFragment RenderDisabledRow( string icon, string label, string desc ) => __builder =>
	{
		<div class="setting-row setting-row-disabled">
			<div class="setting-icon-frame">
				<iconify icon="@icon" Size=@(14) Color="rgba(255, 255, 255, 0.35)" />
			</div>
			<div class="setting-text">
				<span class="setting-label">@label</span>
				<span class="setting-desc">@desc</span>
			</div>
			<div class="soon-pill">
				<iconify icon="lucide:clock" Size=@(10) Color="#fcd34d" />
				<span>SOON</span>
			</div>
		</div>
	};

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add( IsVisible );
		hash.Add( _kbRowIndex );
		hash.Add( showResetConfirm );
		hash.Add( isResetting );
		hash.Add( IsTutorialActive() );
		hash.Add( LocalizationManager.CurrentLanguage );
		if ( SettingsManager.Instance?.Settings != null )
		{
			var s = SettingsManager.Instance.Settings;
			hash.Add( s.DefaultAutoContract );
			hash.Add( s.SkipBattleAnimations );
			hash.Add( s.ShowDamageNumbers );
			hash.Add( s.ShowTypeEffectiveness );
			hash.Add( s.ShowGeneticsOnCards );
			hash.Add( s.CompactCardView );
			hash.Add( s.ShowPowerRatings );
			hash.Add( s.ContractWarningThreshold );
			hash.Add( s.ShowLevelUpNotifications );
			hash.Add( s.ShowDiscoveryAlerts );
			hash.Add( s.ConfirmBeforeRelease );
			hash.Add( s.ConfirmBeforeFusion );
			hash.Add( s.ConfirmPurchaseThreshold );
			hash.Add( s.LargerTextMode );
			hash.Add( s.HighContrastMode );
		}
		return hash.ToHashCode();
	}
}
