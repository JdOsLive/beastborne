@namespace Beastborne.UI.Components
@using Sandbox;
@using Sandbox.UI;
@using System;
@using System.Linq;
@using Beastborne.Battle3D;
@inherits Panel

@{
	var mgr = ImpactRingManager.Instance;
	var entries = mgr?.Active;
}

<root class="impact-ring-overlay">
	@if ( entries != null )
	{
		foreach ( var d in entries )
		{
			// Encode the spawn id into a class so s&box's Razor diff treats
			// each spawn as a distinct element. Without this, spawning a
			// second ring while the first is alive would re-class the existing
			// div, and CSS @keyframes only play on first DOM mount (CLAUDE.md
			// quirk) — the new ring would skip its expand animation.
			var idTag = d.Id.ToString( "N" ).Substring( 0, 8 );
			var anchorClass = $"impact-ring-anchor ira-{idTag}";
			var leftPct = (int)( d.SpawnScreenPos.x * 100 );
			var topPct = (int)( d.SpawnScreenPos.y * 100 );
			var ringClass = d.IsCrit ? "impact-ring crit" : "impact-ring super";
			<div class="@anchorClass" style="left: @(leftPct)%; top: @(topPct)%;">
				<div class="@ringClass" style="border-color: @(d.Color);"></div>
			</div>
		}
	}
</root>

@code {
	protected override int BuildHash()
	{
		var hash = new HashCode();
		var mgr = ImpactRingManager.Instance;
		var list = mgr?.Active;
		if ( list == null )
		{
			hash.Add( 0 );
			return hash.ToHashCode();
		}
		hash.Add( list.Count );
		foreach ( var d in list )
		{
			hash.Add( d.Id );
		}
		return hash.ToHashCode();
	}
}
