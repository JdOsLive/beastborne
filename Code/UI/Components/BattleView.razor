	private void OnSwapRequested()
	{
		var bm = BattleManager.Instance;
		if (bm == null) return;

		var available = bm.GetAvailableSwapTargets();
		if (available == null || available.Count == 0)
		{
			SoundManager.PlayBack();
			return;
		}

		// Build carousel list: swap targets first, then active beast last
		// Matches the order in BattleSceneController.EnterSwapMode
		var active = bm.GetActivePlayerMonster();
		swapTargets = new List<Monster>();
		foreach (var m in bm.PlayerTeam)
		{
			if (m == null || m.CurrentHP <= 0 || m == active) continue;
			swapTargets.Add(m);
		}
		if (active != null && active.CurrentHP > 0)
			swapTargets.Add(active);

		// Start with the active beast selected (it's last in the list)
		swapCarouselIndex = swapTargets.Count - 1;
		actionBarState = "swap";

		BattleSceneController.Instance?.GetCameraController()?.FocusPlayer();
		BattleSceneController.Instance?.EnterSwapMode( swapCarouselIndex );

		SoundManager.PlayClick();
		StateHasChanged();
	}

	private void OnSwapCarouselLeft()
	{
		if (swapTargets == null || swapTargets.Count == 0) return;
		swapCarouselIndex = (swapCarouselIndex - 1 + swapTargets.Count) % swapTargets.Count;
		BattleSceneController.Instance?.RotateSwapCarousel( swapCarouselIndex );
		SoundManager.PlaySwoosh();
		StateHasChanged();
	}

	private void OnSwapCarouselRight()
	{
		if (swapTargets == null || swapTargets.Count == 0) return;
		swapCarouselIndex = (swapCarouselIndex + 1) % swapTargets.Count;
		BattleSceneController.Instance?.RotateSwapCarousel( swapCarouselIndex );
		SoundManager.PlaySwoosh();
		StateHasChanged();
	}

	private bool IsSwapTargetActive()
	{
		if (swapTargets == null || swapCarouselIndex >= swapTargets.Count) return false;
		var active = BattleManager.Instance?.GetActivePlayerMonster();
		return swapTargets[swapCarouselIndex] == active;
	}

	private void OnSwapConfirm()
	{
		if (swapTargets == null || swapCarouselIndex >= swapTargets.Count) return;
		var monster = swapTargets[swapCarouselIndex];
		if (monster.CurrentHP <= 0) return;

		// Can't swap to the already-active beast
		if (monster == BattleManager.Instance?.GetActivePlayerMonster())
		{
			SoundManager.PlayBack();
			return;
		}

		int idx = BattleManager.Instance?.GetMonsterIndex(monster) ?? -1;
		if (idx < 0) return;

		BattleManager.Instance.ExecutePlayerSwap(idx);
		actionBarState = "executing";

		BattleSceneController.Instance?.ExitSwapMode();
		BattleSceneController.Instance?.GetCameraController()?.FocusDefault();

		swapTargets = null;
		swapCarouselIndex = 0;
		SoundManager.PlaySuccess();
		StateHasChanged();
	}

	private void OnSwapBack()
	{
		actionBarState = "actions";
		BattleSceneController.Instance?.ExitSwapMode();
		BattleSceneController.Instance?.GetCameraController()?.FocusDefault();
		swapTargets = null;
		swapCarouselIndex = 0;
		SoundManager.PlayBack();
		StateHasChanged();
	}

	private void OnPlayerMonsterClicked(Monster monster, bool isActive, bool isKO)
	{
		// Swap is now handled by carousel UI — this click handler is for 2D mode only
	}

	private List<Monster> GetAvailableSwapTargets() => BattleManager.Instance?.GetAvailableSwapTargets() ?? new List<Monster>();

	// Horde system target selection
	private bool IsCurrentTarget(Monster monster)
	{
		if (monster == null) return false;
		// If no target selected, default to first alive enemy
		if (selectedTargetId == Guid.Empty)
		{
			var firstAlive = GetEnemyTeam().FirstOrDefault(e => e != null && e.CurrentHP > 0);
			return monster == firstAlive;
		}
		return monster.Id == selectedTargetId;
	}

	private void OnEnemyTargetSelected(Monster monster)
	{
		// In arena mode, targeting is disabled - you always attack the active enemy
		if (IsArenaBattle) return;
		if (monster == null || monster.CurrentHP <= 0) return;
		selectedTargetId = monster.Id;
		BattleManager.Instance?.SetPlayerTarget(monster);
		SoundManager.PlayClick();
		StateHasChanged();
	}

	private Monster GetSelectedTarget()
	{
		if (selectedTargetId == Guid.Empty)
		{
			return GetEnemyTeam().FirstOrDefault(e => e != null && e.CurrentHP > 0);
		}
		return GetEnemyTeam().FirstOrDefault(e => e?.Id == selectedTargetId && e.CurrentHP > 0);
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add(BattleManager.Instance?.CurrentTurnIndex);
		hash.Add(BattleManager.Instance?.IsPlaying);
		hash.Add(BattleManager.Instance?.IsWaitingForPlayerInput);
		hash.Add(BattleManager.Instance?.CurrentBattleState?.PlayerActiveIndex ?? 0);
		hash.Add(BattleManager.Instance?.CurrentBattleState?.TurnNumber ?? 0);
		hash.Add(lastTurn?.TurnNumber);
		hash.Add(currentMoveAnnouncement);
		hash.Add(GetAutoCatch());
		hash.Add(GetAutoNegotiateStrategy());
		hash.Add(GetAutoContractTargetSpecies());
		hash.Add(contractTargetSearchOpen);
		hash.Add(contractTargetSearchText);
		hash.Add(swapCarouselIndex);
		hash.Add(swapTargets?.Count);
		hash.Add(isLogExpanded);
		hash.Add(battleLog.Count);
		// Ticker visibility flips off when the most recent entry ages out —
		// include it explicitly so the fade-out class toggle triggers a re-render
		// even when no sprites are animating.
		hash.Add(GetTickerEntry() != null);
		hash.Add(SpriteAnimator.GlobalFrame);
		// Pass 3: announcement key (slam-in replay) + shake state (per-monster bumps).
		hash.Add(announcementKey);
		hash.Add(shakeTimers.Count);
		foreach (var k in shakeKeys.Values) hash.Add(k);
		// HP-bar lag: version bump per displayedHP write triggers a re-render
		// when the bar should change width. Single int — avoids iterating the
		// dictionary in BuildHash (per the perf constraint).
		hash.Add(displayedHPVersion);
		// Pass 2: chat/radio dock live state — message count + current track + play state.
		hash.Add(ChatManager.Instance?.Messages?.Count ?? 0);
		hash.Add(RadioManager.CurrentStationIndex);
		hash.Add(RadioManager.CurrentTrackIndex);
		hash.Add(RadioManager.IsPlaying);
		hash.Add(selectedTargetId);
		hash.Add(hoveredMoveId);
		hash.Add(BattleTransition.IsActive);
		// Boss state
		hash.Add(IsBossWave());
		hash.Add(IsRareBossEncounter());
		hash.Add(GetCurrentBossPhase());

		// Cinematic CRITICAL — render-key (changes per fire so the .bb-crit-flash-@N
		// class swap re-mounts the keyframes) + active flag (so the panel re-renders
		// when the timer flips off and the elements should drop from the DOM).
		hash.Add(critCinematicKey);
		hash.Add(critCinematicTimer > 0f);

		// Cinematic BOSS splash — same pattern. Title/name included so a back-to-back
		// boss wave with different copy diffs cleanly.
		hash.Add(bossSplashKey);
		hash.Add(bossSplashTimer > 0f);
		hash.Add(bossSplashTitle);
		hash.Add(bossSplashName);

		// Wave-clear banner — render-key + active flag + label/reward so back-to-back
		// non-final wave clears each get their own animation.
		hash.Add(waveClearKey);
		hash.Add(waveClearTimer > 0f);
		hash.Add(waveClearWaveLabel);
		hash.Add(waveClearRewardLine);

		// Status stamp — render-key + active flag + label/color/side so back-to-back
		// status applications each get their own animation, even if same status.
		hash.Add(statusStampKey);
		hash.Add(statusStampTimer > 0f);
		hash.Add(statusStampLabel);
		hash.Add(statusStampColor);
		hash.Add(statusStampIsPlayerSide);

		// Radio play state already hashed below for dock; but the EQ bar visibility
		// is gated on RadioManager.IsPlaying so the existing hash entry covers it.

		// Track HP and stat stages/statuses for all monsters
		var battleState = BattleManager.Instance?.CurrentBattleState;
		if (BattleManager.Instance?.PlayerTeam != null)
		{
			foreach (var m in BattleManager.Instance.PlayerTeam)
			{
				if (m != null)
				{
					hash.Add(m.CurrentHP);
					// Include stat stages and status count in hash
					if (battleState != null)
					{
						hash.Add(GetStatStageIndicators(m).Count);
						hash.Add(GetMonsterStatuses(m).Count);
					}
				}
			}
		}
		if (BattleManager.Instance?.EnemyTeam != null)
		{
			foreach (var m in BattleManager.Instance.EnemyTeam)
			{
				if (m != null)
				{
					hash.Add(m.CurrentHP);
					// Include stat stages and status count in hash
					if (battleState != null)
					{
						hash.Add(GetStatStageIndicators(m).Count);
						hash.Add(GetMonsterStatuses(m).Count);
					}
				}
			}
		}
		return hash.ToHashCode();
	}
}
