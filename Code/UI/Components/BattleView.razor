	protected override void OnAfterTreeRender(bool firstTime)
	{
		if (firstTime)
		{
			SubscribeToBattle();
		}
		else if (!isSubscribed && (BattleManager.Instance?.IsInBattle == true || BattleManager.Instance?.IsTransitioning == true))
		{
			SubscribeToBattle();
		}
	}

	public override void OnDeleted()
	{
		if (BattleManager.Instance != null)
		{
			BattleManager.Instance.OnBattleStart -= HandleBattleStart;
			BattleManager.Instance.OnTurnExecuted -= OnTurnExecuted;
			BattleManager.Instance.OnBattleEnd -= HandleBattleEnd;
			BattleManager.Instance.OnMoveUsed -= HandleMoveAnnouncement;
			BattleManager.Instance.OnMonsterDefeated -= HandleMonsterDefeated;
		}
		if (ExpeditionManager.Instance != null)
		{
			ExpeditionManager.Instance.OnWaveCompleted -= HandleWaveCompleted;
		}
		if ( BattleSceneController.Instance != null )
		{
			BattleSceneController.Instance.OnBillboardClicked = null;
			BattleSceneController.Instance.OnTurnVisualsStarted -= OnTurnVisualsStarted;
		}
		isSubscribed = false;
	}

	private void SubscribeToBattle()
	{
		if (BattleManager.Instance == null) return;
		if (!BattleManager.Instance.IsInBattle) return;

		BattleManager.Instance.OnBattleStart -= HandleBattleStart;
		BattleManager.Instance.OnTurnExecuted -= OnTurnExecuted;
		BattleManager.Instance.OnBattleEnd -= HandleBattleEnd;
		BattleManager.Instance.OnMoveUsed -= HandleMoveAnnouncement;
		BattleManager.Instance.OnMonsterDefeated -= HandleMonsterDefeated;

		lastTurn = null;
		currentMoveAnnouncement = "";
		// Don't clear log here - HandleBattleStart will manage log persistence

		BattleManager.Instance.OnBattleStart += HandleBattleStart;
		BattleManager.Instance.OnTurnExecuted += OnTurnExecuted;
		BattleManager.Instance.OnBattleEnd += HandleBattleEnd;
		BattleManager.Instance.OnMoveUsed += HandleMoveAnnouncement;
		BattleManager.Instance.OnMonsterDefeated += HandleMonsterDefeated;

		// Wave-clear cinematic — bind/rebind to ExpeditionManager. Fires per
		// non-final wave clear (final-wave clear handled by expedition complete).
		if (ExpeditionManager.Instance != null)
		{
			ExpeditionManager.Instance.OnWaveCompleted -= HandleWaveCompleted;
			ExpeditionManager.Instance.OnWaveCompleted += HandleWaveCompleted;
		}

		// Wire 3D billboard clicking to target selection
		if ( BattleSceneController.Instance != null )
		{
			BattleSceneController.Instance.OnBillboardClicked = OnBillboardClicked3D;
			BattleSceneController.Instance.OnTurnVisualsStarted -= OnTurnVisualsStarted;
			BattleSceneController.Instance.OnTurnVisualsStarted += OnTurnVisualsStarted;
		}

		isSubscribed = true;

		bool waitingForInput = BattleManager.Instance.IsWaitingForPlayerInput;
		int turnCount = BattleManager.Instance.CurrentResult?.Turns?.Count ?? 0;
		Log.Info($"[BattleView] SubscribeToBattle: IsArenaBattle={IsArenaBattle}, IsWaitingForPlayerInput={waitingForInput}, IsPlaying={BattleManager.Instance.IsPlaying}, TurnCount={turnCount}");

		// Start playback if there are pre-simulated turns ready
		// Otherwise wait for player input
		if (!IsArenaBattle && turnCount > 0 && !waitingForInput)
		{
			Log.Info("[BattleView] Starting playback (pre-simulated turns)");
			BattleManager.Instance.StartPlayback();
		}
		else
		{
			Log.Info($"[BattleView] NOT starting playback - IsArenaBattle={IsArenaBattle}, turnCount={turnCount}, waitingForInput={waitingForInput}");
		}

		// Force UI refresh after subscribing to show move selection if ready
		StateHasChanged();
	}

	private void HandleBattleStart()
	{
		Reset3DBattleUI();
		lastTurn = null;
		currentMoveAnnouncement = "";
		selectedTargetId = Guid.Empty;
		swapCarouselIndex = 0;
		swapTargets = null;
		BattleSceneController.Instance?.ClearSwapHighlights();

		// HP-bar lag: clear any leftover state from a prior battle so monsters
		// render at their fresh CurrentHP via the fallback path. Per-monster
		// entries get seeded on their first OnTurnExecuted.
		displayedHP.Clear();
		displayedHPReleaseTimers.Clear();

		var currentWave = ExpeditionManager.Instance?.CurrentWave ?? 1;

		// Check if this is a new expedition or continuing the same one
		var currentExpeditionId = ExpeditionManager.Instance?.CurrentExpedition?.Id ?? "";

		// Clear log only when starting a brand new expedition
		if (currentExpeditionId != lastLoggedExpeditionId)
		{
			battleLog.Clear();
			lastLoggedExpeditionId = currentExpeditionId;
			lastLoggedWave = 0;
			hasCompletedWaveTransition = false;
		}

		// Add wave divider if this is a new wave in the same expedition
		if (currentWave > lastLoggedWave && !string.IsNullOrEmpty(currentExpeditionId))
		{
			var totalWaves = ExpeditionManager.Instance?.CurrentExpedition?.Waves ?? 1;
			var isBossWave = ExpeditionManager.Instance?.IsBossWave ?? false;
			var waveLabel = isBossWave ? $"BOSS WAVE {currentWave}/{totalWaves}" : $"Wave {currentWave}/{totalWaves}";
			AddLogEntry($"--- {waveLabel} ---", "wave");
			lastLoggedWave = currentWave;
		}

		// ── Boss splash trigger ──
		// Fire once per wave-entry when this is a boss wave and we're in 3D
		// mode (the 2D mode already has its own boss-banner element above).
		// The wave key (expedition id + wave number) prevents re-firing on
		// retries that re-enter HandleBattleStart on the same wave.
		var splashWaveKey = $"{currentExpeditionId}#{currentWave}";
		if (Use3DBattle && IsBossWave() && !IsArenaBattle && splashWaveKey != lastBossSplashWaveKey)
		{
			TriggerBossSplash();
			lastBossSplashWaveKey = splashWaveKey;
		}
	}

	// Populate strings + start timer + bump render key. Called once per
	// boss wave entry from HandleBattleStart. Strings are read off the
	// current enemy team's first alive boss-tier monster so the splash
	// names the actual encounter.
	private void TriggerBossSplash()
	{
		var enemyTeam = GetEnemyTeam();
		Monster boss = null;
		if (enemyTeam != null)
		{
			foreach (var m in enemyTeam)
			{
				if (m == null) continue;
				if (IsBossMonster(m)) { boss = m; break; }
			}
			// Fallback: first alive enemy if no explicit boss-flagged monster.
			if (boss == null)
			{
				foreach (var m in enemyTeam)
				{
					if (m != null && m.CurrentHP > 0) { boss = m; break; }
				}
			}
		}

		var species = boss != null ? MonsterManager.Instance?.GetSpecies(boss.SpeciesId) : null;
		bossSplashIsRare = IsRareBossEncounter();
		bossSplashTitle = bossSplashIsRare ? "LEGENDARY ENCOUNTER" : "BOSS BATTLE";
		bossSplashName = species?.Name?.ToUpperInvariant() ?? (boss?.Nickname?.ToUpperInvariant() ?? "???");

		var currentWave = ExpeditionManager.Instance?.CurrentWave ?? 0;
		var totalWaves = ExpeditionManager.Instance?.CurrentExpedition?.Waves ?? 0;
		var lvl = boss?.Level ?? 0;
		bossSplashSubtitle = (currentWave > 0 && totalWaves > 0 && lvl > 0)
			? $"WAVE {currentWave}/{totalWaves}  ·  LV {lvl}"
			: (lvl > 0 ? $"LV {lvl}" : "");

		bossSplashTimer = BOSS_SPLASH_DURATION;
		bossSplashKey++;
	}

	private void HandleMoveAnnouncement(string announcement)
	{
		currentMoveAnnouncement = announcement;
		announcementTimer = ANNOUNCEMENT_DURATION;
		// Bump the render-key so the slam-in animation replays on each announcement
		announcementKey++;

		// Add to battle log
		var logType = "normal";
		if (announcement.Contains("super effective")) logType = "super";
		else if (announcement.Contains("critical")) logType = "crit";
		else if (announcement.Contains("not very effective")) logType = "resist";

		AddLogEntry(announcement, logType);
	}

	private float lastLogTimestamp = 0f;
	private const float MIN_LOG_STAGGER = 0.4f; // minimum seconds between visible entries

	private float GetStaggeredTimestamp()
	{
		var now = RealTime.Now;
		// Ensure each entry is at least MIN_LOG_STAGGER seconds after the previous one
		var ts = Math.Max(now, lastLogTimestamp + MIN_LOG_STAGGER);
		lastLogTimestamp = ts;
		return ts;
	}

	private void AddLogEntry(string text, string type = "normal")
	{
		battleLog.Add(new BattleLogEntry { Text = text, Type = type, Timestamp = GetStaggeredTimestamp() });
		if (battleLog.Count > MAX_LOG_ENTRIES)
			battleLog.RemoveAt(0);
	}

	private void AddLogEntry(BattleTurn turn, string text, string type)
	{
		battleLog.Add(new BattleLogEntry
		{
			Text = text,
			Type = type,
			AttackerName = turn.AttackerName,
			DefenderName = turn.DefenderName,
			MoveName = turn.MoveName,
			MoveElement = turn.MoveElement,
			Damage = turn.Damage,
			IsCritical = turn.IsCritical,
			IsSuperEffective = turn.IsSuperEffective,
			IsPlayerAttacker = turn.IsPlayerAttacker,
			IconOverride = GetLogEntryIcon(type),
			Timestamp = GetStaggeredTimestamp(),
		});
		if (battleLog.Count > MAX_LOG_ENTRIES)
			battleLog.RemoveAt(0);
	}

	private const float LOG_VISIBLE_DURATION = 5.0f; // seconds before fading starts
	private const float LOG_FADE_DURATION = 1.5f; // seconds to fade out

	// Ticker (bottom-center single-line chip) constants.
	// Short visible window — lets new entries replace old ones mid-turn without pileup.
	private const float TICKER_VISIBLE_DURATION = 2.25f; // seconds visible before fade-out
	private const float TICKER_FADE_DURATION = 0.35f;    // seconds to fade after visible window

	// Types that are already expressed by the 3D scene (floating damage numbers,
	// crit colors, super VFX, miss popups) and should NOT be shown in the ticker.
	// They still live in `battleLog` for the full-log dropdown history.
	private static bool IsTickerSuppressedType(string type) => type switch
	{
		"damage" => true,
		"crit" => true,
		"super" => true,
		"resist" => true,
		"miss" => true,
		_ => false,
	};

	/// <summary>
	/// Returns the single most-recent ticker-worthy entry whose timestamp has
	/// arrived and which has not fully faded out yet. Returns null if nothing
	/// to show right now.
	/// </summary>
	private BattleLogEntry GetTickerEntry()
	{
		var now = RealTime.Now;
		var maxAge = TICKER_VISIBLE_DURATION + TICKER_FADE_DURATION;
		for (int i = battleLog.Count - 1; i >= 0; i--)
		{
			var entry = battleLog[i];
			if (entry.Timestamp > now) continue;                   // scheduled in the future
			if (IsTickerSuppressedType(entry.Type)) continue;      // redundant with 3D scene
			var age = now - entry.Timestamp;
			if (age > maxAge) return null;                         // newest candidate already expired
			return entry;
		}
		return null;
	}

	/// <summary>
	/// True while the entry is in its "fully visible" window. Once it crosses
	/// TICKER_VISIBLE_DURATION, this returns false — which flips the .visible
	/// class off and lets the CSS transition fade it out. GetTickerEntry keeps
	/// returning the entry until TICKER_VISIBLE + TICKER_FADE, so the element
	/// stays mounted long enough for the fade to play.
	/// </summary>
	private bool IsTickerEntryVisible(BattleLogEntry entry)
	{
		if (entry == null) return false;
		var age = RealTime.Now - entry.Timestamp;
		return age <= TICKER_VISIBLE_DURATION;
	}

	private List<(BattleLogEntry entry, float age)> GetRecentLogEntries()
	{
		var now = RealTime.Now;
		var maxAge = LOG_VISIBLE_DURATION + LOG_FADE_DURATION;
		var recent = new List<(BattleLogEntry, float)>();
		for (int i = battleLog.Count - 1; i >= 0 && recent.Count < 5; i--)
		{
			var entry = battleLog[i];
			// Skip entries whose staggered timestamp hasn't arrived yet
			if (entry.Timestamp > now) continue;
			var age = now - entry.Timestamp;
			if (age > maxAge) break;
			recent.Add((entry, age));
		}
		recent.Reverse(); // oldest first
		return recent;
	}

	private string GetLogIconify(BattleLogEntry entry)
	{
		// Element-based attacks use element icons
		if (entry.MoveElement.HasValue && entry.Type is "damage" or "crit" or "super" or "resist")
		{
			return entry.MoveElement.Value switch
			{
				ElementType.Fire => "game-icons:fire",
				ElementType.Water => "game-icons:water-drop",
				ElementType.Earth => "game-icons:stone-block",
				ElementType.Wind => "game-icons:wind-slap",
				ElementType.Electric => "game-icons:lightning-bolt",
				ElementType.Ice => "game-icons:ice-cube",
				ElementType.Nature => "game-icons:oak-leaf",
				ElementType.Metal => "game-icons:anvil",
				ElementType.Shadow => "game-icons:shadow-grasp",
				ElementType.Spirit => "game-icons:ghost",
				_ => "lucide:swords",
			};
		}
		return entry.IconOverride ?? "lucide:circle";
	}

	private string GetLogEntryIcon(string type) => type switch
	{
		"miss" => "lucide:shield-off",
		"swap" => "lucide:repeat-2",
		"buff" => "lucide:trending-up",
		"debuff" => "lucide:trending-down",
		"guard" => "lucide:shield",
		"heal" => "lucide:heart-pulse",
		"status" => "lucide:flame",
		"ko" => "lucide:skull",
		"wave" => "lucide:swords",
		_ => null, // attack types use element icon instead
	};

	private string GetLogDiamondClass(BattleLogEntry entry)
	{
		if (entry.MoveElement.HasValue && entry.Type is "damage" or "crit" or "super" or "resist")
			return $"el-bg-{GetElementIconName(entry.MoveElement.Value)}";
		return entry.Type switch
		{
			"miss" => "el-bg-neutral",
			"swap" => "el-bg-swap",
			"ko" => "el-bg-ko",
			"wave" => "el-bg-wave",
			"heal" => "el-bg-heal",
			"buff" => "el-bg-buff",
			"debuff" => "el-bg-debuff",
			"guard" => "el-bg-guard",
			"status" => "el-bg-status",
			_ => "el-bg-neutral",
		};
	}

	public override void Tick()
	{
		base.Tick();

		// Update contract target search text from input
		if (contractTargetSearchInput != null && contractTargetSearchOpen)
		{
			contractTargetSearchText = contractTargetSearchInput.Text ?? "";
		}

		// Handle negotiation panel input when overlay is showing
		if (showNegotiationOverlay && negotiationPanel != null)
		{
			negotiationPanel.TickInput();
			StateHasChanged();
			return; // Don't process battle input while negotiating
		}

		if (BattleManager.Instance == null) return;

		if (BattleManager.Instance.IsInBattle && !isSubscribed)
		{
			SubscribeToBattle();
		}

		if (BattleManager.Instance.IsInBattle && BattleManager.Instance.IsPlaying)
		{
			BattleManager.Instance.ManualTick(RealTime.Delta);
			StateHasChanged();
		}

		// Track wave transition completion to suppress CSS re-animation
		var sceneCtrlTick = BattleSceneController.Instance;
		if (sceneCtrlTick != null && sceneCtrlTick.IsWaveTransitioning)
			hasCompletedWaveTransition = true; // Will persist, preventing CSS anim re-trigger

		// For arena/manual mode: ensure UI updates when waiting for player input
		// This is needed because PlaybackManualTurns is async and the UI won't auto-update
		if (BattleManager.Instance.IsInBattle && !BattleManager.Instance.IsPlaying && BattleManager.Instance.IsWaitingForPlayerInput)
		{
			StateHasChanged();
		}

		if (announcementTimer > 0)
		{
			announcementTimer -= RealTime.Delta;
			if (announcementTimer <= 0)
			{
				currentMoveAnnouncement = "";
			}
		}

		// Cinematic CRITICAL — decrement so the .bb-crit-flash + .bb-crit-stamp
		// elements fall out of the DOM after ~0.62s.
		if (critCinematicTimer > 0f)
		{
			critCinematicTimer -= RealTime.Delta;
			if (critCinematicTimer < 0f) critCinematicTimer = 0f;
		}

		// Cinematic BOSS splash — decrement so the splash falls out of the DOM
		// after ~2.05s and the .bb-splash-active modifier clears.
		if (bossSplashTimer > 0f)
		{
			bossSplashTimer -= RealTime.Delta;
			if (bossSplashTimer < 0f)
			{
				bossSplashTimer = 0f;
				bossSplashTitle = "";
				bossSplashName = "";
				bossSplashSubtitle = "";
			}
		}

		// Cinematic WAVE CLEAR banner — decrement so the banner falls out of
		// the DOM after ~1.6s.
		if (waveClearTimer > 0f)
		{
			waveClearTimer -= RealTime.Delta;
			if (waveClearTimer < 0f)
			{
				waveClearTimer = 0f;
				waveClearWaveLabel = "";
				waveClearRewardLine = "";
			}
		}

		// Status stamp — decrement so the stamp falls out of the DOM after
		// ~1.7s. Latest-wins; never queues.
		if (statusStampTimer > 0f)
		{
			statusStampTimer -= RealTime.Delta;
			if (statusStampTimer < 0f)
			{
				statusStampTimer = 0f;
				statusStampLabel = "";
				statusStampColor = "";
			}
		}

		// Pass 3: tick HP-bar shake timers — clear when expired so the
		// .taking-hit class falls off and the bar settles back at rest.
		if (shakeTimers.Count > 0)
		{
			var expiredShake = new List<Guid>();
			var keys = shakeTimers.Keys.ToList();
			foreach (var key in keys)
			{
				var remaining = shakeTimers[key] - RealTime.Delta;
				shakeTimers[key] = remaining;
				if (remaining <= 0f) expiredShake.Add(key);
			}
			foreach (var id in expiredShake) shakeTimers.Remove(id);
		}

		// Tick defeat fade-out timers
		if (defeatedFadeTimers.Count > 0)
		{
			var expired = new List<Guid>();
			var keys = defeatedFadeTimers.Keys.ToList();
			foreach (var key in keys)
			{
				var remaining = defeatedFadeTimers[key] - RealTime.Delta;
				defeatedFadeTimers[key] = remaining;
				if (remaining <= 0f)
					expired.Add(key);
			}
			foreach (var id in expired)
			{
				defeatedFadeTimers.Remove(id);
				defeatedMonsterCache.Remove(id);
			}
		}

		// HP-bar lag release (2D mode): tick the catchup timers and, when one
		// expires, sync displayedHP back to actual CurrentHP. This is the 2D
		// equivalent of OnTurnVisualsStarted (which only fires in 3D mode).
		if (displayedHPReleaseTimers.Count > 0)
		{
			var expiredRelease = new List<Guid>();
			var keys = displayedHPReleaseTimers.Keys.ToList();
			foreach (var key in keys)
			{
				var remaining = displayedHPReleaseTimers[key] - RealTime.Delta;
				displayedHPReleaseTimers[key] = remaining;
				if (remaining <= 0f) expiredRelease.Add(key);
			}
			foreach (var id in expiredRelease)
			{
				displayedHPReleaseTimers.Remove(id);
				var mon = FindMonsterById(id);
				if (mon != null)
				{
					displayedHP[id] = mon.CurrentHP;
					displayedHPVersion++;
				}
			}
		}

		SpriteAnimator.Update();
	}

	private void OnTurnExecuted(BattleTurn turn)
	{
		// Tracked for other UI (e.g. last-turn readouts). Log entries are
		// appended in OnTurnVisualsStarted instead so the bottom-center ticker
		// reveals text in sync with the 3D attack animation, not ahead of it.
		lastTurn = turn;

		// HP-bar lag: the simulator already dropped defender.CurrentHP by the
		// time we got here. Seed displayedHP with the OLD pre-damage value so
		// the bar holds at its existing width until the visual swing fires.
		// Reconstructed as CurrentHP + Damage. We only do this for damaging,
		// non-miss turns; non-damage turns (status, swap, item) don't drop the
		// bar so there's no display lag to apply.
		if (turn != null && turn.Damage > 0 && !turn.IsMiss && turn.DefenderId != Guid.Empty)
		{
			var defender = FindMonsterById(turn.DefenderId);
			if (defender != null && defender.MaxHP > 0)
			{
				var oldHP = defender.CurrentHP + turn.Damage;
				if (oldHP < 0) oldHP = 0;
				if (oldHP > defender.MaxHP) oldHP = defender.MaxHP;
				displayedHP[turn.DefenderId] = oldHP;
				displayedHPVersion++;

				// 2D mode has no OnTurnVisualsStarted — schedule a release
				// timer so the bar drops ~200ms after the move-name slam-in,
				// roughly matching when the player perceives the "hit" beat.
				if (!Use3DBattle)
				{
					displayedHPReleaseTimers[turn.DefenderId] = DISPLAYED_HP_RELEASE_2D;
				}
			}
		}

		// Pass 3: shake the defender's HP bar in 2D mode (3D mode shakes via
		// OnTurnVisualsStarted, where the visuals begin in sync with the swing).
		if (turn != null && !Use3DBattle && turn.Damage > 0 && !turn.IsMiss)
		{
			var defender = FindMonsterById(turn.DefenderId);
			if (defender != null) TriggerShake(defender);
		}

		// Cinematic CRITICAL — sub-second flash + slanted CRITICAL stamp.
		// Pure visual layer, decoupled from BattleSceneController slow-mo
		// or any scene-side timing. Doesn't fire on missed hits or zero-damage
		// turns even if IsCritical happens to be set, since "critical" with
		// no damage isn't a meaningful payoff moment.
		if (turn != null && turn.IsCritical && !turn.IsMiss && turn.Damage > 0)
		{
			critCinematicTimer = CRIT_CINEMATIC_DURATION;
			critCinematicKey++;
		}

		// Status stamp — scan turn.EffectMessages for the canonical status-
		// application strings emitted by BattleSimulator. Latest-wins: if
		// multiple statuses land in one turn, only the last one stamps.
		// Per-wave first-time only — BattleSimulator only emits the message
		// when AddStatus succeeds, so persisting statuses don't re-fire.
		if (turn != null && turn.EffectMessages != null && turn.EffectMessages.Count > 0)
		{
			TryFireStatusStampFromMessages(turn);
		}
	}

	/// <summary>
	/// Scan a turn's EffectMessages for status-application strings and fire
	/// the cinematic status stamp. The defender is the affected monster in
	/// the typical case (move applies status to opponent); for self-targeted
	/// status moves the messages still read about the same monster but the
	/// affected entity is the attacker — we resolve that by name match.
	/// </summary>
	private void TryFireStatusStampFromMessages(BattleTurn turn)
	{
		if (turn?.EffectMessages == null) return;

		// Only the LAST status-message in the turn wins (latest-wins per spec).
		string label = null;
		string color = null;
		string affectedName = null;

		foreach (var msg in turn.EffectMessages)
		{
			if (string.IsNullOrEmpty(msg)) continue;

			if (msg.Contains(" was poisoned!"))      { label = "POISONED!";  color = "poison";   affectedName = msg.Replace(" was poisoned!", ""); }
			else if (msg.Contains(" was burned!"))   { label = "BURNED!";    color = "burn";     affectedName = msg.Replace(" was burned!", ""); }
			else if (msg.Contains(" is paralyzed!")) { label = "PARALYZED!"; color = "paralyze"; affectedName = msg.Replace(" is paralyzed!", ""); }
			else if (msg.Contains(" fell asleep!"))  { label = "SLEEPING!";  color = "sleep";    affectedName = msg.Replace(" fell asleep!", ""); }
			else if (msg.Contains(" was frozen solid!")) { label = "FROZEN!"; color = "freeze";  affectedName = msg.Replace(" was frozen solid!", ""); }
			else if (msg.Contains(" became confused!")) { label = "CONFUSED!"; color = "confuse"; affectedName = msg.Replace(" became confused!", ""); }
		}

		if (label == null) return;

		// Resolve which side of the arena the affected monster is on so we can
		// position the stamp over their half. Match by nickname: the message
		// uses Nickname directly, so a player-team match wins; otherwise enemy.
		bool isPlayerSide = false;
		if (!string.IsNullOrEmpty(affectedName))
		{
			foreach (var m in GetPlayerTeam())
			{
				if (m != null && m.Nickname == affectedName) { isPlayerSide = true; break; }
			}
		}
		// If we couldn't resolve, default to the defender's side — which is
		// the most common case (status move's target is the opponent).
		else
		{
			var defender = FindMonsterById(turn.DefenderId);
			isPlayerSide = defender != null && IsPlayerMonster(defender);
		}

		statusStampLabel = label;
		statusStampColor = color;
		statusStampIsPlayerSide = isPlayerSide;
		statusStampTimer = STATUS_STAMP_DURATION;
		statusStampKey++;
	}

	/// <summary>
	/// Wave-clear cinematic trigger. Fires per non-final wave (final wave
	/// clear goes straight to expedition-complete which has its own setpiece).
	/// </summary>
	private void HandleWaveCompleted(int waveJustCleared, int totalWaves)
	{
		// Build the wave label — pad to 2 digits to match the design's "WAVE 03" feel.
		waveClearWaveLabel = $"WAVE {waveJustCleared:D2}";

		// Reward chip is optional — pull XP/gold from the most-recent BattleResult
		// if available. We don't want to invent values; if the data isn't easy to
		// read, just show no chip.
		string rewardLine = "";
		var lastResult = BattleManager.Instance?.CurrentResult;
		if (lastResult != null && lastResult.PlayerWon)
		{
			var xp = lastResult.TotalXP;
			var gold = lastResult.TotalGold;
			if (xp > 0 && gold > 0)       rewardLine = $"+ {xp} XP   ·   {gold} GOLD";
			else if (xp > 0)              rewardLine = $"+ {xp} XP";
			else if (gold > 0)            rewardLine = $"+ {gold} GOLD";
		}
		waveClearRewardLine = rewardLine;

		waveClearTimer = WAVE_CLEAR_DURATION;
		waveClearKey++;
	}

	private Monster FindMonsterById(Guid id)
	{
		if (id == Guid.Empty) return null;
		foreach (var m in GetPlayerTeam()) if (m != null && m.Id == id) return m;
		foreach (var m in GetEnemyTeam()) if (m != null && m.Id == id) return m;
		return null;
	}

	/// <summary>
	/// Fires from BattleSceneController at the MOMENT a queued turn's visuals
	/// begin playing. This is where per-turn log entries are appended so the
	/// ticker text lands with the swing/impact rather than at simulation time
	/// (which is 1-2 turns ahead of the on-screen animation).
	/// </summary>
	private void OnTurnVisualsStarted(BattleTurn turn)
	{
		if (turn == null) return;

		// HP-bar lag release (3D mode): the swing animation is starting now,
		// so sync displayedHP back to actual CurrentHP. The CSS transition on
		// .panel3d-hp-fill (width 0.6s ease) animates the bar drop in sync
		// with the visible impact instead of pre-emptively at simulation time.
		if (Use3DBattle && turn.Damage > 0 && !turn.IsMiss && turn.DefenderId != Guid.Empty)
		{
			var defender = FindMonsterById(turn.DefenderId);
			if (defender != null)
			{
				displayedHP[turn.DefenderId] = defender.CurrentHP;
				displayedHPVersion++;
				// Don't need a 2D release timer if a 3D release just happened.
				displayedHPReleaseTimers.Remove(turn.DefenderId);
			}
		}

		// Pass 3: shake the defender's HP bar in 3D mode at the moment the
		// scene starts the swing — feels in-sync with the impact VFX.
		if (Use3DBattle && turn.Damage > 0 && !turn.IsMiss)
		{
			var defender = FindMonsterById(turn.DefenderId);
			if (defender != null) TriggerShake(defender);
		}

		// Log swap actions
		if (turn.IsSwap && !string.IsNullOrEmpty(turn.SwapToName))
		{
			AddLogEntry(turn, $"{turn.SwapToName} entered the battle!", "swap");
		}

		// Log item use actions
		if (turn.IsItemUse && !string.IsNullOrEmpty(turn.ItemName))
		{
			var msg = !string.IsNullOrEmpty(turn.ItemTargetName)
				? $"You used {turn.ItemName} on {turn.ItemTargetName}!"
				: $"You used {turn.ItemName}!";
			AddLogEntry(turn, msg, "item");
		}

		// Log miss (kept for dropdown history; filtered from ticker)
		if (turn.IsMiss)
		{
			AddLogEntry(turn, $"{turn.AttackerName}'s {turn.MoveName} missed!", "miss");
		}

		// Log damage (kept for dropdown history; filtered from ticker — the
		// floating damage number + crit/super coloring already tell this story)
		if (turn.Damage > 0)
		{
			var logType = turn.IsCritical ? "crit" : (turn.IsSuperEffective ? "super" : (turn.IsResisted ? "resist" : "damage"));
			AddLogEntry(turn, $"{turn.AttackerName} dealt {turn.Damage} dmg with {turn.MoveName}!", logType);
		}

		// Log KO
		if (turn.Damage > 0 && turn.DefenderHPAfter <= 0)
		{
			AddLogEntry(turn, $"{turn.DefenderName} was knocked out!", "ko");
		}

		// Log status message (can't act due to sleep/paralysis, protected itself, etc.)
		if (!string.IsNullOrEmpty(turn.StatusMessage) && !turn.IsSwap)
		{
			var statusType = GetStatusMessageType(turn.StatusMessage);
			AddLogEntry(turn, turn.StatusMessage, statusType);
		}

		// Log effect messages (stat changes, status effects, heals, etc.)
		if (turn.EffectMessages != null)
		{
			foreach (var msg in turn.EffectMessages)
			{
				if (string.IsNullOrEmpty(msg)) continue;
				var effectType = GetEffectMessageType(msg);
				AddLogEntry(turn, msg, effectType);
			}
		}
	}

	private void HandleMonsterDefeated(Monster monster)
	{
		if (monster == null) return;
		defeatedFadeTimers[monster.Id] = DEFEAT_TOTAL_DURATION;
		defeatedMonsterCache[monster.Id] = monster;
	}

	private string GetStatusMessageType(string message)
	{
		if (message.Contains("protected") || message.Contains("Guard"))
			return "guard";
		if (message.Contains("asleep") || message.Contains("paralyzed") || message.Contains("frozen"))
			return "status";
		if (message.Contains("hurt itself") || message.Contains("confused"))
			return "damage";
		return "status";
	}

	private string GetEffectMessageType(string message)
	{
		// Stat increases (buffs)
		if (message.Contains("rose") || message.Contains("sharply rose") || message.Contains("recovered"))
			return "buff";
		// Stat decreases (debuffs)
		if (message.Contains("fell") || message.Contains("harshly fell"))
			return "debuff";
		// Status conditions
		if (message.Contains("burned") || message.Contains("poisoned") || message.Contains("paralyzed") ||
		    message.Contains("frozen") || message.Contains("asleep") || message.Contains("confused"))
			return "status";
		// Healing
		if (message.Contains("HP"))
			return "heal";
		return "effect";
	}

	private bool HasContractInk()
	{
		return (TamerManager.Instance?.CurrentTamer?.ContractInk ?? 0) > 0;
	}

	private void HandleBattleEnd(BattleResult result)
	{
		Reset3DBattleUI();
		Log.Info($"[BattleView] HandleBattleEnd: PlayerWon={result?.PlayerWon}, IsBackground={ExpeditionManager.Instance?.IsRunningInBackground}");

		// HP-bar lag: clear so the next battle starts with clean fallback state.
		displayedHP.Clear();
		displayedHPReleaseTimers.Clear();

		lastBattleWon = result?.PlayerWon ?? false;

		// Victory/defeat sounds disabled per-wave - only play at expedition end
		// if (result?.PlayerWon == true)
		// 	SoundManager.PlayVictory();
		// else
		// 	SoundManager.PlayDefeat();

		if (IsArenaBattle || IsRaidBattle)
		{
			// Arena and raid battles skip negotiation — go straight to result
			Log.Info($"[BattleView] {(IsRaidBattle ? "Raid" : "Arena")} battle ended, invoking OnBattleEnd");
			OnBattleEnd?.Invoke(result?.PlayerWon ?? false);
			return;
		}

		// Contract negotiation is now player-initiated via the CONTRACT diamond button
		// No more random post-battle popups
		{
			Log.Info($"[BattleView] Invoking OnBattleEnd callback");
			OnBattleEnd?.Invoke(result?.PlayerWon ?? false);
		}
	}

	private void OnNegotiationComplete(bool caught, Monster monster)
	{
		Log.Info($"[BattleView] OnNegotiationComplete: caught={caught}, monster={monster?.Nickname}, isMidBattle={isMidBattleContract}");
		showNegotiationOverlay = false;
		negotiationTarget = null;

		if ( isMidBattleContract )
		{
			isMidBattleContract = false;

			// Check if negotiation was skipped (no turn consumed)
			bool wasSkipped = negotiationPanel?.WasSkipped == true;
			if ( wasSkipped )
			{
				contractTarget = null;
				isBossContract = false;
				BattleSceneController.Instance?.GetCameraController()?.FocusDefault();
				StateHasChanged();
				return;
			}

			if ( caught && contractTarget != null )
			{
				// Success: remove beast from battle
				Log.Info($"[BattleView] Contract success! Removing {contractTarget.Nickname} from battle");
				BattleManager.Instance?.RemoveEnemyFromBattle( contractTarget );
				BattleSceneController.Instance?.RemoveContractedEnemy( contractTarget.Id );

				// Award 75% XP to active player beast
				var playerBeast = BattleManager.Instance?.GetActivePlayerMonster();
				if ( playerBeast != null )
				{
					int avgLevel = (int)(BattleManager.Instance.PlayerTeam.Average( p => p.Level ));
					int xp = (int)(BattleSimulator.CalculateXPGain( contractTarget, avgLevel ) * 0.75f);
					playerBeast.CurrentXP += xp;
				}

				// Check if battle is now over
				var remaining = BattleManager.Instance?.EnemyTeam?.Where( e => e.CurrentHP > 0 && !e.WasContracted ).ToList();
				if ( remaining == null || remaining.Count == 0 )
				{
					BattleManager.Instance?.ForceEndBattle( playerWon: true );
					contractTarget = null;
					isBossContract = false;
					StateHasChanged();
					return;
				}
			}

			// Whether success or fail, consume turn (enemy attacks)
			contractTarget = null;
			isBossContract = false;
			BattleSceneController.Instance?.GetCameraController()?.FocusDefault();
			BattleManager.Instance?.ExecuteEnemyTurnOnly();
			StateHasChanged();
			return;
		}

		// Post-battle negotiation flow (legacy / boss encounters)
		isBossContract = false;
		ExpeditionManager.Instance?.ClearCatchableEnemies();
		StateHasChanged();
		OnBattleEnd?.Invoke(lastBattleWon);
	}

