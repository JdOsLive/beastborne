	// Pass 3: HP-bar shake helpers — `IsShaking` adds the `.taking-hit` class
	// for SHAKE_DURATION after a damaging turn lands, and the integer key bumps
	// each hit so the shake @keyframes animation replays (re-mount required in s&box).
	private bool IsShaking(Monster m)
	{
		if (m == null) return false;
		return shakeTimers.TryGetValue(m.Id, out var t) && t > 0f;
	}
	private int GetShakeKey(Monster m)
	{
		if (m == null) return 0;
		return shakeKeys.TryGetValue(m.Id, out var k) ? k : 0;
	}
	private void TriggerShake(Monster m)
	{
		if (m == null) return;
		shakeTimers[m.Id] = SHAKE_DURATION;
		shakeKeys[m.Id] = (shakeKeys.TryGetValue(m.Id, out var prev) ? prev : 0) + 1;
	}
