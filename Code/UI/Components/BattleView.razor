	private float GetHPPercent(Monster m) => m == null || m.MaxHP <= 0 ? 0 : (float)m.CurrentHP / m.MaxHP * 100f;

	// Bar-width source. Reads from the deferred displayedHP dictionary so the
	// bar lags one beat behind the simulation (the actual HP drops on
	// OnTurnExecuted; the bar drops on OnTurnVisualsStarted / 2D timer release).
	// Falls back to live CurrentHP if no entry — covers initial renders,
	// swap-ins, wave spawns, anything not in the OnTurnExecuted hot path.
	private float GetDisplayedHPPercent(Monster m)
	{
		if (m == null || m.MaxHP <= 0) return 0;
		var hp = displayedHP.TryGetValue(m.Id, out var v) ? v : m.CurrentHP;
		// Clamp negatives just in case (shouldn't happen but defends against bad turn data).
		if (hp < 0) hp = 0;
		return (float)hp / m.MaxHP * 100f;
	}

	// Same lag-then-catchup gate for the HP NUMBER readout, so the "209 / 209"
	// text doesn't tick to the new value before the bar's visible drop lands.
	private int GetDisplayedHP(Monster m)
	{
		if (m == null) return 0;
		var hp = displayedHP.TryGetValue(m.Id, out var v) ? v : m.CurrentHP;
		if (hp < 0) hp = 0;
		return hp;
	}

	private float GetXPPercent(Monster m) => m == null || m.XPForNextLevel <= 0 ? 0 : (float)m.CurrentXP / m.XPForNextLevel * 100f;

