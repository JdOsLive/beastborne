	/// <summary>
	/// Latest player/guild/trade message that's reasonable to surface in the
	/// battle dock. We skip system spam (joins, leaves, achievements) so the
	/// dock stays useful — it should show conversation, not noise.
	/// </summary>
	private ChatMessage GetLatestBattleChat()
	{
		var msgs = ChatManager.Instance?.Messages;
		if (msgs == null || msgs.Count == 0) return null;
		for (int i = msgs.Count - 1; i >= 0; i--)
		{
			var m = msgs[i];
			if (m == null) continue;
			if (m.Type == ChatMessageType.Player ||
				m.Type == ChatMessageType.GuildChat ||
				m.Type == ChatMessageType.Trade)
			{
				return m;
			}
		}
		return null;
	}

	private string TruncateChat(string text)
	{
		if (string.IsNullOrEmpty(text)) return "";
		const int max = 60;
		if (text.Length <= max) return text;
		return text.Substring(0, max - 1) + "…";
	}

