@namespace Beastborne.UI.Components
@using Sandbox;
@using Sandbox.UI;
@using Beastborne.Core;
@using Beastborne.Data;
@using Beastborne.Systems;
@using Beastborne.UI.Panels;
@using Beastborne.UI.Components;
@using Beastborne.Battle3D;
@using Iconify;
@inherits Panel

<root class="battle-view @(IsBossWave() ? "boss-battle" : "") @(Use3DBattle ? "mode-3d" : "") @(bossSplashTimer > 0f ? "bb-splash-active" : "")" style="@(Use3DBattle ? "" : GetBackgroundStyle())">
	<!-- Dark overlay for readability (hidden in 3D mode) -->
	@if (!Use3DBattle)
	{
		<div class="background-overlay @(IsBossWave() ? "boss-overlay" : "") @(IsRaidBattle ? "raid-overlay" : "")"></div>
		<!-- P5-style yellow corner slabs (boss battles use legendary-gold variant) -->
		<div class="bb-corner-slab tl @(IsBossWave() ? "legendary" : "")"></div>
		<div class="bb-corner-slab br @(IsBossWave() ? "legendary" : "")"></div>
	}

	<!-- ── Cinematic CRITICAL stamp ─────────────────────────────────────
	     Fired sub-second over the 3D scene whenever a damaging hit lands
	     with turn.IsCritical == true. The flash + stamp are SEPARATE
	     elements and complement (not replace) the existing manga-impact
	     damage number in DamageNumberOverlay. Render-key class swap
	     (.bb-crit-flash-@N) re-mounts the keyframes on every fire so
	     back-to-back crits each get their own animation. -->
	@if (critCinematicTimer > 0f)
	{
		<div class="bb-crit-flash bb-crit-flash-@(critCinematicKey % 4)"></div>
		<div class="bb-crit-stamp-wrap bb-crit-stamp-wrap-@(critCinematicKey % 4)">
			<div class="bb-crit-stamp">
				<span class="bb-crit-stamp-text">CRITICAL!</span>
				<div class="bb-crit-stamp-underline"></div>
			</div>
		</div>
	}

	<!-- ── Cinematic BOSS splash ────────────────────────────────────────
	     Fires once on wave-start when IsBossWave() — full-bleed slanted
	     slab with title + species name. ~2.0s total on-screen, slides in
	     from the LEFT, holds, slides out to the RIGHT. The .bb-splash-active
	     modifier on .battle-view dims action diamonds + ticker + wave
	     indicator while the splash is up. -->
	@if (bossSplashTimer > 0f)
	{
		<div class="bb-boss-splash-overlay bb-boss-splash-overlay-@(bossSplashKey % 4)"></div>
		<div class="bb-boss-splash bb-boss-splash-@(bossSplashKey % 4) @(bossSplashIsRare ? "legendary" : "")">
			<div class="bb-boss-splash-edge top"></div>
			<div class="bb-boss-splash-body">
				<span class="bb-boss-splash-title">@bossSplashTitle</span>
				<span class="bb-boss-splash-name">@bossSplashName</span>
				@if (!string.IsNullOrEmpty(bossSplashSubtitle))
				{
					<span class="bb-boss-splash-sub">@bossSplashSubtitle</span>
				}
			</div>
			<div class="bb-boss-splash-edge bottom"></div>
		</div>
	}

	<!-- ── Cinematic WAVE CLEAR banner ─────────────────────────────────
	     Fires for ~1.6s after a non-final wave is cleared. Two slanted
	     yellow/red strips slam in horizontally; centered "VICTORY" label
	     + giant italic "CLEAR!" + optional reward chip. Render-key class
	     swap (.bb-wave-clear-key-@N % 4) re-mounts on every fire. -->
	@if (waveClearTimer > 0f)
	{
		<div class="bb-wave-clear-overlay bb-wave-clear-key-@(waveClearKey % 4)"></div>
		<div class="bb-wave-clear bb-wave-clear-key-@(waveClearKey % 4)">
			<div class="bb-wave-clear-strip a"></div>
			<div class="bb-wave-clear-strip b"></div>
			<div class="bb-wave-clear-text">
				<span class="bb-wave-clear-label">★ @waveClearWaveLabel ★</span>
				<span class="bb-wave-clear-big">CLEAR!</span>
				@if (!string.IsNullOrEmpty(waveClearRewardLine))
				{
					<span class="bb-wave-clear-reward">
						<span class="bb-wave-clear-reward-inner">@waveClearRewardLine</span>
					</span>
				}
			</div>
		</div>
	}

	<!-- ── Status stamp ────────────────────────────────────────────────
	     Big slanted slab announcing "POISONED!" / "BURNED!" etc. when a
	     status condition lands on a monster. Sits roughly above the
	     affected monster's side of the arena. Render-key class swap so
	     back-to-back status applications each get their own animation. -->
	@if (statusStampTimer > 0f)
	{
		<div class="bb-status-stamp bb-status-stamp-@statusStampColor bb-status-stamp-key-@(statusStampKey % 4) @(statusStampIsPlayerSide ? "player-side" : "enemy-side")">
			<span class="bb-status-stamp-text">@statusStampLabel</span>
		</div>
	}

	<!-- Intentionally no scene-framing chrome on .battle-view.mode-3d — the 3D
	     scene should read as a 2.5D battle, not a boxed-in UI panel. The skewed
	     WAVE badge + halftone wash live below; those are localized polish, not
	     framing. Don't reintroduce a top-edge strip or framing chevrons here. -->

	<!-- Boss Battle Banner -->
	@if (IsBossWave() && !IsArenaBattle && !Use3DBattle)
	{
		<div class="boss-banner @(IsRareBossEncounter() ? "rare" : "")">
			<div class="boss-banner-line left"></div>
			<div class="boss-banner-content">
				<span class="boss-banner-text">@(IsRareBossEncounter() ? L("ui.battle.legendary_boss") : L("ui.battle.boss_battle"))</span>
				@if (GetBossPhaseCount() > 1)
				{
					<span class="boss-phase-text">@L("ui.battle.phase") @GetCurrentBossPhase()/@GetBossPhaseCount()</span>
				}
			</div>
			<div class="boss-banner-line right"></div>
		</div>
	}

	<!-- Top Bar: Wave/Turn Info + Turn Order (hidden in 3D mode - info shown in floating panels) -->
	<div class="battle-top-bar" style="@(Use3DBattle ? "display: none;" : "")">
		<div class="battle-info">
			@if (IsRaidBattle)
			{
				<div class="info-badge raid-badge">
					<span class="badge-label">@L("ui.battle.raid")</span>
				</div>
				<div class="info-badge round-badge">
					<span class="badge-label">@L("ui.battle.round")</span>
					<span class="badge-value">@(GetRaidRound() + 1)</span>
				</div>
				<div class="raid-damage-counter">
					<span class="raid-dmg-label">@L("ui.battle.dmg")</span>
					<span class="raid-dmg-value">@($"{GetRaidDamage():N0}")</span>
				</div>
			}
			else if (!IsArenaBattle)
			{
				<div class="info-badge wave-badge @(IsBossWave() ? "boss-wave" : "")">
					<span class="badge-label">@(IsBossWave() ? L("ui.battle.boss") : L("ui.battle.wave"))</span>
					<span class="badge-value">@GetCurrentWave()</span>
				</div>
			}
			@if (!IsRaidBattle)
			{
				<div class="info-badge turn-badge">
					<span class="badge-label">@L("ui.battle.turn")</span>
					<span class="badge-value">@GetCurrentTurn()</span>
				</div>
			}
		</div>

		@if (IsArenaBattle)
		{
			<div class="arena-score-bar">
				<span class="arena-score-name">@ArenaPlayerName</span>
				<div class="arena-score-pips">
					@for (int i = 0; i < 2; i++)
					{
						var won = ArenaPlayerWins > i;
						<div class="arena-pip @(won ? "won" : "")"></div>
					}
				</div>
				<span class="arena-score-game">Game @ArenaGameNumber</span>
				<div class="arena-score-pips">
					@for (int i = 0; i < 2; i++)
					{
						var won = ArenaOpponentWins > i;
						<div class="arena-pip opponent @(won ? "won" : "")"></div>
					}
				</div>
				<span class="arena-score-name">@ArenaOpponentName</span>
			</div>
		}

		<!-- Turn Order Display (hidden in arena/raid) -->
		@if (!IsArenaBattle && !IsRaidBattle)
		{
			<div class="turn-order bb-skewed-strip">
				<span class="turn-order-label">@L("ui.battle.next")</span>
				@{ int turnOrderIdx = 0; }
				@foreach (var monster in GetTurnOrder().Take(4))
				{
					var isPlayer = IsPlayerMonster(monster);
					var stagger = turnOrderIdx;
					turnOrderIdx++;
					<div class="turn-order-icon @(isPlayer ? "player" : "enemy") bb-stagger-@stagger">
						@if (HasSprite(monster))
						{
							<div class="turn-icon-sprite" style="background-image: url(@GetAnimatedSpritePath(monster))"></div>
						}
						else
						{
							<span class="turn-icon-placeholder">?</span>
						}
					</div>
				}
				<div class="bb-strip-underline"></div>
			</div>
		}

	</div>

	<!-- Main Battle Arena (hidden in 3D mode) -->
	<div class="battle-arena" style="@(Use3DBattle ? "display: none;" : "")">
		<!-- Player Side -->
		<div class="battle-side player-side">
			<div class="side-label">@L("ui.battle.your_team")</div>
			<div class="monsters-container">
				@{
					var playerTeam = GetPlayerTeam();
					var playerActive = GetPlayerActiveMonster();
					// Reorder so active monster is always displayed first
					var displayOrder = new List<Monster>();
					if (playerActive != null) displayOrder.Add(playerActive);
					displayOrder.AddRange(playerTeam.Where(m => m != null && m != playerActive));
				}
				@foreach (var monster in displayOrder)
				{
					if (monster == null) continue;
					var isActive = monster == playerActive;
					var isAttacker = IsAttacker(monster);
					var isDefender = IsDefender(monster);
					var hpPercent = GetDisplayedHPPercent(monster);
					var isKO = monster.CurrentHP <= 0;
					var canSwapTo = false; // Swap is now handled by carousel UI

					<div class="monster-card-wrapper @(isActive && CanSelectMoves() ? "show-moves" : "")">
						<div class="monster-card @(isActive ? "active" : "benched") @(isAttacker ? "attacking" : "") @(isDefender ? "hit" : "") @(isKO ? "ko" : "") @(canSwapTo ? "swap-target" : "")"
							 onclick=@(() => OnPlayerMonsterClicked(monster, isActive, isKO))>
							<div class="card-glow"></div>
							<div class="card-content">
								<div class="monster-sprite-area">
									@if (HasSprite(monster))
									{
										<div class="sprite" style="background-image: url(@GetAnimatedSpritePath(monster))"></div>
									}
									else
									{
										<div class="sprite-placeholder">?</div>
									}
									@if (isDefender && GetLastDamage(monster) > 0 && ShouldShowDamageNumbers())
									{
										<div class="damage-number">-@GetLastDamage(monster)</div>
									}
									@if (isKO)
									{
										<div class="ko-badge">@L("ui.battle.ko")</div>
									}
								</div>
								<div class="monster-info">
									<div class="name-row">
										<span class="monster-name @((monster.Nickname ?? "Monster").Length > 9 ? "long-name" : "")">@(monster.Nickname ?? "Monster")</span>
										<span class="monster-level">Lv.@monster.Level</span>
									</div>
									<div class="hp-bar @(IsShaking(monster) ? "taking-hit" : "") shake-cycle-@(GetShakeKey(monster) % 4)">
										<div class="hp-fill @GetHPColor(hpPercent)" style="width: @hpPercent%"></div>
									</div>
									<div class="stats-row">
										<span class="hp-text">@monster.CurrentHP / @monster.MaxHP</span>
										@if (!IsRaidBattle)
										{
											<div class="xp-bar">
												<div class="xp-fill" style="width: @(GetXPPercent(monster))%"></div>
											</div>
											<span class="xp-text">@monster.CurrentXP / @monster.XPForNextLevel</span>
										}
									</div>
									@{
										var statuses = GetMonsterStatuses(monster);
										var statStages = GetStatStageIndicators(monster);
										if (statuses.Count > 0 || statStages.Count > 0)
										{
											<div class="status-row">
												@foreach (var status in statuses)
												{
													@{ var sbInfo = GetStatusBadgeInfo(status); }
								<span class="status-badge @status.ToLower()">
									<iconify icon="@sbInfo.Icon" Size=@(13) Color="@sbInfo.Color" />
								</span>
												}
												@foreach (var (statName, stage, isPositive) in statStages)
												{
													<span class="stat-stage-badge @(isPositive ? "buff" : "debuff")">
														<span class="stat-name">@statName</span>
														<span class="stat-arrow">@GetStatStageIcon(stage, isPositive)</span>
													</span>
												}
											</div>
										}
									}
								</div>
							</div>
						</div>

						<!-- Move Selection Popup (appears below active monster) -->
						@if (isActive && CanSelectMoves())
						{
							<div class="move-popup">
								<div class="move-popup-content bb-slanted" onmouseleave=@(() => SetHoveredMove(null))>
									<div class="popup-moves">
										@{
											var moves = GetActiveMoves();
											foreach (var move in moves)
											{
												var moveDef = MoveDatabase.GetMove(move.MoveId);
												if (moveDef != null)
												{
													var elementClass = moveDef.Element.ToString().ToLower();
													var isDisabled = !move.HasPP;
													var capturedMoveId = move.MoveId;
													var effectivenessIndicator = GetMoveEffectivenessIndicator(moveDef);
													var effectivenessClass = GetEffectivenessClass(effectivenessIndicator);
													<div class="move-btn-wrapper" onmouseover=@(() => SetHoveredMove(capturedMoveId))>
														<button class="popup-move-btn @elementClass @(isDisabled ? "disabled" : "") @effectivenessClass"
																onclick=@(() => OnMoveChosen(move.MoveId))>
															<img class="popup-move-icon" src="ui/icons/elements/transparent/@(GetElementIconName(moveDef.Element)).svg" />
															<div class="popup-move-info">
																<span class="popup-move-name">@moveDef.Name</span>
																<span class="popup-move-pp @(move.CurrentPP <= 3 ? "low" : "")">@move.CurrentPP/@moveDef.MaxPP</span>
															</div>
															@if (moveDef.BasePower > 0)
															{
																<span class="popup-move-power">@moveDef.BasePower</span>
															}
															@if (!string.IsNullOrEmpty(effectivenessIndicator) && ShouldShowTypeEffectiveness())
															{
																<span class="effectiveness-badge @effectivenessClass">@effectivenessIndicator</span>
															}
														</button>
													</div>
												}
											}
										}
									</div>
									<button class="popup-swap-btn" onclick=@OnSwapRequested>
										<span class="swap-icon">🔄</span>
										<span class="swap-text">SWAP</span>
									</button>
									@if (!string.IsNullOrEmpty(hoveredMoveId))
									{
										var hoveredMove = MoveDatabase.GetMove(hoveredMoveId);
										if (hoveredMove != null)
										{
											var elemClass = hoveredMove.Element.ToString().ToLower();
											<div class="move-tooltip">
												<div class="tooltip-header">
													<span class="tooltip-name">@hoveredMove.Name</span>
													<span class="tooltip-element @elemClass">@hoveredMove.Element</span>
												</div>
												<div class="tooltip-stats">
													<span>Power: @(hoveredMove.BasePower > 0 ? hoveredMove.BasePower.ToString() : "—")</span>
													<span>Acc: @(hoveredMove.Accuracy)%</span>
													<span>@hoveredMove.Category</span>
												</div>
												<label class="tooltip-desc">@hoveredMove.Description</label>
											</div>
										}
									}
								</div>
							</div>
						}
					</div>
				}
			</div>
		</div>

		<!-- Center: Action Display -->
		<div class="battle-center">
			<!-- Halftone wash — pulses while a move announcement is on-screen -->
			<div class="bb-center-wash @(string.IsNullOrEmpty(currentMoveAnnouncement) ? "" : "active")"></div>
			@if (!string.IsNullOrEmpty(currentMoveAnnouncement))
			{
				<!-- Render-key class makes the slam-in animation re-fire on each new announcement -->
				<div class="move-announcement slam-@announcementKey">
					<span class="move-announcement-text">@currentMoveAnnouncement</span>
				</div>
			}
			@if (GetLastTurn() != null)
			{
				var turn = GetLastTurn();
				<div class="action-display">
					@if (!string.IsNullOrEmpty(turn.MoveName))
					{
						<div class="action-move @GetMoveElementClass(turn.MoveElement)">
							@turn.MoveName
						</div>
					}
					@if (!turn.IsMiss && !turn.IsSwap && turn.Damage > 0)
					{
						var impactClass = turn.IsCritical ? "crit" : (turn.IsSuperEffective && ShouldShowTypeEffectiveness() ? "super" : "");
						<div class="action-damage @impactClass @(turn.IsResisted && ShouldShowTypeEffectiveness() ? "resisted" : "") @(string.IsNullOrEmpty(impactClass) ? "" : "manga-impact") impact-@(turn.TurnNumber)">
							@if (!string.IsNullOrEmpty(impactClass))
							{
								<!-- Manga-impact starburst (5 white rays, low opacity) -->
								<div class="bb-starburst">
									<div class="bb-ray r1"></div>
									<div class="bb-ray r2"></div>
									<div class="bb-ray r3"></div>
									<div class="bb-ray r4"></div>
									<div class="bb-ray r5"></div>
								</div>
							}
							<span class="damage-number">@turn.Damage</span>
							@if (turn.IsCritical) { <span class="damage-tag">@L("ui.battle.crit")</span> }
							@if (turn.IsSuperEffective && ShouldShowTypeEffectiveness()) { <span class="damage-tag super">@L("ui.battle.super")</span> }
							@if (turn.IsResisted && ShouldShowTypeEffectiveness()) { <span class="damage-tag resist">@L("ui.battle.resist")</span> }
						</div>
					}
					@if (turn.IsMiss)
					{
						<div class="action-miss">@L("ui.battle.miss")</div>
					}
					@if (turn.IsSwap)
					{
						<!-- P5 slanted swap banner — re-fires on each swap via key class -->
						<div class="action-swap-banner swap-key-@(turn.TurnNumber)">
							<span class="action-swap-text">SWITCHING IN</span>
							<span class="action-swap-name">@turn.SwapToName</span>
						</div>
					}
				</div>
			}
		</div>

		<!-- Enemy Side -->
		<div class="battle-side enemy-side">
			<div class="side-label">@(IsArenaBattle ? (CompetitiveManager.Instance?.CurrentOpponent?.Name?.ToUpper() ?? "OPPONENT") : "ENEMIES")</div>
			<div class="monsters-container">
				@{
					var enemyTeam = GetEnemyTeam();
					var enemyActive = GetActiveEnemyMonster();
					// For arena: only show active monster (like player side). For expedition: show all (horde mode)
					List<Monster> enemyDisplayOrder;
					if (IsArenaBattle)
					{
						enemyDisplayOrder = new List<Monster>();
						if (enemyActive != null) enemyDisplayOrder.Add(enemyActive);
						enemyDisplayOrder.AddRange(enemyTeam.Where(m => m != null && m != enemyActive));
					}
					else
					{
						enemyDisplayOrder = enemyTeam;
					}
				}
				@foreach (var monster in enemyDisplayOrder)
				{
					if (monster == null) continue;
					var isActive = IsArenaBattle ? (monster == enemyActive) : (monster.CurrentHP > 0);
					var isTargeted = !IsArenaBattle && IsCurrentTarget(monster); // No targeting in arena
					var isAttacker = IsAttacker(monster);
					var isDefender = IsDefender(monster);
					var hpPercent = GetDisplayedHPPercent(monster);
					var isKO = monster.CurrentHP <= 0;
					var isBoss = IsBossWave() && !IsArenaBattle && IsBossMonster(monster);
					var isRareBoss = isBoss && IsRareBossEncounter();

					<div class="monster-card-wrapper">
						<div class="monster-card enemy @(isActive ? "active" : "benched") @(isTargeted ? "targeted" : "") @(isAttacker ? "attacking" : "") @(isDefender ? "hit" : "") @(isKO ? "ko" : "") @(IsArenaBattle ? "no-target" : "") @(isBoss ? "boss-monster" : "") @(isRareBoss ? "rare-boss" : "")"
							 onclick=@(() => OnEnemyTargetSelected(monster))>
							@if (isBoss)
							{
								<div class="boss-indicator @(isRareBoss ? "legendary" : "")">
									<span class="boss-label">@(isRareBoss ? "LEGENDARY" : "BOSS")</span>
								</div>
							}
							<div class="card-glow"></div>
							<div class="card-content">
								<div class="monster-sprite-area">
									@if (HasSprite(monster))
									{
										<div class="sprite" style="background-image: url(@GetAnimatedSpritePath(monster))"></div>
									}
									else
									{
										<div class="sprite-placeholder">?</div>
									}
									@if (isDefender && GetLastDamage(monster) > 0 && ShouldShowDamageNumbers())
									{
										<div class="damage-number">-@GetLastDamage(monster)</div>
									}
									@if (isKO)
									{
										<div class="ko-badge">@L("ui.battle.ko")</div>
									}
								</div>
								<div class="monster-info">
									<div class="name-row">
										<span class="monster-name @((monster.Nickname ?? "Monster").Length > 9 ? "long-name" : "")">@(monster.Nickname ?? "Monster")</span>
										<span class="monster-level">Lv.@monster.Level</span>
									</div>
									<div class="hp-bar @(IsShaking(monster) ? "taking-hit" : "") shake-cycle-@(GetShakeKey(monster) % 4)">
										<div class="hp-fill @GetHPColor(hpPercent)" style="width: @hpPercent%"></div>
									</div>
									<div class="hp-text">@(IsRaidBattle ? L("ui.battle.raid_boss") : $"{monster.CurrentHP} / {monster.MaxHP}")</div>
									@{
										var enemyStatuses = GetMonsterStatuses(monster);
										var enemyStatStages = GetStatStageIndicators(monster);
										if (enemyStatuses.Count > 0 || enemyStatStages.Count > 0)
										{
											<div class="status-row">
												@foreach (var status in enemyStatuses)
												{
													@{ var sbInfo = GetStatusBadgeInfo(status); }
								<span class="status-badge @status.ToLower()">
									<iconify icon="@sbInfo.Icon" Size=@(13) Color="@sbInfo.Color" />
								</span>
												}
												@foreach (var (statName, stage, isPositive) in enemyStatStages)
												{
													<span class="stat-stage-badge @(isPositive ? "buff" : "debuff")">
														<span class="stat-name">@statName</span>
														<span class="stat-arrow">@GetStatStageIcon(stage, isPositive)</span>
													</span>
												}
											</div>
										}
									}
								</div>
							</div>
						</div>
					</div>
				}
			</div>
		</div>
	</div>

	<!-- 3D Battle HUD Overlay (always in DOM, hidden via CSS when not in 3D mode) -->
	@{
		var playerMon3D = Use3DBattle ? GetPlayerActiveMonster() : null;
		var enemyMon3D = Use3DBattle ? GetActiveEnemyMonster() : null;
		var playerSpecies3D = playerMon3D != null ? MonsterManager.Instance?.GetSpecies(playerMon3D.SpeciesId) : null;
		var enemySpecies3D = enemyMon3D != null ? MonsterManager.Instance?.GetSpecies(enemyMon3D.SpeciesId) : null;
	}

	<!-- Enemy Info Panels (top-right, diamond on RIGHT) -->
	@if (Use3DBattle && !BattleTransition.IsActive)
	{
		var enemyTeam3D = GetEnemyTeam();
		var activeEnemy3D = GetActiveEnemyMonster();
		var enemyIdx3D = 0;
		var sceneCtrl = BattleSceneController.Instance;
		var isWaveEntering = sceneCtrl != null && sceneCtrl.IsWaveTransitioning;
		var enterProgress = sceneCtrl?.WaveEnterProgress ?? 1f;
		// Render cached defeated enemies that are still fading out (may no longer be in current team)
		@foreach (var cachedEnemy in defeatedMonsterCache.Values.Where(m => m != null && (enemyTeam3D == null || !enemyTeam3D.Contains(m)) && defeatedFadeTimers.ContainsKey(m.Id)).Reverse())
		{
			var species = MonsterManager.Instance?.GetSpecies(cachedEnemy.SpeciesId);
			var idx = enemyIdx3D;
			var enemyElClass = species != null ? GetElementIconName(species.Element) : "neutral";
			var defeatTimeLeft = defeatedFadeTimers[cachedEnemy.Id];
			var isInHoldPhase = defeatTimeLeft > DEFEAT_FADE_DURATION;
			var fadeProgress = isInHoldPhase ? 1f : MathF.Max(0f, defeatTimeLeft / DEFEAT_FADE_DURATION);
			var fadeSlide = !isInHoldPhase ? (int)(60 * (1f - fadeProgress)) : 0;
			var cachedHasDual = species?.SecondaryElement.HasValue == true;
			var cachedSecondaryElClass = cachedHasDual ? GetElementIconName(species.SecondaryElement.Value) : "neutral";
			<div class="panel3d-diamond-wrapper enemy-panel-wrapper wave-entering fading-out secondary @(cachedHasDual ? "dual-typed" : "")"
				 style="top: @(28 + idx * 110)px; right: @(36 - fadeSlide)px; position: absolute; opacity: @fadeProgress;">
				<div class="panel3d-card enemy-card">
					<div class="panel3d-card-content">
						<div class="panel3d-header">
							<span class="panel3d-name">@(species?.Name ?? "???")</span>
							<span class="panel3d-level">Lv @(cachedEnemy.Level)</span>
							<span class="panel3d-target-num">#@GetEnemyTargetSlot(cachedEnemy)</span>
						</div>
						<div class="panel3d-hp-row">
							<span class="panel3d-hp-label">HP</span>
							<div class="panel3d-hp-track">
								<div class="panel3d-hp-fill danger" style="width: 0%"></div>
							</div>
							<span class="panel3d-hp-nums">0 / @(cachedEnemy.MaxHP.ToString("N0"))</span>
						</div>
					</div>
				</div>
				<div class="panel3d-diamond enemy-diamond el-bg-@enemyElClass">
					<img class="panel3d-diamond-icon" src="ui/icons/elements/element_white/@(enemyElClass).svg" />
				</div>
				@if (cachedHasDual)
				{
					<div class="panel3d-diamond-secondary enemy-secondary el-bg-@cachedSecondaryElClass">
						<img class="panel3d-diamond-icon-secondary" src="ui/icons/elements/element_white/@(cachedSecondaryElClass).svg" />
					</div>
				}
			</div>
			enemyIdx3D++;
		}
		if (enemyTeam3D != null && (!isWaveEntering || enterProgress > 0f))
		{
		@foreach (var enemy in BuildEnemyHpCardOrder3D(enemyTeam3D))
		{
			var species = MonsterManager.Instance?.GetSpecies(enemy.SpeciesId);
			var isActive = enemy == activeEnemy3D;
			var isTargeted = IsCurrentTarget(enemy);
			var idx = enemyIdx3D;
			var enemyElClass = species != null ? GetElementIconName(species.Element) : "neutral";
			var isFading = defeatedFadeTimers.ContainsKey(enemy.Id);
			var defeatTimeLeft = isFading ? defeatedFadeTimers[enemy.Id] : 0f;
			var isInHoldPhase = defeatTimeLeft > DEFEAT_FADE_DURATION;
			var fadeProgress = isFading ? (isInHoldPhase ? 1f : MathF.Max(0f, defeatTimeLeft / DEFEAT_FADE_DURATION)) : 1f;
			var panelOpacity = isWaveEntering ? enterProgress : (isFading ? fadeProgress : 1f);
			var enterSlide = isWaveEntering ? (int)(60 * (1f - enterProgress)) : 0;
			var fadeSlide = isFading && !isInHoldPhase ? (int)(60 * (1f - fadeProgress)) : 0;
			var enemyHasDual = species?.SecondaryElement.HasValue == true;
			var enemySecondaryElClass = enemyHasDual ? GetElementIconName(species.SecondaryElement.Value) : "neutral";
			<div class="panel3d-diamond-wrapper enemy-panel-wrapper @(isWaveEntering || hasCompletedWaveTransition ? "wave-entering" : "") @(isFading ? "fading-out" : "") @(idx == 0 ? "" : "secondary") @(isTargeted ? "targeted" : "") @(enemyHasDual ? "dual-typed" : "") "
				 style="@(!Use3DBattle ? "display: none;" : "") top: @(28 + idx * 110)px; right: @(36 - fadeSlide - enterSlide)px; position: absolute; opacity: @panelOpacity;"
				>
				<div class="panel3d-card enemy-card">
					<div class="panel3d-card-content">
						<div class="panel3d-header">
							<span class="panel3d-name">@(species?.Name ?? "???")</span>
							<span class="panel3d-level">Lv @(enemy.Level)</span>
							<span class="panel3d-target-num">#@GetEnemyTargetSlot(enemy)</span>
						</div>
						<div class="panel3d-hp-row">
							<span class="panel3d-hp-label">HP</span>
							<div class="panel3d-hp-track @(IsShaking(enemy) ? "taking-hit" : "") shake-cycle-@(GetShakeKey(enemy) % 4)">
								<div class="panel3d-hp-fill @GetHPColorClass3D(enemy)" style="width: @GetDisplayedHPPercent(enemy)%"></div>
							</div>
							<span class="panel3d-hp-nums">@(GetDisplayedHP(enemy).ToString("N0")) / @(enemy.MaxHP.ToString("N0"))</span>
						</div>
					</div>
				</div>
				<div class="panel3d-diamond enemy-diamond el-bg-@enemyElClass">
					<img class="panel3d-diamond-icon" src="ui/icons/elements/element_white/@(enemyElClass).svg" />
				</div>
				@if (enemyHasDual)
				{
					<div class="panel3d-diamond-secondary enemy-secondary el-bg-@enemySecondaryElClass">
						<img class="panel3d-diamond-icon-secondary" src="ui/icons/elements/element_white/@(enemySecondaryElClass).svg" />
					</div>
				}
			</div>
			enemyIdx3D++;
		}
		}
	}

	<!-- Player Info Panel (top-left, diamond on LEFT) -->
	@if (playerMon3D != null && !BattleTransition.IsActive)
	{
		var playerElClass = playerSpecies3D != null ? GetElementIconName(playerSpecies3D.Element) : "neutral";
		var playerFading = defeatedFadeTimers.ContainsKey(playerMon3D.Id);
		var playerDefeatTimeLeft = playerFading ? defeatedFadeTimers[playerMon3D.Id] : 0f;
		var playerInHold = playerDefeatTimeLeft > DEFEAT_FADE_DURATION;
		var playerFadeProgress = playerFading ? (playerInHold ? 1f : MathF.Max(0f, playerDefeatTimeLeft / DEFEAT_FADE_DURATION)) : 1f;
		var playerFadeSlide = playerFading && !playerInHold ? (int)(60 * (1f - playerFadeProgress)) : 0;
		var playerHasDual = playerSpecies3D?.SecondaryElement.HasValue == true;
		var playerSecondaryElClass = playerHasDual ? GetElementIconName(playerSpecies3D.SecondaryElement.Value) : "neutral";
		<div class="panel3d-diamond-wrapper player-panel-wrapper @(playerHasDual ? "dual-typed" : "") @(playerFading ? "fading-out" : "")" style="@(!Use3DBattle ? "display: none;" : "") top: 28px; left: @(36 - playerFadeSlide)px; position: absolute; opacity: @playerFadeProgress;">
			<div class="panel3d-diamond el-bg-@playerElClass">
				<img class="panel3d-diamond-icon" src="ui/icons/elements/element_white/@(playerElClass).svg" />
			</div>
			@if (playerHasDual)
			{
				<div class="panel3d-diamond-secondary el-bg-@playerSecondaryElClass">
					<img class="panel3d-diamond-icon-secondary" src="ui/icons/elements/element_white/@(playerSecondaryElClass).svg" />
				</div>
			}
			<div class="panel3d-card">
				<div class="panel3d-card-content">
					<div class="panel3d-header">
						<span class="panel3d-name">@(playerMon3D.Nickname ?? playerSpecies3D?.Name ?? "???")</span>
						<span class="panel3d-level">Lv @(playerMon3D.Level)</span>
					</div>
					<div class="panel3d-hp-row">
						<span class="panel3d-hp-label">HP</span>
						<div class="panel3d-hp-track @(IsShaking(playerMon3D) ? "taking-hit" : "") shake-cycle-@(GetShakeKey(playerMon3D) % 4)">
							<div class="panel3d-hp-fill @GetHPColorClass3D(playerMon3D)" style="width: @GetDisplayedHPPercent(playerMon3D)%"></div>
						</div>
						<span class="panel3d-hp-nums">@(GetDisplayedHP(playerMon3D).ToString("N0")) / @(playerMon3D.MaxHP.ToString("N0"))</span>
					</div>
					<div class="panel3d-xp-bar">
						<div class="panel3d-xp-fill" style="width: @GetXPPercent(playerMon3D)%"></div>
					</div>
				</div>
			</div>
		</div>
	}

	<!-- Ambient Particles (3D mode only) -->
	@if (Use3DBattle)
	{
		<div class="battle3d-ambient">
			<div class="ambient-particle p1"></div>
			<div class="ambient-particle p2"></div>
			<div class="ambient-particle p3"></div>
			<div class="ambient-particle p4"></div>
			<div class="ambient-particle p5"></div>
			<div class="ambient-particle p6"></div>
		</div>
		<div class="battle3d-vignette"></div>
	}

	<!-- Wave Indicator (top center) -->
	@if (Use3DBattle && !BattleTransition.IsActive && !ExpeditionResultPopup.IsVisible)
	{
		<div class="wave-indicator-container">
			<div class="wave-badge bb-skewed-badge @(IsBossWave() ? "wave-boss" : "")">
				<div class="bb-skewed-badge-inner">
					<span class="wave-text">@GetWaveBadgeText()</span>
				</div>
				<div class="bb-skewed-badge-underline"></div>
			</div>
		</div>
	}

	<!-- Battle Ticker (bottom-center, one line at a time) -->
	@if (Use3DBattle && !BattleTransition.IsActive && !ExpeditionResultPopup.IsVisible)
	{
		var tickerEntry = GetTickerEntry();
		@if (tickerEntry != null)
		{
			var tickerVisible = IsTickerEntryVisible(tickerEntry);
			var diamondClass = GetLogDiamondClass(tickerEntry);
			var turnClass = tickerEntry.IsPlayerAttacker ? "player-turn" : "enemy-turn";
			<div class="battle-ticker-host @(tickerVisible ? "visible" : "")">
				<div class="battle-ticker @tickerEntry.Type @turnClass">
					<div class="ticker-diamond @diamondClass">
						<iconify icon="@GetLogIconify(tickerEntry)" Size=@(14) Color="white" />
					</div>
					<span class="ticker-text">@tickerEntry.Text</span>
				</div>
			</div>
		}
	}

	<!-- 3D Action Bar (bottom) -->
	@if (Use3DBattle && !BattleTransition.IsActive && !ExpeditionResultPopup.IsVisible)
	{
	<div class="battle3d-action-bar">
		@{
			var barState = GetActionBarState();
			var awaitingInput = CanSelectMoves();
		}

		<!-- Diamond Action Buttons (state: actions OR moves OR targets; FIGHT
		     is shared and toggles. In moves state the 4 secondaries are
		     replaced by 4 element-tinted move diamonds; in targets state, by
		     up to 3 element-tinted enemy diamonds in the SWITCH/BAG/CONTRACT
		     slots. Clicking FIGHT in either sub-state returns to actions or
		     moves.) -->
		@if ((barState == "actions" || barState == "moves" || barState == "targets" || barState == "swap") && !showNegotiationOverlay)
		{
			var turnsPlaying = BattleManager.Instance?.IsPlaying == true && !BattleManager.Instance.IsWaitingForPlayerInput;
			var sceneAnimating = BattleSceneController.Instance != null && (BattleSceneController.Instance.IsWaveTransitioning);
			// Also gate on the 3D scene still playing queued turn animations
			// or waiting for a faint to finish — simulation can flip
			// IsWaitingForPlayerInput back on before the scene catches up, and
			// the player shouldn't be able to queue a new move while the
			// prior turn is mid-animation.
			var scenePlayingTurns = BattleSceneController.Instance?.IsPlayingTurns == true;
			var buttonsDisabled = turnsPlaying || sceneAnimating || scenePlayingTurns;
			var inMoves = barState == "moves";
			var inTargets = barState == "targets";
			var inSwap = barState == "swap";
			var inContractTargeting = inTargets && isContractTargeting;
			var inSubState = inMoves || inTargets || inSwap;
			// FIGHT acts as BACK in moves + (move-)targets sub-states. In CONTRACT
			// targeting we hide FIGHT and render a normal-sized contract diamond
			// as the back button instead. In SWAP, FIGHT is replaced by the
			// ▶ rotate-right secondary diamond.
			var showFightButton = !inContractTargeting && !inSwap;
			var fightIcon = inSubState ? "lucide:arrow-left" : "lucide:swords";
			var fightLabel = inSubState ? "BACK" : "FIGHT";
			var clusterClass = inMoves ? "in-moves" : (inTargets ? "in-targets" : (inSwap ? "in-swap" : "")) + (inContractTargeting ? " in-contract" : "");
			if (barState != lastObservedBarState)
			{
				lastObservedBarState = barState;
				clusterPulseKey++;
				clusterFlashSince = 0f;
			}
			var fightClass = (awaitingInput ? "awaiting" : "") + " " + (buttonsDisabled ? "disabled" : "") + " " + ((inMoves || inTargets) ? "is-back" : "");
			// Shared move-info panel: rendered BEFORE cluster-bg in DOM so it
			// stacks BEHIND the dark slab + yellow border. Content updates
			// based on hoveredMoveSlot. All data prep goes through
			// TryFillHoveredMove3D and TryFillHoveredEnemy3D — keeps generics
			// out of the markup body.
			string hoveredPP = "";
			string hoveredPwr = "";
			string hoveredDesc = "";
			string hoveredMoveName = "";
			bool sharedPanelActive = false;
			if (inMoves)
			{
				sharedPanelActive = TryFillHoveredMove3D( hoveredMoveSlot, out hoveredMoveName, out hoveredPP, out hoveredPwr, out hoveredDesc );
			}

			string hoveredEnemyName = "";
			string hoveredEnemySub = "";
			string hoveredEnemyHP = "";
			bool targetPanelActive = false;
			if (inTargets)
			{
				targetPanelActive = TryFillHoveredEnemy3D( hoveredTargetSlot, out hoveredEnemyName, out hoveredEnemySub, out hoveredEnemyHP );
			}

			string swapBeastName = "";
			string swapBeastSub = "";
			string swapBeastHP = "";
			bool swapPanelActive = false;
			if (inSwap)
			{
				swapPanelActive = TryFillCurrentSwapTarget3D( out swapBeastName, out swapBeastSub, out swapBeastHP );
			}

			<div class="action3d-buttons panel-in @clusterClass">
				@if (inMoves)
				{
					<div class="move-info-panel-shared @(sharedPanelActive ? "active" : "")">
						@if (sharedPanelActive)
						{
							<div class="mvi-name">@hoveredMoveName</div>
							<div class="mvi-stats">
								<span class="mvi-pp">@hoveredPP</span>
								<span class="mvi-pwr">@hoveredPwr</span>
							</div>
							<div class="mvi-desc">@hoveredDesc</div>
						}
					</div>
				}
				@if (inTargets)
				{
					<div class="move-info-panel-shared @(targetPanelActive ? "active" : "")">
						@if (targetPanelActive)
						{
							<div class="mvi-name">@hoveredEnemyName</div>
							<div class="mvi-stats">
								<span class="mvi-pp">@hoveredEnemySub</span>
								<span class="mvi-pwr">@hoveredEnemyHP</span>
							</div>
						}
					</div>
				}
				@if (inSwap)
				{
					<div class="move-info-panel-shared @(swapPanelActive ? "active" : "")">
						@if (swapPanelActive)
						{
							<div class="mvi-name">@swapBeastName</div>
							<div class="mvi-stats">
								<span class="mvi-pp">@swapBeastSub</span>
								<span class="mvi-pwr">@swapBeastHP</span>
							</div>
						}
					</div>
				}
				<div class="action3d-cluster-bg">
				</div>
				@if (inContractTargeting)
				{
					<div class="action3d-btn contract-back is-secondary" onclick=@OnContractBack onmouseover=@(() => HoverBtn(41))>
						<div class="action3d-diamond">
							<iconify icon="lucide:arrow-left" Size=@(28) Color="white" />
						</div>
						<span class="action3d-label">BACK</span>
					</div>
				}
				@if (showFightButton)
				{
				<div class="action3d-btn fight @fightClass" onclick=@OnFight3D onmouseover=@(() => HoverBtn(1))>
					<div class="action3d-diamond">
						<div class="fight-flame-stack">
							<div class="fight-flame-layer fl-back"></div>
							<div class="fight-flame-layer fl-mid"></div>
							<div class="fight-flame-layer fl-front"></div>
						</div>
						<div class="fight-ring"></div>
						<iconify icon="@fightIcon" Size=@(44) Color="white" />
						@if (IsFightBurstActive)
						{
							<div class="fight-burst burst-@fightBurstKey">
								<div class="fb-ember fb-e1"></div>
								<div class="fb-ember fb-e2"></div>
								<div class="fb-ember fb-e3"></div>
								<div class="fb-ember fb-e4"></div>
								<div class="fb-ember fb-e5"></div>
								<div class="fb-ember fb-e6"></div>
								<div class="fb-ember fb-e7"></div>
								<div class="fb-ember fb-e8"></div>
							</div>
						}
					</div>
					<span class="action3d-label">@fightLabel</span>
				</div>
				}

				@if (!inSubState)
				{
					<div class="action3d-btn swap is-secondary @(buttonsDisabled ? "disabled" : "")" onclick=@OnSwapRequested onmouseover=@(() => HoverBtn(2))>
						<div class="action3d-diamond">
							<iconify icon="lucide:repeat-2" Size=@(28) Color="white" />
						</div>
						<span class="action3d-label">SWITCH</span>
					</div>
					<div class="action3d-btn bag is-secondary @(buttonsDisabled ? "disabled" : "")" onclick=@OnOpenBag onmouseover=@(() => HoverBtn(3))>
						<div class="action3d-diamond">
							<iconify icon="lucide:briefcase" Size=@(28) Color="white" />
						</div>
						<span class="action3d-label">BAG</span>
					</div>
					@if (!IsArenaBattle && !IsRaidBattle)
					{
						<div class="action3d-btn contract contract-btn is-secondary @(buttonsDisabled || !HasContractInk() ? "disabled" : "")" onclick=@OnContract3D onmouseover=@(() => HoverBtn(4))>
							<div class="action3d-diamond">
								<iconify icon="lucide:scroll-text" Size=@(28) Color="white" />
							</div>
							<span class="action3d-label">CONTRACT</span>
						</div>
					}
					<div class="action3d-end @(buttonsDisabled ? "disabled" : "")" onclick=@OnEndClicked onmouseover=@(() => HoverBtn(5))>
						<div class="end-diamond">
							<iconify icon="lucide:log-out" Size=@(22) Color="white" />
						</div>
						<span class="end-label">END</span>
					</div>
				}
				else if (inMoves)
				{
					@foreach (var moveSlot in BuildMoveSlots3D(buttonsDisabled))
					{
						<div class="action3d-btn move is-secondary el-bg-@moveSlot.ElementClass @moveSlot.SlotClass @moveSlot.DisabledClass" onclick=@(() => { if (!moveSlot.IsDisabled) OnMoveChosen3D(moveSlot.MoveId); }) onmouseover=@(() => OnMoveSlotHover(moveSlot.Index))>
							<div class="action3d-diamond">
								<img class="action3d-element-icon" src="@moveSlot.IconSrc" />
							</div>
							<span class="action3d-label">@moveSlot.MoveName</span>
						</div>
					}
				}
				else if (inTargets)
				{
					@foreach (var enemySlot in BuildEnemySlots3D(buttonsDisabled))
					{
						<div class="action3d-btn enemy is-secondary el-bg-@enemySlot.ElementClass @enemySlot.SlotClass @enemySlot.DisabledClass" onclick=@(() => { if (!enemySlot.IsDisabled) OnTargetChosen3D(enemySlot.EnemyRef); }) onmouseover=@(() => OnTargetSlotHover(enemySlot.Index))>
							<div class="action3d-diamond">
								<img class="action3d-beast-icon" src="@enemySlot.SpriteSrc" />
								<div class="beast-num-badge">@enemySlot.SlotNum</div>
							</div>
							<span class="action3d-label">@enemySlot.DisplayName</span>
						</div>
					}
				}
				else if (inSwap)
				{
					var canConfirmSwap = !IsSwapTargetActive() && !buttonsDisabled;
					var confirmDisabledClass = canConfirmSwap ? "" : "disabled";
					<div class="action3d-btn swap-back is-secondary sw-back-slot" onclick=@OnSwapBack onmouseover=@(() => HoverBtn(60))>
						<div class="action3d-diamond">
							<iconify icon="lucide:arrow-left" Size=@(28) Color="white" />
						</div>
						<span class="action3d-label">BACK</span>
					</div>
					<div class="action3d-btn swap-rotate is-secondary sw-left-slot @(buttonsDisabled ? "disabled" : "")" onclick=@OnSwapCarouselLeft onmouseover=@(() => HoverBtn(61))>
						<div class="action3d-diamond">
							<iconify icon="lucide:chevron-left" Size=@(32) Color="white" />
						</div>
						<span class="action3d-label">PREV</span>
					</div>
					<div class="action3d-btn swap-rotate is-secondary sw-right-slot @(buttonsDisabled ? "disabled" : "")" onclick=@OnSwapCarouselRight onmouseover=@(() => HoverBtn(62))>
						<div class="action3d-diamond">
							<iconify icon="lucide:chevron-right" Size=@(32) Color="white" />
						</div>
						<span class="action3d-label">NEXT</span>
					</div>
					<div class="action3d-btn swap-confirm is-secondary sw-confirm-slot @confirmDisabledClass" onclick=@(() => { if (canConfirmSwap) OnSwapConfirm(); }) onmouseover=@(() => HoverBtn(63))>
						<div class="action3d-diamond">
							<iconify icon="lucide:check" Size=@(32) Color="white" />
						</div>
						<span class="action3d-label">SWAP</span>
					</div>
				}
			</div>
		}

		<!-- (Move picker is now rendered as element-tinted diamonds inside the
		     action-bar cluster above — see the else branch in the
		     actions/moves conditional. The old linear pill row was retired.) -->

		<!-- (Swap-bar legacy carousel disabled — replaced by the 4-diamond
		     swap layout inside the action-buttons cluster above.) -->
		@if (false && barState == "swap" && swapTargets != null && swapTargets.Count > 0)
		{
			var swapMon = swapCarouselIndex < swapTargets.Count ? swapTargets[swapCarouselIndex] : null;
			var swapSpecies = swapMon != null ? MonsterManager.Instance?.GetSpecies(swapMon.SpeciesId) : null;
			var isActive = IsSwapTargetActive();

			<div class="swap-bar panel-in">
				<div class="swap-confirm-btn @(isActive ? "active" : "")" onclick=@OnSwapConfirm onmouseover=@(() => HoverBtn(25))>
					<iconify icon="lucide:repeat-2" Size=@(20) Color="white" />
					<span class="swap-confirm-text">@(isActive ? "ACTIVE" : "SWAP")</span>
				</div>

				@if (swapTargets.Count > 1)
				{
					<div class="swap-bar-arrow" onmouseover=@(() => HoverBtn(23)) onclick=@OnSwapCarouselLeft>
						<iconify icon="lucide:chevron-left" Size=@(22) Color="white" />
					</div>
				}

				<div class="swap-bar-info">
					@if (swapMon != null)
					{
						<span class="swap-bar-name">@(swapMon.Nickname ?? swapSpecies?.Name ?? "???")</span>
						<span class="swap-bar-detail">Lv @(swapMon.Level)@(isActive ? " — Active" : "")</span>
					}
				</div>

				@if (swapTargets.Count > 1)
				{
					<div class="swap-bar-arrow" onmouseover=@(() => HoverBtn(24)) onclick=@OnSwapCarouselRight>
						<iconify icon="lucide:chevron-right" Size=@(22) Color="white" />
					</div>
				}

				<div class="move3d-back" onmouseover=@(() => HoverBtn(22)) onclick=@OnSwapBack>
					<iconify icon="ph:arrow-left-bold" Size=@(24) Color="white" />
				</div>
			</div>
		}


	</div>
	}

	<!-- (Legacy target picker overlay removed — replaced by element-tinted
	     enemy diamonds rendered inside the action-buttons cluster above.) -->

	<!-- Bottom Action Bar (2D mode only) -->
	<div class="action-bar" style="@(Use3DBattle ? "display: none;" : "")">
		<div class="auto-controls">
			@if (!IsArenaBattle && !IsRaidBattle)
			{
				<button class="control-btn play-btn @(IsPlaying() ? "playing" : "")" onclick=@OnPlayPause>
					<span class="btn-icon">@(IsPlaying() ? "⏸" : "▶")</span>
				</button>
			}

			@if (!IsArenaBattle && !IsRaidBattle)
			{
				<div class="toggle-group">
					<div class="toggle-item @(GetAutoCatch() ? "active" : "")" onclick=@ToggleAutoCatch>
						<div class="toggle-switch"></div>
						<span class="toggle-label">@L("ui.battle.auto_contract")</span>
					</div>
					@if (GetAutoCatch())
					{
						<div class="strategy-selector">
							<div class="strategy-chip skip @(GetAutoNegotiateStrategy() == -1 ? "selected" : "")" onclick=@(() => SetAutoNegotiateStrategy(-1))>@L("ui.battle.skip")</div>
							<div class="strategy-chip @(GetAutoNegotiateStrategy() == 0 ? "selected" : "")" onclick=@(() => SetAutoNegotiateStrategy(0))>@L("ui.battle.gen") <span class="ink-cost">3<img class="currency-icon" src="ui/icons/currency/ink.svg" /></span></div>
							<div class="strategy-chip @(GetAutoNegotiateStrategy() == 1 ? "selected" : "")" onclick=@(() => SetAutoNegotiateStrategy(1))>@L("ui.battle.fair") <span class="ink-cost">2<img class="currency-icon" src="ui/icons/currency/ink.svg" /></span></div>
							<div class="strategy-chip @(GetAutoNegotiateStrategy() == 2 ? "selected" : "")" onclick=@(() => SetAutoNegotiateStrategy(2))>@L("ui.battle.str") <span class="ink-cost">1<img class="currency-icon" src="ui/icons/currency/ink.svg" /></span></div>
							<div class="strategy-chip @(GetAutoNegotiateStrategy() == 3 ? "selected" : "")" onclick=@(() => SetAutoNegotiateStrategy(3))>@L("ui.battle.gold") <span class="ink-cost">2<img class="currency-icon" src="ui/icons/currency/ink.svg" /></span></div>
							<div class="strategy-chip target @(GetAutoContractTargetSpecies() != null ? "selected" : "")" onclick=@OpenContractTargetSearch>
								@if (GetAutoContractTargetSpecies() != null)
								{
									var targetName = MonsterManager.Instance?.GetSpecies(GetAutoContractTargetSpecies())?.Name ?? "?";
									<span>@($"TARGET: {targetName}")</span>
								}
								else
								{
									<span>@L("ui.battle.target")</span>
								}
							</div>
							@if (GetAutoContractTargetSpecies() != null)
							{
								<div class="strategy-chip clear" onclick=@ClearContractTarget>✕</div>
							}
						</div>
					}
				</div>

				@if (!IsRaidBattle)
				{
					<button class="control-btn end-btn" onclick=@OnEndExpedition>
						<span class="btn-icon">✕</span>
						<span class="btn-label">@L("ui.battle.end")</span>
					</button>
				}
			}

			@if (IsArenaBattle)
			{
				@if (showRetireConfirm)
				{
					<div class="retire-confirm">
						<span class="retire-confirm-text">@L("ui.battle.retire_confirm")</span>
						<button class="control-btn retire-yes" onclick=@OnRetireConfirmed>
							<span class="btn-label">@L("ui.battle.yes_retire")</span>
						</button>
						<button class="control-btn retire-no" onclick=@(() => showRetireConfirm = false)>
							<span class="btn-label">@L("ui.battle.cancel")</span>
						</button>
					</div>
				}
				else
				{
					<button class="control-btn retire-btn" onclick=@(() => showRetireConfirm = true)>
						<span class="btn-icon">🚪</span>
						<span class="btn-label">@L("ui.battle.retire")</span>
					</button>
				}
			}
		</div>

		<!-- Target indicator (shown when in manual mode, not arena - arena auto-targets active enemy) -->
		@if (CanSelectMoves() && !IsArenaBattle)
		{
			<div class="target-indicator">
				@{
					var currentTarget = GetSelectedTarget();
					if (currentTarget != null)
					{
						<span class="target-label">TARGET:</span>
						<span class="target-name">@currentTarget.Nickname</span>
						<span class="target-hint">(click enemy to change)</span>
					}
				}
			</div>
		}

		<!-- Battle log is now in the wave indicator dropdown above -->
	</div>

	<!-- Contract Negotiation (radial, no overlay) -->
	@if (showNegotiationOverlay && negotiationTarget != null)
	{
		<ContractNegotiationPanel @ref=negotiationPanel IsVisible=@true
								  TargetMonster=@negotiationTarget
								  IsBossContract=@isBossContract
								  OnNegotiationComplete=@OnNegotiationComplete />
	}

	<!-- ============================================================
	     PASS 2 — Chat & Radio docks (in-battle)
	     Compact panels at the bottom corners of the battle view.
	     Show live state inline, click body to open the full popup.
	     Visible in BOTH 2D AND 3D combat — for 3D this is the only
	     chat/radio access point since the command bar is hidden.
	     ============================================================ -->
	@if (!BattleTransition.IsActive)
	{
		var latestChat = GetLatestBattleChat();
		var hasChat = latestChat != null;
		var radioStation = RadioManager.CurrentStation;
		var radioTrack = RadioManager.CurrentTrack;
		var hasRadio = radioStation != null && radioTrack != null;

		<!-- Chat dock — bottom-left -->
		<div class="battle-dock-chat @(hasChat ? "" : "empty")" onclick=@OnDockChatClick>
			<!-- Tab prefix: dark purple slab on the left edge with a chat glyph,
			     reads as "press to open." Inner content counter-skewed so the
			     icon doesn't shear with the parent's skewX(-4deg). -->
			<div class="dock-tab dock-tab-chat">
				<div class="dock-tab-inner">
					<iconify icon="lucide:message-square" Size=@(18) Color="#1a0e2e" />
				</div>
			</div>
			@if (hasChat)
			{
				<div class="dock-content">
					<div class="dock-chat-avatar av-@latestChat.ResolvedNameColor">
						<img src="avatar:@latestChat.SteamId" />
					</div>
					<div class="dock-chat-body">
						<span class="dock-chat-line">
							<span class="dock-chat-name c-@latestChat.ResolvedNameColor">@latestChat.PlayerName</span>
							<span class="dock-chat-text">@TruncateChat(latestChat.Content)</span>
						</span>
					</div>
				</div>
			}
			else
			{
				<div class="dock-content dock-content-empty">
					<span class="dock-empty-label">Open chat</span>
				</div>
			}
		</div>

		<!-- Radio dock — bottom-right (hidden if no station playing) -->
		@if (hasRadio)
		{
			<div class="battle-dock-radio">
				<!-- Tab prefix: yellow slab on the left edge, reads as the
				     "alive" half of the dock pair. Inner content counter-skewed. -->
				<div class="dock-tab dock-tab-radio">
					<div class="dock-tab-inner">
						<iconify icon="lucide:radio" Size=@(18) Color="#1a0e2e" />
					</div>
				</div>
				<div class="dock-content">
					<div class="dock-radio-cover" onclick=@OnDockRadioBodyClick>
						<span class="dock-radio-emoji">@(radioStation?.Icon ?? "📻")</span>
					</div>
					<div class="dock-radio-info" onclick=@OnDockRadioBodyClick>
						<span class="dock-radio-station">@radioStation.Name</span>
						<span class="dock-radio-track">@radioTrack.Name</span>
					</div>
					<!-- Tiny EQ bar — 4 vertical yellow bars with staggered scaleY
					     anim. Continuous infinite animation. Hidden when paused. -->
					@if (RadioManager.IsPlaying)
					{
						<div class="dock-radio-eq">
							<span class="eq-bar"></span>
							<span class="eq-bar"></span>
							<span class="eq-bar"></span>
							<span class="eq-bar"></span>
						</div>
					}
					<div class="dock-radio-controls">
						<button class="dock-radio-btn" onclick=@OnDockRadioPrev>
							<iconify icon="lucide:skip-back" Size=@(14) Color="rgba(255,255,255,0.85)" />
						</button>
						<button class="dock-radio-btn dock-radio-btn-play" onclick=@OnDockRadioToggle>
							<iconify icon="@(RadioManager.IsPlaying ? "lucide:pause" : "lucide:play")" Size=@(14) Color="#ffffff" />
						</button>
						<button class="dock-radio-btn" onclick=@OnDockRadioNext>
							<iconify icon="lucide:skip-forward" Size=@(14) Color="rgba(255,255,255,0.85)" />
						</button>
					</div>
				</div>
			</div>
		}
	}

	@if (contractTargetSearchOpen)
	{
		<div class="contract-search-overlay" onclick=@CloseContractTargetSearch>
			<div class="contract-search-popup" onclick=@((e) => e.StopPropagation())>
				<div class="contract-search-header">
					<span class="contract-search-title">@L("ui.battle.target_beast")</span>
					<button class="contract-search-close" onclick=@CloseContractTargetSearch>×</button>
				</div>
				<div class="contract-search-input-wrapper">
					<TextEntry class="contract-search-input" @ref="contractTargetSearchInput" Text="@contractTargetSearchText" Placeholder="Type to filter..." />
				</div>
				<div class="contract-search-results">
					@foreach (var species in GetFilteredSpecies())
					{
						<div class="contract-search-result @(GetAutoContractTargetSpecies() == species.Id ? "active" : "")" onclick=@(() => SelectContractTarget(species))>
							<span class="result-number">#@species.BeastiaryNumber</span>
							<img class="result-element-icon" src="ui/icons/elements/background/@(GetElementIconName(species.Element)).svg" />
							<span class="result-name">@species.Name</span>
						</div>
					}
					@if (GetFilteredSpecies().Count == 0)
					{
						<div class="contract-search-empty">@L("ui.battle.no_matches")</div>
					}
				</div>
			</div>
		</div>
	}

</root>

@code {
	// Localization helper
	private string L( string key ) => LocalizationManager.Get( key );
	private string L( string key, params object[] args ) => LocalizationManager.Get( key, args );

	public Action<bool> OnBattleEnd { get; set; }
	public Action OnExpeditionCancelled { get; set; }
	public string ExpeditionId { get; set; } = "";
	public bool IsArenaBattle { get; set; } = false;
	public bool IsRaidBattle { get; set; } = false;
	public bool Use3DBattle { get; set; } = true;
	public Action OnArenaRetire { get; set; }
	public string ArenaPlayerName { get; set; } = "";
	public string ArenaOpponentName { get; set; } = "";
	public int ArenaPlayerWins { get; set; } = 0;
	public int ArenaOpponentWins { get; set; } = 0;
	public int ArenaGameNumber { get; set; } = 1;

	private bool isSubscribed = false;
	private BattleTurn lastTurn = null;
	private string currentMoveAnnouncement = "";
	private float announcementTimer = 0f;
	private const float ANNOUNCEMENT_DURATION = 2.0f;

	// Pass 3: counter that increments every time a new announcement comes in,
	// so the .slam-@key class re-applies and the keyframes animation replays
	// (s&box only plays @keyframes on first mount per element).
	private int announcementKey = 0;

	// Pass 3: counter for HP-bar shake replays, plus per-monster timers so the
	// shake class only sticks to the actual damage taker for ~240ms.
	private Dictionary<Guid, int> shakeKeys = new();
	private Dictionary<Guid, float> shakeTimers = new();
	private const float SHAKE_DURATION = 0.24f;

	// Track recently defeated monsters for fade-out animation
	// Total time = TurnAnimDelay (0.8s hold) + fade out (0.8s) to sync with 3D faint
	private Dictionary<Guid, float> defeatedFadeTimers = new();
	private Dictionary<Guid, Monster> defeatedMonsterCache = new(); // Keep ref so we can render during fade
	private const float DEFEAT_HOLD_DURATION = 0.8f; // Hold visible while hit VFX plays
	private const float DEFEAT_FADE_DURATION = 0.45f; // Then fade out during faint animation
	private const float DEFEAT_TOTAL_DURATION = DEFEAT_HOLD_DURATION + DEFEAT_FADE_DURATION;

	// HP-bar display lag: the simulation drops Monster.CurrentHP the instant a
	// turn resolves (which is BEFORE the on-screen attack visual lands). To keep
	// the bar from shrinking pre-emptively, we render against this dictionary
	// of "displayed" HP values per monster instead of CurrentHP directly.
	//
	// Flow:
	//   • OnTurnExecuted(turn) — defender already had its CurrentHP dropped by
	//     the simulator. We reconstruct the OLD value (CurrentHP + turn.Damage)
	//     and store it here so the bar HOLDS at the pre-damage width.
	//   • OnTurnVisualsStarted(turn) — fires when the 3D scene starts the swing
	//     animation. We sync displayedHP back to actual CurrentHP, which lets the
	//     existing CSS `.panel3d-hp-fill { transition: width 0.6s ease; }` lerp
	//     the bar down in sync with the visible impact.
	//   • For 2D mode (no OnTurnVisualsStarted event), we use a per-monster
	//     release timer ticked in Tick() — about 200ms after OnTurnExecuted,
	//     which lines up with the move-name slam-in.
	//
	// Fallback: GetDisplayedHPPercent reads CurrentHP if no entry is present
	// (initial render, swap-in, wave-spawn — all cases where there's no lag to apply).
	private Dictionary<Guid, int> displayedHP = new();
	private Dictionary<Guid, float> displayedHPReleaseTimers = new(); // 2D mode: catchup delay before snapping to actual
	private const float DISPLAYED_HP_RELEASE_2D = 0.20f; // ~200ms after OnTurnExecuted in 2D, then sync
	// Bumped per release so BuildHash picks up the change (HP value alone wouldn't differ for 0-damage cases).
	private int displayedHPVersion = 0;

	// True after the first wave transition — suppresses CSS entrance animation on subsequent waves
	private bool hasCompletedWaveTransition = false;

	// ── Cinematic CRITICAL hit ────────────────────────────────────────
	// On every damaging crit, we fire a screen flash (~100ms) + a giant
	// CRITICAL stamp that slams in from the left, holds, slides out right.
	// Total on-screen time ≈ 600ms. The render-key class trick (.bb-crit-flash-@N
	// cycling 0..3) re-mounts the elements on every fire, which is the only
	// way s&box re-runs @keyframes for the same DOM slot — so back-to-back
	// crits each get their own animation rather than stalling on the first.
	private int critCinematicKey = 0;
	private float critCinematicTimer = 0f;
	private const float CRIT_CINEMATIC_DURATION = 1.5f;

	// ── Cinematic BOSS splash ─────────────────────────────────────────
	// Fired once on wave-start when IsBossWave() — slanted slab + title +
	// species name slams in from off-screen-LEFT, holds, slides out to the
	// RIGHT. Total ~2.0s on-screen. The .bb-splash-active modifier on
	// .battle-view dims action diamonds + ticker + wave indicator while
	// the splash is up so they don't compete with the moment.
	private int bossSplashKey = 0;
	private float bossSplashTimer = 0f;
	private string bossSplashTitle = "";
	private string bossSplashName = "";
	private string bossSplashSubtitle = "";
	private bool bossSplashIsRare = false;
	private const float BOSS_SPLASH_DURATION = 2.05f;
	// Tracks the last wave we fired the splash for so wave-start fires per
	// wave entry but not on every restart of the same wave (e.g. retries).
	private string lastBossSplashWaveKey = "";

	// ── Cinematic WAVE CLEAR banner ───────────────────────────────────
	// Fires sub-2-second when ExpeditionManager.OnWaveCompleted emits — two
	// slanted yellow/red strips slam in across the screen, "WAVE N" label +
	// "CLEAR!" big italic text, optional reward chip with the wave's
	// total XP/gold gained. Same render-key class trick as the crit
	// cinematic so back-to-back wave clears (rare but possible) replay
	// cleanly. Does NOT fire on the FINAL wave clear — that goes straight
	// to the expedition-complete screen, which is its own setpiece.
	private int waveClearKey = 0;
	private float waveClearTimer = 0f;
	private string waveClearWaveLabel = "";   // "WAVE 03"
	private string waveClearRewardLine = "";  // "+ 320 XP · 80 GOLD"  (optional)
	private const float WAVE_CLEAR_DURATION = 1.6f;

	// ── Status stamp ──────────────────────────────────────────────────
	// Fires when a status effect lands on a monster (poison/burn/paralyze/
	// sleep/freeze/confuse). Big italic slanted slab over the affected
	// monster's side of the arena. Latest-wins: only one stamp on screen at
	// a time — back-to-back applications replace the previous. Detected by
	// scanning turn.EffectMessages for the canonical status-application
	// strings emitted by BattleSimulator (no core-side change required).
	private int statusStampKey = 0;
	private float statusStampTimer = 0f;
	private string statusStampLabel = "";    // "POISONED!"
	private string statusStampColor = "";    // "poison" | "burn" | etc — class suffix
	private bool statusStampIsPlayerSide = false;
	private const float STATUS_STAMP_DURATION = 1.7f;

	private List<Monster> cachedPlayerTeam = new();
	private List<Monster> cachedEnemyTeam = new();

	// Swap carousel state
	private int swapCarouselIndex = 0;
	private List<Monster> swapTargets = null;

	// Battle log entries (persists across waves in same expedition)
	private List<BattleLogEntry> battleLog = new();
	private const int MAX_LOG_ENTRIES = 50; // Increased for full expedition logging
	private bool isLogExpanded = false; // Compact by default, click to expand
	private string lastLoggedExpeditionId = null;
	private int lastLoggedWave = 0;

	// Horde system: player target selection
	private Guid selectedTargetId = Guid.Empty;

	// Move tooltip state
	private string hoveredMoveId = null;

	// Contract negotiation overlay state
	private bool showNegotiationOverlay = false;
	private Monster negotiationTarget = null;
	private bool isBossContract = false;
	private ContractNegotiationPanel negotiationPanel;
	private bool lastBattleWon = false;
	private bool showRetireConfirm = false;
	// Battle action bar state: "actions" | "moves" | "targets" | "executing"
	private string actionBarState = "actions";
	private string pendingMoveId3D = null;
	// Tracks which move slot (0-3) is currently hovered, so a SHARED info
	// panel rendered before cluster-bg in DOM can show the right move's data
	// while still rendering BEHIND the cluster bg's yellow border.
	private int hoveredMoveSlot = -1;
	// Same idea for the swap state — tracks hovered beast slot (0-2).
	private int hoveredSwapSlot = -1;
	// Tracks hovered enemy slot in the targets state (0-2) for the shared
	// enemy info panel.
	private int hoveredTargetSlot = -1;
	// Key that increments on every FIGHT click — combined with a time-based
	// active flag so the burst only renders for ~700ms after a click. Without
	// this, the burst element would persist in DOM and replay the keyframe
	// animation whenever the FIGHT button re-mounts (e.g. after move execution
	// returns the bar to "actions" state).
	private int fightBurstKey = 0;
	private RealTimeSince fightBurstSince = 1000f;
	private bool IsFightBurstActive => fightBurstSince < 0.7f;
	// Tracks the previous barState so we can fire a cluster-bg "pulse" key
	// increment whenever the state actually changes. The Razor render uses
	// this to swap the cluster-bg's class, re-mounting it so the pulse
	// keyframe replays on every transition.
	private string lastObservedBarState = "actions";
	private int clusterPulseKey = 0;
	// Time-gated flash overlay for state transitions — re-mounts on every
	// state change and fades out over ~0.4s, marking the transition with a
	// per-state colored wash.
	private RealTimeSince clusterFlashSince = 1000f;
	private bool IsClusterFlashActive => clusterFlashSince < 0.4f;

	private string currentAnnouncement = "";
	private string currentAnnouncementTag = "";
	private string currentAnnouncementTagClass = "";

	private string GetHPColorClass3D(Monster mon)
	{
		if (mon == null) return "high";
		// Use DISPLAYED HP so the green→yellow→red threshold transitions in
		// sync with the bar's visible drop, not the simulation's instant drop.
		var pct = GetDisplayedHPPercent(mon);
		if (pct > 50) return "high";
		if (pct > 20) return "medium";
		return "low";
	}

	private List<string> GetMonsterStatuses3D(Monster mon)
	{
		var statuses = new List<string>();
		if (mon == null) return statuses;
		var state = BattleManager.Instance?.CurrentBattleState;
		if (state == null) return statuses;
		if (state.Statuses.TryGetValue(mon.Id, out var activeStatuses))
		{
			foreach (var s in activeStatuses)
				statuses.Add(s.Condition.ToString());
		}
		return statuses;
	}

	/// <summary>
	/// Get the current action bar state, accounting for turn execution
	/// </summary>
	private string GetActionBarState()
	{
		if (actionBarState == "executing")
		{
			// Return to actions once we can select moves again
			if (CanSelectMoves())
			{
				actionBarState = "actions";
				return "actions";
			}
			return "executing";
		}
		if (actionBarState == "swap")
		{
			// If we're no longer waiting for input, exit swap mode
			if (!CanSelectMoves())
			{
				BattleSceneController.Instance?.ClearSwapHighlights();
				swapTargets = null;
				swapCarouselIndex = 0;
				actionBarState = "actions";
				return "actions";
			}
			return "swap";
		}
		return actionBarState;
	}

	/// <summary>
	/// View-model row for an action-bar move slot in 3D mode. Built by
	/// BuildMoveSlots3D so the markup foreach can stay simple — keeps the
	/// generic `for` loop OUT of the Razor markup body (where the `less-than`
	/// in `i less count` confuses the parser and breaks BuildRenderTree).
	/// </summary>
	private class MoveSlot3D
	{
		public string MoveId;
		public string MoveName;
		public string ElementClass;
		public string SlotClass;
		public string DisabledClass;
		public bool IsDisabled;
		public string IconSrc;
		public int Index;
	}

	private List<MoveSlot3D> BuildMoveSlots3D( bool buttonsDisabled )
	{
		var result = new List<MoveSlot3D>();
		var moveMon = GetPlayerActiveMonster();
		var moves3D = GetAvailableMoves3D( moveMon );
		if ( moves3D == null ) return result;
		var slotClasses = new[] { "mv-slot-1", "mv-slot-2", "mv-slot-3", "mv-slot-4" };
		var moveCount = System.Math.Min( 4, moves3D.Count );
		for ( int i = 0; i < moveCount; i++ )
		{
			var move = moves3D[i];
			var moveData = MoveDatabase.GetMove( move.MoveId );
			if ( moveData == null ) continue;
			var elementClass = moveData.Element.ToString().ToLowerInvariant();
			var hasPP = move.CurrentPP > 0;
			var moveDisabled = !hasPP || buttonsDisabled;
			var iconName = GetElementIconName( moveData.Element );
			result.Add( new MoveSlot3D
			{
				MoveId = move.MoveId,
				MoveName = moveData.Name,
				ElementClass = elementClass,
				SlotClass = slotClasses[i],
				DisabledClass = moveDisabled ? "disabled" : "",
				IsDisabled = moveDisabled,
				IconSrc = "ui/icons/elements/transparent/" + iconName + ".svg",
				Index = i,
			} );
		}
		return result;
	}

	private class EnemySlot3D
	{
		public Monster EnemyRef;
		public string DisplayName;
		public string ElementClass;
		public string SlotClass;
		public string DisabledClass;
		public bool IsDisabled;
		public string SpriteSrc;
		public int Index;
		public int SlotNum;
	}

	private List<EnemySlot3D> BuildEnemySlots3D( bool buttonsDisabled )
	{
		var result = new List<EnemySlot3D>();
		var enemies = GetEnemyTargetList3D();
		if ( enemies == null ) return result;
		// Reverse so top diamond = leftmost enemy in the 3D scene, bottom
		// diamond = rightmost. Player reads target picker left-to-right by
		// matching the on-screen position.
		enemies = new List<Monster>( enemies );
		enemies.Reverse();
		// Contract picker uses a different slot layout: enemy 1 → LEFT (BAG),
		// enemy 2 → TOP (SWITCH), enemy 3 → RIGHT (FIGHT slot, normal-sized).
		// BACK button takes the BOTTOM (CONTRACT) slot. Standard target picker
		// uses TOP/LEFT/BOTTOM for enemies 1/2/3 and the right is FIGHT-back.
		string[] slotClasses;
		if ( isContractTargeting )
		{
			slotClasses = new[] { "cn-slot-1", "cn-slot-2", "cn-slot-3" };
		}
		else
		{
			slotClasses = new[] { "tg-slot-1", "tg-slot-2", "tg-slot-3" };
		}
		var enemyCount = System.Math.Min( 3, enemies.Count );
		for ( int i = 0; i < enemyCount; i++ )
		{
			var enemy = enemies[i];
			if ( enemy == null ) continue;
			var species = MonsterManager.Instance?.GetSpecies( enemy.SpeciesId );
			var elementClass = species != null ? species.Element.ToString().ToLowerInvariant() : "neutral";
			result.Add( new EnemySlot3D
			{
				EnemyRef = enemy,
				DisplayName = species?.Name ?? "???",
				ElementClass = elementClass,
				SlotClass = slotClasses[i],
				DisabledClass = buttonsDisabled ? "disabled" : "",
				IsDisabled = buttonsDisabled,
				SpriteSrc = species?.IconPath ?? "",
				Index = i,
				SlotNum = i + 1,
			} );
		}
		return result;
	}

	private List<Monster> GetEnemyTargetList3D()
	{
		var team = GetEnemyTeam();
		if ( team == null ) return null;
		return team.Where( e => e != null && e.CurrentHP > 0 && !e.WasContracted ).ToList();
	}

	/// <summary>
	/// Build the HP card display order: simple left-to-right (reversed from
	/// the raw team list). Top card = leftmost = slot 1 in the target picker.
	/// The TOP card always gets the prominent (non-".secondary") styling so
	/// the yellow border highlight rides on the slot-1 card regardless of
	/// which enemy is actually currently attacking.
	/// </summary>
	private List<Monster> BuildEnemyHpCardOrder3D( List<Monster> team )
	{
		if ( team == null ) return new List<Monster>();
		var alive = team.Where( e => e != null && (e.CurrentHP > 0 || defeatedFadeTimers.ContainsKey( e.Id )) ).ToList();
		alive.Reverse();
		return alive;
	}

	/// <summary>
	/// Returns the 1-based target-picker slot number for an enemy, matching
	/// the badge shown on the action-bar enemy diamonds. Top diamond in the
	/// picker = leftmost enemy in the scene = slot 1.
	/// </summary>
	private int GetEnemyTargetSlot( Monster enemy )
	{
		if ( enemy == null ) return 0;
		var list = GetEnemyTargetList3D();
		if ( list == null ) return 0;
		var idx = list.IndexOf( enemy );
		if ( idx < 0 ) return 0;
		// Reversed: slot 1 = LAST in raw list (leftmost in scene).
		return list.Count - idx;
	}

	/// <summary>
	/// Populate hovered-move display strings for the shared info panel.
	/// Returns true if a valid move was found at the given slot. Mirrors
	/// TryFillHoveredEnemy3D — keeps the slot-bounds check (which uses a
	/// less-than operator) out of the Razor markup body.
	/// </summary>
	private bool TryFillHoveredMove3D( int slot, out string name, out string pp, out string pwr, out string desc )
	{
		name = "";
		pp = "";
		pwr = "";
		desc = "";
		if ( slot < 0 ) return false;
		var moveMon = GetPlayerActiveMonster();
		var moves = GetAvailableMoves3D( moveMon );
		if ( moves == null || slot >= moves.Count ) return false;
		var move = moves[slot];
		if ( move == null ) return false;
		var moveData = MoveDatabase.GetMove( move.MoveId );
		if ( moveData == null ) return false;
		name = moveData.Name;
		pp = "PP " + move.CurrentPP + "/" + moveData.MaxPP;
		pwr = moveData.BasePower > 0 ? "PWR " + moveData.BasePower : "";
		desc = string.IsNullOrEmpty( moveData.Description ) ? "" : moveData.Description;
		return true;
	}

	/// <summary>
	/// True if the target picker has at least one valid enemy. Cheap bool
	/// check for the markup branch — avoids declaring a generic-list local
	/// in the Razor code-block (which corrupts the generated
	/// BuildRenderTree output).
	/// </summary>
	private bool HasTargetEnemies3D()
	{
		var team = GetEnemyTeam();
		if ( team == null ) return false;
		foreach ( var e in team )
		{
			if ( e != null && e.CurrentHP > 0 && !e.WasContracted ) return true;
		}
		return false;
	}

	/// <summary>
	/// Populate the shared info panel with the currently-selected swap target
	/// (the beast pointed at by swapCarouselIndex). Used during swap state.
	/// </summary>
	private bool TryFillCurrentSwapTarget3D( out string name, out string sub, out string hp )
	{
		name = "";
		sub = "";
		hp = "";
		if ( swapTargets == null || swapCarouselIndex < 0 || swapCarouselIndex >= swapTargets.Count ) return false;
		var beast = swapTargets[swapCarouselIndex];
		if ( beast == null ) return false;
		var species = MonsterManager.Instance?.GetSpecies( beast.SpeciesId );
		var displayName = beast.Nickname;
		if ( string.IsNullOrEmpty( displayName ) ) { displayName = species?.Name ?? "???"; }
		name = displayName;
		var active = BattleManager.Instance?.GetActivePlayerMonster();
		var activeSuffix = (beast == active) ? " · Active" : "";
		sub = "Lv " + beast.Level + activeSuffix;
		hp = "HP " + beast.CurrentHP + "/" + beast.MaxHP;
		return true;
	}

	/// <summary>
	/// Populate hovered-enemy display strings for the shared info panel.
	/// Returns true if a valid enemy was found at the given slot.
	/// </summary>
	private bool TryFillHoveredEnemy3D( int slot, out string name, out string sub, out string hp )
	{
		name = "";
		sub = "";
		hp = "";
		if ( slot < 0 ) return false;
		var enemies = GetEnemyTargetList3D();
		if ( enemies == null || slot >= enemies.Count ) return false;
		var enemy = enemies[slot];
		if ( enemy == null ) return false;
		name = MonsterManager.Instance?.GetSpecies( enemy.SpeciesId )?.Name ?? "???";
		sub = "Lv " + enemy.Level;
		hp = "HP " + enemy.CurrentHP + "/" + enemy.MaxHP;
		return true;
	}

