@namespace Beastborne.UI.Components
@using Sandbox;
@using Sandbox.UI;
@using Beastborne.Core;
@using Beastborne.Data;
@using Beastborne.Systems;
@using Beastborne.UI.Panels;
@using Beastborne.UI.Components;
@using Beastborne.Battle3D;
@using Iconify;
@inherits Panel

<root class="battle-view @(IsBossWave() ? "boss-battle" : "") @(Use3DBattle ? "mode-3d" : "")" style="@(Use3DBattle ? "" : GetBackgroundStyle())">
	<!-- Dark overlay for readability (hidden in 3D mode) -->
	@if (!Use3DBattle)
	{
		<div class="background-overlay @(IsBossWave() ? "boss-overlay" : "") @(IsRaidBattle ? "raid-overlay" : "")"></div>
	}

	<!-- Boss Battle Banner -->
	@if (IsBossWave() && !IsArenaBattle && !Use3DBattle)
	{
		<div class="boss-banner @(IsRareBossEncounter() ? "rare" : "")">
			<div class="boss-banner-line left"></div>
			<div class="boss-banner-content">
				<span class="boss-banner-text">@(IsRareBossEncounter() ? L("ui.battle.legendary_boss") : L("ui.battle.boss_battle"))</span>
				@if (GetBossPhaseCount() > 1)
				{
					<span class="boss-phase-text">@L("ui.battle.phase") @GetCurrentBossPhase()/@GetBossPhaseCount()</span>
				}
			</div>
			<div class="boss-banner-line right"></div>
		</div>
	}

	<!-- Top Bar: Wave/Turn Info + Turn Order (hidden in 3D mode - info shown in floating panels) -->
	<div class="battle-top-bar" style="@(Use3DBattle ? "display: none;" : "")">
		<div class="battle-info">
			@if (IsRaidBattle)
			{
				<div class="info-badge raid-badge">
					<span class="badge-label">@L("ui.battle.raid")</span>
				</div>
				<div class="info-badge round-badge">
					<span class="badge-label">@L("ui.battle.round")</span>
					<span class="badge-value">@(GetRaidRound() + 1)</span>
				</div>
				<div class="raid-damage-counter">
					<span class="raid-dmg-label">@L("ui.battle.dmg")</span>
					<span class="raid-dmg-value">@($"{GetRaidDamage():N0}")</span>
				</div>
			}
			else if (!IsArenaBattle)
			{
				<div class="info-badge wave-badge @(IsBossWave() ? "boss-wave" : "")">
					<span class="badge-label">@(IsBossWave() ? L("ui.battle.boss") : L("ui.battle.wave"))</span>
					<span class="badge-value">@GetCurrentWave()</span>
				</div>
			}
			@if (!IsRaidBattle)
			{
				<div class="info-badge turn-badge">
					<span class="badge-label">@L("ui.battle.turn")</span>
					<span class="badge-value">@GetCurrentTurn()</span>
				</div>
			}
		</div>

		@if (IsArenaBattle)
		{
			<div class="arena-score-bar">
				<span class="arena-score-name">@ArenaPlayerName</span>
				<div class="arena-score-pips">
					@for (int i = 0; i < 2; i++)
					{
						var won = ArenaPlayerWins > i;
						<div class="arena-pip @(won ? "won" : "")"></div>
					}
				</div>
				<span class="arena-score-game">Game @ArenaGameNumber</span>
				<div class="arena-score-pips">
					@for (int i = 0; i < 2; i++)
					{
						var won = ArenaOpponentWins > i;
						<div class="arena-pip opponent @(won ? "won" : "")"></div>
					}
				</div>
				<span class="arena-score-name">@ArenaOpponentName</span>
			</div>
		}

		<!-- Turn Order Display (hidden in arena/raid) -->
		@if (!IsArenaBattle && !IsRaidBattle)
		{
			<div class="turn-order">
				<span class="turn-order-label">@L("ui.battle.next")</span>
				@foreach (var monster in GetTurnOrder().Take(4))
				{
					var isPlayer = IsPlayerMonster(monster);
					<div class="turn-order-icon @(isPlayer ? "player" : "enemy")">
						@if (HasSprite(monster))
						{
							<div class="turn-icon-sprite" style="background-image: url(@GetAnimatedSpritePath(monster))"></div>
						}
						else
						{
							<span class="turn-icon-placeholder">?</span>
						}
					</div>
				}
			</div>
		}

	</div>

	<!-- Main Battle Arena (hidden in 3D mode) -->
	<div class="battle-arena" style="@(Use3DBattle ? "display: none;" : "")">
		<!-- Player Side -->
		<div class="battle-side player-side">
			<div class="side-label">@L("ui.battle.your_team")</div>
			<div class="monsters-container">
				@{
					var playerTeam = GetPlayerTeam();
					var playerActive = GetPlayerActiveMonster();
					// Reorder so active monster is always displayed first
					var displayOrder = new List<Monster>();
					if (playerActive != null) displayOrder.Add(playerActive);
					displayOrder.AddRange(playerTeam.Where(m => m != null && m != playerActive));
				}
				@foreach (var monster in displayOrder)
				{
					if (monster == null) continue;
					var isActive = monster == playerActive;
					var isAttacker = IsAttacker(monster);
					var isDefender = IsDefender(monster);
					var hpPercent = GetHPPercent(monster);
					var isKO = monster.CurrentHP <= 0;
					var canSwapTo = false; // Swap is now handled by carousel UI

					<div class="monster-card-wrapper @(isActive && CanSelectMoves() ? "show-moves" : "")">
						<div class="monster-card @(isActive ? "active" : "benched") @(isAttacker ? "attacking" : "") @(isDefender ? "hit" : "") @(isKO ? "ko" : "") @(canSwapTo ? "swap-target" : "")"
							 onclick=@(() => OnPlayerMonsterClicked(monster, isActive, isKO))>
							<div class="card-glow"></div>
							<div class="card-content">
								<div class="monster-sprite-area">
									@if (HasSprite(monster))
									{
										<div class="sprite" style="background-image: url(@GetAnimatedSpritePath(monster))"></div>
									}
									else
									{
										<div class="sprite-placeholder">?</div>
									}
									@if (isDefender && GetLastDamage(monster) > 0 && ShouldShowDamageNumbers())
									{
										<div class="damage-number">-@GetLastDamage(monster)</div>
									}
									@if (isKO)
									{
										<div class="ko-badge">@L("ui.battle.ko")</div>
									}
								</div>
								<div class="monster-info">
									<div class="name-row">
										<span class="monster-name">@(monster.Nickname ?? "Monster")</span>
										<span class="monster-level">Lv.@monster.Level</span>
									</div>
									<div class="hp-bar">
										<div class="hp-fill @GetHPColor(hpPercent)" style="width: @hpPercent%"></div>
									</div>
									<div class="stats-row">
										<span class="hp-text">@monster.CurrentHP / @monster.MaxHP</span>
										@if (!IsRaidBattle)
										{
											<div class="xp-bar">
												<div class="xp-fill" style="width: @(GetXPPercent(monster))%"></div>
											</div>
											<span class="xp-text">@monster.CurrentXP / @monster.XPForNextLevel</span>
										}
									</div>
									@{
										var statuses = GetMonsterStatuses(monster);
										var statStages = GetStatStageIndicators(monster);
										if (statuses.Count > 0 || statStages.Count > 0)
										{
											<div class="status-row">
												@foreach (var status in statuses)
												{
													<span class="status-badge @status.ToLower()">@GetStatusIcon(status)</span>
												}
												@foreach (var (statName, stage, isPositive) in statStages)
												{
													<span class="stat-stage-badge @(isPositive ? "buff" : "debuff")">
														<span class="stat-name">@statName</span>
														<span class="stat-arrow">@GetStatStageIcon(stage, isPositive)</span>
													</span>
												}
											</div>
										}
									}
								</div>
							</div>
						</div>

						<!-- Move Selection Popup (appears below active monster) -->
						@if (isActive && CanSelectMoves())
						{
							<div class="move-popup">
								<div class="move-popup-content" onmouseleave=@(() => SetHoveredMove(null))>
									<div class="popup-moves">
										@{
											var moves = GetActiveMoves();
											foreach (var move in moves)
											{
												var moveDef = MoveDatabase.GetMove(move.MoveId);
												if (moveDef != null)
												{
													var elementClass = moveDef.Element.ToString().ToLower();
													var isDisabled = !move.HasPP;
													var capturedMoveId = move.MoveId;
													var effectivenessIndicator = GetMoveEffectivenessIndicator(moveDef);
													var effectivenessClass = GetEffectivenessClass(effectivenessIndicator);
													<div class="move-btn-wrapper" onmouseover=@(() => SetHoveredMove(capturedMoveId))>
														<button class="popup-move-btn @elementClass @(isDisabled ? "disabled" : "") @effectivenessClass"
																onclick=@(() => OnMoveChosen(move.MoveId))>
															<img class="popup-move-icon" src="ui/icons/elements/transparent/@(GetElementIconName(moveDef.Element)).svg" />
															<div class="popup-move-info">
																<span class="popup-move-name">@moveDef.Name</span>
																<span class="popup-move-pp @(move.CurrentPP <= 3 ? "low" : "")">@move.CurrentPP/@moveDef.MaxPP</span>
															</div>
															@if (moveDef.BasePower > 0)
															{
																<span class="popup-move-power">@moveDef.BasePower</span>
															}
															@if (!string.IsNullOrEmpty(effectivenessIndicator) && ShouldShowTypeEffectiveness())
															{
																<span class="effectiveness-badge @effectivenessClass">@effectivenessIndicator</span>
															}
														</button>
													</div>
												}
											}
										}
									</div>
									<button class="popup-swap-btn" onclick=@OnSwapRequested>
										<span class="swap-icon">🔄</span>
										<span class="swap-text">SWAP</span>
									</button>
									@if (!string.IsNullOrEmpty(hoveredMoveId))
									{
										var hoveredMove = MoveDatabase.GetMove(hoveredMoveId);
										if (hoveredMove != null)
										{
											var elemClass = hoveredMove.Element.ToString().ToLower();
											<div class="move-tooltip">
												<div class="tooltip-header">
													<span class="tooltip-name">@hoveredMove.Name</span>
													<span class="tooltip-element @elemClass">@hoveredMove.Element</span>
												</div>
												<div class="tooltip-stats">
													<span>Power: @(hoveredMove.BasePower > 0 ? hoveredMove.BasePower.ToString() : "—")</span>
													<span>Acc: @(hoveredMove.Accuracy)%</span>
													<span>@hoveredMove.Category</span>
												</div>
												<label class="tooltip-desc">@hoveredMove.Description</label>
											</div>
										}
									}
								</div>
							</div>
						}
					</div>
				}
			</div>
		</div>

		<!-- Center: Action Display -->
		<div class="battle-center">
			@if (!string.IsNullOrEmpty(currentMoveAnnouncement))
			{
				<div class="move-announcement">
					@currentMoveAnnouncement
				</div>
			}
			@if (GetLastTurn() != null)
			{
				var turn = GetLastTurn();
				<div class="action-display">
					@if (!string.IsNullOrEmpty(turn.MoveName))
					{
						<div class="action-move @GetMoveElementClass(turn.MoveElement)">
							@turn.MoveName
						</div>
					}
					@if (!turn.IsMiss && !turn.IsSwap && turn.Damage > 0)
					{
						<div class="action-damage @(turn.IsCritical ? "crit" : "") @(turn.IsSuperEffective && ShouldShowTypeEffectiveness() ? "super" : "") @(turn.IsResisted && ShouldShowTypeEffectiveness() ? "resisted" : "")">
							@turn.Damage
							@if (turn.IsCritical) { <span class="damage-tag">@L("ui.battle.crit")</span> }
							@if (turn.IsSuperEffective && ShouldShowTypeEffectiveness()) { <span class="damage-tag super">@L("ui.battle.super")</span> }
							@if (turn.IsResisted && ShouldShowTypeEffectiveness()) { <span class="damage-tag resist">@L("ui.battle.resist")</span> }
						</div>
					}
					@if (turn.IsMiss)
					{
						<div class="action-miss">@L("ui.battle.miss")</div>
					}
					@if (turn.IsSwap)
					{
						<div class="action-swap">SWAP → @turn.SwapToName</div>
					}
				</div>
			}
		</div>

		<!-- Enemy Side -->
		<div class="battle-side enemy-side">
			<div class="side-label">@(IsArenaBattle ? (CompetitiveManager.Instance?.CurrentOpponent?.Name?.ToUpper() ?? "OPPONENT") : "ENEMIES")</div>
			<div class="monsters-container">
				@{
					var enemyTeam = GetEnemyTeam();
					var enemyActive = GetActiveEnemyMonster();
					// For arena: only show active monster (like player side). For expedition: show all (horde mode)
					List<Monster> enemyDisplayOrder;
					if (IsArenaBattle)
					{
						enemyDisplayOrder = new List<Monster>();
						if (enemyActive != null) enemyDisplayOrder.Add(enemyActive);
						enemyDisplayOrder.AddRange(enemyTeam.Where(m => m != null && m != enemyActive));
					}
					else
					{
						enemyDisplayOrder = enemyTeam;
					}
				}
				@foreach (var monster in enemyDisplayOrder)
				{
					if (monster == null) continue;
					var isActive = IsArenaBattle ? (monster == enemyActive) : (monster.CurrentHP > 0);
					var isTargeted = !IsArenaBattle && IsCurrentTarget(monster); // No targeting in arena
					var isAttacker = IsAttacker(monster);
					var isDefender = IsDefender(monster);
					var hpPercent = GetHPPercent(monster);
					var isKO = monster.CurrentHP <= 0;
					var isBoss = IsBossWave() && !IsArenaBattle && IsBossMonster(monster);
					var isRareBoss = isBoss && IsRareBossEncounter();

					<div class="monster-card-wrapper">
						<div class="monster-card enemy @(isActive ? "active" : "benched") @(isTargeted ? "targeted" : "") @(isAttacker ? "attacking" : "") @(isDefender ? "hit" : "") @(isKO ? "ko" : "") @(IsArenaBattle ? "no-target" : "") @(isBoss ? "boss-monster" : "") @(isRareBoss ? "rare-boss" : "")"
							 onclick=@(() => OnEnemyTargetSelected(monster))>
							@if (isBoss)
							{
								<div class="boss-indicator @(isRareBoss ? "legendary" : "")">
									<span class="boss-label">@(isRareBoss ? "LEGENDARY" : "BOSS")</span>
								</div>
							}
							<div class="card-glow"></div>
							<div class="card-content">
								<div class="monster-sprite-area">
									@if (HasSprite(monster))
									{
										<div class="sprite" style="background-image: url(@GetAnimatedSpritePath(monster))"></div>
									}
									else
									{
										<div class="sprite-placeholder">?</div>
									}
									@if (isDefender && GetLastDamage(monster) > 0 && ShouldShowDamageNumbers())
									{
										<div class="damage-number">-@GetLastDamage(monster)</div>
									}
									@if (isKO)
									{
										<div class="ko-badge">@L("ui.battle.ko")</div>
									}
								</div>
								<div class="monster-info">
									<div class="name-row">
										<span class="monster-name">@(monster.Nickname ?? "Monster")</span>
										<span class="monster-level">Lv.@monster.Level</span>
									</div>
									<div class="hp-bar">
										<div class="hp-fill @GetHPColor(hpPercent)" style="width: @hpPercent%"></div>
									</div>
									<div class="hp-text">@(IsRaidBattle ? L("ui.battle.raid_boss") : $"{monster.CurrentHP} / {monster.MaxHP}")</div>
									@{
										var enemyStatuses = GetMonsterStatuses(monster);
										var enemyStatStages = GetStatStageIndicators(monster);
										if (enemyStatuses.Count > 0 || enemyStatStages.Count > 0)
										{
											<div class="status-row">
												@foreach (var status in enemyStatuses)
												{
													<span class="status-badge @status.ToLower()">@GetStatusIcon(status)</span>
												}
												@foreach (var (statName, stage, isPositive) in enemyStatStages)
												{
													<span class="stat-stage-badge @(isPositive ? "buff" : "debuff")">
														<span class="stat-name">@statName</span>
														<span class="stat-arrow">@GetStatStageIcon(stage, isPositive)</span>
													</span>
												}
											</div>
										}
									}
								</div>
							</div>
						</div>
					</div>
				}
			</div>
		</div>
	</div>

	<!-- 3D Battle HUD Overlay (always in DOM, hidden via CSS when not in 3D mode) -->
	@{
		var playerMon3D = Use3DBattle ? GetPlayerActiveMonster() : null;
		var enemyMon3D = Use3DBattle ? GetActiveEnemyMonster() : null;
		var playerSpecies3D = playerMon3D != null ? MonsterManager.Instance?.GetSpecies(playerMon3D.SpeciesId) : null;
		var enemySpecies3D = enemyMon3D != null ? MonsterManager.Instance?.GetSpecies(enemyMon3D.SpeciesId) : null;
	}

	<!-- Enemy Info Panels (top-right, diamond on RIGHT) -->
	@if (Use3DBattle && !BattleTransition.IsActive)
	{
		var enemyTeam3D = GetEnemyTeam();
		var activeEnemy3D = GetActiveEnemyMonster();
		var enemyIdx3D = 0;
		var sceneCtrl = BattleSceneController.Instance;
		var isWaveEntering = sceneCtrl != null && sceneCtrl.IsWaveTransitioning;
		var enterProgress = sceneCtrl?.WaveEnterProgress ?? 1f;
		// Render cached defeated enemies that are still fading out (may no longer be in current team)
		@foreach (var cachedEnemy in defeatedMonsterCache.Values.Where(m => m != null && (enemyTeam3D == null || !enemyTeam3D.Contains(m)) && defeatedFadeTimers.ContainsKey(m.Id)))
		{
			var species = MonsterManager.Instance?.GetSpecies(cachedEnemy.SpeciesId);
			var idx = enemyIdx3D;
			var enemyElClass = species != null ? GetElementIconName(species.Element) : "neutral";
			var defeatTimeLeft = defeatedFadeTimers[cachedEnemy.Id];
			var isInHoldPhase = defeatTimeLeft > DEFEAT_FADE_DURATION;
			var fadeProgress = isInHoldPhase ? 1f : MathF.Max(0f, defeatTimeLeft / DEFEAT_FADE_DURATION);
			var fadeSlide = !isInHoldPhase ? (int)(60 * (1f - fadeProgress)) : 0;
			<div class="panel3d-diamond-wrapper enemy-panel-wrapper wave-entering fading-out secondary"
				 style="top: @(12 + idx * 90)px; right: @(20 - fadeSlide)px; position: absolute; opacity: @fadeProgress;">
				<div class="panel3d-card enemy-card">
					<div class="panel3d-header">
						<span class="panel3d-name">@(species?.Name ?? "???")</span>
						<span class="panel3d-level">Lv @(cachedEnemy.Level)</span>
					</div>
					<div class="panel3d-hp-row">
						<span class="panel3d-hp-label">HP</span>
						<div class="panel3d-hp-track">
							<div class="panel3d-hp-fill danger" style="width: 0%"></div>
						</div>
						<span class="panel3d-hp-nums">0 / @(cachedEnemy.MaxHP.ToString("N0"))</span>
					</div>
				</div>
				<div class="panel3d-diamond enemy-diamond el-bg-@enemyElClass">
					<img class="panel3d-diamond-icon" src="ui/icons/elements/transparent/@(enemyElClass).svg" />
				</div>
			</div>
			enemyIdx3D++;
		}
		if (enemyTeam3D != null && (!isWaveEntering || enterProgress > 0f))
		{
		@foreach (var enemy in enemyTeam3D.Where(e => e != null && (e.CurrentHP > 0 || defeatedFadeTimers.ContainsKey(e.Id))))
		{
			var species = MonsterManager.Instance?.GetSpecies(enemy.SpeciesId);
			var isActive = enemy == activeEnemy3D;
			var isTargeted = IsCurrentTarget(enemy);
			var idx = enemyIdx3D;
			var enemyElClass = species != null ? GetElementIconName(species.Element) : "neutral";
			var isFading = defeatedFadeTimers.ContainsKey(enemy.Id);
			var defeatTimeLeft = isFading ? defeatedFadeTimers[enemy.Id] : 0f;
			var isInHoldPhase = defeatTimeLeft > DEFEAT_FADE_DURATION;
			var fadeProgress = isFading ? (isInHoldPhase ? 1f : MathF.Max(0f, defeatTimeLeft / DEFEAT_FADE_DURATION)) : 1f;
			var panelOpacity = isWaveEntering ? enterProgress : (isFading ? fadeProgress : 1f);
			var enterSlide = isWaveEntering ? (int)(60 * (1f - enterProgress)) : 0;
			var fadeSlide = isFading && !isInHoldPhase ? (int)(60 * (1f - fadeProgress)) : 0;
			<div class="panel3d-diamond-wrapper enemy-panel-wrapper @(isWaveEntering || hasCompletedWaveTransition ? "wave-entering" : "") @(isFading ? "fading-out" : "") @(isActive ? "" : "secondary") @(isTargeted ? "targeted" : "") "
				 style="@(!Use3DBattle ? "display: none;" : "") top: @(12 + idx * 90)px; right: @(20 - fadeSlide - enterSlide)px; position: absolute; opacity: @panelOpacity;"
				>
				<div class="panel3d-card enemy-card">
					<div class="panel3d-header">
						<span class="panel3d-name">@(species?.Name ?? "???")</span>
						<span class="panel3d-level">Lv @(enemy.Level)</span>
					</div>
					<div class="panel3d-hp-row">
						<span class="panel3d-hp-label">HP</span>
						<div class="panel3d-hp-track">
							<div class="panel3d-hp-fill @GetHPColorClass3D(enemy)" style="width: @GetHPPercent(enemy)%"></div>
						</div>
						<span class="panel3d-hp-nums">@(enemy.CurrentHP.ToString("N0")) / @(enemy.MaxHP.ToString("N0"))</span>
					</div>
				</div>
				<div class="panel3d-diamond enemy-diamond el-bg-@enemyElClass">
					<img class="panel3d-diamond-icon" src="ui/icons/elements/transparent/@(enemyElClass).svg" />
				</div>
			</div>
			enemyIdx3D++;
		}
		}
	}

	<!-- Player Info Panel (top-left, diamond on LEFT) -->
	@if (playerMon3D != null && !BattleTransition.IsActive)
	{
		var playerElClass = playerSpecies3D != null ? GetElementIconName(playerSpecies3D.Element) : "neutral";
		var playerFading = defeatedFadeTimers.ContainsKey(playerMon3D.Id);
		var playerDefeatTimeLeft = playerFading ? defeatedFadeTimers[playerMon3D.Id] : 0f;
		var playerInHold = playerDefeatTimeLeft > DEFEAT_FADE_DURATION;
		var playerFadeProgress = playerFading ? (playerInHold ? 1f : MathF.Max(0f, playerDefeatTimeLeft / DEFEAT_FADE_DURATION)) : 1f;
		var playerFadeSlide = playerFading && !playerInHold ? (int)(60 * (1f - playerFadeProgress)) : 0;
		<div class="panel3d-diamond-wrapper player-panel-wrapper @(playerFading ? "fading-out" : "")" style="@(!Use3DBattle ? "display: none;" : "") top: 12px; left: @(20 - playerFadeSlide)px; position: absolute; opacity: @playerFadeProgress;">
			<div class="panel3d-diamond el-bg-@playerElClass">
				<img class="panel3d-diamond-icon" src="ui/icons/elements/transparent/@(playerElClass).svg" />
			</div>
			<div class="panel3d-card">
				<div class="panel3d-header">
					<span class="panel3d-name">@(playerMon3D.Nickname ?? playerSpecies3D?.Name ?? "???")</span>
					<span class="panel3d-level">Lv @(playerMon3D.Level)</span>
				</div>
				<div class="panel3d-hp-row">
					<span class="panel3d-hp-label">HP</span>
					<div class="panel3d-hp-track">
						<div class="panel3d-hp-fill @GetHPColorClass3D(playerMon3D)" style="width: @GetHPPercent(playerMon3D)%"></div>
					</div>
					<span class="panel3d-hp-nums">@(playerMon3D.CurrentHP.ToString("N0")) / @(playerMon3D.MaxHP.ToString("N0"))</span>
				</div>
				<div class="panel3d-xp-bar">
					<div class="panel3d-xp-fill" style="width: @GetXPPercent(playerMon3D)%"></div>
				</div>
			</div>
		</div>
	}

	<!-- Ambient Particles (3D mode only) -->
	@if (Use3DBattle)
	{
		<div class="battle3d-ambient">
			<div class="ambient-particle p1"></div>
			<div class="ambient-particle p2"></div>
			<div class="ambient-particle p3"></div>
			<div class="ambient-particle p4"></div>
			<div class="ambient-particle p5"></div>
			<div class="ambient-particle p6"></div>
		</div>
		<div class="battle3d-vignette"></div>
	}

	<!-- Wave Indicator (top center) -->
	@if (Use3DBattle && !BattleTransition.IsActive && !ExpeditionResultPopup.IsVisible)
	{
		<div class="wave-indicator-container">
			<div class="wave-badge @(IsBossWave() ? "wave-boss" : "")">
				<span class="wave-text">@(IsBossWave() ? "BOSS" : $"WAVE {GetCurrentWave()}")</span>
			</div>
		</div>
	}

	<!-- Battle Ticker (bottom-center, one line at a time) -->
	@if (Use3DBattle && !BattleTransition.IsActive && !ExpeditionResultPopup.IsVisible)
	{
		var tickerEntry = GetTickerEntry();
		@if (tickerEntry != null)
		{
			var tickerVisible = IsTickerEntryVisible(tickerEntry);
			var diamondClass = GetLogDiamondClass(tickerEntry);
			var turnClass = tickerEntry.IsPlayerAttacker ? "player-turn" : "enemy-turn";
			<div class="battle-ticker-host @(tickerVisible ? "visible" : "")">
				<div class="battle-ticker @tickerEntry.Type @turnClass">
					<div class="ticker-diamond @diamondClass">
						<iconify icon="@GetLogIconify(tickerEntry)" Size=@(14) Color="white" />
					</div>
					<span class="ticker-text">@tickerEntry.Text</span>
				</div>
			</div>
		}
	}

	<!-- 3D Action Bar (bottom) -->
	@if (Use3DBattle && !BattleTransition.IsActive && !ExpeditionResultPopup.IsVisible)
	{
	<div class="battle3d-action-bar">
		@{
			var barState = GetActionBarState();
			var awaitingInput = CanSelectMoves();
		}

		<!-- Diamond Action Buttons (state: actions, hidden during negotiation) -->
		@if (barState == "actions" && !showNegotiationOverlay)
		{
			var turnsPlaying = BattleManager.Instance?.IsPlaying == true && !BattleManager.Instance.IsWaitingForPlayerInput;
			var sceneAnimating = BattleSceneController.Instance != null && (BattleSceneController.Instance.IsWaveTransitioning);
			// Also gate on the 3D scene still playing queued turn animations
			// or waiting for a faint to finish — simulation can flip
			// IsWaitingForPlayerInput back on before the scene catches up, and
			// the player shouldn't be able to queue a new move while the
			// prior turn is mid-animation.
			var scenePlayingTurns = BattleSceneController.Instance?.IsPlayingTurns == true;
			var buttonsDisabled = turnsPlaying || sceneAnimating || scenePlayingTurns;
			<div class="action3d-buttons panel-in">
				<div class="action3d-btn fight @(awaitingInput ? "awaiting" : "") @(buttonsDisabled ? "disabled" : "")" onclick=@OnFight3D onmouseover=@(() => HoverBtn(1))>
					<div class="action3d-diamond">
						<iconify icon="lucide:swords" Size=@(36) Color="white" />
					</div>
					<span class="action3d-label">FIGHT</span>
				</div>
				<div class="action3d-btn swap @(buttonsDisabled ? "disabled" : "")" onclick=@OnSwapRequested onmouseover=@(() => HoverBtn(2))>
					<div class="action3d-diamond">
						<iconify icon="lucide:repeat-2" Size=@(36) Color="white" />
					</div>
					<span class="action3d-label">SWITCH</span>
				</div>
				<div class="action3d-btn bag @(buttonsDisabled ? "disabled" : "")" onclick=@OnOpenBag onmouseover=@(() => HoverBtn(3))>
					<div class="action3d-diamond">
						<iconify icon="lucide:briefcase" Size=@(36) Color="white" />
					</div>
					<span class="action3d-label">BAG</span>
				</div>
				@if (!IsArenaBattle && !IsRaidBattle)
				{
					<div class="action3d-btn contract contract-btn @(buttonsDisabled || !HasContractInk() ? "disabled" : "")" onclick=@OnContract3D onmouseover=@(() => HoverBtn(4))>
						<div class="action3d-diamond">
							<iconify icon="lucide:scroll-text" Size=@(36) Color="white" />
						</div>
						<span class="action3d-label">CONTRACT</span>
					</div>
				}
				<div class="action3d-end @(buttonsDisabled ? "disabled" : "")" onclick=@OnEndClicked onmouseover=@(() => HoverBtn(5))>
					<div class="end-diamond">
						<iconify icon="lucide:log-out" Size=@(18) Color="white" />
					</div>
					<span class="end-label">END</span>
				</div>
			</div>
		}

		<!-- Move Picker (state: moves) -->
		@if (barState == "moves")
		{
			<div class="move-picker3d panel-in">
				<div class="moves3d-row">
					@{
						var moveMon = GetPlayerActiveMonster();
						var moves3D = GetAvailableMoves3D(moveMon);
					}
					@if (moves3D.Count > 0)
					{
						@foreach (var move in moves3D)
						{
							var moveData = MoveDatabase.GetMove(move.MoveId);
							if (moveData == null) continue;
							var elementClass = moveData.Element.ToString().ToLowerInvariant();
							var haspp = move.CurrentPP > 0;
							<div class="move3d-btn @elementClass @(!haspp ? "no-pp" : "")" onclick=@(() => { if (haspp) OnMoveChosen3D(move.MoveId); }) onmouseover=@(() => HoverBtn(10 + move.MoveId.GetHashCode()))>
								<div class="move3d-diamond-indicator">
									<div class="move3d-element-diamond el-bg-@elementClass">
										<img class="move3d-element-icon" src="ui/icons/elements/transparent/@(GetElementIconName(moveData.Element)).svg" />
									</div>
								</div>
								<div class="move3d-info">
									<span class="move3d-name">@moveData.Name</span>
									<div class="move3d-bottom">
										<span class="move3d-pp">PP <span>@move.CurrentPP/@moveData.MaxPP</span></span>
										@if (moveData.BasePower > 0)
										{
											<span class="move3d-power">PWR @moveData.BasePower</span>
										}
									</div>
								</div>
								@if (!string.IsNullOrEmpty(moveData.Description))
								{
									<div class="move3d-desc">
										<span class="move3d-desc-text">@moveData.Description</span>
									</div>
								}
							</div>
						}
					}
					<div class="move3d-back" onmouseover=@(() => HoverBtn(20)) onclick=@(() => { actionBarState = "actions"; BattleSceneController.Instance?.GetCameraController()?.FocusDefault(); StateHasChanged(); })>
						<iconify icon="ph:arrow-left-bold" Size=@(24) Color="white" />
					</div>
				</div>
			</div>
		}

		<!-- Swap Mode: arrows + name + confirm all in action bar -->
		@if (barState == "swap" && swapTargets != null && swapTargets.Count > 0)
		{
			var swapMon = swapCarouselIndex < swapTargets.Count ? swapTargets[swapCarouselIndex] : null;
			var swapSpecies = swapMon != null ? MonsterManager.Instance?.GetSpecies(swapMon.SpeciesId) : null;
			var isActive = IsSwapTargetActive();

			<div class="swap-bar panel-in">
				<div class="swap-confirm-btn @(isActive ? "active" : "")" onclick=@OnSwapConfirm onmouseover=@(() => HoverBtn(25))>
					<iconify icon="lucide:repeat-2" Size=@(20) Color="white" />
					<span class="swap-confirm-text">@(isActive ? "ACTIVE" : "SWAP")</span>
				</div>

				@if (swapTargets.Count > 1)
				{
					<div class="swap-bar-arrow" onmouseover=@(() => HoverBtn(23)) onclick=@OnSwapCarouselLeft>
						<iconify icon="lucide:chevron-left" Size=@(22) Color="white" />
					</div>
				}

				<div class="swap-bar-info">
					@if (swapMon != null)
					{
						<span class="swap-bar-name">@(swapMon.Nickname ?? swapSpecies?.Name ?? "???")</span>
						<span class="swap-bar-detail">Lv @(swapMon.Level)@(isActive ? " — Active" : "")</span>
					}
				</div>

				@if (swapTargets.Count > 1)
				{
					<div class="swap-bar-arrow" onmouseover=@(() => HoverBtn(24)) onclick=@OnSwapCarouselRight>
						<iconify icon="lucide:chevron-right" Size=@(22) Color="white" />
					</div>
				}

				<div class="move3d-back" onmouseover=@(() => HoverBtn(22)) onclick=@OnSwapBack>
					<iconify icon="ph:arrow-left-bold" Size=@(24) Color="white" />
				</div>
			</div>
		}


	</div>
	}

	<!-- Target Picker (outside action bar) -->
	@if (Use3DBattle && !BattleTransition.IsActive && GetActionBarState() == "targets")
	{
		<div class="target-picker-overlay panel-in">
			@{
				var tgtEnemies = GetEnemyTeam()?.Where(e => e != null && e.CurrentHP > 0 && !e.WasContracted).ToList();
			}
			@if (tgtEnemies != null)
			{
				int tgtIdx = 0;
				@foreach (var enemy in tgtEnemies)
				{
					tgtIdx++;
					var tSpecies = MonsterManager.Instance?.GetSpecies(enemy.SpeciesId);
					var elementClass = tSpecies != null ? tSpecies.Element.ToString().ToLowerInvariant() : "neutral";
					<div class="target3d-card" onclick=@(() => OnTargetChosen3D(enemy)) onmouseover=@(() => HoverBtn(100 + enemy.GetHashCode()))>
						<div class="target3d-diamond-indicator">
							<div class="target3d-element-diamond el-bg-@elementClass">
								<img class="target3d-sprite-icon" src="@(tSpecies?.IconPath ?? "")" />
							</div>
							<div class="target3d-number">@tgtIdx</div>
						</div>
						<div class="target3d-info">
							<span class="target3d-name">@(tSpecies?.Name ?? "???")</span>
							<div class="target3d-bottom">
								<span class="target3d-level">Lv @(enemy.Level)</span>
								<span class="target3d-hp">HP @(enemy.CurrentHP)/@(enemy.MaxHP)</span>
							</div>
						</div>
					</div>
				}
			}
			<div class="move3d-back" onmouseover=@(() => HoverBtn(21)) onclick=@OnCancelTargetPicker3D>
				<iconify icon="ph:arrow-left-bold" Size=@(24) Color="white" />
			</div>
		</div>
	}

	<!-- Bottom Action Bar (2D mode only) -->
	<div class="action-bar" style="@(Use3DBattle ? "display: none;" : "")">
		<div class="auto-controls">
			@if (!IsArenaBattle && !IsRaidBattle)
			{
				<button class="control-btn play-btn @(IsPlaying() ? "playing" : "")" onclick=@OnPlayPause>
					<span class="btn-icon">@(IsPlaying() ? "⏸" : "▶")</span>
				</button>
			}

			@if (!IsArenaBattle && !IsRaidBattle)
			{
				<div class="toggle-group">
					<div class="toggle-item @(GetAutoCatch() ? "active" : "")" onclick=@ToggleAutoCatch>
						<div class="toggle-switch"></div>
						<span class="toggle-label">@L("ui.battle.auto_contract")</span>
					</div>
					@if (GetAutoCatch())
					{
						<div class="strategy-selector">
							<div class="strategy-chip skip @(GetAutoNegotiateStrategy() == -1 ? "selected" : "")" onclick=@(() => SetAutoNegotiateStrategy(-1))>@L("ui.battle.skip")</div>
							<div class="strategy-chip @(GetAutoNegotiateStrategy() == 0 ? "selected" : "")" onclick=@(() => SetAutoNegotiateStrategy(0))>@L("ui.battle.gen") <span class="ink-cost">3<img class="currency-icon" src="ui/icons/currency/ink.svg" /></span></div>
							<div class="strategy-chip @(GetAutoNegotiateStrategy() == 1 ? "selected" : "")" onclick=@(() => SetAutoNegotiateStrategy(1))>@L("ui.battle.fair") <span class="ink-cost">2<img class="currency-icon" src="ui/icons/currency/ink.svg" /></span></div>
							<div class="strategy-chip @(GetAutoNegotiateStrategy() == 2 ? "selected" : "")" onclick=@(() => SetAutoNegotiateStrategy(2))>@L("ui.battle.str") <span class="ink-cost">1<img class="currency-icon" src="ui/icons/currency/ink.svg" /></span></div>
							<div class="strategy-chip @(GetAutoNegotiateStrategy() == 3 ? "selected" : "")" onclick=@(() => SetAutoNegotiateStrategy(3))>@L("ui.battle.gold") <span class="ink-cost">2<img class="currency-icon" src="ui/icons/currency/ink.svg" /></span></div>
							<div class="strategy-chip target @(GetAutoContractTargetSpecies() != null ? "selected" : "")" onclick=@OpenContractTargetSearch>
								@if (GetAutoContractTargetSpecies() != null)
								{
									var targetName = MonsterManager.Instance?.GetSpecies(GetAutoContractTargetSpecies())?.Name ?? "?";
									<span>@($"TARGET: {targetName}")</span>
								}
								else
								{
									<span>@L("ui.battle.target")</span>
								}
							</div>
							@if (GetAutoContractTargetSpecies() != null)
							{
								<div class="strategy-chip clear" onclick=@ClearContractTarget>✕</div>
							}
						</div>
					}
				</div>

				@if (!IsRaidBattle)
				{
					<button class="control-btn end-btn" onclick=@OnEndExpedition>
						<span class="btn-icon">✕</span>
						<span class="btn-label">@L("ui.battle.end")</span>
					</button>
				}
			}

			@if (IsArenaBattle)
			{
				@if (showRetireConfirm)
				{
					<div class="retire-confirm">
						<span class="retire-confirm-text">@L("ui.battle.retire_confirm")</span>
						<button class="control-btn retire-yes" onclick=@OnRetireConfirmed>
							<span class="btn-label">@L("ui.battle.yes_retire")</span>
						</button>
						<button class="control-btn retire-no" onclick=@(() => showRetireConfirm = false)>
							<span class="btn-label">@L("ui.battle.cancel")</span>
						</button>
					</div>
				}
				else
				{
					<button class="control-btn retire-btn" onclick=@(() => showRetireConfirm = true)>
						<span class="btn-icon">🚪</span>
						<span class="btn-label">@L("ui.battle.retire")</span>
					</button>
				}
			}
		</div>

		<!-- Target indicator (shown when in manual mode, not arena - arena auto-targets active enemy) -->
		@if (CanSelectMoves() && !IsArenaBattle)
		{
			<div class="target-indicator">
				@{
					var currentTarget = GetSelectedTarget();
					if (currentTarget != null)
					{
						<span class="target-label">TARGET:</span>
						<span class="target-name">@currentTarget.Nickname</span>
						<span class="target-hint">(click enemy to change)</span>
					}
				}
			</div>
		}

		<!-- Battle log is now in the wave indicator dropdown above -->
	</div>

	<!-- Contract Negotiation (radial, no overlay) -->
	@if (showNegotiationOverlay && negotiationTarget != null)
	{
		<ContractNegotiationPanel @ref=negotiationPanel IsVisible=@true
								  TargetMonster=@negotiationTarget
								  IsBossContract=@isBossContract
								  OnNegotiationComplete=@OnNegotiationComplete />
	}

	@if (contractTargetSearchOpen)
	{
		<div class="contract-search-overlay" onclick=@CloseContractTargetSearch>
			<div class="contract-search-popup" onclick=@((e) => e.StopPropagation())>
				<div class="contract-search-header">
					<span class="contract-search-title">@L("ui.battle.target_beast")</span>
					<button class="contract-search-close" onclick=@CloseContractTargetSearch>×</button>
				</div>
				<div class="contract-search-input-wrapper">
					<TextEntry class="contract-search-input" @ref="contractTargetSearchInput" Text="@contractTargetSearchText" Placeholder="Type to filter..." />
				</div>
				<div class="contract-search-results">
					@foreach (var species in GetFilteredSpecies())
					{
						<div class="contract-search-result @(GetAutoContractTargetSpecies() == species.Id ? "active" : "")" onclick=@(() => SelectContractTarget(species))>
							<span class="result-number">#@species.BeastiaryNumber</span>
							<img class="result-element-icon" src="ui/icons/elements/background/@(GetElementIconName(species.Element)).svg" />
							<span class="result-name">@species.Name</span>
						</div>
					}
					@if (GetFilteredSpecies().Count == 0)
					{
						<div class="contract-search-empty">@L("ui.battle.no_matches")</div>
					}
				</div>
			</div>
		</div>
	}

</root>

@code {
	// Localization helper
	private string L( string key ) => LocalizationManager.Get( key );
	private string L( string key, params object[] args ) => LocalizationManager.Get( key, args );

	public Action<bool> OnBattleEnd { get; set; }
	public Action OnExpeditionCancelled { get; set; }
	public string ExpeditionId { get; set; } = "";
	public bool IsArenaBattle { get; set; } = false;
	public bool IsRaidBattle { get; set; } = false;
	public bool Use3DBattle { get; set; } = true;
	public Action OnArenaRetire { get; set; }
	public string ArenaPlayerName { get; set; } = "";
	public string ArenaOpponentName { get; set; } = "";
	public int ArenaPlayerWins { get; set; } = 0;
	public int ArenaOpponentWins { get; set; } = 0;
	public int ArenaGameNumber { get; set; } = 1;

	private bool isSubscribed = false;
	private BattleTurn lastTurn = null;
	private string currentMoveAnnouncement = "";
	private float announcementTimer = 0f;
	private const float ANNOUNCEMENT_DURATION = 2.0f;

	// Track recently defeated monsters for fade-out animation
	// Total time = TurnAnimDelay (0.8s hold) + fade out (0.8s) to sync with 3D faint
	private Dictionary<Guid, float> defeatedFadeTimers = new();
	private Dictionary<Guid, Monster> defeatedMonsterCache = new(); // Keep ref so we can render during fade
	private const float DEFEAT_HOLD_DURATION = 0.8f; // Hold visible while hit VFX plays
	private const float DEFEAT_FADE_DURATION = 0.45f; // Then fade out during faint animation
	private const float DEFEAT_TOTAL_DURATION = DEFEAT_HOLD_DURATION + DEFEAT_FADE_DURATION;

	// True after the first wave transition — suppresses CSS entrance animation on subsequent waves
	private bool hasCompletedWaveTransition = false;

	private List<Monster> cachedPlayerTeam = new();
	private List<Monster> cachedEnemyTeam = new();

	// Swap carousel state
	private int swapCarouselIndex = 0;
	private List<Monster> swapTargets = null;

	// Battle log entries (persists across waves in same expedition)
	private List<BattleLogEntry> battleLog = new();
	private const int MAX_LOG_ENTRIES = 50; // Increased for full expedition logging
	private bool isLogExpanded = false; // Compact by default, click to expand
	private string lastLoggedExpeditionId = null;
	private int lastLoggedWave = 0;

	// Horde system: player target selection
	private Guid selectedTargetId = Guid.Empty;

	// Move tooltip state
	private string hoveredMoveId = null;

	// Contract negotiation overlay state
	private bool showNegotiationOverlay = false;
	private Monster negotiationTarget = null;
	private bool isBossContract = false;
	private ContractNegotiationPanel negotiationPanel;
	private bool lastBattleWon = false;
	private bool showRetireConfirm = false;
	// Battle action bar state: "actions" | "moves" | "targets" | "executing"
	private string actionBarState = "actions";
	private string pendingMoveId3D = null;

	private string currentAnnouncement = "";
	private string currentAnnouncementTag = "";
	private string currentAnnouncementTagClass = "";

	private string GetHPColorClass3D(Monster mon)
	{
		if (mon == null) return "high";
		var pct = GetHPPercent(mon);
		if (pct > 50) return "high";
		if (pct > 20) return "medium";
		return "low";
	}

	private List<string> GetMonsterStatuses3D(Monster mon)
	{
		var statuses = new List<string>();
		if (mon == null) return statuses;
		var state = BattleManager.Instance?.CurrentBattleState;
		if (state == null) return statuses;
		if (state.Statuses.TryGetValue(mon.Id, out var activeStatuses))
		{
			foreach (var s in activeStatuses)
				statuses.Add(s.Condition.ToString());
		}
		return statuses;
	}

	/// <summary>
	/// Get the current action bar state, accounting for turn execution
	/// </summary>
	private string GetActionBarState()
	{
		if (actionBarState == "executing")
		{
			// Return to actions once we can select moves again
			if (CanSelectMoves())
			{
				actionBarState = "actions";
				return "actions";
			}
			return "executing";
		}
		if (actionBarState == "swap")
		{
			// If we're no longer waiting for input, exit swap mode
			if (!CanSelectMoves())
			{
				BattleSceneController.Instance?.ClearSwapHighlights();
				swapTargets = null;
				swapCarouselIndex = 0;
				actionBarState = "actions";
				return "actions";
			}
			return "swap";
		}
		return actionBarState;
	}

	/// <summary>
	/// FIGHT button: open move picker
	/// </summary>
	private void OnFight3D()
	{
		actionBarState = "moves";
		BattleSceneController.Instance?.GetCameraController()?.FocusPlayer();
		StateHasChanged();
	}

	/// <summary>
	/// Move chosen in 3D: if multiple enemies alive, show target picker. Otherwise execute immediately.
	/// </summary>
	private void OnMoveChosen3D(string moveId)
	{
		var aliveEnemies = GetEnemyTeam()?.Where(e => e != null && e.CurrentHP > 0).ToList();
		if (aliveEnemies != null && aliveEnemies.Count > 1 && !IsArenaBattle)
		{
			pendingMoveId3D = moveId;
			actionBarState = "targets";
			BattleSceneController.Instance?.GetCameraController()?.FocusEnemies();
			SoundManager.PlayClick();
			StateHasChanged();
		}
		else
		{
			actionBarState = "executing";
			BattleSceneController.Instance?.GetCameraController()?.FocusDefault();
			OnMoveChosen(moveId);
			StateHasChanged();
		}
	}

	/// <summary>
	/// Target chosen after move selection: set target and execute the pending move.
	/// </summary>
	private void OnTargetChosen3D(Monster target)
	{
		if ( target == null ) return;

		// Contract targeting — start negotiation instead of attack
		if ( isContractTargeting )
		{
			isContractTargeting = false;
			StartMidBattleNegotiation( target );
			return;
		}

		if ( pendingMoveId3D == null ) return;
		BattleManager.Instance?.SetPlayerTarget(target);
		actionBarState = "executing";
		BattleSceneController.Instance?.GetCameraController()?.FocusDefault();
		OnMoveChosen(pendingMoveId3D);
		pendingMoveId3D = null;
		SoundManager.PlayClick();
		StateHasChanged();
	}

	/// <summary>
	/// Cancel target selection and go back to move picker or actions
	/// </summary>
	private void OnCancelTargetPicker3D()
	{
		if ( isContractTargeting )
		{
			isContractTargeting = false;
			actionBarState = "actions";
		}
		else
		{
			actionBarState = "moves";
		}
		pendingMoveId3D = null;
		BattleSceneController.Instance?.GetCameraController()?.FocusDefault();
		SoundManager.PlayBack();
		StateHasChanged();
	}

	/// <summary>
	/// Reset 3D battle UI state (called on battle start/end/wave change)
	/// </summary>
	private void Reset3DBattleUI()
	{
		actionBarState = "actions";
		pendingMoveId3D = null;
		isContractTargeting = false;
		contractTarget = null;
		isMidBattleContract = false;
		showNegotiationOverlay = false;
	}


	private List<MonsterMove> GetAvailableMoves3D(Monster mon)
	{
		if (mon == null) return new List<MonsterMove>();
		return mon.Moves?.Where(m => m != null).ToList() ?? new List<MonsterMove>();
	}

