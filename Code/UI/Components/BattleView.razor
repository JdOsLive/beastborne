	// Wave badge text — kept OUT of markup because nested ternaries with multiple
	// interpolated strings (the dollar-quote form with curly placeholders)
	// confuse the s&box Razor parser. It counts the open-curly INSIDE
	// interpolated strings as a block brace and silently drops a closing brace
	// from BuildRenderTree, which surfaces as CS1513 at the top of the code section.
	private string GetWaveBadgeText()
	{
		if ( IsBossWave() ) return "BOSS";
		var totalWaves = ExpeditionManager.Instance?.CurrentExpedition?.Waves ?? 0;
		var current = GetCurrentWave();
		if ( totalWaves > 0 ) return $"WAVE {current}/{totalWaves}";
		return $"WAVE {current}";
	}

