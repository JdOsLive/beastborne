	/// <summary>
	/// BACK button when in CONTRACT targeting — returns to actions and
	/// cancels contract targeting. Replaces the big FIGHT diamond in the
	/// contract picker since "fight" is the wrong semantic here.
	/// </summary>
	private void OnContractBack()
	{
		isContractTargeting = false;
		actionBarState = "actions";
		hoveredTargetSlot = -1;
		BattleSceneController.Instance?.GetCameraController()?.FocusDefault();
		Beastborne.Systems.SoundManager.PlayBack();
		StateHasChanged();
	}

	/// <summary>
	/// BACK button in the target picker — returns to move selection without
	/// committing to an attack.
	/// </summary>
	private void OnTargetBack()
	{
		actionBarState = "moves";
		pendingMoveId3D = null;
		hoveredTargetSlot = -1;
		BattleSceneController.Instance?.GetCameraController()?.FocusPlayer();
		Beastborne.Systems.SoundManager.PlayFightBackWhoosh();
		StateHasChanged();
	}

	/// <summary>
	/// Direct-click swap to a specific beast — skips the carousel + confirm
	/// two-step. Just executes the swap if the beast is available.
	/// </summary>
	private void OnSwapToBeast( Monster beast )
	{
		if ( beast == null || beast.CurrentHP <= 0 ) { return; }
		if ( beast == BattleManager.Instance?.GetActivePlayerMonster() ) { return; }

		int idx = BattleManager.Instance?.GetMonsterIndex( beast ) ?? -1;
		if ( idx < 0 ) { return; }

		BattleManager.Instance.ExecutePlayerSwap( idx );
		actionBarState = "executing";

		BattleSceneController.Instance?.ExitSwapMode();
		BattleSceneController.Instance?.GetCameraController()?.FocusDefault();

		swapTargets = null;
		swapCarouselIndex = 0;
		hoveredSwapSlot = -1;
		Beastborne.Systems.SoundManager.PlayClick();
		StateHasChanged();
	}

	/// <summary>
	/// FIGHT button: open move picker. If already in moves state, toggle back
	/// to actions — the FIGHT diamond doubles as the back button now that the
	/// 4 moves bloom out around it as element-tinted diamonds.
	/// </summary>
	private void OnFight3D()
	{
		if (actionBarState == "targets")
		{
			// In targets, FIGHT acts as BACK to moves picker.
			actionBarState = "moves";
			pendingMoveId3D = null;
			hoveredTargetSlot = -1;
			BattleSceneController.Instance?.GetCameraController()?.FocusPlayer();
			Beastborne.Systems.SoundManager.PlayFightBackWhoosh();
			StateHasChanged();
			return;
		}

		if (actionBarState == "moves")
		{
			actionBarState = "actions";
			BattleSceneController.Instance?.GetCameraController()?.FocusDefault();
			Beastborne.Systems.SoundManager.PlayFightBackWhoosh();
		}
		else
		{
			actionBarState = "moves";
			BattleSceneController.Instance?.GetCameraController()?.FocusPlayer();
			Beastborne.Systems.SoundManager.PlayFightWhoosh();
			fightBurstKey++;
			fightBurstSince = 0f;
		}
		StateHasChanged();
	}

	/// <summary>
	/// Move chosen in 3D: if multiple enemies alive, show target picker. Otherwise execute immediately.
	/// </summary>
	private void OnMoveChosen3D(string moveId)
	{
		var aliveEnemies = GetEnemyTeam()?.Where(e => e != null && e.CurrentHP > 0).ToList();
		if (aliveEnemies != null && aliveEnemies.Count > 1 && !IsArenaBattle)
		{
			pendingMoveId3D = moveId;
			actionBarState = "targets";
			BattleSceneController.Instance?.GetCameraController()?.FocusEnemies();
			SoundManager.PlayClick();
			StateHasChanged();
		}
		else
		{
			actionBarState = "executing";
			BattleSceneController.Instance?.GetCameraController()?.FocusDefault();
			OnMoveChosen(moveId);
			StateHasChanged();
		}
	}

	/// <summary>
	/// Target chosen after move selection: set target and execute the pending move.
	/// </summary>
	private void OnTargetChosen3D(Monster target)
	{
		if ( target == null ) return;

		// Contract targeting — start negotiation instead of attack
		if ( isContractTargeting )
		{
			isContractTargeting = false;
			StartMidBattleNegotiation( target );
			return;
		}

		if ( pendingMoveId3D == null ) return;
		BattleManager.Instance?.SetPlayerTarget(target);
		actionBarState = "executing";
		BattleSceneController.Instance?.GetCameraController()?.FocusDefault();
		OnMoveChosen(pendingMoveId3D);
		pendingMoveId3D = null;
		SoundManager.PlayClick();
		StateHasChanged();
	}

	/// <summary>
	/// Cancel target selection and go back to move picker or actions
	/// </summary>
	private void OnCancelTargetPicker3D()
	{
		if ( isContractTargeting )
		{
			isContractTargeting = false;
			actionBarState = "actions";
		}
		else
		{
			actionBarState = "moves";
		}
		pendingMoveId3D = null;
		BattleSceneController.Instance?.GetCameraController()?.FocusDefault();
		SoundManager.PlayBack();
		StateHasChanged();
	}

	/// <summary>
	/// Reset 3D battle UI state (called on battle start/end/wave change)
	/// </summary>
	private void Reset3DBattleUI()
	{
		actionBarState = "actions";
		pendingMoveId3D = null;
		isContractTargeting = false;
		contractTarget = null;
		isMidBattleContract = false;
		showNegotiationOverlay = false;
	}


