	private void OnContract3D()
	{
		if ( !HasContractInk() ) { SoundManager.PlayDeny(); return; }

		var aliveEnemies = GetEnemyTeam()?.Where( e => e != null && e.CurrentHP > 0 && !e.WasContracted ).ToList();
		if ( aliveEnemies == null || aliveEnemies.Count == 0 ) { SoundManager.PlayDeny(); return; }

		// Check if any enemies are catchable
		var catchable = aliveEnemies.Where( e => {
			var sp = MonsterManager.Instance?.GetSpecies( e.SpeciesId );
			return sp?.IsCatchable == true;
		}).ToList();
		if ( catchable.Count == 0 ) { SoundManager.PlayDeny(); return; }

		if ( catchable.Count == 1 )
		{
			StartMidBattleNegotiation( catchable[0] );
		}
		else
		{
			isContractTargeting = true;
			actionBarState = "targets";
			BattleSceneController.Instance?.GetCameraController()?.FocusEnemies();
			SoundManager.PlayClick();
			StateHasChanged();
		}
	}

	private void StartMidBattleNegotiation( Monster enemy )
	{
		contractTarget = enemy;
		negotiationTarget = enemy;
		isMidBattleContract = true;
		isBossContract = enemy.IsBoss;
		showNegotiationOverlay = true;
		actionBarState = "actions";

		// Zoom camera in on the enemy
		BattleSceneController.Instance?.GetCameraController()?.FocusEnemies();

		// Spend 1 ink entry fee (non-refundable)
		TamerManager.Instance?.SpendContractInk( 1 );

		// Track attempt count for escalating cost
		enemy.ContractAttemptsThisBattle++;

		SoundManager.PlayClick();
		StateHasChanged();
	}

