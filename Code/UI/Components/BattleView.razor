	private class BattleLogEntry
	{
		public string Text { get; set; }
		public string Type { get; set; } = "normal"; // normal, damage, heal, status, super, crit, miss, swap, buff, debuff, guard, ko, wave
		public string AttackerName { get; set; }
		public string DefenderName { get; set; }
		public string MoveName { get; set; }
		public ElementType? MoveElement { get; set; }
		public int Damage { get; set; }
		public bool IsCritical { get; set; }
		public bool IsSuperEffective { get; set; }
		public bool IsPlayerAttacker { get; set; }
		public string IconOverride { get; set; } // lucide icon name for non-element entries
		public float Timestamp { get; set; } // RealTime.Now when entry was created
	}

