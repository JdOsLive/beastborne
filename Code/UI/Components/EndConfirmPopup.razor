@namespace Beastborne.UI.Components
@using Sandbox;
@using Sandbox.UI;
@using Beastborne.Core;
@using Beastborne.Systems;
@inherits Panel

<root class="end-confirm-root @(IsVisible ? "visible" : "")">
	<div class="end-confirm-overlay" onclick=@Close></div>
	<div class="end-confirm-popup">
		<span class="end-confirm-text">Are you sure you want to end the expedition?</span>
		<div class="end-confirm-buttons">
			<button class="end-confirm-btn end-confirm-yes" onclick=@OnLeave onmouseover=@(() => SoundManager.PlayHover())>
				<span class="end-confirm-btn-text">LEAVE</span>
			</button>
			<button class="end-confirm-btn end-confirm-no" onclick=@Close onmouseover=@(() => SoundManager.PlayHover())>
				<span class="end-confirm-btn-text">CANCEL</span>
			</button>
		</div>
	</div>
</root>

@code {
	public static bool IsVisible { get; private set; }
	public static Action OnConfirmed { get; set; }

	public static void Show( Action onConfirmed )
	{
		OnConfirmed = onConfirmed;
		IsVisible = true;
		SoundManager.PlayClick();
	}

	public static void Close()
	{
		IsVisible = false;
		OnConfirmed = null;
		SoundManager.PlayBack();
	}

	private void OnLeave()
	{
		IsVisible = false;
		OnConfirmed?.Invoke();
		OnConfirmed = null;
	}

	protected override int BuildHash()
	{
		return HashCode.Combine( IsVisible );
	}
}
