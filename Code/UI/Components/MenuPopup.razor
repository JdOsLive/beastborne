@namespace Beastborne.UI.Components
@using Sandbox;
@using Sandbox.UI;
@using Beastborne.Core;
@using Beastborne.Systems;
@using Beastborne.UI;
@using Beastborne.UI.Panels;
@inherits Panel

<root class="menu-container @(IsVisible ? "visible" : "") @LayoutClass">

	@* Dimming overlay — click anywhere outside to close *@
	<div class="menu-overlay" onclick=@Close></div>

	@* Compact SYSTEM slab — dock-tier OS chrome (violet on dark). Centered:
	   the bottom command bar (its old anchor) is retired. The slab surface
	   lives on .mp-body; the living ring is a LATER sibling so it paints
	   above the body fill (absolute children paint behind their own
	   parent's background-color in s&box). *@
	<div class="menu-popup" @ref="popupRoot">
	  <div class="mp-body">

		@* Header — violet kicker seam (the panel's one angled element) + italic title *@
		<div class="popup-header">
			<div class="header-left">
				<div class="mp-kicker"><span>TAMERLINK OS</span></div>
				<span class="header-title">SYSTEM</span>
			</div>
			<div class="header-right">
				<button class="version-chip"
						onclick=@OnVersionClicked
						onmouseover=@(() => OnHover("version"))>
					<iconify icon="lucide:sparkles" Size=@(11) Color="#ffce3a" />
					<span class="version-text">v@(GameVersion)</span>
				</button>
				<button class="close-btn" onclick=@Close onmouseover=@(() => OnHover("close"))>
					<iconify icon="lucide:x" Size=@(14) Color="rgba(255, 255, 255, 0.85)" />
				</button>
			</div>
		</div>

		@* Tile list — vertical, 5 launchers. Uniform dock identity: dark
		   tiles, violet glyphs (no per-tile rainbow — this is OS chrome). *@
		<div class="popup-tiles">

			<button class="tile @(_kbIndex == 0 ? "kb-active" : "")"
					onclick=@OnHelpClicked
					onmouseover=@(() => OnHover("help"))>
				<div class="tile-icon-frame">
					<iconify icon="lucide:book-open" Size=@(19) Color="#9b6cff" />
				</div>
				<div class="tile-text">
					<span class="tile-label">@L("ui.menu_popup.help")</span>
					<span class="tile-desc">@L("ui.menu_popup.help_desc")</span>
				</div>
				<iconify class="tile-chevron" icon="lucide:chevron-right" Size=@(15) Color="rgba(255, 255, 255, 0.4)" />
			</button>

			<button class="tile @(_kbIndex == 1 ? "kb-active" : "")"
					onclick=@OnAchievementsClicked
					onmouseover=@(() => OnHover("achievements"))>
				<div class="tile-icon-frame">
					<iconify icon="lucide:trophy" Size=@(19) Color="#9b6cff" />
				</div>
				<div class="tile-text">
					<span class="tile-label">@L("ui.menu_popup.achievements")</span>
					<span class="tile-desc">@L("ui.menu_popup.achievements_desc")</span>
				</div>
				<iconify class="tile-chevron" icon="lucide:chevron-right" Size=@(15) Color="rgba(255, 255, 255, 0.4)" />
			</button>

			<button class="tile @(_kbIndex == 2 ? "kb-active" : "")"
					onclick=@OnOptionsClicked
					onmouseover=@(() => OnHover("options"))>
				<div class="tile-icon-frame">
					<iconify icon="lucide:settings" Size=@(19) Color="#9b6cff" />
				</div>
				<div class="tile-text">
					<span class="tile-label">@L("ui.menu_popup.options")</span>
					<span class="tile-desc">@L("ui.menu_popup.options_desc")</span>
				</div>
				<iconify class="tile-chevron" icon="lucide:chevron-right" Size=@(15) Color="rgba(255, 255, 255, 0.4)" />
			</button>

			<button class="tile @(_kbIndex == 3 ? "kb-active" : "")"
					onclick=@OnFeedbackClicked
					onmouseover=@(() => OnHover("feedback"))>
				<div class="tile-icon-frame">
					<iconify icon="lucide:message-square-heart" Size=@(19) Color="#9b6cff" />
				</div>
				<div class="tile-text">
					<span class="tile-label">Feedback</span>
					<span class="tile-desc">Bugs · ideas · upvotes</span>
				</div>
				<iconify class="tile-chevron" icon="lucide:chevron-right" Size=@(15) Color="rgba(255, 255, 255, 0.4)" />
			</button>

		</div>

		@* Utility row — language + sound + discord + credits *@
		<div class="popup-utility-row">
			<div class="utility-cluster">
				<button class="utility-chip lang-chip @(CurrentLangCode == "en" ? "active" : "")"
						onclick=@(() => SetLanguage("en"))
						onmouseover=@(() => OnHover("lang-en"))>
					<iconify class="utility-flag" icon="circle-flags:gb" Size=@(14) Color="white" />
					<span>EN</span>
				</button>
				<button class="utility-chip lang-chip @(CurrentLangCode == "fr" ? "active" : "")"
						onclick=@(() => SetLanguage("fr"))
						onmouseover=@(() => OnHover("lang-fr"))>
					<iconify class="utility-flag" icon="circle-flags:fr" Size=@(14) Color="white" />
					<span>FR</span>
				</button>
			</div>

			<button class="utility-chip"
					onclick=@OnMuteToggle
					onmouseover=@(() => OnHover("mute"))>
				<iconify icon="@(IsMuted ? "lucide:volume-off" : "lucide:volume-2")"
						 Size=@(13)
						 Color="@(IsMuted ? "#fca5a5" : "#9b6cff")" />
			</button>

			<button class="utility-chip discord-chip @(discordCopied ? "copied" : "")"
					onclick=@OnDiscordClicked
					onmouseover=@(() => OnHover("discord"))>
				<img class="utility-discord-glyph" src="/ui/buttons/pixel--discord-white.png" />
			</button>

			<button class="utility-chip"
					onclick=@OnCreditsClicked
					onmouseover=@(() => OnHover("credits"))>
				<iconify icon="lucide:star" Size=@(13) Color="#9b6cff" />
			</button>
		</div>

		@* Discord status text — small inline indicator under utility row *@
		@if (discordCopied)
		{
			<div class="discord-toast">Discord link copied to clipboard</div>
		}

		@* Exit — full-width, distinct treatment *@
		<button class="exit-btn @(_kbIndex == 4 ? "kb-active" : "")"
				onclick=@OnMainMenuClicked
				onmouseover=@(() => OnHover("exit"))>
			<iconify icon="lucide:log-out" Size=@(15) Color="#fca5a5" />
			<span>@L("ui.menu_popup.return_menu")</span>
			<iconify class="exit-chevron" icon="lucide:chevron-right" Size=@(14) Color="rgba(252, 165, 165, 0.5)" />
		</button>

	  </div>

	  @* THE LIVING RING — one violet cursor gliding between the launchers.
	     Position written imperatively from UpdateRing (event-driven target,
	     CSS transition carries the glide); the ink-lean wave is a per-frame
	     imperative transform (flat panel — no perspective subtree, safe). *@
	  <div class="mp-ring @(ringVisible ? "on" : "") @(ringSnap ? "snap" : "")" @ref="ringPanel"></div>
	</div>
</root>

@code {
	// Localization helper
	private string L( string key ) => LocalizationManager.Get( key );
	private string L( string key, params object[] args ) => LocalizationManager.Get( key, args );

	public static MenuPopup Instance { get; private set; }

	public bool IsVisible { get; private set; }

	// Layout class kept for compatibility with the old A/B toggle — the
	// horizontal variant was removed in the dock-tier redesign.
	private string LayoutClass => "layout-vertical";

	// Discord link
	private bool discordCopied;
	private const string DiscordLink = "https://discord.gg/dJTTyCqKru";

	// Version (single source — flagged for promotion to a shared const later)
	private const string GameVersion = "1.2.1";

	// Quick-mute state — restores prior master volume on unmute
	private bool IsMuted => SoundManager.MasterVolume <= 0.001f;
	private static float _volumeBeforeMute = 1.0f;

	// Hover sound guard — avoids re-firing hover sound when the user's
	// cursor jitters over the same button. Cleared on hover-out and close.
	private string _lastHoveredKey;

	// Language code (reactive via LocalizationManager)
	private string CurrentLangCode => LocalizationManager.CurrentLanguage;

	protected override void OnAfterTreeRender( bool firstTime )
	{
		if ( firstTime )
		{
			Instance = this;
		}
	}

	public static void Show()
	{
		if ( Instance != null )
		{
			Instance.IsVisible = true;
			Instance._lastHoveredKey = null;
			Instance._kbIndex = 0;
			// Ring warms up snapped for a couple of frames so it doesn't
			// glide in from a stale rect.
			Instance._snapFrames = 3;
			Instance.ringSnap = true;
			Instance.StateHasChanged();
			SoundManager.PlayPopup();
		}
	}

	public static void Hide()
	{
		if ( Instance != null )
		{
			Instance.IsVisible = false;
			Instance._lastHoveredKey = null;
			Instance.ringVisible = false;
			Instance.StateHasChanged();
		}
	}

	public static void Toggle()
	{
		if ( Instance == null ) return;
		if ( Instance.IsVisible ) Instance.Close();
		else Show();
	}

	// NOTE: Esc is reserved by s&box (it opens the system pause / leave-game menu).
	// We close via overlay click + close button + clicking any tile (which opens
	// another panel). Don't bind Esc — it won't fire reliably and conflicts with the
	// platform.

	private void Close()
	{
		SoundManager.PlayPopdown();
		Hide();
	}

	// ────────────────────── KEYBOARD NAVIGATION ──────────────────────
	// Cursor over the 5 launchers: 0 Help, 1 Achievements, 2 Options,
	// 3 Feedback, 4 Return-to-Menu. Up/Down move, Space/Enter activates,
	// Menu/run closes. Escape is NOT bound (reserved by s&box).
	private int _kbIndex = 0;

	private static readonly int KbLauncherCount = 5;

	// ────────────────────── THE LIVING RING ──────────────────────
	// One violet cursor shared by keyboard AND mouse (hover re-anchors the
	// keyboard index, so there is exactly one cursor on screen). Position is
	// recomputed every tick from live Box.Rects (flat panel — layout space is
	// paint space); CSS transitions carry the glide; a per-frame multi-sine
	// ink-lean wave keeps it alive.
	private Panel popupRoot;
	private Panel ringPanel;
	private bool ringVisible;
	private bool ringSnap = true;
	private int _snapFrames;
	private float _lastRingL = -9999f, _lastRingT, _lastRingW, _lastRingH;

	// Ring geometry — small-control scale of the flat recipe: 3px border,
	// 6px outset. Content-box: declared size = target + 2*outset − 2*border.
	private const float RingOutset = 6f;
	private const float RingBorder = 3f;

	public override void Tick()
	{
		base.Tick();
		if ( !IsVisible )
		{
			if ( ringVisible ) { ringVisible = false; StateHasChanged(); }
			return;
		}

		UpdateRing();
		ApplyRingWave();

		if ( !UIModalState.IsTopModal( "MenuPopup" ) ) return;

		if ( Input.Pressed( "Up" ) || Input.Pressed( "Left" ) )
		{
			_kbIndex = Math.Max( 0, _kbIndex - 1 );
			SoundManager.PlayHover();
			StateHasChanged();
		}
		else if ( Input.Pressed( "Down" ) || Input.Pressed( "Right" ) )
		{
			_kbIndex = Math.Min( KbLauncherCount - 1, _kbIndex + 1 );
			SoundManager.PlayHover();
			StateHasChanged();
		}
		else if ( Input.Pressed( "Jump" ) || Input.Pressed( "Enter" ) )
		{
			switch ( _kbIndex )
			{
				case 0: OnHelpClicked(); break;
				case 1: OnAchievementsClicked(); break;
				case 2: OnOptionsClicked(); break;
				case 3: OnFeedbackClicked(); break;
				case 4: OnMainMenuClicked(); break;
			}
		}
		else if ( Input.Pressed( "Menu" ) || Input.Pressed( "run" ) )
		{
			Close();
		}
	}

	// Find the panel the cursor sits on: indices 0–3 are the .tile launchers
	// in DOM order, index 4 is the .exit-btn. Fresh traversal every call —
	// loop @refs don't exist and traversal is hotload-safe.
	private Panel FindRingTarget()
	{
		if ( popupRoot == null ) return null;
		int seen = 0;
		if ( _kbIndex == 4 )
			return FindByClass( popupRoot, "exit-btn", 0, ref seen );
		return FindByClass( popupRoot, "tile", _kbIndex, ref seen );
	}

	private Panel FindByClass( Panel node, string cls, int nth, ref int seen )
	{
		foreach ( var child in node.Children )
		{
			if ( child.HasClass( cls ) )
			{
				if ( seen == nth ) return child;
				seen++;
			}
			var deeper = FindByClass( child, cls, nth, ref seen );
			if ( deeper != null ) return deeper;
		}
		return null;
	}

	private void UpdateRing()
	{
		if ( ringPanel == null || popupRoot == null ) return;
		var target = FindRingTarget();
		if ( target == null ) return;

		var tr = target.Box.Rect;
		var pr = popupRoot.Box.Rect;
		if ( tr.Width <= 0 || pr.Width <= 0 ) return;

		float s = ScaleFromScreen;
		float l = (tr.Left - pr.Left) * s - RingOutset;
		float t = (tr.Top - pr.Top) * s - RingOutset;
		float w = tr.Width * s + RingOutset * 2f - RingBorder * 2f;
		float h = tr.Height * s + RingOutset * 2f - RingBorder * 2f;

		// Only write when the target rect actually moved — the CSS transition
		// carries the glide between writes.
		if ( Math.Abs( l - _lastRingL ) > 0.5f || Math.Abs( t - _lastRingT ) > 0.5f
			|| Math.Abs( w - _lastRingW ) > 0.5f || Math.Abs( h - _lastRingH ) > 0.5f )
		{
			ringPanel.Style.Left = Length.Pixels( l );
			ringPanel.Style.Top = Length.Pixels( t );
			ringPanel.Style.Width = Length.Pixels( w );
			ringPanel.Style.Height = Length.Pixels( h );
			_lastRingL = l; _lastRingT = t; _lastRingW = w; _lastRingH = h;
		}

		if ( !ringVisible ) { ringVisible = true; StateHasChanged(); }

		if ( _snapFrames > 0 )
		{
			_snapFrames--;
			if ( _snapFrames == 0 && ringSnap ) { ringSnap = false; StateHasChanged(); }
		}
	}

	// The ink-lean wave — the menu's multi-sine at small-ring amplitude.
	// Per-frame imperative transform is safe here: flat panel, no
	// perspective ancestor (the 7fps law is a leaned-subtree law).
	private void ApplyRingWave()
	{
		if ( ringPanel == null || !ringVisible ) return;
		// PawPad v5.1 liquid mix (skewY/rotZ-forward + out-of-phase breathing),
		// scaled down a touch for the smaller row targets here.
		float wt = Time.Now;
		float skX = ( 2.0f * MathF.Sin( wt * 2.2f ) + 0.7f * MathF.Sin( wt * 3.5f + 1.1f ) ) * 0.45f;
		float skY = ( 2.3f * MathF.Sin( wt * 1.8f + 1.9f ) + 0.9f * MathF.Sin( wt * 2.9f ) ) * 0.45f;
		float rotZ = ( 1.1f * MathF.Sin( wt * 1.0f ) + 0.5f * MathF.Sin( wt * 2.4f + 0.5f ) ) * 0.45f;
		float brX = 1f + 0.010f * MathF.Sin( wt * 1.35f + 0.7f ) + 0.005f * MathF.Sin( wt * 2.7f );
		float brY = 1f + 0.010f * MathF.Sin( wt * 1.15f + 2.6f ) + 0.005f * MathF.Sin( wt * 2.3f + 1.4f );

		var tx = new PanelTransform();
		tx.AddRotation( 0f, 0f, rotZ );
		tx.AddSkew( skX, skY, 0f );
		tx.AddScale( new Vector2( brX, brY ) );
		ringPanel.Style.Transform = tx;
	}

	// Hover on a launcher re-anchors the keyboard cursor (one cursor, house
	// last-input-wins pattern). Other hover keys just play the sound.
	private void OnHover( string key )
	{
		if ( _lastHoveredKey == key ) return;
		_lastHoveredKey = key;

		int idx = key switch
		{
			"help" => 0,
			"achievements" => 1,
			"options" => 2,
			"feedback" => 3,
			"exit" => 4,
			_ => -1
		};
		if ( idx >= 0 && idx != _kbIndex )
		{
			_kbIndex = idx;
			StateHasChanged();
		}

		SoundManager.PlayHover();
	}

	private void OnOptionsClicked()
	{
		SoundManager.PlayForward();
		Hide();
		OptionsPanel.Show();
	}

	private void OnHelpClicked()
	{
		SoundManager.PlayForward();
		Hide();
		HelpPanel.Show();
	}

	private void OnAchievementsClicked()
	{
		SoundManager.PlayForward();
		Hide();
		AchievementPanel.Toggle();
	}

	private void OnCreditsClicked()
	{
		SoundManager.PlayForward();
		Hide();
		CreditsPanel.Show();
	}

	private void OnVersionClicked()
	{
		// Same destination as Credits for now — if a "What's New" panel is
		// added later, redirect this call.
		SoundManager.PlayForward();
		Hide();
		CreditsPanel.Show();
	}

	private void OnFeedbackClicked()
	{
		SoundManager.PlayForward();
		Hide();
		FeedbackPanel.Show();
	}

	private void OnMainMenuClicked()
	{
		SoundManager.PlayForward();
		Hide();
		GameManager.Instance?.ReturnToMainMenu();
	}

	private async void OnDiscordClicked()
	{
		SoundManager.PlayClick();
		Clipboard.SetText( DiscordLink );
		discordCopied = true;
		StateHasChanged();
		await Task.Delay( 1800 );
		discordCopied = false;
		StateHasChanged();
	}

	private void SetLanguage( string code )
	{
		if ( LocalizationManager.CurrentLanguage == code ) return;
		SoundManager.PlayClick();
		LocalizationManager.SetLanguage( code );
		StateHasChanged();
	}

	private void OnMuteToggle()
	{
		SoundManager.PlayClick();
		if ( IsMuted )
		{
			SoundManager.MasterVolume = _volumeBeforeMute > 0.001f ? _volumeBeforeMute : 1.0f;
		}
		else
		{
			_volumeBeforeMute = SoundManager.MasterVolume;
			SoundManager.MasterVolume = 0f;
		}
		StateHasChanged();
	}

	protected override int BuildHash()
	{
		return HashCode.Combine(
			IsVisible,
			discordCopied,
			CurrentLangCode,
			IsMuted,
			_kbIndex,
			ringVisible,
			ringSnap
		);
	}
}
