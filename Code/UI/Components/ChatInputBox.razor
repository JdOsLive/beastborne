@using Sandbox;
@using Sandbox.UI;
@namespace Beastborne.UI.Components
@inherits Panel

<root class="chat-input-wrapper">
	<TextEntry
		class="chat-input"
		@ref="textEntry"
		Text="@inputText"
		Placeholder="@Placeholder"
	/>
</root>

@code {
	public Action OnSubmit { get; set; }
	/// <summary>Placeholder text — the PawPad chat names the channel ("Message global…").</summary>
	public string Placeholder { get; set; } = "Type a message...";
	private string inputText = "";
	private TextEntry textEntry;

	public void FocusInput()
	{
		textEntry?.Focus();
		ChatPanel.IsChatFocused = true;
	}

	/// <summary>Stamp of the last blur (Esc / programmatic / focus lost) — a
	/// same-frame latch for pollers: the Esc that blurred the entry is still
	/// edge-true this frame and must not ALSO read as "back" (PhoneLauncher).</summary>
	public static float LastBlurAt = -999f;

	/// <summary>Give the keyboard back. Safe when nothing is focused. Named
	/// BlurInput (not Blur) so it does not shadow Panel.Blur().</summary>
	public void BlurInput()
	{
		textEntry?.Blur();
		ChatPanel.IsChatFocused = false;
		LastBlurAt = Time.Now;
	}

	public string GetText()
	{
		return textEntry?.Text ?? "";
	}

	public void ClearText()
	{
		if ( textEntry != null )
		{
			textEntry.Text = "";
		}
		inputText = "";
		StateHasChanged();
	}

	protected override void OnAfterTreeRender( bool firstTime )
	{
		base.OnAfterTreeRender( firstTime );

		if ( firstTime && textEntry != null )
		{
			textEntry.AddEventListener( "onfocus", ( e ) => OnInputFocus() );
			textEntry.AddEventListener( "onblur", ( e ) => OnInputBlur() );
			// Esc inside the entry — the engine's cancel event, if TextEntry raises
			// it (VERIFY LIVE); PhoneLauncher also polls Escape as a fallback.
			textEntry.AddEventListener( "oncancel", ( e ) => BlurInput() );
			textEntry.AddEventListener( "onsubmit", ( e ) => OnSubmit?.Invoke() );
		}
	}

	private void OnInputFocus()
	{
		ChatPanel.IsChatFocused = true;
	}

	private void OnInputBlur()
	{
		ChatPanel.IsChatFocused = false;
		LastBlurAt = Time.Now;
	}
}
