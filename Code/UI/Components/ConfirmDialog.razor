@namespace Beastborne.UI.Components
@using Sandbox;
@using Sandbox.UI;
@using Beastborne.Systems;
@using Beastborne.UI;
@using Beastborne.UI.Primitives;
@inherits Panel

@*
    ConfirmDialog — canonical "are you sure?" modal for destructive or
    irreversible actions. Replaces 5 hand-rolled confirm dialogs.

    Convention (Beastborne house style, decided here):
        - Destructive button on the LEFT, cancel on the RIGHT.
        - Cancel is the safe default; player's eye + cursor naturally rest
          there after reading. Destructive requires deliberate movement.
        - Frame: 16px radius, dark rgba(12,10,22,0.98) bg, 1px tone-tinted
          border (red destructive, gold warning, purple benign).
        - 24/28 padding, 14px gap between body and buttons.
        - Buttons are BbButton primitives (Code/UI/Primitives/): confirm =
          commit (red) / primary (gold — warning + purple tones), cancel =
          ghost. Keyboard cursor = the violet focus ring (Focused param).

    Usage (static, mounted globally — see GameHUD):
        ConfirmDialog.Show(
            title: "Release this beast?",
            body: "This action cannot be undone.",
            destructiveLabel: "RELEASE",
            tone: "red",
            onConfirm: () => DoRelease());
*@

<root class="bb-confirm-root @(IsVisible ? "visible" : "")">
    <div class="bb-confirm-overlay" onclick=@Close></div>
    <div class="bb-confirm-frame tone-@_tone" onclick:stopPropagation>
        @if (!string.IsNullOrEmpty(_iconName))
        {
            <div class="bb-confirm-icon">
                <iconify icon="@_iconName" Size=@(28) Color="@GetIconColor()" />
            </div>
        }
        <span class="bb-confirm-title">@_title</span>
        @if (!string.IsNullOrEmpty(_body))
        {
            <span class="bb-confirm-body">@_body</span>
        }
        <div class="bb-confirm-buttons">
            <BbButton Class="bb-confirm-btn destructive"
                      Tier=@GetConfirmTier() Size=@(44) Stretch=@true
                      Label=@_destructiveLabel Focused=@(_kbIndex == 0)
                      OnClick=@OnConfirmClick />
            <BbButton Class="bb-confirm-btn cancel"
                      Tier="ghost" Size=@(44) Stretch=@true
                      Label=@_cancelLabel Focused=@(_kbIndex == 1)
                      OnClick=@Close />
        </div>
    </div>
</root>

@code {
    public static bool IsVisible { get; private set; }

    private static string _title = "";
    private static string _body = "";
    private static string _destructiveLabel = "CONFIRM";
    private static string _cancelLabel = "CANCEL";
    private static string _tone = "red"; // red | gold | purple
    private static string _iconName = "";
    private static Action _onConfirm;

    // Keyboard cursor — 0 = destructive (left), 1 = cancel (right). Defaults
    // to 1: cancel is the Beastborne-house safe default (the player's eye and
    // cursor rest there). Reset on every Show().
    private static int _kbIndex = 1;

    public static void Show(
        string title,
        string body = "",
        string destructiveLabel = "CONFIRM",
        string cancelLabel = "CANCEL",
        string tone = "red",
        string iconName = "lucide:triangle-alert",
        Action onConfirm = null)
    {
        _title = title;
        _body = body;
        _destructiveLabel = destructiveLabel;
        _cancelLabel = cancelLabel;
        _tone = tone;
        _iconName = iconName;
        _onConfirm = onConfirm;
        _kbIndex = 1; // safe default: cancel
        IsVisible = true;
        SoundManager.PlayClick();
    }

    /// <summary>
    /// Keyboard handling — s&box calls Panel.Tick() automatically. Only the
    /// top-priority open modal reacts (ConfirmDialog is always highest).
    /// Left/Right pick yes/no, Space/Enter activates, Menu/run cancels.
    /// Escape is intentionally NOT bound (reserved by s&box).
    /// </summary>
    public override void Tick()
    {
        base.Tick();
        if ( !IsVisible ) return;
        if ( !UIModalState.IsTopModal( "ConfirmDialog" ) ) return;

        if ( Input.Pressed( "Left" ) || Input.Pressed( "Right" )
            || Input.Pressed( "Up" ) || Input.Pressed( "Down" ) )
        {
            _kbIndex = _kbIndex == 0 ? 1 : 0;
            SoundManager.PlayHover();
        }
        else if ( Input.Pressed( "Jump" ) || Input.Pressed( "Enter" ) )
        {
            if ( _kbIndex == 0 ) OnConfirmClick();
            else Close();
        }
        else if ( Input.Pressed( "Menu" ) || Input.Pressed( "run" ) )
        {
            Close();
        }
    }

    public static void Close()
    {
        IsVisible = false;
        _onConfirm = null;
        SoundManager.PlayBack();
    }

    private void OnConfirmClick()
    {
        IsVisible = false;
        var action = _onConfirm;
        _onConfirm = null;
        action?.Invoke();
    }

    /// <summary>
    /// Tone → BbButton tier. Semantic accent doctrine (guiding-star): violet
    /// means selection/"you", NEVER an action color — so purple-tone dialogs
    /// (benign-but-irreversible, e.g. "Claim leadership") get the gold
    /// primary tier; the purple identity stays on the frame border + icon.
    /// </summary>
    private string GetConfirmTier() => _tone switch
    {
        "gold" => "primary",
        "purple" => "primary",
        _ => "commit",
    };

    private string GetIconColor()
    {
        return _tone switch
        {
            "gold" => "#fbbf24",
            "purple" => "#a78bfa",
            _ => "#ef4444",
        };
    }

    protected override int BuildHash()
    {
        return HashCode.Combine(IsVisible, _title, _body, _tone, _destructiveLabel, _cancelLabel, _kbIndex);
    }
}
