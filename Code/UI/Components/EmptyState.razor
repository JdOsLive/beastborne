@namespace Beastborne.UI.Components
@using Sandbox;
@using Sandbox.UI;
@inherits Panel

@*
    EmptyState — canonical "nothing here" panel block.
    Modeled on the FeedbackPanel .fb-empty pattern (the most polished of the
    15+ hand-rolled empty states in the project): diamond frame icon + title
    + body + optional CTA button.

    Usage:
    <EmptyState
        Icon="lucide:search-x"
        Title="No beasts match these filters"
        Body="Try clearing the rarity filter or removing the search."
        Size="full"
        CtaLabel="Clear filters"
        OnCta=@ClearFilters />

    Size: "full" (88px diamond, padded for full-panel empties) or "inline"
    (64px diamond, smaller padding for sidebar/sub-section empties).
    OmitIcon=true skips the diamond frame entirely (text-only empty).
*@

<root class="bb-empty @(Size == "inline" ? "is-inline" : "is-full")">
    @if (!OmitIcon && !string.IsNullOrEmpty(Icon))
    {
        <div class="bb-empty-frame">
            <div class="bb-empty-frame-bg"></div>
            <iconify class="bb-empty-icon" icon="@Icon" Size=@(Size == "inline" ? 28 : 36) Color="rgba(196, 181, 253, 0.85)" />
        </div>
    }
    <div class="bb-empty-text">
        @if (!string.IsNullOrEmpty(Title))
        {
            <span class="bb-empty-title">@Title</span>
        }
        @if (!string.IsNullOrEmpty(Body))
        {
            <span class="bb-empty-body">@Body</span>
        }
    </div>
    @if (!string.IsNullOrEmpty(CtaLabel) && OnCta != null)
    {
        <button class="bb-empty-cta @CtaTone" onclick=@(() => OnCta?.Invoke())>
            @if (!string.IsNullOrEmpty(CtaIcon))
            {
                <iconify icon="@CtaIcon" Size=@(13) Color="#ffffff" />
            }
            <span>@CtaLabel</span>
        </button>
    }
</root>

@code {
    [Property] public string Icon { get; set; } = "lucide:inbox";
    [Property] public string Title { get; set; } = "";
    [Property] public string Body { get; set; } = "";
    [Property] public string Size { get; set; } = "full";
    [Property] public bool OmitIcon { get; set; } = false;

    [Property] public string CtaLabel { get; set; } = "";
    [Property] public string CtaIcon { get; set; } = "";
    [Property] public string CtaTone { get; set; } = ""; // "is-bug" (red) | "is-idea" (blue) | empty (purple default)
    [Property] public Action OnCta { get; set; }

    protected override int BuildHash()
    {
        return HashCode.Combine(Icon, Title, Body, Size, OmitIcon, CtaLabel, CtaIcon, CtaTone);
    }
}
