@namespace Beastborne.UI.Components
@using System.Linq
@using Sandbox
@using Sandbox.UI
@inherits Panel
@attribute [StyleSheet]

@*
    DEV PROBE — two sheets, one panel. Every cell is labelled with the exact CSS it uses; a rule
    the parser rejects simply won't paint (26.06.03+ parser recovers per rule) — that ABSENCE is
    the finding. Delete the panel when the laws are written.

    `dev_shapes`          toggle (keeps the current sheet)
    `dev_shapes scroll`   SHEET 2 (2026-09-10, engine 26.09.08b): NATIVE SCROLLBARS —
                          scrollbar-color / -width / -gutter, auto vs scroll, native + overlay
                          double-up, width consumption (green row edge), Panel.ScrollIntoView.
    `dev_shapes shapes`   SHEET 1 (2026-09-01, engine 26.09.01): border-shape SDF polygons /
                          circles · HDR colour multiplication · unified radii · gamma · clip text.
    `dev_shapes_scroll [row9|anc|top|bottom|wheel|dump]`  drives cell B of sheet 2 (see code).
    LAWS RECORDED: .claude/ui-knowledge/learnings.md "2026-09-10 — NATIVE SCROLLBARS" + CLAUDE.md quirks row.
*@

<root class="dsp-root @(IsVisible ? "open" : "")">
    <div class="dsp-sheet">
        @if ( Sheet == "scroll" )
        {
            <div class="dsp-title"><span>DEV · NATIVE SCROLLBAR PROBE — engine 26.09.08b</span></div>

            <div class="dsp-srow4">
                <div class="dsp-scell">
                    <div class="dsp-scroll va">
                        @for ( int i = 0; i < 12; i++ ) { <div class="dsp-srow"><span>ROW @i.ToString( "00" )</span></div> }
                    </div>
                    <span class="dsp-cap">A: overflow-y: scroll — NOTHING else (the unset-default witness: run 1 = NO bar, scrollbar-width computes 0px)</span>
                </div>
                <div class="dsp-scell">
                    <div class="dsp-scroll vb" @ref="_sB">
                        @for ( int i = 0; i < 12; i++ ) { <div class="dsp-srow @(i == 9 ? "tgt" : "")"><span>ROW @i.ToString( "00" )</span></div> }
                    </div>
                    <span class="dsp-cap">B: scrollbar-width: auto + scrollbar-color: #9b6cff #1c1830 (thumb then track) — row 09 gold = dev_shapes_scroll target</span>
                </div>
                <div class="dsp-scell">
                    <div class="dsp-scroll vb2">
                        @for ( int i = 0; i < 12; i++ ) { <div class="dsp-srow"><span>ROW @i.ToString( "00" )</span></div> }
                    </div>
                    <span class="dsp-cap">B2: width auto + scrollbar-color: rgba(155,108,255,.55) rgba(244,241,234,.12) — the house alpha recipe</span>
                </div>
                <div class="dsp-scell">
                    <div class="dsp-scroll vc1">
                        @for ( int i = 0; i < 12; i++ ) { <div class="dsp-srow"><span>ROW @i.ToString( "00" )</span></div> }
                    </div>
                    <span class="dsp-cap">C1: scrollbar-width: thin</span>
                </div>
            </div>

            <div class="dsp-srow4">
                <div class="dsp-scell">
                    <div class="dsp-scroll vc2">
                        @for ( int i = 0; i < 12; i++ ) { <div class="dsp-srow"><span>ROW @i.ToString( "00" )</span></div> }
                    </div>
                    <span class="dsp-cap">C2: scrollbar-width: none</span>
                </div>
                <div class="dsp-scell">
                    <div class="dsp-scroll vc3">
                        @for ( int i = 0; i < 12; i++ ) { <div class="dsp-srow"><span>ROW @i.ToString( "00" )</span></div> }
                    </div>
                    <span class="dsp-cap">C3: scrollbar-width: 4px (a LENGTH) + scrollbar-color #9b6cff #1c1830</span>
                </div>
                <div class="dsp-scell">
                    <div class="dsp-scroll vd">
                        @for ( int i = 0; i < 12; i++ ) { <div class="dsp-srow"><span>ROW @i.ToString( "00" )</span></div> }
                    </div>
                    <span class="dsp-cap">D: width auto + scrollbar-gutter: stable (+ color) — rows narrower? green edge LEFT of the bar = consumed</span>
                </div>
                <div class="dsp-scell">
                    <div class="dsp-scroll vd2">
                        @for ( int i = 0; i < 12; i++ ) { <div class="dsp-srow"><span>ROW @i.ToString( "00" )</span></div> }
                    </div>
                    <span class="dsp-cap">D2: width auto + scrollbar-gutter: stable both-edges (+ color)</span>
                </div>
            </div>

            <div class="dsp-srow4">
                <div class="dsp-scell">
                    <div class="dsp-scroll ve1">
                        @for ( int i = 0; i < 12; i++ ) { <div class="dsp-srow"><span>ROW @i.ToString( "00" )</span></div> }
                    </div>
                    <span class="dsp-cap">E1: overflow-y: auto + width auto, 12 rows (overflows) — bar?</span>
                </div>
                <div class="dsp-scell">
                    <div class="dsp-scroll ve2">
                        @for ( int i = 0; i < 3; i++ ) { <div class="dsp-srow"><span>ROW @i.ToString( "00" )</span></div> }
                    </div>
                    <span class="dsp-cap">E2: overflow-y: auto + width auto, 3 rows (FITS) — bar hidden?</span>
                </div>
                <div class="dsp-scell">
                    <div class="dsp-scroll ve3">
                        @for ( int i = 0; i < 3; i++ ) { <div class="dsp-srow"><span>ROW @i.ToString( "00" )</span></div> }
                    </div>
                    <span class="dsp-cap">E3: overflow-y: scroll + width auto, 3 rows (FITS) — bar or gutter still painted?</span>
                </div>
                <div class="dsp-scell">
                    <div class="dsp-shost">
                        <div class="dsp-scroll vf">
                            @for ( int i = 0; i < 12; i++ ) { <div class="dsp-srow"><span>ROW @i.ToString( "00" )</span></div> }
                        </div>
                        <div class="dsp-ovl-track"><div class="dsp-ovl-thumb"></div></div>
                    </div>
                    <span class="dsp-cap">F: overflow-y: scroll + width auto + the old .pl-sb-track overlay (blue 4px at x 288) — native + overlay DOUBLE UP?</span>
                </div>
            </div>

            <div class="dsp-srow4">
                <div class="dsp-scell">
                    <div class="dsp-scroll vg1">
                        @for ( int i = 0; i < 12; i++ ) { <div class="dsp-srow"><span>ROW @i.ToString( "00" )</span></div> }
                    </div>
                    <span class="dsp-cap">G1: width auto + OUR sheet styles the bar — .vg1 scrollbar { opacity: 1 } · .vg1 scrollbar > .thumb { #ffce3a, radius 0 }</span>
                </div>
                <div class="dsp-scell">
                    <div class="dsp-scroll vg2">
                        @for ( int i = 0; i < 12; i++ ) { <div class="dsp-srow"><span>ROW @i.ToString( "00" )</span></div> }
                    </div>
                    <span class="dsp-cap">G2: width auto + longhands — scrollbar-thumb-color: #4ade80; scrollbar-track-color: #0d0b16</span>
                </div>
                <div class="dsp-scell">
                    <div class="dsp-shost">
                        <div class="dsp-scroll vg3">
                            @for ( int i = 0; i < 12; i++ ) { <div class="dsp-srow"><span>ROW @i.ToString( "00" )</span></div> }
                        </div>
                        <div class="dsp-ovl-track"><div class="dsp-ovl-thumb"></div></div>
                    </div>
                    <span class="dsp-cap">G3: scrollbar-width: none + the old overlay kept (the escape hatch)</span>
                </div>
                <div class="dsp-scell">
                    <div class="dsp-scroll vg4">
                        @for ( int i = 0; i < 12; i++ ) { <div class="dsp-srow"><span>ROW @i.ToString( "00" )</span></div> }
                    </div>
                    <span class="dsp-cap">G4: house recipe — scrollbar-width 4px · scrollbar-color violet .55 / cream .12 · scrollbar-gutter stable</span>
                </div>
            </div>

            <div class="dsp-foot"><span>dev_shapes scroll|shapes · dev_shapes_scroll row9|anc|top|bottom|wheel|dump drives cell B (read the console) · green row edge = each row's right border</span></div>
        }
        else
        {
            <div class="dsp-title"><span>DEV · SHAPES PROBE — engine 26.09.01</span></div>

            <div class="dsp-row">
                <div class="dsp-cell"><div class="dsp-chip skew"><span>SKEW CHIP</span></div><span class="dsp-cap">A: transform skewX(-12deg) + counter-skew span (today)</span></div>
                <div class="dsp-cell"><div class="dsp-chip poly"><span>POLY CHIP</span></div><span class="dsp-cap">B: border-shape polygon, upright text, no transform</span></div>
                <div class="dsp-cell"><div class="dsp-chip poly bordered"><span>POLY + BORDER</span></div><span class="dsp-cap">C: polygon + 2px border (does the border follow the slope?)</span></div>
                <div class="dsp-cell"><div class="dsp-chip poly" onclick=@(() => Log.Info( "[dev_shapes] POLY CHIP hit — click landed inside the polygon" ))><span>CLICK ME</span></div><span class="dsp-cap">D: hit-test — click the corner OUTSIDE the slope: should NOT log</span></div>
            </div>

            <div class="dsp-row">
                <div class="dsp-cell"><div class="dsp-ava r999"><img src="ui/monsters/embrik/idle/embrik_idle_01.png" /></div><span class="dsp-cap">E: border-radius 999px + overflow hidden (old law: clipped to nothing)</span></div>
                <div class="dsp-cell"><div class="dsp-ava circ"><img src="ui/monsters/embrik/idle/embrik_idle_01.png" /></div><span class="dsp-cap">F: border-shape circle() clip</span></div>
                <div class="dsp-cell"><div class="dsp-pill"><span>PILL 100px</span></div><span class="dsp-cap">G: border-radius 100px on 40 tall — clamps to a pill?</span></div>
                <div class="dsp-cell"><div class="dsp-hv"></div><span class="dsp-cap">H: border-radius 40px / 12px (h/v radii)</span></div>
            </div>

            <div class="dsp-row">
                <div class="dsp-cell"><div class="dsp-ring sdr"></div><span class="dsp-cap">I: ring border 4px #9b6cff (SDR reference)</span></div>
                <div class="dsp-cell"><div class="dsp-ring hdr"></div><span class="dsp-cap">J: ring border 4px #9b6cff * 8 (thin ring, high multiplier)</span></div>
                <div class="dsp-cell"><div class="dsp-ring hdr6"></div><span class="dsp-cap">J2: ring border 6px #9b6cff * 6 (the chart recipe)</span></div>
                <div class="dsp-cell"><div class="dsp-ring sdr outl"></div><span class="dsp-cap">J3: SDR border + outline 3px rgba(#9b6cff * 6, .6) offset 4</span></div>
                <div class="dsp-cell"><div class="dsp-gold hdr"><span>CLAIM</span></div><span class="dsp-cap">K: gold fill #ffce3a * 3, ink text — edge fattening?</span></div>
                <div class="dsp-cell"><span class="dsp-hdrtext">1,257</span><span class="dsp-cap">L: color #6fb1f0 * 6 on text</span></div>
            </div>

            <div class="dsp-row">
                <div class="dsp-cell"><div class="dsp-alpha"><div class="a12"></div><div class="a24"></div><div class="a45"></div><div class="a55"></div><div class="a80"></div></div><span class="dsp-cap">M: alpha ladder .12 / .24 / .45 / .55 / .80 cream on slab (gamma check vs pre-update memory)</span></div>
                <div class="dsp-cell"><span class="dsp-cliptext">PUBLIC SQUARE</span><span class="dsp-cap">N: background-clip: text gradient</span></div>
                <div class="dsp-cell"><div class="dsp-chip poly shadow"><span>SHADOW</span></div><span class="dsp-cap">O: polygon + filter drop-shadow</span></div>
                <div class="dsp-cell"><div class="dsp-hex"><iconify icon="lucide:flame" Size=@(22) Color="#ff6a3d" /></div><span class="dsp-cap">P: hexagon polygon badge (element diamond replacement)</span></div>
            </div>

            <div class="dsp-row">
                <div class="dsp-cell"><div class="dsp-chip skew rounded"><span>ROUNDED SKEW</span></div><span class="dsp-cap">Q: today's chip — skewX + border-radius 8px (the curve we must keep)</span></div>
                <div class="dsp-cell"><div class="dsp-chip poly rounded"><span>POLY + RADIUS</span></div><span class="dsp-cap">R: polygon + border-radius 8px — does the SDF round the corners?</span></div>
                <div class="dsp-cell"><div class="dsp-chip poly8"><span>8-VERTEX</span></div><span class="dsp-cap">S: 8-vertex chamfered parallelogram (the fallback if R fails)</span></div>
                <div class="dsp-cell"><div class="dsp-chip poly rounded bordered"><span>RADIUS+BORDER</span></div><span class="dsp-cap">T: polygon + radius + 2px border</span></div>
            </div>

            <div class="dsp-foot"><span>dev_shapes again to close · click D's outer corner then read the console</span></div>
        }
    </div>
</root>

@code {
    public static bool IsVisible { get; private set; }
    public static string Sheet { get; private set; } = "scroll";
    private static DevShapesPanel _instance;

    private Panel _sB; // sheet 2, cell B's scroller (width auto + violet colour) — the dev_shapes_scroll target host

    protected override void OnAfterTreeRender( bool firstTime ) { _instance = this; }

    /// <summary>dev_shapes → toggle · dev_shapes scroll|shapes → open that sheet.</summary>
    [ConCmd( "dev_shapes" )]
    public static void Toggle( string sheet = "" )
    {
        if ( !string.IsNullOrWhiteSpace( sheet ) ) { Sheet = sheet.Trim().ToLowerInvariant(); IsVisible = true; }
        else IsVisible = !IsVisible;
        Log.Info( $"[dev_shapes] {( IsVisible ? "open" : "closed" )} sheet={Sheet}" );
        _instance?.StateHasChanged();
    }

    /// <summary>
    /// Sheet-2 driver for cell B (overflow-y: scroll + scrollbar-width auto + violet scrollbar-color).
    ///   row9   — Panel.ScrollIntoView( row09.Box.Rect ) — the new 26.09.08b API (takes a SCREEN-SPACE Rect, returns bool moved)
    ///   anc    — row11.ScrollAncestorsIntoView() — the child-side helper
    ///   top    — ScrollTo( 0,0 )   ·   bottom — ScrollTo( 0, 9999 ) (doc: clamped)
    ///   wheel  — ScrollOffset += 64 (the codebase's OnMouseWheel write) — does the native thumb follow?
    ///   dump   — child count + every child's rect + the native thumb's rect (the bar is an ordinary LAST child per the engine doc)
    /// </summary>
    [ConCmd( "dev_shapes_scroll" )]
    public static void ScrollProbe( string mode = "row9" )
    {
        var sc = _instance?._sB;
        if ( sc == null || Sheet != "scroll" || !IsVisible ) { Log.Info( "[dev_shapes_scroll] cell B not mounted — run `dev_shapes scroll` first" ); return; }

        var kids = sc.Children.ToList();
        float before = sc.ScrollOffset.y;
        mode = ( mode ?? "row9" ).Trim().ToLowerInvariant();

        switch ( mode )
        {
            case "row9":
            {
                var row = kids.ElementAtOrDefault( 9 );
                if ( row == null ) { Log.Info( "[dev_shapes_scroll] no row 09" ); return; }
                bool moved = sc.ScrollIntoView( row.Box.Rect );
                Log.Info( $"[dev_shapes_scroll] ScrollIntoView(row09.Box.Rect) moved={moved} offset {before:F1} -> {sc.ScrollOffset.y:F1} scrollSize={sc.ScrollSize.y:F1} row09={row.Box.Rect} scroller={sc.Box.Rect}" );
                break;
            }
            case "anc":
            {
                // VERIFIED 2026-09-10 (26.09.08b): Panel.ScrollAncestorsIntoView() is INTERNAL — CS1061 from game code.
                // Only ScrollIntoView( Rect ) and ScrollTo( Vector2 ) are public. Emulate with the row's rect on row 11:
                var row = kids.ElementAtOrDefault( 11 );
                if ( row == null ) { Log.Info( "[dev_shapes_scroll] no row 11" ); return; }
                bool moved = sc.ScrollIntoView( row.Box.Rect );
                Log.Info( $"[dev_shapes_scroll] (ScrollAncestorsIntoView is internal) ScrollIntoView(row11.Box.Rect) moved={moved} offset {before:F1} -> {sc.ScrollOffset.y:F1} row11={row.Box.Rect} scroller={sc.Box.Rect}" );
                break;
            }
            case "top":
                sc.ScrollTo( Vector2.Zero );
                Log.Info( $"[dev_shapes_scroll] ScrollTo(0,0) offset {before:F1} -> {sc.ScrollOffset.y:F1}" );
                break;
            case "bottom":
                sc.ScrollTo( new Vector2( 0f, 9999f ) );
                Log.Info( $"[dev_shapes_scroll] ScrollTo(0,9999) offset {before:F1} -> {sc.ScrollOffset.y:F1} (clamped to scrollSize {sc.ScrollSize.y:F1}?)" );
                break;
            case "wheel":
                sc.ScrollOffset += new Vector2( 0f, 64f );
                Log.Info( $"[dev_shapes_scroll] ScrollOffset += 64 -> {sc.ScrollOffset.y:F1} (does the native thumb follow? screenshot)" );
                break;
            default:
                Log.Info( $"[dev_shapes_scroll] B: kids={kids.Count} (12 rows + native bar?) offset={sc.ScrollOffset.y:F1} scrollSize={sc.ScrollSize.y:F1} scroller={sc.Box.Rect}" );
                for ( int i = 0; i < kids.Count; i++ )
                    Log.Info( $"[dev_shapes_scroll]   kid {i}: rect={kids[i].Box.Rect} kids={kids[i].ChildrenCount}" );
                var thumb = kids.Count > 12 ? kids[12].Children.FirstOrDefault() : null;
                if ( thumb != null ) Log.Info( $"[dev_shapes_scroll]   native thumb rect={thumb.Box.Rect}" );
                break;
        }
    }

    protected override int BuildHash() => HashCode.Combine( IsVisible, Sheet );
}
