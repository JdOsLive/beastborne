@namespace Beastborne.UI.Components
@using Sandbox
@using Sandbox.UI
@inherits Panel
@attribute [StyleSheet]

@*
    DEV PROBE (2026-09-01) — engine 26.09.01 UI rendering update, verified in OUR build:
    border-shape SDF polygons/circles · HDR colour multiplication · unified corner radii ·
    gamma blending · background-clip: text. Toggle with `dev_shapes`. Every cell is labelled
    with the exact CSS it uses; a rule the parser rejects simply won't paint (26.06.03+ parser
    recovers per rule) — that ABSENCE is the finding. Delete the panel when the laws are written.
*@

<root class="dsp-root @(IsVisible ? "open" : "")">
    <div class="dsp-sheet">
        <div class="dsp-title"><span>DEV · SHAPES PROBE — engine 26.09.01</span></div>

        <div class="dsp-row">
            <div class="dsp-cell"><div class="dsp-chip skew"><span>SKEW CHIP</span></div><span class="dsp-cap">A: transform skewX(-12deg) + counter-skew span (today)</span></div>
            <div class="dsp-cell"><div class="dsp-chip poly"><span>POLY CHIP</span></div><span class="dsp-cap">B: border-shape polygon, upright text, no transform</span></div>
            <div class="dsp-cell"><div class="dsp-chip poly bordered"><span>POLY + BORDER</span></div><span class="dsp-cap">C: polygon + 2px border (does the border follow the slope?)</span></div>
            <div class="dsp-cell"><div class="dsp-chip poly" onclick=@(() => Log.Info( "[dev_shapes] POLY CHIP hit — click landed inside the polygon" ))><span>CLICK ME</span></div><span class="dsp-cap">D: hit-test — click the corner OUTSIDE the slope: should NOT log</span></div>
        </div>

        <div class="dsp-row">
            <div class="dsp-cell"><div class="dsp-ava r999"><img src="ui/monsters/embrik/idle/embrik_idle_01.png" /></div><span class="dsp-cap">E: border-radius 999px + overflow hidden (old law: clipped to nothing)</span></div>
            <div class="dsp-cell"><div class="dsp-ava circ"><img src="ui/monsters/embrik/idle/embrik_idle_01.png" /></div><span class="dsp-cap">F: border-shape circle() clip</span></div>
            <div class="dsp-cell"><div class="dsp-pill"><span>PILL 100px</span></div><span class="dsp-cap">G: border-radius 100px on 40 tall — clamps to a pill?</span></div>
            <div class="dsp-cell"><div class="dsp-hv"></div><span class="dsp-cap">H: border-radius 40px / 12px (h/v radii)</span></div>
        </div>

        <div class="dsp-row">
            <div class="dsp-cell"><div class="dsp-ring sdr"></div><span class="dsp-cap">I: ring border 4px #9b6cff (SDR reference)</span></div>
            <div class="dsp-cell"><div class="dsp-ring hdr"></div><span class="dsp-cap">J: ring border 4px #9b6cff * 4 (HDR — should glow)</span></div>
            <div class="dsp-cell"><div class="dsp-gold hdr"><span>CLAIM</span></div><span class="dsp-cap">K: gold fill #ffce3a * 3, ink text — edge fattening?</span></div>
            <div class="dsp-cell"><span class="dsp-hdrtext">1,257</span><span class="dsp-cap">L: color #6fb1f0 * 6 on text</span></div>
        </div>

        <div class="dsp-row">
            <div class="dsp-cell"><div class="dsp-alpha"><div class="a12"></div><div class="a24"></div><div class="a45"></div><div class="a55"></div><div class="a80"></div></div><span class="dsp-cap">M: alpha ladder .12 / .24 / .45 / .55 / .80 cream on slab (gamma check vs pre-update memory)</span></div>
            <div class="dsp-cell"><span class="dsp-cliptext">PUBLIC SQUARE</span><span class="dsp-cap">N: background-clip: text gradient</span></div>
            <div class="dsp-cell"><div class="dsp-chip poly shadow"><span>SHADOW</span></div><span class="dsp-cap">O: polygon + filter drop-shadow</span></div>
            <div class="dsp-cell"><div class="dsp-hex"><iconify icon="lucide:flame" Size=@(22) Color="#ff6a3d" /></div><span class="dsp-cap">P: hexagon polygon badge (element diamond replacement)</span></div>
        </div>

        <div class="dsp-row">
            <div class="dsp-cell"><div class="dsp-chip skew rounded"><span>ROUNDED SKEW</span></div><span class="dsp-cap">Q: today's chip — skewX + border-radius 8px (the curve we must keep)</span></div>
            <div class="dsp-cell"><div class="dsp-chip poly rounded"><span>POLY + RADIUS</span></div><span class="dsp-cap">R: polygon + border-radius 8px — does the SDF round the corners?</span></div>
            <div class="dsp-cell"><div class="dsp-chip poly8"><span>8-VERTEX</span></div><span class="dsp-cap">S: 8-vertex chamfered parallelogram (the fallback if R fails)</span></div>
            <div class="dsp-cell"><div class="dsp-chip poly rounded bordered"><span>RADIUS+BORDER</span></div><span class="dsp-cap">T: polygon + radius + 2px border</span></div>
        </div>

        <div class="dsp-foot"><span>dev_shapes again to close · click D's outer corner then read the console</span></div>
    </div>
</root>

@code {
    public static bool IsVisible { get; private set; }
    private static DevShapesPanel _instance;

    protected override void OnAfterTreeRender( bool firstTime ) { _instance = this; }

    [ConCmd( "dev_shapes" )]
    public static void Toggle()
    {
        IsVisible = !IsVisible;
        Log.Info( $"[dev_shapes] {( IsVisible ? "open" : "closed" )}" );
        _instance?.StateHasChanged();
    }

    protected override int BuildHash() => HashCode.Combine( IsVisible );
}
