@using Sandbox;
@using Sandbox.UI;
@using Beastborne.Core;
@using Beastborne.Data;
@using Beastborne.Systems;
@using Beastborne.UI;
@using Beastborne.UI.Panels;
@using Beastborne.UI.Components;
@using Beastborne.Battle3D;
@inherits PanelComponent

<root class="game-hud @(IsVisible ? "" : "hidden") @(Is3DBattleActive() ? "battle-3d" : "")" onclick=@OnRootClicked>
	<!-- Content Area — full-bleed. Panels pad their own bottom to
	     clear the command bar (reserve ~128px for bar + inset). -->
	<div class="content-area">
		<BattleTransition />
		<!-- Global overlays — must sit at GameHUD level, not inside a tab
			 panel, so they survive the expedition→map panel swap that
			 fires when CurrentExpedition becomes null. -->
		<ExpeditionResultPopup />

		<!-- Manga-Impact damage number overlay (screen-space). Mounted only
		     during 3D battles so it's not paying re-render cost out of
		     combat. Sits inside .content-area so it's clipped to the
		     normal HUD area, above other panels. -->
		@if ( Is3DBattleActive() )
		{
			<DamageNumberOverlay />
			<ImpactRingOverlay />
			<StatusFXOverlay />
		}

		<!-- Tab-switch confirm dialog — fires when the player tries to
			 leave the expedition tab mid-run. Ends the expedition on
			 confirm so progress isn't silently lost on a stray click. -->
		@if ( _pendingTabSwitch != null )
		{
			<div class="tab-leave-confirm-root">
				<div class="tab-leave-backdrop" onclick=@CancelLeaveExpedition></div>
				<div class="tab-leave-modal">
					<div class="tlc-icon">
						<iconify icon="lucide:alert-triangle" Size=@(36) Color="#fca5a5" />
					</div>
					<div class="tlc-title">LEAVE EXPEDITION?</div>
					<div class="tlc-body">Your current run will end and any un-awarded rewards will be lost.</div>
					<div class="tlc-actions">
						<button class="tlc-btn danger" onclick=@ConfirmLeaveExpedition>
							<iconify icon="lucide:log-out" Size=@(14) Color="#ffffff" />
							<span>END &amp; LEAVE</span>
						</button>
						<button class="tlc-btn secondary" onclick=@CancelLeaveExpedition>
							<iconify icon="lucide:arrow-left" Size=@(14) Color="#cbd5e1" />
							<span>STAY</span>
						</button>
					</div>
				</div>
			</div>
		}
		@switch (currentTab)
		{
			case "monsters":
				<MonsterRosterPanel @ref="monsterRosterPanel" />
				break;

			case "skills":
				<SkillTreePanel @ref="skillTreePanel" />
				break;

			case "expedition":
				// When no run is active, the world map IS the expedition tab. Once
				// a run starts, the battle UI inside ExpeditionPanel takes over.
				@if ( ExpeditionManager.Instance?.CurrentExpedition == null
					&& BattleManager.Instance?.IsInBattle != true )
				{
					<WorldMapPanel @ref="worldMapPanel" />
				}
				else
				{
					<ExpeditionPanel @ref="expeditionPanel" />
				}
				break;

			case "online":
				<OnlineHubPanel @ref="onlineHubPanel" />
				break;

			case "beastiary":
				<BeastiaryPanel @ref="beastiaryPanel" />
				break;

			case "shop":
				<ShopPanelContent @ref="shopPanel" />
				break;
		}
	</div>

	<!-- ============================================================ -->
	<!-- COMMAND BAR — Unified Bottom Bar (2026-04-23, 4th rework)     -->
	<!-- A single floating card that carries the ENTIRE HUD chrome.    -->
	<!-- Three zones separated by thin purple rules:                   -->
	<!--   LEFT   — Steam avatar + LV chip + currency trio             -->
	<!--   CENTER — 7 destination tabs with icon + label               -->
	<!--   RIGHT  — Quests/Menu/Bag pills + 4 utility diamonds + help  -->
	<!-- Omitted in 3D battle mode — Razor @if (not opacity toggle).   -->
	<!-- ============================================================ -->
	@if (!Is3DBattleActive())
	{
	<div class="command-bar">
		<!-- ─── LEFT ISLAND ──────────────────────────────────────── -->
		<div class="cb-zone cb-zone-left cb-island">
			<div class="cb-avatar-wrap" onclick=@OnPlayerInfoClicked
			     onmouseover=@(() => { if (hoveredBar != "avatar") { hoveredBar = "avatar"; SoundManager.PlayHover(); } })
			     onmouseout=@(() => hoveredBar = null)>
				<div class="cb-avatar @GetGenderClass()">
					<span class="cb-avatar-fallback">@GetAvatarEmoji()</span>
					@if (GetSteamId() > 0)
					{
						<img class="cb-avatar-steam" src="@($"avatar:{GetSteamId()}")" />
					}
					else
					{
						<img class="cb-avatar-img" src="@GetAvatarImagePath()" />
					}
				</div>
				<div class="cb-avatar-meta">
					<span class="cb-tamer-name">@GetTamerName()</span>
					<span class="cb-lv-chip">LV @GetTamerLevel()</span>
				</div>
				<div class="cb-key cb-avatar-key"><span>0</span></div>
			</div>

			<div class="cb-currency-stack">
				<div class="cb-currency gold @GetCurrencyPulseClass("gold")"
				     onmouseover=@(() => { hoveredBar = "gold"; })
				     onmouseout=@(() => { if (hoveredBar == "gold") hoveredBar = null; })>
					<div class="cb-currency-diamond">
						<img class="cb-currency-icon" src="ui/icons/currency/money.svg" />
					</div>
					<span class="cb-currency-value">@FormatNumber(GetDisplayedGold())</span>
				</div>
				<div class="cb-currency ink @GetCurrencyPulseClass("ink")"
				     onmouseover=@(() => { hoveredBar = "ink"; })
				     onmouseout=@(() => { if (hoveredBar == "ink") hoveredBar = null; })>
					<div class="cb-currency-diamond">
						<img class="cb-currency-icon" src="ui/icons/currency/ink.svg" />
					</div>
					<span class="cb-currency-value">@FormatNumber(GetDisplayedInk())</span>
				</div>
				<div class="cb-currency tokens @GetCurrencyPulseClass("tokens")"
				     onmouseover=@(() => { hoveredBar = "tokens"; })
				     onmouseout=@(() => { if (hoveredBar == "tokens") hoveredBar = null; })>
					<div class="cb-currency-diamond">
						<img class="cb-currency-icon" src="ui/icons/currency/token.svg" />
					</div>
					<span class="cb-currency-value">@FormatNumber(GetDisplayedTokens())</span>
				</div>
			</div>
		</div>

		<div class="cb-divider"></div>

		<!-- ─── CENTER ISLAND: 6 destination tabs ───────────────── -->
		<div class="cb-zone cb-zone-center cb-island @(IsNavigatingTabs ? "focused" : "")">
			<!-- Beasts -->
			<div class="cb-tab cb-tab-beasts @(currentTab == "monsters" ? "active" : "") @(IsNavigatingTabs && selectedTabIndex == 0 ? "keyboard-selected" : "")"
			     onmouseover=@(() => { if (hoveredBar != "beasts") { hoveredBar = "beasts"; SoundManager.PlayHover(); } })
			     onmouseout=@(() => hoveredBar = null)
			     onclick=@(() => { SoundManager.PlayClick(); SwitchTabByIndex(0); IsNavigatingTabs = false; })>
				<div class="cb-tab-icon-wrap">
					<img class="cb-tab-icon-svg" src="ui/icons/beast.svg" />
					<img class="cb-tab-icon-anim" src="ui/icons/animated/beast.webp" />
				</div>
				<div class="cb-label-row">
					<div class="cb-key"><span>1</span></div>
					<span class="cb-tab-label">@L("ui.hud.beasts")</span>
				</div>
				<div class="cb-tab-underline"></div>
			</div>

			<!-- Skills -->
			<div class="cb-tab cb-tab-skills @(currentTab == "skills" ? "active" : "") @(IsNavigatingTabs && selectedTabIndex == 1 ? "keyboard-selected" : "")"
			     onmouseover=@(() => { if (hoveredBar != "skills") { hoveredBar = "skills"; SoundManager.PlayHover(); } })
			     onmouseout=@(() => hoveredBar = null)
			     onclick=@(() => { SoundManager.PlayClick(); SwitchTabByIndex(1); IsNavigatingTabs = false; })>
				<div class="cb-tab-icon-wrap">
					<img class="cb-tab-icon-svg" src="ui/icons/skills.svg" />
					<img class="cb-tab-icon-anim" src="ui/icons/animated/skills.webp" />
				</div>
				<div class="cb-label-row">
					<div class="cb-key"><span>2</span></div>
					<span class="cb-tab-label">@L("ui.hud.skills")</span>
				</div>
				<div class="cb-tab-underline"></div>
			</div>

			<!-- Expeditions -->
			<div class="cb-tab cb-tab-expedition @(currentTab == "expedition" ? "active" : "") @(IsNavigatingTabs && selectedTabIndex == 2 ? "keyboard-selected" : "")"
			     onmouseover=@(() => { if (hoveredBar != "expedition") { hoveredBar = "expedition"; SoundManager.PlayHover(); } })
			     onmouseout=@(() => hoveredBar = null)
			     onclick=@(() => { SoundManager.PlayClick(); SwitchTabByIndex(2); IsNavigatingTabs = false; })>
				<div class="cb-tab-icon-wrap">
					<img class="cb-tab-icon-svg" src="ui/icons/expedition.svg" />
					<img class="cb-tab-icon-anim" src="ui/icons/animated/expedition.webp" />
					@if (IsExpeditionRunning())
					{
						<span class="cb-tab-running-dot"></span>
					}
				</div>
				<div class="cb-label-row">
					<div class="cb-key"><span>3</span></div>
					<span class="cb-tab-label">@L("ui.hud.expedition")</span>
				</div>
				<div class="cb-tab-underline"></div>
			</div>

			<!-- Online -->
			<div class="cb-tab cb-tab-online @(currentTab == "online" ? "active" : "") @(IsNavigatingTabs && selectedTabIndex == 3 ? "keyboard-selected" : "")"
			     onmouseover=@(() => { if (hoveredBar != "online") { hoveredBar = "online"; SoundManager.PlayHover(); } })
			     onmouseout=@(() => hoveredBar = null)
			     onclick=@(() => { SoundManager.PlayClick(); SwitchTabByIndex(3); IsNavigatingTabs = false; })>
				<div class="cb-tab-icon-wrap">
					<img class="cb-tab-icon-svg" src="ui/icons/online.svg" />
					<img class="cb-tab-icon-anim" src="ui/icons/animated/online.webp" />
				</div>
				<div class="cb-label-row">
					<div class="cb-key"><span>4</span></div>
					<span class="cb-tab-label">@L("ui.hud.online")</span>
				</div>
				<div class="cb-tab-underline"></div>
			</div>

			<!-- Beastbook -->
			<div class="cb-tab cb-tab-beastiary @(currentTab == "beastiary" ? "active" : "") @(IsNavigatingTabs && selectedTabIndex == 4 ? "keyboard-selected" : "")"
			     onmouseover=@(() => { if (hoveredBar != "beastiary") { hoveredBar = "beastiary"; SoundManager.PlayHover(); } })
			     onmouseout=@(() => hoveredBar = null)
			     onclick=@(() => { SoundManager.PlayClick(); SwitchTabByIndex(4); IsNavigatingTabs = false; })>
				<div class="cb-tab-icon-wrap">
					<img class="cb-tab-icon-svg" src="ui/icons/beastiary.svg" />
					<img class="cb-tab-icon-anim" src="ui/icons/animated/beastiary.webp" />
				</div>
				<div class="cb-label-row">
					<div class="cb-key"><span>5</span></div>
					<span class="cb-tab-label">@L("ui.hud.beastiary")</span>
				</div>
				<div class="cb-tab-underline"></div>
			</div>

			<!-- Shop -->
			<div class="cb-tab cb-tab-shop @(currentTab == "shop" ? "active" : "") @(IsNavigatingTabs && selectedTabIndex == 5 ? "keyboard-selected" : "")"
			     onmouseover=@(() => { if (hoveredBar != "shop") { hoveredBar = "shop"; SoundManager.PlayHover(); } })
			     onmouseout=@(() => hoveredBar = null)
			     onclick=@(() => { SoundManager.PlayClick(); SwitchTabByIndex(5); IsNavigatingTabs = false; })>
				<div class="cb-tab-icon-wrap">
					<img class="cb-tab-icon-svg" src="ui/icons/shop.svg" />
					<img class="cb-tab-icon-anim" src="ui/icons/animated/shop.webp" />
				</div>
				<div class="cb-label-row">
					<div class="cb-key"><span>6</span></div>
					<span class="cb-tab-label">@L("ui.hud.shop")</span>
				</div>
				<div class="cb-tab-underline"></div>
			</div>
		</div>

		<div class="cb-divider"></div>

		<!-- ─── RIGHT ISLAND: actions + utilities ───────────────── -->
		<div class="cb-zone cb-zone-right cb-island">
			<!-- Quests / Menu / Bag — labeled primary actions -->
			<div class="cb-action-group">
				<button class="cb-action quests-action @(HasUnclaimedDailyRewards() ? "has-new" : "")" onclick=@OnQuestsClicked
				        onmouseover=@(() => { if (hoveredBar != "quests") { hoveredBar = "quests"; SoundManager.PlayHover(); } })
				        onmouseout=@(() => hoveredBar = null)>
					<img class="cb-action-icon" src="ui/icons/buttons/missions-star-static.png" />
					<img class="cb-action-icon-anim" src="ui/icons/animated/missions-star.webp" />
					<div class="cb-label-row">
						<div class="cb-key"><span>7</span></div>
						<span class="cb-action-label">QUESTS</span>
					</div>
					@if (HasUnclaimedDailyRewards())
					{
						<span class="cb-action-badge quests-badge">!</span>
					}
				</button>

				<button class="cb-action menu-action" onclick=@OnMenuClicked
				        onmouseover=@(() => { if (hoveredBar != "menu") { hoveredBar = "menu"; SoundManager.PlayHover(); } })
				        onmouseout=@(() => hoveredBar = null)>
					<img class="cb-action-icon" src="ui/icons/buttons/menu.svg" />
					<img class="cb-action-icon-anim" src="ui/icons/animated/menu.webp" />
					<div class="cb-label-row">
						<div class="cb-key"><span>8</span></div>
						<span class="cb-action-label">MENU</span>
					</div>
				</button>

				<button class="cb-action bag-action @(HasNewItems() ? "has-new" : "")" onclick=@OnInventoryClicked
				        onmouseover=@(() => { if (hoveredBar != "bag") { hoveredBar = "bag"; SoundManager.PlayHover(); } })
				        onmouseout=@(() => hoveredBar = null)>
					<img class="cb-action-icon" src="ui/icons/buttons/inventory.svg" />
					<img class="cb-action-icon-anim" src="ui/icons/animated/inventory.webp" />
					<div class="cb-label-row">
						<div class="cb-key"><span>9</span></div>
						<span class="cb-action-label">@L("ui.hud.inventory")</span>
					</div>
					@if (HasNewItems())
					{
						<span class="cb-action-badge bag-badge">@L("ui.hud.new")</span>
					}
				</button>
			</div>

			<div class="cb-divider cb-divider-thin"></div>

			<!-- Utility diamonds: Chat / Radio / Effects / Notifs -->
			<div class="cb-util-group">
				<div class="cb-util cb-util-chat" onclick=@OnChatClicked
				     onmouseover=@(() => { if (hoveredBar != "chat") { hoveredBar = "chat"; SoundManager.PlayHover(); } })
				     onmouseout=@(() => hoveredBar = null)>
					<div class="cb-util-shell">
						<div class="cb-util-iconify-wrap">
							<iconify icon="lucide:message-circle" Size=@(20) Color=@(hoveredBar == "chat" ? "#ffffff" : "#c4b5fd") />
						</div>
					</div>
					<div class="cb-key cb-util-key"><span>T</span></div>
					@if (GetChatUnreadCount() > 0)
					{
						<span class="cb-util-badge purple">@GetChatUnreadCount()</span>
					}
				</div>

				<div class="cb-util cb-util-radio" onclick=@OnRadioClicked
				     onmouseover=@(() => { if (hoveredBar != "radio") { hoveredBar = "radio"; SoundManager.PlayHover(); } })
				     onmouseout=@(() => hoveredBar = null)>
					<div class="cb-util-shell">
						<div class="cb-util-iconify-wrap">
							<iconify icon="lucide:radio" Size=@(20) Color=@(hoveredBar == "radio" ? "#ffffff" : "#c4b5fd") />
						</div>
					</div>
					<div class="cb-key cb-util-key"><span>R</span></div>
				</div>

				<div class="cb-util cb-util-effects" onclick=@OnEffectsClicked
				     onmouseover=@(() => { if (hoveredBar != "effects") { hoveredBar = "effects"; SoundManager.PlayHover(); } })
				     onmouseout=@(() => hoveredBar = null)>
					<div class="cb-util-shell">
						<div class="cb-util-iconify-wrap">
							<iconify icon="lucide:sparkles" Size=@(20) Color=@(hoveredBar == "effects" ? "#ffffff" : "#fde68a") />
						</div>
					</div>
					<div class="cb-key cb-util-key"><span>C</span></div>
					@if (GetEffectsCount() > 0)
					{
						<span class="cb-util-badge yellow">@GetEffectsCount()</span>
					}
				</div>

				<div class="cb-util cb-util-notifs" onclick=@OnNotificationsClicked
				     onmouseover=@(() => { if (hoveredBar != "notifs") { hoveredBar = "notifs"; SoundManager.PlayHover(); } })
				     onmouseout=@(() => hoveredBar = null)>
					<div class="cb-util-shell">
						<div class="cb-util-iconify-wrap">
							<iconify icon="lucide:bell" Size=@(20) Color=@(hoveredBar == "notifs" ? "#ffffff" : "#c4b5fd") />
						</div>
					</div>
					<div class="cb-key cb-util-key"><span>N</span></div>
					@if (GetNotificationCount() > 0)
					{
						<span class="cb-util-badge purple">@GetNotificationCount()</span>
					}
				</div>

			</div>

		</div>
	</div>
	}

	<!-- HUD overlays - render before popups so popups appear on top -->
	<ActiveEffectsPanel />
	<NotificationPanel />
	<ChatPanel />
	<VoiceChatPanel Mode="widget" />
	<RadioWidget />

	<!-- Popup/Modal panels - render after HUD overlays so they appear on top -->
	<BeastShowcasePopup />
	<TamerCardShowcasePopup />
	<ProfilePanel />
	<AchievementPanel />
	<DailyPanel />
	<QuestPanel />
	<TutorialPanel />
	<MenuPopup />
	<OptionsPanel />
	<InventoryPanel />
	<ConfirmDialog />
	<HelpPanel />
	<FeedbackPanel />
	<CreditsPanel />
	<TradingPanel />
</root>

@code {
	// Localization helper
	private string L( string key ) => LocalizationManager.Get( key );
	private string L( string key, params object[] args ) => LocalizationManager.Get( key, args );

	// Default landing is "monsters" (Beasts). 6 destinations after Home
	// was dropped: monsters, skills, expedition, online, beastiary, shop.
	private string currentTab = "monsters";
	private string hoveredCurrency = null;
	// Single hover field carries all command-bar hover state — tabs, actions,
	// utilities, currencies. Tooltips removed in favor of visible labels +
	// recognizable iconify glyphs (hover → flicker loop was unfixable with
	// above-element tooltip positioning).
	private string hoveredBar = null;

	// Panel references for input forwarding
	private MonsterRosterPanel monsterRosterPanel;
	private SkillTreePanel skillTreePanel;
	private ExpeditionPanel expeditionPanel;
	private WorldMapPanel worldMapPanel;
	private OnlineHubPanel onlineHubPanel;
	private BeastiaryPanel beastiaryPanel;
	private ShopPanelContent shopPanel;

	// Keyboard navigation state
	// When true, user is navigating tabs at top level (Left/Right to switch, Down to enter panel)
	// When false, the current panel handles input (panel calls ExitPanel() to return)
	// Starts false so panels work immediately - user presses Up to go to tab level
	public static bool IsNavigatingTabs { get; set; } = false;

	// Cross-handler "the active panel already used the back key this frame" flag.
	//
	// Why this exists: OnUpdate() calls TickCurrentPanel() (which runs the active
	// panel's keyboard handler) and THEN HandleKeyboardInput() (GameHUD's own).
	// `Input.Pressed("Menu")` is edge-triggered and reports true to BOTH in the
	// same frame — so a panel consuming Q for an INTERNAL back action (close a
	// sub-picker, detail->grid, etc.) could not stop GameHUD from ALSO seeing Q
	// and flipping IsNavigatingTabs = true (exit-panel-to-tabs), which froze the
	// panel. Now: a panel that uses Q internally sets PanelHandledBackKey = true;
	// GameHUD's Menu->exit-panel flip skips when the flag is set. Reset to false
	// at the TOP of OnUpdate() every frame, before the panel ticks.
	public static bool PanelHandledBackKey { get; set; } = false;
	// 7 tabs: home is position 0, then the original 6. Number keys 1–6
	// still map to the original tabs (indexes 1–6) and H maps to home (index 0).
	private static string[] tabs = { "monsters", "skills", "expedition", "online", "beastiary", "shop" };
	private int selectedTabIndex = 0;

	// ============================================
	// Currency roll-up animation state
	// ============================================
	// Displayed values lerp toward real values so the HUD counter "rolls" instead of snapping.
	// Initialized lazily on first read so a fresh GameHUD mount does NOT roll from 0.
	private float _displayedGold = -1f;
	private float _displayedInk = -1f;
	private float _displayedTokens = -1f;
	// Previous real values, used to detect value changes (up/down) for icon pulse.
	private int _prevGoldReal = -1;
	private int _prevInkReal = -1;
	private int _prevTokensReal = -1;
	// Pulse-remaining timers (seconds). > 0 while the icon pulse is playing.
	// Up pulse lasts ~0.3s, down pulse ~0.2s. Sign tracks direction (+ up, - down).
	private float _goldPulse = 0f;
	private float _inkPulse = 0f;
	private float _tokensPulse = 0f;
	private int _goldPulseDir = 0; // +1 up, -1 down, 0 none
	private int _inkPulseDir = 0;
	private int _tokensPulseDir = 0;
	// Roll-up duration (ease-out, ~400ms total). Larger delta = same duration, the lerp speed adapts.
	private const float CURRENCY_ROLL_DURATION = 0.4f;
	private const float PULSE_UP_DURATION = 0.3f;
	private const float PULSE_DOWN_DURATION = 0.2f;

	/// <summary>
	/// Formerly: panels called this on a W/Up press at their top row to jump
	/// focus up to the tab bar. Keyboard tab navigation was removed (tabs switch
	/// via the number keys 1-6 only), so this is now a no-op — kept so existing
	/// panel call sites still compile.
	/// </summary>
	public static void ExitPanel()
	{
	}

	/// <summary>
	/// Called when mouse clicks anywhere in a panel to exit tab navigation mode
	/// </summary>
	public static void EnterPanel()
	{
		IsNavigatingTabs = false;
	}

	// Only show when game is running (not in main menu)
	private bool IsVisible => GameManager.Instance?.IsInGame == true;

	private bool Is3DBattleActive() => BattleSceneController.Instance?.IsActive == true && BattleManager.Instance?.IsInBattle == true && currentTab == "expedition";

	protected override void OnStart()
	{
		// Subscribe to state changes
		if ( GameManager.Instance != null )
		{
			GameManager.Instance.OnStateChanged += OnGameStateChanged;
		}

		// Subscribe to tutorial step changes to switch tabs
		if ( TutorialManager.Instance != null )
		{
			TutorialManager.Instance.OnStepChanged += OnTutorialStepChanged;
		}

		// Reset static navigation state on start (in case it was stuck from previous session)
		IsNavigatingTabs = false;

		// Initialize the radio system
		RadioManager.Initialize();
	}

	private void OnRootClicked()
	{
		// Enter panel mode when user clicks inside the panel
		IsNavigatingTabs = false;
	}

	protected override void OnDestroy()
	{
		if ( GameManager.Instance != null )
		{
			GameManager.Instance.OnStateChanged -= OnGameStateChanged;
		}

		if ( TutorialManager.Instance != null )
		{
			TutorialManager.Instance.OnStepChanged -= OnTutorialStepChanged;
		}
	}

	/// <summary>
	/// Handle tutorial step changes - switch to the target tab if specified
	/// </summary>
	private void OnTutorialStepChanged( TutorialStep step )
	{
		if ( step == null ) return;
		if ( string.IsNullOrEmpty( step.TargetTab ) ) return;

		// Switch to the target tab for this tutorial step
		SwitchTab( step.TargetTab );
	}

	private void OnGameStateChanged( GameState oldState, GameState newState )
	{
		// Handle state-specific UI changes if needed
	}

	protected override void OnUpdate()
	{
		try
		{
			// Clear the cross-handler back-key flag at the very top of the
			// frame, BEFORE TickCurrentPanel() runs. A panel that consumes Q
			// for an internal back action this frame will set it true; the
			// Menu->exit-panel flip in HandleKeyboardInput() then yields to it.
			PanelHandledBackKey = false;

			// Update global sprite animations and force re-render for animation
			if ( SpriteAnimator.Update() )
			{
				StateHasChanged();
			}

			// Tick background expedition - since manager OnUpdate may not run in all scenarios,
			// we use GameHUD.OnUpdate as a reliable tick source for background battles
			TickBackgroundExpedition();

			if ( !IsVisible ) return;

			// Tick currency roll-up animation (rolls displayed values toward real values)
			TickCurrencyAnimation();

			// Tutorial auto-start intentionally disabled — the tutorial system is
			// being redesigned. A future rework will reintroduce the trigger.

			// Tick the current panel's input handling (child panels don't auto-tick in s&box Razor)
			TickCurrentPanel();

			HandleKeyboardInput();

			// Check radio hotkeys and tick for auto-advance
			RadioManager.CheckInput();
			RadioManager.Tick();

			// Update radio context based on game state
			UpdateRadioContext();
		}
		catch (Exception ex)
		{
			Log.Warning($"GameHUD.OnUpdate exception: {ex.Message}");
		}
	}

	/// <summary>
	/// Manually tick the current panel's input handling since child panels don't auto-tick
	/// </summary>
	private void TickCurrentPanel()
	{
		// Only tick panels when not navigating tabs (panels handle their own input)
		if (IsNavigatingTabs) return;

		try
		{
			switch (currentTab)
			{
				case "monsters":
					monsterRosterPanel?.TickInput();
					break;
				case "skills":
					skillTreePanel?.TickInput();
					break;
				case "expedition":
					// Exactly one of these is mounted at a time — the world map
					// when no run is active, the expedition panel during a run.
					expeditionPanel?.TickInput();
					worldMapPanel?.TickInput();
					break;
				case "online":
					onlineHubPanel?.TickInput();
					break;
				case "beastiary":
					beastiaryPanel?.TickInput();
					break;
				case "shop":
					shopPanel?.TickInput();
					break;
			}
		}
		catch (Exception ex)
		{
			Log.Warning($"TickCurrentPanel error in '{currentTab}': {ex.Message}");
		}
	}

	private float _bgDebugTimer = 0;

	// Delay between background waves so battles don't complete instantly
	private bool _bgWaveEndPending = false;
	private float _bgWaveEndTimer = 0f;
	private BattleResult _bgPendingResult = null;

	/// <summary>
	/// Tick background expedition battles. Called from OnUpdate which runs reliably.
	/// </summary>
	private void TickBackgroundExpedition()
	{
		try
		{
			// Only tick if we're in background mode with an active expedition
			if ( ExpeditionManager.Instance?.IsRunningInBackground != true ) return;
			if ( ExpeditionManager.Instance?.CurrentExpedition == null ) return;
			if ( BattleManager.Instance == null ) return;

			// Don't tick expedition battles while in online/arena mode - arena manages its own battles
			if ( GameManager.Instance?.CurrentState == GameState.InArena ) return;
			if ( currentTab == "online" ) return;

			// If waiting for wave-end delay, count down before processing next wave
			if ( _bgWaveEndPending )
			{
				_bgWaveEndTimer -= RealTime.Delta;
				if ( _bgWaveEndTimer <= 0 )
				{
					_bgWaveEndPending = false;
					var pendingResult = _bgPendingResult;
					_bgPendingResult = null;
					if ( pendingResult != null )
					{
						HandleBackgroundBattleEnd( pendingResult );
					}
				}
				return;
			}

			// Debug log every 2 seconds
			_bgDebugTimer += RealTime.Delta;
			if ( _bgDebugTimer >= 2f )
			{
				Log.Info( $"[GameHUD BG] IsInBattle={BattleManager.Instance.IsInBattle}, IsPlaying={BattleManager.Instance.IsPlaying}, Turn={BattleManager.Instance.CurrentTurnIndex}/{BattleManager.Instance.CurrentResult?.Turns?.Count ?? 0}, Wave={ExpeditionManager.Instance.CurrentWave}" );
				_bgDebugTimer = 0;
			}

			// If battle is in progress, tick it
			if ( BattleManager.Instance.IsInBattle )
			{
				var result = BattleManager.Instance.CurrentResult;

				// Check if battle is complete (all turns executed)
				if ( result != null && BattleManager.Instance.CurrentTurnIndex >= result.Turns.Count )
				{
					// Don't handle immediately — add a delay between waves
					Log.Info( $"[GameHUD] Battle complete! PlayerWon={result.PlayerWon}, Wave={ExpeditionManager.Instance.CurrentWave}, waiting before next wave..." );
					_bgWaveEndPending = true;
					_bgWaveEndTimer = 0.75f;
					_bgPendingResult = result;
					return;
				}

				// Start playback if not already playing
				if ( !BattleManager.Instance.IsPlaying )
				{
					Log.Info( $"[GameHUD] Starting playback for background battle, Wave={ExpeditionManager.Instance.CurrentWave}, Turn={BattleManager.Instance.CurrentTurnIndex}" );
					BattleManager.Instance.StartPlayback();
				}

				// Tick the battle
				BattleManager.Instance.ManualTick( RealTime.Delta );

				// Force UI update so popup shows progress
				StateHasChanged();
			}
		}
		catch (Exception ex)
		{
			Log.Warning($"TickBackgroundExpedition exception: {ex.Message}");
		}
	}

	/// <summary>
	/// Handle battle end directly from GameHUD since event subscription to ExpeditionManager isn't reliable
	/// </summary>
	private void HandleBackgroundBattleEnd( BattleResult result )
	{
		try
		{
			var em = ExpeditionManager.Instance;
			if ( em == null || em.CurrentExpedition == null ) return;

			bool playerWon = result?.PlayerWon ?? false;
			int currentWave = em.CurrentWave;
			int totalWaves = em.CurrentExpedition.Waves;

			Log.Info( $"[GameHUD] HandleBackgroundBattleEnd: PlayerWon={playerWon}, Wave={currentWave}/{totalWaves}" );

			// Accumulate rewards from battle result
			if ( result != null )
			{
				em.AddAccumulatedRewards( result.TotalGold, result.TotalXP );
			}

			// Capture enemy team before exiting battle (for auto-catch)
			var enemyTeam = BattleManager.Instance?.EnemyTeam?.ToList();

			// Handle auto-catch if enabled and we won
			if ( playerWon && em.AutoNegotiate && enemyTeam != null )
			{
				TryAutoCatch( enemyTeam );
			}

			// Exit the current battle
			BattleManager.Instance?.ExitBattle();

			if ( playerWon && currentWave < totalWaves )
			{
				// Continue to next wave
				Log.Info( $"[GameHUD] Starting next wave..." );
				em.StartNextWave();
			}
			else if ( playerWon && currentWave >= totalWaves )
			{
				// Expedition complete!
				Log.Info( $"[GameHUD] Expedition complete!" );
				em.OnWaveComplete( true );
			}
			else
			{
				// Failed
				Log.Info( $"[GameHUD] Expedition failed" );
				em.OnWaveComplete( false );
			}
		}
		catch (Exception ex)
		{
			Log.Warning($"HandleBackgroundBattleEnd exception: {ex.Message}");
		}
	}

	/// <summary>
	/// Attempt to auto-catch a monster from the defeated enemy team
	/// </summary>
	private void TryAutoCatch( List<Monster> enemyTeam )
	{
		try
		{
			var em = ExpeditionManager.Instance;
			if ( em == null || enemyTeam == null || enemyTeam.Count == 0 ) return;

			// Check if we have contract ink
			if ( (TamerManager.Instance?.CurrentTamer?.ContractInk ?? 0) <= 0 )
			{
				Log.Info( "[GameHUD] Auto-catch: No contract ink available" );
				return;
			}

			// Skip catching if strategy is set to skip (-1)
			if ( em.AutoNegotiateStrategy == -1 )
			{
				Log.Info( "[GameHUD] Auto-catch: Skipping catch (strategy set to Skip)" );
				return;
			}

			// Find a catchable enemy from the battle
			Monster targetMonster = null;
			var targetSpecies = em.AutoContractTargetSpecies;
			foreach ( var enemy in enemyTeam )
			{
				if ( enemy == null ) continue;
				var species = MonsterManager.Instance?.GetSpecies( enemy.SpeciesId );
				if ( species != null && species.IsCatchable )
				{
					// If targeting a specific species, only catch that one
					if ( !string.IsNullOrEmpty( targetSpecies ) && enemy.SpeciesId != targetSpecies )
						continue;
					targetMonster = enemy;
					break;
				}
			}

			if ( targetMonster == null )
			{
				Log.Info( "[GameHUD] Auto-catch: No catchable enemy found" );
				return;
			}

			var species2 = MonsterManager.Instance?.GetSpecies( targetMonster.SpeciesId );
			if ( species2 == null ) return;

			// Generate negotiation options
			var options = ContractGenerator.GenerateNegotiationOptions( species2, targetMonster );
			if ( options == null || options.Count == 0 ) return;

			// Select option based on AutoNegotiateStrategy (0=GEN, 1=FAIR, 2=STR, 3=GOLD)
			int strategyIndex = Math.Clamp( em.AutoNegotiateStrategy, 0, options.Count - 1 );
			var selectedOption = options[strategyIndex];
			var currentInk = TamerManager.Instance?.CurrentTamer?.ContractInk ?? 0;

			// Check if we can afford ink cost
			if ( currentInk < selectedOption.InkCost )
			{
				// Try to fall back to a cheaper option
				var affordableOption = options.Where( o => currentInk >= o.InkCost ).OrderByDescending( o => o.InkCost ).FirstOrDefault();
				if ( affordableOption == null )
				{
					Log.Info( $"[GameHUD] Auto-catch: Not enough ink! Have {currentInk}, need {selectedOption.InkCost}" );
					return;
				}
				Log.Info( $"[GameHUD] Auto-catch: Can't afford {selectedOption.Name} ({selectedOption.InkCost} ink), using {affordableOption.Name}" );
				selectedOption = affordableOption;
			}

			// Check if we can afford gold cost
			if ( selectedOption.GoldCost > 0 )
			{
				int currentGold = TamerManager.Instance?.CurrentTamer?.Gold ?? 0;
				if ( currentGold < selectedOption.GoldCost )
				{
					Log.Info( $"[GameHUD] Auto-catch: Can't afford gold cost ({selectedOption.GoldCost}), trying Fair Terms instead" );
					// Fall back to Fair Terms (no gold cost)
					selectedOption = options[1];
				}
			}

			// Spend contract ink based on option's cost
			if ( !TamerManager.Instance.SpendContractInk( selectedOption.InkCost ) )
			{
				Log.Info( $"[GameHUD] Auto-catch: Not enough ink! Need {selectedOption.InkCost}" );
				return;
			}

			// Attempt negotiation
			var (success, _) = ContractGenerator.AttemptNegotiation( selectedOption );

			if ( success )
			{
				// Create the caught monster
				var caughtMonster = MonsterManager.Instance?.CreateMonster(
					targetMonster.SpeciesId,
					isBred: false,
					targetMonster.Genetics
				);

				if ( caughtMonster != null )
				{
					caughtMonster.Level = targetMonster.Level;
					caughtMonster.Contract = selectedOption.Contract;
					MonsterManager.Instance?.RecalculateStats( caughtMonster );

					// Record catch (stats, leaderboard, beastiary, event)
					em.RecordMonsterCatch( caughtMonster );

					Log.Info( $"[GameHUD] Auto-catch SUCCESS: Caught {caughtMonster.Nickname} with {selectedOption.Name}!" );
				}
			}
			else
			{
				Log.Info( $"[GameHUD] Auto-catch FAILED: {selectedOption.Name} negotiation failed" );
			}
		}
		catch ( Exception ex )
		{
			Log.Warning( $"TryAutoCatch exception: {ex.Message}" );
		}
	}

	private void HandleKeyboardInput()
	{
		try
		{
		// Don't process keyboard input when chat is focused (user is typing)
		if (ChatPanel.IsChatFocused) return;

		// A 3D battle owns the keyboard — BattleView handles its own input.
		if (Is3DBattleActive()) return;

		// A blocking popup/modal is open — it owns the keyboard. The popup's
		// own Tick() drives nav/confirm/cancel; GameHUD must not also eat the
		// global edge-triggered presses underneath it.
		if (UIModalState.AnyModalOpen) return;

		// Tab switching with number keys (always available)
		// Number keys 1–6 switch to the 6 tabs (indexes 0–5 after Home removal).
		if (Input.Pressed("Slot1")) { SwitchTabByIndex(0); IsNavigatingTabs = false; }
		else if (Input.Pressed("Slot2")) { SwitchTabByIndex(1); IsNavigatingTabs = false; }
		else if (Input.Pressed("Slot3")) { SwitchTabByIndex(2); IsNavigatingTabs = false; }
		else if (Input.Pressed("Slot4")) { SwitchTabByIndex(3); IsNavigatingTabs = false; }
		else if (Input.Pressed("Slot5")) { SwitchTabByIndex(4); IsNavigatingTabs = false; }
		else if (Input.Pressed("Slot6")) { SwitchTabByIndex(5); IsNavigatingTabs = false; }

		// Tabs switch ONLY via the number keys above. Directional (WASD / arrow)
		// tab navigation was removed — those keys collided with movement and
		// with panel content navigation.

		// Command-bar non-tab buttons. Keys 7/8/9/0 open the right-side
		// action pills (Quests/Menu/Bag) + the left avatar (Profile). Those
		// panels are UIModalState modals — once open AnyModalOpen is true and
		// this handler stops running, so they re-close via the popup's own Q
		// pass. The open press is all we need to wire here.
		// T/R/C/N toggle the non-modal utility widgets (Chat/Radio/Effects/
		// Notifications) — true press-to-toggle since this handler keeps
		// running while they're open.
		else if (Input.Pressed("Slot7")) { OnQuestsClicked(); }
		else if (Input.Pressed("Slot8")) { OnMenuClicked(); }
		else if (Input.Pressed("Slot9")) { OnInventoryClicked(); }
		else if (Input.Pressed("Slot0")) { OnPlayerInfoClicked(); }
		else if (Input.Pressed("Chat")) { OnChatClicked(); }
		else if (Input.Pressed("Reload")) { OnRadioClicked(); }
		else if (Input.Pressed("View")) { OnEffectsClicked(); }
		else if (Input.Pressed("Notifications")) { OnNotificationsClicked(); }

		// Escape/Menu to go back to main menu (or exit panel first).
		//
		// If the active panel already used Q THIS frame for an internal back
		// action (closing a sub-picker, detail->grid, etc.) it sets
		// PanelHandledBackKey — in that case GameHUD must NOT also flip into
		// tab-nav, or the panel would freeze. Escape is exempt from that
		// suppression: panels never consume Escape, so Escape always escalates.
		bool backPressed = Input.Pressed("Menu") || Input.Pressed("Escape");
		bool menuConsumedByPanel = Input.Pressed("Menu") && PanelHandledBackKey;
		if (backPressed && !menuConsumedByPanel)
		{
			if (!IsNavigatingTabs)
			{
				// Exit panel first (go to tab navigation)
				IsNavigatingTabs = true;
				SoundManager.PlayBack();
			}
			else
			{
				// Already at tabs, go to main menu
				OnMenuClicked();
			}
		}
		}
		catch (Exception ex)
		{
			Log.Warning($"HandleKeyboardInput exception: {ex.Message}");
		}
	}

	private void SwitchTabByIndex(int index)
	{
		if (index >= 0 && index < tabs.Length)
		{
			selectedTabIndex = index;
			SwitchTab(tabs[index]);
		}
	}

	private void SwitchTab(string tab)
	{
		if (currentTab == tab) return;

		// Live-expedition guard: if the player is leaving the expedition tab
		// while a run is active (battle in progress OR expedition resolved
		// but not yet finalized via popup), confirm before proceeding. Avoids
		// silently ending their run on an accidental tab click.
		var hasLiveExpedition = ExpeditionManager.Instance?.CurrentExpedition != null
			|| BattleManager.Instance?.IsInBattle == true;
		if (currentTab == "expedition" && tab != "expedition" && hasLiveExpedition)
		{
			_pendingTabSwitch = tab;
			SoundManager.PlayPopup();
			return;
		}

		PerformTabSwitch(tab);
	}

	private void PerformTabSwitch(string tab)
	{
		Log.Info($"SwitchTab: from '{currentTab}' to '{tab}', IsInBattle={BattleManager.Instance?.IsInBattle}, IsRunningInBackground={ExpeditionManager.Instance?.IsRunningInBackground}");

		// Handle background expedition mode
		if (currentTab == "expedition" && ExpeditionManager.Instance?.CurrentExpedition != null)
		{
			// Only enable background mode if there's actually an active battle
			// and we're not already in background mode
			if (BattleManager.Instance?.IsInBattle == true && ExpeditionManager.Instance?.IsRunningInBackground != true)
			{
				Log.Info($"SwitchTab: Enabling background mode");
				ExpeditionManager.Instance.EnableBackgroundMode();
			}
		}
		else if (tab == "expedition" && ExpeditionManager.Instance?.IsRunningInBackground == true)
		{
			// Switching back to expedition - disable background mode
			ExpeditionManager.Instance.DisableBackgroundMode();
		}

		currentTab = tab;
		// Keep selectedTabIndex in sync so keyboard focus lands on the current tab
		for (int i = 0; i < tabs.Length; i++)
		{
			if (tabs[i] == tab) { selectedTabIndex = i; break; }
		}
		SoundManager.PlayTabSwitch();

		// Tutorial: notify when the World Map (expedition tab) is opened.
		if ( tab == "expedition" )
		{
			TutorialManager.Instance?.NotifyEvent( "worldmap.opened" );
		}
	}

	// Pending tab destination when the player tried to leave mid-expedition.
	// The confirm dialog commits or cancels the switch.
	private string _pendingTabSwitch;

	private void ConfirmLeaveExpedition()
	{
		var target = _pendingTabSwitch;
		_pendingTabSwitch = null;

		// End the current expedition. CancelExpedition handles battle teardown
		// and heals the roster so nothing gets stuck at 0 HP on the map.
		ExpeditionManager.Instance?.CancelExpedition();

		SoundManager.PlayBack();
		if (!string.IsNullOrEmpty(target))
		{
			PerformTabSwitch(target);
		}
	}

	private void CancelLeaveExpedition()
	{
		_pendingTabSwitch = null;
		SoundManager.PlayPopdown();
	}

	// Resource getters
	private int GetTamerLevel() => TamerManager.Instance?.CurrentTamer?.Level ?? 1;
	private float GetTamerXPProgress() => TamerManager.Instance?.CurrentTamer?.XPProgress ?? 0;
	private int GetTamerCurrentXP() => TamerManager.Instance?.CurrentTamer?.CurrentLevelXP ?? 0;
	private int GetTamerXPRequired() => TamerManager.Instance?.CurrentTamer?.XPForNextLevel ?? 100;
	private int GetGold() => TamerManager.Instance?.CurrentTamer?.Gold ?? 0;
	private int GetGems() => TamerManager.Instance?.CurrentTamer?.Gems ?? 0;
	private int GetContractInk() => TamerManager.Instance?.CurrentTamer?.ContractInk ?? 0;
	private int GetBossTokens() => TamerManager.Instance?.CurrentTamer?.BossTokens ?? 0;

	// ============================================
	// Currency roll-up helpers
	// ============================================
	// Displayed (lerped) integer value used by the razor template. When displayed is -1
	// (uninitialized), snap to the real value so a fresh mount does NOT roll from 0.
	private int GetDisplayedGold()
	{
		var real = GetGold();
		if ( _displayedGold < 0f ) _displayedGold = real;
		return (int)System.Math.Round( _displayedGold );
	}

	private int GetDisplayedInk()
	{
		var real = GetContractInk();
		if ( _displayedInk < 0f ) _displayedInk = real;
		return (int)System.Math.Round( _displayedInk );
	}

	private int GetDisplayedTokens()
	{
		var real = GetBossTokens();
		if ( _displayedTokens < 0f ) _displayedTokens = real;
		return (int)System.Math.Round( _displayedTokens );
	}

	/// <summary>
	/// Returns the CSS pulse class for a given currency key based on the active pulse timer.
	/// Empty string when no pulse is active.
	/// </summary>
	private string GetCurrencyPulseClass( string key )
	{
		switch ( key )
		{
			case "gold":
				if ( _goldPulse > 0f )
					return _goldPulseDir > 0 ? "pulse-up" : "pulse-down";
				break;
			case "ink":
				if ( _inkPulse > 0f )
					return _inkPulseDir > 0 ? "pulse-up" : "pulse-down";
				break;
			case "tokens":
				if ( _tokensPulse > 0f )
					return _tokensPulseDir > 0 ? "pulse-up" : "pulse-down";
				break;
		}
		return "";
	}

	/// <summary>
	/// Lerp each displayed currency toward its real value using an ease-out curve,
	/// and track value changes to trigger icon pulses. Called from OnUpdate when visible.
	/// </summary>
	private void TickCurrencyAnimation()
	{
		var dt = RealTime.Delta;
		if ( dt <= 0f ) return;

		var goldReal = GetGold();
		var inkReal = GetContractInk();
		var tokensReal = GetBossTokens();

		// First-frame initialization — snap displayed values to real values (no "roll from 0")
		if ( _displayedGold < 0f ) _displayedGold = goldReal;
		if ( _displayedInk < 0f ) _displayedInk = inkReal;
		if ( _displayedTokens < 0f ) _displayedTokens = tokensReal;
		if ( _prevGoldReal < 0 ) _prevGoldReal = goldReal;
		if ( _prevInkReal < 0 ) _prevInkReal = inkReal;
		if ( _prevTokensReal < 0 ) _prevTokensReal = tokensReal;

		// Detect real-value changes and trigger icon pulse.
		if ( goldReal != _prevGoldReal )
		{
			if ( goldReal > _prevGoldReal ) { _goldPulseDir = 1; _goldPulse = PULSE_UP_DURATION; }
			else { _goldPulseDir = -1; _goldPulse = PULSE_DOWN_DURATION; }
			_prevGoldReal = goldReal;
		}
		if ( inkReal != _prevInkReal )
		{
			if ( inkReal > _prevInkReal ) { _inkPulseDir = 1; _inkPulse = PULSE_UP_DURATION; }
			else { _inkPulseDir = -1; _inkPulse = PULSE_DOWN_DURATION; }
			_prevInkReal = inkReal;
		}
		if ( tokensReal != _prevTokensReal )
		{
			if ( tokensReal > _prevTokensReal ) { _tokensPulseDir = 1; _tokensPulse = PULSE_UP_DURATION; }
			else { _tokensPulseDir = -1; _tokensPulse = PULSE_DOWN_DURATION; }
			_prevTokensReal = tokensReal;
		}

		// Tick down pulse timers.
		if ( _goldPulse > 0f ) { _goldPulse -= dt; if ( _goldPulse <= 0f ) _goldPulseDir = 0; }
		if ( _inkPulse > 0f ) { _inkPulse -= dt; if ( _inkPulse <= 0f ) _inkPulseDir = 0; }
		if ( _tokensPulse > 0f ) { _tokensPulse -= dt; if ( _tokensPulse <= 0f ) _tokensPulseDir = 0; }

		// Ease-out lerp: fraction per frame = 1 - exp(-k*dt) where k is tuned so that over
		// CURRENCY_ROLL_DURATION the value closes ~95% of the gap (feels like "settling").
		// k = -ln(0.05) / duration ≈ 7.49 / duration
		var k = 7.49f / CURRENCY_ROLL_DURATION;
		var alpha = 1f - MathF.Exp( -k * dt );

		_displayedGold = LerpTowardInt( _displayedGold, goldReal, alpha );
		_displayedInk = LerpTowardInt( _displayedInk, inkReal, alpha );
		_displayedTokens = LerpTowardInt( _displayedTokens, tokensReal, alpha );
	}

	/// <summary>
	/// Lerps a float toward an integer target, snapping when close enough so we never
	/// get stuck on a fractional tail.
	/// </summary>
	private static float LerpTowardInt( float current, int target, float alpha )
	{
		var next = current + (target - current) * alpha;
		if ( MathF.Abs( target - next ) < 0.5f )
			return target;
		return next;
	}
	private string GetTamerName() => TamerManager.Instance?.CurrentTamer?.Name ?? "Tamer";
	private string GetTamerTitle()
	{
		var tamer = TamerManager.Instance?.CurrentTamer;
		if ( tamer == null ) return "Beast Tamer";
		// Check active title from cosmetics
		if ( !string.IsNullOrEmpty( tamer.ActiveTitleId ) )
		{
			var titleItem = ItemManager.Instance?.GetItem( tamer.ActiveTitleId );
			if ( titleItem != null ) return titleItem.Name;
		}
		// Fallback to level title
		if ( !string.IsNullOrEmpty( tamer.ActiveLevelTitle ) ) return tamer.ActiveLevelTitle;
		// Fallback to level-based
		var level = tamer.Level;
		if ( level >= 80 ) return "Legendary Tamer";
		if ( level >= 60 ) return "Master Tamer";
		if ( level >= 40 ) return "Expert Tamer";
		if ( level >= 20 ) return "Skilled Tamer";
		if ( level >= 10 ) return "Apprentice Tamer";
		return "Novice Tamer";
	}

	// Format large numbers - abbreviate when they get big
	private string FormatNumber(int value)
	{
		if ( value >= 1_000_000_000 )
			return $"{value / 1_000_000_000f:0.#}B";
		if ( value >= 1_000_000 )
			return $"{value / 1_000_000f:0.##}M";
		if ( value >= 100_000 )
			return $"{value / 1_000f:0.#}K";
		return value.ToString( "N0" );
	}

