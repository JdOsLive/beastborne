	/// <summary>
	/// Update the radio context based on current game state.
	/// Battle music only plays when actively viewing a battle on the expedition tab.
	/// Switching tabs always returns to chill music.
	/// </summary>
	private void UpdateRadioContext()
	{
		// Battle music only when on expedition tab AND actively in battle
		// Auto-battler doesn't affect this - if you're watching, it's battle music
		if ( currentTab == "expedition" && BattleManager.Instance?.IsInBattle == true )
		{
			RadioManager.SetContext( RadioContext.Battle );
			return;
		}

		// Post-battle result popup up: expedition isn't finalized yet, keep
		// expedition-context music playing so it doesn't cut to menu chill
		// the second the fight ends. Covers the "runs dead silent while
		// the victory screen is showing" issue.
		if ( currentTab == "expedition"
			&& (ExpeditionManager.Instance?.CurrentExpedition != null
				|| ExpeditionResultPopup.IsVisible) )
		{
			RadioManager.SetContext( RadioContext.Expedition );
			return;
		}

		// World map entry on the expedition tab — use expedition context so
		// picking a zone / browsing the map keeps the exploratory vibe
		// instead of menu chill.
		if ( currentTab == "expedition" )
		{
			RadioManager.SetContext( RadioContext.Expedition );
			return;
		}

		// Everything else: chill music (Menu context)
		// This includes: other tabs, arena lobby, main menu browsing
		RadioManager.SetContext( RadioContext.Menu );
	}

