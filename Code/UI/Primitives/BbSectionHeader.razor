@namespace Beastborne.UI.Primitives
@using Sandbox;
@using Sandbox.UI;
@using Beastborne.UI;
@inherits Panel

@*
    BbSectionHeader — the scene-identity header language, componentized
    (guiding-star §4: wide-tracked uppercase kicker + italic-900 display
    title + the under-title accent rule that flares wider on focus).

    Anatomy (top to bottom):
        KICKER        13px / 800 / UPPERCASE / ~0.16em tracked, accent-colored
        Title         italic-900 display (Exo2Italic), warm cream
        ── accent ──  solid rule in the view's accent color; width animates
                      idle → flare on the signature glide ease (0.27s)

    Params:
        Kicker           — optional eyebrow line ("WHAT WE'RE BUILDING")
        Title            — the display title ("Roadmap")
        Size             — title px: 24 (panel section) | 28 (large panel,
                           e.g. the phone launcher) | 34 (screen section,
                           default) | 52 (scene title)
        AccentColor      — the view's ONE accent (default gold #ffce3a).
                           One accent per view — don't rainbow headers.
        KickerColor      — optional override; defaults to AccentColor
        AccentWidthIdle  — accent rule resting width (default 56)
        AccentWidthFlare — accent rule flared width (default 112)
        Flare            — parent-gated: true widens the accent (hover /
                           focus / arrival) — the v3.1 under-title flare
        Class            — extra classes on the root

    Parents with pure-CSS hover can skip Flare and drive the width in
    their own SCSS instead:
        .my-card:hover BbSectionHeader .bb-sechead-accent { width: 112px; }

    Usage:
        <BbSectionHeader Kicker="YOUR ROSTER" Title="Beasts" Size=@(34)
                         AccentColor="#9b6cff" Flare=@(_focused) />
*@

<root class="bb-sechead size-@Size @Class">
    @if (!string.IsNullOrEmpty(Kicker))
    {
        <span class="bb-sechead-kicker" style="color: @KickerColorFinal;">@Kicker</span>
    }
    <span class="bb-sechead-title">@Title</span>
    <div class="bb-sechead-accent" style="background-color: @AccentColor; width: @(AccentWidth)px;"></div>
</root>

@code {
    [Property] public string Kicker { get; set; } = "";
    [Property] public string Title { get; set; } = "";
    [Property] public int Size { get; set; } = 34;      // 24 | 28 | 34 | 52
    [Property] public string AccentColor { get; set; } = BbTokens.Gold;
    [Property] public string KickerColor { get; set; } = "";
    [Property] public int AccentWidthIdle { get; set; } = 56;
    [Property] public int AccentWidthFlare { get; set; } = 112;
    [Property] public bool Flare { get; set; } = false;
    [Property] public string Class { get; set; } = "";

    private string KickerColorFinal => string.IsNullOrEmpty( KickerColor ) ? AccentColor : KickerColor;
    private int AccentWidth => Flare ? AccentWidthFlare : AccentWidthIdle;

    protected override int BuildHash()
    {
        return HashCode.Combine(
            HashCode.Combine( Kicker, Title, Size, AccentColor, KickerColor ),
            HashCode.Combine( AccentWidthIdle, AccentWidthFlare, Flare, Class ) );
    }
}
