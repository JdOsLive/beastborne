@namespace Beastborne.UI.Primitives
@using Sandbox;
@using Sandbox.UI;
@using Beastborne.UI;
@inherits Panel

@*
    BbStamp — the tilted status stamp (guiding-star §2: "badges rest at
    rotate(±3deg) and straighten to 0deg on hover — snaps to attention").

    A solid semantic-fill pill, 12px/800/UPPER, resting tilted. The root is
    an UNROTATED layout holder; the inner body carries the tilt + fill (2D
    rotate, so bg on the transform holder is safe).

    Params:
        Text  — stamp copy ("OUT NOW", "IN DEVELOPMENT", "HARD MODE")
        Tone  — semantic fill, fixed meanings (BbTokens accents):
                gold (default, dark ink) | violet | orange | red | green |
                blue | neutral (dark slab, dim text)
        Tilt  — resting lean: any negative → −3°, any positive → +3°,
                0 → flat. The language only uses ±3; don't invent angles.
        Dot   — true renders the pulsing 1.6s live-dot ("LIVE", "ONLINE")
        Class — extra classes; pass "straighten" to snap it upright
                (parent-gated — e.g. Class=@(_hovered ? "straighten" : ""))

    Pure-CSS parents can straighten on hover without any C# state:
        .my-poster:hover BbStamp .bb-stamp-body { transform: rotate(0deg); }

    Usage:
        <BbStamp Text="OUT NOW" Tone="gold" />
        <BbStamp Text="LIVE" Tone="orange" Dot=@true Tilt=@(3) />
*@

<root class="bb-stamp tone-@ToneClass @TiltClass @Class">
    <div class="bb-stamp-body">
        @if (Dot)
        {
            <div class="bb-stamp-dot"></div>
        }
        <span class="bb-stamp-text">@Text</span>
    </div>
</root>

@code {
    [Property] public string Text { get; set; } = "";
    [Property] public string Tone { get; set; } = "gold"; // gold | violet | orange | red | green | blue | neutral
    [Property] public int Tilt { get; set; } = -3;
    [Property] public bool Dot { get; set; } = false;
    [Property] public string Class { get; set; } = "";

    private string ToneClass => string.IsNullOrEmpty( Tone ) ? "gold" : Tone.ToLowerInvariant();
    private string TiltClass => Tilt < 0 ? "tilt-neg" : Tilt > 0 ? "tilt-pos" : "tilt-flat";

    protected override int BuildHash()
    {
        return HashCode.Combine( Text, Tone, Tilt, Dot, Class );
    }
}
