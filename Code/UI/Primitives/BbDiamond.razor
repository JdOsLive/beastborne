@namespace Beastborne.UI.Primitives
@using Sandbox;
@using Sandbox.UI;
@using Beastborne.UI;
@using Beastborne.Systems;
@inherits Panel

@*
    BbDiamond — the 45° gem, Beastborne's action shape (guiding-star §2).

    A rotate(45deg) tinted frame with a counter-rotated inner icon slot.
    2D rotation only — bg on a 2D-rotated element is safe (the "surface on
    a child" rule applies to 3D perspective/rotateY transforms).

    The root is an UNROTATED bounding box sized to the rotated frame's
    diagonal (~1.45×), so the diamond never overhangs siblings in flex rows.

    Usage:
        <BbDiamond Icon="lucide:swords" Size=@(36) Tint="#3f8fe0" />
        <BbDiamond Icon="lucide:trash-2" Size=@(28) Tint="#e0414a" OnClick=@ConfirmRelease />

    Params:
        Icon      — iconify name (default lucide:sparkles)
        Size      — frame SIDE in px, pre-rotation (default 36). Root bounding
                    box is Size × 1.45.
        Tint      — solid fill color (default BbTokens.Violet). Tint to
                    FUNCTION: Item blue, Fuse pink, Release red.
        DarkGlyph — true = dark ink glyph for light tints (legendary gold);
                    false (default) = white glyph.
        OnClick   — optional; when set the diamond becomes interactive
                    (pointer cursor, hover spring scale, press dip, hover sound).
        HoverSound / ClickSound — sound opt-outs (hover on, click OFF by
                    default: click handlers own their own sounds house-wide).
        Class     — extra classes appended to the root.

    Never use on nav / Play / passive chrome — the diamond MEANS action.
*@

<root class="bb-diamond @(OnClick != null ? "interactive" : "") @Class"
      style="width: @(BoundingPx)px; height: @(BoundingPx)px;"
      onclick=@HandleClick onmouseover=@HandleMouseOver onmouseout=@HandleMouseOut>
    <div class="bb-diamond-frame" style="width: @(Size)px; height: @(Size)px; background-color: @Tint; border-radius: @(CornerPx)px;">
        <div class="bb-diamond-glyph">
            <iconify icon="@Icon" Size=@GlyphPx Color=@GlyphColor />
        </div>
    </div>
</root>

@code {
    [Property] public string Icon { get; set; } = "lucide:sparkles";
    [Property] public int Size { get; set; } = 36;
    [Property] public string Tint { get; set; } = BbTokens.Violet;
    [Property] public bool DarkGlyph { get; set; } = false;
    [Property] public Action OnClick { get; set; }
    [Property] public bool HoverSound { get; set; } = true;
    [Property] public bool ClickSound { get; set; } = false;
    [Property] public string Class { get; set; } = "";

    private bool _hoverPlayed;

    private int BoundingPx => (Size * 145 + 99) / 100; // ceil(Size × 1.45) — rotated diagonal
    private int CornerPx => Size / 6 < 3 ? 3 : Size / 6;
    private int GlyphPx => (int)(Size * 0.58f) < 10 ? 10 : (int)(Size * 0.58f);
    private string GlyphColor => DarkGlyph ? BbTokens.GoldInk : "#ffffff";

    private void HandleClick()
    {
        if ( OnClick == null ) return;
        OnClick.Invoke();
        if ( ClickSound ) SoundManager.PlayClick();
    }

    private void HandleMouseOver()
    {
        if ( OnClick == null || _hoverPlayed ) return;
        _hoverPlayed = true;
        if ( HoverSound ) SoundManager.PlayHover();
    }

    private void HandleMouseOut()
    {
        _hoverPlayed = false;
    }

    protected override int BuildHash()
    {
        return HashCode.Combine( Icon, Size, Tint, DarkGlyph, Class, OnClick != null );
    }
}
