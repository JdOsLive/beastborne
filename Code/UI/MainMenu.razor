@using Sandbox;
@using Sandbox.UI;
@using Beastborne.Core;
@using Beastborne.Data;
@using Beastborne.Systems;
@using Beastborne.UI;
@using Beastborne.UI.Components;
@inherits PanelComponent

<root class="main-menu @(IsVisible || transitionPhase > 0 ? "" : "hidden") @(transitionPhase >= 2 ? "covering" : "")">
	<div class="menu-background"></div>
	<div @ref="videoBackgroundPanel" class="menu-video-background"></div>
	<div class="menu-nebula"></div>

	<div class="menu-vignette"></div>
	<div class="menu-content-wash"></div>
	<div class="menu-grain"></div>
	<div class="menu-light-beam"></div>

	<div class="menu-content @(contentVisible ? "visible" : "") @(showStarterSelection ? "fading" : "")">
		<!--
			Featured portrait slot — right side of the screen, Metaphor / Hades II
			style. Placeholder asset for now (Embrik starter artwork at large scale
			with a soft glow). Swap the `src` with a dedicated hero portrait when
			the artist delivers one. Rotates randomly per menu enter.
		-->
		<div class="menu-feature-portrait @(entranceStage >= 1 ? "entered" : "") aura-@GetFeatureElementClass()">
			<div class="feature-element-aura"></div>
			<img class="feature-art" src="@currentFeatureArt" />
			<div class="feature-vignette"></div>
		</div>

		<div class="menu-hero @(entranceStage >= 1 ? "entered" : "")">
			<div class="logo-halo"></div>
			<div class="logo-wrap">
				<img class="game-logo" src="ui/logo/bb_logo_stroke_mascot.png" />
			</div>
			<div class="splash-row @(entranceStage >= 2 ? "entered" : "")">
				<span class="splash-text">@currentSplashText</span>
				<div class="splash-rule"></div>
			</div>
		</div>

		<div class="menu-button-column @(entranceStage >= 3 ? "entered" : "")">
			<button class="menu-entry menu-entry-play @(selectedIndex == 0 ? "selected" : "") @(entranceStage >= 3 ? "entered" : "")"
					onclick=@OnPlayClicked
					onmouseover=@(() => OnButtonHover(0))>
				<span class="entry-arrow">▶</span>
				<span class="entry-text">@L("ui.menu.play")</span>
				<div class="entry-underline"></div>
			</button>

			<button class="menu-entry menu-entry-secondary @(selectedIndex == 1 ? "selected" : "") @(entranceStage >= 4 ? "entered" : "")"
					onclick=@OnRoadmapClicked
					onmouseover=@(() => OnButtonHover(1))>
				<span class="entry-arrow">▶</span>
				<span class="entry-text">@L("ui.menu.roadmap")</span>
				<div class="entry-underline"></div>
			</button>

			<button class="menu-entry menu-entry-secondary @(selectedIndex == 2 ? "selected" : "") @(entranceStage >= 5 ? "entered" : "")"
					onclick=@OnOptionsClicked
					onmouseover=@(() => OnButtonHover(2))>
				<span class="entry-arrow">▶</span>
				<span class="entry-text">@L("ui.menu.options")</span>
				<div class="entry-underline"></div>
			</button>

			<button class="menu-entry menu-entry-secondary @(selectedIndex == 3 ? "selected" : "") @(entranceStage >= 5 ? "entered" : "")"
					onclick=@OnPatchNotesClicked
					onmouseover=@(() => OnButtonHover(3))>
				<span class="entry-arrow">▶</span>
				<span class="entry-text">PATCH NOTES</span>
				@if ( !_patchNotesSeen )
				{
					<span class="entry-new-dot"></span>
				}
				<div class="entry-underline"></div>
			</button>

			<div class="menu-utility-stack @(entranceStage >= 6 ? "entered" : "")">
				<button class="menu-entry menu-entry-utility @(selectedIndex == 4 ? "selected" : "")"
						onclick=@ToggleMainMenuLanguage
						onmouseover=@(() => OnButtonHover(4))>
					<span class="entry-arrow">▶</span>
					<span class="entry-text">@GetLanguageLabel()</span>
					<div class="entry-underline"></div>
				</button>

				<button class="menu-entry menu-entry-utility menu-entry-quit @(selectedIndex == 5 ? "selected" : "")"
						onclick=@OnQuitClicked
						onmouseover=@(() => OnButtonHover(5))>
					<span class="entry-arrow">▶</span>
					<span class="entry-text">@GetQuitLabel()</span>
					<div class="entry-underline"></div>
				</button>
			</div>
		</div>

		<!-- NEWS TICKER — editorial one-liner, top-left. No pill, no chrome. -->
		<div class="news-ticker @(entranceStage >= 2 ? "entered" : "")">
			<span class="ticker-live-label">LIVE</span>
			<span class="ticker-sep">·</span>
			<div class="ticker-content">
				<div class="ticker-item @(tickerVisible ? "visible" : "")">
					<span class="ticker-text">@currentTickerText</span>
				</div>
			</div>
		</div>

		<!--
			Developer credit — fills the dead zone between the menu entry
			column and the bottom Discord row. KH3-style "DEVELOPED BY
			SQUARE ENIX" composition beat. Mark + wordmark lockup per
			the Public Square brand kit.
		-->
		<div class="dev-credit @(entranceStage >= 7 ? "entered" : "")">
			<span class="dev-credit-label">DEVELOPED BY</span>
			<div class="dev-credit-rule"></div>
			<div class="dev-credit-studio">
				<img class="dev-credit-mark" src="ui/logo/ps_mark_white_64.png" />
				<span class="dev-credit-name">PUBLIC SQUARE</span>
			</div>
		</div>

		<div class="menu-bottom-left @(entranceStage >= 7 ? "entered" : "")">
			<div class="discord-link" onclick="@OnDiscordClick">
				<img class="discord-icon" src="/ui/buttons/pixel--discord-white.png" />
				<div class="discord-text-col">
					<span class="discord-text">@discordDisplayText</span>
					<span class="discord-hint">CLICK TO COPY LINK</span>
				</div>
			</div>
		</div>

		@if ( !string.IsNullOrEmpty( currentEventText ) )
		{
			<div class="menu-bottom-center @(entranceStage >= 7 ? "entered" : "")">
				<div class="event-toast">
					@* The event icon can be an iconify key ("lucide:coins") or a
					   short plain symbol ("x2"). Render iconify keys as an actual
					   icon — a ":" is the iconify-set separator. *@
					@if ( currentEventIcon.Contains( ":" ) )
					{
						<iconify class="toast-icon" icon="@currentEventIcon" Size=@(15) Color="#fbbf24" />
					}
					else if ( !string.IsNullOrEmpty( currentEventIcon ) )
					{
						<span class="toast-icon-text">@currentEventIcon</span>
					}
					<span class="toast-title">@currentEventText</span>
					<span class="toast-sep">·</span>
					<span class="toast-timer-label">ENDS IN</span>
					<span class="toast-timer-value">@currentEventTimer</span>
				</div>
			</div>
		}

		<div class="menu-bottom-right @(entranceStage >= 7 ? "entered" : "")">
			<div class="update-badge" onmouseover=@(() => { hoveringUpdate = true; })
				 onmouseout=@(() => { hoveringUpdate = false; })>
				<span class="update-diamond">◆</span>
				<span class="update-label">NEW</span>
				@if (hoveringUpdate)
				{
					<div class="update-tooltip">
						<span class="update-tooltip-title">MISSIONS &amp; HUD UPDATE</span>
						<span class="update-tooltip-body">Daily missions, streak rewards, revamped battle HUD, fusion overhaul preview.</span>
					</div>
				}
			</div>
			<span class="bottom-right-sep">·</span>
			<span class="version-text">v1.2.1 — OPEN BETA</span>
		</div>
	</div>

	@if (showStarterSelection)
	{
		<div class="starter-overlay starter-inline">
			<div class="starter-inline-header">
				<div class="starter-title">Choose Your First Bond</div>
				<div class="panel-header-line"></div>
				<div class="starter-subtitle">Your first partner — chosen here, with you always</div>
			</div>

			<div class="starter-ring-stage @(selectedStarter >= 0 ? "has-selection" : "")">
				<div class="ring-silhouette silhouette-fire">
					<img src="ui/starters/embrik_artwork_whiteoutline.png" />
				</div>
				<div class="ring-silhouette silhouette-water">
					<img src="ui/starters/pagefin_artwork_whiteoutline.png" />
				</div>
				<div class="ring-silhouette silhouette-wind">
					<img src="ui/starters/cherune_artwork_whiteoutline.png" />
				</div>

				<div class="ring-center">
					@if (selectedStarter < 0)
					{
						<span class="ring-center-prompt">Pick a companion</span>
					}
					else
					{
						<span class="ring-center-name">@GetStarterName(selectedStarter)</span>
						<span class="ring-center-sub">pending bond</span>
					}
				</div>

				<div class="ring-slot slot-wind @(starterStage >= 1 ? "entered" : "") @(selectedStarter == 2 ? "selected" : "") @(selectedStarter >= 0 && selectedStarter != 2 ? "dimmed" : "")"
					 onclick=@(() => SelectStarter(2))
					 onmouseover=@(() => OnStarterHover(2))>
					<div class="ring-glow"></div>
					<img class="ring-art" src="ui/starters/cherune_artwork.png" />
					@if (selectedStarter == 2 || hoveredStarter == 2)
					{
						<div class="ring-tooltip tooltip-right">
							<div class="tt-header">
								<span class="tt-name">Cherune</span>
								<span class="tt-element element-wind">WIND</span>
							</div>
							<span class="tt-desc">A novice cherub drifting on borrowed halos. Swift and protective — strikes first, shields allies, and watches over the smallest life in the fight.</span>
						</div>
					}
				</div>

				<div class="ring-slot slot-fire @(starterStage >= 2 ? "entered" : "") @(selectedStarter == 0 ? "selected" : "") @(selectedStarter >= 0 && selectedStarter != 0 ? "dimmed" : "")"
					 onclick=@(() => SelectStarter(0))
					 onmouseover=@(() => OnStarterHover(0))>
					<div class="ring-glow"></div>
					<img class="ring-art" src="ui/starters/embrik_artwork.png" />
					@if (selectedStarter == 0 || hoveredStarter == 0)
					{
						<div class="ring-tooltip tooltip-down-right">
							<div class="tt-header">
								<span class="tt-name">Embrik</span>
								<span class="tt-element element-fire">FIRE</span>
							</div>
							<span class="tt-desc">Born from dying campfires. Balanced offense with a warm, steadfast temperament — the kind of companion that warms the long nights between expeditions.</span>
						</div>
					}
				</div>

				<div class="ring-slot slot-water @(starterStage >= 3 ? "entered" : "") @(selectedStarter == 1 ? "selected" : "") @(selectedStarter >= 0 && selectedStarter != 1 ? "dimmed" : "")"
					 onclick=@(() => SelectStarter(1))
					 onmouseover=@(() => OnStarterHover(1))>
					<div class="ring-glow"></div>
					<img class="ring-art" src="ui/starters/pagefin_artwork.png" />
					@if (selectedStarter == 1 || hoveredStarter == 1)
					{
						<div class="ring-tooltip tooltip-down-left">
							<div class="tt-header">
								<span class="tt-name">Pagefin</span>
								<span class="tt-element element-water">WATER</span>
							</div>
							<span class="tt-desc">Formed from a traveler's tears. Resilient and patient — soaks up punishment, then turns the tide when the moment calls for it.</span>
						</div>
					}
				</div>
			</div>

			<div class="starter-inline-buttons">
				<button class="slot-confirm-btn @(selectedStarter < 0 ? "disabled" : "")" onclick=@OnConfirmStarter>
					<span class="slot-confirm-text">@(selectedStarter < 0 ? "CHOOSE A BOND" : "CONFIRM BOND")</span>
				</button>
				<button class="back-btn" onclick=@BackToTitleScreen>
					<span class="back-btn-text">@L("ui.menu.back")</span>
				</button>
			</div>
		</div>
	}

	@if (transitionPhase > 0)
	{
		<div class="menu-transition">
			<div class="tx-slab tx-slab-gold"></div>
			<div class="tx-slab tx-slab-purple"></div>
			<div class="tx-logo-wrap"><img class="tx-logo" src="ui/logo/bb_logo_stroke.png" /></div>
		</div>
	}

	@* OptionsPanel is also mounted under GameHUD. Mounting a second instance
	   here lets main-menu OPTIONS open the same modal UI without needing to
	   un-hide GameHUD. OptionsPanel maintains a list of instances and routes
	   Show() to whichever one sits under a non-hidden ancestor — see
	   PickActiveInstance() in OptionsPanel.razor. *@
	<OptionsPanel />

	@* Gift inbox — auto-opens once per session when GiftManager finds pending
	   dev-granted rewards. Same instance-picker pattern as OptionsPanel so a
	   second mount under GameHUD (if ever added) would route cleanly. *@
	<GiftInboxPopup />

	@if (showPatchNotes)
	{
		<div class="starter-overlay" onclick=@ClosePatchNotes>
			<div class="patchnotes-panel" onclick:stopPropagation>
				<div class="patchnotes-corner-tag"><span>What's New</span></div>
				<!-- Header strip — peeking beast on the left, version + headline on the right -->
				<div class="patchnotes-header">
					<div class="patchnotes-header-art">
						<img src="@currentFeatureArt" />
					</div>
					<div class="patchnotes-header-info">
						<div class="patchnotes-eyebrow">
							<iconify icon="lucide:sparkles" Size=@(13) Color="#fbbf24" />
							<span class="patchnotes-eyebrow-text">PATCH NOTES</span>
						</div>
						<div class="patchnotes-version-row">
							<span class="patchnotes-version-pill">v1.2.0</span>
							<span class="patchnotes-version-date">May 9, 2026</span>
						</div>
						<div class="patchnotes-headline">Whispering Hollow</div>
						<div class="patchnotes-tagline">A hidden mini-expedition opens above Weavermere. Seven new beasts join the Beastbook. Polish and balance across every panel.</div>
					</div>
					<button class="patchnotes-close" onclick=@ClosePatchNotes>
						<iconify icon="lucide:x" Size=@(16) Color="rgba(255, 255, 255, 0.7)" />
					</button>
				</div>

				<!-- Scrollable body — entries grouped by category with iconify icons -->
				<div class="patchnotes-body" @ref="patchNotesBody">
					<div class="patchnotes-section tone-features">
						<div class="patchnotes-section-head">
							<iconify icon="lucide:sparkles" Size=@(14) Color="#ffffff" />
							<span class="patchnotes-section-title">Features</span>
						</div>
						<div class="patchnotes-list">
							<div class="patchnotes-row">
								<span class="patchnotes-bullet">•</span>
								<span class="patchnotes-text"><span class="patchnotes-text-strong">Battle UI Reborn.</span> The whole battle screen redrawn in a stamp-and-slab dialect. Action bar is now a diamond cluster — FIGHT anchored full-size with a strobe-jitter flame, SWITCH / BAG / CONTRACT / END zig-zagging beside it.</span>
							</div>
							<div class="patchnotes-row">
								<span class="patchnotes-bullet">•</span>
								<span class="patchnotes-text"><span class="patchnotes-text-strong">Move Picker.</span> Clicking FIGHT blooms 4 element-tinted move diamonds in a chevron. Hover any move for a slide-in info card with PP, power, and description. FIGHT itself becomes BACK.</span>
							</div>
							<div class="patchnotes-row">
								<span class="patchnotes-bullet">•</span>
								<span class="patchnotes-text"><span class="patchnotes-text-strong">Target / Contract / Switch Pickers.</span> Target picker shows 3 element-tinted enemy diamonds numbered #1 / #2 / #3 — same numbering as the HP cards. Switch is a 4-diamond carousel (BACK · ◀ PREV · ▶ NEXT · ✓ SWAP) with the active beast in a side card.</span>
							</div>
							<div class="patchnotes-row">
								<span class="patchnotes-bullet">•</span>
								<span class="patchnotes-text"><span class="patchnotes-text-strong">Sheepot &amp; Cerametz.</span> New beast line — pale roots tangle under Sheepot's fleece so it wears a clay pot like armor. Spawns wild in Weaverton, evolves into Cerametz at Lv 25. Art by new artist Jet — welcome to the team!</span>
							</div>
							<div class="patchnotes-row">
								<span class="patchnotes-bullet">•</span>
								<span class="patchnotes-text"><span class="patchnotes-text-strong">Live Events.</span> +50% XP for everyone all launch week. Live announcements ticker now drives in-game XP/gold boosts — server-pushed events light up across battles and expeditions automatically (no client patch required).</span>
							</div>
							<div class="patchnotes-row">
								<span class="patchnotes-bullet">•</span>
								<span class="patchnotes-text"><span class="patchnotes-text-strong">Battle Comms.</span> Chat &amp; Radio docked at the bottom-left of battle — read the latest message and skip tracks without leaving combat. Click either dock body to open the full panel.</span>
							</div>
						</div>
					</div>

					<div class="patchnotes-section tone-balance">
						<div class="patchnotes-section-head">
							<iconify icon="lucide:scale" Size=@(14) Color="#ffffff" />
							<span class="patchnotes-section-title">Balance</span>
						</div>
						<div class="patchnotes-list">
							<div class="patchnotes-row">
								<span class="patchnotes-bullet">•</span>
								<span class="patchnotes-text"><span class="patchnotes-text-strong">Linear stat growth all the way to 100.</span> Stats no longer slow to a crawl past Lv 30 — high-level beasts actually feel high-level. Damage formula retuned to match.</span>
							</div>
							<div class="patchnotes-row">
								<span class="patchnotes-bullet">•</span>
								<span class="patchnotes-text"><span class="patchnotes-text-strong">Defense rebased.</span> Same-level fights now resolve in 3–5 turns at every level band, not 7–10 against tank archetypes.</span>
							</div>
							<div class="patchnotes-row">
								<span class="patchnotes-bullet">•</span>
								<span class="patchnotes-text"><span class="patchnotes-text-strong">Boss tier multipliers retuned.</span> HP scaled up across all tiers (Normal 1.4×→1.9×, Elite 1.7×→2.4×, Legendary 2.0×→2.9×, Mythic 2.4×→3.5×); ATK/DEF trimmed so they don't one-shot the player team.</span>
							</div>
							<div class="patchnotes-row">
								<span class="patchnotes-bullet">•</span>
								<span class="patchnotes-text"><span class="patchnotes-text-strong">Wave scaling +1 instead of +2.</span> Expeditions feel like a steady climb instead of hitting a wall on wave 4.</span>
							</div>
							<div class="patchnotes-row">
								<span class="patchnotes-bullet">•</span>
								<span class="patchnotes-text"><span class="patchnotes-text-strong">Status ticks rebalanced.</span> Poison 1/8 → 1/12 max HP per turn, Burn 1/16 → 1/20. Status pressure still matters without single-handedly winning fights.</span>
							</div>
						</div>
					</div>

					<div class="patchnotes-section tone-fixes">
						<div class="patchnotes-section-head">
							<iconify icon="lucide:wrench" Size=@(14) Color="#ffffff" />
							<span class="patchnotes-section-title">Fixes</span>
						</div>
						<div class="patchnotes-list">
							<div class="patchnotes-row">
								<span class="patchnotes-bullet">•</span>
								<span class="patchnotes-text"><span class="patchnotes-text-strong">Cloud save protection.</span> Cloud saves can no longer get silently overwritten by an empty save after a network blip on a fresh machine. Sync pauses for the session (with a warning toast) instead of pushing an empty blob over your real save.</span>
							</div>
							<div class="patchnotes-row">
								<span class="patchnotes-bullet">•</span>
								<span class="patchnotes-text"><span class="patchnotes-text-strong">Expedition unlock chain.</span> Clearing the first expedition now actually unlocks the second — the cleared-counter was off by one because the tutorial zone was being miscounted.</span>
							</div>
							<div class="patchnotes-row">
								<span class="patchnotes-bullet">•</span>
								<span class="patchnotes-text"><span class="patchnotes-text-strong">Skill points no longer drained between sessions.</span> The save-migration that runs on load is now non-destructive. If you've been losing SP to this bug, your next login will set you right.</span>
							</div>
							<div class="patchnotes-row">
								<span class="patchnotes-bullet">•</span>
								<span class="patchnotes-text">Tutorial highlight no longer floats above the wrong spot — the arrow waits for the target button to settle into its real position before locking on.</span>
							</div>
							<div class="patchnotes-row">
								<span class="patchnotes-bullet">•</span>
								<span class="patchnotes-text">Beastbook grid stops squashing non-square art — Aurael especially shows much more wing/halo/blade detail.</span>
							</div>
							<div class="patchnotes-row">
								<span class="patchnotes-bullet">•</span>
								<span class="patchnotes-text">Chat join notices show the player's name instead of "System joined the server."</span>
							</div>
						</div>
					</div>

					<div class="patchnotes-section tone-polish">
						<div class="patchnotes-section-head">
							<iconify icon="lucide:gem" Size=@(14) Color="#ffffff" />
							<span class="patchnotes-section-title">Polish</span>
						</div>
						<div class="patchnotes-list">
							<div class="patchnotes-row">
								<span class="patchnotes-bullet">•</span>
								<span class="patchnotes-text"><span class="patchnotes-text-strong">Stamp-and-slab dialect everywhere.</span> Expedition · Beastbook · Arena · Quest · Trading · Breeding · Daily · Card Collection · Contract Negotiation panels all redrawn — slab tab pills, italic-display headers, hard-offset shadow buttons. The whole game speaks one voice now.</span>
							</div>
							<div class="patchnotes-row">
								<span class="patchnotes-bullet">•</span>
								<span class="patchnotes-text"><span class="patchnotes-text-strong">Cinematic battle moments.</span> Slanted CRITICAL stamp on every crit. Boss splash card on wave entry. "WAVE CLEAR!" banner on wave end. Slab stamps for poison / burn / paralyze / sleep / freeze / confuse.</span>
							</div>
							<div class="patchnotes-row">
								<span class="patchnotes-bullet">•</span>
								<span class="patchnotes-text"><span class="patchnotes-text-strong">Punchier feel.</span> Move names slam in from the right, HP bars shake on hit, swap-outs get a slanted yellow-edged banner moment, HP bars wait for the attack visual to land before draining.</span>
							</div>
							<div class="patchnotes-row">
								<span class="patchnotes-bullet">•</span>
								<span class="patchnotes-text">HP cards now color-match each beast's element with a #1 / #2 / #3 slot tag matching the target picker.</span>
							</div>
							<div class="patchnotes-row">
								<span class="patchnotes-bullet">•</span>
								<span class="patchnotes-text">Battle nameplates rebuilt — flat saturated element diamonds (both shown for dual-typed beasts), yellow LV slab pills, crisp HP bar borders.</span>
							</div>
							<div class="patchnotes-row">
								<span class="patchnotes-bullet">•</span>
								<span class="patchnotes-text">WAVE badge now shows progress through the expedition (e.g. WAVE 3/5) instead of just the current wave number.</span>
							</div>
						</div>
					</div>
				</div>

				<!-- Footer CTA — matches roadmap pattern -->
				<div class="patchnotes-footer">
					<iconify icon="lucide:message-circle" Size=@(14) Color="#8b5cf6" />
					<span class="patchnotes-footer-text">Spotted something off? Tell us on Discord.</span>
					<button class="patchnotes-footer-link" onclick=@OnDiscordClick>
						<span class="patchnotes-footer-link-text">discord.gg/dJTTyCqKru</span>
					</button>
				</div>
			</div>
		</div>
	}

	@* Open-beta disclaimer — shown once per game launch on the title screen.
	   Static field so the popup persists across MainMenu re-mounts within a
	   session but resets every fresh launch. Players who hit "GOT IT" won't
	   see it again until they restart the game, which is the right cadence
	   for an open-beta reminder. *@
	@if (IsVisible && !_betaDisclaimerSeen)
	{
		<div class="starter-overlay beta-disclaimer-overlay">
			<div class="beta-disclaimer-panel" onclick:stopPropagation>
				<div class="beta-disclaimer-tag"><span>Alert · Beta</span></div>
				<div class="beta-disclaimer-header">
