@using Sandbox;
@using Sandbox.UI;
@using Beastborne.Core;
@using Beastborne.Data;
@using Beastborne.Systems;
@using Beastborne.UI;
@using Beastborne.UI.Components;
@using Beastborne.UI.Panels;
@inherits PanelComponent

<root class="main-menu @(keyboardMode ? "kbd-nav" : "mouse-nav") @(IsVisible || transitionPhase > 0 ? "" : "hidden") @(transitionPhase >= 2 ? "covering" : "")" onmousemove=@OnMenuMouseMove>
	@* Living selection cursor — one ring that glides + liquid-stretches between
	   focusable items (mouse hover + keyboard both drive selectedIndex). Positioned
	   in code from each item's Box.Rect; CSS transitions do the motion. *@
	<div @ref="_cursorRef" class="lh-cursor @(_cursorVisible ? "visible" : "") @(_cursorWarmup >= 2 ? "" : "snap") @(_cursorFiring ? "firing" : "")" style="left: @(_cursorL)px; top: @(_cursorT)px; width: @(_cursorW)px; height: @(_cursorH)px; border-radius: @(_cursorR)px; transform-origin: @(_cursorOrigin);"></div>
	<div @ref="videoBackgroundPanel" class="menu-video-background"></div>
	<div class="menu-nebula"></div>

	<div class="menu-vignette"></div>
	<div class="menu-content-wash"></div>
	<div class="menu-grain"></div>

	@* The hide rides INLINE so every rebuild renders already-hidden (re-renders
	   rebuild this panel and wipe imperative styles — the strobing-menu bug;
	   inline style is part of the render output, atomic with the rebuild).
	   OPACITY + OFFSCREEN ONLY — no display:none: flipping display dropped the
	   whole menu layout and re-laying it out on return was its own hitch; parked
	   offscreen the layout stays warm and both hide paths are still honored. *@
	<div @ref="_refMenuContent" class="menu-content @(contentVisible ? "visible" : "") @(showStarterSelection ? "fading" : "") @(_scene == SceneId.Menu ? "" : "scene-off") @(_menuReturning ? "returning" : "")" style="@(_scene == SceneId.Menu ? "" : "opacity: 0; left: -10000px;")">
		<!-- ============================================================
			 CONCEPT C — LAUNCHER HUB
			 Fixed left sidebar (460px) + main content area. Recreated from
			 the design handoff (design_handoff_main_menu/menu/concept-c.html),
			 translated to s&box-safe CSS. All new classes prefixed `lh-`.
			 The old menu-screen markup (feature portrait, hero/logo column,
			 button column, news ticker, dev credit, bottom HUD) was replaced
			 wholesale — its SCSS is left in place for the human to clean up.
			 ============================================================ -->

		<!-- ===== LEFT SIDEBAR ===== -->
		<aside class="lh-sidebar @(entranceStage >= 1 ? "entered" : "") @(_menuDeparting ? "departing" : "") @(_menuReturning ? "return" : "")">
			<img class="lh-logo" src="ui/logo/bb_logo_stroke_mascot.png" />
			@* Splash text — randomized per menu visit (RandomizeSplash). @key forces a
			   REMOUNT when splashVersion bumps, so the mount-time stamp keyframe
			   (lh-splash-stamp) fires fresh on every visit, not just the first. *@
			<div class="lh-tag" @key=@($"splash-{splashVersion}")>@currentSplashText</div>

			<nav class="lh-nav @(entranceStage >= 2 ? "entered" : "") @(entranceStage >= 4 ? "settled" : "") @(_menuReturning ? "return" : "")">
				<!-- PLAY block — selectedIndex 0 -->
				<div class="lh-play-slot @(selectedIndex == 0 ? "selected" : "")">
					<button class="lh-play @(_playSquashing && _playFireIndex == 0 ? "squash" : "")"
							onclick=@OnPlayClicked
							@ref="_ref0" onmouseover=@(() => OnButtonHover(0))>
						@* Gold surface layer (the sheen clips to it). Static by design — a
						   liquid wave on a surface this large read motion-sick (user veto). *@
						<span class="lh-play-liquid"><span class="lh-play-sheen"></span></span>
						<span class="lh-play-tri">▶</span>
						<span class="lh-play-lbl">@L("ui.menu.play")</span>
					</button>
					<div class="lh-play-ring"></div>
					@* PLAY detonation flash — one-shot gold bloom. Conditionally mounted so
					   the @keyframes fire fresh on every PLAY (mount-time-only quirk). *@
					@if (_playFlashMounted && _playFireIndex == 0)
					{
						<div class="lh-play-flash" @key=@($"play-flash-{_playFireVersion}")></div>
					}
				</div>

				<!-- Roadmap — selectedIndex 1 -->
				<button class="lh-item @(selectedIndex == 1 ? "selected" : "") @(_departHoldIndex == 1 ? "depart-hold" : "")"
						onclick=@OnRoadmapClicked
						@ref="_ref1" onmouseover=@(() => OnButtonHover(1))>
					<span class="lh-item-fill"></span><span class="lh-item-ico"><iconify icon="lucide:map" Size=@(24) Color="rgba(216, 208, 238, 0.85)" /></span>
					<span class="lh-item-lbl">@L("ui.menu.roadmap")</span>
					<span class="lh-item-ring"></span>
				</button>

				<!-- Options — selectedIndex 2 -->
				<button class="lh-item @(selectedIndex == 2 ? "selected" : "") @(_departHoldIndex == 2 ? "depart-hold" : "")"
						onclick=@OnOptionsClicked
						@ref="_ref2" onmouseover=@(() => OnButtonHover(2))>
					<span class="lh-item-fill"></span><span class="lh-item-ico"><iconify icon="lucide:settings" Size=@(24) Color="rgba(216, 208, 238, 0.85)" /></span>
					<span class="lh-item-lbl">@L("ui.menu.options")</span>
					<span class="lh-item-ring"></span>
				</button>

				<!-- Patch Notes — selectedIndex 3. Gold pip until first read this launch. -->
				<button class="lh-item @(selectedIndex == 3 ? "selected" : "") @(!_patchNotesSeen ? "has-new" : "") @(_departHoldIndex == 3 ? "depart-hold" : "")"
						onclick=@OnPatchNotesClicked
						@ref="_ref3" onmouseover=@(() => OnButtonHover(3))>
					<span class="lh-item-fill"></span><span class="lh-item-ico"><iconify icon="lucide:scroll-text" Size=@(24) Color="rgba(216, 208, 238, 0.85)" /></span>
					<span class="lh-item-lbl">Patch Notes</span>
					@if ( !_patchNotesSeen )
					{
						<span class="lh-item-pip"></span>
					}
					<span class="lh-item-ring"></span>
				</button>
			</nav>

			<!-- (Sidebar screenshot placeholder removed — screenshots will live in the
				 right-side boxes / background instead. The Discord card uses margin-top:auto
				 to push itself + the footer to the bottom, so no empty spacer div is needed.) -->

			<!-- Discord card — selectedIndex 4 (keyboard-focusable; shows the violet ring) -->
			<div class="lh-discord @(selectedIndex == 4 ? "selected" : "")"
				 onclick="@OnDiscordClick"
				 @ref="_ref4" onmouseover=@(() => OnButtonHover(4))>
				<span class="lh-discord-ico"><iconify icon="simple-icons:discord" Size=@(24) Color="#ffffff" /></span>
				<span class="lh-discord-txt">
					<span class="lh-discord-url">@discordDisplayText</span>
					<span class="lh-discord-sub">CLICK TO COPY LINK</span>
				</span>
				<span class="lh-discord-ring"></span>
			</div>

			<!-- Footer: utility entries (LANGUAGE selectedIndex 5 / QUIT selectedIndex 6)
				 + studio mark + version. Keeps LANG + QUIT keyboard-reachable. -->
			<div class="lh-foot">
				<div class="lh-foot-utils">
					<button class="lh-util @(selectedIndex == 5 ? "selected" : "")"
							onclick=@ToggleMainMenuLanguage
							@ref="_ref5" onmouseover=@(() => OnButtonHover(5))>
						<iconify class="lh-util-ico" icon="@GetCurrentLanguageFlag()" Size=@(16) />
						<span>@GetLanguageLabel()</span>
						<span class="lh-util-ring"></span>
					</button>
					<button class="lh-util lh-util-quit @(selectedIndex == 6 ? "selected" : "")"
							onclick=@OnQuitClicked
							@ref="_ref6" onmouseover=@(() => OnButtonHover(6))>
						<iconify class="lh-util-ico" icon="lucide:x" Size=@(15) Color="rgba(200, 192, 224, 0.7)" />
						<span>@GetQuitLabel()</span>
						<span class="lh-util-ring"></span>
					</button>
				</div>
				<div class="lh-foot-brand">
					<span class="lh-studio">
						<img class="lh-studio-mark" src="ui/logo/ps_mark_white_64.png" />
						<span class="lh-studio-name">Public Square</span>
					</span>
					<span class="lh-ver">v1.2.1 — OPEN BETA</span>
				</div>
			</div>
		</aside>

		<!-- ===== MAIN AREA ===== -->
		<main class="lh-main @(entranceStage >= 2 ? "entered" : "") @(_menuDeparting ? "departing" : "")">
			<!-- LIVE event pill — driven by the same live-events fields as before -->
			@if ( !string.IsNullOrEmpty( currentEventText ) )
			{
				<div class="lh-event">
					<span class="lh-event-live"><span class="lh-event-dot"></span>LIVE</span>
					@if ( currentEventIcon.Contains( ":" ) )
					{
						<iconify class="lh-event-ico" icon="@currentEventIcon" Size=@(15) Color="#fbbf24" />
					}
					else if ( !string.IsNullOrEmpty( currentEventIcon ) )
					{
						<span class="lh-event-ico-text">@currentEventIcon</span>
					}
					<span class="lh-event-msg">@currentEventText</span>
					@if ( !string.IsNullOrEmpty( currentEventTimer ) )
					{
						<span class="lh-event-sep">·</span>
						<span class="lh-event-ends">ENDS IN</span>
						<span class="lh-event-timer">@currentEventTimer</span>
					}
				</div>
			}

			<!-- FEATURED CARD — per-release marketing. The headline / kicker / desc
				 are hand-set @code fields (see featuredKicker / featuredTitle / ...);
				 update them each release. Later these could be wired to event or
				 patch-notes data. The hero <img> reuses currentFeatureArt (rotating
				 starter art placeholder) — swap for a real key-art screenshot later. -->
			<section class="lh-featured @(entranceStage >= 2 ? "entered" : "") @(_menuDeparting ? "departing" : "") feat-@(GetFeatureElementClass())" @ref="_refFeatured">
				<!-- KEY ART background (placeholder). When art is ready, set on .lh-feat-shot:
					 background-image: url(<screenshot>); background-size: cover; and delete the
					 label. The scrim dims the left so the headline stays readable over the art. -->
				<div class="lh-feat-shot"><span class="lh-feat-shot-label">SCREENSHOT · KEY ART HERE</span>
					<div class="lh-feat-scrim"></div>
					<div class="lh-feat-vignette"></div>
					<img class="lh-feat-hero" src="@currentFeatureArt" />
				</div>
				<div class="lh-feat-topedge"></div>
				<span class="lh-feat-outnow">★ OUT NOW</span>
				<div class="lh-feat-text">
					<span class="lh-feat-kicker"><span class="lh-feat-bar"></span>@featuredKicker</span>
					<div class="lh-feat-title">
						<span class="lh-feat-line1">@featuredTitle</span>
						<div class="lh-feat-line2"><span class="lh-feat-accent">@featuredTitleAccent</span><span>@featuredTitleTail</span></div>
					</div>
					<div class="lh-feat-desc">@featuredDesc</div>
					<div class="lh-feat-ctas">
						<button class="lh-feat-cta @(selectedIndex == 7 ? "selected" : "") @(_playSquashing && _playFireIndex == 7 ? "squash" : "")"
								onclick=@OnPlayClicked
								@ref="_ref7" onmouseover=@(() => OnButtonHover(7))>
							<span class="lh-feat-cta-tri">▶</span>
							<span>Play Now</span>
							<span class="lh-feat-cta-ring"></span>
						</button>
						<button class="lh-feat-cta lh-feat-cta-ghost @(selectedIndex == 8 ? "selected" : "")"
								onclick=@OnPatchNotesClicked
								@ref="_ref8" onmouseover=@(() => OnButtonHover(8))>
							<span>Patch Notes</span>
							<span class="lh-feat-cta-ring"></span>
						</button>
					</div>
				</div>
			</section>

			<!-- BOTTOM CARD ROW — Roadmap + Community -->
			<div class="lh-cards @(entranceStage >= 3 ? "entered" : "") @(_menuDeparting ? "departing" : "")" @ref="_refCardsRow">
				<!-- Roadmap card — selectedIndex 9. Wrapped in a slot so the violet
					 focus ring can be a SIBLING (the card has overflow:hidden, which
					 would clip a child ring — see .lh-play-slot/.lh-play-ring). -->
				<div class="lh-card-slot @(selectedIndex == 9 ? "selected" : "")" @ref="_refSlot9">
					<button class="lh-card lh-card-roadmap"
							onclick=@OnRoadmapClicked
							onmouseover=@(() => OnButtonHover(9))>
						<span class="lh-card-edge"></span>
						<div class="lh-card-row1">
							<span class="lh-card-icn"><iconify icon="lucide:map" Size=@(25) Color="#ffce3a" /></span>
							<div class="lh-card-htxt">
								<span class="lh-card-kicker">WHAT'S NEXT</span>
								<span class="lh-card-title">Roadmap</span>
							</div>
							<span class="lh-card-go" @ref="_ref9"><span>View</span><iconify icon="lucide:arrow-right" Size=@(14) Color="#2a1605" /><span class="lh-card-go-ring"></span></span>
						</div>
						<div class="lh-card-peek">
							<span class="lh-card-peek-lab">IN DEV</span>
							<span class="lh-card-chip"><span class="lh-card-chip-d"></span><span>Tower Mode</span></span>
							<span class="lh-card-chip"><span class="lh-card-chip-d"></span><span>Map Redesign</span></span>
							<span class="lh-card-chip"><span class="lh-card-chip-d"></span><span>Bug Fixing</span></span>
							<span class="lh-card-chip"><span class="lh-card-chip-d"></span><span>Story</span></span>
						</div>
					</button>
					<div class="lh-card-ring"></div>
				</div>
				<!-- Community card — selectedIndex 10. Same slot+sibling-ring pattern. -->
				<div class="lh-card-slot @(selectedIndex == 10 ? "selected" : "")" @ref="_refSlot10">
					<button class="lh-card lh-card-community"
							onclick=@OnDiscordClick
							onmouseover=@(() => OnButtonHover(10))>
						<span class="lh-card-edge"></span>
						<div class="lh-card-row1">
							<span class="lh-card-icn lh-card-icn-discord"><iconify icon="simple-icons:discord" Size=@(26) Color="#ffffff" /></span>
							<div class="lh-card-htxt">
								<span class="lh-card-kicker">COMMUNITY</span>
								<span class="lh-card-title">Join the Community</span>
							</div>
							<span class="lh-card-go lh-card-go-discord" @ref="_ref10"><span>Join</span><iconify icon="lucide:arrow-right" Size=@(14) Color="#ffffff" /><span class="lh-card-go-ring"></span></span>
						</div>
						<div class="lh-card-presence">
							@*  Real member avatars would need the bot to supply avatar URLs AND the
								droplet to proxy the images (s&box can't load cdn.discordapp.com). Until
								then the live count + dot carry presence — fake avatar dots removed. *@
							@if ( discordMembers > 0 )
							{
								@if ( discordOnline > 0 )
								{
									<span class="lh-card-live-dot"></span>
								}
								<span class="lh-card-presence-txt">@DiscordPresenceText</span>
							}
							else
							{
								<span class="lh-card-presence-txt">Join the Discord community</span>
							}
						</div>
					</button>
					<div class="lh-card-ring"></div>
				</div>
			</div>
		</main>
	</div>

	@if (showStarterSelection)
	{
		<div class="starter-overlay starter-inline">
			<div class="starter-inline-header">
				<div class="starter-title">Choose Your First Bond</div>
				<div class="panel-header-line"></div>
				<div class="starter-subtitle">Your first partner — chosen here, with you always</div>
			</div>

			<div class="starter-ring-stage @(selectedStarter >= 0 ? "has-selection" : "")">
				<div class="ring-silhouette silhouette-fire">
					<img src="ui/starters/embrik_artwork_whiteoutline.png" />
				</div>
				<div class="ring-silhouette silhouette-water">
					<img src="ui/starters/pagefin_artwork_whiteoutline.png" />
				</div>
				<div class="ring-silhouette silhouette-wind">
					<img src="ui/starters/cherune_artwork_whiteoutline.png" />
				</div>

				<div class="ring-center">
					@if (selectedStarter < 0)
					{
						<span class="ring-center-prompt">Pick a companion</span>
					}
					else
					{
						<span class="ring-center-name">@GetStarterName(selectedStarter)</span>
						<span class="ring-center-sub">pending bond</span>
					}
				</div>

				<div class="ring-slot slot-wind @(starterStage >= 1 ? "entered" : "") @(selectedStarter == 2 ? "selected" : "") @(selectedStarter >= 0 && selectedStarter != 2 ? "dimmed" : "")"
					 onclick=@(() => SelectStarter(2))
					 onmouseover=@(() => OnStarterHover(2))>
					<div class="ring-glow"></div>
					<img class="ring-art" src="ui/starters/cherune_artwork.png" />
					@if (selectedStarter == 2 || hoveredStarter == 2)
					{
						<div class="ring-tooltip tooltip-right">
							<div class="tt-header">
								<span class="tt-name">Cherune</span>
								<span class="tt-element element-wind">WIND</span>
							</div>
							<span class="tt-desc">A novice cherub drifting on borrowed halos. Swift and protective — strikes first, shields allies, and watches over the smallest life in the fight.</span>
						</div>
					}
				</div>

				<div class="ring-slot slot-fire @(starterStage >= 2 ? "entered" : "") @(selectedStarter == 0 ? "selected" : "") @(selectedStarter >= 0 && selectedStarter != 0 ? "dimmed" : "")"
					 onclick=@(() => SelectStarter(0))
					 onmouseover=@(() => OnStarterHover(0))>
					<div class="ring-glow"></div>
					<img class="ring-art" src="ui/starters/embrik_artwork.png" />
					@if (selectedStarter == 0 || hoveredStarter == 0)
					{
						<div class="ring-tooltip tooltip-down-right">
							<div class="tt-header">
								<span class="tt-name">Embrik</span>
								<span class="tt-element element-fire">FIRE</span>
							</div>
							<span class="tt-desc">Born from dying campfires. Balanced offense with a warm, steadfast temperament — the kind of companion that warms the long nights between expeditions.</span>
						</div>
					}
				</div>

				<div class="ring-slot slot-water @(starterStage >= 3 ? "entered" : "") @(selectedStarter == 1 ? "selected" : "") @(selectedStarter >= 0 && selectedStarter != 1 ? "dimmed" : "")"
					 onclick=@(() => SelectStarter(1))
					 onmouseover=@(() => OnStarterHover(1))>
					<div class="ring-glow"></div>
					<img class="ring-art" src="ui/starters/pagefin_artwork.png" />
					@if (selectedStarter == 1 || hoveredStarter == 1)
					{
						<div class="ring-tooltip tooltip-down-left">
							<div class="tt-header">
								<span class="tt-name">Pagefin</span>
								<span class="tt-element element-water">WATER</span>
							</div>
							<span class="tt-desc">Formed from a traveler's tears. Resilient and patient — soaks up punishment, then turns the tide when the moment calls for it.</span>
						</div>
					}
				</div>
			</div>

			<div class="starter-inline-buttons">
				<button class="slot-confirm-btn @(selectedStarter < 0 ? "disabled" : "")" onclick=@OnConfirmStarter>
					<span class="slot-confirm-text">@(selectedStarter < 0 ? "CHOOSE A BOND" : "CONFIRM BOND")</span>
				</button>
				<button class="back-btn" onclick=@BackToTitleScreen>
					<span class="back-btn-text">@L("ui.menu.back")</span>
				</button>
			</div>
		</div>
	}

	@if (transitionPhase > 0)
	{
		<div class="menu-transition">
			@* PLAY detonation streak — 12px white-headed gold bolt fired from the
			   PLAY button's screen Y toward the incoming gold slab. Mounts fresh with
			   the overlay, so its @keyframes run at t=0 of the wipe. Inline top/left
			   come from the fired button's live Box.Rect (StartPlayDetonation). *@
			@if (_playFlashMounted)
			{
				<div class="tx-streak" @key=@($"streak-{_playFireVersion}") style="top: @(_streakTop)px; left: @(_streakLeft)px;"></div>
			}
			<div class="tx-slab tx-slab-gold"></div>
			<div class="tx-slab tx-slab-purple"></div>
			<div class="tx-logo-wrap"><img class="tx-logo" src="ui/logo/bb_logo_stroke.png" /></div>
		</div>
	}

	@* PLAY detonation — full-screen gold acknowledge pulse. One-shot keyframe;
	   @key remounts it per fire so it replays (mount-time-only quirk). *@
	@if (_playFlashMounted)
	{
		<div class="lh-screen-pulse" @key=@($"pulse-{_playFireVersion}")></div>
	}

	@* ============================================================
	   SCENE SWAP — Roadmap / Options / Patch Notes
	   The shell + content live in their OWN component (LighthouseScene,
	   Components/LighthouseScene.razor) with its OWN render tree: the
	   menu's swap-frame rebuild can never duplicate/churn scene panels
	   (differ-ghost family) and a scene class flip re-renders ~250 lines,
	   not 3,300. MainMenu keeps the whole swap state machine and drives
	   the shell via params; callbacks come back as METHOD GROUPS
	   (hotload-safe). Scene/Mounted ints are in LOCKSTEP with SceneId
	   (Menu 0 · Roadmap 1 · Options 2 · PatchNotes 3). The shell hides
	   by PARKING OFFSCREEN (always display:flex — layout stays warm, so
	   the swap frame doesn't pay a first-layout hitch; see .lh-scene SCSS).
	   z 90: above the menu, UNDER the living cursor (100).
	   ============================================================ *@
	<LighthouseScene @ref="_sceneComp"
					 SceneCode=@((int)_scene)
					 MountedCode=@((int)_mountedScene)
					 Arrived=@_sceneArrived
					 Settled=@_sceneSettled
					 Departing=@_sceneDeparting
					 KbIndex=@selectedIndex
					 CloseRequested=@CloseScene
					 FeedbackRequested=@OnSendFeedback
					 CycleRequested=@CycleScene
					 HoverRequested=@OnSceneHover />

	@* Gift inbox — auto-opens once per session when GiftManager finds pending
	   dev-granted rewards. Same instance-picker pattern as OptionsPanel so a
	   second mount under GameHUD (if ever added) would route cleanly. *@
	<GiftInboxPopup />

	@* Open-beta disclaimer — shown once per game launch on the title screen.
	   Static field so the popup persists across MainMenu re-mounts within a
	   session but resets every fresh launch. Players who hit "GOT IT" won't
	   see it again until they restart the game, which is the right cadence
	   for an open-beta reminder. *@
	@* Beta popup stays mounted; .visible drives the transition-based pop up / down. *@
	<div class="starter-overlay beta-disclaimer-overlay @(IsVisible && entranceStage >= 1 && !_betaDisclaimerSeen ? "visible" : "")">
			<div class="beta-disclaimer-panel" onclick:stopPropagation>
				<div class="beta-disclaimer-head">
					<div class="beta-disclaimer-icon">
						<iconify icon="lucide:flask-conical" Size=@(26) Color="#ff8a5c" />
					</div>
					<div class="beta-disclaimer-head-copy">
						<div class="beta-disclaimer-kicker">
							<div class="beta-disclaimer-kicker-bar"></div>
							<span class="beta-disclaimer-kicker-text">Heads Up</span>
						</div>
						<span class="beta-disclaimer-title"><span class="beta-disclaimer-title-line">Welcome to the</span><span class="beta-disclaimer-title-gold">Open Beta</span></span>
					</div>
				</div>
				<div class="beta-disclaimer-body">
					<span class="beta-disclaimer-desc">Beastborne is in active development. Expect bugs, jank, and rough edges as the game grows toward 1.0.</span>
					<span class="beta-disclaimer-emphasis">Spot something broken — or got an idea? Please report it!</span>
					<span class="beta-disclaimer-hint">Bugs, suggestions, improvements, new feature ideas — report them all. They shape the game.</span>
				</div>
				<div class="beta-disclaimer-actions">
					<button class="beta-disclaimer-btn-primary" onclick=@DismissBetaDisclaimer>
						<span class="beta-disclaimer-btn-primary-text">Got It</span>
						<span class="beta-disclaimer-btn-ring"></span>
					</button>
				</div>
			</div>
		</div>

	@if (showResetConfirm)
	{
		<div class="starter-overlay reset-confirm-overlay">
			<div class="reset-confirm-panel" onclick:stopPropagation>
				<div class="reset-confirm-header">
					<iconify icon="lucide:alert-triangle" Size=@(28) Color="#f87171" />
					<span class="reset-confirm-title">Reset Game Data?</span>
				</div>
				<div class="reset-confirm-body">
					<span class="reset-confirm-desc">This permanently deletes ALL progress: beasts, items, guild membership, mission progress, achievements.</span>
					<span class="reset-confirm-desc reset-confirm-emphasis">This cannot be undone.</span>
					<span class="reset-confirm-hint">(Triggered by Ctrl+Shift+R on the title screen)</span>
				</div>
				<div class="reset-confirm-actions">
					<button class="reset-cancel-btn @(_dialogIndex == 0 ? "mainmenu-kb-selected" : "")" onclick=@OnCancelReset disabled=@isResetting>
						<span>CANCEL</span>
					</button>
					<button class="reset-confirm-btn @(_dialogIndex == 1 ? "mainmenu-kb-selected" : "")" onclick=@OnConfirmReset disabled=@isResetting>
						<span>@(isResetting ? "RESETTING..." : "YES, DELETE EVERYTHING")</span>
					</button>
				</div>
			</div>
		</div>
	}

	@* Cloud-quarantine prompt — shown when cloud is unreachable AND there is no
	   local cache to fall back on. The player cannot safely play without some
	   save source: if they start fresh and we later push an empty blob, their
	   real cloud save would be overwritten. Offer Retry (re-runs LoadAsync) or
	   Play Offline (acknowledges the risk and lets them in with quarantined writes). *@
	@if (IsVisible && showSaveLoadFailPrompt)
	{
		<div class="starter-overlay save-fail-overlay">
			<div class="save-fail-panel" onclick:stopPropagation>
				<div class="save-fail-tag"><span>Cloud Save</span></div>
				<div class="save-fail-header">
					<iconify icon="lucide:cloud-off" Size=@(28) Color="#f87171" />
					<span class="save-fail-title">Save Server Unreachable</span>
				</div>
				<div class="save-fail-body">
					<span class="save-fail-desc">Beastborne couldn't reach the save server, and there's no offline backup on this machine.</span>
					<span class="save-fail-desc save-fail-emphasis">Progress made this session won't sync until you reconnect.</span>
					<span class="save-fail-hint">Reconnecting and retrying is the safest option.</span>
				</div>
				<div class="save-fail-actions">
					<button class="save-fail-retry-btn @(_dialogIndex == 0 ? "mainmenu-kb-selected" : "")" onclick=@OnSaveFailRetry disabled=@isSaveRetrying>
						<iconify icon="lucide:refresh-cw" Size=@(14) Color="#ffffff" />
						<span>@(isSaveRetrying ? "RETRYING..." : "RETRY")</span>
					</button>
					<button class="save-fail-offline-btn @(_dialogIndex == 1 ? "mainmenu-kb-selected" : "")" onclick=@OnPlayOffline>
						<iconify icon="lucide:wifi-off" Size=@(14) Color="#94a3b8" />
						<span>PLAY OFFLINE</span>
					</button>
				</div>
			</div>
		</div>
	}

</root>

@code {
	// Localization helper
	private string L( string key ) => LocalizationManager.Get( key );
	private string L( string key, params object[] args ) => LocalizationManager.Get( key, args );

	private bool contentVisible = false;
	private int entranceStage = 0;
	private int selectedIndex = 0;

	// Device-mode flag for the MOUSE↔KEYBOARD model. When true the root carries
	// `.kbd-nav` and ALL `:hover` rules (gated behind `.mouse-nav` in the SCSS)
	// stop matching, so mouse hover can't linger on a main-area element while the
	// player is keyboarding the sidebar. Flipped via EnterKeyboardMode() (any
	// nav/confirm keypress) and EnterMouseMode() (mouseover OR onmousemove on the
	// root). selectedIndex already defaults to 0 (PLAY) and resets to 0 on
	// return-to-menu, so the keyboard cursor always has a valid seed.
	// NOTE: starts in mouse mode — the menu opens under the cursor.
	private bool keyboardMode = false;

	// Shared keyboard cursor for two-button modal dialogs (save-fail,
	// hiring, reset confirm). 0 = left button focused, 1 = right. Reset
	// to 0 (the safe choice) whenever such a dialog opens.
	private int _dialogIndex = 0;

	// The scene detail scroll body (roadmap OR patch notes — only one view
	// mounts at a time) now lives in the LighthouseScene component; resolve
	// it fresh on every read through ResolveScrollBody (hotload-safe, never
	// stale after a content remount — the component nulls its refs when
	// Mounted changes AND self-heals by class walk if the @ref never rebinds).
	private Sandbox.UI.Panel detailScrollBody => _sceneComp?.ResolveScrollBody();
	private const float DetailKeyScrollStep = 90f;  // arrow Up/Down nudge
	private const float DetailWheelStep = 60f;       // per wheel notch

	private bool showStarterSelection = false;
	private int selectedStarter = -1; // -1 = none selected yet
	private int hoveredStarter = -1;
	private int starterStage = 0;      // staggered ring entrance

	// ─── SCENE SWAP — "deal-out / deal-in" (spec: scene-swap-spec.md) ────
	// Full sibling-scene transition replacing the old right-edge drawer:
	// clicking Roadmap / Options / Patch Notes makes the MENU's elements fly
	// off along their angled planes (~160ms, together, clicked control dies
	// last), then the destination scene's elements deal in staggered (header
	// slab → content plane → footer). TIMERS drive every state flip (never
	// lerp completion); the angled planes move via the list-driven PlaneTween
	// tweener below (imperative — class-toggle transform transitions snap).
	//
	//   SceneId  — which scene OWNS the screen (flips at the swap frame).
	//   SwapState — Idle / Departing / Arriving.
	//   _pending — input buffer: a destination click DURING Departing queues
	//              (the swap frame lands on the latest request); during
	//              Arriving it INTERRUPTS (a new RunSwap bumps _swapVersion,
	//              the in-flight tweens reverse from their mid-flight poses).
	//
	// showRoadmap / showPatchNotes stay as computed props so the existing
	// gates (wheel, keyboard branch) read unchanged.
	private enum SceneId { Menu, Roadmap, Options, PatchNotes }
	private enum SwapState { Idle, Departing, Arriving }

	private SceneId _scene = SceneId.Menu;
	private SwapState _swap = SwapState.Idle;
	private SceneId? _pending = null;
	private int _swapVersion = 0;            // bumped per RunSwap — interrupts abort stale awaits

	// Which static content (Roadmap / PatchNotes) is mounted in the scene
	// frame. Kept through the scene's departure so it never empties mid-exit.
	// Options content is the always-mounted docked OptionsPanel.
	private SceneId _mountedScene = SceneId.Roadmap;

	// Scene wrapper presentation flags (drive the arrival/exit classes).
	private bool _sceneArrived = false;      // .arrived — group A in, stagger firing
	private bool _sceneSettled = false;      // .settled — stagger delays zeroed (snappy hover)
	private bool _sceneDeparting = false;    // .departing — scene flying out (return trip)

	// Menu-side swap flags.
	private bool _menuReturning = false;     // .return — halved staggers on the re-arrival
	private int _departHoldIndex = -1;       // sidebar control that fired the swap (.depart-hold — dies last)
	private int _sceneReturnIndex = 1;       // where the cursor glides home on return

	// Deferred cursor retarget for scene arrivals: set at the swap frame, then
	// UpdatePendingSceneFocus polls the close button's Box.Rect each OnUpdate
	// and only lands selectedIndex=20 once the rect has been REAL (laid out,
	// non-degenerate) for 2 consecutive frames. Retargeting at the swap frame
	// itself read the rect before layout (the wrapper flipped display the same
	// frame) and stranded the ring over the dead menu control's stale rect.
	private bool _pendingSceneFocus = false;
	private int _sceneFocusFrames = 0;

	private bool _menuDeparting => _swap == SwapState.Departing && _scene == SceneId.Menu;
	private bool showRoadmap => _scene == SceneId.Roadmap;
	private bool showPatchNotes => _scene == SceneId.PatchNotes;

	// The scene shell component (own render tree — see LighthouseScene.razor).
	// Its public refs replace the old _refSceneBg/_refSceneClose/_refSceneAct1/
	// _refSceneAct2 fields: the backdrop plane resolves via ResolvePlane(2),
	// the focusables via FocusEl(20/23-27) — always read fresh through the
	// component so a content remount can never strand a stale panel here.
	private LighthouseScene _sceneComp;

	// Open a content scene from the menu. Owns the open sound (same cue the
	// old drawer used — callers don't double it). Records where the cursor
	// should glide home on return + which sidebar control dies last.
	private void OpenScene( SceneId dest )
	{
		if ( dest == _scene && _swap == SwapState.Idle ) return;
		SoundManager.PlaySlideIn();
		if ( _scene == SceneId.Menu )
		{
			_sceneReturnIndex = (selectedIndex >= 0 && selectedIndex <= 10) ? selectedIndex : 1;
			_departHoldIndex = (selectedIndex >= 1 && selectedIndex <= 3) ? selectedIndex : -1;
		}
		RequestScene( dest );
	}

	// Return to the menu. Static views play the standard back sound; Options
	// closes through OptionsPanel.Hide() (it owns its popdown — the OnUpdate
	// watcher then routes the scene home without a second sound).
	private void CloseScene()
	{
		if ( _scene == SceneId.Menu && _swap == SwapState.Idle ) return;
		if ( _scene == SceneId.Options ) OptionsPanel.Hide();
		else SoundManager.PlaySlideOut();
		RequestScene( SceneId.Menu );
	}

	// Route a scene request through the input-buffer rules.
	private void RequestScene( SceneId dest )
	{
		if ( _swap == SwapState.Departing ) { _pending = dest; return; } // queue — swap frame lands on the latest
		if ( dest == _scene ) return;                                    // already there / already heading there
		_ = RunSwap( dest );                                             // Idle = start; Arriving = INTERRUPT (version bump)
	}

	// The whole swap timeline. Departure ~160ms all-at-once → swap frame
	// (display flip, destination mounted CLOSED one frame) → staggered
	// arrival (A header +0 · B content plane +70 · C footer rides CSS
	// delays). Return trips mirror with halved staggers + rate 0.20.
	private async Task RunSwap( SceneId dest )
	{
		EnsureTweens(); // before any _tw* field is passed by value below
		int v = ++_swapVersion;
		bool fromMenu = _scene == SceneId.Menu;
		if ( SWAP_DEBUG ) Log.Info( $"[swapdbg] DEPART begin dest={dest} fromMenu={fromMenu} v={v} t={Time.Now:F3}" );
		_swap = SwapState.Departing;
		_pending = null;
		_sceneSettled = false;

		if ( fromMenu )
		{
			// Planes exit along their entrance vector, over-rotated (x 0→90,
			// deg 10→17) at the fast departure rate. Mid-entrance poses are
			// kept (StartTween only seeds when inactive) — interrupt-safe.
			_menuReturning = false; // a re-arrival interrupted mid-flight is over
			StartTween( _twFeatured, 0f, 10f, 90f, 17f, 0.34f, false ); // 0.34: snappier exit for the 110ms overlap window
			StartTween( _twCards, 0f, 10f, 90f, 17f, 0.34f, false );
		}
		else
		{
			_sceneArrived = false;
			_sceneDeparting = true;
			// From-pose = the DEPARTING scene's rest lean (see SceneRestDeg —
			// +7 roadmap / −7 patch notes / +5 options) — over-rotate out along
			// the same signed direction (Suto rails: exit along your entrance
			// vector).
			float rest = SceneRestDeg( _scene );
			float sgn = MathF.Sign( rest );
			StartTween( _twSceneBg, 0f, rest, 90f, rest + 7f * sgn, 0.34f, false );
		}
		_pendingSceneFocus = false; // a new swap supersedes any in-flight retarget
		StateHasChanged();

		// TIMER → swap frame. 110ms (was 170/150): the P5 OVERLAP trick — the
		// arrival begins while the departure's opacity tails (0.14-0.16s) are
		// still finishing, so the screen never sits empty between scenes (the
		// "waiting period" the user flagged). Park-based hiding makes the brief
		// coexistence free — no display flip, no layout stall.
		await Task.Delay( (int)(110 * SWAP_SLOWMO) );
		if ( v != _swapVersion ) return;

		// ── SWAP FRAME ── (a queued _pending may have replaced the destination;
		// if it points back at the CURRENT scene we still run the arrival branch
		// — re-arriving where we are recovers the departed pose coherently)
		if ( _pending.HasValue ) { dest = _pending.Value; _pending = null; }
		if ( SWAP_DEBUG ) Log.Info( $"[swapdbg] SWAP FRAME dest={dest} v={v} t={Time.Now:F3} featX={_twFeatured.X:F1} cardsX={_twCards.X:F1}" );
		_swap = SwapState.Arriving;
		_scene = dest;
		_departHoldIndex = -1;
		ResetPlanesForSwap( dest );

		if ( dest == SceneId.Menu )
		{
			// Menu stays mounted — un-park + a CHEAP re-arrival: halved
			// group staggers (0/40/80) + tween rate 0.20. No splash re-stamp
			// (RandomizeSplash isn't called on returns).
			if ( _refMenuContent != null )
			{
				// Clear the imperative hide — stylesheet resumes. (Display is
				// cleared too in case an older build's hotload left None set.)
				_refMenuContent.Style.Display = null;
				_refMenuContent.Style.Opacity = null;
				_refMenuContent.Style.Left = null;
			}
			_sceneDeparting = false;
			_menuReturning = true;
			entranceStage = 0;
			selectedIndex = _sceneReturnIndex;   // cursor cross-glides home (swap+1 frame)
			StateHasChanged();
			await Task.Delay( 30 );              // one rendered frame mounted-closed
			if ( v != _swapVersion ) return;

			entranceStage = 1;                   // sidebar slab back in
			StateHasChanged();
			await Task.Delay( 40 );
			if ( v != _swapVersion ) return;

			entranceStage = 2;                   // nav cascade + featured plane
			StartTween( _twFeatured, 70f, 15f, 0f, 10f, 0.20f, true );
			StateHasChanged();
			await Task.Delay( 40 );
			if ( v != _swapVersion ) return;

			entranceStage = 3;                   // cards plane trails
			StartTween( _twCards, 70f, 15f, 0f, 10f, 0.20f, true );
			StateHasChanged();
			await Task.Delay( 230 );
			if ( v != _swapVersion ) return;

			if ( entranceStage < 4 ) entranceStage = 4; // zero stagger delays; tweens finish + null on their own
			_menuReturning = false;
			_swap = SwapState.Idle;
			StateHasChanged();
		}
		else
		{
			// Mount the destination CLOSED for one rendered frame (the proven
			// mount-then-open rule) so its base states commit before .arrived
			// flips and the transition-delay stagger fires.
			if ( dest != SceneId.Options )
			{
				// A content change remounts the @if branch inside LighthouseScene;
				// the component nulls its own focusable refs in the Mounted setter
				// (so the cursor retarget can never read a deleted panel's frozen
				// Box.Rect — the stranded-ring bug's second failure mode).
				_mountedScene = dest;
			}
			// Imperative menu hide — the .scene-off class proved unreliable here
			// (menu lingered visible under the arriving scene). OPACITY + OFFSCREEN,
			// not Display: flipping display:none dropped the whole menu layout and
			// the return-trip relayout was its own hitch. Both paths are honored
			// independently; the inline markup style mirrors them atomically.
			if ( _refMenuContent != null )
			{
				_refMenuContent.Style.Opacity = 0f;
				_refMenuContent.Style.Left = Length.Pixels( -10000f );
			}
			if ( SWAP_DEBUG ) Log.Info( $"[swapdbg] menu parked offscreen (op 0, left -10000), refNull={_refMenuContent == null} t={Time.Now:F3}" );
			_sceneDeparting = false;
			_sceneArrived = false;
			StateHasChanged();
			await Task.Delay( (int)(30 * SWAP_SLOWMO) );
			if ( v != _swapVersion ) return;

			// Group A — header slab in. The cursor retarget to the scene's
			// first focusable (close, 20) is DEFERRED: UpdatePendingSceneFocus
			// polls until the close button's Box.Rect is real for 2 consecutive
			// frames (the wrapper flipped to flex this frame — reading the rect
			// now strands the ring over the dead menu control's stale rect).
			// Options has no scene-shell focusable (the docked panel owns its
			// own kb cursor) — the living cursor hides there instead.
			// A stale SCENE index from a scene→scene cycle (e.g. poster 24
			// while arriving in patch notes, which has no 24) would CANCEL the
			// retarget (the poll reads >= 20 as "player already chose") — clear
			// it so the ring re-homes; a real hover during arrival still wins.
			if ( selectedIndex >= 20 ) selectedIndex = -1;
			_sceneArrived = true;
			_pendingSceneFocus = dest != SceneId.Options;
			_sceneFocusFrames = 0;
			StateHasChanged();
			await Task.Delay( 70 );
			if ( v != _swapVersion ) return;

			// Group B — the angled backdrop plane deals in toward the DEST
			// scene's signed rest lean (x 70→0, deg rest+5→rest; lean per
			// SceneRestDeg — the angle itself says where you are). Low-key land
			// beat (PlayStamp is currently a no-op stub — wired for the next
			// sound pass, DECISION 3).
			float rest = SceneRestDeg( dest );
			float sgn = MathF.Sign( rest );
			StartTween( _twSceneBg, 70f, rest + 5f * sgn, 0f, rest, 0.16f, true );
			SoundManager.PlayStamp();
			await Task.Delay( 280 );
			if ( v != _swapVersion ) return;

			_swap = SwapState.Idle;
			_sceneSettled = true;                // zero stagger delays — hover SNAP never lags
			StateHasChanged();
		}
	}

	// Swap-frame plane cleanup: halt all tweens and pre-pose the INCOMING
	// scene backdrop at its arrival start so it can't flash its steady CSS
	// pose between the swap frame and the group-B tween start.
	//
	// OUTGOING planes are deliberately NOT touched here. Nulling their inline
	// transforms at the swap frame snapped them back to the steady CSS pose
	// IMMEDIATELY (Style.Transform applies same-frame), while the wrapper's
	// display:none only lands on the NEXT rendered frame — a 1-2 frame
	// "departure flash" of the menu at its regular pose. Their flown-out pose
	// is harmless while hidden: the next arrival re-seeds them (StartTween
	// seeds from-pose when the tween is inactive; PlayEntranceSequence nulls
	// everything on a fresh entrance).
	private void ResetPlanesForSwap( SceneId dest )
	{
		EnsureTweens();
		_twFeatured.Active = false;
		_twCards.Active = false;
		_twSceneBg.Active = false;
		if ( dest != SceneId.Menu )
		{
			// Pre-pose at the DEST scene's signed arrival start (rest + 5° more
			// over-rotated) so the slab can't flash its steady pose pre-tween.
			float rest = SceneRestDeg( dest );
			ApplyDealTransform( ResolvePlane( 2 ), 70f, rest + 5f * MathF.Sign( rest ), 2000 );
		}
	}

	// Per-scene backdrop rest lean (Scene Identity v3 — Suto wayfinding: the
	// angle itself says where you are). LOCKSTEP with the per-scene steady CSS
	// (.lh-scene.scene-* .lh-scene-bg transform) — the tween settles + nulls
	// onto that pose. Patch notes MIRRORS (−7°); Options sits shallower (+5°).
	private static float SceneRestDeg( SceneId s ) => s switch
	{
		SceneId.PatchNotes => -7f,
		SceneId.Options => 5f,
		_ => 7f, // Roadmap (and the safe default)
	};

	// Deferred scene-arrival cursor retarget (see _pendingSceneFocus). Runs
	// every OnUpdate; cheap no-op when idle. A user hover that already moved
	// the selection onto a scene focusable (20+) cancels the pending retarget
	// so it can't stomp the player's choice a few frames later.
	private void UpdatePendingSceneFocus()
	{
		if ( !_pendingSceneFocus ) { _focusPollTicks = 0; return; }
		if ( _scene != SceneId.Roadmap && _scene != SceneId.PatchNotes ) { _pendingSceneFocus = false; return; }
		if ( selectedIndex >= 20 ) { _pendingSceneFocus = false; return; }

		// Resolved through FindFocusable — trusts the @ref when it reads live
		// geometry, otherwise self-heals by class walk (the post-split
		// stranded-ring fix; a branch @ref that never rebound read null here
		// forever and the ring froze over the dead sidebar control).
		var el = _sceneComp?.FindFocusable( 20 );
		// Left > -1000 — the scene shell HIDES by parking at left -10000px (layout
		// stays warm), so a rect can be "real" while still offscreen for a frame.
		bool real = el != null && el.Box.Rect.Width >= 1f && el.Box.Rect.Top >= 1f && el.Box.Rect.Left > -1000f;
		// TEMP (rides SWAP_DEBUG): trace the poll — first frame, every 30th
		// no-progress frame, and the landing — so a strand is diagnosable from
		// the log alone (which condition failed, what the rect read).
		if ( SWAP_DEBUG && ( ++_focusPollTicks == 1 || ( !real && _focusPollTicks % 30 == 0 ) ) )
			Log.Info( $"[swapdbg] focus poll t{_focusPollTicks}: closeNull={el == null} rect={( el != null ? el.Box.Rect.ToString() : "-" )} real={real} frames={_sceneFocusFrames} sel={selectedIndex} compNull={_sceneComp == null}" );
		_sceneFocusFrames = real ? _sceneFocusFrames + 1 : 0;
		if ( _sceneFocusFrames >= 2 )
		{
			_pendingSceneFocus = false;
			if ( SWAP_DEBUG ) Log.Info( $"[swapdbg] focus LANDED on 20 after {_focusPollTicks} poll frames t={Time.Now:F3}" );
			_focusPollTicks = 0;
			selectedIndex = 20;     // ring cross-glides to the close button
			StateHasChanged();
		}
	}

	private int _focusPollTicks = 0; // TEMP diagnostics counter (SWAP_DEBUG window)

	// Scene focusable activation (Enter/Space on indices 20-27).
	private void ExecuteSceneAction()
	{
		switch ( selectedIndex )
		{
			case 20: CloseScene(); break;
			// Roadmap posters — ENTER opens Send Feedback (v3 spec: a poster is
			// an invitation to weigh in on that feature; plain panel for now).
			case 23:
			case 24:
			case 25: OnSendFeedback(); break;
			// Prev/next scene arrows (v3.1) — ENTER mirrors the click.
			case 26: CycleScene( -1 ); break;
			case 27: CycleScene( 1 ); break;
		}
	}

	// ─── A/D FOCUS RAILS + DIRECT SCENE CYCLING (v3, rails reshaped v3.1) ──
	// Each content scene declares its A/D walk order; pushing PAST either end
	// CYCLES directly to the sibling scene (Roadmap ⇄ Patch Notes) through the
	// normal RunSwap scene→scene path — full fly-out/fly-in, no menu detour.
	// v3.1: the footer (and its CTAs 21/22) is GONE; the prev/next ARROWS
	// (26/27) bookend each rail, so A from the prev arrow / D from the next
	// arrow cycles naturally — the arrow IS the edge of the rail. They also
	// carry the A/D key caps (the footer key-rail's vocabulary moved onto
	// them). OPTIONS IS DELIBERATELY NOT IN THE CYCLE: its docked panel owns
	// the keyboard outright (the AnyVisible early-return in
	// HandleKeyboardInput), so A/D can never reach the shell there.
	private static readonly int[] RoadmapFocusRail = { 26, 20, 23, 24, 25, 27 };
	private static readonly int[] PatchNotesFocusRail = { 26, 20, 27 };

	// dir −1 = prev arrow / A past the rail start; +1 = next arrow / D past
	// the end. With two scenes in the ring (Options excluded) both directions
	// land on the sibling — the param keeps the arrows honest and is ready for
	// a 3-scene ring. Also the CycleRequested method-group callback target.
	private void CycleScene( int dir )
	{
		var dest = _scene == SceneId.Roadmap ? SceneId.PatchNotes : SceneId.Roadmap;
		if ( dest == SceneId.PatchNotes ) _patchNotesSeen = true;
		OpenScene( dest ); // owns the open sound; RunSwap handles scene→scene
	}

	// Mouse hover on a scene focusable — same contract as OnButtonHover but
	// for the scene index space. Departing freezes the cursor target (the
	// ring holds the clicked control while the scene shatters).
	private void OnSceneHover( int index )
	{
		EnterMouseMode();
		if ( _swap == SwapState.Departing ) return;
		if ( selectedIndex == index ) return;
		selectedIndex = index;
		SoundManager.PlayHover();
	}

	private bool hoveringUpdate = false;

	// Bonded Sweep transition from PLAY → Hub. 0 = idle/unmounted,
	// 1 = bars sliding in, 2 = bars covering + mascot peek, 3 = bars
	// sweeping off-screen to reveal Hub. See PlayBondedSweepAndStart().
	private int transitionPhase = 0;

	// Ctrl+Shift+R danger-zone shortcut — two-stage confirm before wiping save.
	private bool showResetConfirm = false;
	private bool isResetting = false;

