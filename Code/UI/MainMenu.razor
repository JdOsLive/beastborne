	// Populate the display fields from the current entry in `_liveEvents`.
	// The tamer-side IsDoubleXPActive mechanism is DELIBERATELY not wired here
	// anymore — the main-menu toast is now purely server-driven. (In-game 2x
	// XP tamer logic is still intact elsewhere, we just don't surface it on
	// the menu.) If no events are active, every field clears and the toast
	// markup's `@if ( !string.IsNullOrEmpty( currentEventText ) )` gate hides
	// the whole row.
	private void UpdateEventBanner()
	{
		if ( _liveEvents == null || _liveEvents.Count == 0 )
		{
			currentEventText = "";
			currentEventIcon = "";
			currentEventSub = "";
			currentEventTimer = "";
			return;
		}

		var wrapped = ((_eventIndex % _liveEvents.Count) + _liveEvents.Count) % _liveEvents.Count;
		var ev = _liveEvents[wrapped];
		if ( ev == null )
		{
			currentEventText = "";
			currentEventIcon = "";
			currentEventSub = "";
			currentEventTimer = "";
			return;
		}

		currentEventText = string.IsNullOrWhiteSpace( ev.Name ) ? "Live Event" : ev.Name;
		currentEventIcon = string.IsNullOrWhiteSpace( ev.Icon ) ? "" : ev.Icon;
		currentEventSub = ev.Subtitle ?? "";
		UpdateEventTimer();
	}

	// Formats the time remaining on the CURRENT event (the one at
	// `_eventIndex`). If the event has expired in the time since we last
	// fetched, we drop it locally and re-populate — if that empties the list,
	// the toast hides until the next server poll surfaces a fresh entry.
	private void UpdateEventTimer()
	{
		if ( _liveEvents == null || _liveEvents.Count == 0 )
		{
			currentEventTimer = "";
			return;
		}

		var wrapped = ((_eventIndex % _liveEvents.Count) + _liveEvents.Count) % _liveEvents.Count;
		var ev = _liveEvents[wrapped];
		if ( ev == null )
		{
			currentEventTimer = "";
			return;
		}

		var nowMs = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
		var remainingMs = ev.EndsAt - nowMs;

		if ( remainingMs <= 0 )
		{
			// Stale — remove locally and re-pick. The server will drop it too
			// on the next refresh; until then don't keep ticking a dead entry.
			_liveEvents.RemoveAt( wrapped );
			if ( _liveEvents.Count == 0 )
			{
				currentEventText = "";
				currentEventIcon = "";
				currentEventSub = "";
				currentEventTimer = "";
				return;
			}
			_eventIndex = 0;
			UpdateEventBanner();
			return;
		}

		var remaining = TimeSpan.FromMilliseconds( remainingMs );
		if ( remaining.TotalDays >= 1 )
			currentEventTimer = $"{(int)remaining.TotalDays}d {remaining.Hours}h";
		else if ( remaining.TotalHours >= 1 )
			currentEventTimer = $"{(int)remaining.TotalHours}h {remaining.Minutes}m";
		else
			currentEventTimer = $"{remaining.Minutes}m {remaining.Seconds}s";
	}

	/// <summary>
	/// Fire-and-forget refresh of the live events feed. Swaps <c>_liveEvents</c>
	/// in place with server data and re-populates the toast display fields.
	/// Safe to call repeatedly — the server response is tiny and already filters
	/// inactive events. On failure, we clear the list and hide the toast rather
	/// than stick on a stale snapshot.
	/// </summary>
	private async Task RefreshEventsAsync()
	{
		try
		{
			var live = await EventsApiClient.GetAllAsync();
			_liveEvents = live ?? new List<LiveEvent>();

			// Reset the rotation cursor whenever the underlying list changes —
			// otherwise a previously-large list shrinking to 1 item could land
			// us on a `_eventIndex` far past the end.
			_eventIndex = 0;
			_sinceEventRotation = 0;

			UpdateEventBanner();
			StateHasChanged();
		}
		catch ( Exception e )
		{
			Log.Warning( $"[MainMenu] RefreshEventsAsync failed: {e.Message}" );
		}
	}

	// Rotate to the next event if more than one is active. No-op for 0/1.
	// Called from OnUpdate on the `_sinceEventRotation` cadence.
	private void RotateEvent()
	{
		if ( _liveEvents == null || _liveEvents.Count <= 1 ) return;
		_eventIndex = (_eventIndex + 1) % _liveEvents.Count;
		UpdateEventBanner();
	}

	private void RandomizeSplash()
	{
		var random = new Random();
		currentSplashText = SplashTexts[random.Next( SplashTexts.Length )];
		splashVersion++; // remount the tag → replay the stamp keyframe
		_ = PlayStampWithKeyframeDelay();
	}

	// The stamp keyframe sits behind a 0.5s animation-delay — the press sound
	// must land WITH the visual stamp, not at randomize time.
	private async Task PlayStampWithKeyframeDelay()
	{
		await Task.Delay( 500 );
		if ( IsVisible ) SoundManager.PlayStamp();
	}

	private void RandomizeFeatureArt()
	{
		var random = new Random();
		currentFeatureArt = FeatureArtPool[random.Next( FeatureArtPool.Length )];
	}

	// Maps the rotating feature art to an element class for the behind-portrait
	// aura. Fire → warm red, water → cool blue, wind → soft green. The aura
	// does the color-story work (character-driven) instead of a fixed wash.
	private string GetFeatureElementClass()
	{
		if ( string.IsNullOrEmpty( currentFeatureArt ) ) return "neutral";
		if ( currentFeatureArt.Contains( "embrik" ) ) return "fire";
		if ( currentFeatureArt.Contains( "pagefin" ) ) return "water";
		if ( currentFeatureArt.Contains( "cherune" ) ) return "wind";
		return "neutral";
	}

	private void ApplyTickerItem( int index )
	{
		if ( tickerItems == null || tickerItems.Count == 0 ) return;
		var wrapped = ((index % tickerItems.Count) + tickerItems.Count) % tickerItems.Count;
		tickerIndex = wrapped;
		var item = tickerItems[wrapped];
		currentTickerText = item.Text;
		currentTickerIcon = item.Icon;
		currentTickerColor = item.Color;
	}

	/// <summary>
	/// Fire-and-forget refresh of the live announcements feed. Swaps the active
	/// <see cref="tickerItems"/> list in place with server data on success, or
	/// leaves the fallback list untouched on failure/empty. Safe to call
	/// repeatedly — the server response is tiny and the request is idempotent.
	/// </summary>
	private async Task RefreshAnnouncementsAsync()
	{
		try
		{
			var live = await AnnouncementsApiClient.GetAllAsync();
			if ( live == null || live.Count == 0 )
			{
				// Server reachable but nothing to show (or request failed and
				// returned empty). Keep the fallback list in place.
				return;
			}

			_liveAnnouncements = live;

			// Cap at top 5 to prevent the ticker from bloating if we accumulate
			// many active announcements. Server already returns them ordered by
			// priority DESC, created_at DESC — so the top 5 are the most
			// important + most recent. Lower-priority / older ones are silently
			// dropped from the rotation until they're promoted or expire.
			const int MaxTickerItems = 5;

			// Map live announcements → TickerItem, substituting defaults for
			// any missing icon/color fields.
			var mapped = new List<TickerItem>( Math.Min( live.Count, MaxTickerItems ) );
			foreach ( var a in live )
			{
				if ( mapped.Count >= MaxTickerItems ) break;
				if ( string.IsNullOrWhiteSpace( a?.Text ) ) continue;
				var icon = string.IsNullOrWhiteSpace( a.Icon ) ? "lucide:radio" : a.Icon;
				var color = string.IsNullOrWhiteSpace( a.Color ) ? "#fbbf24" : a.Color;
				mapped.Add( new TickerItem( a.Text, icon, color ) );
			}

			if ( mapped.Count == 0 ) return; // all rows invalid — keep fallback

			tickerItems = mapped;
			tickerIndex = 0;
			ApplyTickerItem( 0 );
			tickerVisible = true;
			sinceTickerRotation = 0;
			StateHasChanged();
		}
		catch ( Exception e )
		{
			Log.Warning( $"[MainMenu] RefreshAnnouncementsAsync failed: {e.Message}" );
		}
	}

	// Rotates the news ticker text on a timer. Uses a two-phase fade via the
	// `tickerVisible` class — fade to 0, swap content, fade to 1. Keeps the
	// slide-in snappy without requiring CSS transition-delay (which s&box drops).
	private async void TickTicker()
	{
		if ( !IsVisible ) return;

		tickerVisible = false;
		StateHasChanged();

		await Task.Delay( (int)(TickerFadeSeconds * 1000) );

		if ( !IsVisible ) return;
		ApplyTickerItem( tickerIndex + 1 );
		tickerVisible = true;
		StateHasChanged();
	}

	protected override void OnDestroy()
	{
		if ( GameManager.Instance != null )
		{
			GameManager.Instance.OnStateChanged -= OnGameStateChanged;
		}
	}

	private void OnGameStateChanged( GameState oldState, GameState newState )
	{
		// Reset selections when returning to main menu
		if ( newState == GameState.MainMenu )
		{
			showStarterSelection = false;
			// Hard-reset the scene swap — any in-flight RunSwap aborts on the
			// version bump and the menu owns the screen for the fresh entrance.
			_swapVersion++;
			_scene = SceneId.Menu;
			_swap = SwapState.Idle;
			_pending = null;
			_sceneArrived = false;
			_sceneSettled = false;
			_sceneDeparting = false;
			_menuReturning = false;
			_departHoldIndex = -1;
			_pendingSceneFocus = false;
			_sceneFocusFrames = 0;
			selectedIndex = 0;
			selectedStarter = -1;
			hoveredStarter = -1;

			// Randomize splash text, featured portrait, and update event when returning to menu
			RandomizeSplash();
			RandomizeFeatureArt();
			UpdateEventBanner();

			// Returning to the menu is a good moment to refresh live events —
			// a new one may have gone active while the player was in-game.
			// Stamp first, then fire, so a failed request doesn't cause an
			// immediate retry storm on the next tick.
			_lastEventsFetchTime = Time.Now;
			_ = RefreshEventsAsync();

			// Replay entrance animation
			PlayEntranceSequence();
		}
	}

	protected override void OnUpdate()
	{
		// Update global sprite animations — but only re-render for them when the
		// starter selection is up (the ONLY menu state with animated sprites).
		// Unconditionally hashing GlobalFrame re-rendered the whole ~3k-line tree
		// every sprite tick — a large share of the menu's frame cost.
		if ( SpriteAnimator.Update() && showStarterSelection )
		{
			StateHasChanged();
		}

		// Bind/refresh the ambient video texture onto the bg panel every frame.
		// Cheap when already bound; becomes live once VideoBackground's OnLoaded
		// populates the Texture handle.
		UpdateVideoBackgroundStyle();

		// PER-FRAME assert: the menu surface is hard-hidden while any scene owns
		// the screen. NOT via @ref — the ref provably pointed at a live panel
		// that was hidden while the menu STILL rendered, meaning a duplicate/
		// ghost .menu-content exists in the tree that no ref reaches. Walk the
		// actual children every frame and hide EVERY panel wearing the class.
		// (No Display writes — see the swap-frame hide: opacity + offscreen only,
		// so the menu's layout stays warm for the return trip.)
		if ( Panel != null )
		{
			bool hideMenu = _scene != SceneId.Menu;
			foreach ( var child in Panel.Children )
			{
				if ( child != null && child.HasClass( "menu-content" ) )
				{
					child.Style.Opacity = hideMenu ? 0f : (float?)null;
					child.Style.Left = hideMenu ? Length.Pixels( -10000f ) : (Length?)null;
				}
			}
		}

		// PER-FRAME ghost census while a scene is up — the ghost lives <1s so a
		// 1Hz sample missed it. Logs only on CHANGE (count or child-total) to
		// keep the spam bounded; any extra .menu-content or child-count jump is
		// the ghost being born/destroyed.
		if ( SWAP_DEBUG && Panel != null && _scene != SceneId.Menu )
		{
			int found = 0;
			foreach ( var child in Panel.Children )
			{
				if ( child != null && child.HasClass( "menu-content" ) )
				{
					found++;
					if ( found > 1 || Panel.ChildrenCount != _lastChildCount )
						Log.Info( $"[swapdbg] census #{found} isRef={ReferenceEquals( child, _refMenuContent )} disp={child.ComputedStyle?.Display} op={child.ComputedStyle?.Opacity:F2} rect={child.Box.Rect} t={Time.Now:F3}" );
				}
			}
			if ( found != _lastMenuCount || Panel.ChildrenCount != _lastChildCount )
				Log.Info( $"[swapdbg] census CHANGE menuCount={found} rootChildren={Panel.ChildrenCount} t={Time.Now:F3}" );
			_lastMenuCount = found;
			_lastChildCount = Panel.ChildrenCount;
		}

		if ( !IsVisible ) return;
		HandleKeyboardInput();
		UpdatePlayDetonation();    // PLAY detonation — before UpdateCursor so the ring-slam geometry lands same-frame
		UpdatePlaneTweens();       // angled planes (featured / cards / scene bg); flips entranceStage 3→4 on settle
		UpdatePendingSceneFocus(); // deferred scene-arrival retarget — before UpdateCursor so the ring gets the index same-frame
		UpdateCursor();

		// Options closed itself (Done / X / Q inside OptionsPanel) — swap the
		// scene back to the menu. Hide() already played the popdown, so this
		// is geometry-only (no extra sound, no double-Hide). Allowed during
		// Arriving too (RequestScene interrupts cleanly); Departing buffers.
		if ( _scene == SceneId.Options && _swap != SwapState.Departing && !OptionsPanel.AnyVisible )
		{
			RequestScene( SceneId.Menu );
		}

		// Periodic refresh of the live announcements feed (every 5 min while
		// the main menu is mounted + visible). Fire-and-forget — we don't
		// block the UI on it. First fetch happens in OnStart; this only
		// handles subsequent refreshes.
		if ( _lastAnnouncementFetchTime >= 0f && Time.Now - _lastAnnouncementFetchTime >= AnnouncementRefreshSeconds )
		{
			_lastAnnouncementFetchTime = Time.Now;
			_ = RefreshAnnouncementsAsync();
		}

		// Same 5-minute cadence for the live events feed. Stamp first, then
		// fire, so a failing request doesn't hammer the server each tick.
		if ( _lastEventsFetchTime >= 0f && Time.Now - _lastEventsFetchTime >= EventsRefreshSeconds )
		{
			_lastEventsFetchTime = Time.Now;
			_ = RefreshEventsAsync();
		}

		// Rotate between active events every ~10s if more than one is live.
		// Also re-tick the countdown timer on the current event so "ENDS IN
		// 2h 15m" stays fresh without waiting for a full refresh.
		if ( _liveEvents != null && _liveEvents.Count > 0 )
		{
			if ( _liveEvents.Count > 1 && _sinceEventRotation >= EventRotationSeconds )
			{
				_sinceEventRotation = 0;
				RotateEvent();
			}
			else
			{
				// Cheap: just refreshes the timer string on the current entry.
				UpdateEventTimer();
			}
		}

		// Rotate the news ticker on a cadence. Only while on the idle menu —
		// no rotation while a takeover/scene-swap is active (keeps focus quiet
		// during starter/scene flows).
		if ( !showStarterSelection && _scene == SceneId.Menu && _swap == SwapState.Idle )
		{
			if ( sinceTickerRotation >= TickerRotationSeconds )
			{
				sinceTickerRotation = 0;
				TickTicker();
			}
		}
	}

	private void HandleKeyboardInput()
	{
		// OptionsPanel is a separate sub-component with its own keyboard loop
		// (Tick: arrows move the row cursor, Space/Enter flip the toggle, Q
		// closes). While ANY instance is open (the docked one in the slide-in
		// shell here, or GameHUD's modal), suppress all main-menu keyboard
		// input so Up/Down don't shift selectedIndex behind the panel and
		// Ctrl+Shift+R doesn't fire the reset-confirm on top. AnyVisible (not
		// Instance.IsVisible) — Instance may point at the OTHER screen's mount.
		if ( OptionsPanel.AnyVisible )
			return;

		// ─── OVERLAY PRECEDENCE ─────────────────────────────────────
		// Modal overlays each fully OWN keyboard input while open — every
		// handler `return`s so menu navigation never leaks behind a popup.
		// Order matches z-stacking: the beta disclaimer sits on top at boot,
		// then save-fail, then hiring, then reset-confirm. Process the
		// top-most open overlay first.

		// Open-beta disclaimer — first thing a player sees at launch.
		// Single GOT IT button; Enter/Space/Q all dismiss it.
		if (!_betaDisclaimerSeen)
		{
			if (Input.Pressed("Jump") || Input.Pressed("Enter")
				|| Input.Pressed("Menu") || Input.Pressed("run"))
			{
				DismissBetaDisclaimer();
			}
			return;
		}

		// Cloud-quarantine prompt — two buttons (RETRY / PLAY OFFLINE).
		// Left/Right pick, Enter/Space activate, Q acts as "Play Offline"
		// (the non-destructive escape — it lets the player in).
		if (showSaveLoadFailPrompt)
		{
			if (isSaveRetrying) return; // locked while a retry is in flight
			HandleTwoButtonDialog(
				onLeft: OnSaveFailRetry,
				onRight: OnPlayOffline,
				onBack: OnPlayOffline );
			return;
		}

		// A swap in its departure window owns the screen — keyboard goes quiet
		// for the ~160ms (mouse clicks still buffer via RequestScene). Arrival
		// stays fully interactive (input outruns animation — interrupts work).
		if (_swap == SwapState.Departing)
			return;

		// Danger-zone shortcut: Ctrl+Shift+R wipes ALL game data after a two-stage
		// confirm. Only armed on the clean title screen (no takeover active) so
		// the player can't fat-finger it mid-flow. The actual reset runs via the
		// inline confirm overlay below — OptionsPanel's Danger Zone is the main
		// in-game path; this shortcut stays as a no-save-data rescue hatch.
		// In s&box: "duck" = Ctrl, "run" = Shift, "reload" = R.
		if (!showStarterSelection && _scene == SceneId.Menu && !showResetConfirm)
		{
			if (Input.Down("duck") && Input.Down("run") && Input.Pressed("reload"))
			{
				SoundManager.PlayPopup();
				showResetConfirm = true;
				_dialogIndex = 0; // default focus to the safe CANCEL button
				StateHasChanged();
				return;
			}
		}

		// Reset-confirm overlay — two buttons (CANCEL / YES, DELETE). Q backs
		// out via CANCEL (the safe choice — destructive action is never the
		// keyboard default).
		if (showResetConfirm)
		{
			if (isResetting) return; // locked while the wipe runs
			HandleTwoButtonDialog(
				onLeft: OnCancelReset,
				onRight: OnConfirmReset,
				onBack: OnCancelReset );
			return;
		}

		if (showRoadmap || showPatchNotes)
		{
			// Content scenes: Q/back swaps home; W/S scroll the body (mouse
			// wheel handled in OnMouseWheel); A/D walk the scene focusables
			// (prev arrow → close → posters → next arrow) with the living
			// cursor; Enter/Space activates. Options is NOT here — the docked
			// OptionsPanel owns its own keyboard loop (the AnyVisible
			// early-return above).
			if (Input.Pressed("Menu") || Input.Pressed("run"))
			{
				CloseScene();
				return;
			}
			// (v3.1: the footer CTAs and their Slot1/Slot2 number hotkeys left
			// with the footer — Q close + A/D rail + ENTER is the whole scene
			// key vocabulary now, and every key wears a visible cap.)
			// A/D walks the scene's focus rail (prev arrow → close → posters →
			// next arrow on roadmap; prev arrow → close → next arrow on patch
			// notes). Pushing PAST either end cycles directly to the sibling
			// scene — the v3 "exciting switching" path (Roadmap ⇄ Patch Notes;
			// Options excluded, see the rail note).
			if (Input.Pressed("Left") || Input.Pressed("Right"))
			{
				EnterKeyboardMode();
				int[] rail = showRoadmap ? RoadmapFocusRail : PatchNotesFocusRail;
				int cur = Array.IndexOf(rail, selectedIndex);
				if (cur < 0)
				{
					// Ring mid-retarget / stale index — the first press SEEDS
					// focus at close instead of walking (a blind A press must
					// not surprise-cycle the scene). Explicit 20: the rail now
					// STARTS at the prev arrow (26), but close stays the
					// natural landing spot (matches the arrival retarget).
					_pendingSceneFocus = false;
					selectedIndex = 20;
					SoundManager.PlayHover();
					return;
				}
				int next = cur + (Input.Pressed("Left") ? -1 : 1);
				if (next < 0 || next >= rail.Length)
				{
					CycleScene(Input.Pressed("Left") ? -1 : 1);
					return;
				}
				if (rail[next] != selectedIndex)
				{
					_pendingSceneFocus = false; // player took the wheel — drop the auto-retarget
					selectedIndex = rail[next];
					SoundManager.PlayHover();
				}
				return;
			}
			if (Input.Pressed("Jump") || Input.Pressed("Enter"))
			{
				EnterKeyboardMode();
				ExecuteSceneAction();
				return;
			}
			if (detailScrollBody != null)
			{
				if (Input.Pressed("Down"))
					ScrollDetailBody(DetailKeyScrollStep);
				else if (Input.Pressed("Up"))
					ScrollDetailBody(-DetailKeyScrollStep);
			}
			return;
		}
		else if (showStarterSelection)
		{
			// Navigate starters. Allow -1 as "none chosen"; first keypress picks 0.
			if (Input.Pressed("Left"))
			{
				selectedStarter = selectedStarter <= 0 ? 0 : selectedStarter - 1;
				SoundManager.PlayHover();
			}
			else if (Input.Pressed("Right"))
			{
				selectedStarter = selectedStarter < 0 ? 0 : Math.Min(2, selectedStarter + 1);
				SoundManager.PlayHover();
			}
			else if (Input.Pressed("Jump") || Input.Pressed("Enter"))
				OnConfirmStarter();
			else if (Input.Pressed("Menu") || Input.Pressed("run"))
			{
				BackToTitleScreen();
			}
		}
		else
		{
			// Navigate the menu as a 2D grid (sidebar column 0–6 on the left, the
			// main-area CTA pair 7/8 + card pair 9/10 on the right). Movement is
			// resolved through MenuNavTarget() — an adjacency table keyed by the
			// current index. Any nav/confirm key flips into keyboard mode so mouse
			// hover on the main-area CTAs/cards is suppressed (never two cursors).
			//
			// The Up/Down/Left/Right actions are bound to W/S/A/D in
			// ProjectSettings/Input.config (there are no separate arrow-key binds in
			// this project — "arrow nav" in the codebase IS WASD). The Forward/
			// Backward actions are the SAME physical W/S keys, polled too so a future
			// re-bind that splits them apart still drives the menu.
			bool up    = Input.Pressed("Up")    || Input.Pressed("Forward");   // W
			bool down  = Input.Pressed("Down")  || Input.Pressed("Backward");  // S
			bool left  = Input.Pressed("Left");                                // A
			bool right = Input.Pressed("Right");                               // D

			if (up || down || left || right)
			{
				EnterKeyboardMode();
				char dir = up ? 'W' : down ? 'S' : left ? 'A' : 'D';
				int target = MenuNavTarget(selectedIndex, dir);
				if (target >= 0 && target != selectedIndex)
				{
					selectedIndex = target;
					SoundManager.PlayHover();
				}
				// No neighbor in that direction = no-op (don't wrap, don't crash).
			}
			else if (Input.Pressed("Jump") || Input.Pressed("Enter"))
			{
				EnterKeyboardMode();
				ExecuteSelectedAction();
			}
		}
	}

	// ─── MENU 2D NAVIGATION (adjacency table) ───────────────────────────
	// Returns the selectedIndex reached by pressing `dir` (W/A/S/D) from
	// `from`, or -1 for "no neighbor" (the caller leaves selection unchanged).
	//
	// Layout the table encodes:
	//   SIDEBAR column (left):   0 PLAY → 1 Roadmap → 2 Options → 3 PatchNotes
	//                            → 4 Discord, then the 5 LANGUAGE | 6 QUIT pair.
	//   MAIN area (right):       7 PlayNow | 8 PatchCTA   (CTA pair, top)
	//                            9 RoadmapCard | 10 CommCard (card pair, bottom)
	// Crossing: D from a sidebar item jumps to the nearest main element
	//   (top sidebar rows → Play Now; Discord → Roadmap card). A from a main
	//   element returns to the sidebar (leftmost of each pair → PLAY / Discord;
	//   rightmost stays within its pair). LANGUAGE|QUIT are a horizontal pair —
	//   D goes LANG→QUIT, A goes QUIT→LANG; W from either returns to Discord.
	private int MenuNavTarget( int from, char dir )
	{
		switch (from)
		{
			// ── Sidebar column ──
			case 0: // PLAY
				return dir == 'W' ? 6 : dir == 'S' ? 1 : dir == 'D' ? 7 : -1; // W wraps up to QUIT
			case 1: // Roadmap
				return dir == 'W' ? 0 : dir == 'S' ? 2 : dir == 'D' ? 7 : -1;
			case 2: // Options
				return dir == 'W' ? 1 : dir == 'S' ? 3 : dir == 'D' ? 7 : -1;
			case 3: // Patch Notes
				return dir == 'W' ? 2 : dir == 'S' ? 4 : dir == 'D' ? 7 : -1;
			case 4: // Discord card
				return dir == 'W' ? 3 : dir == 'S' ? 5 : dir == 'D' ? 9 : -1;
			case 5: // LANGUAGE (left of the footer pair)
				return dir == 'W' ? 4 : dir == 'D' ? 6 : dir == 'S' ? 0 : -1; // S wraps up to PLAY
			case 6: // QUIT (right of the footer pair)
				return dir == 'W' ? 4 : dir == 'A' ? 5 : dir == 'S' ? 0 : dir == 'D' ? 9 : -1; // S→PLAY, D→Roadmap card

			// ── Main area: CTA pair (top) ──
			case 7: // Play Now CTA (left of pair)
				return dir == 'A' ? 0 : dir == 'D' ? 8 : dir == 'S' ? 9 : -1;
			case 8: // Patch Notes CTA (right of pair)
				return dir == 'A' ? 7 : dir == 'S' ? 9 : -1; // S → Roadmap card (not Community)

			// ── Main area: card pair (bottom) ──
			case 9: // Roadmap card (left of pair)
				return dir == 'W' ? 7 : dir == 'A' ? 4 : dir == 'D' ? 10 : -1;
			case 10: // Community card (right of pair)
				return dir == 'W' ? 8 : dir == 'A' ? 9 : -1;
		}
		return -1;
	}

	// ─── TWO-BUTTON DIALOG KEYBOARD HELPER ──────────────────────────
	// Shared scheme for every two-choice modal (save-fail, hiring, reset
	// confirm). `_dialogIndex` is the focused button (0 = left, 1 = right);
	// Left/Right move focus, Enter/Space activate the focused button, Q
	// runs `onBack` (always wired to the SAFE / non-destructive choice).
	private void HandleTwoButtonDialog( Action onLeft, Action onRight, Action onBack )
	{
		if (Input.Pressed("Menu") || Input.Pressed("run"))
		{
			onBack?.Invoke();
			return;
		}
		if (Input.Pressed("Left") && _dialogIndex != 0)
		{
			_dialogIndex = 0;
			SoundManager.PlayHover();
			StateHasChanged();
			return;
		}
		if (Input.Pressed("Right") && _dialogIndex != 1)
		{
			_dialogIndex = 1;
			SoundManager.PlayHover();
			StateHasChanged();
			return;
		}
		if (Input.Pressed("Jump") || Input.Pressed("Enter"))
		{
			if (_dialogIndex == 0) onLeft?.Invoke();
			else onRight?.Invoke();
		}
	}

	// Nudge the detail scroll body by `delta` px, clamped at the top.
	// s&box clamps the bottom on its own. Used by arrow keys + mouse wheel.
	private void ScrollDetailBody( float delta )
	{
		if (detailScrollBody == null) return;
		float y = Math.Max( 0f, detailScrollBody.ScrollOffset.y + delta );
		detailScrollBody.ScrollOffset = new Vector2( detailScrollBody.ScrollOffset.x, y );
	}

	// Mouse wheel over the slide-in detail panel scrolls its body. UI wheel
	// events arrive here, NOT via Input.MouseWheel (that's the game channel).
	// Declared `protected` (not `protected internal`): the base member is
	// `protected internal` but it lives in another assembly, so only the
	// `protected` half is visible here — the override must match that.
	protected override void OnMouseWheel( Vector2 delta )
	{
		if ((showPatchNotes || showRoadmap) && detailScrollBody != null)
		{
			ScrollDetailBody( delta.y * DetailWheelStep );
			return; // consume — don't fall through to anything below
		}
		base.OnMouseWheel( delta );
	}

	private void ExecuteSelectedAction()
	{
		switch (selectedIndex)
		{
			case 0: OnPlayClicked(); break;
			case 1: OnRoadmapClicked(); break;
			case 2: OnOptionsClicked(); break;
			case 3: OnPatchNotesClicked(); break;
			case 4: OnDiscordClick(); break;
			case 5: ToggleMainMenuLanguage(); break;
			case 6: OnQuitClicked(); break;
			// Main-area elements (keyboard-reachable via D from the sidebar).
			case 7: OnPlayClicked(); break;        // Play Now CTA
			case 8: OnPatchNotesClicked(); break;  // Patch Notes CTA
			case 9: OnRoadmapClicked(); break;     // Roadmap card
			case 10: OnDiscordClick(); break;      // Community card
		}
	}

	private void OnButtonHover(int index)
	{
		// Hovering a sidebar entry is a MOUSE action — re-assert mouse mode so
		// hover styling comes back even if we were just keyboarding.
		EnterMouseMode();
		// While the menu departs, the cursor target is frozen on the clicked
		// control (it dies last — the ring holds it while the scene shatters).
		if (_swap == SwapState.Departing) return;
		if (selectedIndex == index) return;
		selectedIndex = index;
		PlayHoverSound();
	}

	// ─── DEVICE-MODE (MOUSE ↔ KEYBOARD) ─────────────────────────────
	// Flip into keyboard mode the instant any nav/confirm key is used; flip back
	// into mouse mode the instant the mouse moves. Both guard on the current
	// value so they only re-render on an actual change (onmousemove fires every
	// frame the cursor moves). Reflected as `.kbd-nav` / `.mouse-nav` on the root
	// — the SCSS gates every main-area `:hover` behind `.mouse-nav`, so keyboard
	// mode suppresses ALL mouse hover. Never both cursors at once.
	private void EnterKeyboardMode()
	{
		if (keyboardMode) return;
		keyboardMode = true;
		StateHasChanged();
	}

	// onmousemove on the menu root — catches movement WITHIN an element (where
	// onmouseover never re-fires), so parking-then-twitching the mouse restores
	// hover. Same pattern as SkillTreePanel's OnPanelMouseMove.
	private void OnMenuMouseMove()
	{
		EnterMouseMode();
	}

	private void EnterMouseMode()
	{
		if (!keyboardMode) return;
		keyboardMode = false;
		StateHasChanged();
	}

	// ─── LIVING SELECTION CURSOR ─────────────────────────────────────────
	// One violet ring that glides + liquid-stretches between focusable items.
	// Both mouse hover and keyboard nav drive `selectedIndex`, so the cursor just
	// follows it. Position is read from each item's Box.Rect (raw screen px, the
	// same approach TutorialPanel uses to overlay a target) and written as a
	// root-relative px style; the CSS transitions on .lh-cursor do the gliding.
	private Panel _ref0, _ref1, _ref2, _ref3, _ref4, _ref5, _ref6, _ref7, _ref8, _ref9, _ref10;

	private Panel FocusEl( int i ) => i switch
	{
		0 => _ref0, 1 => _ref1, 2 => _ref2, 3 => _ref3, 4 => _ref4, 5 => _ref5,
		6 => _ref6, 7 => _ref7, 8 => _ref8, 9 => _ref9, 10 => _ref10,
		// Scene focusables (Roadmap/PatchNotes): 20 close · 23/24/25 roadmap
		// posters · 26/27 prev/next scene arrows (the footer CTAs 21/22 left
		// with the footer, v3.1). Resolved through FindFocusable — the
		// component trusts its @ref when it reads live geometry and otherwise
		// SELF-HEALS by class walk (the post-split stranded-ring fix: a branch
		// @ref that never rebound left the focus poll reading null forever
		// while the ring held the dead sidebar control).
		>= 20 and <= 27 => _sceneComp?.FindFocusable( i ),
		_ => null
	};

	// Per-index gap (horizontal/vertical inset) + corner radius so the cursor hugs
	// each item exactly like its old per-item ring did.
	private (int gx, int gy, int r) CursorGeom( int i ) => i switch
	{
		// gap = inset; visible gap to the button ≈ gap − 4 (the ring border). Radius
		// = item radius + gap so corners stay concentric.
		5 or 6 => (13, 11, 16),   // util (LANGUAGE / QUIT)
		7 or 8 => (11, 11, 24),   // featured CTAs (Play Now / Patch Notes) — tighter than sidebar
		9 or 10 => (10, 10, 21),  // roadmap/community View+Join pills
		1 or 2 or 3 => (11, 11, 27), // nav rows — tighter ring (hugs the filled selection)
		20 => (9, 9, 21),         // scene close button (56px slab, radius 12 — v3.1 upsize)
		23 or 24 or 25 => (10, 10, 26), // roadmap posters (520×560 slabs, radius 16)
		26 or 27 => (10, 10, 24), // prev/next scene arrows (64×170 slabs, radius 14)
		_ => (14, 14, 30),        // PLAY + discord
	};

	// Panels that hold a 3D rotation — so the cursor can pivot around THEIR left edge for
	// controls nested inside them (CTAs in the featured card, pills in the cards).
	private Panel _refFeatured, _refSlot9, _refSlot10, _refCardsRow;
	// The whole menu surface — hidden IMPERATIVELY at the swap frame
	// (Style.Opacity 0 + Style.Left -10000px; display is never flipped so the
	// menu's layout stays warm for the return trip) because the .scene-off
	// class proved unreliable (menu lingered visible under the arriving scene;
	// cascade-resolution bug family, see the .entered/.departing teleport fix).
	private Panel _refMenuContent;
	private int _lastMenuCount = -1, _lastChildCount = -1; // census change-detection

	// NOTE (2026-06-10): the old "ghost sweep" OnAfterTreeRender override was
	// REMOVED — proven dead code. PanelComponent never fires OnAfterTreeRender
	// (zero "SWEPT" lines across every session in sbox-dev.log; the hook only
	// works on Panel-derived razor components like OptionsPanel). Had it ever
	// fired it would have been actively harmful: the markup renders .menu-content
	// unconditionally, so the sweep would have deleted the LIVE menu panel on
	// every re-render while a scene was up. The differ-duplication it targeted
	// (rootChildren 6→14, two .menu-content) was a HOTLOAD-rebuild artifact, not
	// a click-swap behavior — per-swap census shows menuCount=1 on every swap.
	// NOTE: no surface waves anywhere — motion-doctrine v2: surfaces are SOLID (the
	// PLAY liquid was vetoed as motion-sick 2026-06-09; the nav-fill liquid was then
	// retired for consistency). The violet ring is the only ALIVE element; buttons
	// answer input with SNAP (Persona pop + brighten).

	// Per-item 3D rotation for the cursor: (rotateY degrees, perspective px, element to
	// pivot around). Left buttons (0-3) rotate around THEMSELVES; the featured CTAs (7,8)
	// and the card pills (9,10) rotate around their containing panel. Keep in sync with
	// the SCSS transforms; angle 0 = flat.
	private (float angle, int persp, Panel pivot) CursorRot( int i ) => i switch
	{
		0 or 1 or 2 or 3 => (13f, 1300, FocusEl( i )),     // sidebar buttons — 13° (matches .lh-play/.lh-item SCSS)
		7 or 8 => (10f, 2000, FocusEl( i )),              // featured CTAs — match the featured's 10° plane
		9 or 10 => (10f, 2000, FocusEl( i )),             // card pills — match the row's shared 10°/2000px plane (Approach A)
		_ => (0f, 0, null),
	};

	// ─── PERSONA POP (selected lunge) ────────────────────────────────────
	// The selected sidebar item physically lunges via a CSS transform on its
	// .selected state — but transforms don't move Box.Rect, so the gliding ring
	// would land on the un-popped layout rect and the gap look would break.
	// These values mirror the CSS pop into the cursor's TARGET rect (UpdateCursor):
	// the offset is folded into left/top/width/height, so it inherits the ring's
	// 0.27s CSS glide for free and stays concentric mid-travel.
	// LOCKSTEP with the SCSS .selected transforms:
	//   .lh-play-slot.selected .lh-play / .lh-item.selected → translateX(9px) scale(1.04)
	//   .lh-discord.selected → translateX(6px) · .lh-util.selected → translateX(4px)
	private (float x, float scale) SelectedPop( int i ) => i switch
	{
		0 or 1 or 2 or 3 => (9f, 1.04f), // PLAY + nav rows — full lunge out of the 3D lean
		4 => (6f, 1f),                   // Discord card — flat, quieter slide
		5 or 6 => (4f, 1f),              // LANGUAGE / QUIT — tiny nudge
		7 or 8 => (0f, 1.05f),           // featured CTAs — swell from left edge (origin: left center)
		9 or 10 => (0f, 1.06f),          // card View/Join pills — swell from left edge
		23 or 24 or 25 => (0f, 1.035f),  // roadmap posters — GROW (the -10px lift is mirrored as a Y fudge in UpdateCursor)
		// Scene arrows nudge toward their own edge on hover/focus — LOCKSTEP
		// with `.settled .lhd-arrow-prev/next:hover` translateX(∓5px) in SCSS.
		26 => (-5f, 1f),
		27 => (5f, 1f),
		_ => (0f, 1f),
	};
	// NOTE: panel controls (7-10) self-pivot at the SAME angle as their panel — the panel
	// is a uniform-tilted plane, so matching the angle is what reads right; pivoting at the
	// panel's far edge collapsed the tilt (large translate + perspective).

	// The panel a control sits inside (for the visual-displacement nudge), or null if the
	// item isn't nested in a 3D-tilted panel.
	private Panel CursorPanel( int i ) => i switch
	{
		7 or 8 => _refFeatured,
		9 or 10 => _refCardsRow,  // Approach A: both pills sit on the ROW's one shared plane (pivot = row's left)
		_ => null
	};

	private bool _cursorVisible = false;
	private int _cursorL, _cursorT, _cursorW, _cursorH, _cursorR;
	private int _cursorCenterX, _cursorCenterY;
	private int _lastCursorIndex = -1;
	private Panel _cursorRef; // the cursor element — transform set imperatively each frame
	private int _cursorWarmup = 0; // 0/1 = snap to position (no glide), 2 = animate
	private float _cursorSkew = 0f; // rotateY degrees — matches the angled element
	private int _cursorPersp = 1300; // perspective px for the cursor's rotateY
	private int _cursorPivotX = 0;   // rotateY pivot (panel left edge) from the cursor's left edge
	private string _cursorOrigin = "center"; // pivot — the rotated element's left edge in cursor-local px

	// Liquid stretch: squash/stretch along the travel axis on a jump; eased back to rest
	// each frame in code (rubber-band arrival).
	private float _stretchSX = 1f, _stretchSY = 1f;
	// Punchy "ink lean" wave (Splatoon/Persona) — recomputed from Time.Now each frame.
	private float _waveSkewX = 0f, _waveSkewY = 0f, _waveRotZ = 0f;

	private void UpdateCursor()
	{
		// ALIVE-layer signature: the ring stays visible THROUGH scene swaps and
		// cross-glides to the destination's first focusable. Hidden only:
		//  · during the initial entrance (stage < 4 — deal-in poses don't match
		//    CursorRot's static angles),
		//  · in the Options scene once settled there (the docked panel owns its
		//    own kb cursor — never two cursors; spec's documented fallback).
		bool cursorActive;
		if ( !IsVisible ) cursorActive = false;
		else if ( _swap == SwapState.Departing ) cursorActive = true;            // holds the dying control
		else if ( _scene == SceneId.Options ) cursorActive = false;              // panel owns focus there
		else if ( _scene == SceneId.Menu ) cursorActive = _swap == SwapState.Arriving || entranceStage >= 4;
		else cursorActive = true;                                                // roadmap / patch notes
		if ( !cursorActive )
		{
			if ( _cursorVisible || _cursorWarmup != 0 ) { _cursorVisible = false; _cursorWarmup = 0; StateHasChanged(); }
			return;
		}

		int idx = selectedIndex;
		var el = FocusEl( idx );
		if ( el == null || el.Box.Rect.Width < 1f ) return; // not laid out yet — hold last position

		var t = el.Box.Rect;
		var (gx, gy, radius) = CursorGeom( idx );

		// PLAY detonation — the ring SLAMS shut around the fired control for the
		// firing window (.firing also flips it gold + speeds the glide in SCSS).
		if ( _cursorFiring ) { gx = 2; gy = 2; radius = 18; }

		// Persona-pop mirror: the cursor's target is by definition the SELECTED item,
		// and the selected item carries the CSS lunge (translateX + scale on .selected)
		// — which moves it visually but not its Box.Rect. Apply the same pop to the
		// rect here so the ring wraps the item where it VISUALLY is. The scale pivots
		// at the item's left-center (transform-origin: left center), so the left edge
		// holds and only Y re-centers. Folding this into left/top/w/h means the pop
		// rides the cursor's CSS glide — concentric through the whole transition.
		var (popX, popS) = SelectedPop( idx );
		float visW = t.Width * popS;
		float visH = t.Height * popS;
		float visL = t.Left + popX;
		float visT = t.Top - ( visH - t.Height ) / 2f;
		// The card View/Join pills sit inside the tilted cards plane — the ring
		// landed a few px high on them (user-tuned 2026-06-09). Small Y fudge.
		if ( idx == 9 || idx == 10 ) visT += 4f;
		// Roadmap posters LIFT -10px on hover/focus (.settled .lhp rules) — the
		// ring rides the lift. LOCKSTEP with the SCSS translateY(-10px).
		if ( idx >= 23 && idx <= 25 ) visT -= 10f;

		// The MainMenu root is full-screen at (0,0), so an item's screen-px rect is
		// already the cursor's local coordinate (the cursor's offset parent is that
		// root). No origin subtraction — same as TutorialPanel positions its spotlight.
		int left = (int)visL - gx;
		int top = (int)visT - gy;
		int w = (int)visW + gx * 2;
		int h = (int)visH + gy * 2;
		int cx = left + w / 2;
		int cy = top + h / 2;

		bool changed = false;

		// Match the angled element's 3D rotation so the ring rotates WITH it, pivoting
		// around that element's LEFT edge (the item itself for the sidebar buttons; the
		// containing PANEL for controls nested in a rotated panel). Keeps the ring
		// concentric instead of pinching on the receding side.
		var (angle, persp, pivotEl) = CursorRot( idx );
		int pivotX = 0; // rotateY pivot (panel's left edge), measured from the cursor's own left edge
		if ( angle != 0f && pivotEl != null && pivotEl.Box.Rect.Width >= 1f )
		{
			// + popX: when the pivot is the item itself (sidebar), its VISUAL left edge
			// carries the Persona-pop offset too. popX is 0 for every case where the
			// pivot is a different element, so adding unconditionally is safe.
			pivotX = (int)( pivotEl.Box.Rect.Left + popX ) - left;
		}
		else { angle = 0f; persp = 0; }
		// transform-origin stays CENTER (so scale + wave pivot center). The rotateY uses a
		// translate-sandwich (below) to pivot at the panel's left edge instead.
		_cursorSkew = angle; _cursorPersp = persp; _cursorPivotX = pivotX;

		// Controls INSIDE a 3D-tilted panel (CTAs/pills) are visually displaced by the
		// panel's perspective+rotateY, but el.Box.Rect is the FLAT layout rect — so the ring
		// lands down-right of the visual control, more so the further it is from the panel's
		// left-edge pivot (e.g. Patch Notes vs Play Now). Apply the panel's transform to the
		// control's center and nudge the ring onto the visual position.
		var panelEl = CursorPanel( idx );
		if ( panelEl != null && angle != 0f && panelEl.Box.Rect.Width >= 1f )
		{
			var pr = panelEl.Box.Rect;
			float aRad = angle * MathF.PI / 180f;
			// transform-origin Y: the cards row (9/10) pivots 374px ABOVE its top (to share the
			// featured's vanishing point — see .lh-cards SCSS); everything else pivots at center.
			float originY = pr.Top + ( ( idx == 9 || idx == 10 ) ? -374f : pr.Height / 2f );
			float rx = cx - pr.Left;                     // control center relative to the origin
			float ry = cy - originY;
			float z = -rx * MathF.Sin( aRad );           // CSS Z — right side recedes (away)
			float scale = (float)persp / ( (float)persp - z ); // perspective foreshorten
			float vx = pr.Left + rx * MathF.Cos( aRad ) * scale; // visual X after the panel transform
			float vy = originY + ry * scale;                     // visual Y
			left += (int)( vx - cx );
			top += (int)( vy - cy );
			cx = left + w / 2;
			cy = top + h / 2;
		}

		// Liquid stretch when jumping to a different item — set the spike NOW (instant
		// snap = punchy); it eases back to rest each frame below via code-lerp, so we don't
		// need a CSS transform transition (which would smear the per-frame wave).
		if ( idx != _lastCursorIndex && _lastCursorIndex >= 0 && _cursorVisible )
		{
			float dx = cx - _cursorCenterX;
			float dy = cy - _cursorCenterY;
			float dist = MathF.Sqrt( dx * dx + dy * dy );
			float k = 0.32f + Math.Clamp( dist / 520f, 0f, 1f ) * 0.45f; // bigger outward stretch + scales with distance
			if ( k > 0.012f )
			{
				// Elongate ALONG the travel axis (reach toward the new button) and squash
				// harder on the perpendicular — more directional = stronger eye-pull to target.
				if ( MathF.Abs( dx ) >= MathF.Abs( dy ) )
				{ _stretchSX = 1f + k; _stretchSY = 1f - k * 0.62f; }
				else
				{ _stretchSX = 1f - k * 0.62f; _stretchSY = 1f + k; }
			}
		}
		_lastCursorIndex = idx;
		_cursorCenterX = cx;
		_cursorCenterY = cy;

		if ( left != _cursorL || top != _cursorT || w != _cursorW || h != _cursorH || radius != _cursorR )
		{ _cursorL = left; _cursorT = top; _cursorW = w; _cursorH = h; _cursorR = radius; changed = true; }
		if ( !_cursorVisible ) { _cursorVisible = true; changed = true; }
		if ( _cursorWarmup < 2 ) { _cursorWarmup++; changed = true; } // snap first 1-2 frames, then animate

		// Ease the launch stretch back toward rest (code-lerp; slower = more visible stretch).
		_stretchSX += ( 1f - _stretchSX ) * 0.10f;
		_stretchSY += ( 1f - _stretchSY ) * 0.10f;

		// Punchy Splatoon "ink lean": two skew axes oscillating OUT OF PHASE (liquid
		// wobble) + a slow rotateZ drift (the lean). Driven by sin(clock) so it's seamless
		// (no loop boundary = no glitch) and center-symmetric (never leaves the button).
		// Recomputed every visible frame and folded into the transform.
		// More MOTION but FLOWING, not jittery: two SLOW non-harmonic sines per axis (base +
		// a gentle detuned layer for organic, non-repeating variation). No fast/high-freq term
		// — those read as nervous "grasping" rather than liquid. Bigger amplitude = more motion.
		float wt = Time.Now;
		_waveSkewX = 4.5f * MathF.Sin( wt * 2.2f )
		           + 1.4f * MathF.Sin( wt * 3.5f + 1.1f );
		_waveSkewY = 1.6f * MathF.Sin( wt * 1.8f + 1.9f )
		           + 0.7f * MathF.Sin( wt * 2.9f );
		_waveRotZ = 0.8f * MathF.Sin( wt * 1.0f )
		          + 0.35f * MathF.Sin( wt * 2.4f + 0.5f );

		if ( changed ) StateHasChanged(); // markup (position / origin) changes only — rare, not per-frame
		ApplyCursorTransform();            // transform applied imperatively each frame — no re-render
	}

	// Apply the cursor's transform IMPERATIVELY via PanelTransform (Style.Transform) — no
	// StateHasChanged, so no panel re-render and no animation restart (same @ref-imperative
	// pattern the video bg uses every Tick). Order matches the old CSS string:
	// perspective -> rotateY (3D per-item) -> rotateZ + skew (the wave) -> scale (stretch).
	private void ApplyCursorTransform()
	{
		if ( _cursorRef == null || !_cursorVisible ) return;
		var t = new PanelTransform();
		if ( _cursorSkew != 0f )
		{
			t.AddPerspective( _cursorPersp );
			// rotateY pivots at the panel's LEFT edge (matches the angled panel) while the
			// scale + wave below pivot at CENTER. Sandwich: shift the pivot to center, rotate,
			// shift back. qx = left-edge position relative to the cursor's center.
			float qx = _cursorPivotX - _cursorW / 2f;
			t.AddTranslate( Length.Pixels( qx ), Length.Pixels( 0f ), Length.Pixels( 0f ) );
			t.AddRotation( 0f, _cursorSkew, 0f );
			t.AddTranslate( Length.Pixels( -qx ), Length.Pixels( 0f ), Length.Pixels( 0f ) );
		}
		t.AddRotation( 0f, 0f, _waveRotZ );             // rotateZ — wave lean (center)
		t.AddSkew( _waveSkewX, _waveSkewY, 0f );        // wave wobble (center)
		t.AddScale( new Vector2( _stretchSX, _stretchSY ) ); // launch stretch — CENTER now, no right-only growth
		_cursorRef.Style.Transform = t;
	}

	// NOTE: the nav-fill liquid wave was removed under motion-doctrine v2 (guiding-star):
	// surfaces are SOLID — the ALIVE layer is the violet ring alone, interaction is SNAP
	// (the Persona pop). One organic mover + sharp input feedback, consistent everywhere.

	// ─── PLAY "DETONATION" ───────────────────────────────────────────────
	// Clicking PLAY physically FIRES the transition instead of politely waiting
	// for it. Five layers on one ~440ms timeline (all SNAP-layer, transient):
	//   (a) squash-overshoot on the fired button — imperative per-frame transform
	//       (scale 1→0.90 @80ms → 1.07 @200ms → 1.0 @340ms), re-including the
	//       static perspective/translateX/rotateY chain so it never un-tilts.
	//       The .squash class drops the 0.14s transform TRANSITION for the
	//       window (a transition would lowpass the per-frame values to mush).
	//       At settle the EXPLICIT .selected-matching pose is assigned (not
	//       null) — the null isn't written until final cleanup, when inline
	//       and stylesheet values are identical (null mid-window was a suspect
	//       for the squash never reading in-engine).
	//   (b) the cursor ring SLAMS shut (gap → 2px) and flips gold (.firing,
	//       ~200ms hold so the slam is readable), then glides back open on the
	//       base 0.27s transition.
	//   (c) a one-shot gold flash mounts in .lh-play-slot (fresh mount →
	//       @keyframes fire): opacity 0.95→0, FLAT scale 1→1.18, 260ms. (The
	//       old keyframes baked perspective() into the transform and never
	//       rendered — see the SCSS note.)
	//   (d) a 12px white-headed gold streak in the .menu-transition overlay
	//       shoots from the button's screen Y toward the incoming slab (220ms).
	//   (e) a full-screen gold acknowledge pulse (.lh-screen-pulse, 300ms) —
	//       the SCREEN answers the shot, not just the button.
	private float _playFireStart = -1f;     // Time.Now stamp; -1 = idle
	private int _playFireIndex = 0;          // which control fired: 0 sidebar PLAY, 7 featured CTA
	private bool _playSquashing = false;     // (a) window — also gates the .squash class
	private bool _playFlashMounted = false;  // (c)+(d) mount window
	private bool _cursorFiring = false;      // (b) window — .firing on the ring
	private int _streakTop = 0, _streakLeft = 0; // (d) inline position from the fired rect
	private int _playFireVersion = 0;        // @key for the one-shots — a re-fire remounts them

	private void StartPlayDetonation()
	{
		// The audio half of the detonation: heavy fire cue + the ring's metallic
		// snap layered on top (Tier 3 — the menu's biggest press deserves both).
		SoundManager.PlayMenuFire();
		SoundManager.PlayRingSlam();

		_playFireIndex = selectedIndex == 7 ? 7 : 0;
		_playFireStart = Time.Now;
		_playFireVersion++;
		_playSquashing = true;
		_playFlashMounted = true;
		_cursorFiring = true;

		var el = FocusEl( _playFireIndex );
		if ( el != null && el.Box.Rect.Width >= 1f )
		{
			var r = el.Box.Rect;
			_streakTop = (int)r.Center.y - 6; // center the 12px streak on the button
			_streakLeft = (int)r.Right + 16;
		}
		StateHasChanged();
	}

	private static float Lerp01( float a, float b, float x )
		=> a + ( b - a ) * Math.Clamp( x, 0f, 1f );

	private static float EaseOutQuad( float x ) => 1f - ( 1f - x ) * ( 1f - x );

	// Piecewise squash-overshoot envelope (multiplier on the button's resting
	// scale). Raised from 0.93/1.05 — at that amplitude the squash never read
	// in-engine; 0.90→1.07 is the floor for a visible pop on a 460px button.
	private static float DetonationScale( float t )
	{
		if ( t < 0.08f ) return Lerp01( 1f, 0.90f, EaseOutQuad( t / 0.08f ) );          // squash
		if ( t < 0.20f ) return Lerp01( 0.90f, 1.07f, EaseOutQuad( ( t - 0.08f ) / 0.12f ) ); // overshoot
		return Lerp01( 1.07f, 1f, ( t - 0.20f ) / 0.14f );                               // settle (ends 0.34)
	}

	// The fired control's resting CSS pose (its .selected state) as an explicit
	// PanelTransform. Assigned at squash-settle INSTEAD of null — null mid-window
	// hands control back to the stylesheet while the .squash class swap is still
	// re-rendering, which was a prime suspect for the squash being invisible.
	// LOCKSTEP: sidebar PLAY = .lh-play-slot.selected .lh-play, CTA = .lh-feat-cta.selected.
	private PanelTransform DetonationRestPose()
	{
		var tr = new PanelTransform();
		if ( _playFireIndex == 0 )
		{
			tr.AddPerspective( 1300 );
			tr.AddTranslate( Length.Pixels( 9f ), Length.Pixels( 0f ), Length.Pixels( 0f ) );
			tr.AddRotation( 0f, 13f, 0f );
			tr.AddScale( new Vector2( 1.04f, 1.04f ) );
		}
		else
		{
			tr.AddScale( new Vector2( 1.05f, 1.05f ) );
		}
		return tr;
	}

	private void UpdatePlayDetonation()
	{
		if ( _playFireStart < 0f ) return;
		float t = Time.Now - _playFireStart;
		bool changed = false;

		// (b) ring slam window ends — base class glides the ring back open.
		// 200ms hold (was 140 — too fast to register as a slam).
		if ( _cursorFiring && t >= 0.20f ) { _cursorFiring = false; changed = true; }

		// (a) imperative squash on the fired button. The chain MUST re-include the
		// static perspective/translateX/rotateY pose (sidebar PLAY) or the button
		// un-tilts for the duration; the featured CTA is flat (its 3D lives on the
		// featured panel), so it gets scale only.
		var el = FocusEl( _playFireIndex );
		if ( el != null )
		{
			if ( t < 0.34f )
			{
				float s = DetonationScale( t );
				var tr = new PanelTransform();
				if ( _playFireIndex == 0 )
				{
					// LOCKSTEP with .lh-play-slot.selected .lh-play in SCSS:
					// perspective(1300px) translateX(9px) rotateY(13deg) scale(1.04).
					tr.AddPerspective( 1300 );
					tr.AddTranslate( Length.Pixels( 9f ), Length.Pixels( 0f ), Length.Pixels( 0f ) );
					tr.AddRotation( 0f, 13f, 0f );
					tr.AddScale( new Vector2( 1.04f * s, 1.04f * s ) );
				}
				else
				{
					tr.AddScale( new Vector2( 1.05f * s, 1.05f * s ) );
				}
				el.Style.Transform = tr;
			}
			else if ( _playSquashing )
			{
				// Settle onto an EXPLICIT identity-of-.selected pose. The inline
				// transform stays owned by code until final cleanup below.
				el.Style.Transform = DetonationRestPose();
			}
		}
		if ( _playSquashing && t >= 0.34f ) { _playSquashing = false; changed = true; }

		// (c)/(d)/(e) unmount the one-shots once their keyframes have finished.
		if ( _playFlashMounted && t >= 0.44f ) { _playFlashMounted = false; changed = true; }

		if ( t >= 0.44f )
		{
			// Final cleanup: NOW null the inline transform — the .squash class is
			// long gone and inline == stylesheet pose, so the handback is a no-op
			// visually (and future .selected toggles animate normally again).
			if ( el != null ) el.Style.Transform = null;
			_playFireStart = -1f;
		}
		if ( changed ) StateHasChanged();
	}

	private async void OnPlayClicked()
	{
		// (No PlayPopup here — StartPlayDetonation below owns the fire + slam audio.)

		// Fire the detonation IMMEDIATELY on input — interaction feedback must be
		// the sharpest motion on screen, and it can't wait on the save check below.
		// If the save-fail prompt intercepts, it reads as plain press feedback.
		StartPlayDetonation();

		// Wait for SaveService to finish loading before deciding the route.
		// The real question we're answering is "has the player committed to a
		// starter yet?" — not "does the save system have any data?" HasSave
		// trips for fresh players too because MissionManager / DailyRewardManager
		// seed defaults on Hydrate. The clean signal is OwnedMonsters.Count > 0.
		if ( SaveService.Instance != null && !SaveService.Instance.IsLoaded )
		{
			await SaveService.Instance.LoadAsync();
		}

		// Cloud quarantined + no local cache = we have no save source to read from.
		// Block and give the player the option to retry before potentially starting
		// fresh and overwriting their cloud save when they reconnect.
		// _saveFailAcknowledged lets "Play Offline" bypass this on its recursive call.
		var svc = SaveService.Instance;
		if ( svc != null && svc.IsCloudQuarantined && !svc.HasSave && !_saveFailAcknowledged )
		{
			showSaveLoadFailPrompt = true;
			_dialogIndex = 0; // focus RETRY (the recommended choice) by default
			StateHasChanged();
			return;
		}

		var monsterCount = MonsterManager.Instance?.OwnedMonsters?.Count ?? 0;
		var hasStarter = monsterCount > 0;
		Log.Info( $"[MainMenu] OnPlayClicked: hasStarter={hasStarter}, OwnedMonsters={monsterCount}, IsLoaded={SaveService.Instance?.IsLoaded}" );

		if ( hasStarter )
		{
			await PlayBondedSweepAndStart();

			// Auto-fire tutorial for new players who already have a starter but
			// haven't run their first expedition yet. ShouldShowTutorial() guards
			// on Level <= 1 && HighestExpeditionCleared == 0, so returning players
			// won't re-trigger.
			if ( TutorialManager.Instance != null && TutorialManager.Instance.ShouldShowTutorial() )
			{
				TutorialManager.Instance.StartTutorial();
			}
		}
		else
		{
			selectedStarter = -1;
			hoveredStarter = -1;
			showStarterSelection = true;
			PlayStarterRingEntrance();
		}
	}

	// Persona-style DIAGONAL WIPE from main menu into Hub (P5 dialect).
	// Gold + purple angular slabs sweep IN from opposite corners to cover the
	// screen, the mascot + BEASTBORNE wordmark slam in over the seam, then the
	// slabs split back OUT in opposite directions to reveal the Hub (mounted
	// under cover). Tier-3 moment — PLAY is a commitment, it deserves the juice.
	//
	// Driven by mount-time @keyframes (see .tx-slab / .tx-logo / tx-slide-* in
	// MainMenu.razor.scss), NOT class-toggle transform transitions — s&box
	// 26.06.03 stopped firing those reliably. The overlay is conditionally
	// rendered, so it mounts fresh on every PLAY and the wipe always runs; the
	// whole thing is a single 2000ms timeline (in 0-30% / hold 30-62% / out
	// 62-100%). Code-behind just times the cover handoff + the unmount.
	private async Task PlayBondedSweepAndStart()
	{
		// Mount the overlay — both slabs begin sweeping in immediately.
		transitionPhase = 1;
		StateHasChanged();

		// ~840ms in, the slabs fully cover the screen (slide-in ends at 38% of
		// the 2200ms timeline). Flip to phase 2 so the root's `.covering` class
		// hides the menu visuals, and mount the Hub behind the cover — the slide
		// off then reveals a laid-out Hub, never a flash of the old menu.
		await Task.Delay( 840 );
		transitionPhase = 2;
		StartGame();
		StateHasChanged();

		// Stamp holds, then the slabs split back out and finish at the 2000ms
		// mark. Wait out the rest of the timeline, then unmount the overlay.
		await Task.Delay( 1360 );
		transitionPhase = 0;
		StateHasChanged();
	}

	private void BackToTitleScreen()
	{
		SoundManager.PlayBack();
		showStarterSelection = false;
		selectedStarter = -1;
		hoveredStarter = -1;
	}

	private void SelectStarter(int index)
	{
		if (selectedStarter == index) return;
		selectedStarter = index;
		hoveredStarter = index;
		SoundManager.PlayClick();
	}

	private void OnStarterHover(int index)
	{
		if (hoveredStarter == index) return;
		hoveredStarter = index;
		SoundManager.PlayHover();
	}

	private string GetStarterName(int index)
	{
		if (index < 0 || index >= starterNames.Length) return "";
		return starterNames[index];
	}

	private string[] starterSpecies = { "embrik", "pagefin", "cherune" };
	private string[] starterNames = { "Embrik", "Pagefin", "Cherune" };

	private async void OnConfirmStarter()
	{
		if (selectedStarter < 0) return; // guard — can't confirm nothing

		PlayClickSound();

		// Default the tamer to Male — the gender-select screen has been removed,
		// but TamerGender is still referenced across the codebase (slot avatars,
		// profile panel, trading), so the enum stays. Default Male for new saves.
		TamerManager.Instance?.SetGender(TamerGender.Male);

		// Create the starter monster (bred = true, so no contract)
		var speciesId = starterSpecies[selectedStarter];
		var starter = MonsterManager.Instance?.CreateMonster(speciesId, isBred: true);

		if (starter != null)
		{
			// Set starter to level 3 for a better early game experience
			starter.Level = 3;
			MonsterManager.Instance?.RecalculateStats(starter);
			MonsterManager.Instance?.RefreshMovesForLevel(starter);
			starter.FullHeal();

			Log.Info($"Created starter: {starter.Nickname} at Level {starter.Level}");

			// Immediately snapshot tamer + monsters into the blob.
			TamerManager.Instance?.SaveToCloud();
			MonsterManager.Instance?.SaveMonsters();

			// Await a synchronous flush so the local cache is guaranteed written
			// (and the cloud push at least fired) BEFORE we enter Hub. The
			// state-change flush alone is fire-and-forget and can lose this
			// critical first-save window if the editor stops play-mode fast.
			if ( SaveService.Instance != null )
			{
				await SaveService.Instance.FlushAsync();
			}

			showStarterSelection = false;
			StartGame();

			// Auto-fire the tutorial after a brand-new player picks their starter.
			// This is the canonical "new player" path — they have a starter (level 3
			// by design) and zero expeditions cleared, so ShouldShowTutorial passes.
			if ( TutorialManager.Instance != null && TutorialManager.Instance.ShouldShowTutorial() )
			{
				TutorialManager.Instance.StartTutorial();
			}
		}
	}

