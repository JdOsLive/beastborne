	protected override void OnStart()
	{
		// Fade in content after a short delay
		contentVisible = true;

		// Spawn the ambient video background component once. VideoBackground lives
		// on its own GameObject so its Component.OnUpdate tick pumps the decoder
		// every frame — a Razor PanelComponent can't host a VideoPlayer safely
		// since OnUpdate cadence there is tied to the panel's mount state.
		// Until the texture binds, the layer is empty and the dark root shows.
		//
		// A surviving instance playing a STALE path (hot reload after a video
		// swap — the old component outlives the assembly change) is torn down
		// and respawned so the current default always wins.
		var existing = VideoBackground.Instance;
		if ( existing != null && existing.VideoPath != VideoBackground.DefaultVideoPath )
		{
			Log.Info( $"[MainMenu] VideoBackground exists but plays stale path '{existing.VideoPath}' — destroying to respawn with current default" );
			existing.GameObject.Destroy();
			existing = null;
		}

		if ( existing == null )
		{
			Log.Info( "[MainMenu] VideoBackground.Instance is null — spawning GameObject + component" );
			var go = new GameObject();
			go.Name = "MainMenu_VideoBackground";
			var vb = go.Components.Create<VideoBackground>();
			Log.Info( $"[MainMenu] Created VideoBackground component: {(vb != null ? "OK" : "NULL")}" );
		}
		else
		{
			Log.Info( "[MainMenu] VideoBackground.Instance already exists — reusing" );
		}

		// Subscribe to state changes
		if ( GameManager.Instance != null )
		{
			GameManager.Instance.OnStateChanged += OnGameStateChanged;
		}

		// NOTE: do NOT call Panel.Focus() / AcceptsFocus here. The main menu's
		// keyboard navigation is driven entirely by the Input action system
		// (Input.Pressed in HandleKeyboardInput). Giving the root panel keyboard
		// focus made it CAPTURE keyboard input and suppress Input.Pressed — so on
		// a fresh launch (OnStart runs once) the menu was keyboard-dead until the
		// panel happened to lose focus (after a round-trip in-game). Mouse/pointer
		// input works via pointer-events CSS and needs neither.

		// Initialize splash text, featured portrait, and event banner
		RandomizeSplash();
		RandomizeFeatureArt();
		UpdateEventBanner();

		// Seed the ticker with the fallback entries so there's always something
		// visible — live server data swaps in when `RefreshAnnouncementsAsync`
		// resolves below.
		ApplyTickerItem( 0 );

		// Kick off the first announcements fetch. Fire-and-forget: if the
		// component unmounts mid-request, the task completes on its own and
		// the StateHasChanged inside will be a no-op.
		_lastAnnouncementFetchTime = Time.Now;
		_ = RefreshAnnouncementsAsync();

		// Same pattern for live events. Stamp the fetch time first so OnUpdate
		// won't double-fire while the first request is in flight.
		_lastEventsFetchTime = Time.Now;
		_ = RefreshEventsAsync();

		// Live Discord member/online counts for the Community card (best-effort).
		RefreshDiscordStatsAsync();

		// Staggered entrance sequence
		PlayEntranceSequence();
	}

	// ─── "DEAL-IN" ENTRANCE ──────────────────────────────────────────────
	// Collapsed stage machine (was 7 stages / ~1.5s; now 4 / ~0.7s-to-interactive):
	//   stage 1 (t≈60ms)  — sidebar slab slides in (CSS transition, unchanged)
	//   stage 2 (t≈180ms) — nav rows cascade (transition-delay stagger) + main
	//                        area fades + the FEATURED card deals in along its
	//                        3D plane (imperative per-frame transform below)
	//   stage 3 (t≈300ms) — bottom CARD ROW deals in, ~120ms behind the featured
	//   stage 4 (~t≈750ms) — both planes settled → cursor goes live, stagger
	//                        delays zero out (.lh-nav.settled). Flipped from
	//                        UpdatePlaneTweens(), not a Task.Delay.
	//
	// The plane slide is IMPERATIVE (the proven cursor pattern — class-toggle
	// transform transitions snap in s&box): rotateY 15°→10° + translateX 70px→0,
	// code-eased (lerp 0.16/frame ≈ 450ms), then the inline transform is NULLED
	// so the steady-state CSS rule resumes. The cursor stays hidden until stage 4,
	// so CursorRot's static angles never see the animation. .lh-main stays
	// opacity-only (a transform there poisons descendant flex-grow widths).
	// TEMP swap diagnostics (2026-06-10, hunting the departure teleport) — every
	// log is single-line (multiline Log.Info truncates). Flip off when solved.
	private const bool SWAP_DEBUG = false; // teleport bug solved (swap-frame layout stall) — re-enable only for swap forensics
	private const float SWAP_SLOWMO = 1f; // real time — slow-mo retired with the bug

	private async void PlayEntranceSequence()
	{
		if ( SWAP_DEBUG ) Log.Info( $"[swapdbg] ENTRANCE begin (nulls plane transforms!) t={Time.Now:F3} swap={_swap} scene={_scene}" );
		if ( _refMenuContent != null )
		{
			// Fresh entrance always clears the imperative hide (all three paths).
			_refMenuContent.Style.Display = null;
			_refMenuContent.Style.Opacity = null;
			_refMenuContent.Style.Left = null;
		}
		entranceStage = 0;
		// Reset any leftover imperative state from a previous visit (deal-in /
		// PLAY detonation) so the CSS defaults are this entrance's baseline.
		EnsureTweens();
		_twFeatured.Active = false;
		_twCards.Active = false;
		_twSceneBg.Active = false;
		var sceneBg = ResolvePlane( 2 );
		if ( sceneBg != null ) sceneBg.Style.Transform = null;
		_playFireStart = -1f;
		_playSquashing = false;
		_playFlashMounted = false;
		_cursorFiring = false;
		if ( _ref0 != null ) _ref0.Style.Transform = null;
		if ( _ref7 != null ) _ref7.Style.Transform = null;
		if ( _refFeatured != null ) _refFeatured.Style.Transform = null;
		if ( _refCardsRow != null ) _refCardsRow.Style.Transform = null;
		StateHasChanged();

		await Task.Delay( 60 );   // one rendered frame at stage 0 so entrance states commit
		entranceStage = 1;        // sidebar slab slides in
		StateHasChanged();

		await Task.Delay( 120 );  // nav cascade + main fade + featured deal-in
		entranceStage = 2;
		StartFeaturedDealIn();
		StateHasChanged();

		await Task.Delay( 120 );  // card row deals in, trailing the featured
		entranceStage = 3;
		StartCardsDealIn();
		StateHasChanged();
		// Stage 4 flips in UpdatePlaneTweens() the frame both planes settle.
	}

	// ─── PLANE TWEENER — list-driven generalization of the old UpdateDealIn ──
	// One tweener drives every angled plane (featured / cards row / scene
	// backdrop): exponential approach per frame (the proven cursor pattern —
	// class-toggle transform transitions snap in s&box). Arrivals use rate
	// 0.16 (0.20 on the cheaper return trip), departures 0.28. On settle at a
	// pose that matches the steady-state CSS, the inline transform is NULLED
	// so the stylesheet takes back over seamlessly; mid-flight retargets keep
	// the current pose (interrupted arrivals become the next departure's
	// start poses — the player never waits for choreography twice).
	private class PlaneTween
	{
		// HOTLOAD-SAFE plane resolution: an int ID resolved through ResolvePlane()
		// each frame — NOT a Func<Panel> closure. Lambdas captured by long-lived
		// objects DIE on s&box hot reload ("Unable to find matching substitution
		// for a lambda method", thrown every frame from StepTween — seen live
		// 2026-06-09). Methods substitute cleanly across hotloads; closures don't.
		public int PlaneId;          // 0 featured · 1 cards row · 2 scene backdrop
		public float X, Deg;         // current pose
		public float TX, TDeg;       // targets
		public float Rate;           // lerp factor per frame
		public int Persp;            // perspective px (matches the steady CSS chain)
		public bool Active;
		public bool NullAtTarget;    // target == steady CSS pose → null inline transform on settle
	}

	private PlaneTween _twFeatured, _twCards, _twSceneBg;

	// Fresh-each-frame panel resolution (refs can re-bind; hotload-safe).
	private Panel ResolvePlane( int id ) => id switch
	{
		0 => _refFeatured,
		1 => _refCardsRow,
		2 => _sceneComp?.SceneBg,
		_ => null,
	};

	private void EnsureTweens()
	{
		if ( _twFeatured != null ) return;
		_twFeatured = new PlaneTween { PlaneId = 0, Persp = 2000 };
		_twCards = new PlaneTween { PlaneId = 1, Persp = 2000 };
		_twSceneBg = new PlaneTween { PlaneId = 2, Persp = 2000 };
	}

	// Retarget a plane. Seeds the start pose only when the tween is at rest —
	// an active tween keeps its mid-flight pose (interrupt = reverse in place).
	private void StartTween( PlaneTween tw, float fromX, float fromDeg, float toX, float toDeg, float rate, bool nullAtTarget )
	{
		EnsureTweens();
		if ( tw == null ) return;
		if ( !tw.Active ) { tw.X = fromX; tw.Deg = fromDeg; }
		tw.TX = toX;
		tw.TDeg = toDeg;
		tw.Rate = rate;
		tw.NullAtTarget = nullAtTarget;
		tw.Active = true;
		ApplyDealTransform( ResolvePlane( tw.PlaneId ), tw.X, tw.Deg, tw.Persp );
	}

	private void StartFeaturedDealIn() => StartTween( _twFeatured, 70f, 15f, 0f, 10f, 0.16f, true );
	private void StartCardsDealIn() => StartTween( _twCards, 70f, 15f, 0f, 10f, 0.16f, true );

	// Same chain SHAPE as the steady-state CSS (perspective(N) translateX
	// rotateY) so the pose converges exactly onto the stylesheet value.
	// transform-origin comes from CSS and is untouched (left center for the
	// featured + scene backdrop, left -374px for the cards row).
	private static void ApplyDealTransform( Panel el, float x, float deg, int persp )
	{
		if ( el == null ) return;
		var t = new PanelTransform();
		t.AddPerspective( persp );
		t.AddTranslate( Length.Pixels( x ), Length.Pixels( 0f ), Length.Pixels( 0f ) );
		t.AddRotation( 0f, deg, 0f );
		el.Style.Transform = t;
	}

	// Per-frame step for every plane. TIMERS own the swap state machine —
	// the only state this flips is the entrance/return stage 3→4 gate
	// (cosmetic: zeroes stagger delays + wakes the cursor).
	private void UpdatePlaneTweens()
	{
		EnsureTweens();
		StepTween( _twFeatured );
		StepTween( _twCards );
		StepTween( _twSceneBg );

		// Menu planes home → menu fully settled (entrance AND return trips).
		if ( entranceStage == 3 && _scene == SceneId.Menu && !_twFeatured.Active && !_twCards.Active )
		{
			entranceStage = 4;
			_menuReturning = false;
			StateHasChanged();
		}
	}

	private void StepTween( PlaneTween tw )
	{
		if ( tw == null || !tw.Active ) return;
		var el = ResolvePlane( tw.PlaneId );
		if ( el == null ) { tw.Active = false; if ( SWAP_DEBUG ) Log.Info( $"[swapdbg] tween p{tw.PlaneId} LOST PANEL t={Time.Now:F3}" ); return; }

		// TIME-BASED easing (2026-06-10): Rate is authored as "lerp factor per frame
		// AT 60fps"; convert to a per-second exponential so the motion covers the
		// same distance in the same real time at ANY framerate. The menu was
		// measured at ~22fps mid-swap — per-frame lerping there ran at a third of
		// the designed speed (the planes only made 63% of the trip before the
		// swap frame cut them off, reading as a "teleport").
		float k = -MathF.Log( 1f - Math.Clamp( tw.Rate, 0.01f, 0.95f ) ) * 60f / SWAP_SLOWMO;
		float a = 1f - MathF.Exp( -k * Time.Delta );
		tw.X += ( tw.TX - tw.X ) * a;
		tw.Deg += ( tw.TDeg - tw.Deg ) * a;
		if ( MathF.Abs( tw.X - tw.TX ) < 0.5f && MathF.Abs( tw.Deg - tw.TDeg ) < 0.04f )
		{
			if ( SWAP_DEBUG ) Log.Info( $"[swapdbg] tween p{tw.PlaneId} SETTLE x={tw.TX:F1} null={tw.NullAtTarget} t={Time.Now:F3}" );
			if ( tw.NullAtTarget ) el.Style.Transform = null;
			else ApplyDealTransform( el, tw.TX, tw.TDeg, tw.Persp );
			tw.Active = false;
		}
		else
		{
			if ( SWAP_DEBUG && _swap != SwapState.Idle ) Log.Info( $"[swapdbg] tween p{tw.PlaneId} x={tw.X:F1} deg={tw.Deg:F1} t={Time.Now:F3}" );
			ApplyDealTransform( el, tw.X, tw.Deg, tw.Persp );
		}
	}

