	@* Cloud-quarantine prompt — shown when cloud is unreachable AND there is no
	   local cache to fall back on. The player cannot safely play without some
	   save source: if they start fresh and we later push an empty blob, their
	   real cloud save would be overwritten. Offer Retry (re-runs LoadAsync) or
	   Play Offline (acknowledges the risk and lets them in with quarantined writes). *@
	@if (IsVisible && showSaveLoadFailPrompt)
	{
		<div class="starter-overlay save-fail-overlay">
			<div class="save-fail-panel" onclick:stopPropagation>
				<div class="save-fail-tag"><span>Cloud Save</span></div>
				<div class="save-fail-header">
					<iconify icon="lucide:cloud-off" Size=@(28) Color="#f87171" />
					<span class="save-fail-title">Save Server Unreachable</span>
				</div>
				<div class="save-fail-body">
					<span class="save-fail-desc">Beastborne couldn't reach the save server, and there's no offline backup on this machine.</span>
					<span class="save-fail-desc save-fail-emphasis">Progress made this session won't sync until you reconnect.</span>
					<span class="save-fail-hint">Reconnecting and retrying is the safest option.</span>
				</div>
				<div class="save-fail-actions">
					<button class="save-fail-retry-btn @(_dialogIndex == 0 ? "mainmenu-kb-selected" : "")" onclick=@OnSaveFailRetry disabled=@isSaveRetrying>
						<iconify icon="lucide:refresh-cw" Size=@(14) Color="#ffffff" />
						<span>@(isSaveRetrying ? "RETRYING..." : "RETRY")</span>
					</button>
					<button class="save-fail-offline-btn @(_dialogIndex == 1 ? "mainmenu-kb-selected" : "")" onclick=@OnPlayOffline>
						<iconify icon="lucide:wifi-off" Size=@(14) Color="#94a3b8" />
						<span>PLAY OFFLINE</span>
					</button>
				</div>
			</div>
		</div>
	}

</root>

@code {
	// Localization helper
	private string L( string key ) => LocalizationManager.Get( key );
	private string L( string key, params object[] args ) => LocalizationManager.Get( key, args );

	private bool contentVisible = false;
	private int entranceStage = 0;
	private int selectedIndex = 0;

	// Shared keyboard cursor for two-button modal dialogs (save-fail,
	// hiring, reset confirm). 0 = left button focused, 1 = right. Reset
	// to 0 (the safe choice) whenever such a dialog opens.
	private int _dialogIndex = 0;

	// @ref to the scrollable patch-notes entry list — arrow keys + mouse
	// wheel drive its ScrollOffset. Bound only while the panel is mounted.
	private Sandbox.UI.Panel patchNotesBody;
	private const float PatchNotesKeyScrollStep = 90f;  // arrow Up/Down nudge
	private const float PatchNotesWheelStep = 60f;       // per wheel notch

	private bool showStarterSelection = false;
	private bool showRoadmap = false;
	private int selectedStarter = -1; // -1 = none selected yet
	private int hoveredStarter = -1;
	private int starterStage = 0;      // staggered ring entrance

	private bool hoveringUpdate = false;

	// Bonded Sweep transition from PLAY → Hub. 0 = idle/unmounted,
	// 1 = bars sliding in, 2 = bars covering + mascot peek, 3 = bars
	// sweeping off-screen to reveal Hub. See PlayBondedSweepAndStart().
	private int transitionPhase = 0;

	// Ctrl+Shift+R danger-zone shortcut — two-stage confirm before wiping save.
	private bool showResetConfirm = false;
	private bool isResetting = false;

	// Open-beta disclaimer — static so it persists across MainMenu re-mounts in
	// the same session but resets every game launch. Dismissal sets this true.
	private static bool _betaDisclaimerSeen = false;

	private void DismissBetaDisclaimer()
	{
		SoundManager.PlayClick();
		_betaDisclaimerSeen = true;
		StateHasChanged();
	}

	// Cloud-quarantine prompt — shown at boot when cloud is unreachable AND there
	// is no local cache. Lets the player retry the cloud load or accept offline mode.
	// _saveFailAcknowledged gates the check so "Play Offline" doesn't loop.
	private bool showSaveLoadFailPrompt = false;
	private bool isSaveRetrying = false;
	private bool _saveFailAcknowledged = false;

	private async void OnSaveFailRetry()
	{
		if (isSaveRetrying) return;
		isSaveRetrying = true;
		SoundManager.PlayClick();
		StateHasChanged();

		var svc = SaveService.Instance;
		if (svc != null)
		{
			await svc.LoadAsync();
			if (!svc.IsCloudQuarantined)
			{
				// Cloud recovered — dismiss prompt and resume the play flow
				showSaveLoadFailPrompt = false;
				isSaveRetrying = false;
				StateHasChanged();
				OnPlayClicked();
				return;
			}
		}

		isSaveRetrying = false;
		StateHasChanged();
	}

	private void OnPlayOffline()
	{
		// Player accepts the risk — dismiss and let them through as-is.
		// Cloud writes remain quarantined for this session (SaveService already set that).
		SoundManager.PlayClick();
		showSaveLoadFailPrompt = false;
		_saveFailAcknowledged = true;
		StateHasChanged();
		OnPlayClicked();
	}

	// Patch notes modal — opens v1.1.0 notes. The pulsing NEW dot stays on the
	// menu entry until the player has opened the panel at least once this
	// session. Static so it persists across MainMenu re-mounts within a game
	// launch but resets every fresh launch (next-version content gets a fresh
	// dot). Future: persist per-version on the tamer to only show NEW for
	// versions the player hasn't read yet.
	private bool showPatchNotes = false;
	private static bool _patchNotesSeen = false;

	private void OnPatchNotesClicked()
	{
		SoundManager.PlayPopup();
		showPatchNotes = true;
		_patchNotesSeen = true;
	}

	private void ClosePatchNotes()
	{
		SoundManager.PlayBack();
		showPatchNotes = false;
	}

	// News ticker
	private int tickerIndex = 0;
	private bool tickerVisible = true;
	private TimeSince sinceTickerRotation = 0;
	private const float TickerRotationSeconds = 6.5f;
	private const float TickerFadeSeconds = 0.35f;
	private string currentTickerText = "";
	private string currentTickerIcon = "lucide:circle";
	private string currentTickerColor = "#a78bfa";

	private struct TickerItem
	{
		public string Text;
		public string Icon;
		public string Color;
		public TickerItem( string t, string i, string c ) { Text = t; Icon = i; Color = c; }
	}

	// Short fallback used when the live announcements endpoint is unreachable
	// or returns an empty list. Kept intentionally small — the "real" content
	// lives on the server now.
	private static readonly TickerItem[] FallbackTickerItems = new[]
	{
		new TickerItem( "Join the Beastborne Discord — help shape the launch", "lucide:message-circle-more", "#5865f2" ),
		new TickerItem( "Beta — your feedback shapes the game", "lucide:sparkles", "#fbbf24" ),
		new TickerItem( "The tower remembers...", "lucide:tower-control", "#c4b5fd" ),
	};

	// Mutable active ticker list — starts with the fallbacks and gets swapped
	// to the live server list when `RefreshAnnouncementsAsync` resolves.
	private List<TickerItem> tickerItems = new( FallbackTickerItems );

	// Cached raw live data, mainly to keep the latest snapshot around for
	// debugging/BuildHash purposes.
	private List<Announcement> _liveAnnouncements = new();

	// Periodic refresh throttle. We refresh every 5 min while the main menu is
	// mounted + visible. `-1` sentinel means "never fetched", which forces the
	// first tick after OnStart to fire.
	private float _lastAnnouncementFetchTime = -1f;
	private const float AnnouncementRefreshSeconds = 300f;

	private int tickerMessageCount => tickerItems.Count;

	// Discord link
	private string discordDisplayText = "discord.gg/dJTTyCqKru";
	private const string DiscordLink = "https://discord.gg/dJTTyCqKru";

	// Event banner — driven by the live /api/events feed. The toast markup is
	// gated on `currentEventText` being non-empty, so an empty list / fetch
	// failure naturally hides the toast. If multiple events are active, we
	// rotate through them on a ~10s cadence.
	private string currentEventText = "";
	private string currentEventIcon = "";
	private string currentEventSub = "";
	private string currentEventTimer = "";

	// Live events rotation state. Refreshed in OnStart, every 5 min while the
	// menu is mounted, and on state change back to MainMenu.
	private List<LiveEvent> _liveEvents = new();
	private int _eventIndex = 0;
	private float _lastEventsFetchTime = -1f;
	private const float EventsRefreshSeconds = 300f;
	private TimeSince _sinceEventRotation = 0;
	private const float EventRotationSeconds = 10f;

	private async void OnDiscordClick()
	{
		Clipboard.SetText( DiscordLink );
		discordDisplayText = "Copied to clipboard!";
		StateHasChanged();
		await Task.Delay( 2000 );
		discordDisplayText = "discord.gg/dJTTyCqKru";
		StateHasChanged();
	}

	// Splash text system
	private string currentSplashText = "";

	// Featured portrait on the right side of the menu — placeholder rotation
	// through the three starter artworks until a dedicated hero piece lands.
	// Swap the array to a single `ui/main menu/featured_hero.png` later.
	private string currentFeatureArt = "ui/starters/embrik_artwork.png";
	private static readonly string[] FeatureArtPool = new[]
	{
		"ui/starters/embrik_artwork.png",
		"ui/starters/pagefin_artwork.png",
		"ui/starters/cherune_artwork.png",
	};

	private static readonly string[] SplashTexts = new[]
	{
		// Funny
		"Embrik used Ember. Your social life took 9999 damage!",
		"A wild bug appeared! ...oh wait, that's a feature.",
		"Now with 100% more genetics!",
